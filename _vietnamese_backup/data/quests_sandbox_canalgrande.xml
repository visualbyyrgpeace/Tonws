<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE questdb SYSTEM ".quests.dtd">

<questdb>

	<include file = "data/common-quests.xml"/>

	<!-- MAP: Canal Grande-->
	<group avatar="client" id="sandbox_canalgrande">
