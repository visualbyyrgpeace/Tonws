<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE questdb SYSTEM ".quests.dtd">

<questdb>

	<include file = "data/common-quests.xml"/>

	<group avatar="farmer" id="sandbox_falls">

		<quest id="SANDBOX_STARTQUEST" title="Welcome to sandbox mode." description="T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" start="instant" finish="instant" visible="false">
			<start_condition timeout="2" operator="and"/>
			<onSuccess>
				<conversation>
					<statement avatar="farmer" message="T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" mood="greeting" align="left"/>
				</conversation>
			</onSuccess>
			<objectives timeout="2" operator="and"/>
			<rewards>
				<set-flag key="sandbox_weather_enabled" value="true"/>
				<set-modifier name="mod_production_building_fishing_lodge" tag="map" value="115"/>
				<set-flag key="sandbox_map_has_avalanche" value="true" />
				<set-flag key="sandbox_map_has_thunderstorm" value="true" />
			</rewards>
		</quest>

		<!-- AVALANCHE -->
		<quest id="SANDBOX_AVALANCHE_LAUNCHER" start="custom" visible="false" finish="instant" repeatable="custom" >
			<onStarted >
				<start-quest id="SANDBOX_AVALANCHE_TICKET" />
			</onStarted>
			<objectives timeout="1" operator="and">
				<random chance="50" />
			</objectives>
			<fail_condition timeout="2" operator="and"/>
			<rewards >
				<start-quest id="SANDBOX_AVALANCHE_1" />
			</rewards>
			<onFailed >
				<start-quest id="SANDBOX_AVALANCHE_0" />
			</onFailed>
		</quest>
		<quest id="SANDBOX_AVALANCHE_TICKET" start="custom" visible="false" finish="instant" repeatable="custom" >
			<objectives timeout="10" operator="and"/>
			<ticket title="T_SANDBOX_AVALANCHE_TICKET" severity="warning" icon="notification_ui_avalanche" reference="options/cat_helppage/help_disasters/avalanche"/>
		</quest>
		<quest id="SANDBOX_AVALANCHE_1" start="custom" visible="false" finish="instant" repeatable="custom" >
			<rewards >
				<avalanche topLeftX="40" topLeftY="58" bottomRightX="55" bottomRightY="68" minValue="-60" maxValue="-50" destroyOnNoDurability="false" avalancheSize="1" startOrientation="topLeft" />
			</rewards>
		</quest>
		<quest id="SANDBOX_AVALANCHE_0" start="custom"  visible="false" finish="instant" repeatable="custom" >
			<rewards >
				<avalanche topLeftX="40" topLeftY="58" bottomRightX="55" bottomRightY="68" minValue="-30" maxValue="-20" destroyOnNoDurability="true" avalancheSize="1" startOrientation="topLeft" />
			</rewards>
		</quest>
		<!-- AVALANCHE END-->

	</group>

</questdb>