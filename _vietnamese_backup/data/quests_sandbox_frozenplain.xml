<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE questdb SYSTEM ".quests.dtd">

<questdb>

	<include file = "data/common-quests.xml"/>

	<group avatar="client" id="sandbox_frozenplain">

		<quest id="SANDBOX_STARTQUEST" title="Welcome to sandbox mode." description="T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" start="instant" finish="instant" visible="false">
			<start_condition timeout="2"/>
			<onSuccess>
				<conversation>
					<statement avatar="client" message="T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" mood="advice" align="left"/>
				</conversation>
			</onSuccess>
			<objectives timeout="2"/>
			<rewards>
				<set-flag key="sandbox_weather_enabled" value="true"/>
				<set-flag key="sandbox_map_has_avalanche" value="true" />
				<set-flag key="sandbox_map_has_thunderstorm" value="true" />
			</rewards>
		</quest>
	
<!--_________________________________________________________________________________________________________________________________________________-->
<!--______________________________________________________________________AVALANCHE_MANAGER______________________________________________________________-->
<!--__________________________________________________________________________________________________________________________________________________________-->

		<quest id="SANDBOX_AVALANCHE_LAUNCHER" start="custom" visible="false" finish="instant" repeatable="custom" >
			<onStarted >
				<start-quest id="SANDBOX_AVALANCHE_TICKET" />
			</onStarted>
			<objectives timeout="1" >
				<random chance="50" />
			</objectives>
			<fail_condition timeout="2" />
			<rewards >
				<start-quest id="SANDBOX_AVALANCHE_1" />
			</rewards>
			<onFailed >
				<start-quest id="SANDBOX_AVALANCHE_0" />
			</onFailed>
		</quest>

		<quest id="SANDBOX_AVALANCHE_TICKET" start="custom" finish="instant" repeatable="custom" >
			<objectives timeout="10" />
			<ticket title="T_SANDBOX_AVALANCHE_TICKET" severity="warning" notification-sound="disasters/sfx_avalanche_going_down" icon="avalanche" />
		</quest>

		<quest id="SANDBOX_AVALANCHE_1" start="custom" visible="false" finish="instant" repeatable="custom" >
			<objectives timeout="1" >
				<random chance="50" />
			</objectives>
			<fail_condition timeout="2" />
			<rewards>
				<!--These coordinates need to be updated for each map-->
				<avalanche topLeftX="135" topLeftY="163" bottomRightX="138" bottomRightY="172" minValue="-40" maxValue="-60" destroyOnNoDurability="false" avalancheSize="1" startOrientation="topLeft" />
			</rewards>
			<onFailed>
				<!--These coordinates need to be updated for each map-->
				<avalanche topLeftX="135" topLeftY="163" bottomRightX="138" bottomRightY="172" minValue="-40" maxValue="-60" destroyOnNoDurability="false" avalancheSize="1" startOrientation="topLeft" />
			</onFailed>
		</quest>
		
		<quest id="SANDBOX_AVALANCHE_0" start="custom" visible="false" finish="instant" repeatable="custom" >
			<objectives timeout="1" >
				<random chance="50" />
			</objectives>
			<fail_condition timeout="2" />
			<rewards>
				<!--These coordinates need to be updated for each map-->
				<avalanche topLeftX="135" topLeftY="163" bottomRightX="138" bottomRightY="172" minValue="-20" maxValue="-40" destroyOnNoDurability="false" avalancheSize="1" startOrientation="topLeft" />
			</rewards>
			<onFailed>
				<!--These coordinates need to be updated for each map-->
				<avalanche topLeftX="135" topLeftY="163" bottomRightX="138" bottomRightY="172" minValue="-20" maxValue="-40" destroyOnNoDurability="false" avalancheSize="1" startOrientation="topLeft" />
			</onFailed>
		</quest>
	
	</group>

</questdb>