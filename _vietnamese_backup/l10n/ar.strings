"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "وبعلم مستشارك، قمت بزرع فخ للسحرة. فبمجرد وصولهم لاستلام البضائع، سيُقبض عليهم على الفور في الشبكة! لنأمل أن تكون فكرتك البارعة فعالة.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "يا سيدي، تمكنا من الإمساك بالساحر الثاني!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "لديك حارسان متمركزان بالقرب من الموارد. يظهر الساحران الآخران ويقتربان ببطء لأخذ الموارد. نصب حراسك الفخ وهم في الطريق إلى هناك.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "لا تستسلم.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "إذن أنت تريد إثارة غضب إخواني. لا أريد أن أكون في مكانك أيها الحاكم.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "الرجل الذي نعمل لديه سيجعلك تدفع الثمن!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "آه! أنت تعترف أخيرًا أنك تعمل بأوامر شخص ما! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "عض الساحر شفتاه، في بادرة ندم على تحدثه بسرعة كبيرة. إذن أرسله شخصٌ غاضب منك شخصيًا.\n\nمهما حاولت جاهدًا التفكير في من قد يكون هذا، لا يخطر إلى ذهنك أي اسم.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "يأتي مستشارك راكضًا ويبدو مذعورًا: "يا سيدي! السحرة على عتبة بابنا! يطلبون منا الضيافة لبضعة أيام. أنقبل؟"";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "أيها الحاكم... هذا كله سوء تفاهم مؤسف. أنا وإخوتي لم نكن نريد أن نسبب لك المتاعب.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "إذن فهم إخوتك. لماذا أشعلتم النيران ؟!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "لم نكن نريد ذلك، يا سيدي. نحن أغبياء قليلًا، هذا كل ما في الأمر...";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "لصالح مَن تعملون، قطاع الطرق؟!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "أبعد ما يكون عن ذلك! ومع ذلك، إذا أردت التخلص من الدخان الكثيف الذي يبتلع تدريجيًا منطقتك بأكملها، فمن الأفضل أن توافق على طلبي.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "وما هو طلبك إذن؟ ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "أتمنى أن تعطيني الموارد والمال!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "ثم ماذا بعد؟ قل لنا أين نجد إخوانك!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "إذا رفضت، فمن المتوقع حدوث المزيد من الكوارث.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "يا سيدي، هذا الشخص الذي عين السحرة، ألا يمكن أن يكون دوق كان؟ تذكرت فجأة أنه وجه إليك التهديدات عندما بدأت في كتابة رسائل إلى الملكة فريغيث.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "قد لا يكون مستشارك مخطئًا، فأنت تتذكر الآن أن دوق كان قد طلب الزواج من الملكة فريغيث، ولكن بعد اجتماعكما وتلك الرقصة الشهيرة، رفضت طلبه.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "أيها الساحر الرخيص! إذن، دوق كان هو من عينك؟! نحن نعلم كل شيء!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "صحيح... لقد كشفت الأمر. لنعقد صفقة. أعطني مبلغًا جيدًا من المال وسنتركك أنا وإخوتي. لن نضايقك بعد الآن.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "يا سيدي، لسنا في وضع يسمح لنا بالتفاوض. دعنا نعطيه المبلغ الذي يطلبه وننتهي من أمر السحر هذا. لا يمكننا محاربة الكوارث الخارقة للطبيعة.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "على الرغم من أنك لا تحب أن تتعرض إلى الضغط، إلا أنك لا بد وأن تعترف بأن مستشارك على حق. فسلامة أهل البلدة أهم من غرورك.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "كل ما علينا فعله الآن هو إطلاق سراح الساحر ودفع المال له.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "سعيد بالعمل معك أيها الحاكم!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "اختفى الساحر مع رزمة كبيرة من النقود. لكنك لن تضطر أبدًا للتعامل معهم مرة أخرى.\n\nأما بالنسبة لدوق كان، فقد أرسلت رسالة إلى الملكة، والتي وعدت بتولي مسئولية قضيته شخصيًا. كل شيء انتهى بخير.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "بعد استعادتك إلى حواسك وإنقاذ مدينتك من النيران، تطلب من الحارس استدعاء السحرة الثلاثة. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "يخبرك جنودك أنهم تمكنوا من العثور على واحد فقط من السحرة الثلاثة. \n\nالاثنان الآخران مفقودان.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "سيدي! هل أنت بخير؟ السحرة فجروا المباني! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "نحتاج إلى إخماد الحرائق في أسرع وقت ممكن!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "تمت السيطرة على آخر الحرائق يا سيدي.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "يوجد ثلاثة سحرة. يبدو أنهم مرتاحون لأنك استجبت إلى طلبهم. توفر لهم غرفة في النزل. وحالما ترى أنهم لم يعودوا يحتاجون إلى أي شيء، تعود إلى مهام الحكم.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "بمجرد مغادرتك النزل، تسمع دويًا هائلًا. بووووووووم! الآن اشتعلت العديد من المباني!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "أغلقوا المنافذ.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "أوه، لا! ظهر وباء الطاعون واشتعلت الحرائق بالعديد من المباني! من المحتمل أنها خدعة السحرة!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "ههه ههه ههه ههه ههه ههه!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "لنسرع ونعالج أهل البلدة ونطفئ الحرائق!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "ومرة أخرى، نجونا من كارثة حقيقية...";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "أكملوا البحث.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "سنكمل البحث يا سيدي!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "ها هو أحدهم! اقبضوا عليه!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "يبدأ حراسك في مطاردة الساحر الثاني، وفجأة، غمر دخان كثيف القرية. يتوقف حراسك عن مطاردتهم، ولا يرون بعدها إلى أين هم ذاهبون.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "يا سيدي، نواجه مشكلة جديدة! لم يعد بإمكاننا التحرك بسرعة! يبدو الأمر وكأننا نسير داخل الهلام!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "يجب أن نتراجع إلى القلعة ونستجوب هذا الساحر الذي تمكنا من القبض عليه.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "وبناء على النصيحة، قررت أن تُحصن نفسك في أراضي القلعة، لتبدأ استجواب الساحر الأول. بالإضافة إلى ذلك، تطلب من رئيس الحراس تأمين القلعة حتى لا يتمكن أحد من دخولها أو مغادرتها.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "بفضل فخك المذهل قررت إبقاء السحرة بعيدًا عن بعضهما واستجواب الساحر الذي تمكنت من الإمساك به.\n\nلسوء الحظ، لم تتمكن من استعادة مواردك، أخذها الساحر الثالث معه.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "يبدو أن الساحر الثاني أكثر ثقة من الأول بكثير. ودون تردد يقول لك هذا: "تهانينا أيها الحاكم، لقد أمسكت بي متلبسًا. لكن اعلم أنك إن لم تحررني على الفور، فستحدث أشياء مروعة لقريتك."";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "حرره.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "تخاف مما قد تمر به قريتك وتقرر إطلاق سراحه.\n\nوقال الساحر: "أنت رائع، أيها الحاكم"، قبل أن يختفي في هالة من الدخان في اللحظة التي أزال فيها الحراس الأغلال.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "يا سيدي! هرب الساحر الأول أيضًا! ظهر شقيقه بجانبه ثم اختفى كلاهما!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "... عدنا إلى نقطة الصفر.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "سوف نقوم بدوريات من أجل القبض على هؤلاء الأوغاد يا سيدي! يمكنك الوثوق بنا.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "كل ما علينا فعله الآن هو انتظار عودة الدوريات يا سيدي.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "لفترة طويلة، كان حراسك يحاولون العثور على هؤلاء السحرة. ولكن بلا جدوى حتى الآن. ومع ذلك، يومًا بعد يوم، رأت المدينة أن السحابة الغريبة من الدخان التي كانت تبطئ عمل الجميع تتبدد ببطء.\n\nسيبقى لغز هؤلاء السحرة بلا حل.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "أبقِه سجينًا.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "السحرة";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "أدخلوهم.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "الأزرق.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "الأخضر.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "أعترف، إنه اختيار جريء. الأزرق. من يستطيع أن يكره مثل هذا اللون الجميل؟ لون الأحلام والحكمة والوفاء. هذا يقول الكثير عنك أيها الحاكم.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "استقبلنا ضيفًا في الغرفة المجددة بالقلعة يا سيدي.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "لسوء الحظ، أبقته ألوان الغرفة مستيقظًا وهو يحمّلك المسؤولية الكاملة.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "يا سيدي، كان ضيفنا مسرورًا بهذه الغرفة. أحب اللون بشكل خاص! قرر أن يمنحنا بعض الهيبة.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "إنها حقيقة أن اللون الأخضر معروف أنه يشير إلى سوء الحظ. لكنه أيضًا رمزًا للأمل والحظ والاستقرار. إنه يتناغم مع باقي ألوان الطبيعة الأخرى. لا بد وأن أقول، إنه اختيار جيد.";
"T_GAME_QUEST_THE_ROOM_DESC" = "أيها الحاكم، جددنا للتو إحدى غرف القلعة. أي لون سيكون أفضل؟";
"T_GAME_QUEST_THE_ROOM_TITLE" = "الغرفة";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "بالطبع لا.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "أرسل الجواسيس.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "لا يوجد شيء اسمه السحر.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "استدعِ الساحرة.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "سيدي، هذا بشع. كيف يعقل ذلك؟ أيمكن أن يكون ساحرًا بارعًا في السحر الأسود؟! لا ينبغي لأحد أن يمتلك مثل هذه القوى!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "هذا قرار حكيم. لنرسل أفضل جواسيسنا لمتابعة رجل البلدة المجنون هذا وننتظر تقريرهم.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "عاد جواسيسك بتقرير.\n\n"تابعنا رجل البلدة ذاك، سارق الفرحة. يبدو وكأن كلماته تثير حزنًا شديدًا لدى السكان. ولا يتذكر أهل البلدة اللحظات السعيدة في حياتهم."";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "يا سيدي! يبدو أن أحد سكاننا يسرق الفرح من رفاقه. \n\nقدم العديد من رجال البلدة شكاوى ضد هذا اللص. إليك شهادة أحد الضحايا: "جاء ليحدثني في صباح ما. استمعت إليه باهتمام وفجأة شعرت بحزن شديد. وكأن كلماته كانت تستهلك فرحتي".";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "هل يجب علينا فعل أي شيء لحل هذه المشكلة يا سيدي؟";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "أيها الحاكم، ماذا علينا أن نفعل؟";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "ساعد الساحرة.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "لا يوجد شيء اسمه أشباح.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "يبدو أن الإجراءات التي اتخذناها تعمل بشكل جيد يا سيدي.\n\nسارق الفرحة يستمر في آثامه، لكننا سنقاتله الآن. \n\nهل نرسل الحراس ونحاكمه على أفعاله؟ ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "لتأخذ العدالة مجراها.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "لا تفعل شيئًا.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "أنت شخص عاقل. فقط العلم يمكنه تفسير مشكلة سارق الفرحة هذه وحلّها.\n\nيمكنك استدعاء أفضل العلماء لديك للعمل على صيغة تسمح لأهل البلدة بأن يكونوا سعداء مجددًا.\n\nبالطبع، العلم ليس مجانيًا. يطلب العلماء الكثير من المال. وإلا، يمكنك أن تودّع السعادة تمامًا.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "لم تزعجك مشكلة سارق الفرح هذه بما فيه الكفاية. ومع ذلك، واصلت حالات اكتئاب أهل البلدة في الازدياد بشدة.\n\nمشوّشًا ذهبت للاحتماء في القلعة. دون أن تعرف ما الذي عليك فعله حيال هذه الكارثة. يقولون أن الوقت يداوي جميع الجراح. \n\nلنأمل ألا يبدأ صبرك في النفاد.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "رحلت الساحرة. يقول البعض حتى أنها غادرت القرية، ولا تريد أن تعاني مثل الآخرين بسببك.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "بعد وقت قصير من رحيلها. أصبح الوضع لا يطاق. يغلب الحزن العميق على جميع القرويين.\n\nمن يدري إلى متى سيستمر هذا؟";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "لنرسل الحراس لتحضره!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "ظل حراسك يبحثون لساعات وساعات. ولم يعثروا على شيء. عادوا جميعًا حزانى ومكتئبين. ومع ذلك يقولون إنهم سمعوا سارق الفرحة، لكنهم لم يرونه أبدًا.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "بعد وقت قصير من عودة الحراس، حلقت بومة برسالة من الساحرة.\n\nكشفت أن سارق الفرحة ليس سوى شبح يتغذى على فرح الناس. ولا يترك لهم سوى الحزن واليأس. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "على الرغم من الجهود التي بذلها علماؤك لتأخير العملية، فإن القرية بأكملها أصبحت حزينة. ومع رحيل الساحرة، لم يتبقَ لك أي وسيلة للدفاع عن نفسك أمام هذا الشبح.\n\nلنأمل أن يشفي الوقت أهل البلدة.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "مر الوقت وعادت القرية إلى مزاجها الجيد. سارق الفرح ذلك الآن ليس سوى ذكرى قديمة.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "اطلب المشورة من الساحرة.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "تفاوض.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "سأحاول التفاوض مع هؤلاء العلماء يا سيدي. دع الأمر لي، وسأعتني بكل شيء!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "إن مستشارك ذلك المفاوض الرائع نجح في خفض سعر العلماء! أحسنت. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "آخ، لم يستطع مستشارك التفاوض بشكل صحيح. ورفع العلماء الآن أسعارهم ولا يريدون مناقشة الأمر معك أكثر من ذلك.";
