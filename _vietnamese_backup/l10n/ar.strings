"T_GAME_QUEST_SCEN2_8_DESC" = "أخشى أن أخي لن يقدر على إنهاء العمل بنفسه... ربما يمكنك الوصول إلى مجموعة آخرين من الأشخاص لقريتنا؟";
"T_GAME_QUEST_SCEN2_8_NAME" = "زد السكان إلى 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "بدأت رقاقات ثلج في التكون فعلاً على أنفي... بل حتى إن بعض المسافرين الذين يبحثون عن مكان للإقامة فيه يعانون أكثر مني. أعتقد أننا يجب أن نسمح لهم بالاستقرار في قريتنا!";
"T_GAME_QUEST_SCEN2_9_NAME" = "ابن 6 منازل بلدة.";
"T_GAME_QUEST_SCEN3_10_DESC" = "من الأفضل لك يا عزيزي ألا تنسى أن غدًا هو يوم زفافنا، وفي يوم مثل هذا سأفرح بشدة ببعض المجوهرات الجديدة! فقط لو كنت تعرف صانع مشغولات ذهبية...";
"T_GAME_QUEST_SCEN3_10_NAME" = "ابن ورشة صانع مشغولات ذهبية.";
"T_GAME_QUEST_SCEN3_11_DESC" = "أنا متأكد أن الملك وسكان بلدتك سيفرحون كثيرًا بالأدوات الجديدة. لقد صارت الأدوات القديمة صدأة وعديمة الفائدة!";
"T_GAME_QUEST_SCEN3_11_NAME" = "ابن ورشة صانع أدوات.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "ابن ورشة خياط وأنتج ملابس.";
"T_GAME_QUEST_SCEN3_12_DESC" = "انظر إلى هذه الأغنام الجميلة. هل رأيتهم يا عزيزي؟ وانظر إلى تلك الكمية الكبيرة من الصوف التي تم قصها منهم! كل ما نحتاج إليه الآن مصنع نسيج وورشة خياط!";
"T_GAME_QUEST_SCEN3_12_NAME" = "ابن مصنع نسيج وأنتج ما يكفي من القماش.";
"T_GAME_QUEST_SCEN3_13_DESC" = "يشعر الأطفال بحماس شديد ومتشوقون للخبز الطازج الذي سيكون أمامهم قريبًا. لقد بنيت بضعة مخابز فعلاً يا عزيزي، أليس كذلك؟";
"T_GAME_QUEST_SCEN3_14_DESC" = "هل يمكنك تخيل ما حدث؟ ترغب أختي في الزواج أخيرًا! لكننا لا نزال بحاجة إلى كنيسة في بلدتنا. ليس لحفل الزفاف فقط، ولكن كذلك لسكان البلدة المتدينين!";
"T_GAME_QUEST_SCEN3_14_NAME" = "حقق رضا ديني كبير.";
"T_GAME_QUEST_SCEN3_15_DESC" = "انظر إلى هذا الآن يا عزيزي. تعافت البلدة من الأزمة وكل شيء يسير بسلاسة، لذلك أعطيك إذني بالاسترخاء مع أصدقائك وبناء حانة إذا كنت تحب ذلك! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "حقق رضا كبير بالحانات.";
"T_GAME_QUEST_SCEN3_1_DESC" = "انظر إلى هذه القرية المتهالكة يا عزيزي... إن سكان البلدة مساكين. أشعر بالأسف تجاههم. أعتقد أنك يجب أن تطلب المساعدة من الملك. ربما يمكنك إقناعه بإرسال بعض الهدايا إليه!";
"T_GAME_QUEST_SCEN3_1_NAME" = "ادفع جزية للملك وأكمل جميع المهام.";
"T_GAME_QUEST_SCEN3_2_DESC" = "يجب أن تتعامل مع الأمور بنفسك حتى يرسل الملك مساعدة. سكان البلدة بحاجة ملحة إلى المزيد من المياه!";
"T_GAME_QUEST_SCEN3_2_NAME" = "ابن بئرًا في قريتك.";
"T_GAME_QUEST_SCEN3_3_DESC" = "لم يتمكن الحاكم السابق من توفير ما يكفي من الطعام حتى. هذا لا يُصدق على الإطلاق. يجب أن تغيِّر من هذا الوضع على الفور يا عزيزي. لماذا لا تبني بضعة أكواخ صيادين سمك؟";
"T_GAME_QUEST_SCEN3_3_NAME" = "ابن كوخي صيادين سمك.";
"T_GAME_QUEST_SCEN3_4_DESC" = "هؤلاء الأطفال المساكين... لا يمكننا أن نطعمهم سمك فقط يا عزيزي. يجب أن تبني مزارع حتى نتمكن من زراعة قمح وحصده لعمل دقيق وخبز!";
"T_GAME_QUEST_SCEN3_4_NAME" = "ابن مزرعتين وأنتج قمح.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "ابن مصهر.";
"T_GAME_QUEST_SCEN3_5_DESC" = "مرحبًا يا عزيزي. ألا تنس شيئًا؟ ألم تخطط لإرسال بعض الهدايا إلى الملك لإقناعه بمساعدتنا؟ من حسن حظك أني معك... نحن بلا ريب بحاجة إلى منجم ومصهر قبل أن نتمكن من إنتاج أي شيء له قيمة!";
"T_GAME_QUEST_SCEN3_5_NAME" = "ابن منجمًا.";
"T_GAME_QUEST_SCEN3_6_DESC" = "جميع سكان بلدتك مرهقين من كثرة العمل. ألا يمكنك بناء بضعة منزل بلدة جديدة لجذب المزيد من العمال؟";
"T_GAME_QUEST_SCEN3_6_NAME" = "ابن 3 منازل بلدة.";
"T_GAME_QUEST_SCEN3_7_DESC" = "أنا في غاية السعادة. بدأت الأمور في التحسن أكثر وأكثر. بهذا يمكننا الآن بدء جمع ضرائب أكثر من سكان البلدة!";
"T_GAME_QUEST_SCEN3_7_NAME" = "اجمع 1500 تالر من الضرائب.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "اجمع ما يكفي من عملة تالر من الضرائب.";
"T_GAME_QUEST_SCEN3_8_DESC" = "هل تعرف ماذا أيضًا سيكون من اللطيف أن نملكه؟ بعض الملابس الجديدة. أعني للملك في المقام الأول بالطبع... لكن أولاً نحن بحاجة إلى بضعة مراعي غنم حتى يمكننا جمع الصوف!";
"T_GAME_QUEST_SCEN3_8_NAME" = "بناء 2 من مراعي الغنم.";
"T_GAME_QUEST_SCEN3_9_DESC" = "يعمل المزارعون بجد فعلاً في حصد القمح. يمكنك الآن بناء طاحونة حتى نتمكن من إنتاج الدقيق لعمل الخبز!";
"T_GAME_QUEST_SCEN3_9_NAME" = "ابن طاحونة وأنتج الدقيق.";
"T_GAME_QUEST_SCEN4_10_DESC" = "قلعتي غير مناسبة للوضع الملكي على الإطلاق، لذلك أخطط لتوسيع قلعتي الصيفية توسعة كبيرة. \n\nوبصفتي ملكك، أأمرك بتسليم كمية كبيرة من الحجارة. أعتمد على جودة عملك أيها المسؤول الكفء.";
"T_GAME_QUEST_SCEN4_10_NAME" = "سلِّم حمولة عربة من الحجارة للملك.";
"T_GAME_QUEST_SCEN4_11_DESC" = "تسببت الحرارة اللاذعة في ضرر كبير لمنازلنا. لقد تدهورت المنازل، والعديد من العائلات تطلب منك تحسين حالات مبانيهم.\n\nسيكون من الرائع لو أخذت تحسين حالات المباني في البلدة في عين الاعتبار.";
"T_GAME_QUEST_SCEN4_11_NAME" = "حقق سعادة عالية بمحالات المباني.";
"T_GAME_QUEST_SCEN4_12_DESC" = "أنا لا أزال في انتظار تسليم عصير العنب أيها المسؤول الكفء. ستبدأ المأدبة التي أستضيفها قريبًا.";
"T_GAME_QUEST_SCEN4_12_NAME" = "سلِّم عصير العنب إلى الملك.";
"T_GAME_QUEST_SCEN4_13_DESC" = "الطلب على الدقيق في المملكة عالي يا سيدي. لا تقدر المزارع على إنتاج ما يكفي من القمح كي تعمل الطاحونات بكامل طاقتها.\n\nإذا سلمتني ما يكفي من الدقيق يمكنني احتكار السوق وتأسيس مؤسسة احتكارية في المنطقة. سأكافئك بسخاء مقابل هذا بالطبع.";
"T_GAME_QUEST_SCEN4_13_NAME" = "سلِّم الدقيق إلى التاجر.";
"T_GAME_QUEST_SCEN4_14_DESC" = "يرغب سكان البلدة في بناء مظلات لحمايتهم من أشعة الشمس الحارقة بالنهار. يجب أن نوفر لهم ألواح خشب حتى يتمكنوا من البدء على الفور!";
"T_GAME_QUEST_SCEN4_14_NAME" = "أنتج 35 لوحًا.";
"T_GAME_QUEST_SCEN4_15_DESC" = "لقد تصرفت بحكمة يا سيدي. لقد نمت البلدة إلى حجم مثير للإعجاب.\n\nلكن لا يزال سكان البلدة غير سعداء على الإطلاق بسبب الجفاف. يجب أن تحاول زيادة السعادة بتلبية المزيد من رغباتهم. هذا مجرد اقتراح متواضع بالطبع...";
"T_GAME_QUEST_SCEN4_15_NAME" = "حقق سعادة عالية في بلدتك.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "بكل بساطة: مذهل يا مولاي!\nلقد تمكنت من بناء بلدة كبيرة بالرغم من الجفاف. يشعر سكان بلدتك بسعادة بالغة بالتغييرات التي أجريتها.\n\nوأنا -بصفتي ملكك- مسرور للغاية بعملك. لقد خدمت هذه المملكة خدمة كبيرة، وستحصل على المكافأة التي تستحقها.";
"T_GAME_QUEST_SCEN4_1_DESC" = "يعيش سكان البلدة في فقر وشقاء يا سيدي فالمملكة تعاني من جفاف. فقط انظر إلى ما كان يومًا ما نهرًا عظيمًا يجري بجوار القلعة مباشرةً. لم يتبق منه إلا بعض البرك الصغيرة...\n\nلقد كلفنا الملك بمهمة توسيع بلدتنا. لنبدأ ببناء بضعة منازل بلدة إضافية.";
"T_GAME_QUEST_SCEN4_1_NAME" = "ابن 8 منازل بلدة.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "لقد سر الملك بسماع توسعك الناجح في البلدة يا مولاي، لكنه يأمرنا ببناء بلدة أكبر من هذه.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "قم بالوصول إلى عدد 100 ساكن إجمالاً.";
"T_GAME_QUEST_SCEN4_2_DESC" = "بصفتي تاجر، يمكنني أن أساعد مساعدة كبيرة في مأزقك الحالي يا سيدي. \n\nقد تكون المملكة تعاني من جفاف، لكن يمكنني تسليم أكثر الإمدادات المطلوبة إلى بلدتك بمجرد بنائك لسوق.";
"T_GAME_QUEST_SCEN4_2_NAME" = "حقق سعادة عالية بالسوق.";
"T_GAME_QUEST_SCEN4_3_DESC" = "أتوسل إليك يا سيدي. أرجوك أعط الأوامر بتشييد آبار إضافية لتوفير ما يكفي من المياه للقرويين في هذه الحرارة.";
"T_GAME_QUEST_SCEN4_3_NAME" = "ابن بئرين.";
"T_GAME_QUEST_SCEN4_4_DESC" = "بشرى سارة يا مولاي. اكتشف أحد سكان البلدة أن برك المياه في مجرى النهر الجاف لا يزال بها بعض الأسماك. \n\nيجب أن نأمر ببناء بضعة أكواخ لصيادين السمك.";
"T_GAME_QUEST_SCEN4_4_NAME" = "ابن كوخي صيادين سمك.";
"T_GAME_QUEST_SCEN4_5_DESC" = "أود أن أقترح عليك اقتراحًا يا سيدي.\n\nإذا تمكنا من توسعة علاقتنا التجارية يمكنني أن أرتب لتسليمات منتظمة للطعام إلى بلدتك.";
"T_GAME_QUEST_SCEN4_5_NAME" = "اربح 1000 تالر من البيع في السوق.";
"T_GAME_QUEST_SCEN4_6_DESC" = "ها أنا أقدم لك اقتراحًا مرة أخرى. أنا بحاجة ملحة للفحم. وفِّر لي الفحم وأنا سأدفع لك كيسًا كبيرًا من عملات تالر.";
"T_GAME_QUEST_SCEN4_6_NAME" = "سلِّم الفحم إلى التاجر.";
"T_GAME_QUEST_SCEN4_7_DESC" = "بلاطي بحاجة ملحة إلى عصير العنب أيها المسؤول. لا يزال الجفاف يضرب مملكتي، كما أنه قد قضى على محصول العنب بالكامل.\n\nأأمرك ببناء مصنع عصير. كما أني أخطط لاستضافة مأدبة في قلعتي قريبًا، لذلك لا تخيب أملي!";
"T_GAME_QUEST_SCEN4_7_NAME" = "ابن مصنع عصير وأنتج عصير.";
"T_GAME_QUEST_SCEN4_8_DESC" = "بالكاد تقدر عائلتي على زراعة هذه التربة المتشققة من الجفاف يا سيدي. سيكون المحصول ضعيفًا، لذلك مزرعة واحدة لن تكفي.";
"T_GAME_QUEST_SCEN4_8_NAME" = "ابن مزرعة إضافية وأنتج ما يكفي من القمح.";
"T_GAME_QUEST_SCEN4_9_DESC" = "ينخفض مخزوننا من الخبز انخفاضًا خطيرًا يا مولاي. يجب أن نقلل من استهلاك الخبز بتوفير المزيد من اللحم للبلدة.";
"T_GAME_QUEST_SCEN4_9_NAME" = "أنتج ما يكفي من اللحم.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "أكمل جميع المهام واقض على الجفاف ووسع بلدتك لتصير مدينة!";
"T_GAME_QUEST_SCEN5_10_DESC" = "الآن لا يوجد إلا شيء واحد ناقص يا سيدي: عصير عنب للاحتفال بانتصارنا.\n\nنرجو منك تسليم كمية وفيرة من عصير العنب إلى معسكر الجيش!";
"T_GAME_QUEST_SCEN5_10_NAME" = "سلِّم 45 عصير عنب إلى الفارس.";
"T_GAME_QUEST_SCEN5_11_DESC" = "رائع جدًا يا مولاي.\nلقد نجح السيد بلانكينشتاين في إكمال حملته، ويتحدث عنك وعن دعمك بحفاوة بالغة.\n\nهل تود إجراء مقايضة واحدة أخيرة قبل أن أغادر هذه المنطقة؟";
"T_GAME_QUEST_SCEN5_11_NAME" = "اربح 2500 تالر من المقايضة.";
"T_GAME_QUEST_SCEN5_1_DESC" = "يا له من صباح جميل يا مولاي. أحمل لك أخبارًا سارة. لقد تواصل معنا تاجر حر.\n\nسيزور بلدتنا قريبًا، ولقد عبَّر عن حاجته لألواح الخشب لتشييد منصة سوق.";
"T_GAME_QUEST_SCEN5_1_NAME" = "أنتج 30 لوحًا.";
"T_GAME_QUEST_SCEN5_2_DESC" = "لقد أسست هنا مركز تجارة صغير لطيف يا سيدي. لا ينقصه إلا شيء واحد فقط: حانة. إذا بنينا حانة ستجذب بلدتنا الصغيرة المزيد من التجار والمسافرين.";
"T_GAME_QUEST_SCEN5_2_NAME" = "حقق رضا كبير بالحانات.";
"T_GAME_QUEST_SCEN5_3_DESC" = "جيد جدًا يا سيدي. ستفتح الحانة الباب أمام العديد من فرص التجارة في المستقبل.\nالآن اسمح لنا بالانتقال إلى الجزء المثير من اتفاقنا. لنقايض بعض السلع... ";
"T_GAME_QUEST_SCEN5_3_NAME" = "اربح 1500 تالر من المقايضة.";
"T_GAME_QUEST_SCEN5_4_DESC" = "هل تكرمت يا مولاي وخزنت أقمشة؟ لدي شريك تجاري يهتم اهتمامًا كبيرًا بالأقمشة.\n\nوقابلت كذلك فارسًا أثناء سفري. إنه في طريقه إلى هنا وقد يكون لديه بعض المهام المثيرة من أجلك.";
"T_GAME_QUEST_SCEN5_4_NAME" = "خزِّن 35 وحدة من القماش في مستودعك.";
"T_GAME_QUEST_SCEN5_5_DESC" = "أنا كونيبرت من بلانكينشتاين، فارس من فرسان الملك يا سيدي.\n\nمركز التجارة لديك مناسب بشكل مثالي لمساعدتي في مهمتي لطرد قطاع الطرق من هذه الأراضي. هل ستمدني بالحجارة حتى أتمكن من تشييد أبراج حراسة لحماية هذه المنطقة؟";
"T_GAME_QUEST_SCEN5_5_NAME" = "سلِّم 50 حجر للفارس.";
"T_GAME_QUEST_SCEN5_6_DESC" = "صانعو الأسلحة لدي في حاجة ملحة إلى حديد من أجل إمداد جيشي بالسيوف يا سيدي المسؤول.\n\nتوجد العديد من رواسب الخام بالقرب من مركز التجارة لديك. هل يمكنك إرسال شحنة حديد إلى خادمي؟";
"T_GAME_QUEST_SCEN5_6_NAME" = "سلِّم 65 قضبان حديد للفارس.";
"T_GAME_QUEST_SCEN5_7_DESC" = "أواجه مشكلة يا سيدي. تسبب بعض خدمي في خرق دروعهم أثناء المعركة الأخيرة ضد قطاع الطرق. \n\nأرجو منك تخزين أدوات حتى يتمكن جنودي من إصلاح دروعهم عند زيارة مركز التجارة.";
"T_GAME_QUEST_SCEN5_7_NAME" = "أنتج 25 أداة.";
"T_GAME_QUEST_SCEN5_8_DESC" = "لدي أخبار جيدة يا سيدي المسؤول. نجحت حملتي نجاحًا باهرًا وتم طرد قطاع الطرق من هذه المنطقة.\n\nاستهلكنا في هذه الحملة الطويلة جميع مؤننا، لذلك أنا بحاجة إلى تسليم بعض الطعام إلى جيشي.";
"T_GAME_QUEST_SCEN5_8_NAME" = "سلِّم 25 سمكة و25 خبز للفارس.";
"T_GAME_QUEST_SCEN5_9_DESC" = "تريد قواتي الاحتفال بانتصارنا على قطاع الطرق، لكن من بعد هزيمة قطاع الطرق ورجالي أصابهم الملل وضيق الصدر. \n\nهلا تبني منشآت ترفيهية في البلدة يا سيدي؟";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "تريد قواتي الاحتفال بانتصارنا على قطاع الطرق، لكن من بعد هزيمة قطاع الطرق ورجالي أصابهم الملل وضيق الصدر. \n\nهلا تبني ساحات مبارزة يا سيدي حتى يرفه فيها الجنود عن أنفسهم؟";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "حقق رضا كبير بساحات المبارزة.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "ابن مركز تجارة ناجح بإكمال جميع المهام!";
"T_GAME_QUEST_SCEN5_SUCESS" = "روعة الروعة يا مولاي. \nلقد نجحت في إنشاء مركز تجارة في هذا الموقع المهم من الناحية الاستراتيجية.\nالملك والسيد بلانكينشتاين في غاية السعادة من عملك ودعمك للحملة ضد قطاع الطرق في هذه المنطقة.";
"T_GAME_QUEST_SCEN6_1_DESC" = "أرسل الملك أمرًا. إنه يطلب كمية ضخمة من المواد لبناء كاتدرائية. لقد بدأ تشييد هذا المبنى الضخم بالفعل، لذلك يجب أن نسلِّم الموارد في أسرع وقتٍ ممكن.";
"T_GAME_QUEST_SCEN6_1_NAME" = "سلِّم موارد تشييد الكاتدرائية.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "قايض الصوف بالسمك.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "قايض خام الحديد بالسمك.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "قايض عصير العنب بالسمك.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "قايض خام الذهب بالسمك.";
"T_GAME_QUEST_SCEN6_2_NAME" = "قايض ألواح الخشب بالسمك.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "يمكنني رؤية عدم وجود بحيرات أو أنهار بالجوار، وهذا يعني أنه ليس بإمكانك إنتاج سمك. ابن سوقًا ويمكنني إعطاءك السمك مقابل العديد من السلع!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "ابن منجمين إضافيين.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "ابن 3 مناجم أخرى.";
"T_GAME_QUEST_SCEN6_3_DESC" = "يجب أن نبدأ في التعدين على الفور. تأكد أننا نملك ما يكفي من المناجم العاملة حتى نتمكن من الالتزام بجدول التسليم.";
"T_GAME_QUEST_SCEN6_3_NAME" = "ابن منجمًا.";
"T_GAME_QUEST_SCEN6_4_DESC" = "يعمل سكان بلدتك بأقصى طاقة لديهم حتى يتمكنوا من استخراج كل ذلك الخام. تأكد من توفير ما يكفي من الطعام لهم حتى يقدروا على العمل بكفاءة!";
"T_GAME_QUEST_SCEN6_4_NAME" = "ابن مخبز وأنتج بعض الخبز.";
"T_GAME_QUEST_SCEN6_5_DESC" = "لا بأس بعملنا، لكن لا يزال علينا صهر الخام!";
"T_GAME_QUEST_SCEN6_5_NAME" = "ابن مصهرين.";
"T_GAME_QUEST_SCEN6_6_DESC" = "العمل في المناجم المظلمة شديدة الرطوبة بدون الملابس الملائمة يمكن أن يكون مضرًا للغاية. يجب عليك توفير لسكان بلدتك ملابس دافئة. أنا متأكد أنهم سيقدِّرون هذا كثيرًا!";
"T_GAME_QUEST_SCEN6_6_NAME" = "سلِّم 25 قطعة من الملابس.";
"T_GAME_QUEST_SCEN6_7_DESC" = "نحن نتج الموارد بمعدل هائل يا سيدي. نحن بحاجة إلى مستودعات أكثر لتخزين كل هذه الموارد!";
"T_GAME_QUEST_SCEN6_7_NAME" = "ابن مستودعين.";
"T_GAME_QUEST_SCEN6_8_DESC" = "العمل في المناجم شاق ومرهق. سيحب سكان البلد أن يكون متوفرًا لهم مكانًا للاسترخاء بعد يوم شاق من العمل. الحانة مثالية في هذا الأمر! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "ابن حانة.";
"T_GAME_QUEST_SCEN6_END_DESC" = "أحسنت! من الرائع أنك تمكنت من تسليم جميع الموارد المطلوبة للكاتدرائية، لكن ستستغرق عملية التشييد بعض الوقت.\n\nستحيا الكاتدرائية ذكرى ملكنا العظيم الذي أسهمت أفعاله في عصر من السلام والوئام اللذان سيمتدان لقرون!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "تذكر أنه يمكنك إزالة الأشجار الحاجبة. استخدم المجرفة في تحديد الأشجار التي ترغب في التخلص منها.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "لا يمكننا خبز تورتة زفاف بدون وجود المكونات المطلوبة يا مولاي. هلا تكرمت ببناء مزرعة حتى يمكننا إنتاج الدقيق بأنفسنا؟";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "ابن مزرعة.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "ابن طاحونة.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "أنتج 25 خبز.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "سيكون هذا حفل زفاف أسطوريًا. أولاً نحن بحاجة إلى التأكد من وجود تورتة زفاف ممتازة. هل يمكنك من فضلك بناء مخبز بينما أختار فستان زفافي؟";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "ابن مخبز.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "أنا بحاجة إلى سوق حتى يمكنني التخلص من جميع هدايا الزفاف التي لا تعجبني!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "حقق سعادة عالية بالسوق.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "نتقدم تقدمًا ملحوظًا يا سيدي في تجهيزات الزفاف، لكننا بحاجة إلى المزيد من الأدوات لبناء سرداق الزفاف!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "ابن ورشة صانع أدوات.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "أنتج 20 أداة.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "أريد عقد حفل زفافنا في كنيسة جميلة. هل بنيت واحدة بالفعل؟";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "حقق سعادة دينية عالية.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "ابن مرعى غنم.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "ابن مصنع نسيج.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "أنتج 20 قطعة ملابس.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "هل يمكنك تصديق هذا؟ لم أتمكن من العثور على فستان زفاف مناسب في أي مكان! أنا بحاجة إلى فستان على الفور. اجعل أفضل خياط لديك يفصِّل واحدًا.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "ابن ورشة خياط.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "ابن زينة.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "زد من سعادة سكان بلدتك!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "هذا المكان كئيب... هل يمكنك من فضلك جعل هذه البلدة أجمل؟ أريد أن يشعر الجميع بسعادة مثل سعادتي!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "لا أبالي بالتورتة والزهور، بل كل ما أريده احتفال كبير مع الكثير من العصير. وأريد كذلك دعوة البلدة بأكملها، لكننا لا نملك مساحة كافية لاستضافة جميع ضيوف الزفاف!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "ابن منازل بلدة صغيرة أخرى.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "أريد مكانًا لطيفًا أقابل فيه أصدقائي بمجرد انتهاء الزفاف. هذه البلدة بحاجة ملحة إلى حانة!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "حقق رضا كبير بالحانات.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "أنتج 25 عصير عنب.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "سيشعر أصدقائي بعطش شديد. هل اهتممت بأمر العصير أم ليس بعد؟";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "ابن مصنع عصير.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "سيصل ضيوف أكثر مما توقعنا. ابن منزل بلدة كبير.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "ابن منزل بلدة كبير.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "أنتج 15 مجوهرات.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "أوه، لا! أنا في مشكلة عويصة. لقد أضعت خاتم زفافي! أرجوك لا تخبرها. هل يوجد صانع مشغولات ذهبية في البلدة يمكنه صنع خاتم جديد؟";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "ابن ورشة صانع مشغولات ذهبية.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "قبل أن أتزوج، أريد أن أثير إعجاب خطيبتي في ساحات المبارزة!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "ابن ساحات مبارزة.";
"T_GAME_QUEST_SCEN8_10_DESC" = "إن غرف التخزين في القلعة متكدسة بالسلع بالفعل يا سيدي. هل يمكن أن أقترح أن نطلب تشييد مستودعات إضافية؟";
"T_GAME_QUEST_SCEN8_10_NAME" = "ابن مستودع جديد.";
"T_GAME_QUEST_SCEN8_11_DESC" = "سيسعد الرجال في البلدة أكثر إذا كان هناك مكانًا لهم يلتقون فيه ويتناولون كوباً من عصير العنب بعد يوم شاق من العمل. أخشى أن يكون هذا طلبًا كبيرًا يا سيدي.";
"T_GAME_QUEST_SCEN8_11_NAME" = "حقق رضا كبير بالحانات.";
"T_GAME_QUEST_SCEN8_12_DESC" = "لقد بنى الحداد مواقد تسخين بسيطة لسكان بلدتنا يا سيدي، لكننالا نزال بحاجة إلى الفحم لتشغيلها.";
"T_GAME_QUEST_SCEN8_12_NAME" = "أنتج 50 فحم.";
"T_GAME_QUEST_SCEN8_1_DESC" = "ينقص البلدة حطب لتدفئة المنازل يا سيدي. من المهم للغاية أن نخزِّن الخشب!";
"T_GAME_QUEST_SCEN8_1_NAME" = "أنتج 75 حطب.";
"T_GAME_QUEST_SCEN8_2_DESC" = "البلدة في حالة يُرثى لها. انظر إلى كل تلك المنازل المتهالكة. على الأرجح عاصفة ثلجية واحدة كافية لانهيار معظمها. لنجلب نجارًا إلى البلدة للمساعدة في إصلاحات المباني.";
"T_GAME_QUEST_SCEN8_2_NAME" = "ابن ورشة نجار.";
"T_GAME_QUEST_SCEN8_3_DESC" = "هذا الشتاء القارس إشارة واضحة من السماء يا سيدي. يجب علينا التكفير عن خطايانا. لنشيِّد بيتًا لله لاسترضاء القدير.";
"T_GAME_QUEST_SCEN8_3_NAME" = "حقق رضا ديني كبير.";
"T_GAME_QUEST_SCEN8_4_DESC" = "يشعر سكان البلدة بالكسل والملل يا سيدي. الأجواء شديدة البرودة في المنازل. أعتقد أننا يجب أن نخزِّن الصوف، ويمكن لسكان البلدة استخدامه في عزل منازلهم عن البرد.";
"T_GAME_QUEST_SCEN8_4_NAME" = "أنتج 55 صوف.";
"T_GAME_QUEST_SCEN8_5_DESC" = "أرسل لنا حاكم الإقليم المجاور حمامة زاجلة بالتماس مساعدة. إنهم في حاجة ملحة لملابس دافئة للناس هناك.";
"T_GAME_QUEST_SCEN8_5_NAME" = "سلِّم حمولة عربة من الملابس إلى الإقليم المجاور.";
"T_GAME_QUEST_SCEN8_6_DESC" = "لا يمكن للمزارع إنتاج القمح في الشتاء يا سيدي. لنرسل بعض سكان المدينة إلى الغابة لاصطياد الغزلان.";
"T_GAME_QUEST_SCEN8_6_NAME" = "ابن بعض أكواخ الصيادين.";
"T_GAME_QUEST_SCEN8_7_DESC" = "لقد تعرضت المملكة لأضرار شديدة من الشتاء القارس يا خادمي المخلص، ومن ثم انخفض الدخل الضريبي بشدة. \n\nأأمرك ببناء خزانة من أجل زيادة الدخل الضريبي وإرسال لي حمولة عربة كبيرة من عملة تالور جزية.";
"T_GAME_QUEST_SCEN8_7_NAME" = "ابن خزانة وسلِّم جزية من العملات للملك.";
"T_GAME_QUEST_SCEN8_8_DESC" = "الآن بعد أن صار يوجد نجار في بلدتنا، لن يشكِّل إصلاح كل هذه المنازل المنهارة أي مشكلة. سيُسر سكان البلدة بهذا كثيرًا.";
"T_GAME_QUEST_SCEN8_8_NAME" = "تأكد أن جميع منازل البلدة تم إصلاحها.";
"T_GAME_QUEST_SCEN8_9_DESC" = "لحوم الحيوانات متوفرة دائمًا، حتى في الشتاء، ويمكن تقديمها بدلاً من الخبز. لنتأكد من وجود كمية لحم تكفينا طوال الشتاء.";
"T_GAME_QUEST_SCEN8_9_NAME" = "أنتج 50 لحم.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "الشتاء أقسى مما توقعناه يا سيدي، وسكان البلدة غير راضين عن هذا الوضع.\n\nعلينا التصرف بسرعة وإلا لن نصمد في فصل الشتاء!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "انج بالبلدة من فصل الشتاء...";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "سكان البلدة في غاية السعادة بالتقدم الذي حققناه يا سيدي. \n\nلقد وفرنا الآن ما يكفينا طوال شهور الشتاء، بل تمكنا حتى من مساعدة الإقليم المجاور. نحن الآن جاهزون، ولن يضرنا هذا الشتاء في شيء!";
"T_GAME_QUEST_SCEN9_10_DESC" = "سمعت أنك تواجه مشكلات مع المتمردين في منطقتك يا سيدي. يسرني أن اقود فرقة بحث ونذهب إلى الغابة، لكن يطلب المرتزقة الذين يعملون معي الدفع مقدمًا.";
"T_GAME_QUEST_SCEN9_10_NAME" = "ادفع للمرتزقة.";
"T_GAME_QUEST_SCEN9_11_DESC" = "لدي طلب آخر يا خادمي المخلص. أنا بحاجة إلى تحقيق أقصى استفادة للملك،و هذا يعني الحلي الذهبية الفخمة.\n\nأأمرك بتسليمي الذهب الذي أحتاج إليه لهذا الغرض. لا تخيب أملي في هذا الأمر.";
"T_GAME_QUEST_SCEN9_11_NAME" = "سلِّم خام الذهب إلى الملك خلال الوقت المحدد.";
"T_GAME_QUEST_SCEN9_12_DESC" = "تشيد أسطولي الجديد يسير بشكل جيد يا خادمي المخلص، لكننا لا نزال بحاجة إلى كميات ضخمة من أقمشة الأشرعة. أأمرك بتسليمي ما يكفي من الأقمشة لصنع أشرعة لجميع سفني.";
"T_GAME_QUEST_SCEN9_12_NAME" = "سلِّم القماش لإنتاج أقمشة الأشرعة.";
"T_GAME_QUEST_SCEN9_13_DESC" = "اكتشف رجالي شيئًا: وجدنا مسارات لقطاع الطرق في الغابة، لكننا بحاجة إلى مؤن أكثر قبل أن نتمكن من إجراء أي تحقيق في هذا الأمر.";
"T_GAME_QUEST_SCEN9_13_NAME" = "سلِّم مؤن للمرتزقة.";
"T_GAME_QUEST_SCEN9_14_DESC" = "لقد فقدت شحنة كاملة من ألواح الخشب لقطاع الطرق في إقليمك أيها الحاكم. يجب أن يتوقف هذا. سلِّم لي المزيد من ألواح الخشب في أسرع وقتٍ ممكن.";
"T_GAME_QUEST_SCEN9_14_NAME" = "سلِّم ألواح خشب لدعم تشييد أسطول الملك.";
"T_GAME_QUEST_SCEN9_15_DESC" = "وجد جامع الضرائب دليلاً على وجود صلة بين قطاع الطرق في الغابة والمخرِّب في البلدة يا سيدي. إنه يرفض إخبارنا بالمزيد لأنه يخشى على حياته.\n\nإنه يطلب منا إعفائه من واجباته كجامع ضرائب، ويريد كذلك مجموعة من الملابس الجديدة حتى يتمكن من مغادرة البلدة والاختباء. عندها فقط سيخبرنا بما اكتشفه.";
"T_GAME_QUEST_SCEN9_15_NAME" = "الغ تكليف جامع الضرائب من الخزانة ووفِّر له ملابس جديدة حتى يتمكن من التسلل من البلدة بدون أن يكشفه أحد.";
"T_GAME_QUEST_SCEN9_16_DESC" = "أوفى جامع الضرائب بوعده يا سيدي وكشف عن هوية المخرب قبل أن يغادر البلدة.\n\nإنه المرتزقة ورجاله. إنهم محتالين يتنقلون من بلدة إلى أخرى ويعرضون "حماية" مقابل المال من قطع الطرق التي يرتكبونها بأنفسهم لكن سرًا!";
"T_GAME_QUEST_SCEN9_17_DESC" = "أخبار سيئة يا سيدي. شخص ما اقتحم المستودع وسرق جميع اللحم!\n\nلنضع بعض المشاعل في أنحاء المدينة، فيمكن لهذا أن يساعدنا على الإمساك باللصوص في الليل.";
"T_GAME_QUEST_SCEN9_17_NAME" = "ابن 7 مشاعل حول المدينة لردع اللصوص.";
"T_GAME_QUEST_SCEN9_18_DESC" = "بما أننا لن يزورنا أي تجار متجولين عما قريب يا مولاي، نحن بحاجة إلى ساحة تخزين إضافية لتخزين جميع سلعنا. \n\nوإضافةً إلى هذا، يجب أن نوقف أي عمليات إنتاج لا لزوم لها لضمان عدم امتلاء المستودعات عن آخرها.\n\nسيكون من الحكمة بناء مستودع آخر.";
"T_GAME_QUEST_SCEN9_18_NAME" = "ابن مستودع آخر في المدينة.";
"T_GAME_QUEST_SCEN9_19_DESC" = "يرتعد سكان البلدة خوفًا من المخرب ويخشون الخروج وإصلاح مبانيهم.\n\nأعتقد أننا يجب أن نبني ورشة نجار إذا كنا نريد إتمام الإصلاحات.";
"T_GAME_QUEST_SCEN9_19_NAME" = "ابن ورشة نجار.";
"T_GAME_QUEST_SCEN9_1_DESC" = "صباح الخير يا سيدي. اليوم طقس شتوي جميل. أمامنا في الشهور القادمة العديد من الأعمال. \n\nلنبدأ على الفور ببناء مجموعة من أكواخ الصيادين، ما رأيك؟";
"T_GAME_QUEST_SCEN9_1_NAME" = "ابن بعض أكواخ الحراجة.";
"T_GAME_QUEST_SCEN9_20_DESC" = "أتيت إليك بطلب يا سيدي. الطلب على الأدوات عالي في جميع أنحاء المملكة.\n\nسأدفع بسخاء لك إذا تمكنت من تسليمي حمولة عربة كبيرة من الأدوات، كما أني سأزور بلدتك مرة أخرى للمقايضة.";
"T_GAME_QUEST_SCEN9_20_NAME" = "سلِّم حمولة عربة من الأدوات للتاجر.";
"T_GAME_QUEST_SCEN9_2_DESC" = "لدي أخبار مهمة يا سيدي. وصلت عصابة من المرتزقة، وقد بدأوا بالفعل في الشكوى من افتقار قريتنا لحانة. \n\nيجب أن نحاول تفادي وجود مجموعة من المرتزقة غير السعداء والشاعرين بالملل في بلدتنا، لذلك لنبني حانة. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "حقق سعادة عالية بالحانة.";
"T_GAME_QUEST_SCEN9_3_DESC" = "يسرني رؤية أن مجهوداتك لزيادة إنتاج الخشب تتقدم جيدًا أيها الحاكم.\n\nالآن، هلا تكرمت وخصصت أول تسليم لي...";
"T_GAME_QUEST_SCEN9_3_NAME" = "ادفع للملك جزية من الخشب.";
"T_GAME_QUEST_SCEN9_4_DESC" = "توجد شائعات قوية عن اضطرابات في البلدة يا سيدي. هل يمكن أن يكون بعض سكان البلدة يتآمرون على التاج؟\n\nإذا لم نتصرف الآن يمكن أن يصل الأمر إلى تمرد كامل. يجب أن نتأكد من سعادة سكان البلدة ورضاهم، ويجب أن نفعل هذا بسرعة.";
"T_GAME_QUEST_SCEN9_4_NAME" = "حقق سعادة أعلى من 100% للبضع دقائق التالية.";
"T_GAME_QUEST_SCEN9_5_DESC" = "كارثة يا سيدي. كارثة! تدمرت الحانة بالكامل. يقول الناس إنه يوجد مخرب طليق في بلدتي. \n\nيجب أن نسيطر على الموقف قبل أن يخرج كل شيء عن السيطرة. ستفي المشانق والمشاهر بالغرض.";
"T_GAME_QUEST_SCEN9_5_NAME" = "ابن مشانق ومشهرتين في البلدة.";
"T_GAME_QUEST_SCEN9_6_DESC" = "سيكون من الحكمة رفع المعنويات في البلدة أكثر يا سيدي. \n\nإظهار بعض العطف تجاه سكان بلدتك سيزيد من سعادتهم. لماذا لا نبني لهم كنيسة أو نزيد من جمال البلدة ببعض حدائق الزهور؟";
"T_GAME_QUEST_SCEN9_6_NAME" = "ابن بعض حدائق الزهور وكنيسة.";
"T_GAME_QUEST_SCEN9_7_DESC" = "يؤسفني إخبارك أيها الحاكم أني لا يمكنني زيارة بلدتك في الوقت الراهن.\nسمعت شائعات عن قطاع طرق في الغابة المحيطة ببلدتك. زيارة بلدتك في الوقت الحالي أمر خطير للغاية على التجار.\n\nولدي رسالة لك من الملك: يأمرك بتشييد مبنيين لنشر الخشب.";
"T_GAME_QUEST_SCEN9_7_NAME" = "ابن مبنيي نشر خشب.";
"T_GAME_QUEST_SCEN9_8_DESC" = "ليس لدي أي فكرة يا سيدي. يجب أن نشيد خزانة. سيزور جامع الضرائب كل منزل في البلدة... وربما يقدر على معرفة أي شيء عن هذا المخرب.";
"T_GAME_QUEST_SCEN9_8_NAME" = "ابن خزانة وانتظر حتى يفتش جامع الضرائب منازل البلدة.";
"T_GAME_QUEST_SCEN9_9_DESC" = "تعرض مبنى نشر الخشب للتخريب يا سيدي. أيضًا لم ينجح جامع الضرائب حتى الآن في كشف هوية المخرب يا سيدي.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "لم تمنع الاضطراب في الوقت المناسب!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "لقد فشلت! بسبب عدم كفاءتك اضطررت إلى طلب ذهبي من بلدة أخرى!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "قريبًا سأأمر بتشييد أسطول عظيم من السفن الحربية أيها الحاكم. \n\nوبلدتك لديها إمكانية أن تكون أكبر مورد للخشب المطلوب لهذا المشروع العملاق. تأكد من تلبية هذا.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "هرب المرتزقة وعصابته من المنطقة أيها الحاكم. سيطاردهم رجالي بكل شراسة.\n\nأود كذلك أن أعبر لك عن شكري لدعمك في تشييد أسطولي الجديد ودعوتك إلى أول رحلة للسفينة الشراعية الجديدة. اتمنى لك يومًا طيبًا حتى يحين ذلك الوقت...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "ادعم الملك في مشروعه.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "جيد جدًا. لقد منعت وقوع اضطراب في البلدة!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "جيد جدًا. لقد سلمت في الوقت المناسب!";
"T_GAME_QUEST_SCEN_10_DESC" = "سيحصل فرساننا على الترفيه في الحانات المحلية بمجرد انتهاء المسابقة! لكنني أشعر بالقلق، لأننا ليس لدينا ما يكفي من الحانات ولا عصير العنب! يجب حل هذه المشكلة على الفور!";
"T_GAME_QUEST_SCEN_10_NAME" = "الحصول على رضا كبير من الحانة.";
"T_GAME_QUEST_SCEN_11_DESC" = "عمل ممتاز أيها المسؤول! أوشكت البلدة على أن تكون جاهزة، على عكسي وبناتي! أريد أفخر الملابس التي يستطيع خياطوك تفصيلها!";
"T_GAME_QUEST_SCEN_11_NAME" = "دفع جزية من 35 قطعة ملابس.";
"T_GAME_QUEST_SCEN_12_DESC" = "نقترب من افتتاح المسابقة الآن، لكنني لا أريد رؤية أي وجوه حزينة في البلدة! احرص على أن يكون أهل البلدة سعداء!";
"T_GAME_QUEST_SCEN_12_NAME" = "تحقيق سعادة كبيرة.";
"T_GAME_QUEST_SCEN_1_DESC" = "مرحبًا أيها المسؤول الصالح! كما ينبغي لك أن تعلم، فأنا أخطط لاستضافة أكبر مبارزة في المنطقة! وأريد منك بناء 3 ساحات مبارزة على الأقل لهذا الحدث! لا تخيب ظني!";
"T_GAME_QUEST_SCEN_1_NAME" = "بناء 3 ساحات مبارزة.";
"T_GAME_QUEST_SCEN_2_DESC" = "سيشعر ضيوف المسابقة بالجوع بالتأكيد! أريد منك البدء في إنتاج الخبز على الفور وتقديمه لملكك بصفته جزية!";
"T_GAME_QUEST_SCEN_2_NAME" = "دفع جزية من 25 رغيف خبز.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "ابن طاحونة وأنتج الدقيق.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "بناء مخبزين وإنتاج الخبز.";
"T_GAME_QUEST_SCEN_3_DESC" = "يا سيدي، لا يجدر بنا أن نبقي الملك منتظرًا! نحتاج إلى قمح ودقيق لنبدأ في إنتاج الخبز!";
"T_GAME_QUEST_SCEN_3_NAME" = "بناء مزرعة وإنتاج القمح.";
"T_GAME_QUEST_SCEN_4_DESC" = "عمل رائع أيها المسؤول! لكن الخبز وحده لن يكفي لإشباع ضيوفنا! أريد سمكًا طازجًا ليكون جزية لملكك!";
"T_GAME_QUEST_SCEN_4_NAME" = "دفع جزية من 25 سمكة.";
"T_GAME_QUEST_SCEN_5_DESC" = "أريد تنظيم مسابقة لا تُنسى! سيحمل فرساننا رماحًا ذهبية وستتألق ساحات المبارزة وستلمع! أسدني معروفًا واجمع الضرائب من أجل ملكك!";
"T_GAME_QUEST_SCEN_5_NAME" = "دفع جزية قيمتها 1000 تالر.";
"T_GAME_QUEST_SCEN_6_DESC" = "أنا على يقين من أن ضيوفنا سيستمتعون بمذاق عصير العنب الطازج الشهي! ابنِ مصانع عنب! ويمكنك تقديم النفايات رديئة الجودة في الحانات المحلية!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "أنا على يقين من أن ضيوفنا سيستمتعون بمذاق عصير العنب الطازج الشهي!";
"T_GAME_QUEST_SCEN_6_NAME" = "ابن مصنع عصير وأنتج عصير.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "بناء مصنع نسيج وإنتاج الأقمشة.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "ابن ورشة خياط وأنتج ملابس.";
"T_GAME_QUEST_SCEN_7_DESC" = "صارت سترات فرساننا بالية ورثة ولا يسرني مظهرها أيها المسؤول! اذهب واجلب سترات جديدة! ابنِ مراعي غنم وعيّن نساج وابنِ ورشة خياط، إذا أردت الاحتفاظ بمنصبك!";
"T_GAME_QUEST_SCEN_7_NAME" = "بناء 2 من مراعي الغنم.";
"T_GAME_QUEST_SCEN_8_DESC" = "علينا بيع مزيد من البضائع من أجل المال يا سيدي. من الأفضل دائمًا أن يكون معنا عملات تالر احتياطية لتغطية النفقات المستقبلية.";
"T_GAME_QUEST_SCEN_8_NAME" = "جني 500 تالر من التجارة.";
"T_GAME_QUEST_SCEN_9_DESC" = "أرى أن الأمور تسير على نحو جيد، لكن لا تزال البلدة قبيحة! أريد نافورات وجدران من الحجر الأبيض وأشجار خضراء ناضرة وتماثيل عظيمة! عليك تجميل البلدة بمزيد من الديكورات!";
"T_GAME_QUEST_SCEN_9_NAME" = "زيادة السعادة من الديكورات.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "ينصح في البداية بتعيين عامل في أحد أكواخ الحراجة في المنطقة.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "تعيين عامل في كوخ الحراجة.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "إحدى المهمات الأساسية بناء سوق.\nلإكمال هذا التكليف، يجب تأسيس سلاسل إنتاج لعدة موارد وجمع الموارد اللازمة يا سيدي.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "تشييد سوق.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "يا سيدي، أنصح بتعيين أحد أهل البلدة في مبنى نشر الخشب حتى نتمكن من إنتاج الألواح في أقرب وقت.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "تعيين عامل في مبنى نشر الخشب.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "يا سيدي، أنصح بتعدين الحجر بدلًا من خام المعادن.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "بمجرد جمع بعض الألواح والخشب، يجب تعيين أحد العمال في المنجم والبدء في تعدين الحجر.";
"T_GAME_QUEST_SCEN_CC_47_END" = "عمل جيد يا سيدي. ما علينا الآن إلا الانتظار حتى تشييد السوق.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "تعيين عامل في المنجم.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "مهمتك الأساسية التالية بناء حانة.\n\nعلينا البدء في تشييد المبنى في الحال.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "بناء حانة";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "أخبار سارة يا سيدي. أتى بعض أهل البلدة لمساعدتنا في مهمتنا. يجب بناء منزل بلدة لهم.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "بناء منزل بلدة.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "نحتاج إلى ورشة صانع أدوات من أجل تشييد الحانة. أنصح بالبدء بتشييد مصنع فحم.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "بناء كوخ مصنع فحم.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "المبنى التالي الذي نحتاج إليه المصهر. يمكننا من خلاله البدء في إنتاج سبائك الحديد.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "ابن مصهر.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "يا سيدي! من أجل البدء في إنتاج الأدوات، نحتاج إلى تشييد ورشة صانع أدوات في البلدة.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "بناء ورشة صانع أدوات.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "توشك إمدادات الطعام على النفاد يا مولاي. يجب أمر أحد أهل البلدة بصيد بعض الأسماك أو صيد بعض الحيوانات. إذا لم يحصل أهل البلدة على الطعام بسرعة، فستقل إنتاجيتهم.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "إنتاج بعض الطعام.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "أنا تاجر بسيط في خدمتك يا سيدي. أرى أنك بحاجة إلى المال من أجل إنشاء مشروعاتك.\nيمكنني شراء بعض خام الحديد منك إذا شئت.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "قايض بعض البضائع مع التاجر.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "هل نفدت أموالك يا مولاي؟ لا مشكلة. أنا على استعداد لشراء بعض جلود الحيوانات منك.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "أيها الحاكم، أنا بحاجة إلى بعض كتل الذهب الخام. هل تود بيع بعضها لي؟";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "يا سيدي، لا أشعر بأنني على ما يرام. يجب أن يفحصني طبيب.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "علاج أهل البلدة المرضى.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "حريق! يجب على أحد أهل البلدة إخماد النيران فورًا.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "إخماد الحريق.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "يسبب قطاع الطرق لنا المتاعب حتى هنا. يجب تعيين بعض أهل البلدة في أبراج الحراسة يا سيدي، لكي نتمكن من التصدي للهجوم.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "الدفاع عن البلدة ضد قطاع الطرق.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "يا سيدي، هل يمكننا نيل قسط من الراحة وأكل وجبة خفيفة؟";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "إنتاج بعض الخبز.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "يا سيدي، ليس لدينا إلا قليل من أهل البلدة لهذا التحدي. علينا تعيينهم في المباني بالتناوب كما نراه مناسبًا.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "تهانينا. نجحت في هذا التحدي ببراعة.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "استخدم أهل البلدة بحكمة لتنفيذ كل المهمات.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "أخبار سارة يا سيدي. بدأت الأشجار تنمو مرة أخرى على شبه الجزيرة بجانب القلعة.\n\nأقترح بناء كوخ حراجة هناك للحصول على الخشب بسهولة.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "يا سيدي، كل أكواخ الحراجة متدهورة ومهجورة!\n\nقُطعت الأشجار في هذه المنطقة بالكامل. لم يعد هناك جدوى من أكواخ الحراجة. \nأنصح بتدمير كل المباني التي لم يعد لها فائدة للحصول على بعض الخشب.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "هدم أكواخ الحراجة.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "أظن أنه يجب سؤال الناس في هذه القرية يا سيدي. قد يكون لديهم بعض الخشب الفائض عن احتياجهم.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "الملك في انتظار أول شحنة من الألواح.\n\nيمكننا تعيين أحد أهل البلدة في مبنى نشر الخشب والبدء في إنتاج الألواح. أنصح بمتابعة مخزون الخشب. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "تعيين أحد أهل البلدة في مبنى نشر الخشب.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "كيف الأحوال أيها الحاكم؟ أنتظر وصول ثلاث شحنات.\n\nعليك تحضير الشحنة الأولى في أسرع وقت ممكن. لا تخيب ظني!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "توصيل البضائع إلى الملك.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "يا سيدي، سُرّ الملك بأول شحنة من الألواح.\nيجب إعداد الشحنة التالية في أسرع وقت ممكن.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "الملك في انتظار الشحنة الأخيرة. فبعد استلامه الألواح، سيمكن زيادة حجم الأسطول الملكي ليصبح مهولًا.\n\nعلينا إتمام تلك الشحنة.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "هل تتساءل لما لم يحصل الملك على الشحنة بعد؟ أظن أن لدي الإجابة عن هذا.\n\nباختصار: ادفع لي فدية بسيطة، وستصل الشحنة إلى الملك دون تأخير أكثر.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "دفع الفدية.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "أحتاج إلى كثير من الألواح لبناء الأسطول الملكي.\nلسوء الحظ، لم تصلني أي شحنات منذ وقت طويل.\n\nأريد أن أطلب منك معروفًا أيها الحاكم! اكتشف لما توقفت الشحنات عن الوصول وحل المشكلة!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "أحسنت عملًا أيها الحاكم. علمت أنني يمكنني الاعتماد عليك.\n\nبفضل مجهوداتك، سيكون الأسطول جاهزًا في لمح البصر.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "وضع نهاية لنقص الخشب وتوصيل ما يكفي من الألواح إلى الملك.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "يا سيدي، أنصح بترشيد استخدام الخشب!\n\nيمكننا بناء سوق حتى نتمكن من شراء خشب من التجار.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "هل تحتاج إلى خشب؟ أظن أن بوسعنا التوصل إلى اتفاق يرضينا نحن الاثنين. ثمة كومة صغيرة من الخشب متوفرة إذا شئت.\n\nتعال واشترِ القدر الذي تريد!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "شراء الخشب من التاجر.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "يا سيدي، ستحتاج إلى شحنات من الخشب تأتي بانتظام.\n\nإذا أسست نقابة تجارية، ستتمكن من إنشاء بعض طلبات المقايضة.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "تأسيس نقابة تجارية.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "يمكنك إنشاء طلبات المقايضة للبيع والشراء في النقابة التجارية.\n\nأنشئ طلب مقايضة للخشب يا سيدي.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "ممتاز! ما دمت تملك المال، سأنفذ طلباتك.\n\nستُكمل طلبات المقايضة لديك حتى تلغيها.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "إنشاء طلب مقايضة لشراء الخشب.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "نشب حريق في المدينة! علينا بناء ما يكفي من أبراج مراقبة الحرائق لإخماد النيران وخفض احتمالية نشوب حرائق جديدة.";
