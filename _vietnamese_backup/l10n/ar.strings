"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "لم نتمكن من الوصول إلى المواقع المحددة على الخريطة، يا سيدي. ولم نتمكن من إعادة أي غنيمة. لكننا على قيد الحياة، هذا أهم شيء.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "على الرغم من فشلك، فإن هذه المغامرة جلبت لك بعض الهيبة. من كان ليظن أن القراصنة يمكنهم إخفاء مثل هذه الكنوز في مناجمك؟\n\nلكن في الوقت الحالي، انتهت حياتك المهنية كصائد للكنوز.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "أوه يا سيدي. قيل لي أن الأنفاق في المنجم انهارت! كنا محظوظين لأننا استطعنا العودة مرتين بالكنوز.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "للمرة الأولى، قررت تنظيم وجبة كبيرة لجنودك، لتشكرهم بلطف على إحضارهم هذه الكنوز لك.\n\nقصة القرصان تلك أصبحت خلفك الآن. من يعرف؟ ربما في يوم من الأيام ستعثر على خريطة تقودك إلى ألغاز أخرى.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = " قريبًا سيكون الكنز لك!\n\nفلتأمر جنودك بالذهاب والعثور على هذا الكنز وإعادته إليك.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "غير معقول! انظر إلى كل ما عثرنا عليه في تلك المناجم! كنت محقًا في تأمينها قبل إرسال شعبك إلى هناك. ثروة لا تصدق! كانت الشائعات حول هذا القرصان صحيحة طوال الوقت. نحن الآن أغنياء!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "لا يمكننا فعل الكثير بالمعلومات التي لدينا. سيكون من الحكمة البحث عن خبير لنستشيره.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "استدعِ عامل منجم.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "هذه فكرة جيدة يا سيدي. ربما يمكنهم إعطائنا خريطة للمناجم ومساعدتنا على فهم المزيد.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "أنا سعيد لأنك طلبت مني المساعدة يا سيدي. أحضرت معي مخططات المناجم. آمل أن يساعدك هذا.\n\nهذه الأنفاق قديمة وأخشى أن تنهار.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "استدعِ الحداد.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "سيعرف الحداد بالتأكيد كيف يعطينا معلومات عن الأحجار التي تحاول هذه المرأة تحطيمها.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "تلقينا عدة شكاوى بشأن المناجم يا سيدي.\nتذهب امرأة إلى هناك كل يوم وتنقل الحجارة وأحيانًا تكسرها. لكن الأكيد أنها تبتعد دائمًا أكثر وأكثر داخل الأنفاق..";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "اذهب واكتشف أمر هذه المرأة.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "هذا ليس من شأني.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "أهل البلدة يشعرون بالقلق، الأنفاق غير آمنة ويمكن أن ينهار المنجم في أي وقت.\n\nمن واجبنا التحقق حول ما يدور وراء هذه القصة.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "أتمنى أن تكون تعلمت درسك!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "بينما يبحث مستشارك عن الأدلة في الخارج، ستكون فكرة جيدة أن تعتني ببلدتك لفترة. حاول تحسين مستوى معيشة شعبك.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "ها أنا ذا مرة أخرى يا سيدي! تتبعت هذه المرأة. لم يكن الأمر سهلًا.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "يبدو أنها تبحث عن شيء ما. رأيتها تكسر عدة أحجار وتنظر بعناية إلى الحطام.\n\nلسوء الحظ، لم أتمكن من اللحاق بها أبعد من ذلك. يبدو أنها تعرف المناجم عن ظهر قلب!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "عاد مستشارك من مهمته بالأخبار.\nورد في التقرير، أن هذه المرأة أصبحت أرملة مؤخرًا. \n\nكان زوجها قرصانًا مشهورًا جدًا. يقال أنه كان يمتلك أعظم كنز في كل العصور وأنه لم يخفِه بعيدًا عن هنا.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "لدي نظرية يا سيدي. أعتقد أن هذه المرأة تعرضت للتهديد من قراصنة آخرين لتكشف مكان الكنز!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "أكمل التحقيق.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "اترك الأمر.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "المرأة والمنجم";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "يصل الحداد بسرعة. طرده حراسك من مكانه. يبدو أنه مشغول.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "ما الذي يمكنني أن أفعله لأجلك يا سيدي؟";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "نحن حاليًا في مهمة ونحتاج إلى خبرتك.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "أنا منصت.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "يشرح مستشارك الوضع إلى الحداد.\n\nويريه أيضًا الأحجار المحطَمة التي استطاع التقاطها. يمكنك أن ترى بطرف عينك أن الحداد يعرف هذا النوع من الحجر.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "يا إلهي! يوجد الكثير من أحجار الجيود الكريمة!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "هل قلت أحجار الجيود الكريمة؟ ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "إنها بلورات خاصة، يمكن أن تحتوي على كنوز. غالبًا ما تكون بلورات ثمينة جدًا.\n\nاستخدم بعض القراصنة رموزًا تستند إلى الجيود لتذكر مكان إخفاء كنوزهم.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "أمتلك البعض منها في ورشتي، يمكنني أن أريك كيف تفتحها باستخدام الأداة الصحيحة.\n\nلكن... لدي طلبية مهمة وعاجلة يجب أن أسلمها وسأقدّر مساعدتك. كتعبير عن امتنانك للمعلومات التي قدمتها لك.";
