"T_GOOGLE_QUESTS_CLOTHES_DESC" = "الجو بارد بالخارج ولا يرتدي سكان البلدة ملابس مناسبة. كن كريمًا وأنتج بعض الملابس.";
"T_GOOGLE_QUESTS_CLOTHES_TITLE" = "الملابس للناس";
"T_GOOGLE_QUESTS_CONFLAGRATION_DESC" = "المملكة تعاني للشهر الرابع من الجفاف المستمر. مهمتك هي التأكد من إخماد الحرائق في بلدتك على الفور. ستكون كارثة إذا سقطت البلدة ضحية لألسنة النيران.";
"T_GOOGLE_QUESTS_CONFLAGRATION_NAME" = "حريق كبير";
"T_GOOGLE_QUESTS_CONSTRCUTION_DESC" = "أمر الملك بتوسيع البلدة. أعلن الطاعة وابدأ في تشييد المباني الجديدة على الفور!";
"T_GOOGLE_QUESTS_CONSTRCUTION_NAME" = "مشروع البناء";
"T_GOOGLE_QUESTS_DEDICATION_DESC" = "رشح جلالة الملك سيادتك لإكمال العديد من المهام الخاصة. أكمل عدة سيناريوهات بنجاح!";
"T_GOOGLE_QUESTS_DEDICATION_NAME" = "التفاني للمملكة";
"T_GOOGLE_QUESTS_FAIRGROUND_DESC" = "يخطط الملك لتنظيم حدث على مستوى الأمة للاحتفال بحملته الناجحة ضد توغل قطاع الطرق. يريد مباني معارض جديدة في كل بلدة في البلاد. اتخذ الاستعدادات اللازمة لذلك!";
"T_GOOGLE_QUESTS_FAIRGROUND_TITLE" = "احتفالات";
"T_GOOGLE_QUESTS_FESTIVITY_DESC" = "خطط جلالة الملك لاحتفالية كبيرة. وأمر الملك بلدتك بتوفير الكمية اللازمة من الجعة إلى الضيوف.";
"T_GOOGLE_QUESTS_FESTIVITY_NAME" = "إمدادات الاحتفالية";
"T_GOOGLE_QUESTS_FIRETOWER_DESC" = "الناس قلقون حول وسائل حماية الحرائق في قرى المملكة. لقد التهمت النيران بالفعل عددًا لا يحصى من المباني. من الحكمة أن تأمر ببناء المزيد من أبراج مراقبة الحرائق.";
"T_GOOGLE_QUESTS_FIRETOWER_TITLE" = "السلامة أولًا";
"T_GOOGLE_QUESTS_FLEET_DESC" = "منذ بداية عصر الاكتشاف، ويحاول الملك بشدة بناء أسطول من السفن السريعة لبدء رحلة استكشافية كبيرة. يجب عليك أن تنتج كمية كبيرة من الألواح الخشبية حتى يتمكن جلالته من إكمال المهمة.";
"T_GOOGLE_QUESTS_FLEET_NAME" = "أسطول جديد";
"T_GOOGLE_QUESTS_GLORIFICATION_DESC" = "وصل رسول على ظهر حصان ومعه مرسوم جديد. لقد أُمرت بتجميل المدينة لزيادة تمجيد جلالة الملك. أسس الديكورات!";
"T_GOOGLE_QUESTS_GLORIFICATION_NAME" = "تمجيد الملك";
"T_GOOGLE_QUESTS_GOLD_DESC" = "نظرًا لأن المملكة المجاورة شهدت تضخمًا هائلًا وعملة متدنية، فقد أمر جلالة الملك جميع الخلفاء بزيادة إنتاج سبائك الذهب. بهذه الطريقة يمكننا مكافحة التضخم وفصل بلدنا عن التبعية المالية لجيراننا. أنتج سبائك الذهب أيه الحاكم!";
"T_GOOGLE_QUESTS_GOLD_TITLE" = "احتياطي الذهب";
"T_GOOGLE_QUESTS_INFIRMARY_DESC" = "أيها السادة والسيدات، المملكة في خطر شديد. ينتشر الطاعون، ومن دون المشافي اللازمة، ستعاني معظم البلدات من عدد كبير من الضحايا. سيتعين على كل بلدة في البلاد بناء المزيد من المشافي وإلا فإن المملكة محكوم عليها بالهلاك!";
"T_GOOGLE_QUESTS_INFIRMARY_TITLE" = "طوارئ طبية";
"T_GOOGLE_QUESTS_IRON_DESC" = "أخبار من الجبهة! جنودنا الشجعان ينتصرون في الحرب! لكنهم يحتاجون إلى دعم كل قرية في البلاد. أفضل السيوف مصنوعة من أجود سبائك الحديد. تحتاج مصاهرنا فقط إلى إنتاج المزيد من السبائك.";
"T_GOOGLE_QUESTS_IRON_TITLE" = "الحديد الحقيقي";
"T_GOOGLE_QUESTS_JEWELS_DESC" = "النبلاء يشتكون من قلة البضاعة الكمالية يا سيدي. أيمكنك أن تتكرم وتنتج المزيد من المجوهرات؟";
"T_GOOGLE_QUESTS_JEWELS_TITLE" = "أشرق لامعًا كالماسة";
"T_GOOGLE_QUESTS_JOUSTING_DESC" = "أصدر الملك المرسوم الآتي: يريد أن يعرف من هو أفضل فارس في البلاد. يُطلب من جميع الحكام أن يبدأوا في بناء ساحات المبارزة في كل قرية من قرى المملكة. قريبًا ستبدأ أكبر بطولة شهدها العالم على الإطلاق.";
"T_GOOGLE_QUESTS_JOUSTING_TITLE" = "البطولة الكبرى";
"T_GOOGLE_QUESTS_JUICE_DESC" = "ويرتب جلالته تحضير مأدبة عشاء لضيوف دول الجوار. الاستعدادات على وشك الانتهاء، ولكن فقط تنقص كمية كبيرة من عصير العنب.";
"T_GOOGLE_QUESTS_JUICE_TITLE" = "العصير للمأدبة";
"T_GOOGLE_QUESTS_LEATHER_DESC" = "أحضر رسول على ظهر حصان للتو أخبارًا عن اتجاهات الموضة التالية من العاصمة. طلب مستشار الأزياء الجديد للملك أفضل الجلود من جميع أنحاء البلاد. من أجل جمع السترات الجلدية التي اخترعها حديثًا، يحتاج إلى كميات هائلة من الجلد. ";
"T_GOOGLE_QUESTS_LEATHER_TITLE" = "الموضة الجديدة";
"T_GOOGLE_QUESTS_MAINTENANCE_DESC" = "بعد زيارته الأخيرة لبلدتك، شهد الملك بنفسه التدهور المرعب للبلدة. أمر بإصلاح المباني في أراضيك على الفور.";
"T_GOOGLE_QUESTS_MAINTENANCE_NAME" = "واجب الصيانة";
"T_GOOGLE_QUESTS_MARKET_DESC" = "منذ أن أمر الملك بزيادة التجارة مع الدول المجاورة، كانت الكمية الفعلية للبضائع المتداولة منخفضة للغاية. هذا يجب أن يتغير. نحتاج إلى المزيد من الأسواق لتلبية هذا الطلب!";
"T_GOOGLE_QUESTS_MARKET_TITLE" = "المهمة التجارية";
"T_GOOGLE_QUESTS_MEAT_DESC" = "سكان البلدة يتضورون جوعًا، يا سيدي. علينا أن ننتج طعامًا للقرية بسرعة! ستكون اللحوم كافية لضمان نظام غذائي صحي للقرويين. أرسل بعض الصيادين إلى الغابة يا سيدي. نحتاج إلى اللحوم لسكان البلدة.";
"T_GOOGLE_QUESTS_MEAT_TITLE" = "إمدادات الطعام";
"T_GOOGLE_QUESTS_NOTIFICATION" = "احصل على مكافأة مهمتك!";
"T_GOOGLE_QUESTS_REINVOLVEMENT_DESC" = "وصل رسول على ظهر حصان ومعه مرسوم من البلاط الملكي. يمنحك منصبًا جديدًا في الحكم لعدة سنوات. لا تخيب ظن الملك.";
"T_GOOGLE_QUESTS_REINVOLVEMENT_NAME" = "عقد سنوي";
"T_GOOGLE_QUESTS_REPOPULATION_DESC" = "بعد عدة أشهر من انتشار الطاعون في البلاد، حان الوقت الآن لإعادة إعمار بلدتك. أمر الملك ببناء منازل بلدة كبيرة، حيث يعتبر العيش في المباني القديمة الموبوءة بالطاعون غير آمن.";
"T_GOOGLE_QUESTS_REPOPULATION_NAME" = "مباني جديدة للبلدة";
"T_GOOGLE_QUESTS_SAUSAGES_DESC" = "النقانق!\n\nيحب جنود الملك هذه الأطعمة الشهية. تخبرك القيادة العسكرية بتوسيع إنتاجك لهذه السلع الرائعة.\n";
"T_GOOGLE_QUESTS_SAUSAGES_TITLE" = "إمدادات للقوات.";
"T_GOOGLE_QUESTS_SUPPLIES_DESC" = "أمر الملك جميع المقاطعات بتخزين الخبز للشتاء القارس، قبل فوات الأوان. الشتاء قادم، يا سيدي...";
"T_GOOGLE_QUESTS_SUPPLIES_NAME" = "أنتج المؤن لفصل الشتاء";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_DESC" = "دمر الجفاف إنتاج البلدان المجاورة من الموارد الغذائية. وقد وعد الملك بدعمهم بالسلع. اُختيرت بلدتك لإنتاج القمح للجيران.";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_NAME" = "ادعم الجار";
"T_GOOGLE_QUESTS_TAXESLEVIED_DESC" = "لضمان نجاح الحرب ضد عصابات قطاع الطرق المنظمة في المملكة، أمر جلالة الملك بتحصيل مبلغ كبير من الضرائب من المجتمعات المحلية.";
"T_GOOGLE_QUESTS_TAXESLEVIED_NAME" = "تحصيل الضرائب";
"T_GOOGLE_QUESTS_TERRITORIAL_DESC" = "بأمر من الملك وبأثر فوري، يجب على جميع السادة القضاء على معسكرات قطاع الطرق في الغابات حول بلداتهم!";
"T_GOOGLE_QUESTS_TERRITORIAL_NAME" = "حملة قطاع الطرق";
"T_GOOGLE_QUESTS_TOOLS_DESC" = "يا سيدي، يجب توسيع البلدة من أجل إكمال مهامنا. أولًا علينا تأسيس اقتصاد مستقر. لذلك نحتاج إلى إنتاج الأدوات.";
"T_GOOGLE_QUESTS_TOOLS_TITLE" = "أدوات تجارة جديدة";
"T_GOOGLE_QUESTS_TOWNGUARD_DESC" = "يطالب الملك بألا يعيش القرويون حول المملكة في خوف من مداهمة قطاع الطرق على بلداتهم بعد الآن. وهو يأمر جميع السادة بالتأكد من أن البلدات محمية جيدًا وأن تُعترض مداهمات قطاع الطرق على الفور.";
"T_GOOGLE_QUESTS_TOWNGUARD_NAME" = "حرس البلدة";
"T_GOOGLE_QUESTS_TRADEAGREEMENT_DESC" = "دخلت اتفاقية تجارية جديدة بين المملكة وجيرانها في حيز التنفيذ. أنت مُطالب بزيادة الأرباح في السوق عن طريق تجارة الموارد الفائضة.";
