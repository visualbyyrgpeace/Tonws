"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "رائعة! إنها جميلة!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "إذا كنت ستتصرف هكذا. سأتولى أمره!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "من الآن فصاعدًا، سيفضل منادي البلدة النزل في إعلاناته.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "من الآن فصاعدًا، سيفضل منادي البلدة الحانة في إعلاناته.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "شكرًا أيها الحاكم! العبرة بالخواتيم.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "أوه، شكرًا لك يا سيدي! أصبح النزل أكثر ترحيبًا بالزهور.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "بحقك يا سيدي، خذ الوقت الكافي للتفكير في الأمر. يعد النزل مصدر دخل مهم للقرية. ويمكن أن يساعدك على إنجاز بعض مشاريعك.\n\nهل أنت متأكد أنك تريد إيقاف مجهوداتك؟";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "ماذا الذي تقوله يا سيدي؟! أنت تساعد هذه الشابة في نزلها وماذا عني؟ ألن تساعدني في حانتي!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "كفى، تأدب عندما تخاطب الحاكم.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "أطالب بالحصول على نفس الامتيازات التي تتمتع بها هذه السيدة!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "هل تريد أيضًا الزهور لمنشأتك؟";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "الزهور؟ لا، أريد منادي بلدة يروج لمنشأتي أيضًا!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "ماذا نفعل يا سيدي؟";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "روج للحانة.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "روج للنزل.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "من الزهور والأعداء";
"T_GAME_QUEST_FEAST_TITLE" = "إقامة احتفال للبلدة.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "قم بتغطية القرية بأبراج مراقبة الحرائق.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "يا سيدي، البلدة غير مهيأة للحرائق الكبيرة! توجد أجزاء من القرية غير مغطاة بأبراج مراقبة الحرائق. ضع الأبراج كي تغطي أكبر عدد ممكن من المباني.";
"T_GAME_QUEST_FOOD_STARTED" = "لا يجب أن ننسى الطعام يا سيدي! لا يوجد مهرجان دون مخزون كامل من المؤن. فلنسرع ونجهّز الموارد في المخزون. كلما أسرعنا في الحصول عليها، سينجح مشروعك في وقت أقل.";
"T_GAME_QUEST_FOOD_SUCCESS" = "لن يموت زوار مهرجاننا جوعًا! قاربنا على تحقيق الهدف يا سيدي! لا استطيع الانتظار!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "حاكم غير قادر على تقديم شراب منعش للملكة؟! نُصحت بتوخي الحذر منك، لكنني لم أرغب في الاستماع!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "جلالة الملكة فريغيث، بحقك، لا تغضبي من هذا المشكلة البسيطة. إنه مجرد مشروب منعش. لا تفتعلي مشكلة دون داعي.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "يبدو أن حتى مستشارك بدأ في إهانتي...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "الوضع خارج عن السيطرة تمامًا، ولم تعد تعرف ماذا تفعل ومستويات التوتر لديك تستمر في الارتفاع.\n\nكيف ستتصرف؟";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "حاول تهدئة الملكة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "اصغي إلي، الحاكم لديه مشاعر تجاهك وهو لا يعرف كيف يتصرف فحسب. كما ترين، هذه المرة الأولى التي يقع فيها في الحب.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "الملكة تشعر بالعاطفة أيضًا. يبدو أنها أيضًا لديها مشاعر تجاهك. أيمكن أن تكون هذه بداية قصة حب حقيقية؟ هل كانت العرافة على حق طوال هذا الوقت؟\n\nفقط الوقت يمكنه أن يخبرنا. في الوقت الحالي، قررت الملكة أن تحظى برقصة أخرى.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "مرت عدة أشهر على الحفل الراقص الشهير. لديك أنت والملكة فريغيث علاقة مقتصرة على الرسائل. تأتي أحيانًا لرؤيتك عندما يسمح الطقس بذلك.\n\nربما ستنصبك ملكًا لمملكتها يومًا ما. لكنها منشغلة جدًا في الوقت الراهن في ضمان سلطتها كملكة.\n\nوكذلك أنت! يجب أن تستمر في فعل كل ما في وسعك للحفاظ على استقرار أمور مدينتك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "أهل البلدة أيضًا سعداء لك وللملكة. لاحظوا زيادة المسافرين، فهم يأتون بشكل أساسي لتذوق عصير العنب والشراب اللذين لم تحظَ بهما الملكة في أثناء الحفل. تقول الشائعات إنهما كانا لذيذين جدًا لدرجة نفاد مخزونهما في أقل من ساعة.\n\nزادت إنتاجية هذين المبنيين!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "الأوراق.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "سأسحب الأوراق عمومًا من أجلك يا سيدي. سيخبرنا ذلك أكثر قليلًا عن أي نوع من الأشخاص أنت وما المصير الذي ينتظرك. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "بعد ذلك السحب الأول، تبدأ في خلط الورق مجددًا.\n\nتطلب منك سحب ثلاث ورقات. واحدة للماضي وواحدة للحاضر وواحدة للمستقبل.\n\nبمجرد اختيار جميع البطاقات، تقلبها واحدة تلو الأخرى.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "أوه يا سيدي، تخبرني هذه البطاقات الثلاثة أنك ستواجه وقتًا عصيبًا للغاية. عليك توخّي الحذر من الناس في الكنيسة. تخبرني البطاقات الثلاثة أنهم حاولوا بالفعل قبل ذلك الاقتراب منك، لكنهم لم ينجحوا.\n\nأعذر من أنذر.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "سحب رائع يا سيدي! كل شيء إيجابي. ستلتقي بامرأة عظيمة ستقلب قلبك رأسًا على عقب. الحب يلوح في الأفق! كن مستعدًا عندما تطرق بابك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "ترى هذه الشابة تخلط الأوراق وتهمس لهم باسمك. حتى تنقل طاقتك.\n\nثم تطلب منك اختيار الكومة اليمنى أو اليسرى.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "آمل ألا تتحقق هذه التنبؤات وأن يكون المتدينون سعداء في مدينتنا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "في صباح اليوم التالي، يقترب منك راهب. ويخبرك أن الكنيسة بحاجة إلى المزيد من الموارد وأنهم بحاجة شديدة إلى مكان إضافي لإقامة الشعار وسيقدّرون ذلك. \n\nتخطر تنبؤات العرافة على بالك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "يمكن للكنيسة الجديدة أن تساعد السكان على النهوض روحيًا. شكرًا جزيلًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "ابنِ مكانًا جديدًا للعبادة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "أوه، هذا ممتاز! سترى، سنستفيد جيدًا من مكان العبادة الجديد هذا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "الكومة اليسرى.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "تشير هذه البطاقة إلى أنك لديك جزءًا مظلمًا جدًا بداخلك وسيؤدي ذلك بك إلى تدمير نفسك. أخشى أن ذلك سيؤثر على إنتاجية شعبك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "أشعر أنك مرتبك وأن مستشارك يدفعك للمغادرة. لكن انتظر قليلًا، فالأمر لم ينتهِ بعد. قد يوفر السحب الثاني إجابات أكثر تحديدًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "هذه العرافة تقول الحقيقة يا سيدي، لدينا زيارة مقررة في عطلة نهاية الأسبوع القادمة. ما يمنحنا وقتًا كافيًا للتخطيط لحفل والتأنق!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "نظّم حفلًا";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "لا يوجد حفل جيد دون طعام وشراب. لنبدأ بذلك يا سيدي.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "ممتاز! لدينا الآن ما يكفي من الطعام والشراب لإرضاء ضيوفنا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "يجب أن تبذل قصارى جهدك في هذا الاحتفال. تخيل إذا التقيت بتوأم روحك هناك؟";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "ربما يكون لدى مستشارك وجهة نظر. لذلك قررت أن ترتدي أجمل ملابسك. المدينة كلها مشرقة، أنت لا تتردد للحظة أن تكشف عن ثروتك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "هذا سيذكره التاريخ! بالتأكيد سيثير هذا إعجاب محبوبتك المحتملة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "الكومة اليمنى.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "أنت شخص يهتم بالآخرين وتخبرني البطاقات أن هذا سيؤثر على إنتاجية سكانك!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "الكرة البلورية.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "اختيار جيد جدًا أيها الحاكم. اقترب من فضلك وانظر إلى الكرة البلورية.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "تقترب العرافة من الكرة البلورية بيديها، وفجأة يظهر دخان أزرق.\n\n"ستعاني من محنة كبيرة يا سيدي. أرى رهبانًا. قد يكونوا سبب مصائبك"، قالت ذلك بنبرة حزينة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "تقترب العرافة من الكرة البلورية بيديها وفجأة، يظهر دخان وردي.\n\n"يا سيدي، ستعثر على الحب! الحب الحقيقي! سيصبح لديك قصة رائعة، أؤكد لك!". تخبرك ذلك بنظرة واثقة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "غادر واذهب للبكاء في غرفتك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "مذعورًا تمامًا، هربت من قاعة الرقص وتجري إلى غرفتك لتنهار بينما تبكي في سريرك.\n\nكل شيء يدل على أنك تعاني من قلب مكسور. وحده الزمن قادر على علاج هذا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "منذ عدة أشهر حتى الآن، وقلبك المكسور يتعافى ببطء.\n\nلم تحاول الملكة فريغيث أبدًا معرفة ما جرى لك، فهي لا تهتم بك على الإطلاق.\n\nلكن من الناحية الأخرى، لقد صنعت التاريخ وتظهر الآن في الكتب بصفتك الحاكم الولهان. أكسبك هذا تعاطف الناس وهم الآن يعملون بكفاءة أكثر.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "أحضر لها شرابًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "قررت أن تذهب بصحبة مستشارك إلى منزل العرافة. ربما يمكنها مساعدتك في منع بعض المصائب أو لعلها تقدم لك أخبارًا رائعة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "العرافة ليست بعيدة عن القلعة. تدخل إلى الخيمة الصغيرة. أنت محاط بمجموعة كبيرة من الأشياء الغامضة. بطريقة ما، تهدئك.\n\n"يا سيدي، لتتفضل بالجلوس. أنا سعيدة جدًا لأنك قبلت دعوتي. ما الطريقة التي تفضلها؟"";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "أحضر لها البعض من عصير العنب.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "يمكنك الاستمتاع بالمواكب من أعلى قمة في قلعتك. وفجأة، من بعيد، ترى موكبًا قادمًا. يقع انتباهك على امرأة جميلة. وتغمر المشاعر قلبك.\n\nأهذا هو الحب من أول نظرة؟";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "وبكل جنون الحب، قررت أن تذهب وتلتقي بهذه الغريبة الجميلة. كدت تتعثر وأنت تنزل على أدراج قلعتك، تنزل الدرج على أربع. مستشارك تملّكته الحيرة بجانبك، لا يفهم ما الذي يجري معك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "سيدي، إنها الملكة فريغيث. لا أعرف ما الذي دفعك للوصول إليها بهذه السرعة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "سررت بلقائك أيها الحاكم.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "أذهلتك الملكة فريغيث بحضورها، لم تعد تعرف كيف تتصرف. لحسن حظك، يساعدك مستشارك الموثوق به في استعادة حواسك.\n\nقررت دعوة الملكة فريغيث إلى الحفل الراقص الليلة. آملًا أن تقبل الموعد الرومانسي الأول هذا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "جلالة الملكة فريغيث، الحاكم يدعوكِ إلى حفل الليلة لتكوني رفيقته. هلا تشرفينا بالقبول؟";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "هذا غير لائق على الإطلاق! لقد وُعدت لدوق "كان"، ولا يمكن رُؤيتي بين أحضان الحاكم.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "يسعدني قبول هذه الدعوة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "حان وقت الحفل الراقص أخيرًا. طلبت من أرقى الموسيقيين أن يعزفوا لك هذا المساء. تريد أن يكون كل شيء مثاليًا تمامًا لمحبوبتك.\n\nوصلت الملكة فريغيث أخيرًا بفستان أنيق. كل ثانية تقضيها في وجودها تزيد حبك اشتعالًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "بدأت الموسيقى، ويبدو أيضًا أن الملكة فريغيث كانت مسحورة. حان وقت الاستراحة، ثم تطلب منك شرابًا منعشًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "ليس لديك أي شيء لتقدمه لها.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "ارفض الدعوة.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "فعلت الصواب أيها الحاكم. من يدري ما أنواع المشاكل التي كنا سنواجهها!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "بقلب مكسور، قررت عدم حضور الحفل على الإطلاق. ستحزن لفترة طويلة. وينعكس ذلك على مدينتك. إنتاجية وسعادة السكان تستمر في الانخفاض. لنأمل ألا يدوم ذلك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "تبدأ في رؤية الضوء في نهاية النفق مجددًا وتغلبت على حزنك. تبدأ ببطء في الخروج من غرفتك مجددًا.\n\nالناس سعداء بتعافيك وهذا يؤثر على إنتاجيتهم ومعنوياتهم إيجابيًا.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "شكرًا لك أيها الحاكم، أنت رجل جذاب جدًا. هل ترغب في استغلال هذا المساء لعقد اتفاقيات تجارية؟ حتى تتاح لنا فرصة اللقاء مجددًا...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "سأتركك مع الملكة أيها الحاكم.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "تعزلا أنفسكما أنت والملكة في الحديقة الملكية. كما في القصص الخيالية. الوقت يقف بالنسبة لك والملكة فريغيث. تستجمع كل شجاعتك وتشاركها مشاعرك. اتضح أن مشاعر الملكة متبادلة!\n\nلسوء الحظ، تشرق الشمس ويجب أن تعود الملكة. لديها الكثير لتتعامل معه في بلدها. وأنت تعلم أنه ليس من السهل إدارة بلد بمفردك.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "أهل البلدة أيضا سعداء لك. إنهم أقل عرضة للإضرابات، هذا خبر سار.\n\nأخيرًا، فعلت الصواب باستشارة هذه العرافة.";
