"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "قد يضر هذا الطلب بسمعتنا، سنتابع بشكل مختلف. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "إن مستشارك قد يكون على حق. إن طلب المساعدة من الملكة فريغيث سيدفعك للاعتماد على حسن نيتها. إذا أصبح هناك أي مشكلة، فستخاطر بخسارة الكثير.\n\nلماذا لا تستخدم الحجر؟ لديك الكثير منه في المناجم.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "قرار صائب، يا سيدي! نحن أحرار ومستقلون.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "نجح مهرجان الخزامى. أثارت القصص الأخيرة عن ترميم الكاتدرائية الكثير من الحماس وقد استفدنا من ذلك!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "لم أحب الخزامى أبدًا.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "حسنًا، لا بأس بذلك! نحن نصلحها.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "هذا مشين.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "يا سيدي، يبدو هذا ابتزازًا! دعنا نستخدم الحجر بدلًا من ذلك، حتى لا نضطر إلى التعامل مع هذه الملكة!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "حسنًا، لن أنسى ذلك يا عزيزتي.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "ملك الخشب";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "سأتولى الأمر.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "إذا لم يكونوا سعداء، فلا يجب أن يأتوا بعد الآن.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "صحيح أن التجار سيستفيدون من تخصيص مكان لهم، بالإضافة إلى السوق. النقابة التجارية هي المبنى الأنسب يا سيدي.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "رائع يا سيدي! شكرًا لموافقتك على هذا. نحن ممتنون إلى الأبد!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "حاكم متحضر مثلك كان يجب أن يقبل طلب التجار...";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "جئت كممثل عن التجار يا سيدي. تعبيرًا عن خيبة أملنا، لن نأتي إلى مدينتك لفترة من الوقت! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "يا سيدي، يطالب اتحاد التجار ببناء المباني التي تتوافق مع وظائفهم.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "نقص المساحة";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "لقد استيقظت لتوك، لدى مستشارك بعض الأخبار السيئة! الفئران تغزو المدينة! إنها أقل خطورة من الجرذان، لكن لا تزال خطيرة. علينا أن نفعل شيئًا!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "يا سيدي، أنشأنا أكاديمية قطط لصيد الفئران ولكن... لا يزال علينا الاهتمام برفاهيتها وإطعامها. يجب أن نوفر ما يكفي من الأسماك للأكاديمية.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "لدينا الآن ما يكفي من الأسماك لتغطية التدريب. بعض القطط المجندة قبضوا بالفعل على الكثير من الفئران، يا سيدي.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "يا سيدي، يجب أن نكافئ أفضل القطط بنعناع الهر. لتقليل إجهادها.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "هناك زيادة ملحوظة في فعالية صائدي الفئران، يا سيدي. يقوم المدرسون بعمل جيد في تدريب القطط. لم يتبقَ سوى عدد قليل من الفئران.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "لم تعد الفئران مصدر إزعاج على الإطلاق يا سيدي. تهانينا على اختياراتك التي أدت إلى هذه النتيجة.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "جهز خطة.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "ما زلت تقرر تناول وجبة الإفطار. أثناء تناولك للخبز المحمص، ترى فأرًا في زاوية الغرفة! إنها موجودة حتى في القلعة! وفجأة، ترى شوكيت، قطك الوفي، يقفز. ويأكل الفأر في لمح البصر. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "يعطيك هذا فكرة. تطلب من مستشارك الإمساك بأكبر عدد ممكن من القطط وتدريبها على صيد الفئران. حتى القطط المنزلية. تريدهم أن يتدربوا على التخلص من كل هذه الفئران.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "عُد إلى النوم.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "عندما تستيقظ، تجد الكثير من الفئران في كل مكان بحيث يصعب على الجميع المشي بشكل صحيح. تباطأ كل سكانك!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "غادرت الفئران أخيرًا بمفردها بعد وقت طويل. إن الاختباء من مسؤولياتك عن طريق النوم ليس حلًا دائمًا.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "القط والفأر";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "يمكن رؤية التأثيرات النشطة حاليًا على اليمين.\nبعض التأثيرات نشطة مؤقتًا ويمكن أن تتغير خلال السيناريو.";
"T_GAME_QUEST_MIL_TUT_01_START" = "يا سيدي،\nمع كامل الاحترام، يبدو أنك لم تلحظ مدى تعاسة أهل القرية. لا يمكن أن يستمر ذلك الوضع.\nكما أن السلع التي ننتجها لا تُصنّع بالطريقة الصحيحة.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "تعلم الآن أي التأثيرات تعمل في البلدة. ربما قد لاحظت أن قطاع الطرق في المنطقة وأن السعادة العامة في البلدة انخفضت بسبب قطاع الطرق.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "اذهب إلى قائمة الإيقاف المؤقت لرؤية التأثيرات الحالية في هذه الخريطة.";
"T_GAME_QUEST_MIL_TUT_02_START" = "هلا تتفضل وتذهب إلى مبنى نشر الخشب؟ \nعلينا إيقاف الإنتاج! لدينا قليل من الخشب وكثير من الألواح!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "لمعرفة معلومات أكثر عن مبنى ما، ما عليك إلا الذهاب إليه!\n\nتظهر قائمة السياقات معلومات مفيدة جدًا عن المبنى؛ مثل عماله وسلاسل الإنتاج المرتبطة به. تتوقف اللعبة مؤقتًا عند فتح هذه القائمة.";
"T_GAME_QUEST_MIL_TUT_03_START" = "يحتاج مبنى نشر الخشب إلى مزيد من الحطابين لإنتاج ألواح أكثر.\n\nعلينا إيقاف عمل مبنى نشر الخشب مؤقتًا حتى نبني مزيدًا من أكواخ الحراجة ونجمع مزيدًا من موارد المبنى.";
"T_GAME_QUEST_MIL_TUT_04_START" = "يجب أن تمنع الموارد من ملء المستودع عن آخره يا مولاي. \nعندما تحتاج إلى مساحة في المستودع، يمكنك استخدام ميزة إتلاف الموارد في قائمة الإحصائيات.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "اذهب إلى قائمة المستودع.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "يجب أن تمنع سد الموارد للمستودع يا مولاي. \nعندما تحتاج إلى مساحة في المستودع، يمكنك استخدام ميزة إتلاف الموارد في علامة تبويب المستودع بقائمة اللعبة.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "دمر الألواح الخشبية حتى ينزل المخزون تحت 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "إتلاف بعض الألواح لإفساح المجال في المستودع.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "لا تأخذ تهديداتي على محمل الجد أيها الحاكم. \n\nسأتعامل بخشونة من الآن فصاعدًا!";
"T_GAME_QUEST_MIL_TUT_05_START" = "شيدت بلدة جميلة هناك.\n\nمن المؤسف أنها في منطقتي! أعطني الجواهر والملابس! وأسرع وإلا ستصبح بلدتك في طي النسيان...";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "من المذهل كم يؤتي تهديد صغير ثماره. لم أتصور قط أنك قد ترسل تلك الأشياء إليّ.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "دفع جزية لقطاع الطرق.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "يشعر رجالي بالملل حاليًا. سأرسلهم في رحلة سياحية…\n\n…إليك!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "كما ترى، أنا آخذ ما أشاء!";
"T_GAME_QUEST_MIL_TUT_09_START" = "صباح الخير يا مولاي.\n\nأقف أمامك بأمر من الملك. لقد أرسلني لتعليمك فن الحرب.\n\nستصبح مشكلتك الصغيرة مع قطاع الطرق في طي النسيان عما قريب يا مولاي.";
"T_GAME_QUEST_MIL_TUT_10_START" = "تعدّ الثكنات أساس العمليات العسكرية في المنطقة وتتيح بناء أبراج الحراسة وإمدادها. لا يقاتل الجنود جيدًا إلا عندما يزودون بإمدادات جيدة.\nيجب وضع الأبراج لتغطية أكبر قدر ممكن من البلدة.\n\nابنِ ثكنات وبرج حراسة يا سيدي.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "تلقيت حقًا مساعدة من فارس…\nبدأت أرتعد من الخوف بالفعل.\nلنر ما يستطيع جيشك فعله ضد رجالي…";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "يضرم قطاع الطرق النار في مبانينا. أين رجل الإطفاء ذلك عند الحاجة إليه؟!\n\nعندما تريد معرفة مكان أحد أهل البلدة حاليًا، يمكنك تحديد خيار "إيجاد أهل البلدة" من قائمة السياقات في المباني.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "يمكن هنا رؤية ما يفعله العمال حاليًا.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "إنتاج الجعة والسجق";
"T_GAME_QUEST_MIL_TUT_14_START" = "يحتاج جنودنا إلى الجعة ليعززوا شجاعتهم يا مولاي.\n\nعليك الأمر ببناء مصنع جعة في الدير وفرن تجفيف لإنتاج الجعة.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "يحتاج جنودنا إلى الجعة يا مولاي.\nعليك الأمر ببناء مصنع جعة في الدير وفرن تجفيف للحصول على الجعة.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "يحتاج مصنع الجعة في الدير إلى عدة موارد من مبانٍ أخرى.\nيحصل مصنع الجعة على نبات الجنجل المجفف من فرن التجفيف.\n\nحينها يستطيع الرهبان في الدير البدء في إنتاج الجعة يا مولاي.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "في الدير، يمكنك أمر الرهبان بجمع نبات الجنجل من الحقول أو بصنع الجعة.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "بناء دير وفرن تجفيف.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "بناء دير وزراعة بعض حقول نبات الجنجل.";
"T_GAME_QUEST_MIL_TUT_15_START" = "بالنسبة إلى إنتاج السجق، فستحتاج إلى مزرعة خنازير ومجزر يا سيدي.\n\nيحب جنودنا المذاق الحارّ للسجق. يستطيع المزارع حصد التوابل التي نحتاج إليها من أجل السجق من حديقة الأعشاب.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "يستطيع المجزر إنتاج اللحم العادي بالإضافة إلى السجق الذي يحبه جنودك.\nقد يكون هذا جيدًا للاستفادة من صيد الحيوانات في الغابات.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "بناء مزرعة خنازير ومجزر.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "أظن أنه من الأفضل أن تدرب دفاعاتك أكثر!\nإلى اللقاء في المرة المقبلة… وشكرًا على الموارد.";
"T_GAME_QUEST_MIL_TUT_16_START" = "جعة وسجق!\n\nيحب رجالي هذا الطعام الفاخر. أظن أن عليك مشاركة إنتاجك من هذه الأشياء الرائعة معي.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "حالفك الحظ هذه المرة أيها الحاكم. سيأتي مزيد من رجالي في المرة المقبلة.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "الدفاع عن البلدة";
"T_GAME_QUEST_MIL_TUT_17_START" = "يجب إجراء تحسينات أكثر في البلدة. معظم القرية ليس محميًا جيدًا. علينا تغطية مزيد من القرية بأبراج الحراسة.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "صار معظم القرية في حماية جنودنا. لن يستطيع قطاع الطرق أولئك السرقة منّا بسهولة الآن يا سيدي.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "تغطية على الأقل 50% من القرية بأبراج الحراسة";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "إذا أردت معرفة مزيد من المعلومات عن الجيش، يمكنك دائمًا الذهاب إلى علامة تبويب الجيش في شاشة الإحصائيات.";
"T_GAME_QUEST_MIL_TUT_19_START" = "يحتاج جنودنا إلى أسلحة ودروع!\nتزيد الأسلحة قوة هجوم الجنود وتزيد الدروع قدراتهم الدفاعية.\n\nلذا علينا بناء مستودع أسلحة في البلدة. ولصنع الدروع، يجب بناء مدبغة أيضًا للحصول على الجلد الصناعي.\nسيوفر جزار أو صياد جلود الحيوانات.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "بناء مدبغة ومستودع أسلحة.";
"T_GAME_QUEST_MIL_TUT_20_START" = "يا سيدي،\nحان الوقت لزيادة حجم جيشك. يمكنك حينها إرسال فرقة لتدمير معسكرات قطاع الطرق.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "تكبير الجيش";
"T_GAME_QUEST_MIL_TUT_21_START" = "حان الوقت أيها الحاكم!\n\nسنشن هجومًا الآن على زعيم قطاع الطرق الشرير. معسكرهم مخفي في الغابة.\nما عليك إلا تحديد معسكر قطاع الطرق وإعطاء الأمر لمجموعة مناسبة من الجنود بالهجوم.\n\n\nأرجو لك صيدًا سعيدًا!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "تدمير معسكر قطاع الطرق";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "يسرني لقاؤك يا مولاي.\nسرقني قطاع الطرق الآن للمرة الثالثة هذا الأسبوع. علينا فعل شيء تجاه أولئك الأوغاد!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "نصر ساحق يا مولاي.\nلقنّا قطاع الطرق أولئك درسًا قاسيًا! صارت المنطقة آمنة مرة أخرى، وسيسر الملك كثيرًا. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "إكمال التدريب الأساسي وهزيمة قطاع الطرق.";
"T_GAME_QUEST_NEW" = "مهمة جديدة!";
"T_GAME_QUEST_NEW2" = "مهمة جديدة:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "لا أحد لديه وقت لذلك.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "أنت محق.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "حسنًا يا سيدي، إذن لن نفعل شيئًا حيال أمر هذا الخبز البشع. يمكنني بالفعل سماع الشكاوى حول الطعام السيئ. لكن في كلا الحالتين...، كما تأمر يا سيدي.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "يا سيدي، أصبح الخبز الآن لذيذًا! وأسعار الشراء ترتفع كذلك.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = ""القمح مسؤوليتك، عليك أن تتعامل مع أصل المشكلة. أخبر الطحان أن يستخدم مياه أكثر نقاءً. ربما تتحسن جودة الخميرة".\n\nسينقل مستشارك حكمتك إلى الخباز ويعدُك بأن الخبز ستتحسن جودته.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "علينا أن نفعل شيئًا يا سيدي. تغيّر الخبز عما كان. جاء الكثير من الناس يشكون من جودته. علينا تغيير الوصفة.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "وصفة جديدة";
"T_GAME_QUEST_NOQUEST" = "لا توجد مهمات متاحة.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "فلنسرع وننتج دروعًا وأسلحة. إذا كان هؤلاء الأشخاص خطرين، فمن الآمن أن نكون مستعدين.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "أيها الحاكم، لقد انتهينا من الاستعدادات للدفاع عن المدينة.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "يبلغ جنودك عن تحركات لقوات في الشمال. تقع هناك أكبر صحراء في المملكة.\n\nومع ذلك، أنت تعلم أنه لن يجرؤ إلا مجنون على محاولة الهجوم على هذا الجانب من حدودك. قررت أن تتجاهل هذا التهديد. أيًا كان ما سيحدث، لن يردّه شيء!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "بعد بضعة أيام قليلة، أبلغ جنودك عن مجموعة من الأشخاص قادمين من الصحراء الشمالية مباشرة. سيصلون إلى البلدة في غضون ساعات قليلة.\n\nربما يكونون مجرد مسافرين، لكن من يدري، ربما هم قطاع طرق خطرين جاءوا لغزو قريتك!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "جهز الدفاع.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "جهز الترحيب الحار.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "الصحراء الشمالية";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "تقترب مجموعة من عشرة أشخاص من مدينتك. يظل جنودك على أهبة الاستعداد، في انتظار أوامرك.\n\nتسمح لهم بالاقتراب. يسير زعيم هذه المجموعة بمفرده نحو بوابات المدينة. "صباح الخير يا سيدي، لقد عبرنا للتو الصحراء الشمالية. هل يمكنك أن تستضيفنا لليلة واحدة؟"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "فلتدخلوا إلى مدينتنا الجميلة، ستبقون في النزل، لدينا مساحة كافية هناك.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "بينما يصطحبك مستشارك إلى المنزل، لا تزال على أهبة الاستعداد. لماذا خاطروا بعبور الصحراء بينما كان بإمكانهم الإبحار على طول النهر؟ لماذا يختارون طريقًا خطيرًا إذا لم يختبئوا؟ \n \n ربما يستطيع جواسيسك معرفة المزيد عنهم. أو ربما عليك الخلود إلى النوم أيضًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "اخلد إلى النوم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "أرسل جاسوسًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "ظل جاسوسك مستيقظًا طوال الليل وتمكن من التنصت على بعض المحادثات في النزل: المسافرون هاربون. يقال أنهم ارتكبوا جرائم معينة في بلدهم على الجانب الآخر من الصحراء. أُرسل الجيش على أثرهم وهم يجهزون طريقهم بالفعل لمواصلة هروبهم من العدالة.\n\nما هو الحل الأفضل؟";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "احتجز المسافرين.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "تلقينا للتو رسالة من الملك. هرب مجرمون خطيرون من سجن الدولة المجاورة. هناك حوالي عشرة منهم وقد سرقوا قطعة ثمينة. أتعتقد أنهم المسافرين الذين كانوا هنا قبل بضعة أيام؟";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "أرسل رسالة إلى الملك.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "لنبقِ الأمر سرًا بيننا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "سأرسل رسالة إلى الملك لأخبره بأنهم مروا عبر قريتنا. قد ينجحوا في العثور عليهم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "يا سيدي! نجح الجيش الملكي في القبض على هؤلاء الأشخاص الخطرين. واستعادوا الكنز المسروق.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "شكرًا لك على مساعدتك أيها الحاكم. سرق هؤلاء الأشخاص إحدى مجوهراتي الثمينة. كانوا يخططون لبيعها في السوق السوداء. فعلت الصواب بإخباري عن وجودهم حول مدينتك.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "جيد جدًا يا سيدي. إذا سألنا أحدهم عن ذلك، فسنقول إننا لا نعرف.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "مضى وقت طويل منذ أن حدث أي شيء مذهل في المدينة. ومع ذلك، تشعر اليوم بأن شيئًا ما سيتغير.\n\nوكنت على حق! يُحضر إليك مستشارك خطابًا من المسافرين الذين يطلب الجيش الملكي القبض عليهم. نص الرسالة كالتالي: \n\n"شكرًا لك على عدم الإبلاغ عننا أيها الحاكم. كما ترى، كنا ضحايا لمؤامرة وكانت عائلاتنا بأكملها في خطر كبير. أصبح لدينا الوقت الكافي لإثبات براءتنا بعد إخفائك أمر مجيئنا إلى قريتك. لكان الأمر مستحيلًا لولاك. لذلك، اقبل من فضلك هذه الجائزة تعبيرًا عن امتناننا. أنت حاكم صالح".";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "أطلقت سراح المسافرين يا سيدي. كما أمرتنا. آمل ألا يأتي ذلك بنتائج عكسية علينا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "يشكرك المسافرون على لطفك ويعدونك أنهم بمجرد إثبات براءتهم، سيعطونك مكافأة تعبيرًا عن امتنانهم.\n\nأنت تأمل بصدق أن تكون اتخذت القرار الصحيح وأن هؤلاء المسافرين لم يخدعونك بالأكاذيب.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "مرت الآن عدة أشهر منذ آخر مرة سمعت فيها عن هؤلاء المسافرين. أحيانًا تفكر في الأمر مجددًا. لم تواجه أي مشاكل مع الملك، لكنك لم تحصل على مكافأتك المزعومة أيضًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "فجأة، في صباح يوم مشرق، يأتي مستشارك ليعطيك طردًا به خطاب. يحتوي الخطاب على رسالة من المسافرين الغامضين. يعبرون فيها عن امتنانهم. وفي الطرد، يمكنك رؤية المكافأة الموعودة. الهيبة مع الذهب.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "أنت سعيد لأنك كنت على حق وأنك لم تُخدع.\n\nيبلغ مستشارك بالفعل أنك أصبحت بطلًا لهؤلاء المسافرين وأنهم يشيدون بك. يا له من وقت رائع أن تكون حاكمًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "يا سيدي، غادر المسافرون النزل في الصباح الباكر، بدا وكأنهم في عجلة من أمرهم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "ينتظر المسافرون إجابتك. البعض يبدو عدوانيًا، والبعض يبدو خائفًا.\n\n"لا يمكنني أن أستضيفكم أيها المسافرين. فليس لدينا مساحة كافية لكم الليلة."\n\n"كذب!" فجأة صرخ أحد المسافرين بذلك وهو يندفع نحوك بسيفه.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "احموا الحاكم!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "أسرع يا سيدي! أسرع! فلنبتعد عن الأنظار!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "تمكنت من اللجوء إلى مخبأ مع مستشارك الذي يبدو مذعورًا للغاية: "يا سيدي، ماذا سنفعل؟! هؤلاء المسافرون الأشرار يدمرون قريتنا ولا يوجد شيء يمكننا القيام به! كان علينا تجهيز دفاعاتنا بدلًا من لفائف الخبز!"\n\nللأسف، الشيء الوحيد الذي يمكنك فعله هو الانتظار.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "في الصباح الباكر، تخاطر بالخروج من مخبأك. لم تتضرر القرية. يبدو أن هؤلاء المسافرين أفقدوا الحراس وعيهم وأخذوا بعض المؤن لبقية رحلتهم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "لحسن الحظ، خططنا لمثل هذه الخطوة يا سيدي. سنتمكن من صدهم بالأسلحة والدروع التي أنتجناها. أنا متأكد من ذلك.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "نجحنا في القبض على جميع المسافرين يا سيدي. وحبسناهم في السجن، حان الوقت لكي تتخذ قرارًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "هؤلاء المسافرون يزدادون غرابة. الآن وبعد أن حبستهم، تشعر أنك أكثر أمانًا بقليل. ومع ذلك، هناك شيء ما يزعجك.\n\nماذا تحتاج إلى أن تفعل؟";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "استجوبهم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "أخبر الملك.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "حسنًا يا سيدي، سأطرح عليهم بعض الأسئلة لتوضيح هذه القصة.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "عاد مستشارك ليقدم لك بعض المعلومات عن المسافرين.\n\nلقد فروا من بلادهم لأنهم اُتهموا ظلمًا. والدليل على براءتهم موجود في أقصى الجنوب. في إحدى المدن المجاورة.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "دعهم يذهبون.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "لذلك سأبلغ الملك حتى يأتي الجيش الملكي ويأخذ هؤلاء المجرمين الخطرين!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "الجيش الملكي قادم أخيرًا. أنت تسلم المسافرين. ويرسل لك الملك مكافأة مقابل توفير المعلومات اللازمة للقبض على هؤلاء الأفراد الخطرين.\n\nتتعافى قريتك ببطء، بينما تستأنف بسلام أنشطتك كحاكم.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "ارتكب جاسوسك خطأ ورصده المسافرون. إنهم يحتجزونه كرهينة ويطالبون بفدية إذا أردت عودته حيًا.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "سنخسر الكثير من المال، لكن على الأقل سيبقى جاسوسنا في أمان.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "شكرًا لك يا سيدي على دفع الفدية لتحريري! كنت خائفًا على حياتي. يا له من عمل خطير أن تكون جاسوسًا.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "هذه فكرة رائعة. يجب أن نحضر الطعام لهؤلاء الأشخاص عندما يصلون إلى بوابتنا. سيفي الخبز والسمك بالغرض.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "ممتاز، الآن كل ما علينا فعله هو انتظارهم.";
"T_GAME_QUEST_PLACE_STARTED" = "حان الوقت الآن لبناء الموقع المناسب لحدث بهذا الحجم!";
"T_GAME_QUEST_PLACE_SUCCESS" = "يا إلهي، هذا أمر لا يصدق على الإطلاق! وفكرة أن لا شيء من كل هذا كان لينجح لو لم يكن الحراس مندفعين. كانت فكرتك رائعة عندما انتهزت هذه الفرصة! هذا المهرجان واعد.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "ازرع المزيد من الزهور.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "هذا ليس ضروريًا.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "جميل! أوه، الزهور حقًا رائعة. تحملني رائحتها بين السحاب.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "أنت شخص بغيض. كانت مدينتنا أجمل بكثير بالزهور!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "عاد الربيع، يا سيدي. تستطيع القرية أن تستفيد من بعض الزهور الإضافية.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "بتلات جميلة";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "احترق مبنى نشر الخشب يا مولاي. هلا تأمر بإعادة البناء؟ نحتاج إليه لإنتاج الألواح!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "إعادة بناء مبنى نشر الخشب.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "لا تعطِ أحدًا شيئًا.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "إعادة توزيع المكاسب لأهل البلدة.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "استثمر هذه الأموال في المناجم.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "سيدي، لدينا الكثير من الأموال في الخزائن وإعادة توزيع بعض هذه الأرباح سيكون مفيدًا للمدينة.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "سمع القرويون عن قرارك. وليسوا سعداء به. حاول إظهار المزيد من الاهتمام لشعبك قليلًا، يا سيدي.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "لم تعد إنتاجية أهل البلدة تتأثر بالقرار الذي تتخذه بشأن إعادة توزيع الأرباح. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "كم جعلت أهل البلدة سعداء! إنهم بسعادة غامرة!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "مبادرة ممتازة، يا سيدي. لنبدأ في بناء المناجم واستخراج الموارد.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "إن استثمار الأموال التي كانت لدينا في بناء مناجم جديدة على الأغلب هو أفضل قرار اتخذناه على الإطلاق. سنستطيع در المزيد بسهولة أكبر باستخدام هذه الموارد.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "أنت كريم جدًا، يا سيدي. ستسمح لهم هذه الأموال بتحسين حياتهم اليومية.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "إعادة توزيع الأرباح";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "لقد كنا محظوظين، يا سيدي. لم تتأثر المحاصيل. غادرت الخنازير ولم يعد علينا القلق بشأنها.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "دمرت الخنازير البرية محاصيلنا، يا سيدي! فقد توجهوا إلى المزرعة. إنها مذبحة.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "حطمت هذه الخسارة السكان وتأثرت سعادتهم وإنتاجيتهم.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "سيدي، بدأت محاصيلنا في التعافي من الأضرار التي سببتها الخنازير منذ بعض الوقت. تنمو المزارع من جديد وبدأ الناس في نسيان ما حدث.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "السكان مهملون نتيجة لقرارك! لنأمل ألا تتضرر المحاصيل بسبب هذه الخنازير البرية.";
"T_GAME_QUEST_REWARD" = "المكافأة:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "مرحبًا أيها المسؤول!\n\nألقِ نظرة على هذا الساحل! أعتقد أن بلدتك تستحق هذا المنظر البديع!\nاعتنِ بأهل بلدتك جيدًا ولا تنس دفع الجزية للملك، حتى يتسنى لك مواصلة خدمتي!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "قرض من خزانة الملك";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "أيها الحاكم،\nإذا أوشكت أموالك على النفاد، يستطيع الملك إقراضك بعضًا من المال حتى تتحسن الأحوال.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "مرحبًا بك في بلدتنا المتواضعة أيها الحاكم!\nتقسّم التلال الصخرية المنطقة. يمكن العثور على رواسب الخام في جنوب غرب الحافة يا سيدي.\n\nأتطلع إلى العمل معًا.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "مرحبًا أيها الحاكم!\n\nأنا الملكة فريغيث، حاكمة هذه المملكة. طلبت مساعدتك لتحقيق العظمة الحقيقية لهذه البلدة. الأرض غنية بالموارد، لذا يجب أن تكون مهمة سهلة عليك. لا تخيّب ظني.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "انظر إلى مساحة تلك المنطقة الشاسعة يا سيدي. أرض منبسطة بقدر ما ترى العيون! سنقدر على بناء مدينة كبيرة هنا في المستقبل القريب، ألا تظن ذلك؟";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "تحياتي أيها الحاكم.\nثمة فرص كثيرة للازدهار على ضفتي هذا النهر العظيم. فإن أماكن صيد الأسماك شاسعة والمناجم زاخرة بخام المعادن. سنؤسس هنا بلدة مزدهرة باسم الملك.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "هذا رائع أيها الحاكم.\nيحتوي هذا الأخدود على أحد أهم الطرق عبر الجبال. إن البلدة في موقع مثالي لتكون محطة رائعة للتجار العابرين. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "يا سيدي، في سفح هذه الشلالات ثمة أماكن كثيرة لصيد الأسماك. فضلًا عن أن رواسب خام المعادن الهائلة تجعل هذا المكان مثاليًا لتأسيس بلدتنا.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "مرحبًا إلى الحصن الجليدي يا سيدي.\nليس من السهل على أهل البلدة التسلق إلى القلعة، لكن منظر السهول من هنا يستحق العناء. تبدو أراضيك بلا نهاية من الأعلى هنا.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "صباح الخير يا مولاي.\n\nانظر إلى التلال في أراضيك. أليس المنظر رائعًا؟ هذا مكان جميل لتشييد بلدة يا مولاي.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "أتمنى لك صباحًا طيبًا يا سيدي.\n\nمرحبا بك في بلدتنا الصغيرة. يقال إن الحفرة نتجت عن نجم ساقط. لنأمل أن يكون قد جلب لنا الحظ. كتب الملك بالفعل أنه سيكون لدينا بعض المهام قريبًا.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "دفع جزية للملك.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "احتفال لأهل البلدة.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "تبرع للفقراء.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "احتفال صنع الجعة في البلدة.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "بيع الخنازير في السوق.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "تاجر في سوق الحيوانات.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "قايض الحيوانات في السوق.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "إمدادات الجيش.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "معدات من أجل جنود الملك.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "التصدي لهجمات قطاع الطرق.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "تدمير معسكرات قطاع الطرق.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "مرحبًا أيها المسؤول! ألق نظرة على هذا الساحل! أعتقد أن بلدتك تستحق هذا المنظر البديع!\nاعتن بأهل بلدتك جيدًا ولا تنس دفع الجزية للملك، حتى يتسنى لك مواصلة خدمتي!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "هذا مكان رائع لصيد السمك. ألا تتفق معي يا مولاي؟ لن ينقصنا طعام هنا!\nكما نود أن تقيم احتفالًا بين الحين والآخر، إذا كان بالإمكان تحمل تكلفته بعد دفع الجزية للملك!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "شكرًا لك يا عزيزي على جعلنا نستقر هنا! هذه البحيرة رائعة الجمال!\nسيسعد أهل البلدة بالعيش هنا بالتأكيد إذا اعتنيت بهم جيدًا!\nولا تنس دفع رشوة للملك حتى يتسنى لنا البقاء هنا إلى الأبد!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "يا سيدي، كان الانتقال للعيش بجانب وادي النهر هذا قرارًا حصيفًا!\nسيسعد أهل البلدة بالتأكيد عندما تساعد الفقراء والمحتاجين!\nلكن مع كل كرمك هذا، أقترح ألا تنس واجبك تجاه الملك!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "مرحبًا! رجالي مستعدون لدعمك في تأسيس عرش قوتك هنا في هذا المكان المحوري!\nسيكون هذا العام عام احتفال!\nفليحيا الملك ولتحيا معه!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "يا عزيزي الحاكم، سمعت عنك كثيرًا بالفعل! لهذا اخترتك: لتأسيس بلدة مزدهرة في سفح المنحدر الذي عليه قلعتي!\nحريّ بك البدء فورًا! وداعًا!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "يا مولاي، كُلفنا بتأسيس بلدة بالقرب من هذا النهر الجاف. سيكافئنا الملك مكافأة كبيرة إذا قمنا بواجبنا على أكمل وجه.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "يا سيدي، إن الهضبة التي عليها قلعتك مكان مثالي لتشييد بلدة صغيرة. كما أصدر الملك أمرًا بأن تقوم بعدد من المهمات التي يجب القيام بها.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "اكتُشف أرخبيل بالقرب من الساحل. آمرك بأن تستعمر هذه الجزر باسمي!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "يا سيدي، انظر إلى منطقة الغابات الجميلة هذه. سيكون تشييد بلدة هنا عملًا شاقًا، لكن ثمة وفرة من الخشب والغزلان.\n\nسيسهل هذا القيام بالمهمات التي كلفنا الملك بها.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "يا مولاي، سيصعب دفع الجزية للملك بسبب الشتاء القارس. علينا البدء في العمل فورًا…";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "إنه وادٍ بديع. ثمة ما يكفي من الموارد لدفع الجزية للملك. لكن احذر، يجب التخطيط بعناية لبناء المباني نظرًا لضيق المساحة.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "هذه جزيرة جميلة حقًا! يسرني أننا أتينا إلى هنا. علينا البدء فورًا في التخطيط لتشييد القرية!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "هنا أفضل مكان يمكننا مشاهدة المنطقة المحيطة منه. لكن لسوء الحظ، يطول فصل الشتاء على هذا الارتفاع، مما يؤثر كثيرًا في نمو المحاصيل.\n\nيُنصح بتخزين محاصيل احتياطية في فصل الصيف.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "تحياتي! كنا في انتظارك! استكشف رجالي المنطقة بالفعل وعثروا على عديد من عروق خام الحديد الواعدة في الأرض. \n\nمن الأفضل البدء في التعدين على الفور قبل أن يسبقنا أحد!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "من الجيد أنك هنا يا سيدي.\n\nالحاكم السابق هرب. وهو يهرب كان يصرخ بأن هذه المنطقة ملعونة.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "لم يكن الحاكم السابق مخطئًا تمامًا في هذا الشأن. الزراعة صعبة، بالكاد أي شيء ينمو هنا. حتى المياه شحيحة. لكنني متأكد من أنك ستجد حلًا.";
"T_GAME_QUEST_SCEN10_10_DESC" = "يشعر أهل البلدة بقليل من عدم الرضا من ناحية الشعائر الدينية يا سيدي. هل من الممكن بناء كنيسة في البلدة؟";
"T_GAME_QUEST_SCEN10_10_NAME" = "تحقيق سعادة دينية عالية.";
"T_GAME_QUEST_SCEN10_11_DESC" = "هل تتوقع أن يسير رجل في مكانتي على هذه الطرق الترابية أيها الحاكم؟ ابنِ طرقًا تليق بمدينة حقيقية!";
"T_GAME_QUEST_SCEN10_11_NAME" = "بناء طرق مرصوفة بالحجر في البلدة.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "بناء طرق ترابية في البلدة.";
"T_GAME_QUEST_SCEN10_12_DESC" = "قام أحدهم بعمل سيئ هنا يا سيدي. كل المباني تحتاج إلى كثير من الإصلاحات.\n\nعلينا الاستعانة بنجار لإصلاح كل المباني قبل أن تتداعى بالكامل.";
"T_GAME_QUEST_SCEN10_12_NAME" = "الاستعانة بنجار وتحقيق مستوى عالٍ من الرضا عن حالة المباني.";
"T_GAME_QUEST_SCEN10_13_DESC" = "أيها الحاكم! لماذا بلدتك صغيرة جدًا؟ لقد تخلفنا عن الأرشيدوق! \n\nسنخسر الرهان، إلا إذا تمكنت من زيادة عدد سكان البلدة عما قريب!";
"T_GAME_QUEST_SCEN10_13_NAME" = "زيادة عدد سكان القرية.";
"T_GAME_QUEST_SCEN10_14_DESC" = "خاضت العائلات الجديدة التي انتقلت للعيش في البلدة رحلة طويلة وشاقة وهم يتضورون جوعًا. لنقم مأدبة لهم ونحتفل ببداية الرهان الرسمية يا سيدي!";
"T_GAME_QUEST_SCEN10_14_NAME" = "إنتاج ما يكفي من الطعام لإطعام القرية.";
"T_GAME_QUEST_SCEN10_15_DESC" = "علينا البدء في التجارة مع التجار المسافرين. سيجذب وجود التجار في البلدة الزوار ويزيد شهرتها يا سيدي!";
"T_GAME_QUEST_SCEN10_15_NAME" = "ربح كثير من المال عبر التجارة مع التجار.";
"T_GAME_QUEST_SCEN10_16_DESC" = "كمية الضرائب التي تجمعها مثير للشفقة! ربما يجب بناء خزانة لزيادة عائدات الضرائب.";
"T_GAME_QUEST_SCEN10_16_NAME" = "بناء خزانة وجمع ما يكفي من الضرائب.";
"T_GAME_QUEST_SCEN10_17_DESC" = "المجوهرات، أحتاج إلى المجوهرات! رغم أنني أتساءل كيف ستجلب المجوهرات وليس لديك صانع مشغولات ذهبية.";
"T_GAME_QUEST_SCEN10_17_NAME" = "بناء ورشة صانع مشغولات ذهبية والبدء في إنتاج المجوهرات.";
"T_GAME_QUEST_SCEN10_18_DESC" = "عمل ممتاز يا سيدي. يمكنك الآن إرسال ملء عربة من المجوهرات إليّ.";
"T_GAME_QUEST_SCEN10_18_NAME" = "توصيل المجوهرات إلى التاجر.";
"T_GAME_QUEST_SCEN10_2_DESC" = "يا سيدي، أولويتنا توفير الطعام. نحتاج إلى الصيادين وصيادي الأسماك.";
"T_GAME_QUEST_SCEN10_2_NAME" = "بناء أكواخ صيادي أسماك وأكواخ صيادين.";
"T_GAME_QUEST_SCEN10_3_DESC" = "أيها الحاكم الصالح، لا يمكنني دعم مجهوداتك حتى تبني سوقًا.";
"T_GAME_QUEST_SCEN10_3_NAME" = "تحتاج إلى سوق لتوسعة القرية.";
"T_GAME_QUEST_SCEN10_4_DESC" = "يا سيدي! هل بنيت ورشة صانع أدوات بعد؟ بدأ الأرشيدوق في إنتاج الأدوات بالفعل!";
"T_GAME_QUEST_SCEN10_4_NAME" = "بناء ورشة صانع أدوات والبدء في إنتاج الأدوات.";
"T_GAME_QUEST_SCEN10_5_DESC" = "بعد كل العمل الشاق، نود مكانًا يمكن الاسترخاء فيه ومقابلة الأصدقاء واحتساء كوب من عصير العنب. ستكون الحانة مكانًا لطيفًا.\n\nوقتما تشاء بالطبع يا سيدي.";
"T_GAME_QUEST_SCEN10_5_NAME" = "حقق رضا كبير من الحانات.";
"T_GAME_QUEST_SCEN10_6_DESC" = "هل لدينا مساحة كافية لتسكين الناس يا سيدي؟ فكل العمال الجدد الذين ينتقلون للعيش في البلدة يحتاجون إلى منازل، أليس كذلك؟";
"T_GAME_QUEST_SCEN10_6_NAME" = "بناء منزلي بلدة كبيرين و4 منازل بلدة عادية.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "بناء مزيد من منازل البلدة الكبيرة.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "ابن منازل بلدة صغيرة أخرى.";
"T_GAME_QUEST_SCEN10_7_DESC" = "تحتاج البلدة إلى مزيد من الأنشطة الترفيهية الجذابة. ساحات المبارزة على سبيل المثال. احرص على توفير هذا النوع من الترفيه قبل وصول كبار الزوار.";
"T_GAME_QUEST_SCEN10_7_NAME" = "تحقيق رضا كبير من الترفيه.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "حقق رضا كبير من ساحات المبارزة.";
"T_GAME_QUEST_SCEN10_8_DESC" = "يا سيدي، ربما يجب تجميل هذه البلدة الكئيبة عبر بناء بعض التماثيل ووضع بعض الديكورات؟ لنقم بهذا قبل مجيء الملك مرة أخرى.";
"T_GAME_QUEST_SCEN10_8_NAME" = "تجميل البلدة بالديكورات.";
"T_GAME_QUEST_SCEN10_9_DESC" = "طاب يومك أيها الحاكم. هل تريد المقايضة؟\n\nأنا في حاجة طارئة إلى كمية كبيرة من الملابس من أجل القيام بصفقة مربحة مع الأرشيدوق. سأدفع لك مالًا كثيرًا إذا استطعت تحضير ما أحتاج إليه.";
"T_GAME_QUEST_SCEN10_9_NAME" = "تسليم حمولة من الملابس للتاجر.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "هذه كارثة بكل المقاييس أيها الحاكم! تفوق علينا أرشيدوق كانتربورو وأنهى تشييد بلدته قبلنا!\n\nاعتمدت على دعمك والآن خاب ظني. لعل الفوز بهذا الرهان كان حلمًا بعيد المنال من البداية. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "عمل ممتاز أيها الحاكم الصالح! تفوقنا على الأرشيدوق في بناء البلدة وتوسيعها. وفزنا بالرهان!\n\nأبهرني أداؤك وسأحرص بنفسي على أن تحصل على مكافأة سخية. كما أمنحك لقب الدوق، ولك كل الحقوق والصلاحيات المتعلقة به.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "لعلي نافست من هو أقوى مني يا خادمي المطيع.\n\nراهنت أرشيدوق كانتربورو على أنني سأستطيع تحويل أسوأ بلدة في مملكتي إلى مدينة مزدهرة قبل أن يفعل المثل مع أسوأ بلداته.";
"T_GAME_QUEST_SCEN12_01_START" = "إنه لطف بالغ منك زيارتنا. أرحب بك بالنيابة عن كل الرهبان الحاليين في الدير.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "مرحبًا إلى ديرنا يا مولاي.\nبالتأكيد يمكننا مساعدتك في منح الملك الهدية المثالية. لكننا نواجه بعض المشاكل مع قطاع طرق حاليًا. ربما يمكنك مساعدتنا.";
"T_GAME_QUEST_SCEN12_02_START" = "يا له من عمل فظيع!\n\nسرق أحدهم خشبنا! لا يمكننا تخزين الجعة التي صنعناها دون خشب نصنع منه براميل.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "لك جزيل الشكر يا سيدي! يمكننا الآن صناعة بعض البراميل من أجل الجعة مجددًا.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "بناء بعض أكواخ الحراجة.";
"T_GAME_QUEST_SCEN12_04_START" = "يا مولاي، يجب توسيع البلدة من أجل إكمال مهامنا. علينا أولًا تأسيس اقتصاد مستقر. لذلك، نحن بحاجة إلى إنتاج الأدوات.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "هذا رائع يا سيدي. يمكننا الآن توسيع البلدة أكثر.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "تأسيس سلسلة إنتاج أدوات.";
"T_GAME_QUEST_SCEN12_05_START" = "يجب إمداد البلدة بالطعام يا سيدي. لدينا مزرعة، لكن ليس لدينا طاحونة أو مخابز؟";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "عمل رائع! تتحول القرية إلى بلدة حقيقية.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "تأسيس إنتاج مستقر للطعام.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "كلا! قطاع الطرق الأشرار! لقد دمروا الدير!";
"T_GAME_QUEST_SCEN12_06_START" = "يا سيدي، ظل هذا الدير على هذا التل لقرون. سيكون من المروع إذا تدمر المبنى على يد قطاع الطرق الأوغاد أولئك. إنهم يهددون بتدميره منذ أسابيع…";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "عمل رائع يا مولاي.\nنجا الدير من هجمات قطاع الطرق أولئك وأنتجنا الجعة المثالية! \n\nلقد صارت مشروبًا فاخرًا! بديع بحق.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "حماية الدير.";
"T_GAME_QUEST_SCEN12_07_START" = "يجب إعادة بناء الدير وإلا لن نكمل مهمتنا في الوقت المحدد!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "عمل جيد يا سيدي! أعيد بناء الدير! يمكننا مواصلة المهمة الحالية: إنتاج الجعة المثالية!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "إعادة بناء الدير.";
"T_GAME_QUEST_SCEN12_08_START" = "علينا الحرص على أن يكون على الدير حراسة مشددة يا مولاي! من المفترض أن يزيد وضع برج حراسة إلى جانبه حمايته.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "بناء برج حراسة إلى جانب الدير.";
"T_GAME_QUEST_SCEN12_09_START" = "هل تعلم كم جندي يحب السجق؟\nيمكنك بناء مزرعة خنازير ومجزر لإنتاج بعض منه.";
"T_GAME_QUEST_SCEN12_09_START2" = "يا سيدي،\nأنصح بأن تأمر ببناء مزرعة خنازير ومجزر.\nهكذا سنتمكن من إنتاج اللحم لسكان القرية، والسجق الذي يحبه الجنود.";
"T_GAME_QUEST_SCEN12_10_START" = "أظن أن علينا أن نعطي أولئك الجنود المساكين بعض السيوف والدروع. سيحسن هذا استمراريتهم في القتال بشكل كبير. لهذا نحتاج إلى مستودع أسلحة ومدبغة.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "نجحنا يا مولاي! يمكننا الآن صناعة بعض الدروع للجنود.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "بناء مستودع أسلحة ومدبغة.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "بناء مستودع أسلحة.";
"T_GAME_QUEST_SCEN12_11_START" = "بما أن لدينا الآن مستودع أسلحة ومدبغة، فسيكون من الرائع البدء في إنتاج المعدات.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "هذا عظيم يا مولاي! سيؤدي الجنود بشكل أفضل في القتال الآن.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "صناعة المعدات من أجل الجنود.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "عمل رائع يا سيدي. من المفترض أن يكون الدير محميًا الآن من هجمات قطاع الطرق المقبلة!";
"T_GAME_QUEST_SCEN12_15_START" = "لم نستطع إصلاح حقول نبات الجنجل المدمرة.\n\nهلا تتفضل وتزرع بعضها؟";
"T_GAME_QUEST_SCEN12_15_TITLE" = "زراعة بعض حقول نبات الجنجل.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "بناء مزرعة لنبات الجنجل وزراعة بعض من حقوله.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "هاهاها. صار ديرك في طي النسيان. هذه المنطقة تحت سيطرتي الآن!";
"T_GAME_QUEST_SCEN12_16_START" = "هل تظن أن بوسعك حماية أولئك الرهبان الضعفاء؟ لا أظن ذلك. سأريك كيف سأسحق ذلك الدير الصغير.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "ستدفع ثمن ذلك في المرة المقبلة! لم ينته الأمر بعد...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "ردع الهجمات على الدير!";
"T_GAME_QUEST_SCEN12_17_START" = "يا سيدي، سأبدأ أنا وزملائي من الرهبان على الفور في إنتاج أفخر أنواع الجعة في البلاد.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "انتهينا من صناعة الجعة يا مولاي. وأنتجنا أنواعًا مختلفة عديدة من الجعة. علينا الآن اختيار الأفضل منها وتحسينه أكثر.";
"T_GAME_QUEST_SCEN12_18_START" = "قال كبير صناع الجعة إن علينا ترقية معدات صناعة الجعة لتحسينها أكثر. نريد إسعاد الملك، أليس كذلك؟ لذا يجب أن تكون هذه الجعة الأفضل في البلاد…";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "هذا عظيم يا سيدي! كل ما نحتاج إليه الآن مزيد من أفخر المكونات.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "ترقية الدير إلى المستوى 2.";
"T_GAME_QUEST_SCEN12_19_START" = "يا سيدي، أوشكت الجعة على أن تكون جاهزة. لكن لا تزال تنقصنا بعض المكونات. ستكون الأعشاب وبعض مسحوق الذهب مثالية لإنهاء المنتج.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "جلب الأعشاب وكتل الذهب الخام. ";
"T_GAME_QUEST_SCEN12_20_START" = "يجب أن تُترك الجعة لبعض الوقت لتنضج.\n\nلا يجب أن تؤثر فيها تأثيرات خارجية، لذا لا يجب أن تُمس الجعة في مرحلة الإنضاج.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "اكتملت يا مولاي. هلا تسمح لي بتقديم الجعة المثالية لك؟";
"T_GAME_QUEST_SCEN12_20_TITLE" = "الدفاع عن الدير حتى تكتمل صناعة الجعة.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "أردت شكرك بنفسي أيها المسؤول.\nكانت هذه أفضل هدية في يوم مولدي. لم أكن أعلم أنك على دراية بحبي للجعة.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "حماية الدير وصنع الجعة المثالية للملك.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "تحضير البلدة لمجيء الملك. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "هل ظننت أن بوسعك خداعي؟ خاب ظني، أنت لا تستطيع إدارة بلدة صغيرة.\n\nأنا أدير شؤون مملكة بأكملها، ولا أحتاج إلى خداع أحد!";
"T_GAME_QUEST_SCEN13_01_START" = "سأفحص ممتلكاتي خلال العام المقبل.\nستكون بلدتك الشهيرة على رأس الأماكن التي أزورها في رحلتي!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "أنا راضٍ عنك تمامًا!\nأنت ملم حقًا بكيفية إدارة بلدة بنجاح وتأكد أنك نلت استحساني.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "اجتياز فحص الملك.";
"T_GAME_QUEST_SCEN13_02_START" = "تحياتي، يا سيدي المسؤول! قررت المجيء إلى بلدتك مبكرًا لرؤية عظمتها!\n\nومن الواضح أنك كنت في انتظار مجيئي.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "عدم إثارة ريبة الملك.";
"T_GAME_QUEST_SCEN13_05_1_START" = "يجب أولًا مواصلة إنتاج البضائع!\n\nأعد تعيين عامل في كوخ الحراجة وأصلح مبنى نشر الخشب لمواصلة الإنتاج.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "عمل رائع يا سيدي.\nلكن لا وقت للراحة!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "تعيين عامل في كوخ الحراجة وإصلاح مبنى نشر الخشب.";
"T_GAME_QUEST_SCEN13_05_START" = "كلا! تدهورت البلدة بالكامل بسبب قطاع الطرق في الغابات.\n\nعلينا البدء في الترميم فورًا!";
"T_GAME_QUEST_SCEN13_06_START" = "احترقت السوق ويجب ترميمها!\n\nنحن في حاجة ماسة إلى البضائع لتحضير البلدة لمجيء الملك.";
"T_GAME_QUEST_SCEN13_07_1_START" = "كما نحتاج إلى نجار يا سيدي. فثمة عديد من المباني بحاجة طارئة إلى إصلاح!";
"T_GAME_QUEST_SCEN13_07_START" = "علينا إصلاح الخزانة حتى يواصل جامع الضرائب عمله.\nفالمال مطلوب من أجل الإصلاحات!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "علينا استخدام أموال الضرائب للقيام بالإصلاحات الضرورية.";
"T_GAME_QUEST_SCEN13_08_START" = "يجب إصلاح منازل البلدة وبناء منازل جديدة لاستقطاب مزيد من العمال إلى البلدة.\nلأن علينا مواصلة الإنتاج!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "لدينا الآن مساحة كافية لمزيد من العمال، لكننا لم ننته بعد.";
"T_GAME_QUEST_SCEN13_09_START" = "هذه كارثة!\nلا يمكننا إلا إصلاح الأماكن التي سيزورها الملك والأمل ألا يشك في أمرنا.\n\nأحسن استغلال وقت راحة الملك!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "الانتظار حتى يعلن الملك عن أول مكان سيزوره.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "رأى الملك قطاع طرق وبدأ يرتاب! علينا توخي مزيد من الحذر!";
"T_GAME_QUEST_SCEN13_10_START" = "يريد الملك استكشاف الغابات.\nعلينا تدمير معسكرات قطاع الطرق قبل أن يصل إلى هناك!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "كان ذلك وشيكًا! لكن لم ينته الأمر بعد…";
"T_GAME_QUEST_SCEN13_10_TITLE" = "تدمير كل معسكرات قطاع الطرق. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "كلا! لم ننجح في خداع الملك.\nبما أنه يشك في أمرنا الآن، لا يجب أن نرتكب مزيدًا من الأخطاء!";
"T_GAME_QUEST_SCEN13_11_START" = "يريد الملك السير في أرجاء البلدة.\nإذا رأى سكان البلدة غير الراضين، سيدرك بالتأكيد أن هناك خطبًا ما.\n\nكما نحتاج إلى بناء تمثال للملك!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "ممتاز! كان كل أهل البلدة في حالة جيدة خلال جولة الملك.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "رفع مستوى رضا سكان البلدة وبناء تمثال للملك.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "لم يُسر الملك!\nلا يجب أن نرتكب خطأ آخر!";
"T_GAME_QUEST_SCEN13_12_START" = "سيفحص الملك قواتنا.\nاحرص على أن يكون لدينا نوبة حراسة مبهرة في انتظار وصوله!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "ستبهر نوبة الحراسة هذه الملك بالتأكيد!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "تشغيل ما يكفي من الجنود.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "فشلنا يا سيدي. لم تكن الاحتفاليات بالمستوى الذي يقبله الملك وهو الآن مستاء! \n\nربما كان الصدق الطريقة الأفضل…";
"T_GAME_QUEST_SCEN13_13_START" = "يريد الملك احتفالية رائعة. احرص على أن يكون لدينا ما يكفي من المجوهرات والملابس الفخمة.\nسينهار كل شيء إذا فشلنا!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "نجحت الاحتفالية نجاحًا باهرًا! يبدو أننا تمكنا من خداع الملك.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "تحضير الملابس والمجوهرات.";
"T_GAME_QUEST_SCEN13_14_START" = "شوارعك أخطر من أتنقل عبرها ومعي كل بضائعي القيّمة.\n\nأنت وحدك في هذا!";
"T_GAME_QUEST_SCEN13_15_START" = "بعد أن هزمت قطاع الطرق، سيسرني المجيء إلى بلدتك والتجارة فيها مرة أخرى.";
"T_GAME_QUEST_SCEN13_16_START" = "إن التاجر جبان، لكنه يقول الحق!\nالغابات المحيطة بالبلدة محفوفة بالمخاطر. علينا تدريب الحراس على رصد قطاع الطرق.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " وضعت أساسات الدفاع في هذه القرية يا سيدي. لكن علينا توسيعها.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "بناء ثكنات وبرج حراسة.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "كلا! هل اجتاز قطاع الطرق دفاعاتنا؟! لن يُسر الملك عند سماع هذا. ";
"T_GAME_QUEST_SCEN13_19_START" = "لن تعدّ البلدة آمنة بوجود قطاع الطرق.\nلا تسمح بوقوع هجمات كثيرة خلال الفحص أو سيفضح أمرنا بالتأكيد!";
"T_GAME_QUEST_SCEN14_01A_START" = "يا مولاي، ألا تظن أن هذا الرجل يتصرف بغرابة؟";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "إرسال الأقمشة.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "يا سيدي، فشلنا في تنفيذ المهمة!\nكان ذلك المستشار الطبي محتالًا وهرب ومعه كل الذهب في الخزانة.\n\nلكن حالفنا الحظ ووجدنا العلاج في مختبره…";
"T_GAME_QUEST_SCEN14_01_START" = "صباح الخير يا مولاي. تفشى الطاعون في المملكة.\nحتى الملك مريض للغاية! علينا مساعدة المستشار الطبي للبلاط في إنتاج علاج بسرعة. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "وجدنا علاجًا في الوقت المناسب يا سيدي!\n\nسيذهب إلى الملك بينما نتحدث! هذه أخبار سارة للمملكة!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "العثور على علاج من أجل الملك.";
"T_GAME_QUEST_SCEN14_02A_START" = "ثمة خطب ما يا سيدي! يطلب هذا المستشار الطبي أشياء غريبة. ينتابني شعور سيئ...\n\nعلينا الانتباه لتصرفات هذا الرجل.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "سآخذ الجعة إلى الطبيب عندما تصدر الأمر.\nآمل أن يصنع علاجًا عما قريب. لا يملك الملك كثيرًا من الوقت!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "تسليم الجعة.";
"T_GAME_QUEST_SCEN14_02_START" = "أظن أن مصنع جعة في الدير سيكون أفضل طريقة لجلب بعض الجعة للملك. \n\nآمل أن تخفف الجعة معاناة الملك.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "أظن أن مصنع جعة في الدير ومزرعة نبات الجنجل سيكونان أفضل طريقة لجلب بعض الجعة للملك. \n\nآمل أن تخفف الجعة معاناة الملك.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "عمل رائع يا سيدي! سيساعدنا الرهبان بالتأكيد في صنع بعض الجعة! سيسر الملك.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "بناء دير.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "بناء دير وفرن تجفيف.";
"T_GAME_QUEST_SCEN14_03_START" = "نحتاج إلى مزرعة خنازير لجلب الخنازير إلى المستشار الطبي!\nعليك الأمر ببنائها في الحال يا مولاي.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "هذا رائع يا سيدي. يمكننا الآن الحصول على بعض الخنازير.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "بناء مزرعة خنازير.";
"T_GAME_QUEST_SCEN14_05_START" = "يا سيدي، تحتاج البلدة إلى ثكنات. علينا الحفاظ على تطبيق القانون والنظام في هذه الأوقات.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "يا سيدي! كنت أعلم!\n\nذلك المستشار الطبي محتال. كان لديه علاج الملك طوال الوقت.\nيبدو أن كان يصيب البلد بالمرض. \n\nسمحت لنفسي بأمر الحراس باعتقاله.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "هذه إهانة!\n\nكيف تجرؤون على اعتقالي! أنا المستشار الخاص للملك. \nلا يمكنكم فعل هذا…";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "خاب ظني فيك أيها الحاكم!\n\nرأيت رؤيا ليلة أمس! رأيت فيها أن عدم كفاءتك ستجلب التعاسة على هذه البلدة.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "أيها الحاكم! اسمي راسيكسين، مستبصر ومستشار طبي لدى الملك.\nسأحتاج إلى كل المساعدة التي يمكنك توفيرها!\nأولًا: اجلب لي بعض الأعشاب الطبية في أسرع وقت ممكن!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "أرى أنك جلبت كل الأعشاب التي أحتاج إليها.\n\nرأيت رؤيا ليلة أمس، رأيت فيها أنك لن تخذل الملك.\n\nالآن أؤمر مستشارك بأن يجلب الأعشاب لي واغرب عن وجهي. لدي عمل أقوم به.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "أرسل الأعشاب.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "ما كان يجب أن أعتمد عليك أيها الحاكم. أظهرت لي في الرؤى التي أراها أن عدم كفاءتك ستجلب الدمار إلى المدينة. لقد خيبت أمل الملك وأملي أيها الحاكم!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "أنا بحاجة إلى أقمشة كي أصفي العلاج. عليك إنتاج بعض الأقمشة من أجلي، وافعل هذا بسرعة حتى أتمكن من البدء في التصفية قريبًا.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "من الجيد رؤية أنك لا تضيغ وقتي أيها الحاكم.\n\nالآن اطلب تسليم الموارد، فأنا شخص مشغول للغاية!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "اصنع أقمشة.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "يجب تخفيف العلاج من أجل التصنيع بكميات ضخمة. الجعة هي المشروب المنشود. \n\nالآن ابدأ في العمل!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "في الوقت المناسب. الآن أوصلها إلى معملي.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "اصنع الجعة.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "لا... تأخر الوقت جدًا. الآن المصيبة التالية ستضرب البلدة.\n\nالخطأ خطأك!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "علينا اتخاذ إجراءات أكثر صرامة لإنقاذ الملك.\n\nأنا بحاجة إلى خنازير للتضحية بها للآلهة التقليدية.\nربما سيساعد هذا...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "لقد أخذت وقتك أيها الحاكم. لطف كبير منك أنك ظهرت من الأساس…";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "سلِّم خنازير.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "أنا بحاجة إلى...آآآ...أعني الملك بحاجة إلى غليون مميز لتخفيف ألمه.\n\nأعطني صندوقًا مليئًا بالعملات لشراء بعض الأدوية!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nأعطني هذا. أنا سـ... آآآ أعني...سيُسر الملك بالحصول على دوائه قريبًا. إنه في معاناة كبيرة.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "سلِّم المال.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "اكتشفت أن ملابس الملك تجعله مريضًا. إنه بحاجة إلى ملابس جديدة مصنوعة من مادة خاصة.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "أخيرًا أتيت بالملابس. كان صبر الملك قد بدأ ينفد.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "سلِّم الملابس.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "لم أعد أتحمل العمل في هذا المعمل القديم.\n\nابن لي برج حراسة يمكنني تحويله إلى معمل رائع. يجب أن يكون في برج لأني أحب الأبراج.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nسأخذ هذا البرج باسم الملك. سأحول هذا إلى معملي الجديد. الآن اغرب عن وجهي!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "ابنِ برج حراسة.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "يوجد شيء أخير ناقص أيها الحاكم.\n\nأنا بحاجة إلى سبائك ذهب لإكمال العلاج. أحضر لي بعض سبائك الذهب.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "وأخيرًا! الآن لا أحتاج إلا إلى بعض الوقت لتنقية العلاج.\n\nسأضطر إلى إجراء بعض التحضيرات لمغاد... أعني لإعطاء العلاج.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "سلِّم سبائك الذهب";
"T_GAME_QUEST_SCEN15_01_FAIL" = "ضاع كل شئ! سيتعين عليك أن تعيش بمعرفة أنك شاركت في وفاة العديد من الرجال الشجعان…";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "ضاع كل شيء! بدون الإمدادات اللازمة لم نتمكن من تحقيق النصر.\n\nسيتعين عليك أن تعيش وأنت تعرف أنك ساهمت في قتل عدد كبير من الرجال الشجعان!\n\nالملك يستشيط غضبًا...";
"T_GAME_QUEST_SCEN15_01_START" = "تحياتي، يا سيدي المسؤول.\nأتيت بطلب من الملك لأخذ الإمدادات للحرب الجارية.\n\nأعلم أن سكان بلدتك يعانون بشدة بسبب الحرب، لكن الجنود في الجبهة بحاجة ماسة إلى دعمك!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "تحياتي، يا سيدي المسؤول.\nأتيت بطلب من الملك لأخذ الإمدادات للحرب الجارية. أعلم أن سكان بلدتك يعانون بشدة بسبب الحرب، لكن الجنود في الجبهة بحاجة ماسة إلى دعمك!\n\nلا يمكن تحقيق النصر إلا إذا وصلت كل تسليماتك في الوقت المناسب.\n\nالملك يعتمد على دعمك.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "النصر حليفنا!\nأسهم دعمك القوي مساهمة كبيرة في النصر، ويدين لك رجالي بخالص الامتنان.\n\nأتمنى أن تسود أوقات السلام عما قريب!";
