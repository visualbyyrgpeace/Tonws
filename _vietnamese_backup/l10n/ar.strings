"T_SCENARIO_2016_10_QUEST_15_DESC" = "لزيادة سعادة شعبنا، يجب أن نبني ساحة مبارزة.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "يا سيدي، المدينة تزدهر بشكل جيد للغاية. للحفاظ على جميع المباني في حالة جيدة، يجب أن نبني ورشة نجار.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "إذا لم نفعل شيئًا ضد قطاع الطرق، فسوف يحرموننا من منازلنا وممتلكاتنا العزيزة.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "لدينا بالفعل بعض الجنود. آمل أن نتمكن من الدفاع عن المدينة ضد هجمات قطاع الطرق.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "يا سيدي، حان الوقت لوضع قطاع الطرق عند حدهم وإبعادهم عن هذه المنطقة.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "يبدو أن هناك حاجة إلى بعض الإجراءات الأكثر وضوحًا. البلدة الآن في إضراب!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "أهل البلدة في حالة إضراب. انتظر حتى يهدؤون.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "يا مولاي، يا له من يوم رائع، أليس كذلك؟\n\nلقد أتيت أماك كي أسألك عما إذا كان من الممكن التأكد من أن البلدة مزينة بما يكفي للاحتفالات.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "قم بزيادة مستوى الرضا بتزيين البلدة.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "لقد قمت بعمل رائع بهذه الديكورات الجديدة يا سيدي. البلدة تبدو رائعة!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "يا سيدي، العمال الذين يعدّون للاحتفال منزعجون جدا من قلة الترفيه في الاحتفالات. سمعت العديد منهم يقولون إنهم يرغبون في معسكر بهلوانيات.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "ابن معسكر بهلوانيات.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "رائع يا سيدي! عاد العمال للتحضير للاحتفالات. إنهم مليؤون بالبهجة لأن لدينا الآن معسكر للبهلوانيات في البلدة.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "هذه العواصف الرعدية تلحق أضرارا جسيمة بالبلدة. يجب أن نتأكد من إصلاح جميع المباني بشكل مناسب يا سيدي. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "قم بزيادة الرضا عن حالة المبنى.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "عظيم يا سيدي! الآن، المباني في حالة جيدة جدًا مرة أخرى.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "يا سيدي! عاصفة رعدية شديدة تهب على المدينة. يجب أن تصل إلى القلعة الآمنة. ضرب البرق بالفعل عدة مبان…";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "هل لي أن آخذ لحظة من وقتك يا سيدي؟\n\nمع كل هذه الاستعدادات... لا تنسَ عن أي شيء تدور هذه الاحتفالات... لا يمكن أن تحدث إلا بعد اكتمال الحصاد يا سيدي!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "أكمل حصاد العنب.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "يا له من مشهد رائع يا مولاي! اكتمل موسم الحصاد وأوشكت الاستعدادات للاحتفال على الانتهاء أيضًا. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "يا سيدي، لقد نفد الوقت منا. لقد فات الأوان الآن على المهرجان. لن يسعد الملك أن يسمع عن هذا…";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "رائع يا مولاي!\n\nاكتملت الاستعدادات للاحتفال. نحن فقط في انتظار أمرك لبدء الاحتفالات.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = "بموجب مرسوم ملكي، آمرك بإقامة عام من الاحتفالات. أريدك في كل موسم أن تنظم مهرجانًا على شرف زوجتي الجديدة!\n\nاذهب الآن وابدأ الاستعداد! لا تخيب ظني…";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "لقد خذلتني حقًا أيها الحاكم!\n\nلم يكن إعداد احتفالين بالمهمة الصعبة، لكنك فشلت رغم ذلك! هل طلبت الكثير؟ والآن اغرب عن وجهي!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "قم بترتيب كل الاحتفالات في الوقت المناسب!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "أيها الحاكم! لقد كان عامًا رائعًا من الاحتفالات.\n\nلقد أثبتّ أنه يمكنني الاعتماد عليك كلما واجهت مهمة صعبة.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "يا له من مهرجان جميل يا مولاي!\n\nلكن الآن علينا التأكد من تنظيم مهرجان الخريف كما هو مخطط وقبل بدء الشتاء! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "رتب مهرجان الخريف قبل أن يبدأ الشتاء.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "للتحضير لمهرجان الربيع، علينا الإسراع يا مولاي.\n\nيجب أن يكتمل المهرجان قبل بداية الصيف وليس لدينا الكثير من الوقت.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "قم بترتيب عيد الربيع قبل أن يبدأ الصيف.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "يا له من مهرجان جميل يا مولاي!\nلكن الآن علينا التأكد من تنظيم مهرجان الصيف كما هو مخطط وقبل بدء الشتاء! \n\nالوقت هو أهم عامل يا مولاي!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "رتب مهرجان الصيف قبل أن يبدأ الخريف.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "يا له من مهرجان جميل يا مولاي!\n\nعلينا التأكد من تنظيم مهرجان الخريف كما هو مخطط وقبل بدء الربيع! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "رتب مهرجان الشتاء قبل أن يبدأ الربيع.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "يا سيدي، أقترح بناء أرض احتفالات في أسرع وقت ممكن. ستقام جميع الاحتفالات هناك.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "ابنِ أرض احتفالات.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "عظيم يا مولاي! اكتملت أراضي الاحتفال. هذا المبنى مهم جدًا للمهام المطروحة، لذلك يجب أن نراقبه.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "يا سيدي، نحتاج إلى أرض احتفالات! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "أول شيء نحتاجه هو عمود مناسب يا مولاي. يمكن للحطاب أن يقطع لنا شجرة مناسبة تمامًا لهذا الغرض. ولكن، سيتعين عليه قطع العديد من الأشجار للعثور على أفضل شجرة.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "اجمع الخشب للعمود.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "يجب تزيين عمودنا بشكل صحيح. لهذا نحتاج أقمشة كافية يا سيدي.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "أنتِج أقمشة للعمود.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "يا له من عمود جميل. هل تعلم أنه من المعتاد أن يسرق إخوتي الأعمدة في المنطقة كل عام؟";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "هاهاها! عمودك لنا الآن! سيكون زخرفة جيدة أمام معسكر قطاع الطرق. إذا كان بإمكانك، يمكنك المجيء ومحاولة استعادته…";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "احمِ العمود من هجمات قطاع الطرق!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "اللعنة! تقريبا حصلت على العمود اللعين. لقد دافعت عنه جيدًا أيها الحاكم!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "يا سيدي! يوجد معسكر لقطاع الطرق بالقرب من البلدة. نحتاج المزيد من الرجال وبرج حراسة آخر لتأمين القرية.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "ابنِ برج حراسة آخر وعيّن عددًا كافيًا من الجنود.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "ممتاز! الآن يمكن لجنودنا الدفاع عن أرض الاحتفالات بسهولة أكبر عندما يهاجم قطاع الطرق!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "تمت سرقة العمود من مستودعاتنا. علينا مهاجمة معسكر قطاع الطرق واستعادته للتأكد من أن المهرجان يمكن أن يبدأ في الوقت المناسب.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "هاجم معسكر قطاع الطرق واستعِد العمود!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "انتصار! يتم إرجاع العمود إلى مستودعنا بينما نتحدث يا سيدي.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "يا سيدي! المزرعة تحترق! من فضلك، عليك أن تفعل شيئًا!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "يا لها من كارثة أيها الحاكم! احترقت المزرعة وخرب المحصول…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "أنقِذ المزرعة!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "أنا ممتن لك إلى الأبد يا مولاي!\n\nلكن النار دمرت الحصاد! قد لا يزال يتعين إلغاء الاحتفالات إذا لم نحصد الحقول في الوقت المناسب.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "مزرعة عائلتي احترقت يا سيدي! لن أعدّ أول خبز في السنة في الوقت المناسب للمهرجان. هل تكون لطيفًا جدًا وتأمر بإعادة بناء المزرعة؟";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "ابن مزرعة جديدة.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "شكرا يا سيدي.\n\n"لولاك كنت سأتدمر واحتفالات الصيف كادت ستُلغى!"\n\nلكن علينا الإسراع في حصاد القمح في الوقت المناسب!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "يا سيدي، علينا أن نعتني بالحصاد الآن. لا يزال هناك بعض الوقت حتى يبدأ المهرجان. علينا التأكد من حصاد ما يكفي من القمح.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "أكمل حصاد القمح.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "الجو حار جدًا هذه الأيام يا مولاي. آمل ألا يكون هناك حريق أو جفاف آخر يهدد الاحتفالات. ومع ذلك، لدينا الآن ما يكفي من القمح للعيد. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "يا سيدي، حقولي جافة جدًا، أعتقد أننا سنواجه جفافًا آخر هذا الصيف. هل يمكنك أن تكون لطيفًا جدًا وتبني بئرين لري الحقول؟";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "ابنِ عدة آبار لري الحقول.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "أحسنت يا مولاي! تم ري الحقول. الآن علينا فقط الانتظار حتى ينمو القمح مرة أخرى.\n\nآمل ألا يستغرق الأمر وقتًا طويلًا…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "يمكن أن يبدأ العيد بمجرد أن ننتهي من خبز أول خبز للحصاد يا مولاي. هلّا تكون لطيفًا جدًا للتأكد من اكتمال الخبز في الوقت المناسب؟";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "اخبز ما يكفي من الخبز لمهرجان الصيف.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "رائع يا مولاي. تم إعداد خبز العيد!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "يا سيدي! هناك شيء ما ينقص المهرجان... نحتاج الجعة! ينبغي أن تأمر ببناء مصنع للجِعَة في الدير من أجل الحصول على بعض الجعة التي ينتجها الرهبان!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "اصنع ما يكفي من الجعة لمهرجان الصيف.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "جيد جدا يا مولاي. هذه الجعة لذيذة حقًا ومنعشة في صيف حار مثل هذا.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "لدي فكرة رائعة عن احتفال الشتاء يا مولاي. في رحلاتي، تذوقت شرابًا شتويًا خاصًا يكون ساخنًا. سيكون هذا هو المشروب المثالي لعيد الشتاء.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "قم بتوصيل مكونات الشراب الساخن.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "ممتاز يا مولاي. الآن لدينا جميع المكونات الخاصة بالشراب الساخن. سأبدأ على الفور وأعد الشراب.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "يا سيدي، أتيت أمامك لأسأل عن ديكورات الشجرة. سيكون من الرائع حقًا أن يكون لديك بعض الحلي الذهبية.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "أنتِج سبائك الذهب للزينة.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "رائع يا سيدي. هذه الحلي جميلة حقا. أشكرك على قضاء وقتك الثمين في زخرفة هذه الأشجار. أعتقد أن هذا سيكون مهرجانًا رائعًا.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "أنا والرفاق نريد تنظيم مسرحية الميلاد للمهرجان. للأسف نحن نفتقد بعض الموارد الحاسمة للمسرحية. هلّا تتعامل بلطف وتزودنا بالمعدات اللازمة؟";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "جهز الموارد لمسرحية الميلاد.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "شكرا لك يا مولاي. الآن يمكننا البدء في صناعة الأزياء الخاصة بنا لمسرحية الميلاد.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "يا سيدي، فكرت في كعك الزنجبيل في العيد. ولكن قد يكون من الصعب الحصول على الموارد اللازمة.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "قم بتوصيل مكونات كعك الزنجبيل.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "عظيم يا مولاي. سأبدأ خبز الزنجبيل على الفور.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "في هذه الأوقات يجب ألا ننسى المحتاجين. لذلك أقوم بجمع الأموال من أجل الفقراء. سيكون من اللطيف حقًا أن تتبرع ببعض ضرائب البلدات من أجل قضيتنا.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "اجمع ضرائب كافية للفقراء.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "شكرًا لك على تبرعك السخي يا مولاي!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "يؤسفني إخبارك أيها الحاكم\nأني لا يمكنني زيارة بلدتك في الوقت الراهن.\nسمعت شائعات عن قطاع طرق في الغابة المحيطة ببلدتك. زيارة بلدتك في الوقت الحالي أمر خطير للغاية على التجار.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "شكرًا جزيلًا يا مولاي. الآن بعد أن تم إبعاد قطاع الطرق عن المنطقة سأزور بلدتك بانتظام مرة أخرى.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "لقد انهارت الكنيسة يا مولاي. في هذه الأوقات، نحتاج إلى كل الدعم الذي يمكننا الحصول عليه. نحتاج كنيسة أخرى في البلدة.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "أيها الحاكم، شيء غريب يحدث في هذه البلدة. لقد عانينا من سبع كوارث في هذا الموسم فقط! علينا معرفة ما يجري هنا. أنا على استعداد للاعتقاد بأننا ملعونون.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "يجب أن نغادر البلدة حالًا يا سيدي. ضاع كل شيء... سنهلك! اللعنة لن تُرفع أبدًا.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "ابحث عن طريقة لرفع اللعنة.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "لقد أنقذت البلدة! هذه أخبار رائعة. تم رفع اللعنة أخيرًا وتمكنت حتى من النجاة من الطقوس.\n\nستحتاج البلدة إلى بعض الوقت للتعافي على الرغم من ذلك…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "البلدة بحاجة إلى إمداد ثابت من الأعشاب الطبية بأسرع ما يمكن يا سيدي. وإلا فسيكون الطاعون خطرًا مستمرًا في بلدتنا.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "اصنع الأعشاب الطبية.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "لن نتغلب على الطاعون أبدًا دون بناء مستوصف واحد على الأقل يا سيدي. أقترح بناء أكثر.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "يحتاج الأطباء في البلدة إلى مواد أكثر للضمادات، من أجل علاج ضحايا الطاعون بشكل صحيح. يجب أن ترسل لهم بعض الأقمشة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "يا سيدي، الطاعون أصاب البلدة! للأسف، لن يقوم أي تاجر بزيارتنا طالما أن هذه الكوارث تحدث…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "نحتاج إلى طاحونة هوائية لنحول القمح إلى دقيق يا سيدي. في هذه الأوقات الصعبة، نحتاج إلى تكييف إنتاجنا الغذائي يا مولاي!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "لكي ننتج الخبز نحتاج أن نطلب بناء مخبز يا سيدي.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "الآن حان الوقت لتخزين الخبز. نحن بحاجة لإطعام البلدة. آخر شيء نحتاجه هو سكان يتضورون جوعًا.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "يا سيدي، الماشية… كل الحيوانات، والأسماك في النهر… كلهم يموتون! ما الذي يجري هنا؟";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "الكنيسة تحترق، أيها الحاكم. لقد تركنا السيد! يجب عليك مساعدتنا…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "لقد أجريت بعض الأبحاث في الكنيسة ووجدت وثائق قد تساعدنا يا مولاي.\n\nلكن الكنيسة الآن غير آمنة للدخول ولا يمكنني الوصول إلى المستندات الخاصة بي.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "شكرًا يا مولاي. هنا ألقِ نظرة على هذه الوثائق. كانت هناك مقبرة قديمة والتي بُنيت عليها بلدتنا المتواضعة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "كان هناك مرة مستشار خاص في المحكمة. كان عرافًا، لكنه فهم السحر الوثني ومثل هذه الأشياء. لقد جن جنونه وحاول أن يسمم الملك فسجن.\n\nسأتصل بالملك. ربما يسمح لنا بالتحدث مع الرجل.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "أصلح الكنيسة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "لن يساعدنا الملك، نحن بحاجة إلى التصرف بأنفسنا وتحرير العراف.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "يا سيدي! أهل البلدة في حالة ذعر! علينا ضبط الأوضاع لتهدئتهم.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "أيها الحاكم، لن أطلق سراح هذا الرجل الحقير والخائن من سجني. أنا لا أهتم بلعنتك، هذا الرجل حاول قتلي. سوف يتعفن في السجن.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "سحقًا أيها الحاكم... لماذا تهاجمنا؟ أعلم أننا سرقناك مرات لا تحصى، لكن هذا...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "شاهدنا اللعنة أيها الحاكم. لا يمكن لقطاع الطرق سرقة التجار الأثرياء عندما تحدث أشياء من هذا القبيل في الحي.\n\nسنساعدك على إخراج هذا الرجل من السجن...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "يوجد معسكر قطاع طرق بالقرب من بلدتنا يا سيدي. ربما يمكن "إقناعهم" بمساعدتنا في تحرير العراف من السجن.\n\nيجب أن يكون لهذا الرجل بعض الإجابات! أصدِر أمر الهجوم على ذلك المعسكر، لبدء مممم "مفاوضة"… صغيرة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "يا له من انتصار رائع على قطاع الطرق يا مولاي. الآن دعونا نتحدث معهم…\n\nربما قد يساعدوننا في كسر اللعنة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "يبدو أنه غضب الرب يا سيدي. المزارعون يفيدون بأننا نعاني من جفاف!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "قد تحتاج الاستعدادات للهجوم على السجن إلى بعض المعدات العسكرية، وبعض الملاعب المناسبة للتدريب. لنبدأ بمستودع أسلحة، حسنًا؟";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "رجالي بحاجة إلى التدرب على مداهمة السجن، أيها الحاكم. إذا كنت تريد حقًا المضي قدمًا في هذا الأمر، فنحن بحاجة إلى مكان ما للتدريب.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "ابنِ ميدانًا للتنافس في الرماية.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "أيها الحاكم، أعتقد أنه من الرائع الحصول على شيء نأكله ونشربه، على الأقل لقائد حفلة المداهمة، أنا!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "قدّم مؤنًا.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "حان الوقت لبعض المعدات، أيها الحاكم. هذه السيوف والفؤوس الخشبية التي نستخدمها عادة لن تكون مجدية ضد حارس السجن.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "سلّم المعدات العسكرية.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "يا سيدي، الشمس! هناك خسوف يتشكل! علينا أن نسرع وإلا فكلنا هالكون!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "رائع! نحن جاهزون تقريبًا لإخراج هذا الرجل من السجن! في المرة القادمة التي نلتقي فيها يمكنك التحدث إليه شخصيًا.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "ربما يمكنك إقناعي إن عوضتني. لم أتناول أي نقانق منذ مدة طويلة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "حسنًا، حسنًا. سأساعدك. يبدو أن تلك اللعنة التي أصابتك قوية فعلًا، لكن يمكن إزالتها من خلال طقس بسيط.\n\nلماذا بنيت بلدتك فوق مقابر قديمة في المقام الأول؟";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "الأمر الجيد هو أن تأثير اللعنة يمكن عكسه، لكننا نحتاج إلى بعض الموارد التي يصعُب الحصول عليها.\n\nنحتاج إلى بلورة مرو مشحونة وجرعة من الخلود وعصا برق.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "أيها الحاكم، بالصدفة وجدت واحدة من المرو في إحدى غاراتي. لسوء الحظ، أخذها "عامل" عندما انفصلنا عن عصابتنا.\n\nلديه معسكر قطاع الطرق الخاص به في المنطقة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "احصل على المرو المشحون من معسكر قطاع الطرق.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "أيها الحاكم، يمكن بناء عصا البرق بقضبان حديدية عادية وبعض الأدوات.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "ابنِ عصا البرق.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "يا سيدي، يمكنني تحضير الجرعة إذا أمكنك أن تحضر لي المكونات الضرورية.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "أحضِر مكونات الجرعة.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "الآن عليك شرب الجرعة مع حمل عصا البرق في يدك اليسرى وحجر المرو المشحون في يدك اليمنى. بعد ذلك، عليك الوقوف في مكان مفتوح حتى تضرب صاعقة برق العصا.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "عليك تأدية الطقس.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "أنت آخر شخص كان يمكن أن أتوقع أن يحررني من السجن، لأنك أنت السبب في دخولي إياه من الأساس.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "حسنًا، يبدو أنك تواجه مشكلة مع لعنة ما، والآن تريد مساعدتي؟";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "يا إلهي! هناك عاصفة رعدية تلوح في أفق بلدتنا الصغيرة. لنتأكد أن أبراج مراقبة الحرائق لدينا على أهبة الاستعداد!";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "أيها الحاكم. حضوري إلى بلدتكم أمر خطير للغاية بالنسبة إلي. لكن يمكنني ترتيب الأمور من أجلك إن كان بإمكانك دفع الثمن…";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "ألا تظن أن الجنود في البلدة يهدرون الكثير من الموارد القيّمة؟ يمكننا بيعها والحصول على أموال إضافية بسهولة. ما عليك سوى التأكد من إلهاء ضابط توزيع المؤن بطريقة ما.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "ألغِ تعيين ضابط توزيع المؤن على الثكنات.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "ألغِ تعيين الحمالين في القلعة.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "أيها الحاكم، يحتاج صبياني إلى بعض الوقت الهادئ عند أسوار المدينة، فكما تعرف، إنهم يحبون أن يكونوا بمفردهم عند "تخزين" البضائع خارج الأسوار. من المهم أن يكون الحراس قرب الأسوار في مكان آخر.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "ألغِ تعيين كل الجنود.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "لدي مشكلة صغيرة مع السكان في البلدة، فكما تعرف، وجودنا مساعدة لهم، وهم لا يريدون أن يدفعوا لنا مقابل أعمالنا الطيبة. هل تفهمني؟";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "اجمع الأموال مقابل الحماية.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "أيها الحاكم، للأسف لم تجمع أموالًا كافية تكافئ "نفقاتي" هنا في البلدة. أريد استعادة بقية أموالي. ماذا عن "استثمارك" بعض الأموال؟";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "تود عصابتي إقامة بطولة مراهنة صغيرة في الحانة الليلة، وهي "شبه قانونية". ما رأيك في أن تهتم بتوفير ترفيه ممتع في الحانة بإرسالك بعض الجعة و العصير.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = "يريد "شركائي في العمل" طعامًا جيدًا خلال مدة البطولة. عليك إرسال بعض النقانق والخبز حتى لا يصاب أحد بالجوع، هلّا تفعل؟";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "سلّم النقانق والخبز.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "أيها الحاكم، أتيتك بتكليف آخر. رجال عصابتي... إحم... أقصد شركائي في العمل بالطبع، يحتاجون إلى مزيد من وسائل الضغط لتأدية عملهم بصورة أفضل. ما رأيك في أن ترسل بعض الأسلحة والدروع، اتفقنا؟";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "سلّم الأسلحة والدروع.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "يريد "شركائي في العمل" بعض الترفيه أيها الحاكم. نحتاج إلى مشرب للاستراحة قليلًا. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "مرحبًا أيها الحاكم. شكرًا لك على توفير بعض الوقت للقائي. أنا أمثل… إحم… الفصيل "المشبوه". يمكننا دعمك في مسعاك نحو إعادة انتخابك، لكن أولًا عليك القيام ببعض المهام من أجلنا.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "أيها الحاكم، دعمتنا بإكمال مهام لنا والآن دورنا لإظهار بعض الامتنان لذلك.\n\nفعلت لي ما هو صعب علي والآن سأفعل لك ما يصعب عليك وأغير نتيجة الانتخابات لصالحك. ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "أكمِل جميع المهام للفصيل المشبوه.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = "اختر الفصيل "المشبوه".";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "اعمل مع نادي أصدقاء الزهور.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "اعمل مع نقابة التجار.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "اختر الفصيل العسكري.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "حدِّد فصيل النبلاء.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "يا سيدي، عليك التقرير بشأن الفصيل الذي تريد دعمه. بعدما تختار، عليك التركيز على تلبية طلبات الفصيل. بمجرد اقتناعهم بالتصويت لصالحك، يمكنك اختيار فصيل آخر.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "زُر الفصيل المتدين.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "اختر فصيل الخدم.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "زُر المجموعة البسيطة.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "لا شيء مميز إطلاقًا بهذه البلدة. يستطيع المرء أن يلاحظ أنكم لا تمتلكون حسًا جماليًا ولا تهتمون بالتفاصيل. لمَ لم تضع خطة لتغيير ذلك أيها الحاكم؟";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "ازرع المزيد من أحواض الزهور.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "أيها الحاكم، هل تتكاسل مجددًا؟ ألا ترى أن كل الزهور على وشك الذبول. ربما عليك الاهتمام أكثر بالطبيعة الخلابة من حولك.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "رائحة البلدة كريهة أيها الحاكم! الخطأ خطؤك هذه المرة حقًا. المجارير مسدودة وتفيض.\n\nعليك حل هذه الأزمة!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "ابنِ المزيد من مصارف مياه الأمطار.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "ها نحن ذا! أخيرًا أصبح مظهر المدينة لائقًا والزهور تترعرع في كل مكان، والآن أجد هذا! انظر إلى منازل البلدة! إن وصفها بالخربة أقل مما يعبر عن حالها.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "أيها الحاكم، هذا أمر مشين!\nتلك الحيوانات المنتشرة في كل مكان أكلت قدرًا كبيرًا من أجمل زهوري. كيف سمحت للأمور بالوصول إلى هذا؟\n\nأطالب بإقامة المزيد من أكواخ الصيد في الحال، لإبعاد تلك الكائنات عن أحواض زهوري.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "عليك الحرص على توفير أماكن كافية للجلوس من أجل معرض البستنة الخاص بالولاية. يُفترَض أن تكفي بعض المقاعد ذات الأماكن المُختارة بعناية في أرجاء البلدة.\n\nتأكَد من تنفيذ الأمر!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "ابنِ مقاعد في البلدة.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "يا لتلك الحيوانات المسكينة أيها الحاكم.\n\nتعيش الخنازير في ظروف قاسية هنا في البلدة ولا يمكنها التجول بحرية كما يُفترَض بها.\n\nيطالب نادي أصدقاء الزهور بتدمير مزرعة الخنازير ومحل الجزارة!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "اهدم مزرعة الخنازير ومحل الجزارة.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "أيها الحاكم، أنا رئيسة نادي أصدقاء الزهور. أنت تريد دعمنا في الانتخابات القادمة، لكن لمَ لا تُنتخَب امرأة ذات كفاءة مثلي لمنصب حاكم بلدة مثل هذه؟";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "رغم شكوكي في البداية في كفاءتك بصفتك حاكمًا، فقد أثبتّ بالفعل أنك صديق مخلص لنادي أصدقاء الزهور.\nسنصوّت لصالحك في الانتخابات.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "أكمِل كل طلبات نادي أصدقاء الزهور.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "يا سيدي، سيُنتخَب حاكم جديد في هذه البلدة قريبًا.\n\nأقترح أن نبدأ في إقناع الفصائل في البلدة بالتصويت لصالحك. لا أعتقد أن لدينا وقتًا لإقناعهم جميعًا، لذا عليك الاختيار بعناية مَن علينا أن ندعم.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "ظهرت نتيجة الانتخابات للتو يا سيدي.\n\nأخشى أنه علي إخبارك أننا لم ننجح في الحصول على أصوات كافية من الفصائل في البلدة.\n\nعلينا أن نخرج من القلعة قبل الأسبوع القادم، حيث سيتولى الحاكم الجديد إدارة مكاتبنا…";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "يا سيدي، نجحنا في إقناع فصائل كافية في البلدة للتصويت لصالحنا. أمنّا تفويضنا لإدارة هذه البلدة.\n\nلنحتفل بقضائنا أعوامًا عديدة قادمة في هذا المكتب.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "سيدي الحاكم، لم يبقَ وقت طويل حتى بداية الانتخابات. علينا الإسراع بإقناع فصائل كافية بالتصويت لصالحك.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "الوقت المتبقي: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "أقنِع 3 فصائل على الأقل للفوز بالانتخابات.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "يا سيدي، نقابة التجار غاضبة. تهدَّم السوق لدينا وكان يجب إعادة بنائه منذ وقت طويل للغاية.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "يا له من أمر مثير للغضب! خزّن أهل البلدة الحمالون كمية كبيرة جدًا من البضائع في مبنى النقابة التجارية، وانهار! كيف يمكننا تسيير أي تجارة مع حدوث مثل هذه الأمور طوال الوقت.\n\nأرجوك أن تعيد بناء النقابة التجارية.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "أعِد بناء النقابة التجارية.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "رائع يا مولاي. يمكننا الآن أن نبدأ في التجارة من جديد أخيرًا. هلّا تتكرم بإنشاء تنظيم للطلبات التجارية داخل النقابة التجارية؟ يُفترَض بهذا أن يعيد بلدتنا إلى مكانتها الملائمة في المنطقة.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "أنشئ تنظيمًا فعالًا للطلبات التجارية في النقابة التجارية.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "المال! كل شيء يدور حول المال دائمًا أيها الحاكم. إن أولويتنا الأولى هي التأكد من تحقيق ربح كافٍ من خلال التجارة.\n\nلنكسب المال أيها الحاكم!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "بدأت المساحات الشاغرة في سوقنا في الامتلاء بسرعة أيها الحاكم. عليك دراسة فكرة ترقية السوق كي يكون لدينا مساحات أكثر ونتمكن من التجارة بكفاءة أعلى.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "عليك ترقية السوق.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "يطالب الكثير من أهل البلدة بإقامة أكشاك تسوق صغيرة متفرقة في أنحاء البلدة أيها الحاكم. بهذه الطريقة يمكننا زيادة التجارة داخل البلدة. إنها فكرة جيدة جدًا، أليس كذلك؟";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "ضع أكشاك تسوق في البلدة.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "وفرت عقدًا تجاريًا مربحًا للغاية أيها الحاكم. إن أسعار الملابس والجعة زادت للغاية!\n\nأشم رائحة المال! الكثير من المال!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "عليك بيع الملابس والجعة في السوق.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "أيها الحاكم، أنا أمثل نقابة التجار. حتى تحظى بأصوات النقابة في الانتخابات القادمة، أنت بحاجة إلى تحسين الوضع التجاري في البلدة بشكل كبير.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "إنه يوم رائع للتجارة يا سيدي.\n\nنجحت في الدفع بهذه البلدة إلى أن تكون أكبر مركز تجاري في المنطقة. لهذا، سيظل تجار النقابة ممتنين لك للأبد.\n\nولنشكرك، سنصوّت لصالحك في الانتخابات المقبلة.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "أكمِل جميع المهام لنقابة التجار.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "هذا غير مقبول! غير مقبول كليًا!\n\nكيف يُفترَض بنا إمداد أبراج الحراسة وليس لدينا ثكنات في البلدة من الأساس.\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "ابنِ ثكنات.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "أخيرًا لدينا حاكم يعرف كيف يدير الأمور. حسنًا، من الحكمة تعيين بعض الجنود في أبراج الحراسة.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "بصفتي قائد وحدة، أجد أنه من المستحيل أن أنظم قواتنا وأعثر على وقت للراحة بعد القتال. جسدي الذي أنهكته الحرب يتوق إلى خيمة ضباط مريحة.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "ابنِ بعض خيام الضباط.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "أيها الحاكم، لا تزال أعداد قواتنا أقل مما يكفي. أي لص حقير سيضحك حتى يبلل سرواله عندما يواجه جيشنا المثير للشفقة.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "نحتاج إلى مؤن للجيش أيها الحاكم. أفضل المؤن النقانق. إنها تتحمل ويمكن تناولها بسهولة في الميدان.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "كيف يُفترَض بجنودنا الشجعان التدرب من أجل المعارك القادمة وليس هناك مكان لذلك، أيها الحاكم؟ بصفتي قائدًا للقوات المسلحة، أطالب بإنشائك ميدان للتنافس في الرماية.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "مرحبًا أيها الحاكم. أنت تريد دعم الفصيل العسكري في الانتخابات المقبلة.\n\nحسنًا، هناك الكثير لتفعله كي تقنعنا بالتصويت لصالحك.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "شكرًا جزيلًا أيها الحاكم. تجعلنا نحن الجنود البسطاء فخورين بأعمالك. لم يقف الجيش في هذه البلدة شامخًا هكذا قط حتى أصبحت حاكمنا. استحققت أصواتنا في الانتخابات.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "أكمِل جميع المهام للفصيل العسكري.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "ليست هناك بلدة كبيرة تقدم مجموعة محدودة من المشروبات لمواطنيها يا سيدي. ونحن النبلاء على وجه الخصوص نريد شيئًا فاخرًا مثل عصير العنب.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "يحتفل النبلاء بإكمال أجدد سلسلة إنتاج لك يا سيدي.\n\nنحن نحتاج إلى كمية كبيرة من عصير العنب من أجل الاحتفال، لكن أرجوك ألا تحضر نوعًا رخيصًا رديئًا…";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "يا سيدي، يستحيل أن تقصد أن نذهب إلى المشرب مثل بقية الرعاع. إن موقع البطولة خارج أسوار المدينة مُهمَل منذ سنوات.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "مات بطل مهم بالنسبة إلى النبلاء يا سيدي. إن بنيت له نصبًا تذكاريًا ومدفنًا لائقًا، فستُسعد الكثير من النبلاء في هذه البلدة.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "ابنِ ضريحًا وتمثالًا للبطل.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "يا سيدي، هذه البلدة ينقصها بعض الممتلكات القيّمة للنبلاء. لا يستطيع المرء التباهي بما يكفي بحياة المقام الرفيع عن طريق المجوهرات الثمينة يا مولاي.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "رائع يا مولاي. الطلب على المجوهرات مرتفع جدًا حاليًا، حيث يريد الجميع المجوهرات التي يرتديها الناس في البلاط الملكي.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "لقاؤك أخيرًا أمر عظيم يا مولاي. أنا أمثل فصيل النبلاء في بلدتك. إذا كنت تريد أن تكسب أصواتنا في الانتخابات المقبلة، فعليك تلبية طلباتنا الباهظة.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "حققت بالفعل كل طلبات النبلاء يا مولاي. في بلدتك، يتمتع النبلاء بكل الامتيازات التي يتمتعون بها في البلاط الملكي. فعلت أشياء عظيمة في هذه البلدة!\nلك أصواتنا في الانتخابات المقبلة.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "أكمِل جميع طلبات النبلاء.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "يتناقص مجتمعنا المتدين باستمرار. يقضي السكان وقتهم في تناول المشروبات أو الاحتفال. لا بد لهذا أن ينتهي.\n\nالسبب هو ذلك المشرب الفاسق. عليك هدمه! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "جيد جدًا! كان يجب أن يُهدَم ذلك المبنى المحرض على الفساد منذ شهور. أخيرًا امتلك أحد الشجاعة اللازمة لفعل ذلك.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "اهدم المشرب.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "لا تستطيع الكنيسة تحمل تهافت كل أولئك المؤمنين الجدد. منذ هدم المشرب، أصبحت الكنيسة مزدحمة للغاية.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "شكرًا للرب. يا لها من كنيسة مهيبة جديدة. أنت هدية من الرب أيها المبعوث.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "عليك ترقية الكنيسة أو بناء واحدة جديدة.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "لا يزال مجتمعنا المتدين غير راضٍ عن عطايا البلدة لدعم الدين. السكان بحاجة إلى زيادة رضاهم عن الدين!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "نجحت أيها المبعوث. كان إيماني بقدراتك في محله. أعدت السعادة إلى المجتمع المتدين.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "يشكو سكان الدير رفاقي من نقص إنتاج الجنجل في البلدة. لا يمكننا نحن الرهبان إنتاج الجعة دون القدر المطلوب من الجنجل.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "ابنِ فرن تجفيف.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "بما أن إنتاج الجنجل يزداد من جديد حاليًا، يجدر بك التفكير في زيادة ناتج الجعة.\n\nعليك ترقية الدير، أو إنشاء دير جديد.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "يشع الدير الجديد نورًا. أحسنت أيها الحاكم.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "عليك ترقية الدير أو بناء واحد جديد.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "علينا إنتاج قدر كافٍ من الجعة من أجل احتفاليات افتتاح الدير الجديد. سيكون ضيوفنا عطشانين.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "اكتملت عملية صناعة الجعة أيها الحاكم. هل تريد أن تنال الشرف بأن تكون أول من يتذوقه؟";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "إن مقبرة البلدة صغيرة للغاية ولا توجد بها أماكن كافية للقبور. أنت بحاجة إلى إعطاء أمر ببناء عدة أضرحة ومواقع دفن جديدة.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "وسِّع المقبرة: أنشئ أضرحة وقبور.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "يُفترَض بتوسيع المقبرة أن يتضمن إنشاء جدران جديدة لها. عليك الأمر بإنشاء جدران جديدة لتحديد أراضي المقبرة بوضوح.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "ابنِ جدران جديدة للمقبرة.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "مرحبًا بك أيها الحاكم. نحن رهبان الفصيل المتدين يمكننا أن ندعمك في الانتخابات المقبلة، بعدما تلبي مطالبنا.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "اشكر الرب أيها الحاكم. أكملت تلبية جميع مطالبنا. أعمالك ستذهب بك إلى النعيم، كما أن أصوات الفصيل المتدين ستكون لك.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "أكمِل جميع المهام للفصيل المتدين.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "يا سيدي، ليس لدى رجال الإطفاء سوى فرص محدودة في مواجهة الحرائق المندلعة في البلدة. وجود أبراج مراقبة حرائق أكثر في خدمتنا سيمثل مساعدة ضخمة.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "بعض أعضاء فصيل الخدم يتمنون وجود معسكر بهلوانيات في البلدة. هذا سيضمن أنه - حتى لنا نحن - يوجد ما يُضحك.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "أيها الحاكم الوقور، نحن أهل البلدة متعهدي النقل نُنهك حقًا مع كل مهام النقل تلك هنا. إن أمرك بإنشاء المزيد من المستودعات سيساعدنا كثيرًا.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "يا سيدي، يشكو النجارون من ملابسهم. إن مهام الإصلاح في أرجاء البلدة تؤدي إلى معدل عالٍ لاستهلاك ملابسهم. إنهم بحاجة ماسة إلى ملابس جديدة.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "سلِّم الملابس.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "يا سيدي، يحتاج أهل البلدة الحمالون إلى أحذية جديدة. لا حاجة بك إلى صنع أحذية جديدة، حيث يمكننا فعل ذلك بأنفسنا.\n\nنحتاج فقط إلى جلود وأقمشة.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "سلِّم الأقمشة والجلود.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "يا سيدي، إن تبرعًا بسيطًا منك لفصيل الخدم الخاص بنا سيضمن اقتناعنا التام بأنك أكرم حاكم على الإطلاق.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "تبرع بالمال للخدم.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "سيدي الحاكم، يحتاج جامع الضرائب إلى إجازة بشدة. إنه لم يعد صغيرًا، كما أن عظامه تؤلمه.\n\nيمكنك تدبر أمر جمع الضرائب بنفسك لبعض الوقت، أليس كذلك؟";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "ألغِ تعيين جامع الضرائب واجمعها أنت.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "يا سيدي، أنا أمثل فصيل الخدم في بلدتك.\n\nنحن نعمل حمالين ورجال إطفاء ونجارين وجامعي ضرائب. بما أن لنا أصواتًا في الانتخابات، فيمكنك "كسبها" بأن تجعل حياتنا أقل شقاءً قليلًا.";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "قمت بأشياء عظيمة لنا نحن الخدم يا سيدي. من الآن فصاعدًا، تبدأ عصور ذهبية لنا معشر الخدم. لم نكن لنتخيل قط أنك ستحسّن حياتنا في البلدة فعلًا.\n\nلك أصواتنا في الانتخابات!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "أكمِل جميع المهام لفصيل الخدم.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "يا سيدي! ينتشر الطاعون في البلدة. أرجوك، عليك مساعدتنا! إن أبنائي في منطقة تفشي الوباء وليس لدينا مشفى في البلدة.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "سيدي الحاكم، إن إمدادات الطعام في البلدة غير كافية. يقول المزارعون إننا نفتقر إلى مبانٍ ضرورية. عليك الأمر بإنشاء مزرعة جديدة ومخبز.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "ابنِ مزرعة ومخبزًا.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "يا سيدي، نحن معشر الأشخاص البسطاء ليس لدينا الكثير لنضحك بسببه، كما أن روتيننا اليومي مرهق. سيكون أمرًا رائعًا أن نحصل على مكان يمكننا فيه أن ننسى أحزاننا. ستكون أرض احتفالات المكان المناسب.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "يا سيدي، أغلب السكان يعيشون فقراء. يمكنك زيادة صيتك بإعادة بعض الضرائب إلى الشعب.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "أعِد بعض الضرائب إلى الشعب.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "بما أن لدينا الآن البنية التحتية اللازمة، يُفترَض بنا تقديم طعام أكثر تنوعًا للسكان. أغلب أهل البلدة يعيشون في فقر وليس لديهم لحم لتناوله على العشاء. بإمكانك تغيير هذا.";
