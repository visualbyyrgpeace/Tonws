"BUILDING_UPGRADE_TAXBONUS" = "مكافأة الضرائب";
"EVENT_WITCHHUNT_08_SUCCESS" = "أخيرًا لدينا طبيب في القرية. يمكنه بالتأكيد مساعدتنا في هذا المرض.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "انتظر حتى يعود الطبيب من العاصمة.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "سيسعد القرويون في البلدة أكثر إذا كان هناك مكان مشترك لهم يلتقون فيه ويتناولون كوبًا من عصير العنب أو يحتسون بعض الجعة بعد يوم شاق من العمل. أهذا كثيرًا لطلبه، يا سيدي؟";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "ارفع مستوى رضا المجتمع.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "حسنًا أيها الحاكم. إذا لن تقبل بالمقايضة معي، فسيأخذ رجالي ما نحتاج إليه بالقوة.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "حالفك الحظ هذه المرة. لكن المرة المقبلة لن يكون الأمر بهذه السهولة.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "هاهاها. ليكن هذا درسًا لك. أنا على يقين أنك ستقبل بالمقايضة معي في المرة المقبلة.";
"SCENARIO_CW_QUEST_B_20_DESC" = "أحتاج إلى كثير من الحجر يا سيدي. سأزودك بالخشب إذا أعطيتني الحجر.";
"SCENARIO_CW_QUEST_B_30_DESC" = "يا سيدي، جمعت بعض الخشب لدعم بناء القرية. سأقايض بعضًا منه بالقمح.";
"SCENARIO_CW_QUEST_B_40_DESC" = "شعرت ابنتي ببرد قارس الليلة الماضية. هلا تتفضل وتعطيني بعض الصوف؟ يمكنني إعطاؤك خشبًا قيمًا في المقابل.";
"SCENARIO_CW_QUEST_B_50_DESC" = "لدي سؤال يا سيدي... يريد ابني تعلم حرفة الدباغة. ويحتاج إلى بعض الجلود من أجل التدرب. سأقايض بعض الخشب بالجلود.";
"SCENARIO_CW_QUEST_B_60_DESC" = "هل لديك بعض الأعشاب يا سيدي؟ فلسوء الحظ، ليس لدي أي منها لتتبيل اللحم.\nسأعطيك أفضل الأخشاب لدي في المقابل.";
"SCENARIO_CW_QUEST_B_70_DESC" = "يا سيدي، أريد ترميم منزلي. هلا تقايض بعض الأدوات بآخر كوم من الحطب لدي؟";
"SCENARIO_CW_QUEST_B_80_DESC" = "أود إعداد وليمة يا سيدي. هلا تساعدني؟ سأزودك ببعض الخشب في المقابل.";
"SCENARIO_CW_QUEST_B_NAME" = "المقايضة مع المزارع.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "يا سيدي، تتضور أسرتي جوعًا. هلا تتفضل وتعطينا بعض السمك؟ وسأعطيك بعض الخشب من مخزوني الضئيل من الحطب في المقابل.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "لدي مخزون ضئيل من الخشب اللازم للإصلاحات. سأقايضه معك ببعض الحجر يا سيدي.";
"SCENARIO_CW_QUEST_C_10_DESC" = "يحتاج رجالي إلى مزيد من السمك. اجلب لي بعضًا منه وسأعطيك الخشب! كما سأترك قريتك الصغيرة وشأنها.";
"SCENARIO_CW_QUEST_C_20_DESC" = "أيها الحاكم! أريد أن أقدم لك معروفًا وأخذ بعض الحجر الثقيل من مخزونك. إذا وافقت، فسأعطيك بعض الخشب أيضًا.";
"SCENARIO_CW_QUEST_C_30_DESC" = "قبل أن تهدر القمح وتمنحه إلى مزارعيك، حريّ بك أن تعطيني إياه وسأعطيك أجود الخشب لدي.";
"SCENARIO_CW_QUEST_C_40_DESC" = "نريد وضع الصوف على مقابض سيوفنا لتصير أرق. لكن لا تقلق، إذا ساعدتنا، لن نستخدم السيوف ضدك.";
"SCENARIO_CW_QUEST_C_50_DESC" = "يشعر رجالي بالملل. إذا زودتنا بالجلود، فسنتمكن من تحسين دمى التدريب ونجعلها تبدو أكثر واقعية. إذا لن تقبل بالمقايضة معي، فسنتدرب على أهل بلدتك.";
"SCENARIO_CW_QUEST_C_60_DESC" = "أحد رجالي مريض. وسمعت أن الأعشاب يمكنها مساعدته. سأبحث عنها في مخزونك إذا لا تمانع. أنا على يقين من أنني سأجدها.";
"SCENARIO_CW_QUEST_C_70_DESC" = "صارت أدواتنا بلا جدوى. ولديك عديد منها أيها الحاكم. تكرّم وأعطني بعضًا منها وإلا سأتكرّم وآخذها بنفسي عنوة.";
"SCENARIO_CW_QUEST_C_80_DESC" = "يريد رجالي أكل بعض اللحم. أعطني اللحم وسأكون في غاية اللطف لدرجة أن أعطيك الخشب مقابله. \n\nأو سيزور رجالي بلدتك الصغيرة ويأخذون اللحم بأنفسهم عنوة…";
"SCENARIO_CW_QUEST_C_NAME" = "المقايضة مع قاطع الطرق.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "حاكم جديد إذن...\nبما أنك جديد هنا، فيجب أن أشرح لك القواعد. أنت تعطيني ما أريد، وأنا أدعك تقوم بما تقوم به أياً يكن.\n\nهذه صفقة عادلة، صحيح؟ حسنًا، لنبدأ بمهمة سهلة: اجلب لي بعض السمك!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "نقص في الخشب؟ لا مشكلة!\nلقد سرق... خزّنت كومًا كبيرًا. من الخشب. وسأقايضك بعض الخشب مقابل بعض الحجر.";
"SCENARIO_THIEF_FAIL" = "لا تقبل بالمقايضة معي حقًا، أليس كذلك؟\n\nحسنًا، سترى عواقب ذلك.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "انظر ماذا لدينا هنا يا سيدي... يبدو وكأنه سن. من غير بشري. وهنا! المزيد من الكمأة. ليس لدي المعرفة الكافية لتفسير الأمر، لكنني أعرف شخصًا يمكنه أن يساعدنا. لنذهب لرؤية الرجل العجوز!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "من غير التاجر يمكنه أن يلوم السكان المحليين بهذا القدر؟ لقد شارك في الجريمة!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "التاجر!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "إنها الفتاة على الأرجح! إنها أخت فتاة البلدة المنفية. هذا دافع!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "الفتاة الصغيرة!";
"THEBEAST_CHOICE_A_REASON_DESC" = "نفذت الفتاة التي نفتها الملكة ظلمًا هذه الهجمات. أرادت الثأر بسبب النفي القسري الذي مرّت به.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "ث رمزًا للثأر!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "مسار القرية نحو الازدهار تحوّل إلى كابوس... ربما لم يكن هناك نيّة للأذى وأراد مساعدة جاره فحسب.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "هيكتور، الفنان!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "بالتأكيد هو! إنها يكره الوافدين الجدد وهاجم أخت الفتاة المنفية للتأكد من أنها لن تفعل أي شيء لإلحاق الضرر بمزرعة العنب الخاصة به.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "بازل المزارع.";
"THEBEAST_CHOICE_B_REASON_DESC" = "أراد المجرم طرد أهل البلدة منها بإخافتهم ومنع السكان الجدد من الانتقال إلى هنا.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "لإثناء المزيد من الوافدين الجدد عن الهجرة إلى البلدة!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "لا بد أنها مدّت المجرم بالمال.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "الملكة فريغيث!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "إنه الخباز! كان يدّعي أنه تمت مهاجمته لتفادي الشكوك! يا له من عبقري!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "الخباز.";
"THEBEAST_CHOICE_C_REASON_DESC" = "انضمت الملكة فريغيث إلى قوى أخرى من بعض السكان لترويع الوافدين الجدد حتى تغلق الحدود مجددًا، بعدما ندمت على قرارها بفتحها!";
"THEBEAST_CHOICE_C_REASON_TITLE" = "مؤامرة الدولة.";
