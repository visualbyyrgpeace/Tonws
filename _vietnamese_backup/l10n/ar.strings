"T_MAIN_MENU_LOADGAME" = "تحميل اللعبة";
"T_MAIN_MENU_PRESS_TO_CONTINUE" = "اضغط على أي زر للمتابعة";
"T_MAIN_MENU_START" = "اضغط للبدء";
"T_MAIN_MENU_TOUCH_TO_CONTINUE" = "اللمس للاستمرار";
"T_MAP_CANALGRANDE_DESC" = "بحيرة بها العديد من الجزر الصغيرة هي المكان المثالي لبناء بلدة متصلة بالجسور وتعبرها القنوات.";
"T_MAP_COASTALISLAND_DESC" = "يوجد في هذا الخليج جزيرة مثالية. هل يمكنك تأسيس بلدة ذات أهمية حقيقية في هذا الموقع البعيد؟";
"T_MAP_COASTSANDCLIFFS_DESC" = "القلعة تطل على المحيط من منحدر مرتفع. يمكنك بناء بلدة ساحلية لطيفة على الهضاب المحيطة.";
"T_MAP_COASTSANDCLIFFS_NAME" = "المنحدرات والسواحل";
"T_MAP_DESC_10" = "هذا الوادي الخصب مناسب بشكل مثالي لبناء بلدة مزدهرة.";
"T_MAP_DESC_11" = "تم إنشاء هذه الخريطة لاختبار الأداء على جميع الأجهزة. مدينة ضخمة للغاية منتشرة في كل الخريطة.";
"T_MAP_DESC_12" = "المياه المتموجة للأنهار في هذه المنطقة تدعو سكان البلدة للذهاب للصيد أو السباحة في المياه النقية للغاية.";
"T_MAP_DESC_13" = "أسفل الهضبة الظليلة توجد قرية صغيرة قد تتحول إلى بلدة كبيرة.";
"T_MAP_DESC_14" = "تعاني المملكة من جفاف والنهر قد نضب. هذا يجعل زراعة الأرض وتوفير طعام لسكان بلدتك مهمة صعبة.";
"T_MAP_DESC_15" = "أسس مركز تجارة مزدهر على الهضبة. في انتظارك صفقات مربحة مع التجار والفرسان.";
"T_MAP_DESC_16" = "أسس مستعمرة تعدين ووفر الموارد لبناء كاتدرائية ضخمة.";
"T_MAP_DESC_17" = "حضر تجهيزات زفاف ملكي كبير.";
"T_MAP_DESC_18" = "ابن بلدة كبيرة بالقرب من مجرى النهر الجاف هذا، لكن تذكر أن المياه سلعة نادرة في هذه المنطقة.";
"T_MAP_DESC_19" = "توجد هضبة صغيرة بالقرب من حافة المستنقعات. مكان مثالي لبناء بلدة.";
"T_MAP_DESC_2" = "هذا المكان الهادئ على الساحل هو الموقع المثالي لتأسيس قريتك.";
"T_MAP_DESC_20" = "منطقة جبلية معزولة في منتصف العدم. لا توجد مياه، لكنها غنية بالمعادن. يعد هذا المكان مثاليا للثراء السريع!";
"T_MAP_DESC_2016_01" = "الملك بحاجة إلى الكثير من الألواح لبناء أسطول كبير. اعرف سبب توقف تسليم الألواح، وأنشئ نقابة تجارية.";
"T_MAP_DESC_2016_02" = "هذه المنطقة الجميلة مكان مثالي لبناء مدينة كبيرة. توفر التلال الشاسعة مساحة كبيرة لمباني لا حصر لها.";
"T_MAP_DESC_2016_03" = "بلدة صغيرة تحولت إلى مدينة مزدهرة كبيرة. حقق رغبات سكان البلدة واحتياجاتهم في الوقت المحدد.";
"T_MAP_DESC_2016_04" = "غيِّر وظائف سكان البلدة المتوفرين بحكمة لبناء سوق وحانة.";
"T_MAP_DESC_2016_05" = "خطط بلدتك جيدًا، فالمساحة للمباني نادرة بين الشلالات، كما أن التضاريس يمكن أن تكون صعبة في التنقل.";
"T_MAP_DESC_2016_06" = "تحدث انهيارات ثلجية شديدة في هذه المنطقة. بجانب هذا، يجب أن تؤسس بلدة صغيرة وتستفيد من رواسب الخام الغنية.";
"T_MAP_DESC_2016_08" = "ابن بلدتك في الوادي. يمكنك العثور على كل شيء تحتاج إليه، لكن بعض المناطق صعب الوصول إليها.";
"T_MAP_DESC_2016_09" = "اعبر النهر للوصول إلى الموارد المطلوبة لمدينتك.";
"T_MAP_DESC_2016_10" = "وفر بضع العملات، لكن احذر حيث إن قطاع الطرق قد اتخذوا من هذه المنطقة مخبأ لهم. بالإضافة إلى تهديد قطاع الطرق، سكان البلدة غير السعداء لن يدفعون الضرائب.";
"T_MAP_DESC_21" = "أسس قرية على جزيرة رائعة ومخبأة. استمتع بهواء البحر الطلق!";
"T_MAP_DESC_21_NOBANDITS" = "أسس قرية على جزيرة رائعة ومخبأة. استمتع بهواء البحر الطلق!";
"T_MAP_DESC_22" = "حافظ على قريتك واعبر بها بسلام من فصل الشتاء القارس.";
"T_MAP_DESC_23" = "عليك أن تبني بلدة عاملة على هذا السهل المتجمد بسرعة شديدة وإلا ستموت جوعًا في الشتاء.";
"T_MAP_DESC_24" = "ادعم الملك في مشروعه لبناء أسطول مهيب من السفن مع البقاء مسيطرًا على الاضطرابات المتزايدة في بلدتك.";
"T_MAP_DESC_25" = "استخدم الغابة المجاورة في هذه المنطقة لصالحك عند محاولة تأسيس بلدتك. المياه نادرة هنا، لذلك لا يمكن الاعتماد على الصيد.";
"T_MAP_DESC_26" = "دخل الملك في رهان، ومهمتك هي بناء مدينة كبيرة قبل الأرشيدوق. ليس أمامك الكثير من الوقت لإكمال جميع المهام. لا تخيب أمل الملك!";
"T_MAP_DESC_27" = "مناطق المستنقعات تجعل العثور على أرض مناسبة للبناء أمرًا صعبًا. تأكد من استخدام الأراضي المتوفرة للبناء بأفضل طريقة ممكنة!";
"T_MAP_DESC_28" = "وادي صخري يحتوي على الكثير من الموارد، ولكن مساحة المباني نادرة.";
"T_MAP_DESC_29" = "مجموعة صغيرة من الجزر. استعمارها سيكون تحديًا.";
"T_MAP_DESC_29_NOBANDITS" = "مجموعة صغيرة من الجزر. استعمارها سيكون تحديًا.";
"T_MAP_DESC_3" = "هذه هير خريطة الدرس التعليمي. هنا ستتعرف على عالم Townsmen.";
"T_MAP_DESC_30" = "ابن بلدة تحيط بجبلك المنعزل، لكن توخ الحذر لأن شتاء طويل قادم.";
"T_MAP_DESC_31" = "سيزور الملك أراضيه. تجهز لهذه الزيارة.";
"T_MAP_DESC_32" = "عيد ميلاد الملك قد اقترب. الآن ابحث عن الجعة المثالية كهدية. ربما يعرف الرهبان في الدير معلومات أكثر...";
"T_MAP_DESC_33" = "يعاني الملك من مرض غامض. القرار بيدك أنت: إما معالجته وإما محاولة معرفة من أين أتى المرض.";
"T_MAP_DESC_34" = "تمكنت الحرب من هذه الأرض. وبعيدًا عن جبهة القتال، يجب أن تؤسس بلدة مزدهرة وتدعم جيش الملك.";
"T_MAP_DESC_35" = "يرغب الملك في التجهز لأوقات عصيبة، وتم اختيار بلدتك لتسليم السلع المطلوبة.";
"T_MAP_DESC_36" = "اعرف تفاصيل الحرب من محارب قديم.";
"T_MAP_DESC_37" = "حقق رغبات زوجتك وفي الوقت نفسه تعامل مع قاطع طريق مبتز.";
"T_MAP_DESC_4" = "قلعتك موجودة على جزيرة نهرية صغيرة. استخدام ضفاف النهر المجاورة بحكمة وابن اقتصادًا مزدهرًا.";
"T_MAP_DESC_6" = "ابن قرية صغيرة على ضفاف بحيرة جميلة.";
"T_MAP_DESC_7" = "اختار الملك بلدتك لاستضافة أكبر مبارزة في المنطقة!";
"T_MAP_DESC_8" = "الشتاء قادم. ساعد سكان بلدتك في التجهز للفصل الثلجي!";
"T_MAP_DESC_9" = "ادعم زوجتك واجعل اقتصاد قرية منهكة يزدهر مرة أخرى!";
"T_MAP_DESC_APOCALYPSE" = "تعاني البلدة من لعنة، وأمراض غريبة ومصائب أغرب تثقل كاهل السكان. القرار قرارك بالعثور على طريقة لحل اللعنة في أسرع وقتٍ ممكن. مهما كلف الأمر...";
"T_MAP_DESC_FESTIVITIES" = "تزوج الملك مرة أخرى. وللاحتفال بزوجته الجديدة، مطلوب منك استضافة عدة احتفالات موسمية، لكن التحطيط والتنفيذ قد يكونا صعبين. سيكون هذا سباقًا عكس عقارب الساعة...";
"T_MAP_DESC_ICYHOLD" = "عالية على منحدر يقف الحصن الجليدي. يصعب الوصول إليها، ولكن بمجرد توسعته يمكن للمرء أن يرى بعيدًا في المنطقة المحيطة بالتندرا الباردة. الشتاء طويل جدًا في هذه المنطقة!";
"T_MAP_DIPLOMATICVISIT_DESC" = "ستأتي ملكة بلد حليف لنا لزيارة المدينة. ستُعقد اتفاقيات تجارية مربحة، لكن يجب تخطي حاجز اللغة أولًا.";
"T_MAP_DIPLOMATICVISIT_NAME" = "زيارة دبلوماسية";
"T_MAP_DIVIDEDSHORELINE_DESC" = "هناك جبل شاهق يقسم أراضيك هذه. علاوة على ذلك، يمكنك غزو جزيرة بالقرب من قلعتك.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "الشاطئ المنقسم";
"T_MAP_FRIGYTHKINGDOM_DESC" = "تحتاج الملكة فريغيث إلى حاكم جديد ليدير هذا الجزء من المملكة. ابنِ بلدة هائلة في هذه الأرض الجديدة.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "مملكة فريغيث";
"T_MAP_FROZENFRONT_DESC" = "تسببت الحرب الأخيرة في تحويل معظم البلدة إلى أنقاض. بقايا البلدة المغطاة بالثلج الآن تحدد المكان الذي وقعت فيه المعركة العظيمة بين الجيوش. الآن حان وقت إعادة بناء البلدة.\n\nهذه خريطة للشتاء فقط!";
"T_MAP_HIGHLANDS_DESC" = "تقطع الجبال والتلال هذا البلد. يا له من منظر رائع عندما تصل إلى القمم.";
"T_MAP_HIGHLANDS_INTRO" = "مرحبًا بك في الهضاب أيها الحاكم. هذه المنطقة مليئة بالألغاز. وأنا متأكد من أنه ستكشف لك الأرض عن أسرارها إذا أصغيت جيدًا واهتممت بأحوال السكان واعتنيت بهم.";
"T_MAP_HIGHLANDS_NAME" = "الهضاب";
"T_MAP_INSANECHOICES_DESC" = "دُعيت إلى قرية حيث يبدو دوقها مجنونًا، ويرفض أهل البلدة دفع أي ضرائب!\nكل اختيار تتخذه سيقودك إلى نهاية مختلفة.";
"T_MAP_INSANECHOICES_NAME" = "الخيارات الجنونية";
"T_MAP_LEGACY_DESC" = "الملك لديه مهمة جديدة من أجلك. إنه يكبر في السن ويخشى أن يغادر هذا العالم دون أن يترك إرثًا. يريد منك أن تنقل الدروس التي تعلمها في أثناء حكمه إلى الأجيال القادمة.";
"T_MAP_LEGACY_NAME" = "الإرث";
"T_MAP_LOWLANDS_DESC" = "تمتد السهول الواسعة والكثير من مساحات المباني إلى الأفق. يمكن بناء مدينة كبيرة للغاية هنا.";
