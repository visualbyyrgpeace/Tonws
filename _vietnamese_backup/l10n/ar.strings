"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_2" = "الغ تعيين عامل من مبنى!";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_3" = "أوقف إنتاج مبنى نشر الخشب بإزالة العامل.";
