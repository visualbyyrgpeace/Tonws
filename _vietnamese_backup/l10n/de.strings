"T_GAME_HELPPAGE_DLC_AZURE_BUILDING_CASTLES" = "Von nun an ist es möglich in Endloskarten den Typ des Schlosses zu wählen. Das normale Schloss hat ein für die „The Seaside Empire“ angepasstes Aussehen. Zusätzlich gibt es nun ein Militärschloss, welches entscheidende Vorteile gegen Banditenangriffe bietet.";
"T_GAME_HELPPAGE_DLC_AZURE_BUILDING_CASTLES_MILITARY" = "Normales Militärschloss und „The Seaside Empire“ Militärschloss";
"T_GAME_HELPPAGE_DLC_AZURE_BUILDING_SKINS" = "Fast alle Gebäude haben in „The Seaside Empire“ ein neues Aussehen bekommen.";
"T_GAME_HELPPAGE_DLC_AZURE_CHOICE_POPUP_01" = "Kurzgeschichten können ausgelöst werden, wenn bestimmte Bedingungen erfüllt sind. Beispielsweise, wenn ein bestimmtes Gebäude errichtet wurde oder die Einwohnerzahl eine bestimmte Größe erreicht hat.";
"T_GAME_HELPPAGE_DLC_AZURE_CHOICE_POPUP_02" = "Manchmal sind eine oder mehrere Auswahlmöglichkeiten innerhalb einer Entscheidungssituation einer Kurzgeschichte nicht verfügbar. Dies resultiert daraus, dass eine Voraussetzung nicht erfüllt ist.";
"T_GAME_HELPPAGE_DLC_AZURE_CONTENT" = "Inhalt";
"T_GAME_HELPPAGE_DLC_AZURE_CONTENT_ONLYAZURE" = "Manche Inhalte, wie z.B. der Hafen, sind nur in „The Seaside Empire“ verfügbar.";
"T_GAME_HELPPAGE_DLC_AZURE_HARBOR_PLACEHOLDER" = "Der Hafen kann nur auf Karten von „The Seaside Empire“ auf besonderen Stellen am Strand errichtet werden. Diese sind durch Holzpfähle gekennzeichnet.";
"T_GAME_HELPPAGE_DLC_AZURE_INTRO" = "Einführung";
"T_GAME_HELPPAGE_DLC_AZURE_NEWCONTENT_01" = "Neue Gebäude und Dekorationen sind im Baumenü verteilt zu finden. Das neue Setting lässt sich nur über die Kartenauswahl im Hauptmenü erreichen und eine neue Stadt in „The Seaside Empire“ gestartet wird.";
"T_GAME_HELPPAGE_DLC_AZURE_NEWCONTENT_02" = "Kurzgeschichten und Ereignisse, sowie das Militärschloss sind erst verfügbar, wenn man ein neues Endlosspiel startet. Hier finden sich zusätzlich mehrere Optionen, um das Endlosspiel zu personalisieren.";
"T_GAME_HELPPAGE_DLC_AZURE_SANDBOX_SETTINGS" = "In den Einstellungen einer Endloskarte können Banditen, Katastrophen, Zufallsaufgaben oder Kurzgeschichten ein- und ausgeschaltet werden. Diese Einstellungen sind nur beim Start einer Endloskarte änderbar.";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_AZURE" = "Neues Setting – „The Seaside Empire“ ";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_AZURE_DESC" = "„The Seaside Empire“ bietet mediterranes Klima mit wunderschönen Stränden und kristallklarem Wasser. Hier fällt kein Schnee im Winter, aber mit Dürre- und Hitzewellen im Sommer und starken Stürmen im Herbst und Winter ist zu rechnen. Die Region bietet eine einzigartige Topografie und einen typischen Gebäudestil der repräsentativ für die Region ist.";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_BEACHES_DESC" = "Auf den Sandstränden von „The Seaside Empire“ können Getreide und andere Agrarprodukte nicht angebaut werden.";
"T_GAME_HELPPAGE_DLC_AZURE_TOWNHOUSES" = "Mittleres Wohnhaus und Stadthaus";
"T_GAME_HELPPAGE_DLC_AZURE_TOWNHOUSES_01" = "Das mittlere Wohnhaus und das Stadthaus bieten standardmäßig 4, bzw. 3 Familien Wohnraum.";
"T_GAME_HELPPAGE_PRESTIGE_01" = "Prestige ist eine spezielle Ressource die Euer Ansehen in der Towniewelt symbolisiert. Viele Sonderfunktionen können mit Prestige genutzt werden. Durch das Erfüllen von Aufgaben in Szenarien und Endloskarten kann Prestige verdient werden. Euer Prestigepool ist auf jeder Karte einzigartig.";
"T_GAME_HELPPAGE_PRESTIGE_02" = "Mit Prestige können Gebäude sofort fertiggestellt, verbessert und spezielle Dekorationen errichtet werden.";
