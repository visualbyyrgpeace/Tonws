"T_PURCHASE_TEASER" = "Wie wär's mit ein bisschen mehr Prestige?\n\nDu willst doch sicher auch schneller bauen, öfter Vorspulen oder den Händler sofort rufen können!\n\nWorauf wartest du also noch? Ab zum Townshop!";
"T_PURCHASE_TEASER_DOUBLEXP_SHORT" = "Möchtest du schneller höhere Stufen erreichen?\nHol dir doppelt soviel XP für immer!";
"T_PURCHASE_TEASER_FASTFORWARD_SHORT" = "Dir reichen 60 Sekunden Vorspulen nicht?\nHol dir unbegrenztes Vorspulen!";
"T_PURCHASE_TEASER_NOADS_SHORT" = "Du magst keine Werbebanner oder Werbeunterbrechungen?\nHol dir die werbefreie Version!";
"T_QUESTS_BANQUETT" = "Der König möchte einen großen Ball ausrichten. Stellt sicher, dass die nötigen Güter zur Verfügung stehen.";
"T_QUESTS_COVERAGE" = "Das Dorf muss besser geschützt werden, Statthalter. Ihr solltet den Bau von weiteren Wachtürmen in Auftrag geben.";
"T_QUESTS_GENERIC_HELP_ADVISOR" = "Ein Ratschlag";
