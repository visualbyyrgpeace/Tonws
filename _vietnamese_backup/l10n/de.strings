"T_GAME_QUEST_BOARDGAME_001_END_001" = "Glückwunsch Sir, wir können zum nächsten Schritt übergehen! Ich habe eine Ankündigung gemacht und drei Spieleentwickler stehen uns nun zur Verfügung. Jeder von ihnen ist auf eine bestimmte Art von Spiel spezialisiert.";
"T_GAME_QUEST_BOARDGAME_001_STARTED_001" = "Ah, ich verstehe Sir, Ihr wollt diese Ressourcen nutzen, um Würfel und andere Hilfsmittel herzustellen. Das ist eine tolle Idee! Beginnen wir damit, die benötigten Ressourcen zu sammeln. ";
"T_GAME_QUEST_BOARDGAME_002_END_002" = "Mit diesem guten Team können wir die Vorbereitung des Ortes guten Gewissens beginnen!";
"T_GAME_QUEST_BOARDGAME_002_GD_001" = "Sir, ich freue mich, teil des Teams zu sein. Ich bin Spezialist für Strategiespiele.";
"T_GAME_QUEST_BOARDGAME_002_GD_002" = "Was mich betrifft, so bin ich ein Experte für Rätselspiele. Ich bin in der Lage, dir einen Raum voller verschiedener Rätsel zu machen, die Bewohner werden in einer bestimmten Zeit entkommen müssen.";
"T_GAME_QUEST_BOARDGAME_002_GD_003" = "Ich bin ein Kartenspiel-Veteran. Diese werden für alle Altersgruppen sein, aber sicher!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_001" = "Eure Majestät, die Bevölkerung rebelliert! Es ist ein richtiger Bürgerkrieg, der auf unserem Land stattfindet!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_002" = "Es hat einige Zeit gedauert, bis sich die Bevölkerung beruhigt hat. Wenn sich diese Situation jemals wiederholt, seid vorsichtig mit den Entscheidungen, die ihr trefft, Sire. Wenn wir einen weiteren Bürgerkrieg vermeiden können…";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_003" = "Eure Majestät, die Menge tobt immer noch! Was für eine schreckliche Entscheidung Ihr getroffen habt!";
"T_GAME_QUEST_BOARDGAME_FIRE_001" = "Deine Soldaten haben die Schande ihres Lebens erlitten. Einige können sich selbst nicht einmal im Spiegel betrachten. Einer von ihnen, der Leiter der Gruppe, beschloss, sich an den Bewohnern zu rächen. Einer deiner Spione hat Euch sofort informiert.\n\nWas wollt Ihr tun?";
"T_GAME_QUEST_BOARDGAME_FIRE_002" = "Verhindert Rache.";
"T_GAME_QUEST_BOARDGAME_FIRE_004" = "Majestät, bevor wir uns um diese Soldaten kümmern, müssen wir die Feuer stoppen!";
"T_GAME_QUEST_BOARDGAME_FIRE_005" = "Nun, da wir die Stadt vor diesen Bränden gerettet haben, sollten wir uns um diese Soldaten kümmern.";
"T_GAME_QUEST_BOARDGAME_REVOLT_001" = "Die Townies sind nicht glücklich über die von Ihnen getroffene Entscheidung und haben beschlossen, das Gesetz in ihre eigenen Hände zu nehmen.\n\nSie haben die Wachen gezwungen, Glockenschuhe und eine Eselsmütze zu tragen. Sie müssen nun in diesem Outfit durch die Stadt reisen.\nEinige Leute werfen Tomaten auf sie. \n\nSollen wir etwas dagegen unternehmen?";
"T_GAME_QUEST_BOARDGAME_REVOLT_002" = "Tut nichts.";
"T_GAME_QUEST_BOARDGAME_REVOLT_003" = "Ruft nach Verstärkung.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_001" = "Nach einem kurzen Gespräch mit Eurem Berater steht Ihr vor zwei Lösungen. Ihre Soldaten auf die Galeere schicken, um sie zu bestrafen, nicht nur weil sie ihre Posten nicht halten, sondern auch weil sie Feuer gelegt haben. Oder sie in den Zivildienst schicken...";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_002" = "Die Galeere.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_003" = "Zivildienst.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_004" = "Schweren Herzens entscheidet Ihr Euch, Eure Soldaten auf die Galeere zu schicken. Schließlich müssen sie mit gutem Beispiel vorangehen, sonst können sich Gerüchte verbreiten, dass Ihr keine Autorität habt.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_005" = "Eure Soldaten sind zurückgekehrt. Dieser kleine unfreiwillige Aufenthalt auf See brachten sie wieder an ihren rechten Platz.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_006" = "Warum nicht die Dinge nützlich und angenehm machen? Dank der Soldaten werden die Arbeiter für einige Zeit produktiver sein.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_007" = "Alles hat ein Ende. Die Soldaten ihre Schulden beglichten und halfen den Townies bei ihren täglichen Aufgaben.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_A" = "Es war richtig, einzugreifen, Sire. Sie verdienen es nicht, mit Tomaten beworfen zu werden.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_B" = "Gehen wir der Sache auf den Grund, indem wir einen Kampf für Gerechtigkeit organisieren. Die Bevölkerung wird einen Verfechter haben, ebenso wie die Soldaten. Die zwei Parteien werden fair gegeneinander antreten. Dann wird Gerechtigkeit herrschen.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_C" = "Lasst uns einen Turnierplatz bauen. Der rote Soldat wird für das Volk kämpfen. Der blaue Soldat wird um die Soldaten kämpfen.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_002" = "LASST DEN KAMPF BEGINNEN!";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_003" = "Der rote Ritter hat den Kampf gewonnen. Der Sieg gebührt dem Volk.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_004" = "Die Soldaten wurden für schuldig befunden und mussten Zivildienst leisten. Wenn sie wieder Spieleabende organisieren, werden sie aus der Stadt verbannt.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_005" = "Der blaue Ritter ging als Sieger aus diesem Duell hervor. Der Sieg gebührt somit den Soldaten.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_006" = "Die Townies müssen die Soldaten dafür entschädigen, dass sie Tomaten auf sie geworfen haben. Allerdings müssen Soldaten Zivildienst leisten. Wenn sie wieder anfangen, Spieleabende zu organisieren, werden sie aus der Stadt verbannt.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_007" = "Eure Majestät, der König hat von der Nutzung des Turnierplatzes gehört, um sicherzustellen, dass Gerechtigkeit herrscht. Er möchte Ihnen sagen, dass er zugestimmt hat und dass er Ihnen damit ein gewisses Ansehen verschafft. Ende gut, alles gut.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_001" = "Entsende Jäger.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_002" = "Das ist nicht meine Aufgabe.";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_A" = "Aber Sir.... um zu jagen, sollten wir mindestens einen Jäger haben... Verlieren wir keine Zeit und bauen wir diese Jagdhütte!";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_B" = "Mission erfüllt! Eine ziemliche Jagd, die wir durchführen mussten. Das Land ist gerettet.";
"T_GAME_QUEST_BOAR_REGULATION_TITLE" = "Wildschweinregulierung";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_001" = "Euer Bruder IST ein Vogel.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_002" = "Woa, woa, woa. Wachen! Ergreift ihn!";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Ich gestatte es Euch.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Nun gut, es reicht. Bringt den Mann zum Medikus";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Wie meint Ihr das? Euer Bruder sei ein Vogel? Ihr habt doch Euren Verstand verloren.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Der Gouverneur will damit sagen, dass Ihr Eurem Bruder vertrauen müsst. Ihr Bruder weiß, was er tut.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Wenn Ihr das sagt… Wenn ihm irgendetwas zustößt, werde ich Euch dafür verantwortlich machen!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Gouverneur, wir haben ihm ein kleines Beruhigungsmittel gegeben, er schläft jetzt. Er hat seltsame Dinge gemurbelt, über eine Technik, die ihn über die Berge hätte fliegen lassen können. Ihr habt das Richtige getan, indem Ihr ihn zu mir gebracht hast. Ein wenig länger und er hätte uns erzählt, dass die Erde rund sei!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Sir! Wir haben einen Boten aus dem Palast getroffen. Er lässt uns wissen, dass unser Erfinder absolut unglaublich ist und er möchte, dass er länger in der Hauptstadt bleibt, um an seinen Erfindungen weiterzuarbeiten. Der kulturelle Einfluss der Stadt hat einen Satz nach vorne gemacht! Der König hat beschlossen, uns etwas Prestige zu schicken.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Mylord, ich komme zu Euch, weil mein Bruder verrückt geworden ist. Er behauptet, er sei ein Vogel und er könne fliegen! Ich habe Angst, er wird etwas Dummes tun und ein bisschen zu hoch zu klettern, um zu beweisen, dass er wie ein Vogel fliegen kann.\n";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Oh, Sir! Danke, dass Ihr mich nicht in den Kerker geworfen habt! Meine Schwester macht sich zu viele Sorgen um mich. Ich wollte Euch mit meiner Entdeckung überraschen! Ich habe eine Maschine erfunden, die fliegen kann! WIE VÖGEL! Ich möchte sie in der Hauptstadt bei der großen Jahresmesse vorstellen.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Der Vogelbruder";
"T_GAME_QUEST_COVERAGE_DESC" = "Das Dorf muss besser geschützt werden, Statthalter.\n\nIhr solltet den Bau von mehr Wachtürmen in Auftrag geben. Positioniert sie so, dass sie weite Teile des Dorfes mit ihrer Reichweite abdecken.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Mein Herr, das Dorf ist auf Banditenangriffe nicht vorbereitet! Teile der Stadt sind nicht durch Verteidigungsgebäude geschützt.";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Erhöhe die Abdeckung des Dorfes mit Verteidigungsgebäuden";
"T_GAME_QUEST_COVERAGE_TITLE" = "Decke dein Dorf mit Wachtürmen ab.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Banditen greifen unser Dorf an, Statthalter!\nWir müssen möglichst viele Angriffe abwehren, damit nicht zu viel Schaden entsteht!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Mein Herr,\ndie Bewohner leben in Angst wegen Banditenangriffen. Wir sollten dem Dorf und vor allem den Banditen demonstrieren, dass wir uns verteidigen können!";
"T_GAME_QUEST_DESIRES_01_START" = "Was für eine provinzielle Gegend!\nDie vielen Vorzüge einer großen Stadt fehlen hier völlig. Hier wird sich einiges ändern müssen, bevor es hier schön wird!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Jetzt, wo die Banditen besiegt sind und das Dorf gewachsen ist, wird es hier wirklich wunderschön, mein Schatz.\nEs war wirklich eine gute Idee, hierher zu ziehen.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Erfülle die Wünsche deiner Frau.";
"T_GAME_QUEST_DESIRES_02_START" = "Unglaublich, eine Schneiderei gibt es auch nicht. \nWürdest du bitte eine errichten, damit ich mir neue Kleider schneidern lassen kann.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Vielen Dank, Schatz. Meine alten Kleider waren schon völlig abgetragen.";
"T_GAME_QUEST_DESIRES_03_START" = "Ich vermisse das geschäftige Treiben der Stadt. Könntest du bitte mehr Leute ansiedeln, um Leben in das Dorf zu bringen?";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Vergrößere die Bevölkerung.";
"T_GAME_QUEST_DESIRES_04_START" = "Oh, was für ein nettes, belebtes Dorf! Ihr habt doch sicher nichts dagegen, wenn ich mich in der Gegend niederlasse?\nHahaha…";
"T_GAME_QUEST_DESIRES_05_START" = "Banditen in den Wäldern? Ich würde mich deutlich sicherer fühlen, wenn du eine Stadtwache gründen würdest, um diese Unholde zu abzuwehren!";
"T_GAME_QUEST_DESIRES_06_START" = "Oho, ein Wachturm!\nEuch sollte klar werden, das solches Verhalten meine Leute nur noch mehr herausfordert.";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Oh nein! Die Räuber treiben ihr Unwesen in der Stadt.\n\nIch will, dass du sofort die Stadtwache verstärkst!";
"T_GAME_QUEST_DESIRES_07_START" = "Sorge bitte dafür, dass die Stadtwache diese Unholde von der Stadt fernhält.";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Wunderbar. Ich fühle mich nun wirklich sicher.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Wehre alle Banditenangriffe ab.";
"T_GAME_QUEST_DESIRES_08_START" = "Stelle sicher, dass alle Wachen pflichtbewusst arbeiten, indem du sie mit Gebräu und Würstchen belieferst!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Produziere Gebräu und Würstchen.";
"T_GAME_QUEST_DESIRES_09_START" = "Die Wachen brauchen auch Waffen und Rüstungen. Wie sollen sie diese Unholde sonst vertreiben?";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Die Wachen sollten jetzt in der Lage sein, diese Unholde von der Stadt abzuhalten!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Produziere Waffen und Rüstungen.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Ich dachte, Ihr wärt klüger, Statthalter. Vielleicht hätte ich erwähnen sollen, dass sich meine Leute so oder so ihren Anteil holen werden.";
"T_GAME_QUEST_DESIRES_10_START" = "So wie ihr Eurer Frau jeden Wunsch erfüllt, scheint ihr unter dem Überfluss von Münzen zu leiden. Lasst mich helfen, Euch von dieser schweren Bürde zu befreien.";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Eine weise Entscheidung, Herr Statthalter. Diese milde Gabe wird meine Leute sicher ein wenig beruhigen.";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Zahlt Münzen.";
"T_GAME_QUEST_DESIRES_11_START" = "Du willst dich doch nicht etwa auf diese Erpressung einlassen?\nFür mich neue Kleider beim Händler zu kaufen, wäre eine deutlich bessere Verwendung für die Münzen. ";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Kaufe Kleider beim Händler.";
"T_GAME_QUEST_DESIRES_12_START" = "In diesem Dorf ist es langweilig. Es fehlt an Unterhaltung!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "In diesem Dorf ist es langweilig. Es fehlt ein Turnierplatz!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "Viel besser! Langsam wird es hier richtig schön.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Baue einen Turnierplatz.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Ihr scheint wirklich nicht dazuzulernen, Statthalter. Meine Männer werden mal bei Euch vorbei schauen und eine kleine Inventur machen!\nHar Har Har";
"T_GAME_QUEST_DESIRES_13_START" = "Wie mir scheint, leidet ihr immer noch unter der Last eures Vermögens. Vielleicht sollte ich Euch diesmal etwas mehr abnehmen!\nBringt mir Goldbarren. Und wagt es ja nicht, diese Eurer Frau zu geben!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Wie ich sehe, habt Ihr dazugelernt. Vielleicht müssen meine Kumpanen ihren Anteil ja zukünftig nicht mehr selbst abholen.";
"T_GAME_QUEST_DESIRES_15_START" = "Du willst diesem Räuber doch nicht etwa Gold geben?\nDu solltest es lieber zu Schmuck für mich verarbeiten!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Oh, danke mein Schatz. Allerdings habe ich jetzt Angst um meinen Schmuck. Bist du sicher, dass die Wachen alle Räuber abwehren?";
"T_GAME_QUEST_DESIRES_16_START" = "Ich möchte eine kleines Stadtfest ausrichten.\nDafür brauche ich noch Traubensaft und Brot.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Sehr gut. Ich hoffe nur, es gibt keine Zwischenfälle mit Banditen.";
"T_GAME_QUEST_DESIRES_17_START" = "Oho, was für eine tolle Feier! Habt ihr etwa vergessen, uns einzuladen?";
"T_GAME_QUEST_DESIRES_18_START" = "Jetzt reicht es aber! Diese Banditen müssen endgültig von hier vertrieben werden.\nZerstöre ihr Lager, damit ihnen die Lust am Plündern vergeht.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "Endlich sind wir diese Banditen los!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Zerstöre alle Räuberlager.";
"T_GAME_QUEST_DESIRES_19_START" = "Dieses Dorf hat ja noch nicht einmal einen Marktplatz!\nBaue einen, mein Schatz, damit wir mit dem Händler Waren aus der Stadt handeln können.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Das macht es ein wenig erträglicher, hier zu wohnen.";
"T_GAME_QUEST_DESIRES_20_START" = "Gibt es hier denn keine anderen Nahrungsmittel als Fisch?\nKönntest du bitte eine Bäckerei errichten, um frisches Brot zu produzieren.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Endlich! Ich kann Fisch schon nicht mehr sehen.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Mein Herr,\nunsere Kundschafter berichten, dass sich die Banditen der Umgebung an den Stadtgrenzen gesammelt haben. Ich befürchte, ein großangelegter Angriff steht uns bevor. Wir sollten die nötigen Vorbereitungen treffen!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "Die Banditen starten einen Überfall!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "Die nächste Welle an Banditen hat das Dorf erreicht, Lord!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Lord Statthalter! Die Banditen starten den nächsten Angriff…";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Eine weitere Welle an Banditen ist auf dem Weg zu unserem Dorf, mein Herr.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Eine sehr große Angriffswelle ist auf dem Weg zu uns. Es sieht so aus, als wäre es die letzte Welle der Banditen. Wir müssen die Stadt halten!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Mein Herr, die Stadtwache meldet, dass der Angriff vorüber ist. Die letzten Banditen werden gerade aus dem Dorf getrieben und ziehen sich zurück.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "Der Tierbestand hat sich erholt, mein Herr.\nWir können endlich wieder jagen!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Die Felder erholen sich langsam wieder. Das Feldersterben scheint vorüber zu sein, mein Herr.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Die Felder erholen sich langsam, mein Lord. Die Dürre scheint vorbei zu sein.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "Ein Großbrand ist in der Stadt ausgebrochen, Herr Statthalter!\n\nWir müssen ihn schnell löschen, bevor er sich auf weitere Teile der Stadt ausbreitet.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Ausgezeichnet, mein Herr.\n\nSämtliche Feuer konnten gelöscht werden und die Stadt ist wieder sicher.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Alle Feuer wurden gelöscht, mein Herr.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Sorge dafür, dass kein Gebäude abbrennt.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Mein Herr, der schwarze Tod rollt über das Land hinweg.\n\nWir müssen uns dringend um die Kranken kümmern, bevor sie das ganze Dorf mit der Pest infizieren.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Es ist geschafft, Herr Statthalter!\n\nDer Ausbruch der Pest wurde eingedämmt. Das Dorf ist wieder sicher.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Moderne Medizin.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Großmutters Heilmittelchen.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Der Medikus beschloss mit großer Empörung, die Krankenstation zu zerstören! Er sagte: "Wenn Ihr die Großmutters Heilmittel bevorzugt, braucht Ihr mein Labor nicht mehr!"";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Weise Entscheidung, Sir.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Dank Eurer Entscheidung ist die Behandlung der Medikusse viel effektiver!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Sir, viele Townies wissen nicht mehr, an wen sie sich wenden sollen, wenn sie gesundheitliche Probleme haben. Sollen wir sie an den die Moderne Medizin oder Großmütterchens Heimittel verweisen?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Ärzte und Großmutter";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Geh wieder schlafen.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Ich vertraue Euch.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Oh nein! Nein! Wir hätten dem Träumer glauben schenken sollen! Einige Bewohner haben begonnen, eine seltsame Krankheit zu entwickeln.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Zum Glück für uns ist es uns gelungen, diese Krankheit zu stoppen. Wir sollten uns beim nächsten Mal besser die Vorahnungen anhören.....";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Dieser Townie hat uns mehr als einmal vor Katastrophen bewahrt. Lasst uns einen Heilmedikus in die Stadt holen, Sire, nur für alle Fälle.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Oh, Eure Majestät! Wir haben gerade ein Haus für den Heilmedikus fertiggestellt und einige unserer Townies sind krank. Gut, dass Ihr Euch entschieden habt, diesem Townie zuzuhören! Der Schaden war somit überschaubar. Gut gemacht, Sire.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Wir müssen sie dennoch heilen, Eure Majestät. Andernfalls könnte sich die Krankheit ausbreiten.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Hervorragend! Die Stadt ist wieder gesund und munter. Jetzt können wir uns wieder unseren Angelegenheiten widmen.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Mylord, letzte Nacht träumte ich, dass unsere Stadt mit einer seltsamen Krankheit infiziert werden würde. Alle Bewohner hatten verstopfte Nasen.\n\nGlaubt Ihr, mein Traum könnte eine Vorahnung sein?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Traumzeit";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Ich freue mich drauf!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Oh, mir war der alte lieber.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "Nein, dafür habe ich keine Zeit.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Nein heißt nein.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Schickt sie herein.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Stattgegeben.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Es kommt nicht in Frage, mehr Reisende anzulocken.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "In einem Ausbruch nie dagewesener Großzügigkeit macht Ihr Euch ans Werk. Dieses Gasthaus wird in einem Meer aus Blumen schwimmen. ";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Also gut.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = "„Hört, Hört, ihr guten Leute! Das Gasthaus hat eine neue Besitzerin! Kommt zur Neueröffnung!“\n\nDer Stadtschreier hat heute gute Laune. Man sagt, jedes mal, wenn ein neuer Gast ins Gasthaus kommt, bekommt er Trinkgeld.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Mylord, wir müssen die neue Besitzerin des Gasthauses besuchen. Würdet Ihr sie empfangen?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Mylord, bitte. Das Gasthaus ist eines der liebsten Orte von Reisenden. Wir könnten den Ruf der Stadt aufwerten, wenn wir das Gasthaus verbessern.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Guten Morgen, Sire. Vielen Dank für Euer herzliches Willkommen.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "Wem verdanken wir die Ehre Eures Besuchs?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Naja, wie sie wissen, ist das Gasthaus in schlechter Verfassung. Der frühere Besitzer war wirklich fahrlässig. Nicht nur mit Zulieferern, sondern auch mit Gästen!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Äh, ja. Wenn Ihr meint. Wir verbringen nicht wirklich viel Zeit im Gasthaus.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Ich bin hier um Eure Hilfe zu erbitten. Ich würde gerne damit anfangen, die Einrichtung mit ein paar Blumen zu schmücken, damit es etwas einladender aussieht. Ich will mehr Reisende anlocken, die vielleicht wiederkehren.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Nun, lasst uns zu Schritt zwei übergehen! Die Getränke.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! Ein zweiter Schritt… Nun denn, jetzt wo wir schon hier sind, können wir auch gleich weitermachen. Was ist der nächste Schritt?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Wir brauchen Metall und erstklassiges Holz.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Habt Ihr nicht gerade noch von Getränken geredet? Warum jetzt Holz?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Um ordentliche Fässer zu bauen, was denn sonst? Der ehemalige Besitzer hatte nicht ein mal vernünftige Fässer zur Aufbewahrung der Getränke. Zulieferer müssen wohl schlechtes Holz verwenden. Also brauchen wir genug Holz und Eisenbarren, um sie selber herzustellen.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Großartig! Sie sind wunderschön!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Wenn Ihr es so sagt. Ich werde es alleine hinkriegen!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "Von nun an wird der Stadtschreier das Gasthaus bewerben.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "Von nun an wird der Stadtschreier die Taverne bewerben.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Danke, Gouverneur! Ende gut, alles gut.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Oh, danke, Mylord! Das Gasthaus ist so viel ansprechender mit den ganzen Blumen.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Kommt schon, Sire. Nehmt Euch die Zeit, darüber nachzudenken. Das Gasthaus ist eine wichtige Einkommensquelle der Stadt. Es kann Euch helfen, manch Eurer Projekte voranzutreiben.\n\nSeid Ihr Euch sicher, dass Ihr das nicht wollt?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Was höre ich da, Sire?! Ihr helft dieser jungen Dame hier mit ihrem Gasthaus und was ist mit mir? Mir wir mit meiner Taverne nicht geholfen!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Achtet auf Eure Worte, wenn Ihr mit dem Gouverneur spricht!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Ich verlage die selben Privilegien, wie diese Dame hat!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Wollt Ihr auch Blumen für Euer Unternehmen?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Blumen? Nein! Ich will einen Stadtschreier, der meine Taverne bewirbt!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Sire, was sollen wir tun?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Bewirbt die Taverne.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Bewirbt das Gasthaus.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Von Blumen und Feinden";
"T_GAME_QUEST_FEAST_TITLE" = "Veranstalte ein Fest für das Dorf.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Decke das Dorf mit Feuerwachtürmen ab.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Lord, die Stadt ist nicht auf Großbrände vorbereitet! Teile des Dorfes sind nicht von Feuerwehrtürmen abgedeckt. Wir sollten Türme so platzieren, dass sie so viele Gebäude wie möglich abdecken können.";
"T_GAME_QUEST_FOOD_STARTED" = "Lasst uns das Essen nicht vergessen, Sir! Kein Fest ohne volle Speisekammer! Lasst uns sputen und die Nahrung auf Lager bringen. Je früher wir sie haben, desto früher wird das Vorhaben ein Erfolg.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Unsere Festgäste werden nicht verhungern! Oh, Sir, wir nähern uns dem Ziel! Ich kann es nicht erwarten!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Ein Gouverneur, der nicht in der Lage ist, einer Königin eine Erfrischung anzubieten!? Mir wurde gesagt, ich solle Euch gegenüber misstrauisch sein, aber ich wollte es nicht glauben!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Königin Frygith, kommt schon, seid nicht sauer wegen so einer Kleinigkeit. Es ist nur eine Getränk. Seid nicht so dramatisch.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Ich merke, dass sogar Euer Berater anfängt mich nicht mehr mit angemessenem Respekt zu behandeln…";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "Die Situation ist völlig außer Kontrolle. Ihr wisst nicht mehr, wie Ihr Euch verhalten sollt und der Druck wird immer größer.\n\nWie reagiert Ihr?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Versucht, die Königin zu beruhigen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Es ist so… Der Gouverneur hat Gefühle für Euch und weiß nicht wie er sich verhalten soll. Wisst Ihr, es ist das erste mal, dass er verliebt ist.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "Die Königin ist auch emotional. Sie scheint auch Gefühle für Euch zu haben. Könnte das der Anfang einer echten Liebesgeschichte sein? Hatte die Wahrsagerin doch recht?\n\nDie Antwort steht in den Sternen. In der Zwischenzeit hat sich die Königin für eine weitere Tanzpartie entschieden.\n";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Seit dem berühmten Ball sind mehrere Monate vergangen. Ihr und Queen Frigith führt eine Briefbeziehung. Manchmal kommt sie zu Euch, wenn das Wetter es zulässt.\n\nVielleicht wird sie Euch eines Tages zum König ihres Königreichs machen. Aber im Moment hat sie zu viel tun, um sich ihren Platz als Königin zu sichern.\n\nEbenso wie Ihr! Ihr müsst weiterhin alles in Eurer Macht Stehende tun, damit in Eurer Stadt alles reibungslos läuft.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Die Townies freuen sich auch für Euch und die Königin. Sie haben eine Zunahme der Reisenden beobachtet. Sie kommen hauptsächlich, um den Traubensaft und das Gebräu zu probieren, der der Königin während der Party abgelehnt wurde. Gerüchten zufolge waren die Getränke so gut, dass ihnen die Reserven innerhalb weniger als einer Stunde ausgegangen sind.\n\nDie Produktivität dieser beiden Gebäude ist gestiegen!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Die Karten.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Ich eine allgemeine Ziehung für Euch machen, Sire. Es wird uns ein wenig mehr darüber verraten, was für ein Mensch Ihr seid und welches Schicksal Euch erwartet. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Nach diesem ersten Zug mischt sie nochmals die Karten fort.\n\nSie bittet Euch, drei Karten zu ziehen. Jeweils eine für die Vergangenheit, Gegenwart und Zukunft.\n\nSobald alle Karten ausgewählt sind, dreht sie sie nacheinander um.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Oh Sire, diese drei Karten sagen mir, dass Ihr eine sehr schwierige Zeit haben werdet. Ihr solltet den Leuten der Kirche misstrauisch gegenüber stehen. Die Karten sagen mir, dass sie in der Vergangenheit bereits versucht haben, Euch anzusprechen, aber ohne großen Erfolg.\n\nSeid gewarnt.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Ein wunderbarer Zug, Sire! Sehr positiv. Ihr werdet eine Frau treffen, eine großartige Frau, die Euer Herz auf den Kopf stellen wird. Die Liebe ist am Horizont zu sehen! Seid bereit, wenn sie an Eurer Tür klopft.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Ihr seht die junge Frau, wie sie die Karten mischt und Euren Namen hineinflüstert um Eure Energie zu übertragen.\n\nDann bittet sie Euch, den rechten oder linken Stapel zu wählen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Ich hoffe, dass diese Vorhersage nicht wahr wird und dass die religiösen Menschen in unserer Stadt glücklich sind.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Am nächsten Morgen kommt ein Mönch zu Euch. Er informiert Euch, dass die Kirche mehr Ressourcen braucht und dass ein zusätzlicher Ort der Anbetung sehr willkommen wäre.\n\nDie Vorhersage der Wahrsagerin kommt Euch in den Sinn.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Sire, eine neue Kirche könnte der Bevölkerung zu einer spirituellen Erleuchtung helfen. Danke vielmals.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Baut einen neuen Anbetungsort.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Oh, das ist perfekt! Ihr werdet sehen! Wir werden diesen neuen Ort der Anbetung gut nutzen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Linker Stapel.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Diese Karte zeigt an, dass Ihr einen sehr dunklen Teil in Euch habt und sie wird Euch zur Selbstzerstörung führen. Ich befürchte, dass dies die Produktivität Eurer Bewohner beeinträchtigen wird.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Ich spüre, dass Ihr verwirrt seid und dass Euer Berater Euch drängt, zu gehen. Aber bleibt noch ein bisschen, es ist noch nicht vorbei. Eine zweite Ziehung kann genauere Antworten liefern.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Sire, diese Wahrsagerin sagt die Wahrheit, wir haben einen Besuch für das kommende Wochenende geplant. Das gibt uns genug Zeit, eine Party zu planen und uns schick zu machen!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Organisiert eine Party";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Eine Party ist nichts ohne Essen und Trinken. Lasst uns damit anfangen, Sire.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Perfekt. Jetzt haben wir genug Essen und Trinken für unsere Gäster.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Mylord, wir sollten bei den Vorbereitungen der Feierlichkeiten unser Bestes geben. Was ist, wenn Ihr Euren Seelenverwandten dort treffen werdet?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Euer Berater hat möglicherweise Recht. Also beschließt Ihr, Euch mit Eurer schönsten Kleidung zu schmücken. Die ganze Stadt glänzt vor Prunk. Ihr zögert nicht eine Sekunde lang, Euren Reichtum zu preiszugeben.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Das wird Geschichte schreiben! Dies wird Ihren potentiellen Liebhaber sicherlich beeindrucken.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Rechter Stapel.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Ihr seid ein fürsorglicher Mensch und die Karten sagen mir, dass dies die Produktivität Eurer Bewohner beeinflussen wird!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "Die Kristallkugel.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Sehr gute Wahl, Gouverneur. Bitte tretet näher und blickt in die Kugel.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "Die Wahrsagerin nähert sich der Kristallkugel mit ihren Händen und plötzlich erscheint blauer Rauch.\n\n„Oh Majestät, großes Unglück wird auf Euch zukommen. Ich sehe Mönche. Vielleicht ist es die Ursache für Euer Unglück", sagte sie mit einem traurigen Unterton.“";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "Die Wahrsagerin nähert sich der Kristallkugel mit ihren und plötzlich erscheint rosa Rauch.\n\n„Oh Majestät, Ihr werdet die Liebe finden! Die Große Liebe! Ihr werdet eine unglaubliche Liebesgeschichte haben, das versichere ich Euch!“ erzählt sie Euch mit einem selbstbewussten Blick.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Geht und heult in Eurem Gemach.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Panisch rennt Ihr aus dem Ballsaal und stürmt in Eure Gemächer um Euch heulend im Bett zu verkriechen.\n\nAlles lässt darauf schließen, dass Ihr an einem gebrochenem Herzen leidet. Nur Zeit kann Eure Wunden heilen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Seit einigen Monaten erholt Ihr Euch langsam von Eurem gebrochenen Herzen.\n\nEinerseits hat Queen Frygith nie versucht herauszufinden, wie es Euch geht, sie kümmert sich überhaupt nicht um Euch.\n\nAndererseits habt Ihr Geschichte geschrieben und taucht jetzt in Geschichtsbüchern als der verliebte Gouverneur auf. Das hat Ihnen Sympathie der Menschen eingebracht und sie arbeiten jetzt effizienter.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Bringt ihr Gebräu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "In Begleitung Eures Beraters beschließt Ihr, zum Haus der Wahrsagerin zu gehen. Vielleicht kann sie Euch helfen, Unglücke zu verhindern oder Euch großartige Neuigkeiten zu bringen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "Die Wahrsagerin ist nicht weit von der Burg entfernt. Ihr betritt das kleine Zelt. Ihr seid von einer ganzen Reihe an mystischer Objekte umgeben. In gewisser Weise beruhigt es Euch. \n\n„Oh Majestät, setzt Euch. Ich bin so froh, dass Ihr meine Einladung angenommen habt. Welche Methode bevorzugt Ihr?“";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Bringt ihr Traubensaft.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Ihr könnt die Paraden vom Dach Eures Schlosses aus bewundern. Und plötzlich, in der Ferne, sieht Ihr eine Prozession kommen. Eure Aufmerksamkeit fällt auf eine schöne Frau. Euer Herz ist überwältigt. \n\nIst das diese Liebe auf den ersten Blick, von der die Menschen reden?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Von der Liebe geblendet, beschließt Ihr, diese schöne Fremde zu treffen. Fast stolpert Ihr auf der Treppe eurer Schlossanlage und eilt dann auf allen Vieren die Treppe hinunter. Euer Berater, der neben Euch steht, fragt sich, was mit Euch los ist.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Sire, das ist Queen Frygith. Ich weiß nicht, was Euer Beweggrund ist, sie so schnell zu begrüßen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Gouverneur, schön Euch kennenzulernen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "Königin Frygith hat Euch mit ihrer Anwesenheit geblendet, Ihr wisst nicht mehr, wie Ihr Euch verhalten sollt. Zu Eurem Glück hilft Euch Euer vertrauenswürdiger Berater und lässt Euch Eure Sinne wiederfinden.\n\nIhr entscheidet Euch, Queen Frygith zum Ball heute Abend einzuladen. Hoffentlich akzeptiert sie diese erste romantische Einladung.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Queen Frygith, der Gouverneur, lädt Euch zum heutigen Ball als seine Begleitung ein. Erweist Ihr uns die Ehre, zu akzeptieren?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "Das ist absolut unangebracht! Ich bin dem Herzog von Cannes versprochen, ich kann nicht in den Armen eines Gouverneurs gesehen werden.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Die Einladung nehme ich gerne an.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "Die Zeit für den Ball ist endlich gekommen. Ihr habt die besten Musiker des Landes geladen, an diesem Abend für Euch zu spielen. Ihr wollt, dass absolut alles perfekt für Eure Geliebte ist.\n\nKönigin Frygith kommt endlich in einem eleganten Kleid an. Jede Sekunde, die Ihr in ihrer Gegenwart verbringst, lässt Eure Liebe stärker werden.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "Die Musik lässt ihre Magie walten, Queen Frygith scheint ebenfalls im Bann zu stehen. Es ist Zeit für eine Pause und sie bittet Euch um ein kleines Getränk.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Ihr habt nichts, was Ihr ihr anbieten könnt.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Einladung ablehnen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Ihr habt das richtige getan, Gouverneur. Wer weiß, welche Art von Problemen wir uns eingebrockt hätten!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Mit gebrochenem Herzen beschließt Ihr, überhaupt nicht am Ball teilzunehmen. Ihr trauert für eine lange Zeit. Und das spiegelt sich in Eurer Stadt wider. Die Produktivität und die Zufriedenheit der Bewohner nimmt ab. Hoffentlich hält es nicht lange an.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Ihr beginnt, das Licht am Ende des Tunnels wieder zu sehen, und überwindet Eure Traurigkeit. Ihr fangt langsam wieder an, aus Eurem Zimmer zu kriechen.\n\nDie Leute erfreuen sich Eurer Genesung und das wirkt sich positiv auf ihre Produktivität und Moral aus."";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Danke, Gouverneur! Ihr seid sehr charmant. Würdet Ihr den Abend nutzen, um Handelsabkommen zu schließen? Sodass wir die Möglichkeit haben, uns wiederzusehen?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Ich werde Euch mit der Königin alleine lassen, Gouverneur.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Ihr und die Königin zieht euch im königlichen Garten zurück. Wie im Märchen. Die Zeit steht still. Ihr sammelt all Euren Mut und teilt Eure Gefühle. Es stellte sich heraus, dass eure Gefühle auf Gegenseitigkeit beruhen!\n\nLeider ist schon wieder Sonnenaufgang und die Königin muss zurückkehren. Sie hat in ihrem Land viel zu tun. Und Ihr wisst, dass es nicht so einfach ist, ein Land allein zu führen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Die Townies freuen sich auch für Euch. Sie neigen weniger zu Streiks, was großartige Neuigkeiten sind.\n\nLetztendlich habt Ihr mit dem Besuch der Wahrsagerin das Richtige getan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Ich würde gerne die Einladung annehmen!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Oh Majestät, es ist schrecklich. Die Menschen, die gezwungen worden sind in die Kirche zu gehen, sind völlig am Boden. Sie sind am Ende ihrer Kräfte. Lasst uns im Gegenzug beten, dass sie darüber hinwegkommen! Es war eine schlechte Entscheidung, den Gottesdienst zur Pflicht zu machen!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Diese ganze Geschichte mit der Kirche und der Wahrsagerin ist jetzt endlich hinter uns. Den Townies geht es langsam wieder besser.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Diese Entscheidung hatte positive Auswirkungen, Sire! Ihr habt das Richtige getan, indem Ihr den Gottesdienst zur Pflicht gemacht habt. Die Townies sind jetzt glücklicher und produktiver.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "Der religiöse Anführer Eures Dorfes ist zurückgekehrt, um Euch zu sehen.\n\n„Majestät, lasst mich Euch auch etwas fragen. Könnten Sie den Gottesdienst obligatorisch machen? Sehen Sie, mit diesen Wahrsagern hier, fürchte ich, dass unsere Leute leicht beeinflusst werden können. Ich möchte sie retten, bevor es zu spät ist.“";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Nehmt die Anfrage an.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Ich verspreche Euch, Sire, Ihr werdet es nicht bereuen!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Die Anfrage ablehnen.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Ich verstehe, Sire. Diese Wahrsagerin hat Euch manipuliert. Ihr hättet Euch von ihr fernhalten sollen!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Da Religion einen geringen Stellenwert bei Euch hat, werden wir Orte der Anbetung zerstören!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Majestät, es ist schrecklich! Wütende Mönche zerstören Gebäude in der Stadt! Und es war unmöglich, sie zu fangen, sie sind geflohen! Seht Ihr, wohin es uns geführt hat? Dies wird Euch lehren, nächstes mal die Wahrsagerin zu konsultieren.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Als Berater werde ich Euch niemals wieder eine Wahrsagerin konsultieren lassen! Lasst uns zurück an die Arbeit gehen, Mylord. Den Townies ist zum Töten zumute…";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Sire, einige Reisende kamen heute Nachmittag in der Stadt an. Unter ihnen eine Wahrsagerin. Sie schickt Euch eine Einladung, damit sie Vorhersagen für Euch treffen kann.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "Die Wahrsagerin";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Hört einfach auf, sie zu essen.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Führt Untersuchungen durch.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Vernichtet die Fischerhütten.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "Es ist schrecklich! Die Bewohner aßen weiterhin Fisch aus Mangel an etwas Besserem und die Krankheit verbreitete sich!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "Die Krankheit ist unter Kontrolle, Sir. Wir hatten Glück.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Diese Qualitätskontrollen kosten ein Vermögen, aber es ist immer noch besser als mit einer Epidemie zu kämpfen!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Alle Fischerhütten wurden überprüft und der Fisch ist wieder essbar! Sie hatten Recht, in diese Entscheidung zu investieren. Wir haben ernsthafte Probleme vermieden.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "Die Zerstörung dieser Fischerhütten hat es uns ermöglicht, die eventuelle Kontamination der Fische zu beseitigen. Dennoch ist es schade, dass so schöne Gebäude zerstört wurden.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Gouverneur, ich will nicht pedantisch sein, aber ich muss zugeben, dass Eure Fische... Sie sind nicht mehr das, was sie einmal waren. Ich weiß nicht, ob es am Fluss oder an etwas anderem liegt, aber sie sind absolut ekelhaft! Jemand wird krank, wenn du Ihr Euch nicht darum kümmert.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Frischer Fisch!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Erreiche eine hohe Gemeinschaftszufriedenheit.";
"T_GAME_QUEST_GETREWARD" = "Einlösen!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Sir, ich weiß nicht wie ich es sagen soll… Atmet tief durch. Seid Ihr bereit? Nun ja… einige Bewohner sagen, sie hätten ein Riesenkaninchen gesehen.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Ja, und?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "EIN RIESENKANINCHEN?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "UND?! Aber Sir! Es ist absolut angsteinflößend! Stellt Euch vor, es hüpft durch die Burg und entwurzelt alle Häuser!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Die paar Häuser, die wir haben…";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Lasst uns handeln und zwar SCHNELL!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Aha, das ist schon eine logischere Reaktion Eurerseits, Sir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Lasst uns eine Jägerhütte bauen.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Schickt dem König eine Nachricht. Lasst sie uns einen Botschafter senden.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Trotz unserer Kaninchenjagt-Aktion, konnten wir das Riesenkaninchen nicht finden. Dafür haben wir jetzt jedoch viel Fleisch auf Lager…";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Irgendwelche Hinweise?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Ich habe meinen Dienst geleistet. Ich lege mich jetzt erstmal hin.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "Der Botschafter ist angekommen, Sir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Ich verlange Unterstützung der königlichen Armee.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Begleitet den Botschafter zum Beweis.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Was höre ich da? Ein Riesenkaninchen, das auf Eurem Land herumhoppelt? Seit Ihr Euch sicher, dass Ihr nicht doch einen Sonnenstich habt?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Aha, ich verstehe. Spuren von Riesenkaninchen… Das ist ein Märchen, das man törichten Kindern erzählt. „Das Riesenkaninchen kommt nachts und reißt euch die Ohren aus.“";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "Sonst noch was? Ich habe besseres zu tun.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Geht zur Hexe.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Wir könnten die Hexe nach Rat fragen. Vielleicht weiß sie etwas von diesem berühmt-berüchtigten Riesenkaninchen.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Ich habe Euch erwartet. Die Raben haben Euere Ankunft vorhergesagt. Wie sie gekrächzt haben. Aber lange nicht so laut wie das Hoppeln des Kaninchens.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Beten.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Magie anwenden.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Nichts tun.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Also ist es wahr?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Darauf könnt Ihr wetten! Ihr habt lange gebraucht, mich aufzusuchen. Glücklicherweise haben wir noch Zeit. Ihr habt drei Optionen…";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Ich sehe, dass Ihr Euch unter allen Umständen wenig um Eure Townies schert, Sir… Das wird Folgen haben.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Nun gut, lasst uns zwei Jägthütten bauen und etwas Fleisch gewinnen. Wer weiß, vielleicht, mit ein bisschen Glück könnten wir den Riesenkaninchenbau finden.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Das ist mein Spezialgebiet. Ich werde Euch einen kleinen Trank brauen, aber Ihr müsst mir die Zutaten bringen.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Schön und gut? Gebt Ihr mir die Zutaten?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Vielen Dank, Sir. Verdammt! Jetzt habe ich die andere Hälfte der Zutaten vergessen.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Oh, wir haben nicht den ganzen Tag Zeit, Sir. Ich habe einen Trank zu brauen. Warum gebt Ihr mir die Zutaten nicht jetzt?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Vielen Dank, Sir. Hier ist der Trank. Träufelt ein wenig davon in den Brunnen der Stadt und wartet. Das Riesenkaninchen wird nach einer Weile von dem Geruch von selbst verschwinden.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Sir… Wir müssen dringend Badehäuser errichten und reichlich ätherische Öle ins Wasser kippen. Die Townies stinken zum Himmel!";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Großartig! Die Stadt kann endlich wieder aufatmen!\nDas Kaninchen hat sich wie in Luft aufgelöst, als ob wir es uns ausgedacht hätten. Lasst uns vorerst zurück an unsere Arbeit machen, Mylord.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Zu guter Letzt verschwand das Kaninchen von alleine. Bei einem seiner letzten Sprünge, hat es eine alte von Banditen vergrabene Truhe ausgebuddelt. Die Truhe beinhaltete 2000 Goldmünzen und der König denkt, wir verdienen es, Prestige zu erhalten!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Nun ja… Es hat bei Euch ein Riesenkaninchen gebraucht, um endlich eine Kirche zu errichten!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Lasst uns sputen und die Kirche bauen, sodass wir die Bewohner zum Gebet versammeln können.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Jetzt können wir nur noch darauf warten, dass das Göttliche sein Werk vollbringt.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Das Kaninchen ist spurlos verschwunden, so als ob wir es uns nur eingebildet hätten. Lasst uns vorerste zurück an unsere Arbeit gehen, Mylord.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Autsch. Ich hätte an Eurer Stelle den Trank genommen, aber Ihr seid der Boss! Viel Glück beim bevorstehenden Unglück, Sir.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Das Riesenkaninchen";
"T_GAME_QUEST_INN_STARTED" = "Sir, zusätzliche Unterkünfte werden nötig sein. Warum bauen wir kein Wirtshaus? So können wir den Bedürfnissen der Festbesucher nachkommen.";
"T_GAME_QUEST_INN_SUCCESS" = "Das wäre wohl erledigt. Lasst uns nun über die restlichen Vorkehrungen nachdenken.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Es ist zu riskant.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Warum nicht?";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Den Witzbold.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "Der Hof des Königs ist hocherfreut! Es war genau was fehlte! Das Prestige ist unser!";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "Die Townette mit den Wortspielen.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Leider waren die Rätsel… viel zu kompliziert für sie. Der Hof des Königs hätte sich etwas weniger Intellektuelles gewünscht. Diesmal werden wir kein Prestige erhalten.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "Den akrobatischen Townie.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "Der königliche Hof ist vom Talent des Townies beeindruckt! Der König wird uns Prestige als Belohnung zukommen lassen. ";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Du hast Recht, wer weiß, was mit uns passiert, wenn der König mit unseren Kandidaten nicht zufrieden ist.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Sir, wir haben eine Nachricht von der Hauptstadt erhalten. Der König ist enttäuscht, dass kein Mitglied unserer Stadt gekommen ist, um seine Dienste anzubieten. Doch glücklicherweise wird er uns nicht für eine solche Geringfügigkeit verurteilen. Der König ist sehr barmherzig!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Ich habe drei potenzielle Kandidaten gefunden. Welchen sollen wir schicken?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Mylord, der König wünscht sich einen Narren zur Unterhaltung. Sollen wir einige potentielle Kandidaten für die Position schicken?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Der Hofnarr";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Repariert das Dach.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Wir müssen es so bald wie möglich reparieren!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Nicht jetzt.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Wir haben derzeit andere Prioritäten. Das Lavendelfest beginnt bald und die Vorbereitungen laufen noch.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "Apropos. Wir sollten die Vorbereitungen abschließen.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Das ist schon besser! Das lässt auf eine lukrative Veranstaltung hoffen!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Mylord, ich habe gehört, dass die Lavendelhändler unsere Kathedrale hoch geschätzt haben. Sie zögern, zu unserem Fest zu kommen.";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "Das Lavendelfest verlief reibungslos… dennoch hatten wir nicht so viele Besucher, wie früher! Diese Veranstaltung brachte uns kein Prestige.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Abgemacht!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "So lasst uns sputen und den Saft für die Königin produzieren.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Jetzt müssen wir nur noch den Tausch tätigen.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Es ist mir eine Freude, Geschäfte mit Euch zu machen.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Mylord, es gibt schlechte Neuigkeiten! Das weltweite Symbol unserer Kultur hat übernacht Feuer gefangen! Die große Kathedrale hat kein Dach mehr! ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Experten sagen, dass wir auf unserem Land nicht mehr genug Edelholz haben, um das Dach zu reparieren. Aber Königin Frygith hat zufällig die notwendigen Ressourcen - sollten wir sie um Hilfe bitten?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Bittet um Hilfe.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Ihr beeilt Euch, einen Boten zur Königin zu schicken.\n\n„Hilf mir, Königin Frygith! Dürfte ich etwas Edelholz von Eurem Land borgen? Meine Kathedrale ist am Auseinanderfallen.“";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Hallo Liebchen, Ihr kommst gerade rechtzeitig, da ich mich mit Saft eindecken muss. Seid Ihr an einem freundschaftlichen Austausch interessiert? Saftgläser gegen das Holz, das ihr braucht.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Sire, das ist kein Angebot zu unseren Gunsten…";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Ihr wiegt die Vor- und Nachteile dieses Abkommens ab. Vielleicht wird die Königin die Lösung aller Probleme sein… Außer es gibt noch einen anderen Weg?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Denkt darüber nach.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Diese Forderung könnte unserem Ruf schaden, wir werden anders vorgehen. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Euer Berater könnte Recht haben. Königin Frygith um Hilfe zu bitten, würde Euch dazu bringen, von ihrer Gunst abhängig zu werden. Wenn es jemals ein Problem geben wird, riskiert Ihr, viel zu verlieren.\n\nWarum nicht Stein verwenden? Ihr habt eine Menge davon in den Minen.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Es war eine gute Entscheidung, Sire! Wir sind frei und unabhängig.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "Das Lavendelfest ist ein Erfolg. Die jüngsten Geschichten über die Restaurierung der Kathedrale haben viel Begeisterung hervorgerufen, und wir haben davon profitiert!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Ich habe Lavendel noch nie gemocht.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Das ist in Ordnung. Wir werden die Kathedrale reparieren.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Unfassbar.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Mylord, das hört sich nach Erpressung an! Lasst uns stattdessen Stein verwenden, damit wir uns nicht mit dieser Königin herumschlagen müssen!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Nun gut. Das werde ich nicht vergessen, Liebchen.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Holzkönig";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Ich werde mich darum kümmern.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Wenn sie nicht zufrieden sind, sollen sie nicht mehr hierher kommen.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "Es ist wahr, dass Händler davon profitieren würden, wenn sie neben dem Markt auch ein eigenes Gebäude hätten. Eine Handelsgilde wäre das perfekte Gebäude, Sire.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Wunderbar, Mylord! Danke, dass Ihr dem zugestimmt habt. Wir sind Euch ewig dankbar!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Ein solch moderner Gouverneur wie Ihr, hätte der Anfrage der Kaufleute zustimmen müssen.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Eure Majestät, ich bin ein Vertreter der Kaufleute. Um unsere Enttäuschung zu zeigen, werden wir für eine Weile nicht in Eure Stadt kommen! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Mylord, der Verband der Kaufleute verlangt, dass Ihr Gebäude baut, die Ihren Funktionen gerecht werden.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Platzmangel";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Als Ihr gerade aufgewacht seid, hat Euer Berater schon eine schreckliche Nachricht für Euch! Die Stadt ist von Mäusen überfallen! Sie sind weniger gefährlich als Ratten, klar, aber trotzdem... Wir müssen etwas dagegen tun!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Sire, die Academie für Mäusejagdkatzen wurde gegründet, aber... wir müssen uns immer noch um ihr Wohlergehen kümmern und sie füttern. Wir sollten genug Fisch für die Akademie bereitstellen.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Wir haben jetzt genug Fisch, um das Training abzudecken. Einige Rekruten haben bereits eine Menge Mäuse gefangen, Sire. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Mylord, wir sollten die besten Katzen mit Katzenminze belohnen. Zur Stressminderung.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "Es gibt eine spürbare Effektivitätssteigerung der Mäusefänger, Sire. Die Trainer leisten gute Arbeit bei der Ausbildung der Katzen. Es gibt nur noch eine kleine Anzahl von Mäusen.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Mäuse sind überhaupt keine Belästigung mehr, Sire. Herzlichen Glückwunsch zu Euren Entscheidungen, die zu diesem Ergebnis geführt haben.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Bereitet einen Plan vor.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Nichtsdestotrotz entscheidet Ihr Euch zu frühstücken. Als Ihr Euer Toast isst, seht Ihr eine Maus in der Zimmerecke! Sie sind sogar im Schloss! Und plötzlich seht Ihr wie Eure treue Katze, Chouquette, einen Sprung macht. Sie frisst die Maus ratzfatz.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Da kommt Ihr auf eine Idee. Ihr weist Euren Berater an, so viele Katzen wie möglich zu fangen und sie im Mäusejagen auszubilden. Auch die Hauskatzen. Ihr wollt, dass sie trainiert werden, um all diese Mäuse loszuwerden.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Geht wieder schlafen.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Wenn Ihr wieder aufwacht, sind überall so viele Mäuse, dass die Townies Schwierigkeiten haben, richtig zu laufen. Alle Bewohner laufen nun langsamer!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Nach langer Zeit sind die Mäuse von selbst wieder verschwunden. Ihr könnt Euch nicht immer vor Eurer Verantwortung verstecken, indem Ihr einfach schläft. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Katz und Maus";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "Auf der rechten Seite sind alle Einflüsse aufgelistet, die momentan aktiv sind.\nManche Einflüsse sind nur temporär wirksam und können im Verlauf eines Szenarios aktiv bzw. inaktiv werden.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Mein Herr,\nbei allem gebührenden Respekt, aber sie scheinen nicht bemerkt zu haben, wie unzufrieden die Bevölkerung ist.\nHinzu kommt, dass einige Gebäude die Rohstoffe nicht verarbeiten, die sie produzieren. ";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Nun seid Ihr im Bilde über die momentanen Einflüsse, die im Dorf herrschen. Wie ihr seht, sind die Bewohner unzufrieden und arbeiten weniger.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Besuche das Pausenmenü, um mehr über Einflüsse zu erfahren.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Schaut doch bitte beim Sägewerk vorbei und seht nach dem Rechten.\nWir haben zu wenig Holz und bereits viel zu viele Planken produziert.\n\nWir müssen die Produktion stoppen!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Immer, wenn du Informationen über Gebäude benötigst, musst du nur das Gebäude besuchen!\n\nDas Kontextmenü birgt viel Wissenswertes über Bauwerke, die Arbeiter darin und evtl. verbundene Produktionsketten. Während du im Kontextmenü bist, ist das Spiel pausiert.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Es sind zu wenige Holzfäller vorhanden, die das Sägewerk beliefern.\n\nIhr solltet das Sägewerk pausieren, bis wir genug Holzfäller haben, um einen Vorrat an Bauressourcen anzusammeln.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Wir müssen dafür sorgen, dass keine Ressourcen unser Lager blockieren.\nIm “Ressourcen vernichten”-Menü der Statistiken können überflüssige Rohstoffe jederzeit vernichtet werden, um Raum im Lagerhaus zu schaffen.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Begib dich ins Lagerhausmenu.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Wir müssen dafür sorgen, dass keine Ressourcen unser Lager blockieren.\nIm Reiter “Lagerbestand” im Spielmenü können Ressouren vernichtet werden.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Vernichte Planken, bis der Lagerbestand unter 100 fällt.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Vernichte einige Planken, um Platz im Lagerhaus zu schaffen.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Wie ich sehe, scheint Ihr meine Warnung nicht ernst zu nehmen, Statthalter. \n\nAb sofort sind die Samthandschuhe ausgezogen!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Ihr habt aber ein schönes Dorf errichtet.\n\nNur etwas unvorteilhaft für Euch, dass es auf meinem Land steht. \nBringt mir Schmuck und Kleidung! Und zwar schnell, sonst ist Euer Dorf Geschichte…\n";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Beeindruckend, was so eine kleine Drohung bewirken kann. Ich hätte nicht gedacht, dass Ihr mir wirklich diese Dinge liefern würdet.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Zahle einen Tribut an die Banditen.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Meine Jungs langweilen sich. Ich glaube ich schicke mal ein paar von ihnen auf Exkursion…\n\n...ZU EUCH!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Wie Ihr seht, werde ich mir holen, was ich verlange!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Guten Tag, Lord Statthalter.\n\nIch komme im Auftrag des Königs. Er hat mich zu Euch geschickt, damit ich Euch die Kunst des Krieges beibringe. Euer Banditenproblem sollte sich bald gelöst haben, mein Herr.";
"T_GAME_QUEST_MIL_TUT_10_START" = "Die Kaserne ist der Grundstein Eures Militärs. Sie ermöglicht es, Wachtürme zu bauen und sie zu versorgen. Soldaten kämpfen nur gut, wenn sie ordentlich versorgt sind!\nDer Einflussbereich jedes Turms sollte möglichst viel Fläche des Dorfes abdecken.\n\nBaut eine Kaserne und einen Wachturm, mein Herr.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Ihr habt tatsächlich Hilfe von einem Ritter bekommen. Meine Knie schlottern bereits vor der Kampfkraft Eurer Soldaten.\n\nMal sehen, was ihr gegen meine nächsten Angriffe unternehmen könnt…\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Die Banditen legen in unserem Dorf Feuer! Wo ist nur dieser Feuerwehrmann, wenn man ihn mal braucht?\n\nImmer wenn Ihr einen Townie sucht, geht ins Kontextmenü seines Gebäudes und benutzt die Option “Finde meinen Townie!”";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Hier könnt ihr sehen, was die Arbeiter in diesem Moment machen und wo sie sich befinden.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Produziere Gebräu und Würstchen.";
"T_GAME_QUEST_MIL_TUT_14_START" = "Unsere Soldaten benötigen Gebräu, um sich Kampfesmut anzutrinken.\n\nWir brauchen ein Kloster und eine Hopfendarre, um das Gebräu produzieren zu können.";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Unsere Soldaten benötigen Gebräu.\nDies bekommen wir über ein Kloster und einige Hopfenfelder, mein Herr.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "Das Kloster benötigt mehrere Ressourcen, die von anderen Gebäuden geliefert werden können.\nWasser vom Brunnen, Weizen von einem Bauernhof und Hopfen von einer Hopfendarre.\n\nNur dann beginnen die Mönche mit dem Brauen von Bier.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "Nun beginnen die Mönche mit dem Brauen von Bier. Im Kloster kann man einstellen, ob ein Mönch Hopfen ernten oder sich mit dem Brauvorgang beschäftigen soll.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Baue ein Kloster und eine Hopfendarre.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Baue ein Kloster und einige Hopfenfelder.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Für die Herstellung von Würstchen benötigen wir eine Schweinefarm und einen Metzger.\n\nSoldaten lieben den würzigen Geschmack von Würstchen. Die Würze wird durch die Beigabe von Kräutern zum Fleisch erreicht - diese kann ein Bauer im Kräutergarten ernten.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Eine Metzgerei kann nicht nur Würstchen herstellen, mein Statthalter. Die Metzgerei kann auch beauftragt werden, aus den Schweinen normales Fleisch herzustellen, welches von allen Townies gerne gegessen wird.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Baue eine Schweinefarm und eine Metzgerei.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Das mit der Verteidigung üben wir nochmal!\nBis zum nächsten Mal und danke für die Ressourcen!";
"T_GAME_QUEST_MIL_TUT_16_START" = "Gebräu und Würstchen!\n\nAuch meine Banditen lieben diese Nahrungsmittel. Ich bin der Meinung, dass ihr Eure Produktion dieser vorzüglichen Güter mit mir teilen solltet.";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Das war pures Glück! Nächstes Mal komme ich mit mehr Banditen vorbei…";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Verteidige dein Dorf.";
"T_GAME_QUEST_MIL_TUT_17_START" = "Das Dorf muss besser geschützt werden, Statthalter. Ihr solltet den Bau von weiteren Wachtürmen in Auftrag geben. Positioniert sie so, dass sie mindestens 50% des Dorfes mit ihrer Reichweite abdecken.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Nun haben wir einen hohen Anteil des Dorfes in der Reichweite von Türmen. Die Banditen werden es nicht einfach haben, in Euer Dorf einzudringen.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Decke mindestens 50% des Dorfes mit Wachtürmen ab.";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Wenn ihr mehr Informationen zum Militär sehen wollt, könnt ihr jederzeit einen Blick in den militärischen Bereich des Statistikmenüs werfen.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Unsere Soldaten sollten mit Waffen und Rüstungen versorgt werden. Waffen steigern die Angriffskraft und Rüstungen die Verteidigung der Soldaten.\n\nBeides wird in der Rüstkammer produziert. Für Rüstungen benötigen wir Leder aus einer Gerberei. Der Gerber verarbeitet dort Tierhäute, die von einer Jagdhütte oder einer Metzgerei hergestellt werden.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Baue eine Gerberei und eine Rüstkammer.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Lord, wir sollten beginnen, die Armee zu vergrößern. Dies ermöglicht es Euch, eine Angriffsstreitmacht zu dem Banditenlager zu schicken und es ein für alle Mal zu zerstören.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Vergrößere deine Armee.";
"T_GAME_QUEST_MIL_TUT_21_START" = "Es ist soweit, Statthalter.\n\nDie Armee ist groß genug, um einen Angriff starten zu können. Das Banditenlager ist in den Wäldern versteckt.\n\nUm es anzugreifen, öffnet Ihr sein Kontextmenü und wählt danach die Option “Gebäude angreifen!” aus.\nIch wünsche eine gute Jagd!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Zerstöre das Banditenlager.";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Gut, dass ich Sie treffe, mein Lehnsherr.\nIch bin gerade zum dritten mal diese Woche von Banditen überfallen worden.\nWir sollten dringend etwas gegen diese Unholde unternehmen!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Ein großer Sieg, mein Lehnsherr.\nDen Banditen haben wir es gezeigt und die Region ist wieder sicher. Der König wird begeistert sein.";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Schließe die Grundausbildung ab und besiege die Banditen.";
"T_GAME_QUEST_NEW" = "Neue Aufgabe!";
"T_GAME_QUEST_NEW2" = "Neue Aufgabe:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Wer hat schon dafür Zeit?";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Ihr habt recht.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Also gut, Mylord. Dann werden wir nichts gegen das schreckliche Brot unternehmen. Ich kann jetzt schon die lautstarken Beschwerden über das fürchterliche Essen hören. Aber naja…, zu Eurem Befehl, Mylord.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Oh, Sir. Das Brot ist jetzt köstlich. Der Verkaufswert ist auch gestiegen.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = "„Das Weizen ist das Problem. Man muss ein Problem dort bekämpfen, wo es entsteht. Sagt dem Müller, dass er sauberes Wasser verwenden soll. Möge die Hefe von guter Qualität sein.“\n\nEuer Berater gibt die Nachricht an den Bäcker weiter und verspricht, dass das Brot von nun an von besserer Qualität sein wird.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Mylord, wir müssen etwas tun. Das Brot ist nicht mehr das, was es mal war. Viele Townies beschweren sich über die Qualität. Wir sollten das Rezept ändern.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Ein neues Rezept";
"T_GAME_QUEST_NOQUEST" = "Keine Aufgabe verfügbar.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Beeilen wir uns und produzieren Schilde und Waffen. Wenn diese Menschen gefährlich sind, ist es besser, bereit zu sein.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Gouverneur, wir haben die Vorbereitungen für die Verteidigung der Stadt abgeschlossen.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Eure Soldaten melden Truppenbewegungen im Norden. Dort befindet sich die größte Wüste des Königreichs.\n\nIhr wisst jedoch, dass niemand verrückt genug ist, um einen Angriff auf dieser Seite Eurer Grenzen zu versuchen. Ihr beschließt, diese Bedrohung zu ignorieren. Geschehe was wolle!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Ein paar Tage später melden Ihre Soldaten eine Gruppe von Menschen, die direkt aus nördlichen Wüste kommen. Sie werden in ein paar Stunden in der Stadt sein.\n\nEs könnten nur Reisende sein, aber wer weiß, vielleicht sind es gefährliche Banditen, die in Eure Stadt eindringen wollen!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Bereitet die Geschütze vor.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Bereitet den herzlichen Empfang vor.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Die Wüste im Norden";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Eine Gruppe von zehn Leuten nähert sich Eurer Stadt. Die Soldaten bleiben auf der Hut und warten auf Euren Befehle.\n\nIhr lasst sie näher kommen. Der Anführer dieser Gruppe geht allein zu den Toren der Stadt. „Guten Morgen, Mylord, wir sind gerade durch die nördliche Wüste gefahren. Dürften wir Euch um eine Nacht Gastfreundschaft bitten?“";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "So kommt in unsere schöne Stadt, ihr könnt im Gasthaus bleiben, dort ist genug Platz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Während Euer Berater Euch nach Hause begleitet, seid Ihr immer noch auf der Hut. Warum riskierten die Reisenden die Durchquerung der Wüste, obwohl sie entlang des Flusses hätten segeln können? Es gibt doch keinen Grund einen gefährlicheren Weg zu wählen, außer man will sich verstecken...\n\nVielleicht könnten Eure Spione mehr über sie herausfinden. Oder Ihr könnt genauso gut enfach nur schlafen gehen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Geht schlafen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Schickt einen Spion.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Euer Spion blieb die ganze Nacht wach und schaffte es, einige Gespräche aus dem Gasthaus zu belauschen. Die Reisenden sind auf der Flucht. Sie sollen in ihrem Land auf der anderen Seite der Wüste bestimmte Verbrechen begangen haben. Die Armee wurde nach ihnen geschickt, und sie bereiten sich bereits auf ihre Weiterreise vor, um ihre Flucht fortzusetzen.\n\nWas wäre die beste Lösung?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Schließt die Reisenden ein.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Wir haben gerade eine Nachricht vom König erhalten. Aus dem Gefängnis des Nachbarlandes sind gefährliche Kriminelle geflohen. Es sind etwa zehn von ihnen und sie haben einen wertvollen Gegenstand gestohlen. Glaubt Ihr, es waren die Reisenden, die vor ein paar Tagen hier waren?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Schickt dem König eine Nachricht.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Behalten wir das für uns.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Ich werde dem König eine Nachricht zukommen lassen, damit er weiß, dass sie durch unser Dorf gekommen sind. Vielleicht können sie sie finden.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Sire! Die königliche Armee hat es geschafft, diese gefährlichen Personen in die Finger zu bekommen. Sie konnten sich den gestohlenen Schatz zurückholen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Danke für Eure Hilfe, Governor. Diese Leute hatten einen meiner kostbaren Juwelen gestohlen. Sie hatten vor ihn auf dem Schwarzmarkt zu verkaufen. Ihr habt das Richtige getan, um mich über ihre Anwesenheit in deiner Stadt zu informieren.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Jawohl, Eure Majestät. Wenn uns jemand danach fragt, sagen wir, wir wüssten von nichts.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Es ist schon eine Weile her, dass in der Stadt etwas Spektakuläres passiert ist. Doch heute habt Ihr das Gefühl, dass sich etwas ändern wird.\n\nUnd Ihr hattet Recht! Euer Berater übergibt Euch einen Brief von den Reisenden, die von der Royal Army gesucht werden. Im Brief steht folgendes:  \n\n„Danke, dass Ihr uns nicht verraten habt, Governor. Wir waren Opfer einer Verschwörung und unsere ganze Familie war in großer Gefahr. Indem Ihr es geheim gehalten habt, dass wir in Eurer Stadt waren, hatten wir Zeit, den Beweis unserer Unschuld zu finden. Ohne Euch wäre es unmöglich gewesen.  Bitte nehmen Sie daher diese Auszeichnung als Zeichen unserer Dankbarkeit an. Ihr seid ein guter Gouverneur.“";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Ich habe die Reisenden befreit, Majestät. Wie Ihr uns befohlen habt. Ich hoffe, es wird uns nicht zum Verhängnis.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Die Reisenden bedanken sich für Eure Freundlichkeit und versprechen, dass sie Euch, sobald ihre Unschuld bewiesen ist, eine Belohnung als Zeichen ihrer Dankbarkeit geben werden.\n\nIhr hofft aufrichtig, dass Ihr die richtige Entscheidung getroffen habt und dass diese Reisenden Sie nicht durch Lügen getäuscht haben.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Es ist jetzt mehrere Monate her, seit Ihr das letzte Mal von diesen Reisenden gehört habt. Manchmal denkt Ihr wieder darüber nach. Ihr hattest keine Probleme mit dem König, aber Ihr habt auch keine so genannte Belohnung erhalten.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Als plötzlich, eines Morgens, Euer Berater kommt, um Euch ein Paket mit einem Brief zu übergeben. Der Brief enthält eine Nachricht von den mysteriösen Reisenden. Sie drücken ihre Dankbarkeit aus. Im Paket seht Ihr die versprochene Belohnung. Prestige und Gold.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Ihr seid froh, dass ihr Recht hattet und dass Ihr nicht getäuscht wurdet.\n\nIhr Berater berichtet bereits, dass Ihr für diese Reisenden ein Held geworden sind und sie Euch applaudieren. Was für eine tolle Zeit, um Gouverneur zu sein.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Sire, die Reisenden verließen das Gasthaus am frühen Morgen, sie schienen in Eile zu sein.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Die Reisenden erwarten Eure Antwort. Einige sehen aggressiv aus, manche verängstigt. \n\n„Ich kann Euch leider keine Gastfreundlichkeit bieten, Reisende. Wir haben nicht genug Platz.“\n\n„LÜGEN!“, schreit plötzlich einer der Reisenden und stürmt mit seinem Schwert auf Euch zu.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Beschützt den Gouverneur!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Schnell, Sire! Beeilt Euch! Versteckt Euch!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Ihr habt es geschafft mit Eurem panisch wirkenden Berater in ein Versteck zu flüchten: „Sire, was sollen wir nur tun?! Diese bösen Reisenden zerstören unsere Stadt und es gibt nichts, was wir tun können! Wir hätten unsere Verteidigung aufrüsten sollen, statt Brötchen!“\n\nLeider können wir nur abwarten.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Am frühen Morgen wagt Ihr Euch aus Eurem Versteck heraus. Die Stadt wurde nicht beschädigt. Es scheint, als ob diese Reisenden einfach die Wachen ausgeschaltet und etwas Proviant für den Rest ihrer Reise mitgenommen haben.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Glücklicherweise haben wir uns auf einen potentiellen Angriff vorbereitet, Sire. Mit den Waffen und Schilden, die wir produziert haben, werden wir sie abwehren können. Da bin ich mir sicher.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Sire, wir konnten die Reisenden \n\nMajestät, es ist uns gelungen, alle Reisenden zu fassen. Wir haben sie Kerker geworfen. Es ist an der Zeit, eine Entscheidung zu treffen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Diese Reisenden werden immer seltsamer. Jetzt, da sie eingesperrt sind, fühlt man sich ein wenig sicherer. Aber irgendetwas bedrückt Euch. \n\nWas wollt Ihr tun?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Befragt Sie.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Informiert den König.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Na gut, Sire, ich werde ihnen ein paar Fragen stellen, um diese Sache aufzuklären.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Ihr Berater ist zurück und übermittelt Euch einige Informationen über die Reisenden. \n\nSie sind aus ihrem Land geflohen, weil sie zu Unrecht beschuldigt wurden. Der Beweis für ihre Unschuld liegt weiter südlich. In einer der umliegenden Städte.\n";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Lasst sie gehen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Deshalb werde ich mit dem König sprechen, damit die königliche Armee kommen und diese gefährlichen Verbrecher holen kann!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Die königliche Armee kommt endlich. Ihr übergebt ihnen die Reisenden. Der König schickt Euch eine Belohnung für die Bereitstellung der notwendigen Informationen, um diese gefährlichen Personen zu fangen.\n\nDie Stadt erholt sich langsam, während Ihr friedlich Ihre Aktivitäten als Gouverneur wieder aufnehmen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Euer Spion hat einen Fehler gemacht und wurde von den Reisenden entdeckt. Sie halten ihn als Geisel und fordern Lösegeld, wenn Ihr ihn lebend zurück wollt.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Wir werden viel Geld verlieren, aber wenigstens bleibt unser Spion sicher.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Danke, Sire, dass Ihr das Lösegeld bezahlt habt, um mich zu befreien! Ich hatte Angst um mein Leben. Was für ein gefährlicher Job, ein Spion zu sein.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Das ist eine tolle Idee. Wir sollten für diese Menschen Essen zubereiten, wenn sie vor unserer Haustür ankommen. Brot und Fisch sollten genügen.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Perfekt. Jetzt müssen wir nur noch auf sie warten.";
"T_GAME_QUEST_PLACE_STARTED" = "Es ist jetzt an der Zeit, den passenden Ort für eine Veranstaltung dieser Größenordnung zu bauen!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Oh lá lá, das ist absolut unglaublich! Kaum zu glauben, dass nichts davon passiert wäre, wenn die Wachen nicht fleißig gewesen wären. Ihr hattet eine wunderbare Idee, als Ihr diese Gelegenheit genutzt habt! Das Fest sieht vielverspechend aus.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Pflanzt weitere Blumen.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Das ist nicht nötig.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Wunderschön! Oh, Blumen sind wirklich etwas besonderes. Ihr Duft lässt mich auf Wolke 7 schweben.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Ihr seid ein schrecklicher Mensch. Unsere Stadt wäre so viel schöner mit Blumen gewesen!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Der Frühling ist wieder da, Mylord.  Das Dorf konnte von einigen zusätzlichen Blumen profitieren. ";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Bezaubernde Blüten";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "Das Sägewerk ist abgebrannt, mein Herr. Würdet ihr den Wiederaufbau in Auftrag geben? Für die Herstellung von Brettern benötigen wir ein Sägewerk!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Baue das Sägewerk wieder auf.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Gebt niemandem etwas davon ab.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Verteilt die Gewinne auf die Townies";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Investiert das Geld in Bergwerke.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Sir, wir haben viel Geld in der Kasse und eine Umverteilung einiger dieser Einnahmen wäre für die Stadt von Vorteil.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Die Dorfbewohner haben von Eurer Entscheidung gehört. Sie sind nicht glücklich. Versucht, Euren Leuten etwas mehr Aufmerksamkeit zu schenken, Sir.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "Die Produktivität der Townies wird nicht mehr durch die Entscheidung über die Gewinnumverteilung beeinflusst. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Wie glücklich Ihr die Townies gemacht habt! Sie sind überglicklich!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Ausgezeichnete Initiative, Sir. Beginnen wir mit dem Bau von Minen und dem Abbau von Ressourcen.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Das Geld, das wir in den Bau neuer Minen investiert haben, ist wahrscheinlich die beste Entscheidung, die wir je getroffen haben. Wir werden uns mit diesen Ressourcen leichter entwickeln können.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Ihr seid sehr großzügig, Sire. Mit diesem Bündel Münzen werden  die Bewohner ein besseres Leben führen können.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Gewinnumverteilung";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Wir hatten Glück, Sire. Unsere Ernte ist nicht betroffen. Die Wildschweine sind weg und wir müssen uns keine Sorgen mehr um sie machen.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Die Wildschweine haben unsere Ernte vernichtet, Eure Majestät! Sie haben vor der Farm keinen Halt gemacht. Es ist ein Massaker.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "Die Bevölkerung ist von diesem Verlust tief bestürzt und ihre Zufriedenheit und Produktivität ist beeinträchtigt.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Eure Majestät, unsere Felder beginnen sich von dem Schaden, den die Wildschweine vor einiger Zeit angerichtet haben, zu erholen. Die Feldfrüchte wachsen wieder nach und die Bürger vergessen nach und nach, was passiert ist. ";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Die Bevölkerung wird durch Eure Entscheidung vernachlässigt! Hoffentlich werden die Ernten nicht durch diese Wildschweine zerstört.";
"T_GAME_QUEST_REWARD" = "Belohnung:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Seid gegrüßt, Statthalter!\n\nSeht Euch nur diesen Ausblick an! Von dieser Klippe aus kann man das ganze Umland und die Küste überblicken. Ich übertrage Euch dieses Schloss. Hier sollt Ihr ein Dorf errichten. Schickt mir Tributzahlungen in sporadischen Abständen!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Anleihe beim König";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Mein Statthalter, solltet Ihr einmal knapp bei Kasse sein, so bietet die Krone euch ein Darlehen an, um wieder zahlungsfähig zu werden.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Willkommen in unserem bescheidenem Dorf, Statthalter.\nDie Küste in der Region ist durch eine Bergkette unterbrochen. Erzvorkommen sind auf der Südwestseite der Berge zu finden, mein Herr.\nIch freue mich schon auf unsere Zusammenarbeit.\n";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Willkommen, Herr Statthalter.\n\nIch bin Königin Frigyth, Herrscherin in diesem Königreich. Ich habe um Eure Hilfe gebeten, diesem Dorf zu wahrer Größe zu verhelfen. Das Land ist reich an Rohstoffen, also sollte es Euch ein leichtes sein. Enttäuscht mich nicht.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Mein Herr, seht nur die unendlichen Weiten in dieser Region. Flaches Land in alle Richtungen! Hier werden wir in absehbarer Zeit eine Großstadt errichten können, denkt Ihr nicht auch?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Seid gegrüßt, Lord Statthalter.\nAm Ufer dieses gewaltigen Stroms können wir eine große Stadt gründen. In dieser Gegend gibt es reichlich Fischgründe.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Wunderbar, Herr.\nDiese Schlucht ist eine der wichtigsten Handelsrouten durch die Berge. Das Dorf ist ideal positioniert, um reisenden Händlern eine Unterkunft zu bieten, während sie auf der Durchreise sind. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Mein Herr, am Fuße dieser Wasserfälle gibt es reichlich Fischgründe und Erzadern. Hier werden wir ein wahrlich wundervolles Dorf errichten können. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Willkommen in der Eisfeste, mein Herr.\nEs ist nicht einfach für die Townies, hoch zum Schloss hinaufzusteigen, aber der Ausblick über die Ebene ist es wert. Eure Ländereien wirken wirklich endlos von hier oben.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Guten Morgen, mein Statthalter.\nLasst euren Blick über die hügelige Ebene schweifen und blickt auf eure Ländereien. Ist dies nicht ein wahrlich schöner Ort? Ich denke, hier werden wir eine traumhafte Stadt errichten.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Einen guten Morgen wünsche ich Euch, mein Herr.\n\nWillkommen in unserem kleinen Dorf. Man sagt, dass die Grube durch einen herabfallenden Stern entstanden ist. Hoffen wir, dass es uns Glück gebracht hat. Der König hat bereits geschrieben, dass er in Kürze einige Aufgaben für uns hat.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Tribut für den König.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Stadtfest für die Townies.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Spende für die Bedürftigen.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Braufest in der Stadt:";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Verkaufe Schweine am Markt.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Handel auf dem Viehmarkt.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Verkaufe Vieh am Markt.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Rationen für das Heer.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Ausrüstung für die Soldaten des Königs.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Wehre Banditenangriffe ab.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Zerstöre Banditencamps.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Seid gegrüßt, mein Statthalter! Seht Euch diese Küste an! Ich erwarte, dass Eure Stadt den schönen Anblick würdigt!\nSorgt für Eure Bürger und zahlt pünktlich einen Tribut, damit Ihr mir weiter dienen könnt!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Ein wunderbarer Ort für die Fischerei, Herr Statthalter! An Nahrung sollte es uns hier nicht mangeln!\nWir würden es auch begrüßen, wenn Ihr ab und an ein Stadtfest organisieren könntet! Natürlich nur, wenn nach den Tributzahlungen an den König etwas übrig bleiben sollte!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Oh mein Schatz, danke, dass wir hierher gesiedelt sind! Dieser See ist wirklich wunderschön!\nHier können die Townies bestimmt glücklich werden, wenn du dich um sie kümmerst!\nUnd vergiss nicht, den König zu bestechen, damit wir hier bleiben dürfen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Mein Herr, es war eine weise Entscheidung, in dieses Flusstal zu gehen!\nDie Townies werden sicher zufrieden sein, wenn ihr den Bedürftigen helft!\nIch schlage allerdings vor, auch den König mit Eurer Großzügigkeit nicht außer Acht zu lassen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Seid gegrüßt! Meine Männer sind stolz darauf, aus diesem zentral gelegenen Punkt beim Errichten Eurer Machtstätte zu dienen!\nDas wird ein Jahr voller Festivitäten!\nLang lebe der König und lang lebt Ihr!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Mein werter Herr Statthalter, ich habe schon viel von Euch gehört! Daher habe ich Euch ausgewählt, diese Stadt am Hang meines Schlosses erblühen zu lassen!\nBesser, Ihr macht Euch sofort ans Werk! Gehabt Euch wohl!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Mein Lord, an diesem ausgetrockneten Flussbett lässt sich ein schönes Dorf errichten. Der König wird uns für einige gute Taten reich belohnen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Mein Herr, euer Schloss auf diesem Plateau ist der perfekte Ausgangspunkt, um eine florierende Stadt zu errichten. Zusätzlich habt Ihr einige Aufgaben vom König bekommen, die wir bei Bedarf abschließen können.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Vor der Küste wurde ein Archipel entdeckt. Erschließt diese Inseln mit Brücken und besiedelt sie in meinem Namen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Mein Lord, seht euch diese schöne Waldregion an. Um hier eine große Stadt zu bauen, haben wir einiges vor uns. Aber Wild und Holz ist in großen Mengen vorhanden.\n\nDies kann uns helfen, die Aufgaben des Königs zu erfüllen.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Mein Herr, die Tribute, die der König uns auferlegt hat, werden sehr schwer auszuführen sein bei diesem harten Winter. Wir sollten mit den Vorbereitungen sofort beginnen...";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Ein wunderbar grünes Tal, Herr Statthalter. Hier gibt es sicher genug Rohstoffe, um die Abgaben an den König zahlen zu können. Aber gebt Acht bei der Stadtplanung: In diesem felsigen Gebiet ist Bauplatz spärlich!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Das ist wirklich eine wunderschöne Insel! Ich bin so froh, dass wir hier her gekommen sind. Wir sollten sofort mit der Planung unseres Dorfes anfangen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Von diesem Schloss aus lässt sich das gesamte Umland überblicken. Allerdings sind die Winter hier oben länger, sodass Getreide schlecht gedeiht. \n\nIn den Sommermonaten einen Vorrat anzulegen wäre sicher klug.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Seid gegrüßt! Wir haben euch erwartet! Meine Männer haben bereits die Gegend ausgekundschaftet und dabei viele Erzadern entdeckt. \n\nBesser ihr macht euch sofort an die Arbeit, bevor euch jemand anders zuvorkommt!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Mein Lord, gut, dass Ihr da seid.\n\nDer frühere Statthalter hat das Weite gesucht. Er hat noch gerufen, dass diese Gegend verflucht ist. ";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Euer Vorgänger hat damit nicht ganz unrecht. Die Landwirtschaft ist schwierig, es wächst so gut wie nichts hier. Selbst das Wasser ist knapp. Aber ich bin mir sicher, dass Ihr eine Lösung finden werdet.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Wäre eure Exzellenz so freundlich und würde eine Kirche im Dorf errichten? Die Zufriedenheit in diesem Bereich ist äußerst niedrig, Herr. ";
"T_GAME_QUEST_SCEN10_10_NAME" = "Erreiche hohe religiöse Zufriedenheit.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Wie soll ein Mann von Welt denn hier herumlaufen, Statthalter? Auf diesen Waldpfaden macht es keinen Spaß zu laufen. Baut Straßen, die einer Stadt würdig sind.";
"T_GAME_QUEST_SCEN10_11_NAME" = "Baue Steinstraßen im Dorf.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Baue Feldwege im Dorf.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Hier hat jemand keine gute Arbeit geleistet, Herr. Die Gebäude sind alle baufällig. \n\nWir benötigen einen Schreiner, der sich darum kümmert, damit uns die Häuser nicht zusammenbrechen.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Baue eine Schreinerei und erreiche eine hohe Zufriedenheit mit dem Zustand der Gebäude.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Statthalter! Wieso haben wir noch nicht die vorgeschriebene Stadtgröße erreicht? Der Großherzog ist schon viel weiter. \n\nWir werden die Wette verlieren, wenn Ihr nicht alsbald genügend Einwohner im Dorf unterbringt.";
"T_GAME_QUEST_SCEN10_13_NAME" = "Vergrößere die Population des Dorfes.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Die eingereisten Familien sind nach der langen Anreise in euer Dorf sehr hungrig. Wie wäre es mit einem Bankett, um den Beginn des Wettstreits zu feiern, mein Herr?";
"T_GAME_QUEST_SCEN10_14_NAME" = "Produziere genügend Nahrung für das Dorf.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Wir sollten genug Handel mit reisenden Händlern betreiben. Dies lockt weitere Besucher an und macht unsere Stadt bekannt, Herr Statthalter.";
"T_GAME_QUEST_SCEN10_15_NAME" = "Erhandle einen großen Profit mit dem Händler.";
"T_GAME_QUEST_SCEN10_16_DESC" = "Wo sind die neuesten Steuereinnahmen, mein Statthalter? Vielleicht solltet Ihr eine Schatzkammer erbauen lassen, um eure Steuererträge zu erhöhen.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Baut eine Schatzkammer und nehmt genug Steuern ein.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Schmuck, ich benötige Schmuck. Aber wie wollt Ihr mir Schmuck zuschicken, wenn Ihr gar keine Goldschmiede errichtet habt, Herr?";
"T_GAME_QUEST_SCEN10_17_NAME" = "Baue eine Goldschmiede und beginne mit der Produktion von Schmuck.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Hervorragend, Herr. Nun könnt Ihr mir eine gut gefüllte Wagenladung an Schmuck zukommen lassen.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Schicke Schmuck an den Händler.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Die Grundversorgung sollte natürlich an erster Stelle stehen, mein Herr. Einige Fischer und Jäger sind hier von Nöten.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Baue einige Fischer- und Jagdhütten.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Herr Statthalter, ich kann erst Unterstützung bei Ihrem Vorhaben anbieten, wenn Ihr einen Marktplatz baut.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Ein Marktplatz wird benötigt, um das Dorf auszubauen.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Statthalter! Habt Ihr schon eine Werkzeugschmiede? Der Großherzog hat bereits mit der Eigenproduktion von Werkzeug begonnen.";
"T_GAME_QUEST_SCEN10_4_NAME" = "Baue eine Werkzeugschmiede und produziere die ersten Werkzeuge";
"T_GAME_QUEST_SCEN10_5_DESC" = "Bei all der Arbeit brauchen wir etwas zu trinken, Eure Exzellenz. Es wäre wirklich schön ein Wirtshaus zu haben. \n\nNatürlich nur, wenn Ihr Zeit habt.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Erreiche eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Habt ihr überhaupt genügend Wohnraum im Dorf, mein Herr? All die anreisenden Arbeiter sollten ein Dach über dem Kopf haben, oder?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Baue 2 große und 4 kleine Wohnhäuser.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Baue mehr große Wohnhäuser.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Baue mehr kleine Wohnhäuser.";
"T_GAME_QUEST_SCEN10_7_DESC" = "Das Dorf benötigt dringend etwas extravagante Unterhaltung. Einen Turnierplatz zum Beispiel. Sorgt dafür, bevor hoher Besuch kommt, mein Vasall.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Erreiche eine hohe Zufriedenheit mit Unterhaltung.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Erreiche eine hohe Zufriedenheit mit Turnierplätzen.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Mein Herr, sollten wir dieses triste Dorf nicht etwas verschönern, bevor der König das nächste mal zur Inspektion kommt?";
"T_GAME_QUEST_SCEN10_8_NAME" = "Baue mehr Dekorationen im Dorf.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Guten Tag, Herr Statthalter, habt Ihr Interesse an einem Handel? \n\nIch benötige dringend viel Kleidung, um einen Handel mit dem Großherzog zu machen. Ich würde Euch auch eine vorzügliche Summe zahlen!";
"T_GAME_QUEST_SCEN10_9_NAME" = "Liefere dem Händler eine Fuhre Kleidung.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Es ist ein Desaster, Statthalter! Der Großherzog von Canterborough hat es vor uns geschafft, seine Stadt aufzubauen. \n\nIch habe auf Eure Unterstützung gezählt und bin nun wirklich enttäuscht. Aber vielleicht war die Wette zu schaffen eine utopische Idee von mir. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Exzellent, mein Statthalter. Wir haben es vor dem Großherzog geschafft, die Stadt aufzubauen. Die Wette ist gewonnen! \n\nIch bin sehr von Eurer Leistung beeindruckt und werde Euch fürstlich belohnen lassen. Der Titel des Herzogs ist euch sicher.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Eventuell habe ich mich letzte Woche etwas übernommen, mein treuer Diener. \nMit dem Großherzog von Canterborough habe ich eine Wette gemacht, dass ich vor ihm meine am weitesten abgelegene Stadt zu einer Metropole aufbaue.";
"T_GAME_QUEST_SCEN12_01_START" = "Wie nett von Ihnen, bei uns vorbei zuschauen. Ich heiße Sie im Namen aller Mönche im Kloster willkommen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Willkommen in unserem Kloster, mein Herr.\n\nAber natürlich werden wir Ihnen bei der Herstellung des Geschenks für den König helfen. Allerdings haben wir hier momentan ein kleines Banditenproblem - vielleicht könntet Ihr uns im Gegenzug helfen?";
"T_GAME_QUEST_SCEN12_02_START" = "Was für eine hinterhältige Tat!\n\nJemand hat unsere Holzvorräte gestohlen! Wir können doch kein Gebräu lagern, wenn wir kein Holz für die Fässer haben!";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Wir sind Ihnen sehr dankbar für diese Tat, nun können wir wieder Gebräufässer herstellen.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Errichte einige Forsthütten.";
"T_GAME_QUEST_SCEN12_04_START" = "Mein Lehnsherr, das Dorf sollte erweitert werden, damit Eure Untertanen die Aufgaben erfüllen können. Eine stabile Wirtschaft zu haben, ist der nächst größere Schritt. Dafür benötigen wir Werkzeuge!";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Fantastisch, mein Herr. Nun können wir mit der Expansion beginnen.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Errichtet eine Werkzeug-Produktion.";
"T_GAME_QUEST_SCEN12_05_START" = "Das Dorf benötigt eine bessere Versorgung mit Nahrung. Wir haben zwar einen Bauernhof, aber keine Mühle oder Bäckerei?";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Sehr gut! Das Dorf entwickelt sich zu einer richtigen Stadt, mein Lord. Die Mönche werden begeistert sein!";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Errichte eine stabile Nahrungsproduktion. Baue eine Mühle und eine Bäckerei.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "Nein! Diese boshaften Banditen haben das Kloster zerstört!";
"T_GAME_QUEST_SCEN12_06_START" = "Mein Lord, dieses Kloster steht seit 400 Jahren auf dieser Anhöhe. Es wäre furchtbar, wenn es durch die gemeinen Banditen zerstört werden würde - diese Halunken drohen damit schon seit Wochen!";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Hervorragend, das Kloster steht noch immer!\n\nDie Banditen wurden abgewehrt und wir haben es geschafft, das perfekte Gebräu herzustellen.\n\nWas für ein feines Getränk es geworden ist. Absolut köstlich!";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Beschütze das Kloster.";
"T_GAME_QUEST_SCEN12_07_START" = "Ihr müsst das Kloster wieder aufbauen, mein Herr! Ansonsten werden wir unsere Aufgabe nie rechtzeitig erledigen können.";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Sehr gut, mein Lord! Das Kloster ist wieder aufgebaut worden - wir können nun unsere Aufgabe fortsetzen: Das Erzeugen des perfekten Gebräus!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Baue das Kloster wieder auf!";
"T_GAME_QUEST_SCEN12_08_START" = "Wir müssen sicherstellen, dass das Kloster gut geschützt ist, mein Lehnsherr. Einen Wachturm neben dem Kloster zu errichten, sollte ausreichen.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Errichte einen Wachturm mit dem Kloster im Einzugsbereich.";
"T_GAME_QUEST_SCEN12_09_START" = "Wusstet ihr, dass Soldaten Würstchen lieben? Ihr könntet eine Schweinefarm und eine Metzgerei errichten.";
"T_GAME_QUEST_SCEN12_09_START2" = "Mein Herr,\nich würde Euch empfehlen, dass wir eine Schweinefarm und eine Metzgerei errichten.\nZum einen können wir damit Fleisch für die Bevölkerung produzieren und zum anderen die von den Soldaten geliebten Würstchen.";
"T_GAME_QUEST_SCEN12_10_START" = "Hmmm, ich denke, wir sollten die Soldaten im Dorf mit Schwertern und Rüstungen versorgen - das würde ihre Erfolgsaussichten im Kampf erheblich steigern.\nDafür benötigen wir eine Rüstkammer und eine Gerberei.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Wir haben es geschafft: Die Rüstkammer wurde fertiggestellt!";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Errichte eine Rüstkammer und eine Gerberei.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Errichte eine Rüstkammer.";
"T_GAME_QUEST_SCEN12_11_START" = "Nun da wir eine Rüstkammer und eine Gerberei haben, sollten wir mit der Produktion von Waffen und Rüstungen beginnen, mein Herr.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Hervorragend, mein Lord. Die Soldaten werden in Zukunft viel besser im Kampf agieren können.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Stelle Ausrüstung für die Soldaten her.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Hervorragend, Herr. Nun ist das Kloster erst einmal vor Angriffen der Banditen geschützt.";
"T_GAME_QUEST_SCEN12_15_START" = "Meine Brüder und ich sind noch nicht dazu gekommen, die zerstörten Hopfenfelder wieder aufzubauen.\n\nWären sie so freundlich und würden einige neue Felder in Auftrag geben, mein Herr? ";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Baue einige Hopfenfelder.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Baue eine Hopfendarre und einige Hopfenfelder.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Haha! Euer lächerliches Kloster ist Geschichte. Nun werde ich mir erst mal ein leckeres Gebräu gönnen.";
"T_GAME_QUEST_SCEN12_16_START" = "Ihr denkt wirklich, dass ihr die kleinen Mönche mit dieser lächerlichen Konstruktion beschützen könnt? Werdet Zeuge, wie ich Euer Kloster dem Erdboden gleichmachen werde...";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Arghhh! Das nächste Mal habt ihr nicht so viel Glück! Wir werden uns wiedersehen...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Wehre alle Angriffe auf das Kloster ab!";
"T_GAME_QUEST_SCEN12_17_START" = "Mein Lord, meine Mönchsbrüder und ich werden nun unserem Handwerk nachkommen und für Euch das feinste Gebräu des ganzen Königreichs herstellen.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Wir sind mit dem Brauen fertig, mein Lehnsherr. Viele verschiedene Erzeugnisse wurden hergestellt - nun können wir das wohlschmeckendste Gebräu auswählen und weiter verfeinern.";
"T_GAME_QUEST_SCEN12_18_START" = "Unser Braumeister meinte, dass wir das Kloster weiter ausbauen müssen, um ein noch feineres Gebräu zu entwickeln. Wir wollen den König doch erfreuen, oder?\n\nDas Gebräu muss das Beste des Landes werden…";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Ausgezeichnet!\nDie Verbesserung des Klosters ist abgeschlossen. Das einzige was wir noch benötigen, sind ein paar der feinsten Zutaten, um das Gebräu perfekt zu machen.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Verbessere das Kloster auf Stufe 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Herr, das perfekte Gebräu benötigt noch einige spezielle Zutaten. Die feinsten Kräuter der Region und etwas Goldstaub würden das Getränk abrunden.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Liefere Kräuter und Golderz.";
"T_GAME_QUEST_SCEN12_20_START" = "Nun muss das Gebräu einige Zeit reifen, mein Herr.\n\nEs sollte nicht durch äußere Einflüsse gestört werden, denn der Reifungsprozess benötigt absolute Ruhe!";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Es ist vollbracht, mein Lehnsherr! Darf ich Ihnen das perfekte Gebräu präsentieren?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Verteidige das Kloster, bis das Gebräu fertig ist.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Ich wollte Euch persönlich danken, mein Statthalter.\nDieses Gebräu war wahrhaft vorzüglich und das perfekte Geschenk für mich. Ich wusste nicht, dass Euch meine Vorliebe für solche Brauerzeugnisse bekannt war.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Beschütze das Kloster und erzeuge das perfekte Gebräu für den König.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Bereite die Stadt auf die Ankunft des Königs vor.";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Dachtet ihr tatsächlich, mich hinters Licht führen zu können?\nIch bin enttäuscht, dass ihr nicht in der Lage seid, eine kleine Stadt zu verwalten. Ich muss ein ganzes Königreich regieren und habe es nicht nötig jemanden zu täuschen!";
"T_GAME_QUEST_SCEN13_01_START" = "Ich plane, innerhalb des nächsten Jahres meine Ländereien zu besichtigen.\nEure berühmte Stadt soll der Höhepunkt meiner Reise werden!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Ich bin außerordentlich zufrieden mit Euch. Ihr wisst, wie man erfolgreich eine Stadt führt und könnt Euch meiner Hochachtung sicher sein.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Bestehe die Inspektion des Königs.";
"T_GAME_QUEST_SCEN13_02_START" = "Seid gegrüßt, Herr Statthalter. Die letzte Besichtigung war ein Desaster! Daher beschloss ich, Euch früher zu beehren, um meinen Augen eine schöne und geschäftige Stadt zu gönnen.\n\nIch bin sicher, ihr habt mich bereits erwartet.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Lasst den König keinen Verdacht schöpfen.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Als Erstes sollten wir die Produktion von Rohstoffen wieder aufnehmen.\nStellt den Holzfäller wieder ein und repariert das Sägewerk, damit wir schnellstmöglich mit Reparaturen beginnen können!";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Sehr gut, mein Herr. Doch dies war erst der Anfang. Um die Wirtschaft der Stadt wieder in Gang zu bringen, dürfen wir keine Zeit verlieren!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Stelle einen Holzfäller an und repariere das Sägewerk.";
"T_GAME_QUEST_SCEN13_05_START" = "Oh Nein! Wegen Banditen in den Wäldern ist die Stadt völlig heruntergekommen!\nDem König würde das sicher gar nicht gefallen! Wir müssen sofort mit dem Wiederaufbau beginnen!";
"T_GAME_QUEST_SCEN13_06_START" = "Der Marktplatz wurde während des letzten Banditenangriffs zerstört. Wir sollten ihn wieder aufbauen und das restliche Gold aus der Schatzkammer gegen Waren eintauschen, die für den Wiederaufbau der Stadt dringend benötigt werden.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Wir brauchen auch dringend einen Schreiner, mein Herr. Viele Gebäude müssen schnellstens repariert werden!";
"T_GAME_QUEST_SCEN13_07_START" = "Wir müssen die Schatzkammer reparieren, damit der Steuereintreiber seine Arbeit wieder aufnehmen kann.\n\nDas Gold wird dringend für Reparaturen benötigt!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Exzellent. Mit dem Steuereinkommen sollten wir in der Lage sein, die nötigen Reparaturen der Stadt bezahlen zu können. ";
"T_GAME_QUEST_SCEN13_08_START" = "Wir brauchen mehr Arbeiter in der Stadt, um die Produktionsgebäude wieder besetzen zu können, mein Herr!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Zumindest haben wir nun Platz für weitere Arbeiter, aber wir sind noch nicht fertig. ";
"T_GAME_QUEST_SCEN13_09_START" = "Das ist eine Katastrophe! Die Stadt ist nicht annähernd für die Besichtigung des Königs bereit. Wir sollten schleunigst etwas dagegen unternehmen, sodass er keinen Verdacht schöpft.\nNutzt die Zeit, während der König sich ausruht, um die Produktionsketten auszubessern.";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Warte, bis der König sein erstes Reiseziel ankündigt.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Das ist nicht gut. Der König hat Banditen in den Wäldern entdeckt und Verdacht geschöpft. Wir müssen vorsichtiger sein!";
"T_GAME_QUEST_SCEN13_10_START" = "Der König hat angekündigt, dass er zuerst die umliegenden Wälder besichtigen möchte. Er hat keine Ahnung, dass dort zahlreiche Banditen hausen.\nSchnell, wir müssen ihre Lager zerstören, bevor der König dort eintrifft!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Das war knapp! Aber es ist noch nicht vorbei.";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Zerstöre alle Banditenlager.";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Oh Nein! Es ist nicht gelungen, den König zu überlisten. Da er nun Verdacht geschöpft hat, können wir uns keinen weiteren Fehltritt erlauben!";
"T_GAME_QUEST_SCEN13_11_START" = "Als nächstes möchte der König die Stadt besichtigen. Wenn er unzufriedene Bürger sieht, wird er merken, dass hier etwas nicht stimmt.\nAußerdem wurde die Statue zu Ehren des Königs vor einiger Zeit zerstört. Wir müssen schnell eine neue errichten!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Ausgezeichnet! Alle Bürger waren bester Laune während der Besichtigung des Königs. Zudem war er besonders beeindruckt von dem guten Zustand der königlichen Statue.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Bringe die Zufriedenheit der Bevölkerung über 100% und baue eine Statue des Königs.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Oh Nein! Der König war von den Wachen überhaupt nicht beeindruckt!\nWir können uns keine weiteren Fehler erlauben, solange der König da ist!";
"T_GAME_QUEST_SCEN13_12_START" = "Der König wird als nächstes die Truppen inspizieren.\nStelle sicher, dass ihn eine beeindruckende Stadtwache erwartet!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Ausgezeichnet! Der König wird von der Stadtwache beeindruckt sein!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Beschäftige genügend Soldaten.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Wir haben versagt, mein Herr! Der Ball entsprach nicht den Erwartungen des Königs und nun ist er verärgert.\nVielleicht wäre Ehrlichkeit der bessere Weg gewesen...";
"T_GAME_QUEST_SCEN13_13_START" = "Zum Abschluss seiner Besichtigung möchte der König einen großen Ball ausrichten. Stellt sicher, dass Schmuck und edle Kleider zur Verfügung stehen.\nSollten wir versagen, wird alles auffliegen!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "Der Ball war ein großer Erfolg und der König ist sehr zufrieden mit der Stadt. Es scheint, als wäre es uns gelungen, den König zu täuschen.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Lagere Kleidung und Schmuck.";
"T_GAME_QUEST_SCEN13_14_START" = "Ich werde unter keinen Umständen eure Stadt besuchen!\nEs ist viel zu gefährlich, Eure Straßen mit all meinen wertvollen Gütern zu bereisen.";
"T_GAME_QUEST_SCEN13_15_START" = "Nun, da ihr die Banditen besiegt habt, wird es mir ein Vergnügen sein, mit Euch zu handeln.";
"T_GAME_QUEST_SCEN13_16_START" = "Der Händler mag ein Feigling sein, doch er hat Recht. Die Wälder um die Stadt sind gefährlich und ein Banditenangriff, während der König zu Besuch ist, wäre eine Katastrophe!\nWir sollten einige Bürger zu Soldaten ausbilden und Wachtürme bauen, damit sie Ausschau nach Banditen halten können.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = "Hervorragende Arbeit, mein Herr. Damit ist der Grundstein für eine Stadtwache gelegt. Allerdings wäre es sicher klug, sie weiter zu verstärken.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Errichte eine Kaserne und einen Wachturm.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Oh Nein! Banditen haben es durch die Verteidigung geschafft?! Der König wird nicht erfreut sein, wenn er hiervon erfährt.";
"T_GAME_QUEST_SCEN13_19_START" = "Banditenangriffe würden nicht das Bild einer sicheren Stadt vermitteln!\nGebt Acht, dass es nicht zu viele Angriffe gibt, solange der König die Stadt besichtigt.";
"T_GAME_QUEST_SCEN14_01A_START" = "Mein Lord,\ndenkt ihr nicht, dass dieser Mann irgendwie seltsam ist?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Liefere Stoffe.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Mein Lehnsherr! Wir haben versagt!\nDieser medizinische Berater ist ein Scharlatan. Er hat unseren gesamten Goldvorrat geklaut und ist über alle Berge verschwunden.\n\nZum Glück haben wir das Heilmittel in seinem Labor entdeckt... ";
"T_GAME_QUEST_SCEN14_01_START" = "Mein Lehnsherr, das ganze Land wird von der Pest heimgesucht.\n\nSogar der König ist von der Seuche betroffen!\nDer medizinische Berater am Hofe benötigt unsere volle Unterstützung bei der Herstellung eines Heilmittels, mein Herr.";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Wir haben rechtzeitig ein Heilmittel gefunden, mein Herr.\nEs wird dem König verabreicht, während wir hier sprechen - das sind wahrlich gute Neuigkeiten für das Königreich!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Finde ein Heilmittel für den König!";
"T_GAME_QUEST_SCEN14_02A_START" = "Irgendetwas stimmt hier nicht, mein Lehnsherr. Dieser neue Berater vom König verlangt nach sonderbaren Sachen.\n\nIch habe ein ungutes Gefühl bei ihm. Wir sollten auf der Hut sein…";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Ausgezeichnet, Herr. \nAuf euren Befehl hin werde ich das Gebräu unverzüglich zum Heilmedikus bringen lassen. \nHoffentlich erzeugt er bald ein Heilmittel - viel Zeit hat der König nicht mehr.";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Liefere das Gebräu.";
"T_GAME_QUEST_SCEN14_02_START" = "Ich habe Gerüchte gehört, dass ein Gebräu am Tage die Leute gesund und glücklich machen soll, mein Lord. Ein Kloster zu bauen und etwas Gebräu zu produzieren könnte dem König vielleicht helfen.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Ich habe Gerüchte gehört, dass ein Gebräu am Tage die Leute gesund und glücklich machen soll, mein Lord.\n\nEin Kloster sowie eine Hopfendarre zu bauen und etwas Gebräu zu produzieren, könnte dem König vielleicht helfen.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Sehr gut! Die Mönche werden uns sicherlich mit etwas Gebräu helfen. Der König wird erfreut sein.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Errichte ein Kloster.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Errichtet ein Kloster und eine Hopfendarre.";
"T_GAME_QUEST_SCEN14_03_START" = "Wir benötigen eine Schweinefarm, um dem Heilmedikus die Schweine zu liefern.\n\nIhr solltet sie schleunigst in Auftrag geben, mein Herr.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Hervorragend, mein Herr. Nun können wir mit der Zucht von Schweinen beginnen.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Errichte eine Schweinefarm.";
"T_GAME_QUEST_SCEN14_05_START" = "Mein Herr! Eine Kaserne ist im Dorf erforderlich. Wir müssen für Recht und Ordnung in diesen Zeiten sorgen.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Lord, ich wusste es!\n\nDieser medizinische Berater ist ein Scharlatan. Er hatte das Heilmittel für die Seuche die ganze Zeit. Es sieht so aus, also ob er diese Krankheit im ganzen Land ausgebreitet hat.\n\nIch habe mir erlaubt, ihn in Gewahrsam nehmen zu lassen.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "Skandal!\n\nWie könnt ihr es wagen, mich verhaften zu lassen! Ich bin der vertraute Berater des Königs. Das könnt Ihr nicht machen…";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Ihr enttäuscht mich, Statthalter!\nLetzte Nacht hatte ich eine Vision: Ich sah, dass eure Inkompetenz großes Unheil über dieses Dorf bringen wird!\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Statthalter! Mein Name ist Rasiksin, Hellseher und medizinischer Berater des Königs.\n\nIch werde die Entwicklung eines Heilmittels leiten und benötige jegliche Unterstützung, die Ihr mir geben könnt…\n\nLiefert mir deshalb genug Heilkräuter! Ich benötige eine große Menge und zwar unverzüglich!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Wie ich sehe, habt Ihr die Kräuter auf Lager, die ich benötige.\n\nIch hatte schon eine vage Vision, die mir zeigte, dass ihr nicht schnell genug liefern könnt.\nNun beauftragt euren Berater, mir die Kräuter zu liefern und geht mir aus den Augen! Ich habe zu tun...";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Liefere die Kräuter.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Ich hätte nicht auf Euch zählen sollen. Meine Visionen zeigten mir eure Inkompetenz und das Unglück, welches Ihr über dieses Land bringt. Ihr habt den König und mich sehr enttäuscht, Statthalter.";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Ich benötige dringend Stoffe, um das Heilmittel filtrieren zu können! Produziert mir unverzüglich genug Stoffe, damit ich mit dem Filtrieren beginnen kann.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Gut zu sehen, dass Ihr meine Zeit nicht verschwendet habt.\nNun ordert die Lieferung der Rohstoffe! Ich bin sehr beschäftigt!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Produziere Stoffe.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "Ich benötige Gebräu und zwar schnell! Das Heilmittel muss verdünnt werden. Gebräu eignet sich am besten für eine Massenproduktion.\n\nNun los, beeilt Euch!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Das wurde aber auch Zeit! Nun liefert es an mein Labor!";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Produziere Gebräu.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Nein...es ist zu spät! Nun wird die nächste Katastrophe die Stadt heimsuchen.\n\nDies ist allein Euer verschulden!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Wir müssen zu drastischen Mitteln greifen, um den König zu heilen.\n\nIch benötige Schweine, um sie den traditionellen Göttern zu Opfern.\nVielleicht hilft es…";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Ihr habt Euch ja Zeit gelassen, Statthalter! Ein Glück, dass Ihr überhaupt auftaucht…";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Liefere Schweine.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Ich brauche...ähh... ich meine natürlich, der König braucht ein seltenes Pfeifenkraut, welches seine Schmerzen lindert. \nSchickt mir eine Truhe voll Münzen, damit ich damit Medizin kaufen kann!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "Gebt mir das Geld...\nDamit ich...ähh.. der König seine Medizin bekommt. Er hält es kaum noch aus vor Schmerzen!";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Liefere das Geld.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Ich habe herausgefunden, dass die Kleidung des Königs ihn krank macht. Er benötigt dringend neue Kleidung aus einem speziellen Material. Etwas besseres als diese Lumpen…\n";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Endlich kommt Ihr mit der Kleidung. Es ist aber auch höchste Zeit - der König ist bereits sehr ungeduldig.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Liefere Kleidung.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Ich halte es nicht mehr aus in diesem alten Labor.\n\nBaut mir einen Wachturm, den ich in ein wundervolles Labor umfunktionieren kann. Es sollte in einem Turm sein. Ich mag Türme...";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "Diesen Turm übernehme ich im Namen des Königs. Dort wird mein neues Labor entstehen. Nun geht mir aus den Augen!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Baue einen Wachturm.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Eine letzte Sache fehlt mir noch.\n\nIch benötige Goldbarren, um das Heilmittel fertigzustellen. Bringt mir Goldbarren!";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "Na endlich! Nun benötigt es nur noch etwas Zeit, um das Heilmittel zu veredeln.\n\nIch werde noch einige Vorkehrungen treffen müssen, bevor ich verschw… ähh ich meine natürlich, dem König das Heilmittel verabreichen werde.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Liefere die Goldbarren";
"T_GAME_QUEST_SCEN15_01_FAIL" = "Alles ist verloren! Sie werden mit dem Wissen über die Mitschuld am Verlust vieler guter Männer leben müssen…";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "Alles ist verloren! Ohne die nötigen Vorräte konnten wir keinen Sieg davontragen.\n\nSie werden mit der Schuld am Verlust vieler guter Männer leben müssen!\n\nDer König ist außer sich…";
"T_GAME_QUEST_SCEN15_01_START" = "Seid gegrüßt, Herr Statthalter.\nMir ist klar, dass der Krieg das ganze Land belastet, doch die Soldaten an der Front brauchen dringend eure Unterstützung!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Seid gegrüßt, Herr Statthalter.\nMir ist klar, dass der Krieg das ganze Land belastet, doch die Soldaten an der Front brauchen dringend eure Unterstützung!\n\nEin Sieg wird nur möglich sein, wenn alle Nachschublieferungen durch euer Dorf rechtzeitig ankommen.\n\nDer König zählt auf euch!";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Wir haben den Sieg errungen!\nBesonders eure zuverlässige Unterstützung hat dazu beigetragen - seid Euch unserer tiefsten Dankbarkeit sicher!\n\nMögen friedvollere Zeiten einkehren!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Unterstütze die Soldaten des Königs.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Erledige alle Nachschublieferungen für die Armee des Königs.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "Das Leben vieler Männer hängt von eurer Unterstützung ab!";
"T_GAME_QUEST_SCEN15_02_START" = "Wir haben neue Gebiete erobert und müssen die Front sichern.\nSchickt Bretter und Stoff, damit wir Lager errichten können!";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Sehr gut. Sendet die Materialien nun an meine Soldaten!";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Sende Stoff und Bretter.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "Wie denkt ihr, sollen meine Soldaten ohne geeignete Ausrüstung eine Schlacht gewinnen?";
"T_GAME_QUEST_SCEN15_03_START" = "Die letzten Kämpfe haben viele Ressourcen verschlungen!\nIch bitte um die Lieferung von Waffen, um meine Männer neu ausrüsten zu können.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Mit der neuen Ausrüstung werden meine Männer sicher siegreich aus den nächsten Kämpfen hervorgehen!";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Liefere Waffen.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Ohne eure Lieferung habe ich keine Hoffnung für die letzte Schlacht!";
"T_GAME_QUEST_SCEN15_04_START" = "Unsere Rationen werden knapp!\nSendet Brot und Fleisch, damit wir uns vor der letzten Schlacht stärken können.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "Die Soldaten warten auf die Nahrungsmittel, sendet sie nun!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Sende Brot und Fleisch.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "Liefere Gebräu und Würstchen";
"T_GAME_QUEST_SCEN15_08_START" = "Obwohl die Stadt eine harte Zeit durchmacht, können wir unsere tapferen Soldaten nicht im Stich lassen. Doch auch das Volk leidet unter dem Krieg.\nIhr werdet Euch entscheiden müssen, mein Herr!\n\nErrichtet zuerst ein Sägewerk und eine Jagdhütte.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Ausgezeichnet. Nun ist die Stadt hoffentlich bereit für die Forderungen des Königs.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Baue ein Sägewerk und eine Jagdhütte.";
"T_GAME_QUEST_SCEN15_09_START" = "Um zukünftige Forderungen erfüllen zu können, brauchen wir eine Schafweide und eine Webstube.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Ausgezeichnete Arbeit, mein Herr. Ihr könnt die Herstellung von Waren jederzeit beschleunigen, indem ihr die Stufe von Produktionsgebäuden erhöht oder weitere errichtet.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Baue eine Schafweide und eine Webstube.";
"T_GAME_QUEST_SCEN15_10_START" = "Für diese Lieferung müssen wir die Eisenindustrie aufbauen. Wir brauchen eine Werkzeugschmiede und eine Rüstkammer, um unsere tapferen Soldaten zu versorgen!";
"T_GAME_QUEST_SCEN15_10_SUCCESS" = "Der Schmied ist bereits am Arbeiten. Stellt sicher, dass genügend Rohstoffe zur Verarbeitung vorhanden sind.";
"T_GAME_QUEST_SCEN15_10_TITLE" = "Errichte eine Werkzeugschmiede und eine Rüstkammer.";
"T_GAME_QUEST_SCEN15_11_START" = "Um die Truppen mit Lebensmitteln zu versorgen, brauchen wir eine Bäckerei und weitere Jagdhütten.";
"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Ausgezeichnet. Die benötigten Güter sollten bald vorrätig sein.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Baue eine Bäckerei und errichte mehr Jagdhütten.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "Indem ihr Euch auf die Lieferungen an das Heer konzentriert habt, habt ihr Eure Bevölkerung vernachlässigt!";
"T_GAME_QUEST_SCEN15_13_START" = "Wir durchleben eine schwere Zeit voller Entbehrungen, mein Herr.\nIch bitte Euch demütig, einen Teil der Güter für die Soldaten an die Bevölkerung zu spenden!";
"T_GAME_QUEST_SCEN15_13_SUCCESS" = "Ihr seid ein ehrenwerter Herrscher, mein Lehnsherr! Neben den Lieferungen an die Soldaten habt ihr Eure Bevölkerung nicht vernachlässigt.";
"T_GAME_QUEST_SCEN15_13_TITLE" = "Optional: Unterstütze die Bevölkerung.";
"T_GAME_QUEST_SCEN15_13_TITLE_OLD" = "Unterstütze die Bevölkerung.";
"T_GAME_QUEST_SCEN15_14_FAIL" = "Zu sehen, wie wertvolle Ressourcen von einem Krieg verzehrt werden, den niemand unterstützt, frustriert die Leute.";
"T_GAME_QUEST_SCEN15_14_START" = "Der Winter naht und viele Bürger können sich keine angemessene Kleidung leisten. Seid so gütig und verarbeitet einige Stoffe zu Kleidung.\nWir können keine Bezahlung bieten, doch wir werden härter arbeiten als zuvor!";
"T_GAME_QUEST_SCEN15_14_START_2" = "Es ist kalt geworden, mein Herr.\n\nViele Bürger können sich keine angemessene Kleidung leisten. Seid so gütig und verarbeitet einige Stoffe zu Kleidung.\nWir können keine Bezahlung bieten, doch wir werden härter arbeiten als zuvor!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "Ihr seid so gütig, mein Herr! Nun müssen wir nicht in der Kälte frieren.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Produziere Kleidung für das Volk.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Ohne neues Werkzeug sind die Arbeiter nicht in der Lage, effektiv zu arbeiten.";
"T_GAME_QUEST_SCEN15_15_START" = "Waffen sind Werkzeuge der Zerstörung! Wenn ihr allerdings dem Werkzeugschmied etwas Eisen liefern würdet, so könnte er neues Werkzeug für die Arbeiter schmieden. So können sie in diesen schweren Zeiten effektiver arbeiten.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "Eure Großzügigkeit kennt keine Grenzen, mein Herr.";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Spende Werkzeuge an die Arbeiter.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Mein Herr, die Bevölkerung hungert immer noch. Wenn sie nicht bald genug Lebensmittel erhält, wird die Stimmung mit Sicherheit noch schlechter werden.";
"T_GAME_QUEST_SCEN15_16_START" = "Das Volk hungert, mein Lehnsherr. Ich bin sicher, in den königlichen Kammern sind noch genug Lebensmittel für ein paar Soldaten. Liefert die Lebensmittel stattdessen an uns und ihr werdet nie wieder eine Beschwerde hören!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "Mögen die Götter Euch segnen. Ihr werdet eine Menge Leben retten.\nWir stehen tief in eurer Schuld, mein Herr.";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Schenke dem Volk Nahrungsmittel.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "Unzufriedenheit breitet sich im Volk aus, mein Herr. Ihr müsst schnell etwas unternehmen!";
"T_GAME_QUEST_SCEN15_17_FAIL" = "Schlechte Nachrichten, mein Herr. Die Stimmung der Bevölkerung ist sehr schlecht. Ich befürchte ein unzufriedener Bürger könnte etwas Unüberlegtes machen.";
"T_GAME_QUEST_SCEN15_17_START" = "Das gesamte Land leidet unter den Auswirkungen des Krieges, mein Herr!\nIch befürchte, es könnte einen Aufstand geben, wenn die Stimmung schlechter wird.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Außerordentliche Leistung, mein Herr! Ihr habt es, trotz der Abgaben an die Soldaten, geschafft, die Unruhen zu verhindern!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Lass die Zufriedenheit nicht zu stark sinken.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Halte die Zufriedenheit über 75%.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Sorge dafür, dass die Zufriedenheit nicht zu lange unter den Wert fällt.";
"T_GAME_QUEST_SCEN15_19_START" = "Ich habe Gerüchte gehört, dass das Feuer in der Stadt kein Unfall war, mein Herr. \nWenn ihr ein Wirtshaus errichten würdet, könnte ich sicher mehr über diesen Vorfall herausfinden.";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Die Dorfbevölkerung wird sich sicher eine Menge Gerüchte im neuen Wirtshaus erzählen. Ich werde versuchen, mehr über die Brände in der Stadt herauszufinden.";
"T_GAME_QUEST_SCEN15_20_START" = "Gerüchte im Wirtshaus berichten von einem Unruhestifter, der versucht, das Volk aufzuhetzen. Vielleicht würde die Anwesenheit von Wachen sein bösartiges Treiben beenden.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Jetzt müssen wir nur warten, bis er wieder versucht, ein Feuer zu legen...";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Endlich können wir aufatmen, mein Herr! Die Wachen konnten den Unruhestifter schnappen und haben ihn eingesperrt - die Stadt sollte wieder sicher sein.";
"T_GAME_QUEST_SCEN16_01_START" = "Seid gegrüßt, verehrter Herr Statthalter. Die Forderungen der königlichen Kornkammern werden sicher bald eintreffen. \nWir sollten die örtliche Landwirtschaft unterstützen, um die Abgaben bewältigen zu können.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Ausgezeichnet!\n\nMit Eurem wirtschaftlichen Geschick ist es gelungen, alle Abgaben an den König zu meistern, mein Herr.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Erfülle die königlichen Abgaben.";
"T_GAME_QUEST_SCEN16_02_2_START" = "Oh Nein! Der König hat mehr Weizen verlangt. \nWir müssen das fehlende Getreide beim Händler eintauschen, um die Lieferung abschließen zu können!";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "Wir haben es tatsächlich geschafft! Sendet den Weizen nun an den König.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Sende weiteren Weizen an den König.";
"T_GAME_QUEST_SCEN16_02_START" = "Der König hat soeben die ersten Abgaben von den Dörfern eingefordert. Wir sollten die verlangten Vorräte möglichst bald bereit stellen.";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Es ist nun genug Getreide im Lager, um die Lieferung an den König zu senden, mein Herr.";
"T_GAME_QUEST_SCEN16_03_START" = "Der König braucht Rohstoffe für den Bau von zusätzlichen Lagerhäusern.\nSendet die benötigten Materialien an den König.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Ausgezeichnet, mein Herr. Sendet die Materialien, damit wir mit den anderen Lieferungen fortfahren können.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Liefere Baumaterialien für ein Lagerhaus.";
"T_GAME_QUEST_SCEN16_04_1_START" = "Die erste Lieferung Fleisch war durch die Krankheit verdorben. Der König verlangt nach einer weiteren Lieferung, aber erst, nachdem wir die Krankheit im Dorf besiegt haben.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Hervorragende Arbeit, mein Herr. Eine neue Lieferung frischen Fleisches steht zur Auslieferung bereit.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Sende Fleisch.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Liefere Fleisch, sobald die Krankheit vorüber ist.";
"T_GAME_QUEST_SCEN16_04_START" = "Die königlichen Kornkammern sind endlich gefüllt. Nun verlangt der König nach Fleisch.\nMit genügend Jägern sollte dies kein Problem darstellen.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Sehr gut, die geforderte Menge an Nahrungsmitteln liegt im Warenhaus bereit.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Baue weitere Jagdhütten und liefere Fleisch.";
"T_GAME_QUEST_SCEN16_05_START" = "Der König plant ein großes Fest und möchte, dass wir die Getränke liefern.\nEr fordert dafür Gebräu und Traubensaft.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Sehr gut, mein Herr. Genügend Gebräu und Traubensaft stehen im Lager bereit.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Liefere Gebräu und Traubensaft.";
"T_GAME_QUEST_SCEN16_06_START" = "Der König ist sehr zufrieden und wir sollen nun auch die Speisen für das Fest stellen.\nEine letzte Lieferung an Würstchen und Brot noch.";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Ausgezeichnet, mein Herr. Dies sollte der letzte Tribut gewesen sein.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Sende Würstchen und Brot.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Liefere Saft und Brot.";
"T_GAME_QUEST_SCEN16_08_START" = "Eine Katastrophe, mein Herr! Unser Getreide ist von einer unbekannten Krankheit befallen worden und verdorben. Was sollen wir jetzt nur machen?";
"T_GAME_QUEST_SCEN16_09_START" = "Die Stadtbewohner leiden unter einer schrecklichen Krankheit. Wir müssen sie schnell besiegen, bevor keine gesunden Arbeiter mehr übrig sind!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "Die Seuche scheint durch das Fleisch von kranken Wildtieren ausgelöst worden zu sein.\nDie Lieferung an den König war ebenfalls verseucht. Wir werden eine neue senden müssen.";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Besiege die Seuche mit Hilfe eines Heilmedikus.";
"T_GAME_QUEST_SCEN16_10_START" = "Die Götter scheinen sich gegen uns verschworen zu haben! \nEine furchtbare Krankheit hat alle Wildtiere verenden lassen. Wie sollen wir jetzt nur das Dorf ernähren und die Forderungen des Königs erfüllen?";
"T_GAME_QUEST_SCEN16_11_START" = "Ohne Anbindung zum Meer sind wir abhängig von Weizen und Fleisch. Wir werden selbst Tiere züchten müssen.\nWir benötigen dringend eine Schweinefarm und einen Metzger.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Die Schweine ernähren sich von Weizen. Ertauscht diesen beim Händler, dann können wir uns wieder um die Lieferung für den König kümmern.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Errichte eine Schweinefarm und eine Metzgerei.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Ihr versteht sicher, dass meine Vorräte sehr begehrt sind, daher musste ich den Preis für das Getreide ein wenig anheben.\nVon nun an tausche ich Getreide gegen Eisenerz.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Sendet mir die Waren und ich werde schnellstmöglich mit einer neuen Lieferung zurückkehren.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Tausche Eisenerz gegen Getreide.";
"T_GAME_QUEST_SCEN16_12_2_START" = "Für eine lächerliche Menge Gold kann ich Euch eine Lieferung des letzten Getreides des Landes anbieten.";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Es ist mir ein Vergnügen, mein Herr. Wenn ihr mir die Güter bringt, werde ich versuchen, noch etwas mehr Getreide aufzutreiben.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Tausche Gold gegen Getreide.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Ich habe von Eurem Unglück gehört, mein Herr, und möchte Euch einen Handel anbieten.\nIch habe noch einige Getreidereserven, welche ich gegen Güter tauschen würde.";
"T_GAME_QUEST_SCEN16_12_START" = "Ich wäre bereit einige Steine gegen Weizen zu tauschen.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Ihr scheint genug Waren für einen Tauschhandel zu haben. Ich freue mich auf weitere Geschäfte.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Tausche Steine gegen Getreide.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Habt Ihr schon das Brot meines Neffen probiert? Das solltet Ihr unbedingt! Und sagt ihm, er soll genug für den Winter backen!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Backe 50 Stück Brot.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Baue eine Webstube.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Baue eine Schneiderei.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Sagt, ist Euch auch so kalt? Meine Frau hat sich schon eine Grippe eingefangen, weil ihre Kleider voller Löcher sind. Vielleicht könntet Ihr uns dabei helfen, warme Winterklamotten zu nähen?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Baue eine Schafweide.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Ich glaube, unsere Stadt ist beinahe perfekt für den Winter vorbereitet! Aber, mal unter uns, ist es bei der Kälte nicht am schönsten, bei einem Glas Saft im Wirtshaus zu feiern?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Baue eine Kelterei und produziere 50 Liter Saft.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Mein Herr, ich will nicht unhöflich sein, aber leider fehlt es uns an Höfen! Wie sollen wir nur den ganzen Weizen rechtzeitig vor Winteranbruch ernten können?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Baue 2 Bauernhöfe.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrrr, ich friere jetzt schon, Herr Statthalter! Das wird sicher ein eiskalter Winter, der uns bevorsteht! Meine Frau und ich hoffen, dass Ihr nicht vergesst, an genug Feuerholz zu denken!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Baue 3 Forsthütten.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Habt Dank! Grüßt meine Brüder, wenn Ihr sie seht! Sie sollen so viel Holz sammeln wie nur möglich!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Sammle 35 Holz.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Endlich können wir mit der Ernte beginnen! Hoffentlich wird der Ertrag reichen!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Ernte 35 Weizen.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Wir wissen schon gar nicht mehr, wohin mit dem ganzen Weizen! Daher würden wir es begrüßen, wenn wir die Möglichkeit hätten, nahrhaftes Brot daraus zu machen!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Baue eine Windmühle und produziere Mehl.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Herr Statthalter, wir fühlen uns hier wirklich wohl, aber wir befürchten, dass unsere Häuser den Winter in diesem Zustand nicht lange überstehen werden...";
"T_GAME_QUEST_SCEN2_6_NAME" = "Halte alle Wohnhäuser in einem gutem Zustand.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Ich hätte da noch ein Anliegen... Wir haben leider kein Werkzeug mehr vorrätig... Ihr wisst doch sicher, wie wichtig Werkzeuge für anstehende Reparaturen sind! Hättet Ihr die Freundlichkeit, uns ein paar zu besorgen?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Liefere einen Tribut von 50 Werkzeugen.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Ich befürchte, meine Brüder werden nicht ausreichen, um die ganze bevorstehende Arbeit zu bewältigen... vielleicht habt Ihr ja eine Möglichkeit, mehr Bewohner in unser Dorf zu bringen?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Erhöhe die Bevölkerung auf 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Die ersten Eiszapfen bilden sich schon auf meiner Nase... aber viel schlimmer geht es einigen Wanderern, die nach einer Siedlung suchen. Ich finde, wir sollten sie in unserem Dorf aufnehmen!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Baue 6 Wohnhäuser.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Denk dran, Schatz, morgen ist unser Hochzeitstag! Du könntest mir gerne mal wieder etwas Schmuck schenken! Wenn du doch nur einen Goldschmied kennen würdest...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Baue eine Goldschmiede.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Ich bin mir sicher, der König und die Townies freuen sich über ein paar neue Werkzeuge! Die alten sind schon ganz rostig und unbrauchbar geworden!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Baue einen Werkzeugschmied.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Baue eine Schneiderei und produziere genug Kleidung.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Oh, diese süßen Schafe! Schatz, hast du die schon gesehen? Und wie viel Wolle schon gewonnen wurde! Jetzt kannst du endlich eine Webstube und Schneiderei bauen!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Baue eine Webstube und produziere genug Stoffe.";
"T_GAME_QUEST_SCEN3_13_DESC" = "Die Kinder sind schon ganz aufgeregt und freuen sich auf das Brot, das sie bald bekommen! Du hast doch schon ein paar Bäckereien gebaut, oder? Schatz?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Stell dir vor, meine Schwester will endlich heiraten! Aber wir brauchen unbedingt noch eine Kirche in der Stadt! Nicht nur für die Trauung, sondern auch für die gläubigen Townies!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Sorge für eine hohe Religions-Zufriedenheit.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Sieh dir das an, Schatz: Die Stadt hat sich erholt und alles läuft super! Von mir aus darfst du jetzt gerne mal mit deinen Freunden ausspannen und ein Wirtshaus errichten!";
"T_GAME_QUEST_SCEN3_15_NAME" = "Erreiche eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Schatz, sieh dir dieses heruntergekommene Dorf nur an... die armen Townies tun mir richtig Leid! Ich finde, du solltest mal den König um Hilfe bitten! Vielleicht lässt er sich ja mit ein paar Geschenken überzeugen!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Liefere einen Tribut an den König und erfülle alle Aufgaben.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Bis der König was unternimmt, solltest du die Sache schon mal selber in die Hand nehmen! Die Townies brauchen dringend mehr Wasser!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Baue einen Brunnen.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Dein Vorgänger hat es nicht mal geschafft, für ausreichend Nahrung zu sorgen! Das ist wirklich unglaublich! Schatz, das solltest du sofort ändern! Wie wär's mit ein paar Fischerhütten?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Baue 2 Fischerhütten.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Die armen Kinder... Schatz, wir können denen doch nicht nur Fische anbieten! Du solltest ein paar Bauernhöfe errichten, damit wir etwas Weizen für Mehl und Brot ernten können!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Baue 2 Bauernhöfe und produziere Weizen.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Baue eine Schmelze.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Sag mal, Schatz, hast du nicht etwas vergessen? Wolltest du dem König nicht ein paar Geschenke überreichen, damit er uns hilft? Wenn du mich nicht hättest... Wir brauchen auf jeden Fall erstmal eine Mine und eine Schmelze, sonst können wir nichts wertvolles herstellen!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Baue eine Mine.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Die ganzen Townies sind ganz schön überarbeitet! Kannst du nicht ein paar neue Wohnhäuser bauen lassen, damit sich mehr Arbeiter finden lassen?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Baue 3 Wohnhäuser.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Oh, ich freue mich so! Es geht aufwärts! Jetzt können wir auch ein bisschen mehr Steuergelder von den Townies einfordern!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Sammle 1500 Taler durch Steuern.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Sammle genügend Taler durch Steuern.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Weißt du, was noch schön wäre? Ein paar neue Kleider! Also, hauptsächlich für den König natürlich... aber dafür brauchen wir erstmal einige Schafweiden, um an Wolle zu kommen!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Baue 2 Schafweiden.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Die Bauern ernten schon fleißig Getreide! Jetzt kannst du auch eine Windmühle bauen, dann haben wir schon mal Mehl für die Brote!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Baue eine Windmühle und produziere Mehl.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Mein Schloss entspricht meinem Status nicht mehr, also habe ich beschlossen, einige große Erweiterungen an meinem Sommerschloss vorzunehmen.\n\nAls Euer König verlange ich eine Lieferung an Steinen, mein Statthalter. Ich rechne mit Eurer Zuverlässigkeit.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Liefere eine Ladung Steine an den König.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Unsere Behausungen sind durch die Hitze im Königreich stark in Mitleidenschaft gezogen worden, mein Herr. Einige Familien wünschen sich bessere Wohnbedingungen. \n\nEs wäre vorzüglich, wenn Ihr etwaige Verbesserungen in Betracht ziehen würdet, mein Herr.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Erreiche eine hohe Zufriedenheit mit dem Zustand der Gebäude.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Statthalter, Ich warte immer noch auf die Traubensaftlieferung von Euch. Das von mir veranstaltete Bankett wird in Kürze beginnen.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Liefere Traubensaft an den König.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Mein Herrscher: Im gesamten Königreich fehlt es an Mehl für die Bäckereien. Die Bauernhöfe produzieren zu wenig Getreide. \n\nLiefert mir genug Mehl und ich kann eine Monopolstellung in dieser Region erreichen.\nFür Euren Aufwand werde ich euch natürlich vorzüglich belohnen...";
"T_GAME_QUEST_SCEN4_13_NAME" = "Liefere Mehl an den Händler.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Im Dorf ist der Wunsch nach schattigen Plätzen groß, mein Herr. Wir sollten mehr Bretter produzieren, damit die Townies sich Unterstände errichten können.";
"T_GAME_QUEST_SCEN4_14_NAME" = "Produziert 35 Bretter.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Mein Herr, Ihr habt wirklich ganze Arbeit geleistet - das Dorf hat eine beträchtliche Größe erreicht!\n\nAllerdings sind die Townies immer noch sehr unglücklich. Ihr solltet versuchen, mehr Wünsche der Bewohner zu erfüllen, um die Zufriedenheit im Dorf zu steigern. Das ist natürlich nur ein Vorschlag...";
"T_GAME_QUEST_SCEN4_15_NAME" = "Erreiche eine hohe Zufriedenheit in deinem Dorf.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Hervorragend, mein Statthalter.\nIhr habt trotz der Dürre eine große Stadt am Flussbett entstehen lassen. Ebenso sind die Dorfbewohner sehr glücklich mit den Veränderungen, die Ihr vorgenommen habt.\n\nAls euer König bin ich sehr zufrieden mit Euren Leistungen im Königreich. Ihr habt wirklich gute Arbeit geleistet und werdet dafür fürstlich belohnt.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Die Dorfbewohner sind verarmt und unglücklich über die Dürre, die das Land plagt. Schaut euch den ehemals prächtigen Fluss an, an dem Euer Schloss gelegen ist! Nur noch Pfützen sind geblieben...\n\nMein Herr, der König hat uns mit der Vergrößerung unseres Dorfes beauftragt. Lasst uns mit einigen neuen Wohnhäusern beginnen.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Baue 8 neue Wohnhäuser.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Mein Herr, der König ist beeindruckt vom Ausbau des Dorfes. Jedoch verlangt er nun eine noch größere Stadt.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Erreiche eine Gesamtbevölkerung von 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Verehrter Statthalter, ich als Händler kann ihnen in ihrer brenzligen Situation eine große Hilfe sein. \n\nZwar plagt die Dürre das ganze Land, jedoch kann ich euch die benötigten Nahrungsmittel liefern, sobald ihr einen Marktplatz errichtet habt.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Sorge für eine hohe Marktplatz-Zufriedenheit.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Mein Herr, ich bitte euch... \nDas Dorf benötigt dringend mehrere Brunnen, um die Townies bei dieser Hitze weiterhin mit genug Trinkwasser zu versorgen. ";
"T_GAME_QUEST_SCEN4_3_NAME" = "Errichte 2 Brunnen.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Ich komme mit Neuigkeiten, mein Herr. Ein Dorfbewohner hat noch einige Fischbestände in den Pfützen im ausgetrockneten Flussbett entdeckt. \n\nWir sollten ein paar Fischerhütten im Flussbett bauen.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Baue 2 Fischerhütten.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Ich schlage euch einen guten Handel vor, Herr Statthalter.\n\nIhr handelt ein wenig mit mir und ich belohne euch mit regelmäßigen Nahrungslieferungen.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Erziele einen Profit von 1000 Talern am Markt.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Erneut komme ich mit einem Anliegen, Herr Statthalter. Ihr versorgt mich mit Holzkohle und ich biete euch dafür einen gut gefüllten Beutel Taler an.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Liefere Kohle an den Händler.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Mein Statthalter, an meinem Hof ist ein Mangel an gutem Traubensaft entstanden. Die Dürre plagt mein ganzes Königreich und die Traubenernte wurde durch das Wetter zerstört. \n\nErrichtet in meinem Auftrag eine Kelterei - ich werde in Kürze ein Bankett veranstalten, also enttäuscht mich nicht!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Baue eine Kelterei und produziere Traubensaft.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Mein Herr, meine Familie kann die vertrockneten Felder kaum bestellen, um genug Weizen zu ernten. Durch die Dürre reicht ein Hof einfach nicht mehr aus.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Baue einen weiteren Bauernhof und produziere genug Weizen.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Unsere Brotreserven sind sehr niedrig, mein Herr. Wir sollten versuchen, den Brotkonsum des Dorfes zu verringern, indem wir mehr Fleisch in unseren Lagerhäusern anbieten.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Produziere genug Fleisch.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Erfülle alle Aufgaben, um das Dorf trotz der Dürre zu einer Stadt auszubauen!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Nur noch eine Sache fehlt, mein Lord. Meine Männer wünschen sich mehr Traubensaft im Armeelager. \n\nWürdet ihr mir eine Lieferung an Saft schicken?";
"T_GAME_QUEST_SCEN5_10_NAME" = "Liefere 45 Traubensaft an den Ritter.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Hervorragend, Herr Statthalter!\nLord von Blankenstein hat seine Kampagne in der Region erfolgreich abgeschlossen und spricht in den höchsten Tönen von euch.\n\nWas haltet Ihr von einem abschließenden Handel, bevor auch ich weiter ziehen werde?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Erziele Profit in Höhe von 2500 Talern am Markt.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Was für ein wunderschöner Morgen, mein Statthalter! Ich habe gute Neuigkeiten für euch:\nKontakt mit einem freien Händler ist arrangiert worden.\n\nDer Händler wird in Kürze unser Dorf erreichen und verlangt als Begrüßungsgeschenk einige Bretter, um seine Marktstände zu errichten.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Stelle 30 Bretter her.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Mein Herr, einen gut gelegenen Handelsposten habt ihr hier errichtet!\nWas allerdings noch fehlt, wäre ein Wirtshaus, um weitere Reisende und Händler anzulocken.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Erreiche eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Sehr gut, Herr Statthalter. Dieses Wirtshaus wird euch in Zukunft viele Handelsaufträge bringen.\nNun lasst uns den interessanten Teil unseres Abkommens erledigen. Wir handeln einige Güter...";
"T_GAME_QUEST_SCEN5_3_NAME" = "Erziele einen Profit in Höhe von 1500 Talern am Markt.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Wärt ihr so freundlich und würdet Stoffe in euren Warenhäusern einlagern, mein Herr? Ich habe einen Handelspartner, der sehr an Stoffen interessiert ist.\n\nAußerdem habe ich einen Ritter auf meinen Reisen getroffen, der hierhin unterwegs ist. Er könnte interessante Aufgaben für euch haben.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Lagere 35 Stoffe in deinen Warenhäusern.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Mein Lord! Ich bin Kunibert von Blankenstein, Ritter des Königs. \n\nEuer Handelsposten ist gut gelegen, um mich in meinen Vorhaben zu unterstützen, die Banditen in dieser Gegend zu vertreiben.\nWürdet ihr mir Steine liefern, damit ich einige Wachposten in der Region bauen kann?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Liefere 50 Steine an den Ritter.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Herr Statthalter, meine Waffenschmieden benötigen dringend Eisen, um meine Armee mit neuen Schwertern zu versorgen.\n\nIn der Nähe eures Handelspostens gibt es einige Erzadern - würdet ihr meinem Knecht eine Lieferung mit Eisen zukommen lassen?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Liefere 65 Eisen an den Ritter.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Ich habe ein Problem, Herr Statthalter. Einige meiner Männer haben sehr verbeulte Rüstungen, seit dem letzten Kampf mit den Banditen. \n\nLagert Werkzeuge in euren Warenhäusern, damit meine Soldaten ihre Rüstungen beim nächsten Besuch in Eurem Handelsposten selbst reparieren können.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Produziere 25 Werkzeuge.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Ich komme mit guten Neuigkeiten, Herr Statthalter. Meine Kampagne gegen die Banditen ist ein großer Erfolg. Sie sind aus der Region vertrieben worden. \n\nDoch nun geht uns der Proviant zur Neige - ich benötige eine Lieferung mit Nahrung von euch.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Liefere 25 Fisch und 25 Brot an den Ritter.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Meine Truppen wollen unseren Sieg feiern, mein Statthalter. Nun, da die Banditen vertrieben wurden, langweilen sich meine Männer etwas.\n\nKönntet Ihr für etwas mehr Unterhaltung im Dorf sorgen?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Meine Truppen wollen unseren Sieg feiern, mein Statthalter. Nun da die Banditen vertrieben wurden, langweilen sich meine Männer etwas.\n\nWürdet ihr einen Turnierplatz errichten, sodass meine Männer sich etwas austoben können?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Erreiche eine hohe Zufriedenheit mit Turnierplätzen.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Errichte einen profitablen Handelsposten, indem du alle Aufträge erfüllst!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Es ist vorzüglich, mein Herr.\nIhr habt mit großem Erfolg einen Handelsposten an dieser strategischen Position errichtet.\nDer König ist begeistert und Lord Blankenstein ist äußerst zufrieden mit eurer Unterstützung gegen die Banditen in der Region.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Wir haben einen direkten Befehl vom König! Er fordert Rohstoffe, um eine Kathedrale zu bauen! Die Bauarbeiten haben bereits begonnen, wir sollten uns also beeilen, all die notwendigen Rohstoffe zu liefern.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Liefere Ressourcen für den Bau der Kathedrale.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Tausche Wolle gegen Fisch ein!";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Tausche Eisen gegen Fisch ein!";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Tausche Traubensaft gegen Fisch ein!";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Tausche Gold gegen Fisch ein!";
"T_GAME_QUEST_SCEN6_2_NAME" = "Tausche Holzplanken gegen Fisch ein!";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Sieht so aus, als gäbe es keine nahe gelegenen Seen, um zu angeln! Aber ich kann dir aus dieser Lage helfen! Baue einen Marktplatz und ich werde dir Fische im Tausch gegen ein paar Güter geben, abgemacht?";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Baue 2 weitere Minen.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Baue 3 weitere Minen.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Wir sollten unverzüglich mit dem Abbau der Erze beginnen! Öffnet genug Minenschächte, um rechtzeitig liefern zu können!";
"T_GAME_QUEST_SCEN6_3_NAME" = "Baue eine Mine.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Deine Townies arbeiten so hart wie sie können, um an all das wertvolle Erz zu gelangen! Stelle sicher, dass du sie mit genug Nahrung versorgst, um sie bei Kräften zu halten!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Baue eine Bäckerei und produziere etwas Brot.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Wir Liegen gut in der Zeit, aber wir müssen das Erz noch einschmelzen, um es verwertbar zu machen!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Baue 2 Schmelzöfen.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Das Arbeiten in den dunklen, kalten Minen, ohne anständige Bekleidung, kann ganz schön unangenehm sein! Bitte versorge deine Townies mit warmer Kleidung, sie wären dir sehr dankbar dafür!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Liefere 25 Kleidungsstücke.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Mein Herr, unsere Produktionsmengen sind gewaltig! Wir brauchen mehr Warenhäuser, um all die Ressourcen zu lagern, bevor wir sie ausliefern können!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Baue 2 Warenhäuser.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Als Erzschürfer zu arbeiten, kann ganz schön anstrengend sein! Deine Townies brauchen einen Ort, um sich nach einem anstrengenden Tag zu erholen - ein Wirtshaus bietet sich dafür perfekt an!";
"T_GAME_QUEST_SCEN6_8_NAME" = "Baue ein Wirtshaus.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Gut gemacht! Ihr habt mit dem Ausliefern aller notwendigen Ressourcen für die Kathedrale großartige Arbeit geleistet! Die Bauarbeiten werden noch einige Zeit in Anspruch nehmen.\n\nEs wird als Andenken dienen, für unseren geliebten König. Seine Taten haben ein neues Zeitalter von Frieden und Harmonie herbeigeführt. Dieses Bauwerk wird Jahrhunderte überdauern.";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Vergiss nicht: Du kannst Bäume, die dir im Weg stehen, entfernen! Benutze dazu die Schaufel und markiere die Bäume, die du entfernen möchtest.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Mein Statthalter, uns fehlen noch wichtige Zutaten für die Torte! Wären Sie so freundlich, einen Bauernhof zu errichten, damit wir unser eigenes Mehl herstellen können?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Baue einen Bauernhof.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Baue eine Windmühle.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Produziert 25 Brot.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "Das wird eine fantastische Hochzeit! Als erstes sollten wir sicherstellen, dass wir eine hervorragende Hochzeitstorte haben. Kannst du eine Bäckerei errichten, während ich mein Hochzeitskleid aussuche?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Baue eine Bäckerei.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Ich brauche einen Marktplatz, um all meine Hochzeitsgeschenke loszuwerden, die mir nicht gefallen.";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Sorge für eine hohe Marktplatz-Zufriedenheit.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Mein Herr, wir schreiten gut voran mit den Vorbereitungen! Aber wir brauchen noch mehr Werkzeuge, um das Festzelt aufzubauen.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Baue eine Werkzeugschmiede.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Produziere 20 Werkzeuge.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Ich möchte, dass die Hochzeit in einer wunderschönen Kirche stattfindet. Hast du bereits eine gebaut?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Erreiche hohe religiöse Zufriedenheit.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Baue eine Schafweide.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Baue eine Webstube.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Stelle 20 Kleidungstücke her.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Ist das zu fassen? Ich kann im ganzen Land kein anständiges Hochzeitskleid finden! Ich brauche ein Kleid, sofort! Bring mir deinen besten Schneider, um mir eins zu machen.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Baue eine Schneiderei.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Baue Dekorationen.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Erhöhe die Zufriedenheit deiner Townies!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Dieser Ort ist trostlos… Kannst du diese Stadt schöner machen? Ich möchte, dass jeder so glücklich ist wie ich!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Mich interessieren Torten und Blumen nicht, ich will ein großes Fest mit sehr viel Saft! Und ich möchte die ganze Stadt dazu einladen! Aber wir haben nicht genug Häuser, um alle Townies unterzubringen!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Baue mehr kleine Wohnhäuser.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Ich möchte ein nettes Plätzchen finden, um nach der Hochzeit mit meinen Freunden abzuhängen. In dieser Stadt fehlt ein Wirtshaus!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Sorge für eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Produziere 25 Traubensaft.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Meine Freunde werden sehr durstig sein! Hast du dich schon um den Saft gekümmert?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Baue eine Kelterei.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Es werden mehr Gäste erscheinen als erwartet. Baue ein großes Wohnhaus.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Baue ein großes Wohnhaus.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Stelle 15 Schmuckstücke her.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Ach du meine Güte, ich habe den Ring für meine Frau verloren! Ich bin so geliefert! Bitte erzähl ihr nichts davon! Gibt es in dieser Stadt einen Goldschmied, der mir einen neuen Ring zu machen kann?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Baue eine Goldschmiede.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Bevor ich heirate, möchte ich meine Verlobte auf dem Turnierplatz beeindrucken.";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Baue einen Turnierplatz.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Mein Herr, wir haben so viele Güter im Dorf, aber das Lagerhaus des Schlosses ist schon beinahe voll. Es wäre vielleicht ratsam, ein neues Lagerhaus zu errichten.";
"T_GAME_QUEST_SCEN8_10_NAME" = "Errichte ein neues Lagerhaus.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Die Männer im Dorf wären glücklicher, wenn sie nach Feierabend genüsslich einen Traubensaft-Punsch trinken könnten. Wäre es zu viel, zu fragen, ob ein Wirtshaus errichtet werden kann, Herr Statthalter?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Sorge für eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Der Schmied hat einige Kohleöfen für die Bewohner gebaut. Leider fehlt uns genug Kohle, diese Öfen ordentlich zu befeuern, mein Statthalter.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Produziere 50 Kohle.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Herr Statthalter, im Dorf gibt es viel zu wenig Feuerholz, um die Häuser zu wärmen. Wären Sie so freundlich und würden dafür sorgen, dass genug Feuerholz in den Lagerhäusern ist?";
"T_GAME_QUEST_SCEN8_1_NAME" = "Produziere 75 Feuerholz.";
"T_GAME_QUEST_SCEN8_2_DESC" = "Ein Schneesturm und hier bricht alles zusammen, mein Herr. Wir benötigen dringend eine Schreinerei, die sich um die baufälligen Wohnhäuser kümmert.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Baue eine Schreinerei.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Dieser besonders harte Winter könnte ein göttliches Zeichen sein, dass wir Buße tun sollen, mein Herr. Vielleicht sollten wir eine Kirche bauen, um diesen Winter zu überstehen.";
"T_GAME_QUEST_SCEN8_3_NAME" = "Sorge für eine hohe Religions-Zufriedenheit.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Die Townies sind ruhelos, mein Statthalter, denn in den Wohnhäusern ist es bitterkalt. Ich denke, es ist notwendig, mehr Schafwolle auf Lager zu haben, damit die Bewohner ihre Wohnhäuser besser isolieren können.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Produziere 55 Wolle.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Der Statthalter der Nachbarprovinz hat eine Bitte per Brieftaube geschickt: Er benötigt dringend genug warme Kleidung für seine Bewohner. ";
"T_GAME_QUEST_SCEN8_5_NAME" = "Liefere eine Wagenladung warme Kleidungsstücke an die Nachbarprovinz.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Unsere Bauernhöfe werden in diesem Winter keinen Weizen produzieren können, mein Herr. Wie wäre es, einige Townies in die Wälder hinaus zu schicken, damit sie Rehwild jagen gehen?";
"T_GAME_QUEST_SCEN8_6_NAME" = "Baue einige Jagdhütten.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Mein treuer Diener: Im ganzen Land ist der Winter besonders hart dieses Jahr. Das Steuereinkommen ist über die letzten Monate drastisch gesunken.\n\nAus diesem Grunde befehle ich den Bau einer Schatzkammer im Dorf und eine Wagenladung Taler als Tribut von euch.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Errichte eine Schatzkammer und liefere dem König eine Wagenladung Taler als Tribut.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Nun, da eine Schreinerei im Dorf ist, sollte es kein Problem mehr sein, die Wohnhäuser wieder winterfest zu machen. Die Townies werden dafür sehr dankbar sein.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Sorge dafür, dass alle Wohnhäuser in gutem Zustand sind.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Wildbret als Nahrungsmittel ist ein guter Ersatz für Brot im Winter. Es wäre ratsam, genug Fleisch auf Lager zu haben.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Produziere 50 Fleischwaren.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Mein Herr, die Townies sind nicht sehr glücklich mit der Situation im Dorf. \n\nDer Winter ist dieses Jahr viel schlimmer als erwartet. Wir müssen schnell handeln, damit das Dorf dem Winter trotzen kann.";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Bringe dein Dorf durch den Winter.";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Mein Herr, die Townies sind mit den letzten Entwicklungen im Dorf sehr glücklich. \n\nWir haben nun genug Vorräte für den Rest des Winters und haben nebenbei sogar der Nachbarprovinz geholfen. Der Winter kann uns jetzt nichts mehr anhaben.";
"T_GAME_QUEST_SCEN9_10_DESC" = "Eure Exzellenz, ich habe gehört, ihr habt Probleme mit Aufständischen in eurer Provinz? Ich könnte einen Suchtrupp in die Wälder leiten, aber meine Söldner wollen im Voraus bezahlt werden.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Bezahle die Söldner.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Ich komme mit einem weiteren Anliegen, mein Statthalter. Das neue Flaggschiff soll goldene Verzierungen am Bug haben, jedoch fehlt mir dafür noch Gold.\n\nDie Zeit drängt, also verlange ich schnellstmöglich einen Tribut an Gold. Enttäuscht mich nicht!";
"T_GAME_QUEST_SCEN9_11_NAME" = "Schicke dem König Golderz, bevor die Zeit vorbei ist.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Mein treuer Diener: Die Flotte benötigt noch Segeltücher. Sehr viel davon! Schickt Stoffe an meine Werft, damit diese genügend Segeltücher produzieren kann.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Schicke dem König eine Lieferung Stoffe, um Segeltücher herzustellen.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Meine Männer und ich sind auf einer Fährte. Wir haben Spuren der Banditen im Wald entdeckt. Aber bevor wir ihnen weiter folgen, benötigen wir mehr Proviant.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Liefere Proviant an die Söldner.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Statthalter, ich habe eine ganze Lieferung Bretter an die Banditen in Eurer Provinz verloren! Das kann nicht so weitergehen! Schickt mir eine Lieferung an Brettern, damit meine Werft weiter arbeiten kann.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Schicke dem König Bretter für die Flotte.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Mein Herr, der Steuereintreiber hat eine Verbindung zwischen dem Saboteur und den Banditen im Wald aufgedeckt. Aber nun fürchtet er um sein Leben.\n\nEr verrät uns die Identität erst, wenn er von seinem Beruf entbunden wurde und neue Kleidung hat, um unterzutauchen.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Ziehe den Steuereintreiber ab, und verschaffe ihm neue Kleidung, damit er davonkommen kann.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Bevor er die Region verließ, hat der Steuereintreiber die Identität des Saboteurs preisgegeben.\n\nEs ist der Söldner mit seinen Männern! Es sind Betrüger, die von Dorf zu Dorf ziehen, Unruhe stiften und dann ihre „Hilfe“ anbieten.";
"T_GAME_QUEST_SCEN9_17_DESC" = "Ich habe schlechte Neuigkeiten, mein Herr. Jemand ist ins Lagerhaus eingebrochen und hat all unser Fleisch gestohlen.\n\nWir sollten Fackeln im Dorf errichten, damit Diebe bei Nacht schneller entdeckt werden können.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Errichte einige Fackeln, um Diebstähle zu verhindern.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Eure Exzellenz: Da wir momentan nicht von reisenden Händlern besucht werden, sollten wir vorsorgen und genug Lagerplatz für all unsere Güter haben. \nZusätzlich sollten wir unnötige Produktionen pausieren, damit unser Lagerhaus nicht zu voll wird.\n\nEs wäre eine gute Idee, ein weiteres Lagerhaus zu bauen, mein Herr.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Baue ein weiteres Lagerhaus.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Aus Furcht vor dem Saboteur kommen die Townies nicht mehr dazu, notwendige Reparaturen an ihren Häusern zu verrichten.\n\nWie wäre es, wenn wir eine Schreinerei bauen ließen, damit die Townies etwas Unterstützung bekommen?";
"T_GAME_QUEST_SCEN9_19_NAME" = "Baue eine Schreinerei.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Guten Morgen, mein Herr. Was für ein schöner Wintermorgen es ist. Wir haben in den kommenden Monaten viel zu tun. \n\nLasst uns direkt mit dem Bau einiger Forsthütten beginnen, nicht wahr?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Baue mehrere Forsthütten.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Ich komme mit einem Anliegen zu handeln auf Euch zu, Herr Statthalter.\n\nEs herrscht ein großer Bedarf an Werkzeugen im ganzen Land. Ich würde Euch einen guten Preis zahlen und sogar wieder ins Dorf kommen.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Liefere eine Wagenladung Werkzeuge an den Händler.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Ich bringe Neuigkeiten, mein Lord: Einige Söldner sind im Dorf angekommen und haben sich direkt darüber beschwert, dass wir gar kein Wirtshaus haben. \n\nEs wäre keine gute Idee, die Söldner im Dorf nicht glücklich zu stimmen.";
"T_GAME_QUEST_SCEN9_2_NAME" = "Erreiche eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Sehr gut, mein Statthalter. Wie ich vernommen habe geht es sehr gut mit eurer Holzkolonie voran.\n\nWärt ihr so freundlich und würdet die erste Lieferung an Holz alsbald zu meinem Hafen schicken?";
"T_GAME_QUEST_SCEN9_3_NAME" = "Sende dem König einen Tribut an Holz.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Mein Herr, es gibt Gerüchte über Unruhen im Dorf. Könnte es sein, dass einige Townies gegen die Krone handeln wollen?\n\nWenn wir nicht schleunigst etwas dagegen unternehmen, haben wir eine Rebellion in unserem Dorf. Ihr solltet die Townies schnellstmöglich zufriedenstellen!";
"T_GAME_QUEST_SCEN9_4_NAME" = "Halte die Zufriedenheit für die nächsten paar Minuten über 100%.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Es ist ungeheuerlich, mein Herr. Das Wirtshaus ist zerstört worden - zusätzlich kursieren Gerüchte über einen Saboteur im Dorf!\n\nWenn wir nicht schnellstmöglich Kontrolle ins Dorf bringen, laufen die Dinge aus dem Ruder, mein Lord. Ein Galgen und einige Pranger sollten ein Zeichen setzen.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Baue einen Galgen und 2 Pranger im Dorf.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Mein Lord, es wäre Weise, die Moral im Dorf weiter anzuheben.\n\nDen Townies Güte zu zeigen ist der richtige Weg. Ihr solltet einige Bedürfnisse der Townies bedienen. Zum Beispiel eine Kirche bauen oder das Dorf mit Blumenbeeten verschönern. ";
"T_GAME_QUEST_SCEN9_6_NAME" = "Baue einige Blumenbeete und eine Kirche.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Statthalter, ich muss ihnen leider mitteilen, dass ich in nächster Zeit nicht mehr zum Handeln ins Dorf kommen kann. \nZwielichtige Personen halten sich im Wald auf - die Gefahr für einen Händler ist zu groß.\n\nAber ich bringe Neuigkeiten vom König. Er verlangt den Bau einiger Sägewerke.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Baue 2 Sägewerke.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Mein Lord, ich habe eine Idee: Wir sollten eine Schatzkammer bauen. Auf diese Weise können wir den Steuereintreiber als Ermittler einsetzen. Er kann versuchen, den Saboteur unter den Townies zu finden.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Baue eine Schatzkammer und warte bis der Steuereintreiber die Häuser untersucht.";
"T_GAME_QUEST_SCEN9_9_DESC" = "Das Sägewerk ist sabotiert worden, mein Herr. \nHinzu kommt, dass der Steuereintreiber bisher noch keine Hinweise auf den Saboteur im Dorf gefunden hat.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Ihr habt die Unruhe nicht rechtzeitig verhindert!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Ihr seid gescheitert! Wegen eurer Inkompetenz habe ich den Goldauftrag an ein anderes Dorf vergeben.";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Statthalter, in Kürze werde ich mit dem Bau einer neuen Flotte beginnen. \n\nEuer Dorf ist ideal gelegen, um zum Zentrum für Holzproduktion zu werden und mich in meinem Unterfangen zu unterstützen.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Der Söldner und seine Männer sind aus der Region geflohen. Meine Männer werden sie jedoch mit Nachdruck verfolgen. \n\nIch danke euch für eure Unterstützung in meinem Vorhaben, eine Flotte zu bauen. In Kürze wird mein neues Flaggschiff vom Stapel laufen und Ihr seid herzlich eingeladen, bei der Jungfernfahrt teilzunehmen.\n\nEinen guten Tag wünsche ich...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Unterstütze den König in seinem Vorhaben.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Sehr gut! Ihr habt die Unruhe im Dorf rechtzeitig verhindert.";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Sehr gut! Ihr habt die Waren rechtzeitig abgeliefert.";
"T_GAME_QUEST_SCEN_10_DESC" = "Unsere Ritterleute sollen sich ruhig in den örtlichen Wirtshäusern nach dem Turnier austoben können! Doch ich befürchte, die bestehenden Gebäude und Saftmengen werden nicht ausreichen! Kümmert Euch darum!";
"T_GAME_QUEST_SCEN_10_NAME" = "Erreiche eine hohe Wirtshaus-Zufriedenheit.";
"T_GAME_QUEST_SCEN_11_DESC" = "Hervorragend, mein Statthalter! Die Stadt ist fast bereit, doch ich und meine Töchter sind es nicht! Ich benötige die prächtigsten Gewänder, die Eure Schneider herstellen können!";
"T_GAME_QUEST_SCEN_11_NAME" = "Zahle einen Tribut von 35 Kleidungsstücken.";
"T_GAME_QUEST_SCEN_12_DESC" = "Es ist fast soweit, doch ich möchte keine weinenden Gesichter sehen! Sorgt dafür, dass die Dorfbewohner glücklich sind!";
"T_GAME_QUEST_SCEN_12_NAME" = "Sorge für eine hohe Zufriedenheit.";
"T_GAME_QUEST_SCEN_1_DESC" = "Seid gegrüßt, mein Statthalter! Wie Ihr wisst, plane ich, das größte Ritterturnier der Region zu veranstalten! Ich erwarte, dass Ihr dafür nicht weniger als 3 Turnierplätze errichtet! Enttäuscht mich nicht!";
"T_GAME_QUEST_SCEN_1_NAME" = "Baue 3 Turnierplätze.";
"T_GAME_QUEST_SCEN_2_DESC" = "Die Gäste unseres Turniers werden hungrig sein! Ich will, dass ihr sofort mit der Produktion von Brot beginnt und es meinem Hof als königliches Tribut übergebt!";
"T_GAME_QUEST_SCEN_2_NAME" = "Liefere einen Tribut von 25 Broten.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Baue eine Windmühle und produziere Mehl.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Baue 2 Bäckereien und produziere Brot.";
"T_GAME_QUEST_SCEN_3_DESC" = "Mein Herr, wir sollten den König besser nicht warten lassen! Wir brauchen Getreide und Mehl, um mit der Brotproduktion zu beginnen!";
"T_GAME_QUEST_SCEN_3_NAME" = "Baue einen Bauernhof und produziere Weizen.";
"T_GAME_QUEST_SCEN_4_DESC" = "Sehr gut, mein Statthalter! Aber Brot allein wird unsere Gäste nicht zufrieden stellen! Ich verlange frischen Fisch als weiteren Tribut an Euren König!";
"T_GAME_QUEST_SCEN_4_NAME" = "Liefere einen Tribut von 25 Fischen.";
"T_GAME_QUEST_SCEN_5_DESC" = "Ich will, dass unser Turnier unvergesslich wird! Unsere Ritter sollen goldene Lanzen tragen und die Turnierplätze funkeln und glänzen! Seid so nett und treibt ein paar Steuern für mich ein!";
"T_GAME_QUEST_SCEN_5_NAME" = "Zahle einen Tribut von 1000 Talern.";
"T_GAME_QUEST_SCEN_6_DESC" = "Unsere Gäste erfreuen sich sicherlich am wohltuenden Geschmack unserer selbst gepressten Traubensäfte! Seht zu, dass Ihr eine Kelterei errichtet! Die Traubenabfälle könnt Ihr dann auch gerne den Wirtshäusern spenden!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Unsere Gäste erfreuen sich sicherlich am wohltuenden Geschmack unserer selbst gepressten Traubensäfte!";
"T_GAME_QUEST_SCEN_6_NAME" = "Baue eine Kelterei und produziere Traubensaft.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Baue eine Webstube und produziere Stoffe.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Baue eine Schneiderei und produziere Kleidung.";
"T_GAME_QUEST_SCEN_7_DESC" = "Diese alten und farblosen Wappenröcke unserer Ritter missfallen mir, mein Statthalter! Geht und besorgt ein paar neue! Errichtet Weiden, heuert einen Weber an und baut eine Schneiderei, wenn Ihr mir weiter dienen wollt!";
"T_GAME_QUEST_SCEN_7_NAME" = "Baue 2 Schafweiden.";
"T_GAME_QUEST_SCEN_8_DESC" = "Wir sollten mehr Handel betreiben, mein Herr. Dadurch haben wir mehr Taler für eventuelle Ausgaben zur Verfügung.";
"T_GAME_QUEST_SCEN_8_NAME" = "Erziele 500 Taler Profit durch Handel.";
"T_GAME_QUEST_SCEN_9_DESC" = "Ich sehe, die Arbeiten gehen voran! Aber es ist Euer Dorf, das mir noch ein Dorn im Auge ist! Ich will Springbrunnen und weißes Gemäuer, immergrüne Bäume und luxuriöse Statuen sehen! Seht zu, dass Ihr für mehr Dekorationen sorgt! ";
"T_GAME_QUEST_SCEN_9_NAME" = "Erhöhe die Zufriedenheit mit Dekorationen.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Wir sollten zunächst einen Townie der Forsthütte zuweisen.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Weise einen Arbeiter der Forsthütte zu.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Die erste Aufgabe besteht darin, einen Marktplatz zu errichten.\n\nDazu benötigen wir verschiedene Ressourcen, die wir nach und nach sammeln müssen.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Errichte einen Marktplatz.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Mein Herr, ich empfehle Euch, einen Townie dem Sägewerk zuzuweisen, der die benötigten Bretter herstellen kann.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Weise dem Sägewerk einen Arbeiter zu.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Mein Herr, für den Bau des Marktplatzes benötigen wir Steine und keine Erze.\nWir sollten den Townie zum Steine sammeln schicken.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Sobald genügend Bretter und Holz vorhanden sind, sollten wir einen Townie dem Bergwerk zuweisen.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Sehr gut, nun müssen wir nur noch den Bau des Marktplatzes abschließen.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Weise einen Arbeiter dem Bergwerk zu.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Als zweite Aufgabe soll ein Wirtshaus errichtet werden.\n\nWir sollten den Bau sofort beginnen!";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Baue ein Wirtshaus.";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Gute Neuigkeiten mein Herr. Weitere Townies sind eingetroffen. Bauen wir ihnen ein Haus.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Baue ein Wohnhaus.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Für den Bau eines Wirtshauses benötigen wir Werkzeuge. Ich empfehle zunächst eine Köhlerei zu bauen.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Baue eine Köhlerei.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Ich empfehle nun, die Schmelze zu errichten und schon einmal etwas Eisen zu schmelzen.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Baue eine Schmelze.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Mein Herr, es wird Zeit, eine Schmiede zu errichten, um die benötigten Werkzeuge herstellen zu können.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Baue eine Werkzeugschmiede.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Mein Herr, unsere Nahrungsvorräte gehen zu neige. Ein Townie sollte sich um Fische und Fleisch kümmern, damit wir weiterhin produktiv arbeiten können.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Produziere Nahrung.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Herr Statthalter, wie ich sehe, benötigt Ihr ein paar Münzen für den Bau.\nMit ein paar Eisenerzen kommen wir sicherlich ins Geschäft.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Tausche mit dem Händler.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Wieder knapp bei Kasse? Kein Problem, tauscht ein paar Tierhäute mit mir.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Herr Statthalter, ich bräuchte ein paar Golderze. Habt Ihr welche zum Tausch?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Mein Herr, ich fühle mich nicht so wohl. Ein Arzt sollte mich untersuchen.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Heile die kranken Townies.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Feuer! Ein Townie sollte sich gleich um das Löschen kümmern.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Lösche das Feuer.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Selbst hier lassen uns die Banditen nicht in Ruhe. Mein Herr, wir sollten Townies als Wachen einstellen, bis die Banditen vertrieben wurden.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Verteidige die Stadt gegen Banditen.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Mein Herr, können wir vielleicht eine kleine Brotzeit einlegen?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Stelle etwas Brot her.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Mein Lord, wir haben für die Aufgabe nur ein paar Townies zur Verfügung. Wir sollten sie zuweisen und entfernen, je nachdem, wie wir sie benötigen.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Meinen Glückwunsch. Ihr habt diese Herausforderung gemeistert!";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Setze die Townies geschickt ein, um alle Ziele zu erreichen.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Seht mein Herr, dort drüben auf der Halbinsel wachsen die Bäume bereits wieder. \n\nIch empfehle, dort einige Forsthütten zu bauen, um leichter an Holz zu gelangen.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Mein Herr, die Forsthütten sind alle heruntergekommen und verlassen!\n\nAlle Wälder in der Gegend wurden abgeholzt, mein Herr! Die Forsthütten haben keinen Nutzen mehr.\nIch schlage vor, die nicht mehr benötigten Gebäude abzureißen. So können wir das Holz anderweitig verwenden.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Reiße die Forsthütten ab.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Mein Herr, ich empfehle Euch, sich etwas bei den Townies umzuhören: Vielleicht hat der ein oder andere noch etwas Holz?";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Der König wartet bereits auf die erste Lieferung Bretter.\n\nIhr könntet einen Townie zum Sägewerk beordern, damit wir Bretter herstellen können. Jedoch rate ich Euch, immer ein Auge auf den Holzvorrat zu werfen.";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Setze Townies im Sägewerk ein.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Wie kommt Ihr zurecht, Statthalter? Ich erwarte insgesamt drei Bretter Lieferungen.\n\nDie erste solltet Ihr bald bereitstellen. Enttäuscht mich nicht!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Beliefere den König.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Mein Herr, der König war sehr über die erste Lieferung erfreut.\nWir sollten die zweite Lieferung alsbald bereitstellen.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Es fehlt nur noch eine letzte Lieferung, dann kann die königliche Flotte eine beachtliche Größe erreichen.\n\nWir sollten gleich ein paar Bretter fertigstellen.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Ihr wundert Euch sicherlich, wieso Euer König noch keine Lieferung erhalten hat. Nun, ich denke, das kann ich erklären.\n\nMachen wir es kurz: Ihr zahlt mir einen kleinen Tribut und die Holzlieferung sollte Euren König ohne weitere Zwischenfälle erreichen.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Bezahle das Lösegeld.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Für die königliche Flotte werden sehr viele Bretter benötigt. Leider bleiben die Lieferungen seit einiger Zeit aus.\n\nMein Statthalter, findet die Ursache des Problems und sorgt dafür, dass die Holzlieferungen wieder ankommen.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Gute Arbeit, mein Statthalter. Ich wusste, auf Euch ist Verlass.\n\nDank Eurer edlen Taten wird die neue Flotte bald fertiggestellt werden.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Beende den Holz Engpass und liefere ausreichend Bretter an den König.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Mein Herr, ich empfehle Euch, das Holz mit Bedacht einzusetzen.\n\nWenn wir einen Marktplatz errichten, könnten wir sicherlich bei Händlern Holz erstehen.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "So, Ihr braucht also Holz? Ich denke, da lässt sich etwas machen. Eine Fuhre Holz habe ich bereits da. \n\nKommt und kauft so viel Ihr benötigt.";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Kaufe Holz beim Händler.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Herr Statthalter, Ihr werdet regelmäßige Holzlieferungen benötigen.\n\nWenn Ihr eine Händlergilde errichten würdet, könntet ihr Handelsaufträge aufgeben.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Baue eine Händlergilde.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Ihr könnt in der Händlergilde Handelsaufträge für Einkäufe als auch für den Verkauf von Waren festlegen.\n\nGebt gleich einen Kaufauftrag für Holz auf, mein Herr.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Hervorragend! Solange Ihr bezahlen könnt, werde ich alle Handelsaufträge erfüllen.\n\nHandelsaufträge bleiben bestehen, bis ihr sie wieder abbrecht.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Stelle einen Handelsauftrag für das Kaufen von Holz ein.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "In der Stadt ist ein Feuer ausgebrochen! Wir brauchen Feuerwachtürme, um den Brand zu löschen und das Risiko eines erneuten Brandes zu minimieren.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Erreiche eine hohe Feuerwachturm Abdeckung von 80%.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Banditen! Sie versuchen unsere Gebäude zu zerstören.\nWir brauchen mehr Soldaten in der Stadt, um die Diebe zu vertreiben. Außerdem sollten wir genügend Wachtürme positionieren.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Baue ausreichend Wachtürme und sichere die Stadt mit Soldaten.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Schon wieder ist eine Krankheit ausgebrochen. Bei einer so großen Stadt werden wir einen weiteren Heilmedikus benötigen.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Mein Herr, in der Stadt ist eine Krankheit ausgebrochen. Ein Heilmedikus kann die kranken Townies heilen, bevor noch mehr Townies angesteckt werden.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Errichte einen Heilmedikus und bekämpfe die Krankheit.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Mein Herr, nicht alle Townies können zur Kirche, da sie stets voll ist.\n\nWir werden weitere Kirchen oder eine große Kirche benötigen, damit alle Zufrieden sind.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Mein Herr, im Wirtshaus müssen die Townies zu lange auf ihre Getränke warten. Wir brauchen mehr Wirtshäuser und eine bessere Versorgung von Getränken!";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Es gibt in dieser Stadt kaum Unterhaltung. Wir sollten einen Turnierplatz errichten.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Die Townies sind zufrieden. Das einzige, was ihnen jetzt noch fehlt, sind Luxusgüter.\n\nWir können sie mit Kleidung oder Schmuck versorgen.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Einige Townies beschweren sich, dass es ein zu großes Gedränge auf dem Marktplatz gibt.\n\nWir sollten einen weiteren Marktplatz bauen oder den bestehenden ausbauen - ansonsten werden die unglücklichen Townies die Stadt wieder verlassen.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Ihr habt mich sehr enttäuscht, mein Statthalter. Leider konntet Ihr nicht alle meine Euch aufgetragenen Aufgaben erfüllen.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Hervorragend mein Statthalter. Ihr habt alle Aufgaben erfüllt - ohne, dass ein einziger Townie die Stadt verlassen musste.\n\nIch werde Eure Belohnung verdoppeln!";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Statthalter, leider haben einige Townies die Stadt verlassen. Ich habe mehr von Euch erwartet.\n\nDennoch habt ihr alle auferlegten Aufgaben ausreichend erfüllt und Ihr sollt belohnt werden.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Mein Herr, wir müssen neue Townies ansiedeln, oder der König wird höchst unerfreut sein.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Oh nein, mein Herr. Es haben schon viele Townies die Stadt verlassen. Es sollten nicht noch mehr wegziehen.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Erhöhe deine Bevölkerung.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Mein Herr, einige Townies haben die Stadt bereits verlassen. Wir müssen aufpassen, dass nicht noch mehr wegziehen.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Mein Statthalter, in dieser kleinen Stadt haben sich sehr viele Townies niedergelassen.\n\nErfüllt all ihre Bedürfnisse und sorgt dafür, dass kein Townie die Stadt verlässt.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Erhöhe deine Bevölkerung, bevor die Zeit abläuft.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Erfülle alle Aufgaben bis zur Ankunft des Königs und lasse die Bevölkerung nicht unter 150 sinken.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Die Träger in dieser Stadt sind ziemlich überfordert, mein Herr. Wir sollten ein weiteres Lagerhaus errichten und weitere Träger zuweisen.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Errichte ein neues Lagerhaus und weise dem Schloss mehr Träger zu.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Seit so viele Townies in der Stadt sind, gehen die Nahrungsvorräte zu neige. Eine weitere Fischerhütte sollte helfen.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Mein Herr, die kleine Bäckerei kommt mit dem Brotbacken nicht nach. Durch den Ausbau der Bäckerei können wir einen weiteren Bäcker beschäftigen.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Baue eine Bäckerei auf Stufe 2 aus und weise einen weiteren Bäcker zu.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Der Wasserbedarf hat sich enorm erhöht. Mit genügend Brunnen kann sich jeder Townie mit Trinkwasser versorgen.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Baue mehrere Brunnen in der Stadt.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Mein Herr, wir sollten das Nahrungsangebot erweitern. Eine Jagdhütte oder eine Metzgerei ist genau das richtige dafür.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Errichte eine Jagdhütte oder eine Metzgerei.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Hervorragend, mein Herr, wir haben eine gute Versorgung aufgebaut. Dennoch sollten wir weiterhin die Bedürfnisse der Townies im Auge behalten.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Mein Herr, wir sollten zunächst für Baumaterial sorgen. Die Forsthütte auf der anderen Flussseite sollte besetzt werden.\n\nBauen wir eine Pflasterstraße über den Fluss, dann kann ein Townie seine Arbeit aufnehmen.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Baue eine Pflasterstraße über den Fluss und besetze die Forsthütte.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Bauen Sie eine Straße über den Fluss und weisen Sie einen Townie der Försterhütte zu.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Es war ein Fehler, hierher zu kommen. Ich werde die Stadt verlassen.\n\nHerr Statthalter, Ihr solltet Euch besser um unsere Bedürfnisse kümmern, sonst verlassen sicher noch mehr Townies die Stadt.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Nein, danke. ";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Das ist eine gute Idee.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Ich dachte, Ihr hättet eine progressive Denkweise... Nun, dann bleib in Eurer Mittelmäßigkeit.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, es nimmt langsam Gestalt an. Wir müssen unsere Bemühungen fortsetzen und den Rest der Produktion aufbauen.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Wir regieren den Markt für Haustextilien und Haute Couture! Wir werden ein Vermögen verdienen!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Nachdem der Rohstoff nun verfügbar ist, werden entsprechende Gebäude benötigt. Ein Weber und ein Schneider werden die Arbeit erledigen!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Dank Eurer Entscheidung werden große Veränderungen in Eurer Stadt stattfinden. Aber nichts wird möglich sein ohne.... Schafe und einen Bauernhof in gutem Zustand.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Eure Majestät, ich bin gerade aus der nahegelegenen Stadt zurückgekehrt. Sie haben edle Stoffe mit entzückenden Stickereien. Wir sollten uns davon inspirieren lassen und auch erstklassige Kleidung herstellen.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Seidenblumen";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Die Pollensaison ist wieder da. Die Bewohner niesen ständig. Wie wäre es mit einem Nieswettbewerb?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Jeder von ihnen konzentriert sich und führt sein mächtigstes Niesen vor, wenn er an der Reihe ist. Ihr müsst Euch entscheiden, welches Euer Favorit ist, damit er oder sie zum Gewinner gewählt werden kann!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "HATSCHI!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "AHA-HAAAATSCHI!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "HOOOAAAAAPFFFFFF!!!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "Und hier haben wir unseren Gewinner! Das erfolgreichste Niesen! Herzlichen Glückwunsch! Bemerkenswert!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Der Townie stolziert mit seiner Belohnung davon. Dieser Wettbewerb hat Euch nicht viel gebracht, aber vielleicht wird Eure Stadt berühmt, weil sie den ersten Nieswettbewerb in der Geschichte gestartet hat!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Auf keinen Fall.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Ihr könnt die Menschenmenge am Platz schon von Eurem Schloss aus hören. Ihr hört auch Niesen. Der Wettbewerb wird sicher ein großer Spaß!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Zahlreiche Townies warten in Schlangen und halten ihre Nieser zurück, um ihre ganze Kraft freizusetzen, wenn sie vor der Jury stehen, welche sich aus Euch und Eurem Berater zusammensetzt.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Ihr beurteilt einen Townie nach dem anderen. Ihr habt drei Namen aufgeschrieben. Ihr gebt die Liste an Euren Berater weiter, der sie in die Mitte des Dorfplatzes zum Finale des Nieswettbewerbs bringt!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Ihr beschließt, die Nachricht in der Stadt zu verbreiten, dass ein Wettbewerb auf dem Dorfplatz organisiert wird. Der Townie, der als der Beste eingestuft wird, erhält eine Belohnung!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Mylord, während wir darauf warten, dass sich die Townies auf dem Platz versammeln, sollten wir die Feierlichkeiten vorbereiten! Beginnen wir mit ein wenig Dekoration.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Dekoriert die Stadt.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Das macht unsere Stadt viel attraktiver.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Wir sollten auch unsere Vorräte prüfen.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Perfekt. Wir sind hervorragend gewappnet für unsere Festlichkeiten.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "Der Nieswettbewerb";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Auf geht's!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Ihr habt Recht. Lasst uns Statuen errichten.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "Nein… ich möchte keine Statuen in meiner Stadt.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Bravo, Sir! Diese Skulpturen geben der Stadt ein gewisses Etwas.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ah, Sir. Eines Tages werdet Ihr Euch über solche Details kümmern.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Mylord, unserer Stadt fehlt es an Statuen. Wie wäre es, wenn wir uns ein paar beschaffen würden? Darüber hinaus wird angenommen, dass Statuen die Bewohner beschützen.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Steinharte Engel";
"T_GAME_QUEST_SUCCESS" = "Aufgabe abgeschlossen!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "Das ist eine ehrenhafte Absicht. Lasst es ihn tun.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Was für ein seltsamer Mensch.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Eure Majestät, wir können nicht zulassen, dass der Bewohner das tut. Lasst uns ein Gauklerlager errichten und diesen Irren die Zügel in die Hand geben.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Ausgezeichnet! Die Townies scheinen sehr erfreut vom Ergebnis. ";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Ihr beobachtet die Stadt aus der Ferne.\n\nDer Tränenfänger jagt immer noch die Townies. Immer mehr Menschen weigern sich bereits, ihr Zuhause zu verlassen.\n\nIhr bewegt Euch langsam vom Fenster weg, so dass Ihr nicht mehr Zeuge des Schadens werdet, den Ihr durch Eure Entscheidung verursacht habt.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Vielleicht hättet Ihr etwas tun sollen... Dieser seltsame Townie terrorisiert die Bewohner und die Moral nimmt nur ab. Hoffen wir, dass es nicht anhält!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Gouverneur, mir wurde heute Morgen gesagt, dass es sich einer der Bewohner zur Aufgabe gemacht habe, alle glücklich zu machen. Er begann, die Bewohner zu verfolgen und sie zum Lachen zu zwingen...";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "Der Tränenfänger";
"T_GAME_QUEST_THE_BATH_B_001" = "Das war knapp.";
"T_GAME_QUEST_THE_BATH_B_002" = "Lassen Sie uns nun verkünden, dass das Baden Pflicht ist. Das wird die Krankheit reduzieren!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Keine Pflichtbäder.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "Ihr werdet nie von Euren Fehlern lernen!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Sire, ein weiterer Krankheitsausbruch wurde berichtet. Dieses Mal viel schlimmer als der letzte.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Dieses Mal, Sire - ob Ihr es wollt oder nicht - werde ich Pflichtbäder einführen!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Euer Berater hat viele Townies vor der Krankheit bewahrt. Er hat es sogar geschafft, in die Geschichtsbücher einzugehen. Dennoch wart Ihr es, der die Bäder abgelehnt hat. Selbst noch Jahre später werdet Ihr von Kindern geliebt weil „Baden einfach furchtbar ist“.";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Pflichtbäder!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Das ist weise, Sire. Jetzt werden Townies seltener krank.";
"T_GAME_QUEST_THE_BATH_DESC" = "Vor ein paar Tagen habt Ihr öffentliche Badehäuser in der Stadt errichtet. Zwar war das eine brilliante Idee, jedoch haben die Townies Angst vor Wasser und trauen sich nicht waschen.";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Beheizt das Wasser.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Lasst uns genug Holz sammeln, um das Wasser für die Bäder zu beheizen.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Perfekt. Das Wasser hat eine angenehme Temperatur und wir konnten einige Townies dazu überreden, sich zu waschen.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Leider waren Eure Bemühungen vergebens und die Krankheit hat sich trotzdem in der Stadt verbreitet.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Lasst sie in Frieden.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Wie Ihr wünscht. Kommt bloß nicht heulend angerannt, wenn es in der Stadt jemals zu Krankheitsausbrüchen kommt!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Einige Monate lang haben sich nur wenige Townies gewaschen. Und wenn einer der Townies krank wurde, hat er drei andere angesteckt! Manche sind sogar überzeugt, dass die Bäder der Ursprung der Krankheit seien.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Heilt die Townies.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Badezeit";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Bestechung.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Ihr seid zu den Ordensleuten gegangen und habt gefragt, ob sie für ein paar Münzen, den Townies in ihrer Predigt erzählen, dass Baden schön macht.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Gebt ihnen das nötige Geld.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Alles was noch zu tun ist, ist die Geldsumme an die Ordensleute zu zahlen";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Vielen Dank, Gouverneur. Ich werde Eure Nachricht verkünden.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Es scheint, dass sich Eure Bemühungen gelohnt haben. Die Krankheit ist weniger virulent und wird das für einige Zeit bleiben!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Zwingt sie!";
"T_GAME_QUEST_THE_BATH_YES_002" = "Und los geht’s! Mögen unsere Stadtschreierdie gute Nachricht verkünden!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Nicht alle Bewohner sind mit der Idee von regelmäßiger Körperhygiene glücklich. Manche sagen sogar, dass sie sich nach dem Baden schwächer fühlen.\n\nAndere sagen, dass das Wasser zu kalt ist und weigern sich zu baden.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Verhört den Magier.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Als Ihr ihn gerade befragen wolltet, begann ein dicker Rauch die ganze Domaine zu verschlingen, man konnte die eigene Hand vor Augen nicht mehr sehen.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Jetzt steht Ihr vor einem Dilemma: die notwendigen Ressourcen bereitzustellen oder, auf Teufel komm raus, die Situation verschlechtern zu lassen. Ihr solltet Euch beeilen und schnell handeln... wer weiß, wozu die beiden Magier auf freiem Fuß fähig sind.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Mylord! Wir sind gescheitert. Die Magier konnten mit den Ressourcen fliehen.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Gebt ihm die Ressourcen.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Lasst uns versuchen, diesem blöden Magier alle Ressourcen bereitzustellen!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Wir konnten alle geforderten Ressourcen produzieren. Jetzt müssen wir nur noch die Ware an den angegebenen Ort liefern.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Auf dem Rücken Eures Beraters habt Ihr eine Falle für die Magier angebracht. Sobald sie die Ware abholen, werden sie sofort in einem Netz gefangen! Hoffentlich ist Eure geniale Idee effektiv.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Mylord! Wir konnten den zweiten Magier schnappen!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Ihr habt zwei Wachen in der Nähe der Ressourcen stationiert. Die anderen beiden Magier tauchen auf und nähern sich langsam, um die Ressourcen abzuholen. Wenn sie auf halbem Weg sind, stellen Eure Wachen die Falle.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Gebt nicht nach.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Also wollt Ihr den Zorn meiner Brüder provokieren… Ich will nicht in Eurer Haut stecken, Gouverneur.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "Der Mann, für den wir arbeiten, wird Euch dafür zahlen lassen!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Aha! Endlich gebt Ihr zu, dass ihr für jemanden arbeitet!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "Der Magier biss sich auf die Lippe, als Zeichen der Reue, dass er zu leichtsinnig gesprochen hatte. Also wurde er von jemandem geschickt, der persönlich wütend auf Euch ist.\n\nEgal, wie sehr Ihr versucht, Euch auszumalen, wer es sein könnte, kein Name kommt Euch in den Sinn.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Euer Berater kommt gerannt, er sieht panisch aus: „Sire! Magier vor der Haustür! Sie bitten uns für ein paar Tage um Gastfreundschaft. Sollen wir akzeptieren?“";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Gouverneur… Das ist alles ein fürchterliches Missverständnis. Meine Brüder und ich wollten nicht so viele Schwierigkeiten bereiten.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Also seid ihr Geschwister. Warum habt ihr die Brände gestiftet?";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Wir wollten das nicht, Sire. Wir sind nur ein wenig tollpatschig, das ist alles…";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Für wen arbeitet ihr? Für die Banditen?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "Keineswegs! Wenn Ihr jedoch den dicken Rauch, der allmählich Eure Stadt verschlingt, loswerden wollt, solltet Ihr besser meinem Wünsch nachgehen.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "Was ist denn Euer Wunsch?";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Ich möchte, dass Ihr mir Ressourcen und Geld gebt!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "Und noch was? Sagt uns wo wir Eure Brüder finden können!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Wenn Ihr Euch weigert, werden weitere Katastrophen folgen.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Sire, diese Person, die die Magier angeheuert hat, könnte es nicht der Herzog von Cannes sein? Ich erinnere mich plötzlich daran, dass er Euch bedroht hat, als Ihr angefangen hast, Briefe an Königin Frygith zu schreiben.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Euer Berater könnte Recht haben. Ihr erinnert Euch gerade daran, dass der Herzog von Cannes Königin Frygith einen Antrag gemacht hatte, aber nach Eurem Treffen und dem berühmten Tanz lehnte sie seine Annäherungsversuche ab.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Ihr seid ein billiger Zauberer! Der Herzog von Cannes ist also Euer Dienstherr!? Wir wissen alles!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "In der Tat… Ihr habt es geschafft. Lasst uns ein Abkommen treffen. Gebt mir eine gute Summe Geld und ich und meine Brüder werden verschwinden. Wir werden Euch in Ruhe lassen.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Sire, wir befinden uns in einer Zwickmühle. Geben wir ihm den Betrag, um den er bittet, und bringen wir diese Magier-Geschichte hinter uns. Wir können keine übernatürlichen Katastrophen bekämpfen.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Obwohl Ihr nicht gerne unter Druck gesetzt werdet, müsst Ihr zugeben, dass Euer Berater Recht hat. Das Wohlbefinden der Stadtmenschen ist wichtiger als Euer Ego.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Jetzt müssen wir nur noch den Magier frei lassen und ihm das Geld zahlen.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Es war mir eine Ehre, mit Euch Geschäfte zu machen, Gouverneur!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "Der Magier verschwand mit dem riesen Sack Geld. Aber Ihr musstet Euch nie wieder mit ihnen abgeben.\n\nWas den Herzog von Cannes betrifft, so habt Ihr einen Brief an die Königin geschickt, die versprochen hatte, seinen Fall persönlich zu übernehmen. Ende gut, alles gut.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Nachdem Ihr wieder zur Besinnung gekommen seid und Eure Stadt vor den Flammen gerettet habt, bittet Ihr die Wachen, die drei Magier vorzuladen. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Eure Soldaten berichten, dass sie nur einen der drei Magier auffinden konnten.\n\nDie anderen zwei fehlen.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Mylord! Ist alles in Ordnung? Die Magier haben Gebäude in die Luft gejagt!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Wir müssen so schnell wie möglich die Feuer löschen!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "Das letzte Feuer wurde unter Kontrolle gebracht, Sire.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "Es sind drei Magier. Sie scheinen erleichtert zu sein, dass Ihr positiv auf ihre Anfrage reagiert habt. Ihr stellt ihnen ein Zimmer im Gasthaus zur Verfügung. Da sie nichts mehr von Euch brauchen zu scheinen, kehren Sie zu Ihren Aufgaben als Gouverneur zurück.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Sobald Ihr das Gasthaus verlasst, hört Ihr einen riesigen Knall. BUUUUUUUUUMMMM! Mehrere Gebäude stehen in Flammen!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Einlass verweigern.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "Oh nein! Die Pest ist ausgebrochen und einige Gebäude haben Feuer gefangen! Das ist bestimmt das Werk dieser Magier!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Hahahahahaa!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Lasst uns beeilen! Heilt die Townies und löscht die Feuer!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Und wieder einmal sind wir einem größeren Disaster entkommen…";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Führt die Suche fort.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Wir werden die Suche fortführen, Sire!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "Da ist einer! Schnappt ihn!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Eure Wachen sind dabei den zweiten Magier zu verfolgen, als plötzlich ein dicker Rauch die Stadt bedeckt. Eure Wachen geben die Verfolgungsjagd auf, da sie nichts mehr sehen können.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Mylord, wir haben ein neues Problem! Wir können uns nicht mehr schnell bewegen! Es ist, als ob wir durch Marmelade gehen!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Wir sollten uns ins Schloss zurückziehen und den Magier verhören, den wir schnappen konnten.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Nach dem Ratschlag beschließt Ihr, Euch im Schlossgelände zu verbarrikadieren, um das Verhör des ersten Magiers zu beginnen. Darüber hinaus bittet Ihr den Wachhabenden, das Schloss zu sichern, damit niemand die Burg betreten oder verlassen kann.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Ihr beschließt, die beiden Magier voneinander getrennt zu halten und den Magier zu befragen, den ihr dank Eurer erstaunlichen Falle gefangen habt.\n\nLeider habt Ihr es nicht geschafft, die Ressourcen zurückzugewinnen, der dritte Magier hat sie mitgenommen.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "Der zweite Magier scheint viel selbstbewusster zu sein als der erste. Und ohne zu zögern sagt er Euch das: „Glückwunsch, Gouverneur, Ihr habt mich auf frischer Tat ertappt. Aber wenn Ihr mich nicht sofort freilässt, werden schreckliche Dinge in Eurer Stadt passieren.“";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Lasst ihn frei.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Ihr habt viel zu viel Angst vor dem, was Eure Stadt durchmachen könnte, und beschließt, ihn frei zu lassen.\n\n„Ihr seid ein Spieler, Gouverneur“, sagte der Magier, bevor er in einem Rauchschein verschwand, als die Wachen seine Ketten entfernten.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Mylord! Der erste Magier ist auch entwischt! Sein Bruder ist neben ihm aufgetaucht und dann sind beide auf einmal verschwunden!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "…jetzt stehen wir wieder ganz am Anfang.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "Wir werden nach diesen Schurken suchen, Eure Majestät! Ihr könnt uns vertrauen.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Jetzt müssen wir nur noch warten, bis die Patrouillen zurückkehren, Sire.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Seit langem versuchen Eure Wachen, diese Magier zu finden. Bisher erfolglos. Doch Tag für Tag konnte die Stadt die seltsame Rauchwolke, die alle verlangsamte, beobachten, wie sie sich langsam auflöst.\n\nDas Geheimnis um diese Magier wird ungelöst bleiben.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Haltet ihn gefangen.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Die Magier";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Einlass gewähren. Lasst sie herein.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Blau.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Grün.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Ich muss sagen, eine mutige Entscheidung. Die blaue Farbe. Wer kann schon eine so schöne Farbe hassen? Die Farbe des Traums, der Weisheit und der Loyalität. Das sagt viel über Sie aus, Gouverneur.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Es ist ein Gast im renovierten Raum der Burg angekommen, Sire.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Leider haben die Farben des Raums ihn die ganze Nacht wach gehalten und macht Euch dafür verantwortlich.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Oh, Sire. Unser Gast war äußerst entzückt vom renovierten Raum. Ihm hat besonders die Farbe gefallen. Er hat sich dazu entschieden, uns Prestige zu geben.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "Es ist wahr, dass Grün dafür berüchtigt ist, Unglück zu repräsentieren. Aber es ist auch ein Zeichen von Hoffnung, Glück und Stabilität. Es harmoniert mit allen anderen Farben der Natur. Ich muss sagen, es ist eine gute Wahl.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Gouverneur, wir haben einen der Räume der Burg renoviert. Welche Farbe wäre besser?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "Der Raum";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Absolut nicht.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Sendet Spione.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "Es gibt keine Magie.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Ruft die Hexe herbei.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Mylord, das ist fürchterlich. Wie ist das nur möglich? Könnte es sich um einen Magier handeln, der mit schwarzer Magie vertraut ist? Niemand sollte solche Kräfte haben!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "Das ist eine weise Entscheidung. Lasst uns unseren besten Spion entsenden und den verrückten Townie ausspionieren. Dann sehen wir, was er zu berichten hat.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Der Spion ist mit seinem Bericht zurückgekehrt.\n\n„Ich bin diesem Townie gefolgt, dem Freudendieb. Es scheint als ob seine Worte Traurigkeit in den anderen Townies auslöst. Die Townies können sich dann einfach nicht mehr an die fröhlichen Momente ihres Lebens erinnern.“";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Sire! Einer unserer Bewohner scheint seinen Kameraden die Freude zu stehlen.\n\nMehrere Townies haben Beschwerden gegen diesen Dieb eingereicht. Hier ist die Aussage eines der Opfer: „Er kam eines Morgens, um mit mir zu reden. Ich hörte ihm aufmerksam zu und plötzlich war ich sehr traurig. Als ob seine Worte mir meine Freude entziehen.“";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Majestät, sollten wir etwas tun, um dieses Problem zu lösen?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Gouverneur, was sollen wir tun?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Helft der Hexe.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "Es gibt keine Geister!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Die Maßnahmen, die wir ergriffen haben, scheinen gut zu funktionieren, Sire. \n\nDer Freudendieb setzt seine Missetaten fort, aber wir werden ihn jetzt bekämpfen.\n\nSollen wir die Wache losschicken und ihn für seine Taten vor Gericht bringen? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Lasst Gerechtigkeit walten.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Tut nichts.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Ihr seid ein vernünftiger Mensch. Nur die Wissenschaft kann dieses Problem des Freudendiebes erklären und lösen. \n\nIhr beruft Eure besten Wissenschaftler ein, an einer Formel zu arbeiten, die es den Townies ermöglicht, wieder glücklich zu sein. \n\nNatürlich ist diese Arbeit nicht kostenlos. Die Wissenschaftler verlangen viel Geld. Andernfalls könnt lhr dem Glück ganz und gar zum Abschied winken." ";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Dieses Problem mit dem Freudendieb hat Euch nicht genug beunruhigt. Allerdings haben die Fälle von depressiven Townies weiter drastisch zugenommen.\n\nOrientierungslos flieht Ihr in Euer Schloss. Ich weiß nicht, was ich gegen diese Katastrophe tun soll. Man sagt, dass Zeit alle Wunden heilt. \n\nHoffentlich reißt Euch nicht der Geduldsfaden.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "Die Hexe ist weg. Manche sagen, sie hätte sogar die Stadt verlassen, weil sie nicht genauso leiden will wie alle anderen, nur weil Ihr Euch weigert, etwas zu tun.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Kurz nachdem die Hexe gegangen war, wurde die Situation unerträglich. Alle Townies verfallen in eine tiefe Traurigkeit.\n\nWie lange wird das so weitergehen?";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Schickt die Wachen und schnappt ihn!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Eure Wachen haben stundenlang gesucht und gesucht. Nichts. Sie kamen alle traurig und depremiert zurück. Aber sie sagen, sie hätten den Freudendieb gehört, konnten ihn aber nie sehen.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Kurz nachdem die Wachen zurückgekehrt waren, kam eine Eule mit einer Nachricht der Hexe herbeigeflogen.\n\nSie enthüllte, dass der Freudendieb niemand anderes sei als ein Geist, der sich von der Freude der Townies ernährte. Und er nichts als Traurigkeit und Verzweiflung zurück ließ.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Trotz der Bemühungen der Wissenschaftler, den Prozess zu verzögern, blieb die ganze Stadt depressiv. Da die Hexe verschwunden war, hattet Ihr keine weitere Möglichkeit mehr, Euch gegen diesen Geist zu verteidigen. \n\nHoffen wir, dass die Zeit die Townies heilt.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "Die Zeit ist vergangen und die Stadt ist nun wieder fröhlich und heiter. Der Freudendieb ist nichts als eine verschwommene Erinnerung.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Fragt die Hexe um Rat.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Verhandelt.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Mylord, ich werde versuchen, mit den Wissenschaftlert zu verhandeln. Überlasst es mir, ich kümmere mich um alles!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Euer Berater, der Verhandlungskünstler, konnte erfolgreich den verlangten Preis der Wissenschaftler verringern! Gut gemacht.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Autsch. Euer Berater ging erfolglos aus der Preisverhandlung. Die Wissenschaftler haben ihre verlangten Preise erhöht und wollen nicht länger mit Euch verhandeln.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Bezahlt die Wissenschaftler.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Wenn wir zahlen müssen, dann lasst uns zahlen, denn wenn wir weiterhin warten, wird es uns zum Verhängnis.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Eure Bewohner leiden einfach unter Depressionen, Mylord. Sie sehen einfach keine Hoffnung.\n\nDie Lösung dafür ist, ihnen die schöne Seite des Lebens zu zeigen und ihnen zu beweisen, dass das Leben nicht ganz so trist ist, wie sie denken.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Lasst uns damit anfangen, mehr Dekorationen und ein Gebräufestgelände zu errichten.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "Der Stadt geht es langsam besser. Manche Townies, denen jede Freue entzogen wurde, können jetzt wieder die kleinen Freuden im Leben genießen.\n\nDennoch treibt der Freudendieb nach wie vor sein Unwesen.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Freudendieb";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Es sind Jahre vergangen, seit dem wir das letzte Mal mit der Hexe zu tun hatte, Gouverneur… Ich hoffe es wird nicht noch mehr Unheil über unsere Stadt bringen.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Guten Morgen, Gouverneur. Schön Euch wiederzusehen. Ich hörte, Ihr steckt in Schwierigkeiten?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Nachdem Ihr der Hexe die Lage geschildert habt, lächelt sie. Hat sie schon eine Lösung für unser Problem parat oder heckt sie einen schlechten Streich auf Euch aus?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Nun zu, spricht! Warum grinst Ihr so?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Euren Freudendieb gibt es nicht, Sire.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Aber es muss ihn geben, denn einer unserer Spione leidet an den Konsequenzen mit ihm geredet zu haben!\n";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "Er ist einfach nur einem Geist der Traurigkeit begnet. Sie erscheinen gelegentlich nach dem Bau einer religiösen Einrichtung. Es sind Geister, die sich von der Freude der Menschen ernähren. \n\nDurch das Absorbieren von Freude gewinnt der Geist an Kraft und erhöht seine Stärke. Leider kehrt die Freude nicht zu den Menschen zurück, denen er sie gestohlen hat."";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "Wie werden wir den Geist los?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Ich weiß eine Lösung, aber ich brauche Eure Hilfe.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Wir werden Euch helfen. Was braucht Ihr?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Wir brauchen ein Mausoleum und Grabsteine.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "So gut wie erledigt!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Wir haben Eure Aufgabe erledigt, Hexe. Es ist an der Zeit, dass lhr uns zeigt, was Ihr könnt.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "Die Hexe macht sich auf den Weg zum Mausoleum und verschwindet im Inneren. Ihr hört Zaubersprüche. Plötzlich kommt ein Wind auf, ein schrecklicher Sturm scheint sich zusammenzubrauen.\n\nDie Hexe kommt immer noch nicht aus diesem Mausoleum heraus.\n\nIhr verspürt plötzlich große Traurigkeit. Ihr verspürt Kälte und fühlt Euch von Dunkelheit umgeben.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Dann, in der Ferne, ein Sonnenstrahl. Ein sehr kleiner Sonnenstrahl. Ihr konzentriert Euch darauf. Er wird immer heller. \n\nDer Sonnenstrahl scheint die Form einer Erinnerung anzunehmen. Eine von Euren. Eure glücklichste Erinnerung.\n\nIhr fühlt Euch wieder gut.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Mylord… Was war das eben? Habt Ihr das auch gespürt?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Sire, Ihr seid nun dem Geist der Traurigkeit los. Eurem Gesichtsausdruck zufolge, gehe ich davon aus, dass Ihr dem Geist begegnet seid. Es ist vorbei. Er ist gefangen.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "Es war furchtbar! Ich danke Euch!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "Die Stadt ist den merkwürdigen Geist endlich los. Die Einwohner haben Ihre Freue wieder zurück und sind Euch dankbar.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Sire, wenn Ihr mir nicht bei dem Geisterprojekt helft, kann ich Euch versichern, dass das Euer Untergang sein wird.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "So sei es! Geht mir aus den Augen mit Eurem Hexenwerk!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Lasst sie spielen.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Ich will spielen!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Ein Brettspielfest?! Was für eine seltsame Idee, Sir. Wie sollen wir das machen? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Sir, unsere Soldaten spielen so viel in ihren Wachtürmen, dass sich die Bewohner überhaupt nicht beschützt fühlen. Was müssen wir denn tun?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Die Turmspiele ";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Wir brauchen Holz und Stein.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Wir brauchen Ideen und Entwickler für Spiele.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Durch eine kleine Spende könnten wir unser Ansehen beim König verbessern, mein Herr.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Baue einen Wachturm in Reichweite der Kaserne.";
"T_GAME_QUEST_WATER" = "Wasser";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Seid still, ja?";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Lasst uns anfangen, den Brunnen zu bauen, um einer derartigen Situation vorzubeugen.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Oh, Sir. Bitte. Unsere Ernte ist in Gefahr. Wenn Ihr nichts unternehmt, werden wir keinen friedlichen Winter haben.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "Der Gouverneur hat sich bereits zu diesem Thema geäußert. Wenn Ihr immer wieder ins Schloss kommt und uns von Eurem Gejammer erzählt, müssen wir Euch einsperren. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "… Ihr werdet bald enttäuscht werden!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "Sir! Die Felder! Es ist furchtbar! Nichts wächst mehr. Die Hitze war so stark, dass unsere Ernte ruiniert ist. Ihr hättet dem Farmer vertrauen sollen… jetzt ist es zu spät.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Lasst uns sputen und Brunnen errichten, Sir. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "Der Bau der Brunnen wurde abgeschlossen. Vorsicht ist besser als Nachsicht! Wir werden sehen, ob wir Recht hatten, dem Farmer glauben zu schenken.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Oh, Sir! Die Farmer sagten, dass die Hitzewelle ihre Felder beanspruchte, ABER dank dem Bau der Brunnen, konnten wir eine Menge Ärger vermeiden.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Sir! Ich hatte wieder einen Vorahnungstraum! Die Felder standen in Flammen. Nichts wuchs mehr. Es war kein Wasser verfügbar.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Böse Vorahnung";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Gebt ihr Kräutertee zur Beruhigung.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Nun, wo wir gerade von Kräutertee sprechen - wir werden die Idee verbreiten. Lassen Sie die umliegenden Städte wissen, dass heißes Wasser mit Kräutern kombiniert mit einem eingängigen Slogan großartig ist.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Verbessert die Abwehr!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Lasst uns die militärische Verteidigung verbessern, Gouverneur!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Wir haben großartige Arbeit geleistet, „der Kräutertee, der euch die Schafe vergessen lässt“ ist ein innovativer Slogan...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Jetzt warten wir ab... Soweit wir wissen, haben wir diesen ganzen Aufruhr um nichts gemacht. Wir hätten ihr einen Kräutertee geben sollen...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Trotz Eurer Erwartungen, sowie der Verbesserung der Verteidigung im Falle von Überraschungsangriffen durch Banditen, kamen sie nie. Allerdings haben Sie jetzt einige schöne Militärgebäude zu bewundern.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Oh nein, Sir. Die alte Dame macht es schon wieder! Sie schreit von den Dächern, dass die Hexe des Waldes durch unsere Stadt ziehen und alles auf ihrem Weg zerstören wird.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "Der Hexenweg";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Ah, Sire!\n\nDa unten war es unglaublich! Ein See von ungeheurer Größe und Schönheit!\n\nDie Frau war da! Ich bin ihr einen guten Kilometer lang durch die Minentunnel hinterher gerannt. Dann habe ich sie aus den Augen verloren.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "Und dann.... als ich dachte, ich würde mit leeren Händen nach Hause kommen, sah ich Tausende von Lichtern. Oh Majestät, Ihr hättet das sehen sollen, so etwas Schönes habe ich nie zuvor gesehen! \n\nSie erzählte mir von ihren Plänen, mit der ganzen Beute zu entkommen und woanders ein neues Leben anzufangen. Seit dem Tod ihres Mannes hat sie Schwierigkeiten gehabt, hier zu bleiben, zu viele Erinnerungen....";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Mylord, wir sind bereit, in die Minen zu gehen und den Schatz zu finden. Es gibt mehrere Markierungen auf der Karte.\n\nWo sollen wir anfangen?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Nördliches Versteck";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Südliches Versteck";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "Oh, SIRE! Wir hatten Glück! Unser Team konnte unverletzt entkommen. Die Tunnel sind zusammengestürzt!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "Das Ergebnis dieser ersten Expedition ist sehr zufriedenstellend! Eure Leute haben es geschafft, unversehrt von dieser Expedition zurückzukehren und einen Teil des Piratenschatzes als Bonus mitzubringen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Mylord, wir sind bereit, ein zweites Mal in das Bergwerk zu steigen.\n\nWelches Versteck sollen wir absuchen?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Östliches Versteck";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Westliches Versteck";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "Es bietet sich eine unglaubliche Gelegenheit, Sire! Zweimal waren wir bei dieser Schatzsuche schon erfolgreich!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Ihr analysiert sorgfältig die Minenpläne. Ihr entdeckt einen unterirdischen See, der von einem Fluss gespeist wird und direkt zum Meer führt. Ein sehr nützlicher Zugang für Piraten!\n\nDiese Tunnel sind jedoch nicht sicher und laufen Gefahr, jederzeit einzustürzen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "Gute Nachrichten! Während Ihr damit beschäftigt wart, den Schmied zu helfen, konnte Euer Berater uns Pläne des Bergwerks beschaffen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Sichert das Bergwerk.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Sendet ein Team ins Bergwerk!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Lasst uns in das Bergwerk investieren, sodass es wieder sicher ist, Sire. Es wird uns zwar viele Ressourcen kosten, aber ich versichere Euch, dass Ihr es nicht bereuen werdet.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "Unglaublich, Sire! Wir haben es geschafft, das Bergwerk zu sichern! Unser erstes Team hat sofort die Frau des Piraten gefunden!\nSie konnte entwischen, aber sie hinterließ einen Minenplan mit Markierungen. Ich glaube, diese Markierungen zeigen, wo die Schätze versteckt sind!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Alles, was wir tun müssen, ist den Tribut zu zahlen, Sire.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Teams, Teams… wir haben keine 50! Ich werde es selbst tun. Aber ich brauche wenigstens erst eine gewisse Ausstattung.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Gut, ich bin bereit!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Euer Berater ging in das Bergwerk um mehr über diese Frau herauszufinden.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Beschafft mir die nötige Ausstattung, sodass die Mission ein Erfolg wird.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Plötzlich verliert Ihr die Geduld mit dem Schmied. Ihr befiehlt ihm, diese Ausrüstung so schnell wie möglich zu besorgen und dass seine dringende Lieferung nicht Eure Angelegenheit ist. Und dass es Euch egal sei, wenn er bankrott gehen würde.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Ich… ich werde es Euch so schnell wie möglich bringen, Sir…";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Es war unhöflich Euch zu weigern, dem Schied zu helfen. Ihr müsst verstehen, dass er für seinen Lebensunterhalt arbeiten muss und diese Lieferung schien für die Wirtschaft Eurer Stadt sehr wichtig zu sein. Ich hoffe er wird uns es nicht übel nehmen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Autsch, Mylord… Ihr hättet vorsichtiger sein sollen. Der Schmied hat jedem davon berichtet, wie Ihr ihn behandelt habt. Mehrere Townies streiken jetzt. Und der Schmied weigert sich, zu der Burg zurück zu kehren.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Mylord, mir fällt keine andere Alternative ein, als ein Turniergelände zu bauen. Das wird die Bewohner ablenken und ihnen erlauben, Spannung abzubauen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Die Bewohner scheinen sich beruhigt zu haben. Aber die Piratengeschichte ist immer noch nicht zuende.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Sire, das Turniergelände ist notwendig. Ansonsten werden die Townies weder glücklich noch produktiv sein. Der Streik kostet uns wertvolle Zeit, die wir besser in diese Piraten und Berkwerk-Angelegenheit gesteckt hätten.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Sire, während wir mit diesem Aufstand beschäftigt waren, nutzte die Frau des Piraten die Gelegenheit, die Beute aus den Minen zu bergen. Dort war der Schatz!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Unsere Spione fanden eine Nachricht von dieser Frau, dass sie die Abwesenheit ihres Mannes nicht mehr ertragen könne und dass sie sich ein wenig auf einer himmlischen Insel zurückziehen würde, wo sie eine kleine Burg besitzt.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Es scheint, dass wir eine schöne Summe Geld verpasst haben, Sire. Seht Ihr, wohin Eure voreiligen Entscheidungen uns führen? Wie auch immer, wir können jetzt mit diesen Debakel abschließen.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Lasst uns ein Turniergelände bauen.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Es war die falsche Entscheidung, die Sache auf die leichte Schulter zu nehmen, Lord. Wer weiß, was wir herausgefunden hätten?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Ein paar Tage nachdem Ihr Euch geweigert habt, Euch um die Beschwerden zu kümmern, ist das Bergwerk zusammengestürzt. Euer Volk macht Euch für das tragische Ereignis verantwortlich.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "Euer Volk vergisst so langsam, dass das ganze Bergwerkdebakel passiert ist. Zeit ist vergangen und die Moral ist wieder hergestellt.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Wir konnten die auf der Karte markierten Verstecke nicht ausfindig machen, Sire. Wir kommen leider mit leeren Händen zurück. Aber wir leben, das ist das Wichtigste.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Trotz des Niederschlags, erlangt Ihr durch das Abenteuer ein wenig Prestige. Wer hätte gedacht, dass Piraten solch Schätze in Euren Minen verstecken würden?\n\nVorerst ist jedoch Eure Karriere als Schatzjäger beendet.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Oh nein, Mylord. Es wurde mir berichtet, dass die Tunnel in den Minen zusammengestürzt sind. Wir hatten großes Glück, dass wir zweimal mit Schätzen zurück kommen konnten.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Ausnahmsweise beschließt Ihr, ein großes Essen für eure Soldaten zu organisieren, um ihnen freundlich zu danken, dass sie Euch diese Schätze gebracht haben.\n\nDiese Piratengeschichte liegt jetzt weit hinter Euch. Wer weiß? Vielleicht findet Ihr eines Tages eine Karte, die Euch zu anderen Geheimnissen führt.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "Der Schatz wird bald Euer sein!\n\nIhr gebt den Soldaten den Befehl, diesen Schatz zu finden und Euch zu bringen.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "Unglaublich! Seht Euch alles an, was wir in diesen Minen gefunden haben! Ihr hattet Recht, sie zu sichern, bevor Ihr Eure Leute dorthin geschickt habt. Ein unglaublicher Reichtum! Die Gerüchte über diesen Piraten waren wohl wahr. Wir sind jetzt reich!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Mit der Information die wir haben, können wir nicht viel anfangen. Es wäre klug, eine Experten zu konsultieren.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Ruft einen Minenarbeiter herbei.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "Das ist eine gute Idee, Mylord. Vielleicht kann er uns einen Plan der Tunnel geben, sodass wir einen besseren Überblick erhalten können.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Mylord, ich freue mich, dass Ihr mich um Hilfe bittet. Ich habe Euch den Bergwerkplan mitgebracht. Ich hoffe, es wird Euch helfen.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Ruft einen Schmied herbei.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Der Schmied wird sicher in der Lage sein, uns mehr über diese Steine zu verraten, die diese Frau versucht zu schlagen.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Sire, wir erhielten einige Beschwerden über die Bergwerke. \nEine Frau besucht sie jeden Tag, schleppt Steine, schlägt Steine. Aber was sicher ist, ist dass sie immer und immer tiefer in die Tunnel gräbt.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Findet mehr über diese Frau heraus.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "Das ist nicht mein Problem.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Die Townies sind besorgt darüber, dass die Tunnel nicht sicher genug seien und, dass das Bergwerk jeden Moment zusammenbrechen könnte.\n\nEs ist unsere Pflicht, der Sache nachzugehen.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Ich hoffe Ihr habt aus Eurem Fehler gelernt!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Während Euere Beraterin nach weiteren Hinweisen forscht, wäre es gut, wenn Ihr Euch um die Stadt kümmern könntet. Versucht, das Leben der Townies zu verbessern.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "Da bin ich wieder, Sire! Ich bin dieser Frau bei einer Beschattungsaktion gefolgt. Es war nicht einfach.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Es scheint, als würde sie nach etwas suchen. Ich habe gesehen, wie sie einige Steine geschlagen hat und aufmerksam den Schutt abgesucht hat.\n\nLeider konnte ich ihr nicht sehr weit folgen. Es sieht so aus als ob sie die Bergwerke in- und auswendig kennt.  ";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Euere Beraterin ist mit Neuigkeiten von ihrer Mission zurückgekehrt. \nIn ihrem Bericht heißt es, dass diese Frau kürzlich zur Witwe geworden ist.  \n\nIhr Mann war ein sehr berühmter Pirat. Man sagt, dass er den größten Schatz aller Zeiten besaß und dass er ihn nicht weit von hier versteckt hat. ";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Ich habe da eine Theorie, Sir. Ich glaube, diese Frau wurde von anderen Piraten dazu gedrängt, ihnen zu verraten, wo der Schatz vergraben liegt!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Führt die Untersuchungen weiter.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Lasst es sein.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "Die Frau und das Bergwerk";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "Der Schmied kommt gehetzt an. Eure Wachen haben ihn aus seiner Schmiede gezerrt. Er wirkt zerstreut.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Sir, was kann ich für Euch tun?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Wir sind derzeit auf einer Mission und wir brauchen Eure Hilfe.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Ich bin ganz Ohr.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Euer Berater schildert dem Schmied die Lage.\n\nEr zeigt ihm auch die aufgebrochenen Steine, die er mitnehmen konnte. Ihr könnt sehen, dass der Schmied diese Art von Stein wiederzuerkennen scheint.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Heiliger Bimbam! Das sind eine Menge Geoden!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Geoden, sagst du?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "Es sind besondere Kristalle, sie können Schätze enthalten. Nicht selten sind es Kristalle, die sehr kostbar sein können. \n\nEinige Piraten benutzten Codes auf Geodenbasis, um sich zu merken, wo ihre Schätze versteckt waren. ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Ich habe einige davon in meiner Werkstatt, ich kann Euch zeigen, wie man sie mit dem richtigen Werkzeug öffnet.\n\nAber... Ich habe eine wichtige und dringende Lieferung zu erledigen und würde mich über Eure Hilfe freuen. Als Zeichen Eurer Dankbarkeit für die Informationen, die ich Euch gegeben habe.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Sich weigern.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Akzeptiert.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Ich muss Werkzeuge für Minenarbeiter erstellen. Es handelt sich um einen Großauftrag.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Das sind Geoden. Schaut, ich zeige es Euch. Mit diesem Werkzeug kann man sie leicht öffnen. Oft sind sie nichts besonderes, aber manchmal stößt man auf reine Wunder!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "KRR KRR… KLING!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "Oh Sir, schaut Euch diesen Geoden an! Ein wunderschönes Stück!";
