"T_QUESTS_PRODUCE_JEWELLERY" = "Produziere Schmuck.";
"T_QUESTS_PRODUCE_JUICE" = "Produziere Traubensaft.";
"T_QUESTS_PRODUCE_SAUSAGES" = "Produziere Würstchen.";
"T_QUESTS_PRODUCE_TOOLS" = "Produziere Werkzeuge.";
