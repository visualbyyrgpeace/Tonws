"BUILDING_UPGRADE_TAXBONUS" = "Bonificación por impuestos";
"EVENT_WITCHHUNT_08_SUCCESS" = "Por fin tenemos un médico en la aldea. Seguro que puede ayudarnos con la enfermedad.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Espera a que el médico regrese de la capital.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Los aldeanos serían mucho más felices si tuvieran un local comunitario para reunirse a tomar una copa de mosto o saborear una cerveza tras un duro día de trabajo. ¿Sería mucho pedir, mi señor?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Aumentar la satisfacción de la comunidad.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Muy bien, gobernador. Si no negocias conmigo, mis hombres tomarán lo que necesiten.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Esta vez has tenido suerte. Pero la próxima no tendrás tanta.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Jajaja. Que esto te sirva de lección. Seguro que la próxima vez querrás comerciar conmigo.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Mi señor, necesito muchas piedras. Te proporcionaré madera si tú me ayudas a conseguirlas.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Mi señor, he acumulado madera para la construcción de la aldea. La venderé a cambio de trigo.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Anoche mi hija pasó mucho frío. ¿Serías tan amable de ayudarme dándome lana? A cambio te puedo proporcionar madera valiosa.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Mi señor, tengo una pregunta... Mi hijo quiere aprender la profesión de curtidor. Necesita pieles para practicar. Las intercambiaría por madera.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Mi señor, ¿tienes hierbas? Por desgracia no tengo ninguna para especiar mi carne.\nA cambio te entregaré mi mejor madera.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Mi señor, quiero arreglar mi casa. ¿Me darías algunas herramientas a cambio de mi última pila de leña?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Mi señor, quiero organizar un festín. ¿Podrías ayudarme? A cambio te entregaré algo de madera.";
"SCENARIO_CW_QUEST_B_NAME" = "Comercia con el granjero.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Mi señor, mi familia sufre el azote del hambre. ¿Tendrías la bondad de entregarnos pescado? Yo incluso te compensaría con madera de mi pequeño almacén de leña.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Tengo una pequeña pila de madera para reparaciones. Te la cedo a cambio de piedras, mi señor.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Mis hombres necesitan más pescado. ¡Tráeme un poco y te daré madera! Y además no dañaré a tu pequeña aldea.";
"SCENARIO_CW_QUEST_C_20_DESC" = "¡Eh, gobernador! Quiero hacerte el favor de sacar algunas pesadas piedras de tu almacén. Si me lo permites, incluso te daré madera.";
"SCENARIO_CW_QUEST_C_30_DESC" = "En lugar de malgastar trigo dándoselo a los granjeros, deberías entregármelo a mí y yo te daré mi mejor madera.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Queremos suavizar los mangos de nuestras espadas con lana. No te preocupes, si cooperas no las usaremos contra ti.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Mis hombres se aburren. Si nos entregas pieles, podremos mejorar nuestros muñecos de entrenamiento para que parezcan más reales. Si no quieres comerciar conmigo, practicaremos con tus townies.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Tengo a un hombre enfermo. He oído que hay hierbas que pueden curarlo. Si no te importa, las buscaré en tu almacén. Seguro que las encuentro.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Nuestras herramientas ya no sirven de nada. Tú tienes muchas, gobernador. Ten la bondad de darme algunas y yo seré tan amable de no tomarlas por mi mismo.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Mis hombres quieren comer carne. Entrégamela y tendré la cortesía de darte madera a cambio. \n\nO puede que mis chicos visiten tu aldea y la cojan ellos mismos...";
"SCENARIO_CW_QUEST_C_NAME" = "Comercia con el bandido.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, un nuevo gobernador...\nComo eres nuevo aquí, te explicaré las normas. Tú me das lo que pido y yo te dejo hacer lo que tengas que hacer.\n\nUn acuerdo justo, ¿verdad? Bien, empecemos con una tarea sencilla: ¡tráeme pescado!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "¿Problemas de madera? ¡No hay problema!\nHe roba... eeh... almacenado una enorme pila de madera. Me encantaría vender algo a cambio de un par de piedras.";
"SCENARIO_THIEF_FAIL" = "Así que no vas a comerciar conmigo, ¿eh?\n\nDe acuerdo, ya verás lo que ocurre.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Mi señor, mira lo que tenemos aquí... Parece un colmillo. De origen no humano. ¡Y aquí! Más trufas. No tengo conocimientos para elaborar una teoría, pero conozco a alguien que podría ayudarnos. ¡Vayamos a ver al viejo!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "¿Quién, si no el mercader, podría culpar tanto a los lugareños? ¡Es cómplice!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "¡El mercader!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "¡Probablemente sea la joven! Es la hermana de la townie desterrada. ¡Ahí tenemos un móvil!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "¡La joven doncella!";
"THEBEAST_CHOICE_A_REASON_DESC" = "La joven injustamente desterrada por la reina realizó los ataques. Quería vengarse por su exilio forzoso.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "¡V de vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "La misión para alcanzar el bienestar en la aldea se convirtió en una pesadilla... Seguramente no pretendía hacer daño, solo ayudar a su vecino.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "¡Hector, el artista!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "¡Sin duda es él! Odia a los recién llegados y atacó a la hermana de la chica exiliada para que no causara daños a su viñedo.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Basil, el agricultor.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Asustando a los townies, el autor quería expulsarlos de la ciudad y a la vez evitar que otros nuevos se mudaran aquí.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "¡Para disuadir a otros de que emigren a la aldea!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "No cabe duda de que ayudó económicamente al culpable.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "¡La reina Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "¡Fue el panadero! ¡Simuló haber sido atacado para evitar sospechas! ¡Menudo genio!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "El panadero.";
"THEBEAST_CHOICE_C_REASON_DESC" = "La reina Frygith, arrepentida de su decisión de abrir las fronteras, aunó esfuerzos con algunos residentes para asustar a los recién llegados y volver a cerrarlas.";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Aduce una conspiración.";
