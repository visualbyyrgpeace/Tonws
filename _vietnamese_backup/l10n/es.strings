"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_2" = "Quita al trabajador asignado en el campamento de leñadores para que quede liberado.";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_3" = "Detener la producción de aserradero quitando el trabajador.";
