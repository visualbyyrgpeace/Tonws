"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Vale, ya es suficiente, que un curandero examine a este hombre.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "¿Qué quieres decir? ¿Cómo que mi hermano es un pájaro? Has perdido la cabeza.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Lo que el gobernador trata de decirte es que tienes que confiar en él, tu hermano sabrá lo que se hace. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Si tú lo dices... Pero como le pase algo, te haré responsable.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Gobernador, le dimos un poco de sedante y ahora está dormido. Farfullaba cosas extrañas sobre una técnica que lo hubiera llevado por encima de las montañas, hiciste bien en traérmelo. Un poco más y ¡nos hubiera dicho que la tierra es redonda!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "¡Señor! Un mensajero de palacio nos comunica que nuestro inventor es increíble y que desean que se quede más tiempo en la capital para seguir trabajando en sus inventos. ¡La influencia cultural de la ciudad ha recibido un gran empujón! El rey ha decidido mandarnos prestigio.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Mi señor, acudo a ti porque mi hermano se ha vuelto loco. Dice que es un pájaro y ¡que puede volar! Temo que haga alguna estupidez y decida trepar a algún sitio más alto para demostrar que puede volar como un ave.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "¡Oh, señor! ¡Gracias por no haberme metido en el calabozo! Mi hermana se preocupa demasiado por mí... ¡Quería sorprenderte con mi descubrimiento! ¡Inventé una máquina para volar! ¡COMO LOS PÁJAROS! Quisiera presentarla en la capital, en la gran feria anual.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "El hermano pájaro";
"T_GAME_QUEST_COVERAGE_DESC" = "¡Mi señor, la ciudad no está preparada para ataques de bandidos!\nLa mayor parte no está defendida por torres de vigilancia. Tienes que construir las suficientes para proteger tantos edificios como sea posible.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "¡Mi señor, el pueblo no está preparado para los ataques de los bandidos! Partes de la ciudad no están protegidas por edificios de defensa.";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Aumenta el área de protección del pueblo con edificios defensivos.";
"T_GAME_QUEST_COVERAGE_TITLE" = "Instala torres de vigilancia en la aldea.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "¡Los bandidos atacan la aldea, gobernador!\n¡Tenemos que repeler a tantos asaltantes como podamos para minimizar los daños a nuestra economía y nuestros edificios!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Mi señor,\nlos aldeanos temen los ataques de los bandidos. ¡Debemos demostrar a los Townies y sobre todo a los bandidos que podemos defendernos!";
"T_GAME_QUEST_DESIRES_01_START" = "Qué región tan provinciana, carece de las ventajas de una gran ciudad.\n\n¡Esta aldea tiene que cambiar mucho para convertirse en una próspera metrópolis!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Se está aquí de maravilla, ahora que ha desaparecido la amenaza de los bandidos y la aldea ha crecido.\nMudarnos aquí fue una idea excelente, cariño.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Asegúrate de que tu esposa se sienta cómoda.";
"T_GAME_QUEST_DESIRES_02_START" = "Esta aldea también necesita una sastrería. Así podré hacerme vestidos a medida.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "¡Gracias, cariño!\nTenía toda la ropa hecha jirones.";
"T_GAME_QUEST_DESIRES_03_START" = "Echo de menos el bullicio de la ciudad.\n¡Por favor, aumenta la población para animar esta urbe!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Aumenta la población.";
"T_GAME_QUEST_DESIRES_04_START" = "¡Vaya, que aldea tan alegre y bonita!\n\nSeguro que no pondrás pegas si me instalo aquí.";
"T_GAME_QUEST_DESIRES_05_START" = "¿Bandidos en los bosques?\n¡Establece una guardia para repeler a esos villanos!";
"T_GAME_QUEST_DESIRES_06_START" = "Vaya, una torre de vigilancia...\n\nDeberías saber que tales cosas solo incitan a mis hombres.";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Esos bandidos causan problemas a la aldea.\n\n¡Quiero que refuerces la guardia inmediatamente!";
"T_GAME_QUEST_DESIRES_07_START" = "¡Por favor, asegúrate de que la guardia mantiene a los bandidos alejados de la aldea!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "¡Maravilloso! Ahora me siento mucho más segura.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Repele todos los ataques de bandidos.";
"T_GAME_QUEST_DESIRES_08_START" = "¡Debes proporcionar cerveza y salchichas a los guardias para asegurarte de que cumplen con su deber!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Produce cerveza y salchichas.";
"T_GAME_QUEST_DESIRES_09_START" = "¡Los guardias necesitan armas y armaduras para poder rechazar a los bandidos!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "¡Ahora los guardias podrán repeler a todos los bandidos!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Fabrica armas y armaduras.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "¡Debí mencionar que mis hombres se llevarán su parte de todas formas! ";
"T_GAME_QUEST_DESIRES_10_START" = "Tu manera de satisfacer todos los deseos de tu esposa me induce a pensar que tienes un problema de exceso monetario.\n\n¡Permíteme liberarte de esa pesada carga!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "¡Sería una sabia decisión enviarme esas monedas ahora, señor administrador!";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Proporciona monedas.";
"T_GAME_QUEST_DESIRES_11_START" = "No estarás pensando en ceder a este chantaje, ¿verdad?\n¡El mejor uso para las monedas es comprar ropa nueva!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Compra telas al mercader.";
"T_GAME_QUEST_DESIRES_12_START" = "¡La aldea es aburrida, carece de entretenimiento!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "¡Qué aldea tan aburrida, necesita un campo de justas!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "¡Mucho mejor! Ya empieza a tener buen aspecto.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Construye un campo de justas.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "No has aprendido nada de la última vez. ¡Mis chicos vendrán a hacer un pequeño inventario!";
"T_GAME_QUEST_DESIRES_13_START" = "Parece que sigues nadando en la abundancia. ¡Dame tu oro!\n¡Y no te atrevas a dárselo a tu esposa!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Veo que has aprendido. Quizá mis hombres ya no tengan que tomar su parte por la fuerza.";
"T_GAME_QUEST_DESIRES_15_START" = "¡Cariño, prefiero que uses el oro para hacerme joyas!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "¡Muchas gracias, cariño!";
"T_GAME_QUEST_DESIRES_16_START" = "Quiero celebrar una pequeña fiesta.\nPor tanto necesito zumo y pan.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Muy bien. Espero que no haya incidentes con los bandidos.";
"T_GAME_QUEST_DESIRES_17_START" = "Vaya, qué fiesta más agradable. ¿Se te ha olvidado invitarnos? ";
"T_GAME_QUEST_DESIRES_18_START" = "Se acabó. ¡Deshazte de esos bandidos de una vez por todas!\nDestruye sus campamentos.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "¡Por fin hemos acabado con esos villanos!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Destruye todos los campamento de bandidos.";
"T_GAME_QUEST_DESIRES_19_START" = "¿Ni siquiera hay un mercado en esta aldea? \nConstruye uno, mi amor, para que yo pueda comerciar con productos de la ciudad.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Bueno, ahora la vida aquí es ligeramente más soportable.";
"T_GAME_QUEST_DESIRES_20_START" = "¿No tienen otra comida que no sea pescado?\nPor favor, construye una panadería y produce pan.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "¡Muchas gracias! Cada vez que veo pescado me pongo enferma.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Mi señor, nuestros exploradores informan de que los bandidos de la región se están concentrando en los límites de la ciudad. Me temo que van a lanzar un ataque a gran escala.\n¡Debemos preparar las defensas!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "¡Los bandidos han iniciado el ataque!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "¡Una nueva oleada de bandidos ha alcanzado la aldea, mi señor!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "¡Señor gobernador, los bandidos han comenzado un nuevo ataque!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "¡Se aproxima otra oleada de bandidos a la aldea, excelencia!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Se acerca una enorme oleada de bandidos, excelencia. Parece que es la última. ¡Tenemos que resistir!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Mi señor, la guardia informa de que el ataque ha concluido. Estamos expulsando a los bandidos que quedan.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "La población de animales se recupera. ¡Por fin podemos volver a cazar!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Los campos se recuperan lentamente, mi señor. Parece que hemos acabado con la enfermedad de los cultivos.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Los campos se recuperan lentamente, mi señor. Parece que la sequía ha terminado.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "¡La aldea está en llamas, mi señor administrador!\n\nDebemos apagar el fuego antes de que se extienda.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Excelente, mi señor.\n\nHemos apagado los incendios y la aldea es segura de nuevo.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Ya no hay incendios en la ciudad, mi señor.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Asegúrate de que el fuego no derrumbe ningún edificio.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Mi señor, la peste negra asola el territorio.\n\nTenemos que ocuparnos de los enfermos antes de que se infecte toda la aldea.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "¡Lo conseguimos, mi señor!\n\nHemos contenido la plaga y la aldea se ha salvado.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Medicina moderna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Remedios de las abuelas.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "El médico, lleno de indignación, decidió destruir la enfermería y dijo que, si eliges los remedios de las abuelas, ya no necesitas su laboratorio.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Sabia decisión, señor.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Gracias a tu elección, la atención que presta el médico es mucho más eficaz.";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Señor, muchos aldeanos ya no saben adónde acudir cuando tienen problemas de salud. ¿Deberíamos remitirlos a la medicina moderna o a los remedios de las abuelas?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Médicos y abuelas";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Vuelve a la cama.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Confío en ti.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "¡Oh, no! ¡No! ¡Deberíamos haber hecho caso al que tuvo el sueño! Algunos empezaron a desarrollar una extraña enfermedad.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Por suerte para nosotros, hemos logrado contener la enfermedad. Será mejor que la próxima vez hagamos caso de las premoniciones...";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Este townie nos ha salvado del desastre más de una vez. Construyamos una enfermería, excelencia, por si las moscas.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "¡Oh, excelencia! Ha sido terminar de construir la enfermería y caer enfermos algunos townies. ¡Menos mal que le hizo caso a ese townie! Hemos limitado los daños. ¡Bien hecho, excelencia!";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Pero aún hay que curarlos, excelencia. De lo contrario, la enfermedad podría propagarse.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "¡Espléndido! Toda la aldea está en perfecto estado de salud. Podemos volver a nuestros quehaceres.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Mi señor, anoche soñé que nuestra aldea se infectaba con una extraña enfermedad y que todos los habitantes tenían la nariz congestionada. \n\n¿Crees que podría ser un sueño premonitorio?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Tiempo de soñar";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "¡Estoy deseando que la inauguren!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Oh, yo prefería la anterior.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "No, no tengo tiempo para eso.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "No es no.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Hazla pasar.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Concedido.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Es imposible atraer a más viajeros.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "En un derroche de generosidad sin precedentes, te pones a trabajar. ¡La posada estará nadando en un mar de flores!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Bueno, vale.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = "«¡Atención, atención, buenas gentes! ¡La posada tiene una nueva dueña! ¡Venid a la posada para la nueva inauguración!»\n\nEl pregonero está de buen humor hoy. Se comenta que cada vez que acude un nuevo huésped a la posada, le dan propinas.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Excelencia, ha venido la nueva dueña de la posada a visitarnos. ¿Quiere recibirla?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Excelencia, por favor. La posada es uno de los lugares predilectos de los viajeros. Podríamos mejorar la reputación de la ciudad mejorando esta instalación.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Buenos días, excelencia. Gracias por recibirme en el castillo.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "¿A qué debemos el honor de tu visita?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Pues verás, el dueño anterior era muy descuidado, y no solo con los proveedores, también con los clientes.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Mmm, si tú lo dices. Nosotros no íbamos mucho a la posada.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "El caso es que vengo a pedirte ayuda. Me gustaría poner flores alrededor de mi establecimiento, para que luzca mejor y que atraiga a más viajeros.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Ahora pasemos al punto dos. Las bebidas.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah, que hay punto dos... Bueno, ya que estamos, sigamos adelante. ¿Qué es lo siguiente en tu programa?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Necesitamos metal y madera de primera calidad.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "¿No habías dicho que bebidas? ¿Por qué me hablas de madera?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Para hacer buenos barriles, ¡naturalmente! El anterior propietario ni siquiera tenía barriles en condiciones para conservar las bebidas. Los proveedores deben de estar usando madera mala, así que tenemos que hacernos con suficiente madera y barras de hierro para fabricarlos nosotros mismos.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "¡Genial! ¡Son preciosas!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Si te pones así. ¡Me las arreglaré yo sola!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "A partir de ahora, el pregonero mencionará a la posada en sus anuncios.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "A partir de ahora, el pregonero mencionará a la taberna en sus anuncios.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "¡Gracias, gobernador! Bien está lo que bien acaba.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Oh, ¡gracias, excelencia! La posada resulta mucho más acogedora con las flores.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Vamos, excelencia, piénsatelo: la posada es una importante fuente de ingresos para el pueblo, puede ayudarte a realizar algunos de tus proyectos.\n\n¿Seguro que no merece la pena el esfuerzo?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "¡¿Cómo dices?! ¿Ayudas a esta joven con su posada y a mí no? ¿Acaso no vas a ayudarme con mi taberna, excelencia?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Oye, dirígete al gobernador con más respeto.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "¡Exijo los mismos privilegios que esta señora!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "¿También quieres flores para tu establecimiento?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "¿Flores? ¡No! ¡Quiero un pregonero que también anuncie mi establecimiento!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Excelencia, ¿qué deberíamos hacer?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Promociona la taberna.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Promociona la posada.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "De flores y enemigos";
"T_GAME_QUEST_FEAST_TITLE" = "Organiza un festival para la aldea.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Cubre toda la aldea con torretas de vigilancia contraincendios.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "¡Mi señor, la ciudad no está preparada para incendios grandes! Algunas partes no están cubiertas por torretas de vigilancia contraincendios. Instala torretas para cubrir tantos edificios como sea posible.";
"T_GAME_QUEST_FOOD_STARTED" = "¡No nos olvidemos de la comida, señor! No habrá festival sin una despensa llena. Démonos prisa y consigamos los recursos que haya en existencias. Cuanto antes los tengamos, antes culminaremos tu proyecto.";
"T_GAME_QUEST_FOOD_SUCCESS" = "¡Los asistentes a nuestro festival no se morirán de hambre! Señor, ¡nos acercamos a la meta! ¡Estoy impaciente por verlo!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "¡Un gobernador que no es capaz de ofrecer un mísero refrigerio a una reina! ¡Me dijeron que recelara de ti, pero ¡no quise hacerles caso!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Reina Frygith, vamos, no os enfadéis por semejante bagatela. Es solo un refrigerio. No os pongáis tan dramática...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Y encima tu consejero me falta al respeto...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "La situación está totalmente fuera de control, ya no sabes qué hacer y tu nivel de estrés no para de aumentar. \n\n¿Cómo reaccionas?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Trata de calmar a la reina.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Escuchad, el gobernador siente algo por vos y no sabe bien cómo comportarse. Veréis, es la primera vez que se enamora.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "La reina se emociona. Parece que también siente algo por ti. ¿Podría ser el comienzo de una verdadera historia de amor? ¿Acertó en todo la pitonisa?\n\nSolo el tiempo lo dirá. Mientras tanto, la reina ha decidido bailar otra vez.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Han pasado varios meses desde el famoso baile, tú y la reina Frygith mantenéis una relación epistolar. A veces, viene a verte cuando el tiempo lo permite.\n\nQuizás algún día te elija como rey de su reino, pero por ahora tiene demasiado entre manos como para pensar en sí misma.\n\n¡Y tú también! Debes seguir haciendo todo lo que puedas para que tu ciudad siga funcionando como un reloj.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Los townies también se alegran por ti y por la reina. Han observado un aumento de los viajeros, vienen principalmente a probar el mosto y la bebida que se le negaron a la reina durante la fiesta. Se rumorea que estaban tan buenos que las reservas se agotaron en menos de una hora.\n\n¡Ha aumentado la productividad de estos dos edificios!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Las cartas.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Te echaré las cartas, excelencia. Ellas nos dirán un poco más sobre qué clase de persona eres y qué destino te aguarda. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Después de barajar una vez, lo hace una segunda vez.\n\nTe pide que robes tres cartas: una para el pasado, otra para el presente y otra para el futuro.\n\nTras elegir las cartas, les da la vuelta una a una.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Excelencia, estas tres cartas me dicen que vas a tener malos momentos. Deberías sospechar de la gente de la iglesia. Las cartas me dicen que en el pasado ya han intentaron acercarse a ti, aunque sin mucho éxito.\n\nEstás sobre aviso.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "¡Unas cartas maravillosas, excelencia! Todo es positivo. Conocerás a una mujer, a una gran mujer que te pondrá el corazón patas arriba. ¡Se avecina el amor! Estate preparado para cuando llame a tu puerta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Ves a la joven barajar las cartas, mientras les susurra tu nombre para transmitir tu energía.\n\nTe pide que elijas el montón de la derecha o de la izquierda.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Espero que esta predicción no se haga realidad y que la gente religiosa esté feliz en nuestra ciudad.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "A la mañana siguiente, se te acerca un monje para decirte que la iglesia necesita más recursos y que sería de agradecer otro lugar de culto más.\n\nTe acuerdas de la predicción de la pitonisa.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Excelencia, una nueva iglesia podría ayudar al despertar espiritual de la población. Muchas gracias.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Construye un nuevo lugar de culto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "¡Oh, perfecto! Le daremos muy buen uso a este nuevo lugar de culto, ya verás.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Montón izquierdo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Esta carta indica que hay una parte muy oscura en ti que te llevará a la autodestrucción. Me temo que esto afectará a la productividad de tu gente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Percibo tu confusión y noto que tu consejero te anima a marcharte. Pero quédate un rato, aún no he terminado. Te echaré las cartas por segunda vez para darte respuestas más concretas.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Excelencia, la pitonisa acierta, tenemos una visita programada para el próximo fin de semana. Tenemos tiempo suficiente para preparar una fiesta y ponernos elegantes.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Organiza una fiesta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Una buena fiesta no es nada sin comida y bebida. Empecemos por ahí, excelencia.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "¡Perfecto! Ahora tenemos suficiente comida y bebida para agasajar a nuestros invitados.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Excelencia, deberías poner todo de tu parte en esta celebración. Imagínate que en ella conoces a tu media naranja.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Tal vez tu consejero tenga razón, así que decides ponerte tus mejores galas. La ciudad está radiante, no dudas ni por un segundo en mostrar tu riqueza.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "¡Esto quedará para los anales de la historia! Seguro que impresiona a tu potencial amada.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Montón derecho.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "¡Eres una persona cariñosa y las cartas me dicen que eso afectará a la productividad de tus ciudadanos!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "La bola de cristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Buena elección, gobernador. Por favor, acércate y mira la bola de cristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "La pitonisa se inclina sobre la bola de cristal y le pasa las manos. De repente, aparece un humo azul.\n\n«Oh, excelencia, una gran desgracia se cierne sobre ti. Veo monjes. Quizás sean ellos la causa de tu infortunio», te dice en voz baja y melancólica.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "La pitonisa se inclina sobre la bola de cristal y le pasa las manos. De repente, aparece un humo rosa.\n\n«¡Oh, excelencia, vas a encontrar el amor! ¡El verdadero amor! ¡Vas a vivir una historia increíble, te lo aseguro!», te dice con mirada confiada.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Vete a llorar a tu cuarto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Preso del pánico, huyes del salón de baile y te refugias en tu habitación para llorar desconsoladamente sobre la cama.\n\nTodo indica que estás sufriendo mal de amores. Y solo el tiempo podrá curarlo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Tardas varios meses en recobrarte poco a poco de tu pena de amores.\n\nEn todo ese tiempo, la reina Frygith nunca se ha interesado por cómo estabas, no le importas nada.\n\nPor otro lado, has hecho historia y ahora apareces en los libros como el gobernador enamorado, con lo que te ganas la simpatía de la gente. Ahora trabajan con mayor diligencia.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Tráele una bebida.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "En compañía de tu consejero, decides ir a ver a la pitonisa. A lo mejor la adivina puede ayudarte a prevenir infortunios, o tal vez te dé buenas noticias.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "La tienda de la pitonisa es pequeña y no queda lejos del castillo. Entras en ella y te ves rodeado de un montón de objetos místicos. En cierto modo, te calma.\n\n«Ah, excelencia, siéntate. Me alegro de que hayas aceptado mi invitación. ¿Qué método prefieres?»";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Tráele un poco de mosto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Contemplas los desfiles desde lo alto de tu castillo. De repente, a lo lejos, ves venir una procesión; tu atención se centra en una bella mujer. Tu corazón se desboca. \n\n¿Esto es el amor a primera vista?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Loco de amor, decides salir al encuentro de la bella desconocida. Bajas los escalones de cuatro en cuatro. Tu consejero, que está a tu lado, no entiende qué te pasa.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Excelencia, es la reina Frygith. No sé por qué motivo salís a recibirla tan rápido.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Gobernador, encantada de conocerte.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "La reina Frygith te deslumbra con su presencia, no sabes cómo actuar. Por suerte, tu fiel consejero acude al rescate y te ayuda a recobrar la compostura.\n\nDecides invitar a la reina Frygith al baile de esta noche, con la esperanza de que acepte esta primera cita romántica.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Reina Frygith, el gobernador os invita al baile de esta noche como acompañante suyo. ¿Nos haríais el honor de aceptar?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "¡Eso es totalmente inapropiado! Estoy prometida al duque de Cannes, no me pueden ver en los brazos de un gobernador.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Estaré encantada de aceptar la invitación.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "Llega la hora del baile. Has pedido a los músicos más prestigiosos que toquen para ti esta noche, quieres que todo salga a la perfección para tu amada.\n\nPor fin llega la reina Frygith, con un elegante vestido. Cada segundo que pasas en su presencia afianza tu amor.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "La música toma forma, la reina Frygith también parece estar bajo su hechizo. Es hora de un descanso y te pide un pequeño refrigerio.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "No tienes nada que ofrecerle.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Rechaza la invitación.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Has hecho lo correcto, gobernador. Vete a saber en qué clase de problemas nos habríamos metido.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Con el corazón destrozado, decides no asistir al baile. Estás apenado mucho tiempo y eso se refleja en tu ciudad. La productividad y la felicidad de los habitantes están disminuyendo. Esperemos que no te dure.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Empiezas a ver la luz al final del túnel y superas tu tristeza. Poco a poco, comienzas a salir de tus aposentos.\n\nLa gente se alegra de tu recuperación y eso afecta positivamente a su productividad y moral.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Gracias, gobernador, eres un hombre encantador. ¿Te gustaría aprovechar esta velada para negociar acuerdos comerciales? Así tendríamos la oportunidad de volver a vernos...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Te dejaré con la reina, gobernador.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "La reina y tú os vais al jardín real para estar solos, como en los cuentos de hadas. El tiempo se detiene para ti y para la reina Frygith. Haces acopio de tu coraje y compartes tus sentimientos, y ¡resulta que los sentimientos de la reina son recíprocos!\n\nPor desgracia, se hace de día y la reina debe marcharse. Tiene muchas cosas que hacer en su país. Y tú sabes que no es nada fácil dirigir un país sin ayuda.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Los townies también están felices por ti. Son menos propensos a las huelgas, lo cual es una gran noticia.\n\nAl final, acertaste al consultar a la pitonisa.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "¡Iré encantado!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Oh, excelencia, es terrible. La gente está completamente desmoralizada por tener que a ir a la iglesia. No aguantan más. ¡Recemos para que lo superen! ¡Fue una mala decisión obligarles a asistir al servicio!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Ya quedó atrás todo este asunto de la iglesia y de la pitonisa. La gente empieza a recobrar su felicidad.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Esta decisión ha sido beneficiosa para nosotros, excelencia. Hiciste lo correcto al hacer obligatorio la asistencia al servicio. Ahora los townies están más contentos y son más productivos.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "El líder religioso de tu villa vuelve para verte.\n\n«Excelencia, quisiera preguntarte algo: ¿podrías hacer que la asistencia al servicio fuera obligatoria? Verás, con tantas pitonisas por estos lares, me temo que nuestra gente sea fácilmente influenciable. Me gustaría salvarlos antes de que sea demasiado tarde».";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Acepta la solicitud.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "¡Te prometo que no te arrepentirás, excelencia!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Rehúsa la solicitud.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Ya entiendo, excelencia. Fue la pitonisa quien te hizo cambiar de opinión. ¡Debería haberse mantenido lejos de ella!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Puesto que la religión tiene tan poca importancia para ti, ¡destruiremos los lugares de culto! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "¡Excelencia, es horrible! ¡Los monjes, enojados, están destruyendo edificios en la ciudad! Y no pudieron atraparlos, ¡huyeron! Así aprenderás a no consultar a pitonisas, mira adónde nos ha llevado.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Como consejero tuyo, ¡no permitiré que vuelvas a ver a una pitonisa en tu vida! Ahora volvamos al trabajo, excelencia. La población está de un humor de perros.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Excelencia, esta tarde han llegado al pueblo algunos viajeros, entre ellos una pitonisa. Te manda una invitación para leerte el futuro.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "La pitonisa";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Pues que dejen de comer pescado. ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Haz indagaciones.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Destruye cabañas de pescadores.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "¡Es horrible! A falta de algo mejor, los habitantes siguieron comiendo pescado y ¡se propagó la enfermedad!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "La enfermedad está controlada, señor. Tuvimos suerte de librarnos.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Estos controles de calidad cuestan un ojo de la cara, pero siempre es mejor que sufrir una epidemia";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Todas las cabañas de los pescadores han sido revisadas y el pescado vuelve a ser comestible. Has hecho bien en optar por esta inversión. Hemos evitado graves problemas.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "La destrucción de las cabañas de estos pescadores nos ha permitido acabar con la posible contaminación del pescado, aunque es una lástima haber tenido que derruir unos edificios tan bonitos.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Gobernador, no quiero ser quisquilloso, pero he de admitir que tu pescado... no es lo que era... No sé si será por el río o por otra cosa, pero ¡sabe asqueroso! Como no tomes cartas en el asunto, ¡alguien acabará enfermando!";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "¡Pescado fresco!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Alcanza una satisfacción alta con la comunidad.";
"T_GAME_QUEST_GETREWARD" = "Pague!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Señor, no sé cómo decirlo... Toma aire. ¿Estás listo? Resulta que... varios aldeanos dicen haber visto un conejo gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Sí, ¿y qué?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "¡¿UN CONEJO GIGANTE?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "¡¿Como que Y QUÉ?! Pero ¡señor! ¡Es absolutamente aterrador! ¡Imagínese si salta por el castillo y nos destroza las casas!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Para las pocas casas que tenemos...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "¡Actuemos con RAPIDEZ!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Ah, esa reacción es más lógica, señor.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Construyamos una cabaña de cazador.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Envía una carta a palacio, que nos envíen un emisario.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Pese a lo que organizamos para cazar al conejo gigante, no pudimos dar con él. Eso sí, pero ahora tenemos muchas reservas de comida...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "¿Alguna pista?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Yo cumplí con mi deber, ahora voy a echarme la siesta.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "El emisario ha llegado, señor.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Exijo la ayuda del Ejército Real.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Acompaña a este emisario a ver las pruebas.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "¿Qué es lo que oigo? ¿Un conejo gigante vagando por estas tierras? ¿No te habrá dado una insolación?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Mmm, ya veo. Huellas de conejos gigantes... No es más que un cuento para niños crédulos: «El conejo gigante vendrá mientras duermes y te arrancará las orejas.» ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "¿Y luego qué? Tengo mejores cosas que hacer.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Ve a la bruja.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Podríamos ir a la bruja a pedirle consejo. Tal vez sepa algo sobre el infame conejo gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Te estaba esperando. Los cuervos predijeron que vendrías. ¡Qué ruidosos eran! Aunque bastante menos molestos que los saltos de ese conejo.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Reza.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Usa magia.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "No hagas nada.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "¡¿Así que es verdad?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "¡Pues claro que sí! Estabas tardando en venir. Afortunadamente, aún hay tiempo. Tienes varias opciones que sopesar.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Veo que no le importan nada sus ciudadanos, señor... Eso acabará siendo contraproducente.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Muy bien, construyamos dos cabañas de cazadores y consigamos carne. Quién sabe, con un poco de suerte, encontraremos la madriguera del conejo gigante.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Esa es mi especialidad. Te haré una pequeña poción, pero tienes que traerme unos ingredientes. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Bueno ¿qué? ¿Vas a darme los ingredientes?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Muchas gracias, señor. ¡Maldición! Ahora se me ha olvidado la otra mitad de los ingredientes.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "No tenemos todo el día, señor. Tengo que hacer una poción. ¿Por qué no me das los ingredientes ya?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Muchas gracias, señor. Toma la poción. Pon un poco en el pozo de la villa y espera un rato. El conejo gigante se irá sin más después de olerlo.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Señor... tenemos que construir baños públicos y añadirles un montón de aceites esenciales para quitarles a los townies ese hedor... Es espantoso.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "¡Genial! El pueblo por fin puede respirar tranquilo.\nEl conejo ha desaparecido sin dejar rastro, es como si hubieran sido imaginaciones nuestras. Por el momento, volvamos a nuestros quehaceres, señor.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Después de todo, el conejo se ha ido él solito. En uno de sus últimos saltos, desenterró un cofre escondido por bandidos hace mucho tiempo y que contenía 2000 monedas de oro. ¡El rey nos encuentra dignos de recibir prestigio!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Bueno.... hizo falta un conejo gigante para que por fin te plantearas la construcción de una iglesia.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Apresurémonos en construir la iglesia y congreguemos a los habitantes en ella para rezar.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Ya solo resta esperar a que la divinidad haga su trabajo.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "El conejo ha desaparecido sin dejar rastro, es como si hubieran sido imaginaciones nuestras. Por el momento, volvamos a nuestros asuntos, señor.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "¡Ay! Yo hubiera elegido la poción, pero tú mandas. Buena suerte, señor, con las desgracias que acaecerán.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "El conejo gigante";
"T_GAME_QUEST_INN_STARTED" = "Señor, hará falta alojamiento adicional. ¿Por qué no construimos una posada? Así, podremos satisfacer las necesidades de los visitantes al festival.";
"T_GAME_QUEST_INN_SUCCESS" = "Bueno, una cosa hecha. Ahora pensemos el resto de los preparativos.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Es demasiado arriesgado.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "¿Por qué no?";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "El guasón.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "¡La corte del rey está encantada! ¡Es justo lo que necesitaban! ¡El prestigio es nuestro! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "La townie de los acertijos.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Por desgracia, los acertijos... eran demasiado complicados para ellos. La corte del rey hubiera preferido algo menos intelectual. No ganaremos prestigio esta vez.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "El townie acróbata.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "¡La corte del rey está asombrada con el talento de este acróbata! El rey nos enviará algo de prestigio como recompensa.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Tienes razón, quién sabe qué nos pasará si el rey no queda satisfecho con nuestros candidatos.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Señor, hemos recibido un mensaje de la capital. El rey está decepcionado porque ninguno de nuestros ciudadanos le ha ofrecido sus servicios. Por suerte, no nos censurará por algo tan insignificante. ¡El rey es muy misericordioso!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "He encontrado tres candidatos potenciales. ¿Cuál deberíamos enviar?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Mi señor, el rey desea tener a alguien en la corte que lo entretenga. ¿Enviamos a potenciales candidatos para el nuevo puesto de bufón?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "El bufón de la corte";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Arregla el techo.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "¡Hay que arreglarlo lo antes posible!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Ahora no.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Tenemos otras prioridades en estos momentos. El festival de la lavanda comienza pronto y los preparativos no están listos.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "Ya que sale el tema, deberíamos terminar de prepararlo todo.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "¡Así está mejor! ¡Esto promete ser un evento muy lucrativo!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Excelencia, he oído que los mercaderes de lavanda apreciaban mucho nuestra catedral. Son reacios a acudir a nuestro festival.";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "El festival de la lavanda se desarrolló sin problemas... Sin embargo, no tuvimos tanta afluencia de visitantes como otros años. Este evento no nos ha aportado prestigio.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "¡Trato hecho!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Démonos prisa y produzcamos la mercancía para la reina.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Ya solo queda hacer el trueque.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Es un placer hacer negocios contigo.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "¡Excelencia! ¡Tengo malas noticias! ¡El símbolo mundial de nuestra cultura se incendió anoche y el techo de la gran catedral se ha derrumbado!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Los expertos dicen que no tenemos suficiente madera noble en nuestras tierras para arreglarlo, pero la reina Frygith sí que tiene los recursos necesarios, ¿le pedimos ayuda?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Pide ayuda.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Mandas sin demora un mensajero a la reina. \n\n«¡Ayúdame, reina Frygith! ¿Me prestas esta noble madera de tu tierra? Mi catedral se está cayendo a trozos.»";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Hola, querido, llegas justo a tiempo ya que tengo que abastecerme de mosto. ¿Te interesa un trueque?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Excelencia, con esta oferta saldremos perdiendo...";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Sopesas los pros y los contras del trato. Quizá la reina sea la solución a tus problemas... A no ser que haya otra manera.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Piensa en ello.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Esta solicitud podría dañar nuestra reputación, procederemos de otra forma. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "A tu consejero no le falta razón. Pedirle ayuda a la reina Frygith te obligaría a depender de su buena voluntad. Y si alguna vez hay algún problema, te arriesgas a perder mucho.\n\n¿Por qué no usar piedra? Tienes mucha en las canteras.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "¡Fue una buena decisión, excelencia! Somos libres e independientes.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "El festival de la lavanda es un éxito. Las recientes historias sobre la restauración de la catedral han despertado un gran entusiasmo que nos ha beneficiado.";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Nunca me gustó la lavanda.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "¡Bueno, está bien! Lo arreglaremos.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Indignante.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "¡Excelencia, eso suena a chantaje! Usemos piedra en vez de madera, ¡así no tendremos que negociar con la reina!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Está bien, no lo olvidaré, querido.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Rey de la madera";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Me ocuparé de ello.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Si no están contentos, que no vengan más.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "Es cierto que a los mercaderes les vendría bien un lugar específico para ellos, además del mercado. Un gremio de mercaderes sería el edificio perfecto, excelencia.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "¡Maravilloso, excelencia! Gracias por aceptar. ¡Estaremos eternamente agradecidos!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Un gobernador moderno como tú debería haber aceptado la petición de los mercaderes...";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Excelencia, vengo como representante de los comerciantes. Para mostrar nuestra decepción, ¡no vendremos a tu ciudad un tiempo! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Excelencia, la federación de comerciantes exige que construyas edificios que les permitan desarrollar sus actividades.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Falta de espacio";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "La ciudad sufre una invasión de ratones. Son menos peligrosos que las ratas, desde luego, pero aun así... ¡tenemos que hacer algo!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Excelencia, se ha fundado la Academia de Gatos Cazarratones, pero... debemos cuidar de su bienestar y alimentarlos. Y también proporcionarles suficiente pescado.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Ya tenemos suficiente pescado para cubrir el amaestramiento. Algunos reclutas ya han capturado muchos ratones, excelencia.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Excelencia, deberíamos premiar a los mejores gatos con hierba gatera. Para reducir su estrés.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "La efectividad ha aumentado notablemente entre los gatos cazadores, excelencia. Los amaestradores están haciendo un buen trabajo con los gatos y solo queda un pequeño número de ratones.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Los ratones ya no son una molestia, excelencia. Enhorabuena por las decisiones que han permitido este resultado.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Prepara un plan.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Decides irte a desayunar. Mientras te comes una tostada, ves un ratón en un rincón de la estancia. Ya están incluso en el castillo. Y de repente, ves a Chouquette, tu fiel gato, dando un salto y zampándose al ratón en un abrir y cerrar de ojos. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Eso te da una idea. Das instrucciones a tu consejero para que atrape tantos gatos como sea posible y los amaestre para cazar ratones, incluso a los gatos domésticos. Quieres que los gatos acaben con los ratones.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Vuelve a dormirte.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Cuando te despiertas, hay tantos ratones por todas partes que cuesta andar sin pisar uno. ¡Todos tus habitantes van más lentos!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Pasado mucho tiempo, los ratones acaban yéndose solos. Esconderse de los problemas en la cama no siempre es la solución.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Gato y ratón";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "En la parte derecha puedes ver las influencias activas en la actualidad.\nAlgunas están solo activas temporalmente y pueden cambiar en el transcurso de una escena.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Mi señor.\nCon el debido respeto, parece que no te has percatado de lo infelices que son los aldeanos. Esto no puede seguir así.\nAdemás, los bienes que producimos no se procesan correctamente.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Ahora sabes las influencias que se ejercen sobre la aldea. Quizá te hayas fijado en que esos bandidos merodean por la zona, y el nivel de felicidad general de la ciudad se ha reducido por su presencia. ";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Entra en el menú de pausa para ver las influencias actuales en este mapa.";
"T_GAME_QUEST_MIL_TUT_02_START" = "¿Serías tan amable de visitar el aserradero? \n¡Tenemos que parar la producción! ¡Hay poca madera y demasiados tablones!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "¡Para obtener información sobre un edificio, solo tienes que visitarlo!\n\nEl menú contextual muestra información muy útil sobre el edificio, sus trabajadores, y las cadenas de producción relacionadas. Mientras estás en este menú, el juego está en pausa.";
"T_GAME_QUEST_MIL_TUT_03_START" = "El aserradero necesita más leñadores para producir tablones con más eficacia. Debemos pararlo hasta que hayamos construido más casetas de guardas forestales y acumulado más recursos.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Mi señor, debes evitar que los recursos bloqueen el almacén. \nSi necesitas espacio, puedes usar la opción de destruir recursos que aparece en el menú de estadísticas.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Acceda al menú de almacén.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Debería evitar que los recursos bloqueen el almacén, mi señor.\nCuando necesite espacio en el almacén, puede usar la función Destrucción de recursos en la pestaña Almacén del menú.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Destruye tablas hasta que queden menos de 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Destruye tablones para hacer espacio en el almacén.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "No te tomas mis amenazas en serio, gobernador. \n\n¡A partir de ahora se acabaron los buenos modales!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Has construido una aldea muy bonita, qué pena que esté en mi territorio.\n¡Entrégame joyas y ropas! Y rápido, o acabo con tu aldea.";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Es impresionante el efecto que causa una pequeña amenaza. Nunca pensé que me enviarías esos bienes.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Entrega un tributo a los bandidos.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Mis chicos están muy aburridos. Los enviaré a hacer una pequeña excursión...\n\n... ¡A POR TI!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "¡Como ves, me llevaré lo que quiera!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Buenos días, mi señor.\n\nMe presento ante ti por orden del rey. Me envía a enseñarte el arte de la guerra.\n\nTus problemillas con los bandidos pronto serán historia.";
"T_GAME_QUEST_MIL_TUT_10_START" = "\nLos barracones son los cimientos de tus operaciones militares en la zona y ofrecen la posibilidad de construir y aprovisionar a las torres de vigilancia. Los soldados solo combaten bien si reciben los suministros suficientes.\nDebes colocar torres para cubrir tantas zonas de la aldea como sea posible.\n\nConstruye un barracón y una torre de vigilancia, mi señor.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Está claro que has recibido ayuda de un caballero...\nEstoy empezando a temblar de miedo.\n\nA ver lo que puede hacer tu ejército contra mis chicos...\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Los bandidos están incendiando nuestros edificios. ¿Dónde están los bomberos cuando se les necesita?\n\nCuando quieras saber dónde se encuentra un townie, selecciona la opción «busca a mi townie» en el menú contextual de edificios.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Aquí puedes ver lo que hacen los trabajadores en este momento.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Produce cerveza y salchichas.";
"T_GAME_QUEST_MIL_TUT_14_START" = "Nuestros soldados necesitan cerveza para armarse de valor, excelencia.\n\nPara obtenerla debes ordenar la construcción de un monasterio y un secadero de lúpulo.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Nuestros soldados necesitan cerveza, mi señor.\nPara obtenerla debes ordenar la construcción de un monasterio y crear algunos campos de lúpulo.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "La cervecería del monasterio necesita recursos de otros edificios.\nObtiene lúpulo seco del secadero. Una granja y un pozo la abastecen de trigo y agua.\n\nAsí los monjes podrán empezar a producir cerveza, excelencia.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "En el monasterio puedes ordenar a los monjes que cosechen lúpulo o procesen cerveza.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Construye un monasterio y un secadero de lúpulo.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Construye un monasterio y crea campos de lúpulo.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Para producir salchichas necesitarás una granja porcina y una carnicería, mi señor.\n\nA nuestros soldados les encanta el delicioso sabor especiado de las salchichas. El granjero puede recolectar las especias necesarias en el huerto de finas hierbas.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "La carnicería puede producir carne normal además de salchichas, que apasionan a nuestros soldados.\nEs una buena alternativa para no depender tanto de la caza en los bosques.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Construye una granja porcina y una carnicería.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "¡Más te valdría fortalecer tus defensas!\nHasta la próxima... y gracias por los recursos.\n";
"T_GAME_QUEST_MIL_TUT_16_START" = "¡Cerveza y salchichas!\n\nA mis chicos les encantan. Deberías compartir tu producción de esos manjares conmigo.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Esta vez has tenido suerte, gobernador. La próxima enviaré a más de mis chicos.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Defiende tu aldea";
"T_GAME_QUEST_MIL_TUT_17_START" = "Hay que hacer mejoras en la aldea, la mayor parte no está bien defendida. Tenemos que cubrir más zonas con torres de vigilancia.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Ahora casi toda la aldea está bajo la protección de nuestros soldados. A los bandidos ya no les resultará tan fácil robar, mi señor.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Cubre al menos el 50 % de la aldea con torres de vigilancia";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Si quieres más información sobre asuntos militares, puedes entrar en la pestaña militar de la pantalla de estadísticas.";
"T_GAME_QUEST_MIL_TUT_19_START" = "¡Nuestros soldados necesitan armas y armaduras!\nLas armas aumentan el poder de ataque, y las armaduras la capacidad defensiva.\n\nDe modo que hay que construir una armería. Para fabricar armaduras necesitaremos también una curtiduría para obtener cuero.\nLas pieles de animales las suministrarán los cazadores o los carniceros.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Construye una curtiduría y una armería.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Señor,\nes hora de aumentar el tamaño de tu ejército. Así podrás enviar una partida a destruir el campamento de los bandidos.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Agranda tu ejército.";
"T_GAME_QUEST_MIL_TUT_21_START" = "¡Llegó la hora, gobernador!\n\nAhora atacaremos a ese canalla, el jefe de los bandidos. Su campamento está oculto en el bosque.\nSolo tienes que seleccionar el campamento de bandidos y ordenar el ataque con un grupo razonable de soldados.\n\n\n¡Buena caza!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Destruye el campamento de bandidos.";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Me alegro de verte, mi señor.\nMe acaban de robar los bandidos por tercera vez esta semana. ¡Tenemos que hacer algo para detener a esos canallas!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Una gran victoria, mi señor.\n¡Hemos dado una buena lección a esos bandidos. La región ya es segura de nuevo, el rey estará muy satisfecho. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Completa el entrenamiento básico y acaba con los bandidos.";
"T_GAME_QUEST_NEW" = "¡Nueva misión!";
"T_GAME_QUEST_NEW2" = "¡Nueva misión:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "No hay tiempo para eso.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Tienes razón.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Muy bien, excelencia, no hacemos nada entonces respecto al pésimo pan. Ya puedo oír las quejas sobre la mala calidad de comida. Pero, tú mandas, excelencia.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "¡Oh, señor, el pan está ahora delicioso! El precio de venta también está subiendo.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = "«El trigo es asunto tuyo, tienes que atajar el problema de raíz. Dile al molinero que use agua más limpia y que la levadura sea de buena calidad».\n\nEl consejero transmite tu sabiduría al panadero y te promete que el pan será mejor.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Señor, tenemos que hacer algo. El pan ya no es lo que era. Ha venido mucha gente a quejarse de su calidad. Deberíamos cambiar la receta.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Una receta nueva";
"T_GAME_QUEST_NOQUEST" = "No hay misiones disponibles.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Apurémonos y produzcamos escudos y armas. Si estas personas son peligrosas, es más seguro estar preparados.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Gobernador, hemos terminado los preparativos para la defensa de la ciudad.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Tus soldados informan de movimiento de tropas en el norte, en la zona del desierto más grande del reino.\n\nSin embargo, sabes que nadie estaría tan loco como para intentar un ataque por ese lado de tus fronteras. Decides ignorar esta amenaza. Que pase lo que tenga que pasar.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Unos días después, tus soldados informan de un grupo de personas que vienen directamente del desierto del norte y que llegarán al pueblo en unas horas.\n\nPodrían ser solo viajeros, pero quién sabe, ¡quizás sean peligrosos bandidos que pretenden invadir tu aldea!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Prepara las defensas.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Prepara un caluroso recibimiento.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "El desierto del norte";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Un grupo de diez personas se acerca a tu ciudad. Tus soldados están en guardia, esperando tus órdenes.\n\nDejas que se acerquen. El líder de este grupo camina solo hacia las puertas del pueblo: «Buenos días, mi buen señor, acabamos de cruzar el desierto del norte. ¿Podríais ofrecernos vuestra hospitalidad por una noche?».";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Podéis entrar en nuestra bella ciudad y hospedaros en la posada, donde tenemos espacio suficiente.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Mientras tu consejero te acompaña a casa, sigues con la mosca detrás de la oreja. ¿Por qué arriesgarse a cruzar el desierto cuando podían haber venido por el río? ¿Por qué elegir una ruta tan peligrosa si no es para esconderse?\n\nA lo mejor tus espías podrían averiguar algo más sobre ellos. O podrías irte a la cama y olvidarte del tema.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Vete a la cama.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Envía a un espía.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Tu espía se quedó despierto toda la noche y se las arregló para escuchar algunas conversaciones en la posada: los viajeros están huyendo. Les acusan de varios delitos en su país, al otro lado del desierto. El ejército viene tras ellos y están preparando la ruta para continuar su huida de la justicia.\n\n¿Cuál es la mejor solución?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Encierra a los viajeros.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Acabamos de recibir un mensaje del rey: unos peligrosos criminales se han escapado de una prisión del país vecino, son unos diez y han robado un objeto precioso. ¿Serían los viajeros que estuvieron aquí hace unos días?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Envía un mensaje al rey.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "No se lo digamos a nadie.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Enviaré un mensaje al rey para hacerles saber que han pasado por nuestra villa. Tal vez puedan encontrarlos.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "¡Excelencia! El Ejército Real ha conseguido atrapar a estos peligrosos individuos y recuperar el tesoro robado.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Gracias por tu ayuda, gobernador. Esta gente había robado una de mis preciosas joyas. Estaban planeando venderla en el mercado negro. Hiciste lo correcto al informarme de su presencia en tu ciudad.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Muy bien, excelencia. Si alguien nos pregunta, diremos que no sabemos nada.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Hace tiempo que no pasa nada emocionante en la ciudad, pero hoy tienes la sensación de que algo va a cambiar.\n\nY tenías razón, tu consejero te trae una carta de los viajeros buscados por el ejército real, que dice lo siguiente: \n\n«Gracias por no denunciarnos, gobernador. Verás, fuimos víctimas de un complot y toda nuestra familia corría gran peligro. Como no revelaste que habíamos pasado por tu aldea, tuvimos tiempo de encontrar pruebas de nuestra inocencia. Sin ti, hubiera sido imposible. Por favor, acepta este regalo como muestra de gratitud. Eres un buen gobernador».";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "He liberado a los viajeros, excelencia, como ordenaste. Espero que no sea contraproducente.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Los viajeros te agradecen la amabilidad y prometen que, una vez demostrada su inocencia, te recompensarán como muestra de gratitud.\n\nEsperas sinceramente haber tomado la decisión correcta y que los viajeros no te hayan engañado con mentiras.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Han pasado varios meses desde la última vez que supiste de los viajeros. A veces te acuerdas del episodio. No tuviste problemas con el rey, pero tampoco recibiste la supuesta recompensa.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Cuando, de repente, una luminosa mañana, tu consejero acude a traerte un paquete con una carta. Contiene un mensaje de los misteriosos viajeros expresándote su agradecimiento. En el paquete puedes ver la recompensa prometida. Prestigio además de oro.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Te alegras de haber acertado y de que no te engañasen.\n\nTu consejero informa de que te has convertido en un héroe para estos viajeros y la gente se pone a aplaudirte. ¡Para estos momentos vive un gobernador!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Excelencia, los viajeros dejaron la posada por la mañana temprano, parecían tener prisa.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Los viajeros esperan tu respuesta; algunos parecen agresivos, otros tienen miedo:\n\n«No puedo ofreceros hospitalidad, viajeros, no tenemos sitio suficiente para vosotros esta noche».\n\n«¡MENTIRA!», grita de repente uno de los viajeros al tiempo que carga contra ti blandiendo su espada.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "¡Proteged al gobernador!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "¡Deprisa, excelencia! ¡Deprisa! ¡Salgamos de aquí!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Conseguiste refugiarte en un escondite junto con tu consejero, que parece muy asustado: «Excelencia, ¡¿qué vamos a hacer?! Estos pérfidos viajeros están arrasando el pueblo y ¡no podemos hacer nada! ¡Deberíamos haber preparado nuestras defensas en vez de panecillos!»\n\nPor desgracia, lo único que podéis hacer es esperar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "A primera hora de la mañana, te atreves a salir de tu escondite. El pueblo no ha sufrido daños; parece que los viajeros se limitaron a dejar fuera de combate a los guardias y a llevarse unas cuantas provisiones para el resto de su viaje.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Por suerte, habíamos previsto esa posibilidad, excelencia. Con las armas y escudos que hemos producido, podremos repelerlos. Estoy seguro de ello.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Excelencia, hemos logrado capturar a todos los viajeros. Los hemos encerrado en la cárcel, ahora hay que tomar una decisión.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Cada vez son más raros estos viajeros. Una vez encarcelados, te sientes un poco más seguro. Sin embargo, algo te preocupa.\n\n¿Que debes hacer?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Interrógalos.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Notifica al rey.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Muy bien, excelencia, voy a hacerles unas preguntas para aclarar esta historia.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Tu consejero vuelve y te informa sobre los viajeros. \n\nHan huido de su país porque los habían acusado injustamente. La prueba de su inocencia se encuentra más al sur, en una de las ciudades cercanas.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Déjalos marchar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "¡Avisaré al rey para que el Ejército Real venga a llevarse a estos peligrosos criminales!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Llega el Ejército Real y entregas a los viajeros. El rey te envía una recompensa por proporcionar la información necesaria para capturar a estos peligrosos individuos.\n\nTu villa se recupera poco a poco mientras tú retomas tranquilamente tus tareas como gobernador.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Tu espía cometió un error y los viajeros lo vieron. Lo han cogido de rehén y piden un rescate para devolvértelo con vida.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Vamos a perder mucho dinero, pero al menos nuestro espía estará a salvo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Gracias, excelencia, por pagar el rescate para liberarme. Temía por mi vida. ¡Ser espía es un trabajo de lo más peligroso!";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Es una gran idea. Debemos preparar comida para estas personas cuando lleguen a nuestra puerta. Nos bastará con pan y pescado.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Perfecto, ahora lo único que tenemos que hacer es esperarlos.";
"T_GAME_QUEST_PLACE_STARTED" = "¡Ahora toca construir el lugar apropiado para un evento de semejante magnitud!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Madre mía, ¡es increíble! Y pensar que nada de esto hubiera sido posible si los guardias no hubieran mostrado tanto entusiasmo. ¡Qué gran idea tuviste al aprovechar esta oportunidad! El festival promete ser todo un éxito.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Planta más flores.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "No hace falta.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "¡Precioso! Las flores son increíbles, su aroma me transporta al séptimo cielo.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Eres una persona horrible. ¡Nuestra ciudad habría estado mucho más bonita con flores!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Ya es primavera, mi señor. A la aldea le vendría bien tener más flores.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Pétalos bonitos";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "El aserradero se ha quemado, mi señor. ¿Quiere ordenar la reconstrucción? ¡Necesitamos el edificio para producir tablas!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Reconstruir el aserradero.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "No le des nada a nadie.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Redistribuye las ganancias a los townies.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Invierte este dinero en las minas.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Señor, las arcas están a rebosar y la redistribución de parte de ese dinero sería beneficioso para la ciudad.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Los aldeanos se han enterado de tu decisión. No están contentos. Intenta mostrar un poco más de interés por tu gente, señor.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "En la productividad de los townies ya no influye la decisión que tomaste sobre la redistribución de las ganancias. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "¡Has hecho muy felices a los townies! ¡Están encantados!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Excelente iniciativa, señor. Empecemos a construir minas y a extraer recursos.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Invertir el dinero que teníamos en la construcción de nuevas minas es probablemente la mejor decisión que hayamos tomado nunca, y con estos recursos podremos mejorar nuestro desarrollo.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Eres muy generoso, excelencia. Este dinero les permitirá mejorar su vida cotidiana.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Redistribución de ganancias";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Hemos tenido suerte, excelencia. Las cosechas no se han visto afectadas, los jabalíes se han ido y ya no tenemos que preocuparnos de ellos.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Los jabalíes han destrozado nuestras cosechas, excelencia. Se dirigen a la granja. Es una hecatombe.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "La población está desolada por esta pérdida, que ha afectado a su felicidad y productividad.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Excelencia, nuestras cosechas están empezando a compensar el daño que causaron los jabalíes hace tiempo. Los cultivos vuelven a crecer y la gente empieza a olvidar lo que pasó.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Como resultado de tu decisión, ¡la población se siente ignorada! Esperemos que los jabalíes no estropeen las cosechas.";
"T_GAME_QUEST_REWARD" = "Recompensa:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "¡Te doy la bienvenida, administrador!\n\n¡Mira qué costa! Espero que tu ciudad sea digna de estas vistas.\nCuida a tus townies y no olvides pagar los tributos a tu rey para poder seguir sirviéndole.";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Préstamo del tesoro del rey";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Gobernador, \nSi andas escaso de fondos, la corona te puede hacer un pequeño préstamo para ir tirando.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "¡Bienvenido a nuestra humilde villa, gobernador!\nLa región está dividida por un risco montañoso. Hay depósitos de minerales al suroeste del risco, mi señor.\n\nEstoy deseando trabajar contigo.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "¡Bienvenido, gobernador!\n\nSoy la reina Frigyth, monarca de este reino. He solicitado tu ayuda para que esta villa alcance su verdadero esplendor. La tierra es rica en recursos, así que no te resultará difícil. No me decepciones.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Mi señor, contempla la inmensidad de esta región. ¡Llanuras en todas direcciones! En un futuro próximo, podremos construir una ciudad de grandes dimensiones, ¿no crees?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Saludos, gobernador.\nA orillas de este majestuoso río tenemos muchas posibilidades de prosperar. Hay vastas zonas de pesca y las minas rebosan de mineral. Aquí estableceremos una ciudad floreciente en nombre del rey.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Maravilloso, gobernador.\nEste cañón alberga una de las rutas más importantes para cruzar las montañas. La aldea goza de una ubicación ideal para alojar a los mercaderes de paso. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Mi señor, al fondo de esas cataratas hay mucha pesca. Además, la abundancia de mineral hace que esta región sea ideal para establecer nuestra aldea.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Bienvenido al Enclave Helado, mi señor.\nNo es fácil para los Townies subir hasta el castillo, pero la vista de las llanuras justifica el esfuerzo. Desde aquí, tus tierras parecen no tener fin.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Buenos días, excelencia.\n\nContempla las colinas de tu territorio. ¿No es una vista magnífica? Es un lugar maravilloso para establecer una aldea, excelencia.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Buenos días, mi señor.\n\nBienvenido a nuestra pequeña villa. Dicen que El Foso lo creó una estrella que cayó del cielo. Esperemos que nos traiga suerte. El rey ya nos ha escrito para decirnos que pronto tendrá algunas tareas para nosotros.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Tributo al rey.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festival para los townies.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Donación para los pobres.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Festival de elaboración de cerveza en la aldea.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Vende cerdos en el mercado.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Comercio en el mercado de animales.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Vende animales en el mercado.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Raciones para el ejército.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Equipo para los soldados del rey.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Rechaza todos los ataques de bandidos.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Destruye los campamento de bandidos.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Bienvenido seas, corregidor. ¡Mira qué costas tenemos! ¡Espero que tu ciudad esté a la altura de este hermoso paisaje!\nCuida bien a tus townies y, si quieres seguir a mi servicio, no olvides rendir tributo al rey.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Este lugar es ideal para la pesca. ¿No crees, corregidor? ¡Seguro que aquí no nos falta comida!\nNos gustaría que celebrases un festival de vez en cuando, ¡si es que puedes permitírtelo después de rendir tributo al rey!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Oh, cariño. ¡Gracias por traernos a este lugar! ¡El lago es precioso!\nLos townies serán muy felices aquí, siempre y cuando cuides de ellos. Ah, y no olvides sobornar al rey para que no tengamos que irnos de aquí jamás.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Mi amo, sabia decisión trasladarse a este valle.\nLos townies estarán encantados cuando los pobres y los necesitados reciban ayudas.\nSin embargo, y aun siendo tan generoso, es mejor no descuidar las obligaciones para con el rey.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "¡Bienvenido seas! ¡Es un orgullo para mis hombres ayudarte a construir tu centro de poder en este lugar tan importante de nuestras tierras!\n¡Este año va a estar cargado de celebraciones!\n¡Larga vida al rey y a ti también!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Mi estimado corregidor, ¡no dejo de oír hablar de ti! Por eso, te he elegido para que hagas prosperar esta ciudad a los pies de mi castillo. ¡Que te vaya bien!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Milord, nos han encargado que establezcamos una pequeña ciudad cerca de este lecho del río seco. El rey nos recompensará abundantemente si cumplimos con nuestro deber.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Milord, la meseta en la que se encuentra nuestro castillo es una ubicación perfecta para empezar una ciudad. El rey también ha enviado una lista de tareas que quiere que hagamos.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Acabamos de descubrir un archipiélago junto a la costa. ¡Os ordeno que colonicéis esas islas en mi nombre!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Milord, mira esta hermosa región forestal. Será difícil construir una ciudad aquí, pero al menos tenemos grandes cantidades de ciervos y madera, lo que debería facilitar las tareas que el rey nos ha encomendado.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Mi amo, será difícil cumplir con los tributos que hay que pagar al rey porque el invierno está siendo riguroso. Tenemos que ponernos a trabajar inmediatamente.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Qué valle tan maravilloso. Hay suficientes recursos para rendir tributo al rey. Pero ten cuidado: con tan poco espacio para construir, será necesario planificar con cuidado la expansión.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "¡Esta es una isla realmente bella! Me alegro tanto de haber venido. ¡Deberíamos empezar ya mismo con la planificación!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Desde aquí podremos vigilar perfectamente los alrededores. Por desgracia, a esta altitud el invierno es mucho más largo y eso afectará a las cosechas.\n\nLo más razonable será aprovisionarse en verano.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "¡Saludos! Os hemos estado esperando. Mis hombres ya han explorado la región y han encontrado bastantes yacimientos de mineral. \n\nMejor que empecemos a extraerlo, antes de que alguien lo haga.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Mi señor, me alegro de que esté aquí.\n\nEl anterior gobernador se marchó deprisa y corriendo. Mientras corría, gritaba que este lugar estaba maldito.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Tu predecesor no andaba desencaminado. Aquí la agricultura es difícil, apenas crece nada. Hasta el agua escasea. Pero seguro que tu sabrás encontrar una solución.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Tus townies se sienten algo insatisfechos con sus vidas religiosas, milord. ¿Sería posible construir una iglesia?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Consigue una gran felicidad religiosa.";
"T_GAME_QUEST_SCEN10_11_DESC" = "¿En serio esperas que un hombre de mi talla camine por estos caminos tan mugrientos? ¡Construye caminos dignos de una ciudad real!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Construye caminos de adoquines en la ciudad.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Construye caminos de tierra en la ciudad.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Por aquí hay algo que necesita un poco de bricolaje, milord: hay que arreglar los edificios. Tendremos que contratar a un carpintero para que arregle los edificios antes de que se rompan del todo.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Construye un taller de carpintero. Consigue una gran satisfacción con la condición de los edificios.";
"T_GAME_QUEST_SCEN10_13_DESC" = "¡Gobernador! ¿Por qué tu ciudad es tan pequeña? ¡El archiduque nos lleva ventaja! A menos que consigas aumentar la población, perderemos la apuesta.";
"T_GAME_QUEST_SCEN10_13_NAME" = "Aumenta la población de tu urbe.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Las nuevas familias que llegaron a la ciudad tras un viaje largo y cansado están hambrientas. ¡Celebremos un banquete en su honor para celebrar el comienzo oficial de la apuesta, milord!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Produce suficiente comida como para alimentar a la población.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Deberíamos empezar a comerciar con los mercaderes ambulantes. Si tenemos mercaderes, la reputación de la ciudad aumentará y atraeremos a más visitantes, Milord.";
"T_GAME_QUEST_SCEN10_15_NAME" = "Comercia con el mercader y consigue mucho dinero.";
"T_GAME_QUEST_SCEN10_16_DESC" = "¡La cantidad de impuestos que estás recaudando es penosa! Creo que deberías construir una tesorería para incrementar los ingresos.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Construye una tesorería y recauda los impuestos suficientes.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Joyas, ¡necesito joyas! ¿Cómo pretendes distribuir joyas si ni siquiera has construido una orfebrería?";
"T_GAME_QUEST_SCEN10_17_NAME" = "Construye una orfebrería y empieza a producir joyas.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Excelente, milord. Ya puedes entregarme el cargamento de joyas que te pedí.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Entrégale joyas al mercader.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Mi señor, nuestra preocupación primordial es el suministro de alimentos. Necesitamos pescadores y cazadores.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Construye varias casetas de pescadores y cabañas de cazadores.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Mi estimado gobernador, no podemos ayudarte hasta que no construyas un mercado.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Necesitamos un mercado para ampliar nuestra ciudad.";
"T_GAME_QUEST_SCEN10_4_DESC" = "¡Milord! ¿Has construido ya un taller de herramientas? ¡El Archiduque ya ha comenzado la producción de herramientas!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Construye un taller de herramientas y empieza a producirlas.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Con todo el esfuerzo que hemos puesto, queremos que haya un lugar para relajarse, quedar con los amigos y tomarse una copa de zumo de uva. Creemos que una taberna nos vendría genial. Por supuesto, solo si tú quieres, milord.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Consigue una gran satisfacción con las tabernas.";
"T_GAME_QUEST_SCEN10_6_DESC" = "¿Tienes suficiente espacio en las casas, milord? Los trabajadores que vengan a la ciudad necesitarán un techo, ¿no crees?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Construye 2 casas grandes y 4 de tamaño normal.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Construye más casas unifamiliares grandes.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Construye más casas unifamiliares pequeñas.";
"T_GAME_QUEST_SCEN10_7_DESC" = "La ciudad necesita un poco de entretenimiento extravagante. Por ejemplo, no nos vendría mal un campo de justas. Asegúrate de que puedes proporcionar este tipo de entretenimiento antes de recibir la visita de gente importante.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Obtenga una gran satisfacción con el entretenimiento.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Consigue una gran satisfacción con los campos de justas.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Milord, creo que deberíamos embellecer esta ciudad. ¿Qué tal si construimos estatuas y decoraciones? Pongámonos manos a la obra antes de que el rey vuelva a visitarnos.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Decora la ciudad para que se vea bella y hermosa.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Buenos días, gobernador. ¿Estarías interesado en comerciar? Tengo la necesidad de conseguir una gran cantidad de ropa para poder empezar un comercio lucrativo con el archiduque. Pagaría muy bien si pudieses entregarme lo que necesito.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Entrega un cargamento de ropa al mercader.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "¡Esto es un auténtico desastre, gobernador! ¡El archiduque de Canterborough se nos ha adelantado y ha acabado su ciudad antes que nosotros!\n\nConté contigo y ahora estoy muy decepcionado. Tal vez, intentar ganar esta apuesta fue una locura desde el principio. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Estupendo, mi buen gobernador. Hemos vencido al archiduque en la carrera por agrandar la ciudad. ¡Hemos ganado la apuesta!\n\nEstoy impresionado por tu actuación y me aseguraré de que eres recompensado soberanamente. También te otorgo el título de duque, con todos los derechos y privilegios que entraña.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Mi leal sirviente. El que mucho abarca, poco aprieta.\n\nMe he apostado con el archiduque de Canterborough que conseguiría que la urbe más subdesarrollada de mi reino se convirtiese en una urbe próspera antes de que él lo consiga.";
"T_GAME_QUEST_SCEN12_01_START" = "Muy amable de tu parte visitarnos. Te doy la bienvenida en nombre de todos los monjes presentes. Este es el monasterio de Tardishingen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Te doy la bienvenida a Tardishingen, mi señor.\nPor supuesto que te ayudaremos a preparar el regalo perfecto para el rey. Pero ahora mismo tenemos problemas con los bandidos. Quizá tú también puedas ayudarnos.";
"T_GAME_QUEST_SCEN12_02_START" = "¡Qué perfidia!\n\n¡Alguien nos ha robado la madera! No podemos almacenar la cerveza si no tenemos madera para los barriles.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "¡Muchas gracias, mi señor! Ahora ya podemos fabricar barriles de cerveza.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Construye casetas para guardas forestales.";
"T_GAME_QUEST_SCEN12_04_START" = "Mi señor, la aldea debe expandirse para que podamos llevar a cabo nuestras tareas. Primero tenemos que crear una economía estable. Para eso necesitamos producir herramientas.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Espléndido, mi señor. Ahora ya podemos expandir la aldea.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Establece una cadena de producción de herramientas.";
"T_GAME_QUEST_SCEN12_05_START" = "Hay que suministrar más alimentos a la aldea, mi señor. Tenemos una granja, pero nos faltan molinos y panaderías.";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "¡Muy bien! La aldea se está transformando en una auténtica ciudad.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Crea un método de producción de alimentos estable.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "¡Nooo! ¡Esos malditos bandidos han destruido el monasterio!";
"T_GAME_QUEST_SCEN12_06_START" = "Mi señor, el monasterio se estableció sobre esta colina hace cuatro siglos. Sería terrible que lo destruyeran esos despreciables bandidos. Llevan semanas amenazando con hacerlo...";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Excelente, mi señor.\n¡El monasterio ha sobrevivido a los ataques de los bandidos y hemos obtenido la cerveza perfecto! \n\n¡Se ha convertido en una bebida celestial! Absolutamente maravillosa.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Protege el monasterio.";
"T_GAME_QUEST_SCEN12_07_START" = "¡Debes reconstruir el monasterio, de lo contrario no cumpliremos la misión a tiempo!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "¡Muy bien, mi señor! ¡El monasterio está reconstruido! Ya podemos seguir con nuestra tarea: ¡elaborar la cerveza perfecta!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Reconstruye el monasterio.";
"T_GAME_QUEST_SCEN12_08_START" = "¡Hay que fortalecer la defensa del monasterio, mi señor! Si colocamos una torre de vigilancia junto a él estará mucho más protegido.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Construye una torre de vigilancia junto al monasterio.";
"T_GAME_QUEST_SCEN12_09_START" = "¿Sabías que a los soldados les encantan las salchichas?\nPodrías construir una granja de cerdos y una carnicería para producirlas.";
"T_GAME_QUEST_SCEN12_09_START2" = "Mi señor,\n\nte aconsejo que ordenes la construcción de una granja porcina y una carnicería. Así produciremos carne para los aldeanos y salchichas, que apasionan a los soldados.";
"T_GAME_QUEST_SCEN12_10_START" = "Mmm, creo que esos pobres soldados necesitan espadas y armaduras. Así tendrán muchas más probabilidades de sobrevivir a un combate. Para ello necesitamos una armería y una curtiduría.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "¡Lo hemos conseguido, mi señor! Ahora podemos fabricar armaduras para los soldados.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Construye una armería y una curtiduría.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Construye una armería.";
"T_GAME_QUEST_SCEN12_11_START" = "Ya tenemos una armería y una curtiduría, sería genial empezar a producir el equipo necesario.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "¡Fantástico, mi señor! ¡Ahora los soldados combatirán en mejores condiciones!";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Fabrica equipo para los soldados.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Muy bien, mi señor. ¡Ahora el monasterio está protegido contra los ataques de los bandidos!";
"T_GAME_QUEST_SCEN12_15_START" = "No hemos podido restaurar los campos de lúpulo arrasados.\n\n¿Serías tan amable de crear algunos?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Crea campos de lúpulo.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Construye una granja y varios campos de lúpulo.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Jajaja. Tu humilde monasterio es historia. ¡Ahora esta zona está bajo mi mando!";
"T_GAME_QUEST_SCEN12_16_START" = "¿Crees que puedes proteger a esos pequeños monjes? Vas a ver cómo destruyo ese insignificante monasterio.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "¡Aaarjjj! ¡La próxima vez pagarás por eso! Esto no ha acabado...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Repele todos los ataques.";
"T_GAME_QUEST_SCEN12_17_START" = "Mi señor, mis monjes y yo empezaremos inmediatamente a producir la mejor cerveza del país.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Hemos concluido el proceso de fermentación, mi señor. Hemos creado muchos tipos diferentes de cerveza. Seleccionaremos las mejores y las refinaremos más aún.";
"T_GAME_QUEST_SCEN12_18_START" = "Nuestro maestro cervecero dice que hay que mejorar las herramientas de fermentación para refinar la cerveza más aún. Se trata de agradar al rey, ¿no? Tiene que ser la mejor cerveza del país…";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "¡Fantástico, mi señor! Ahora solo necesitamos más cantidad de los mejores ingredientes.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Mejora el monasterio al nivel 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Señor, la cerveza está casi lista, pero nos faltan algunos ingredientes. Para rematar el producto nos vendrían genial finas hierbas y algo de polvo de oro.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Proporciona las hierbas y las pepitas de oro. ";
"T_GAME_QUEST_SCEN12_20_START" = "La cerveza necesita un tiempo para madurar.\n\nHay que evitar influencias externas, el proceso de maduración requiere reposo.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Ya está, mi señor. Te ofrezco la cerveza perfecta.";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Defiende el monasterio hasta que el proceso de elaboración de cerveza se haya completado.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Quería agradecértelo personalmente, administrador.\nSin duda es el regalo perfecto para mi cumpleaños. No pensé que estuvieras al tanto de mi fascinación por la cerveza.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Crea la cerveza perfecta para el rey.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Prepara la aldea para la llegada del rey. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "¿Creías que podías engañarme? Me decepciona que no hayas sabido administrar una pequeña aldea.\n\n¡Yo gobierno un reino entero, y no necesito engañar a nadie!";
"T_GAME_QUEST_SCEN13_01_START" = "Durante el próximo año inspeccionaré mis posesiones.\n¡Tu célebre aldea será el punto culminante de mi viaje!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "¡Estoy muy satisfecho contigo!\nSabes bien cómo se administra una aldea y te tengo en la más alta estima.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Pasa la inspección del rey.";
"T_GAME_QUEST_SCEN13_02_START" = "¡Saludos, señor administrador! ¡He decidido venir antes a tu aldea para comprobar lo bien que va todo!\n\nSeguro que esperabas mi llegada.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "No dejes que el rey sospeche.";
"T_GAME_QUEST_SCEN13_05_1_START" = "¡Lo primero es volver a poner en marcha la producción de bienes!\n\nVuelve a emplear al guarda forestal y repara el aserradero para empezar con ello.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Muy bien, mi señor.\n¡Pero no hay tiempo para descansar!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Emplea a un guarda forestal y repara el aserradero.";
"T_GAME_QUEST_SCEN13_05_START" = "¡No! La aldea está en absoluta decadencia por culpa de los bandidos.\n\n¡Tenemos que empezar a reconstruirla inmediatamente!";
"T_GAME_QUEST_SCEN13_06_START" = "¡El mercado se ha quemado y hay que reconstruirlo!\n\nNecesitamos urgentemente bienes para preparar la aldea para la llegada del rey.";
"T_GAME_QUEST_SCEN13_07_1_START" = "También necesitamos un carpintero, mi señor. ¡Hay muchos edificios que necesitan reparaciones urgentes.";
"T_GAME_QUEST_SCEN13_07_START" = "Debemos reparar la tesorería para que el recaudador de impuestos siga con su trabajo.\n¡Necesitamos urgentemente monedas para las reparaciones!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Debemos emplear los impuestos en las reparaciones necesarias.";
"T_GAME_QUEST_SCEN13_08_START" = "Tienes que reparar las casas de la aldea y construir otras nuevas para que vengan más trabajadores.\n¡Debemos comenzar a producir de nuevo!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Ya tenemos espacio suficiente para más trabajadores, pero todavía no hemos acabado.";
"T_GAME_QUEST_SCEN13_09_START" = "¡Qué desastre!\nSolo nos queda lavar la cara a los lugares que el rey va a visitar y rezar para que no sospeche.\n\n¡Aprovecha bien el tiempo mientras el rey descansa!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Espera a que el rey anuncie el primer lugar que visitará.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "¡El rey ha visto bandidos y alberga sospechas! ¡Debemos tener más cuidado!";
"T_GAME_QUEST_SCEN13_10_START" = "El rey quiere explorar los bosques.\n¡Debemos destruir los campamentos de bandidos antes de que lo haga!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "¡Por poco! Pero esto no ha acabado todavía...";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Destruye todos los campamento de bandidos. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "¡Cielos, no hemos conseguido engañar al rey!\n¡Ya alberga sospechas, no podemos cometer otro error!";
"T_GAME_QUEST_SCEN13_11_START" = "El rey quiere pasear por la aldea.\nSi descubre que los aldeanos están insatisfechos se percatará de que algo no va bien.\n\n¡Y además tenemos que erigir una estatua suya!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "¡Excelente! Todos los townies estaban de buen humor durante el paseo del rey.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Eleva la satisfacción de los aldeanos y erige una estatua del rey.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "¡El rey está decepcionado!\n¡No podemos cometer más errores!";
"T_GAME_QUEST_SCEN13_12_START" = "El rey va a inspeccionar a nuestras tropas.\n¡Asegúrate de que nuestra guardia le cause una buena impresión!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "¡Esta guardia sin duda impresionará al rey!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Mantén empleados a suficientes soldados.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Hemos fracasado, mi señor. ¡La celebración no ha estado a la altura de las expectativas del rey y está disgustado! \n\nQuizá habría sido mejor ser honestos...";
"T_GAME_QUEST_SCEN13_13_START" = "El rey quiere celebrar una gran fiesta. Ten preparadas joyas y ropas nobles para el evento.\n¡Si fallamos, todo se vendrá abajo!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "¡La fiesta ha sido un gran éxito! Parece que hemos conseguido engañar al rey.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Acumula ropas y joyas.";
"T_GAME_QUEST_SCEN13_14_START" = "Es muy peligroso para mí recorrer tus calles con mis valiosos bienes.\n\n¡Apáñatelas como puedas!";
"T_GAME_QUEST_SCEN13_15_START" = "Ahora que has derrotado a los bandidos, será un placer para mí visitar tu aldea y volver a hacer negocios.";
"T_GAME_QUEST_SCEN13_16_START" = "¡El mercader es un cobarde, pero ha dicho la verdad!\nLos bosques de los alrededores son muy peligrosos. Debemos entrenar a algunos guardias para que vigilen a los bandidos.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Has puesto los cimientos de la defensa de la aldea, mi señor. Pero debemos fortalecerla.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Construye barracones y una torre de vigilancia.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "¡Noo! ¡Los bandidos han traspasado nuestras defensas! Al rey no le va a gustar nada. ";
"T_GAME_QUEST_SCEN13_19_START" = "Los bandidos transmiten mala imagen de la seguridad de la aldea.\n¡No permitas demasiados ataques durante la inspección o nos caerá una buena!";
"T_GAME_QUEST_SCEN14_01A_START" = "Mi señor, ¿no te parece que este hombre actúa de forma muy extraña?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Envía tejidos.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Mi señor, hemos fracasado!\nEl consejero médico es un charlatán y se ha fugado con el oro que guardábamos en la tesorería.\n\nPero por suerte hemos encontrado el remedio en su laboratorio...";
"T_GAME_QUEST_SCEN14_01_START" = "Buenos días, mi señor. La plaga asola el reino.\n¡Incluso el rey está muy enfermo! Debemos ayudar al consejero médico de la corte a encontrar un remedio pronto. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "¡Hemos encontrado un remedio a tiempo, mi señor!\n\n¡Ahora mismo se le está administrando al rey! ¡Es una fantástica noticia para el reino!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Encuentra un remedio para el rey.";
"T_GAME_QUEST_SCEN14_02A_START" = "¡Algo no va bien, mi señor! El consejero médico está pidiendo cosas raras. Tengo un mal presentimiento... \n\nHay que tener cuidado con ese hombre.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Cuando tú lo ordenes le llevaré la cerveza al doctor.\nEspero que nos entregue pronto un remedio. ¡Al rey no le queda mucho tiempo!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Entrega la cerveza.";
"T_GAME_QUEST_SCEN14_02_START" = "Creo que la mejor forma de obtener cerveza para el rey es crear un monasterio cervecero. \n\nEsperemos que la cerveza mitigue su sufrimiento.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Creo que la mejor forma de obtener cerveza para el rey es crear un monasterio cervecero y una granja de lúpulo. \n\nEsperemos que la cerveza mitigue su sufrimiento.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "¡Magnífico, mi señor! ¡Los monjes nos ayudarán a elaborar cerveza! ¡El rey estará agradecido!";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Construye un monasterio.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Construye un monasterio y un secadero de lúpulo.";
"T_GAME_QUEST_SCEN14_03_START" = "¡Necesitamos una granja porcina para proporcionar cerdos al consejero médico!\nDebes ordenar su construcción inmediatamente, mi señor.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Espléndido, mi señor. Ahora ya podemos criar cerdos.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Construye una granja porcina.";
"T_GAME_QUEST_SCEN14_05_START" = "Mi señor, la aldea necesita un barracón. Debemos mantener la ley y el orden en tiempos tan turbulentos.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "¡Mi señor! ¡Lo sabía!\n\nEl consejero médico es un charlatán. Poseía el remedio para el rey desde el principio.\nParece que estaba infectando a todo el país con esta enfermedad. \n\nMe he tomado la libertad de ordenar a los guardias que lo arresten.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "¡Esto es un ultraje!\n\n¿Cómo te atreves a arrestarme? Soy el consejero especial del rey. \nNo puedes hacer esto...";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "¡Me has decepcionado, gobernador!\n\n¡Anoche tuve una visión y descubrí que tu incompetencia causará un gran infortunio a esta ciudad.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "¡Gobernador! Me llamo Rasiksin, y soy el adivino y consejero médico del rey.\n¡Necesitaré toda la ayuda que puedas prestarme!\nPara empezar, proporcióname plantas medicinales tan pronto como sea posible.";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Veo que has conseguido todas las plantas que necesitaba.\n\nAnoche tuve una visión... y sabía que no decepcionarías al rey.\n\nAhora ordena a tu consejero que me entregue las plantas y sal de mi vista. Tengo trabajo.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Envía las plantas medicinales.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "¡Nunca debí contar contigo, gobernador. ¡En mis visiones pude comprobar que tu incompetencia traerá el desastre a la ciudad! ¡Nos has decepcionado al rey y a mí!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Necesito tejidos para filtrar el tratamiento, de modo que fabrícamelos. Y rápido, para que pueda empezar a filtrar pronto.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "¡Me alegro de que no me hayas hecho perder el tiempo, gobernador!\n\n¡Ahora ordena que me entreguen los recursos! ¡Soy una persona muy ocupada!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Produce tejidos.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "Es necesario diluir el tratamiento para producirlo en masa. ¡El líquido perfecto es la cerveza! \n\n¡Ponte manos a la obra!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "¡Ya era hora! Llévala a mi laboratorio.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Produce cerveza.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "¡Demasiado tarde!. Ahora caerá alguna desgracia sobre la ciudad.\n\n¡Y es culpa tuya!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "¡Tenemos que tomar medidas más drásticas para salvar al rey!\n\nNecesito cerdos para sacrificarlos a los dioses tradicionales.\nQuizá sirva de algo...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Te has tomado tu tiempo, gobernador. Ya dudaba de que aparecieras...";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Proporciona cerdos.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Necesito... eeeh... es decir, el rey necesita una hierba especial para pipa para aliviar su dolor.\n\n¡Entrégame un cofre repleto de monedas para comprar la medicina!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\n¡Dame eso! Apreciaré... quiero decir... el rey estará encantado de recibir pronto su medicina. Está sufriendo mucho.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Entrega el dinero.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "He descubierto que al rey le enferman sus ropas. Necesita unas nuevas fabricadas con un material especial.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Por fin has traído las ropas. El rey ya se estaba impacientando.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Entrega la ropa.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "¡Ya no soporto trabajar en este viejo laboratorio!\n\nConstrúyeme una torre de vigilancia que yo pueda transformar en uno nuevo y maravilloso. Tiene que estar en una torre. Me gustan las torres.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nTomo propiedad de esta torre en nombre del rey. Será mi nuevo laboratorio. ¡Ahora sal de mi vista!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Construye una torre de vigilancia.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Falta una última cosa, gobernador.\n\nNecesito lingotes de oro para finalizar el tratamiento. Tráeme algunos.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "¡Por fin! Ahora solo hace falta algo de tiempo para refinar el tratamiento.\n\nTendré que hacer preparativos para mi part... quiero decir, para administrar el remedio.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Entrega los lingotes de oro.";
"T_GAME_QUEST_SCEN15_01_FAIL" = "¡Todo está perdido! Tendrás que vivir con el peso de la muerte de muchos valientes sobre tu conciencia...";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "¡Todo está perdido! Sin los suministros necesarios, no obtendremos la victoria.\n\n¡Tendrás que vivir con el peso de la muerte de muchos valientes sobre tu conciencia!\n\nEl rey arde de indignación...";
"T_GAME_QUEST_SCEN15_01_START" = "Saludos, señor administrador.\nVengo en nombre del rey a recoger los suministros para la guerra que se libra.\n\nSé que los aldeanos sufren por la guerra, pero los soldados del frente necesitan urgentemente tu apoyo.";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Saludos, señor administrador.\nVengo en nombre del rey a recoger los suministros para la guerra que se libra. ¡Sé que los aldeanos sufren por la guerra, pero los soldados del frente necesitan urgentemente tu apoyo!\n\nSolo alcanzaremos la victoria si todos tus envíos llegan a tiempo.\n\nEl rey cuenta contigo.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "¡Hemos alcanzado la victoria!\nY mucho se lo debemos a tu firme apoyo, cosa que mis hombres te agradecen de corazón. ¡Que pronto vivamos tiempos de paz!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Apoya a los soldados.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Entrega todos los suministros al ejército del rey a tiempo.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "¡Las vidas de muchos hombres dependen de tu apoyo!";
"T_GAME_QUEST_SCEN15_02_START" = "Hemos conquistado nuevos territorios y debemos asegurar la línea del frente. \n¡Envía tablones y tejidos rápidamente para construir campamentos!";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Muy bien. Ahora envía los recursos a mis soldados.";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Envía tejidos y tablones.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "¿Cómo crees que vamos a ganar batallas sin el equipo apropiado?";
"T_GAME_QUEST_SCEN15_03_START" = "¡Las últimas batallas han consumido mucho material!\n\nSolicito un envío de armas para mis hombres.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Con esas armas nuevas mis soldados sin duda saldrán victoriosos en la próxima batalla.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Envía armas.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "¡Sin tus suministros no tengo esperanzas de ganar la última batalla! ";
"T_GAME_QUEST_SCEN15_04_START" = "¡Nos estamos quedando sin provisiones!\nEnvíanos pan y carne para recuperar las fuerzas para la batalla final.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "¡Los soldados esperan comida, envíala ya!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Envía pan y carne.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "Envía cervezay salchichas.";
"T_GAME_QUEST_SCEN15_08_START" = "No podemos abandonar a nuestros valientes soldados a su suerte, pero los aldeanos también sufren privaciones, mi señor.\n¡La elección es tuya!\nAntes que nada, construye un aserradero y una cabaña de cazador.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Con suerte, esto bastará para estar preparados.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Construye un aserradero y una cabaña de cazador.";
"T_GAME_QUEST_SCEN15_09_START" = "Para enviar esos recursos necesitamos un pasto para ovejas y una fábrica de tejidos.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Gran trabajo, mi señor. Siempre puedes acelerar la producción mediante la mejora de edificios o la construcción de otros nuevos.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Instala un pasto para ovejas y una fábrica de tejidos.";
"T_GAME_QUEST_SCEN15_10_START" = "¡Necesitamos una industria de hierro avanzada para apoyar a nuestros soldados!";
"T_GAME_QUEST_SCEN15_10_SUCCESS" = "El herrero está trabajando, pero asegúrate de que tiene hierro suficiente para mantener la producción.";
"T_GAME_QUEST_SCEN15_10_TITLE" = "Construye un taller de herramientas y una armería.";
"T_GAME_QUEST_SCEN15_11_START" = "¡Para apoyar a las tropas necesitamos una panadería y más cabañas de cazador!";
"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Muy bien, mi señor. Pronto tendremos almacenada la cantidad de bienes requerida.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Construye una panadería y más cabañas de cazador.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "¡Te has dedicado a servir a las tropas y has descuidado a tus aldeanos!";
"T_GAME_QUEST_SCEN15_13_START" = "Estamos pasando muchas privaciones, mi señor. ¡Te suplico humildemente que entregues a los pobres parte de los suministros destinados a los soldados!";
"T_GAME_QUEST_SCEN15_13_SUCCESS" = "¡Mi señor, eres un gobernante honorable! Pese a las demandas de los soldados, no has descuidado a tus aldeanos.";
"T_GAME_QUEST_SCEN15_13_TITLE" = "Opcional: apoya a los aldeanos.";
"T_GAME_QUEST_SCEN15_13_TITLE_OLD" = "Apoya a los aldeanos.";
"T_GAME_QUEST_SCEN15_14_FAIL" = "A mucha gente le causa frustración ver la cantidad de recursos valiosos que está consumiendo esta guerra, mi señor.";
"T_GAME_QUEST_SCEN15_14_START" = "Hace frío y los trabajadores no tienen ropa apropiada. Ten la amabilidad de fabricar ropa nueva.\n¡No podemos pagarte, pero trabajaremos más duro que nunca, mi señor!";
"T_GAME_QUEST_SCEN15_14_START_2" = "Hace frío y los trabajadores no tienen ropa apropiada. Ten la amabilidad de fabricar ropa nueva.\n¡No podemos pagarte, pero trabajaremos más duro que nunca, mi señor!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "¡Eres nuestro benefactor! Ahora ya no pasaremos frío.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Produce ropa para la gente.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Sin herramientas nuevas los trabajadores disminuirán su productividad.";
"T_GAME_QUEST_SCEN15_15_START" = "Si por el contrario destinaras hierro al taller de herramientas, se podrían forjar herramientas nuevas. \nSeríamos más eficientes en el trabajo en estos tiempos tan duros.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "¡Tu bondad no tiene límites, mi señor!";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Proporciona herramientas a los trabajadores.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Tus aldeanos siguen muriéndose de hambre, mi señor. Si no les das comida, pronto empezarán a perder la moral.";
"T_GAME_QUEST_SCEN15_16_START" = "Los aldeanos se mueren de hambre, mi señor.\n¡Entréganos a nosotros los suministros y no volverás a oír nuestras quejas!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "¡Que los dioses te bendigan!";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Proporciona comida a los aldeanos.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "Se extiende la insatisfacción, mi señor. ¡Tienes que hacer algo rápido!";
"T_GAME_QUEST_SCEN15_17_FAIL" = "¡Esto se complica, mi señor! La moral está muy baja. Me temo que algunos aldeanos enfurecidos podrían llevar a cabo alguna acción impulsiva.";
"T_GAME_QUEST_SCEN15_17_START" = "¡Mi señor, toda la región sufre a causa de la guerra!\nSi la moral de los aldeanos disminuye mucho, se podrían producir disturbios.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "¡Maravilloso, mi señor! ¡Has conseguido satisfacer a los aldeanos y apoyar a las tropas!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "No dejes que disminuya su nivel de satisfacción.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Mantén la felicidad por encima del 75 % durante un par de minutos.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "No dejes que disminuya el nivel de satisfacción demasiado tiempo.";
"T_GAME_QUEST_SCEN15_19_START" = "Hay rumores de que este incendio no ha sido un accidente, mi señor. \nSeguramente obtendré más información en una taberna. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Los aldeanos cotillean mucho en las tabernas. Intentaré averiguar algo sobre los incendios que se han producido.";
"T_GAME_QUEST_SCEN15_20_START" = "Se dice que hay un pirómano que provoca incendios para incitar a los aldeanos.\nDebemos entrenar a algunos guardias.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Ahora solo tenemos que esperar...";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "¡Ya podemos respirar tranquilos, mi señor! Los guardias han arrestado al pirómano.\n¡La aldea está segura!";
"T_GAME_QUEST_SCEN16_01_START" = "Saludos, mi venerado señor. El rey pronto exigirá tributos.\nTenemos que fomentar la agricultura local.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "¡Excelente!\n\nGracias a tu talento económico hemos podido satisfacer las exigencias del rey, mi señor.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Cumple las exigencias del rey.";
"T_GAME_QUEST_SCEN16_02_2_START" = "¡Oh, no! El rey exige otro envío de trigo.\nQuizá podamos obtener el grano que nos falta mediante un intercambio con el mercader.";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "¡Lo conseguimos! Ahora envía al trigo al rey.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Envía más trigo al rey.";
"T_GAME_QUEST_SCEN16_02_START" = "El rey acaba de exigir trigo a las aldeas.\n¡Para satisfacer tal demanda necesitamos más granjas!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Hay suficiente trigo almacenado para realizar la entrega, mi señor.";
"T_GAME_QUEST_SCEN16_03_START" = "El rey necesita recursos para construir más almacenes.\nEnvíale los materiales exigidos.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Envía los materiales exigidos ahora para continuar con las demás entregas.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Suministra material de construcción para un almacén.";
"T_GAME_QUEST_SCEN16_04_1_START" = "El primer envío estaba podrido. Envía otro cargamento cuando hayamos erradicado la enfermedad que azota la aldea.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "¡Excelente trabajo, mi señor! Tenemos un stock de carne nueva lista para el envío.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Envía carne.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Envía carne cuando la enfermedad se haya erradicado.";
"T_GAME_QUEST_SCEN16_04_START" = "Ahora el rey pide carne.\nCon suficientes cazadores, no deberíamos tener problemas.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Muy bien, mi señor. Ya tenemos almacenada la cantidad de recursos requerida.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Construye más casetas de cazador y suministra más carne.";
"T_GAME_QUEST_SCEN16_05_START" = "El rey va a celebrar una fiesta y quiere que le enviemos bebida.\nManda cerveza y zumo de uva a la corte real.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Muy bien, mi señor. Ya tenemos un stock suficiente de ropa y joyas.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Envía cerveza y zumo de uva.";
"T_GAME_QUEST_SCEN16_06_START" = "El rey está muy satisfecho con las entregas.\nTambién quiere que le mandemos comida.\n\nEnvía zumo de uva y pan para la fiesta real. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Magnífico, mi señor. Este ha sido el último tributo.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Envía zumo y pan.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Enviar jugo y pan.";
"T_GAME_QUEST_SCEN16_08_START" = "¡Qué desastre, mi señor! ¡Una misteriosa enfermedad ha afectado a nuestro trigo y se ha echado a perder!";
"T_GAME_QUEST_SCEN16_09_START" = "Los aldeanos sufren una terrible plaga.\n¡Si no la detenemos pronto, nos quedaremos sin trabajadores!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "Parece que la enfermedad la transmiten animales enfermos. El envío para el rey también estaba infectado.\n¡Tenemos que hacer una nueva entrega!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Erradica la plaga en la aldea con la ayuda de un doctor.";
"T_GAME_QUEST_SCEN16_10_START" = "Los dioses han conspirado contra nosotros. La plaga está matando a todos los animales salvajes. ¿Cómo vamos a alimentar a la aldea y satisfacer las necesidades del rey?";
"T_GAME_QUEST_SCEN16_11_START" = "Debemos criar animales para alimentar a los aldeanos.\nPara ello necesitamos una granja porcina y una carnicería.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Los cerdos se alimentan de trigo. Consíguelo mediante un intercambio con el mercader, y así podremos atender las necesidades del rey.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Construye una granja porcina y una carnicería.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Como comprenderás, mis reservas son muy codiciadas.\nA partir de ahora ofrezco trigo a cambio de hierro.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Si me entregas el hierro, pronto enviaré otro cargamento.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Intercambia hierro por trigo.";
"T_GAME_QUEST_SCEN16_12_2_START" = "¡Por una cantidad irrisoria puedo entregarte parte de las últimas reservas de trigo del país!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Un placer, mi señor. Envíame el oro y a ver si puedo sacar algo más.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Intercambia oro por trigo.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Me he enterado de tu desgracia y quiero ofrecerte un trato. Me quedan algunas reservas de trigo que puedo intercambiar por bienes.";
"T_GAME_QUEST_SCEN16_12_START" = "Estoy dispuesto a intercambiar piedras a cambio de trigo.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Parece que tienes suficientes bienes para intercambiar. Con gusto haré más negocios contigo.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Intercambia piedras por trigo.";
"T_GAME_QUEST_SCEN2_10_DESC" = "¿Has probado el pan que hace mi sobrino? ¡Tienes que probarlo! ¡Y dile que haga suficiente para todo el invierno!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Hornea 50 panes.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Construye un telar.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Construye una sastrería.";
"T_GAME_QUEST_SCEN2_11_DESC" = "¿Pasas tanto frío como nosotros? Mi esposa se ha resfriado porque tiene el vestido lleno de agujeros. ¿Puedes ayudarnos a conseguir ropa cálida?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Construye un pasto para ovejas.";
"T_GAME_QUEST_SCEN2_12_DESC" = "¡Nuestra ciudad casi está preparada para soportar el invierno! Pero, entre tú y yo, ¿no sería estupendo poder disfrutar de un buen zumo de uva en la taberna cuando fuera hace un frío que pela?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Construye un lagar y produce 50 jarras de zumo.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Corregidor, no pretendo ser grosero pero, por desgracia, carecemos de granjas. ¿Cómo vamos a cosechar el trigo a tiempo antes de que llegue el invierno?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Construye 2 granjas.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrrr, me estoy congelando, mi querido corregidor. ¡Me temo que nos espera un frío invierno! ¡Mi esposa y esperamos que no olvides contar con un amplio suministro de leña!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Construye 3 casetas de guardas forestales.";
"T_GAME_QUEST_SCEN2_3_DESC" = "¡Gracias! Saluda a mis hermanos, si es que los ves. ¡Diles que recojan toda la madera que puedan!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Recoge 35 unidades de madera.";
"T_GAME_QUEST_SCEN2_4_DESC" = "¡Al fin podemos comenzar la cosecha! ¡Espero que sea suficiente para abastecer nuestras necesidades!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Cosecha 35 unidades de trigo.";
"T_GAME_QUEST_SCEN2_5_DESC" = "¡Una cosecha de lo más abundante! No sabemos ni dónde almacenar todo este trigo. ¡No sería mala idea usarlo para hacer pan!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Construye un molino y produce harina.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Querido corregidor: nos encanta vivir aquí pero nos preocupa que nuestros hogares no soporten las inclemencias del invierno.";
"T_GAME_QUEST_SCEN2_6_NAME" = "Mantén todas las casas en buen estado.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Hay algo que me preocupa... Por desgracia, no tenemos reservas de herramientas. No hace falta que te diga lo importantes que son las herramientas para reparar edificios. ¿Serías tan amable de adquirir algunas?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Entrega un tributo de 50 herramientas.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Me temo que mis hermanos no serán capaces de terminar el trabajo ellos solos... ¿Podrías conseguir más trabajadores para la ciudad?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Aumenta la población a 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Se me está helando la nariz... Y algunos de los viajeros en busca de un lugar en el que asentarse están todavía peor. ¡Deberíamos de permitir que viviesen en nuestra ciudad!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Construye 6 casas.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Cariño, espero que no olvides que mañana es nuestro aniversario de bodas. ¡Me encantaría que me regalases una joya! Ojalá conocieses a un orfebre...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Construye una orfebrería.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Seguro que al rey y a los townies les gustaría tener herramientas nuevas. ¡Las viejas están oxidadas y no sirven para nada!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Construye un taller de herramientas.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Construye una sastrería y produce ropa.";
"T_GAME_QUEST_SCEN3_12_DESC" = "¡Mira esas ovejitas! ¿Las has visto? ¡Y mira toda la lana que han dado! ¡Ya solo necesitamos un telar y una sastrería!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Construye un telar y produce suficiente tela.";
"T_GAME_QUEST_SCEN3_13_DESC" = "¡Los niños están emocionados y deseando probar todo ese pan que pronto tendrán! Ya has construido panaderías, ¿verdad, cariño?";
"T_GAME_QUEST_SCEN3_14_DESC" = "¿Sabes qué? ¡Mi hermana por fin ha decidido casarse! Pero necesitamos una iglesia en la ciudad, no solo para la ceremonia, también para los townies que son creyentes.";
"T_GAME_QUEST_SCEN3_14_NAME" = "Consigue una gran satisfacción religiosa.";
"T_GAME_QUEST_SCEN3_15_DESC" = "¡Mira, cariño! ¡La ciudad ha prosperado y todo va de maravilla! Te doy permiso para que construyas una taberna y vayas a pasar un rato con tus amigos. Si es que quieres...";
"T_GAME_QUEST_SCEN3_15_NAME" = "Consigue una gran satisfacción con las tabernas.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Cariño, esta ciudad está hecha una ruina... Esos pobres townies me dan mucha pena. Creo que deberías enviarle algunos regalos al rey para convencerle de que nos ayude.";
"T_GAME_QUEST_SCEN3_1_NAME" = "Entrega un tributo al rey y completa todas las tareas.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Hasta que el rey envíe ayuda, deberías de ocuparte de esto. ¡Los townies necesitan más agua con urgencia!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Construye un pozo en la ciudad.";
"T_GAME_QUEST_SCEN3_3_DESC" = "¡Tu antecesor no era capaz ni de abastecernos con comida! ¡Increíble! Querido, tienes que hacer algo. ¿Por qué no construyes unas casetas de pescadores?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Construye 2 casetas de pescadores.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Esos pobres niños... Cariño, no pueden comer únicamente pescado. Construye granjas para cultivar trigo y obtener harina y pan.";
"T_GAME_QUEST_SCEN3_4_NAME" = "Construye 2 granjas y produce trigo.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Construye una fundidora.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Cariño, ¿no se te olvida algo? ¿Vas a enviarle regalos al rey para que nos ayude? No sé qué harías sin mí... Necesitamos una mina y una fundidora para producir objetos de valor.";
"T_GAME_QUEST_SCEN3_5_NAME" = "Construye una mina.";
"T_GAME_QUEST_SCEN3_6_DESC" = "¡Los townies trabajan demasiado! ¿Por qué no construyes más casas para atraer a más trabajadores?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Construye 3 casas.";
"T_GAME_QUEST_SCEN3_7_DESC" = "¡Soy tan feliz! ¡Las cosas cada vez van mejor! ¡Ahora incluso podemos recaudar más impuestos de los townies!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Recauda 1500 táleros en impuestos.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Recauda suficientes táleros en impuestos.";
"T_GAME_QUEST_SCEN3_8_DESC" = "¿Sabes qué estaría bien? Tener ropa nueva. Me refiero, sobre todo, para el rey... Pero primero necesitamos pastos para ovejas para obtener lana.";
"T_GAME_QUEST_SCEN3_8_NAME" = "Construye 2 pastos para ovejas.";
"T_GAME_QUEST_SCEN3_9_DESC" = "¡Los granjeros ya están cosechando el trigo! ¡Ya puedes construir un molino para producir harina y hacer pan!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Construye un molino y produce harina.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Mi castillo no es adecuado para mi estatus de realeza y estoy planeando hacer una ampliación enorme en mi finca de verano. \n\nSoy tu rey y te ordeno que entregues una gran cantidad de piedra. Cuento contigo, mi buen corregidor.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Entrega una carretada de piedra al rey.";
"T_GAME_QUEST_SCEN4_11_DESC" = "El calor abrasador está pasando factura en nuestros hogares. Las casas se han deteriorado y muchas familias están pidiendo que mejores las condiciones.\n\nSería espléndido si consiguieses mejorar las condiciones de los edificios de la ciudad.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Mejora las condiciones de construcción para obtener felicidad.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Estimado corregidor; sigo esperando la entrega del zumo de uva. Se acerca la fecha del banquete.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Entrega de zumo de uva al rey.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Su señoría: de todo el reino nos llegan peticiones de harina. Las granjas no pueden producir suficiente trigo como para tener los molinos trabajando al tope.\n\nSi consigues entregarme suficiente harina, podría concentrar el mercado y crear un monopolio en esta región. Por supuesto, recibirías una buena recompensa.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Entrega de harina al mercader.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Los townies quieren construir refugios para resguardarse del sol abrasador durante el día. ¡Deberíamos suministrarles tablones de madera para que puedan empezar cuanto antes!";
"T_GAME_QUEST_SCEN4_14_NAME" = "Produce 35 tablones de madera.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Milord, lo has hecho muy bien. La ciudad ha crecido y ahora tiene un tamaño admirable.\n\nSin embargo, los townies siguen sin ser felices debido a la sequía. Deberías intentar cumplir más sus deseos para que aumente su felicidad. Por supuesto, es solo una modesta propuesta...";
"T_GAME_QUEST_SCEN4_15_NAME" = "Consigue que tu ciudad sea muy feliz.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Simplemente maravilloso, estimado corregidor. A pesar de la sequía, has conseguido construir una gran ciudad. Tus townies están muy contentos con los cambios que has hecho.\n\nComo rey que soy, estoy encantado con tu trabajo. Has ofrecido un gran servicio al reino y te recompensaré por ello.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Mi amo: los townies viven rodeaos de pobreza y miseria. La sequía asola el reino. Basta con que eches un vistazo al río que pasa junto al castillo. En su día fluía con todo su esplendor. Ahora solo se ven unos pocos charcos…\n\nEl rey nos ha encomendado ampliar la ciudad. Para empezar, podríamos construir más casas.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Construye 8 casas más.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Milord, el rey está encantado con el éxito de la expansión de la ciudad, pero quiere que construyas una ciudad aún más grande.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Alcanza una población de 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Mi estimado corregidor: soy mercader y podría ayudarte inmensamente en cumplir tu deber. \n\nPuede que el reino esté en plena sequía, pero si construyes un mercado, podré proveer a la ciudad de todos esos artículos necesarios.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Consigue una alta satisfacción en el mercado.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Te lo suplico, mi señor. Con este calor, es necesario que ordenes la construcción de más pozos para abastecer de agua a la población.";
"T_GAME_QUEST_SCEN4_3_NAME" = "Construye 2 pozos.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Traigo buenas noticias, mi señor. Un townie ha descubierto que en los charcos de agua que hay en el lecho del río seco aún hay peces. \n\nDeberíamos ordenar la construcción de casetas para los pescadores.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Construye 2 casetas de pescadores.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Estimado corregidor; le propongo un trato: si conseguimos ampliar nuestra relación comercial, podría hacer que enviasen a la ciudad suministros de comida de forma regular.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Consigue 1000 táleros de beneficios con ventas en el mercado.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Vuelvo a acudir con una propuesta. Necesito urgentemente carbón. Si me proporciona carbón, le recompensaré con una gran bolsa de táleros.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Entrega el carbón al mercader.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Corregidor: mi corte necesita zumo de uva urgentemente, ya que la sequía sigue asolando mi reino y ha acabado con la recolecta de uva.\n\nTe ordeno construir un lagar. Voy a organizar muy pronto un banquete en mi castillo, así que no me decepciones.";
"T_GAME_QUEST_SCEN4_7_NAME" = "Construye un lagar y produce zumo.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Su señoría: mi familia apenas puede cultivar esta tierra seca y abrasada. La cosecha será escasa, así que no basta con una granja.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Construye otra granja.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Se nos están acabando las reservas, milord. Deberíamos suministrar más carne para reducir el consumo de pan en la ciudad.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Produce suficiente carne.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "¡Completa todas las tareas, supera la sequía y haz que tu población se convierta en una gran ciudad!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Ahora solo falta una cosa, milord, ¡y es el zumo de uva para celebrar nuestra victoria!\n\nEntrega una cantidad copiosa de zumo de uva en el campo del ejército.\n";
"T_GAME_QUEST_SCEN5_10_NAME" = "Entrega 45 de zumo de uva al caballero.";
"T_GAME_QUEST_SCEN5_11_DESC" = "¡Absolutamente maravilloso, milord! Lord Blankenstein ha completado con gran éxito su campaña y habla muy bien de ti y de todo lo que le has ayudado.\n\n¿Quieres comprar una última cosa antes de que me vaya?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Consigue 2500 táleros de beneficio con el comercio.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Es una mañana maravillosa, milord. Y tengo buenas noticias: un mercader independiente se ha puesto en contacto con nosotros.\n\nPronto vendrá a nuestra ciudad y nos ha comentado que necesita tablones de madera para construir un puesto para el mercado.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Produce 30 tablones de madera.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Señor, has constituido un punto de comercio excelente. Pero le falta algo vital: una taberna. Si tuviésemos una taberna, nuestra pequeña ciudad atraerá aún a más mercaderes y viajeros.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Consigue una gran satisfacción con las tabernas.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Magnífico, su señoría. Esa taberna nos abrirá muchas oportunidades de negocio en el futuro.\nAhora pasemos a la parte interesante de nuestro acuerdo. ¡A comerciar! ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Consigue 1500 táleros de beneficio con el comercio.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Milord, ¿serías tan amable de abastecernos de telas? Tengo un socio que está tremendamente interesado en telas.\n\nAdemás, en mis viajes conocí a un caballero. Viene de camino y puede que tenga tareas interesantes para ti.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Almacena 25 unidades de tela en el almacén.";
"T_GAME_QUEST_SCEN5_5_DESC" = "¡Milord! Soy Kunibert von Blankenstein, un caballero ungido del rey.\n\nEl punto de comercio es idóneo para ayudarme en mi misión: alejar a los bandidos de estas tierras. ¿Puedes surtirme de piedra para construir atalayas y poder, así, proteger la región?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Entrega 50 de piedra al caballero.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Estimado corregidor: mis talleres de picas necesitan urgentemente hierro para poder abastecer a mi ejército de espadas.\n\nHay varios depósitos de minerales cerca del punto de comercio. ¿Puedes entregar un envío de hierro a mi criado?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Entrega 65 de hierro al caballero.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Tengo un problema, su señoría. La última batalla contra los bandidos dejó mellada la armadura de parte de mi infantería. \n\nAlmacena herramientas para que mis soldados puedan reparar su armadura cuando visiten el punto de comercio.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Produce 25 herramientas.";
"T_GAME_QUEST_SCEN5_8_DESC" = "¡Traigo buenas noticias, estimado corregidor! Mi campaña ha sido todo un éxito y hemos conseguido expulsar de la región a todos los bandidos.\n\nDurante esta larga campaña, hemos utilizado todas nuestras provisiones. Necesito que alimentes a mi ejército.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Entrega 25 de pescado y 25 de pan al caballero.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Mis tropas quieren celebrar nuestra victoria contra los bandidos, pero ahora que les hemos derrotado, están inquietas. \n\n¿Querrías construir lugares de entretenimiento en la aldea, mi señor?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Mis tropas quieren celebrar nuestra victoria contra los bandidos. Sin embargo, ahora que ya no están los bandidos para molestar, mis hombres se empiezan a poner nerviosos.\n\n¿Podrías construir un campo de justas para que los soldados puedan quemar adrenalina?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Consigue una gran satisfacción con los campos de justas.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Completa todas las tareas para construir un punto de comercio fructífero.";
"T_GAME_QUEST_SCEN5_SUCESS" = "Simplemente espléndido, milord. \n\nHas establecido con éxito un punto de comercio en este lugar de importancia estratégica. El rey y Lord Blankenstein están encantados con tu trabajo y con lo que les has ayudado en la campaña contra los bandidos de esta región.";
"T_GAME_QUEST_SCEN6_1_DESC" = "¡El rey envía una orden! Demanda una cantidad tremenda de material para construir una catedral. La construcción de este edificio monumental ya ha comenzado, así que deberíamos entregar los recursos cuanto antes.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Entrega los recursos para la construcción de la catedral.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Intercambia lana por pescado.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Intercambia metal de hierro por pescado.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Intercambia zumo de uva por pescado.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Intercambia metal de oro por pescado.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Intercambia tableros de madera por pescado.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Veo que no hay ni lagos ni ríos cerca, así que no podrás producir pescado. Construye un mercado y allí podré intercambiar el pescado a cambio de bienes varios.";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Construye 2 minas más.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Construye 3 minas más.";
"T_GAME_QUEST_SCEN6_3_DESC" = "¡Deberíamos empezar la extracción enseguida! Asegúrate de que hay suficientes minas funcionando para que podamos cumplir el plazo de entrega.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Construye una mina.";
"T_GAME_QUEST_SCEN6_4_DESC" = "¡Tus townies están trabajando enérgicamente para conseguir extraer todo ese mineral! No te olvides de suministrarles suficiente comida para que estén en forma.";
"T_GAME_QUEST_SCEN6_4_NAME" = "Construye una panadería.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Vamos bien de tiempo, pero aún tenemos que fundir el mineral.";
"T_GAME_QUEST_SCEN6_5_NAME" = "Construye 2 fundidoras.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Trabajar en la mina húmeda, fría y oscura sin tener la ropa adecuada es muy desagradable. Ofréceles a los townies ropa de abrigo para trabajar. ¡Seguro que te lo agradecerán!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Entrega 25 piezas de ropa.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Milord, ¡estamos produciendo montones de recursos! ¡Hay que construir más almacenes para guardar todos estos recursos!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Construye 2 almacenes.";
"T_GAME_QUEST_SCEN6_8_DESC" = "¡Qué duro que es trabajar en la mina! Tus townies estarían encantados si les ofreces un lugar para relajarse tras un duro día de trabajo. ¡Una taberna vendría genial! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "Construye una taberna.";
"T_GAME_QUEST_SCEN6_END_DESC" = "¡Qué bien! ¡Has conseguido entregar todos los recursos necesarios para construir la catedral! Una pena que la construcción dure tanto.\n\nLa catedral conmemorará a nuestro gran rey, cuyas hazañas han traído una era de paz y armonía que durará siglos.";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "¡Recuerda que puedes eliminar cualquier árbol que te moleste! Utiliza la pala para marcar los árboles que quieres quitar.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Estimado corregidor: ¡no podemos preparar un pastel de boda sin los ingredientes correctos! ¿Serías tan amable de construir una granja para producir nuestra propia harina?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Construye una granja.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Construye un molino de viento.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Produce 25 de pan.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "¡Esta será una boda maravillosa! Lo primero, necesitamos asegurarnos de que tenemos un pastel de boda excelente. ¿Podrías construir una pastelería mientras busco mi traje de boda?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Construye una panadería.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Necesito un mercado para poder deshacerme de todos los regalos de boda que no me gusten.";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Consigue una alta satisfacción en el mercado.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Milord, los preparativos de la boda van viento en popa. Eso sí, necesitamos más herramientas para construir la carpa nupcial.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Construye un taller de herramientas.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Produce 20 herramientas.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Quiero que nuestra ceremonia de boda se celebre en una hermosa iglesia. ¿Ya me has construido una?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Consigue una gran felicidad religiosa.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Construye un pasto para ovejas.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Construye un telar.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Produce 20 trozos de tela.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "¡No me lo puedo creer! ¡No he podido encontrar ningún traje de boda decente! ¡Necesito uno ya mismo! Consigue que el mejor sastre me haga uno.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Construye una sastrería.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Crea decoraciones.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "¡Aumenta la felicidad de tus townies!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Este lugar es lúgubre… ¿Puedes decorar la ciudad para que sea más bella? ¡Quiero que todos se sientan tan felices como yo!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Me importa un rábano las flores y el pastel. ¡Lo que quiero es una celebración por todo lo alto con litros y litros de zumo! ¡Y quiero que venga toda la ciudad! Vaya, no tenemos suficiente sitio para hospedar a todos los invitados.";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Construye más casas.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Quiero un lugar chulo para estar con mis amigos cuando se acabe la boda. ¡Esta ciudad lo que necesita es una taberna!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Consigue una gran satisfacción con las tabernas.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Produce 25 zumos de uva.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "¡Mis amigos estarán sedientos! ¿Ya te has encargado del zumo?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Construye un lagar.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Habrá más invitados de los que esperábamos. Construye una casa grande.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Construye una casa grande.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Produce 15 joyas.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "¡Oh, no! ¡Menudo marrón! ¡He perdido el anillo de boda! ¡No se lo cuentes a ella, por favor! ¿Hay alguna orfebrería en la ciudad para que me hagan uno nuevo?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Construye una orfebrería.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Antes de que me case, quiero impresionar a mi prometida en el campo de justas.";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Construye un campo de justas.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Milord, los almacenes de nuestro castillo ya están llenos hasta los topes de mercancías. Sugiero que ordene la construcción de otro almacén.";
"T_GAME_QUEST_SCEN8_10_NAME" = "Construye un nuevo almacén.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Los hombres townies serían mucho más felices si hubiese un lugar en la ciudad para quedar y tomarse un vasito de zumo de uva tras un duro día de trabajo. ¿Sería mucho pedir que se construya una taberna, milord?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Consigue una gran satisfacción con las tabernas.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Milord, el herrero ha construido unos hornillos sencillos para los townies, pero aún necesitamos carbón para calentarlos.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Produce 50 de carbón.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Milord, a la ciudad le falta leña para poder calentar los hogares. ¡Es muy importante que almacenemos madera!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Produce 75 de leña.";
"T_GAME_QUEST_SCEN8_2_DESC" = "La ciudad está hecha un desastre. Mira esas casas decadentes. Seguro que se derrumban a la primera tormenta de nieve. Llamemos a un carpintero para que venga a la ciudad a ayudarnos con las reparaciones.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Construye un taller de carpintero.";
"T_GAME_QUEST_SCEN8_3_DESC" = "¡Seguro que este invierno tan duro es una señal del cielo, Milord! ¡Tenemos que arrepentirnos de nuestros pecados! ¡Construyamos un templo para calmar al Todopoderoso!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Consigue una gran satisfacción religiosa.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Milord, los townies se están inquietando, ya que hace mucho frío en sus hogares. Creo que deberíamos acumular lana para que los townies la utilicen para aislar sus casas del frío.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Produce 55 de lana.";
"T_GAME_QUEST_SCEN8_5_DESC" = "¡El gobernador de la provincia vecina nos ha enviado una paloma mensajera con una petición de ayuda! Necesitan urgentemente ropa caliente para los habitantes.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Entrega una carretada de ropajes a la provincia vecina.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Las granjas no pueden producir trigo este invierno, milord. Deja que enviemos a algunos townies al bosque para que cacen ciervos.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Construye algunas cabañas para los cazadores.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Mi leal sirviente. Este invierno tan duro ha afectado seriamente al reino. Los ingresos por impuestos se han visto dramáticamente reducidos. Te ordeno que construyas una tesorería para poder incrementar la recolecta de impuestos. Como tributo, envíame un carro lleno de táleros.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Construye una tesorería y entrega un tributo de monedas al rey.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Ahora que tenemos a un carpintero, no nos costará demasiado reparar las casas dañadas. Los townies estarán muy contentos.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Asegúrate de que todas las casas están bien reparadas.";
"T_GAME_QUEST_SCEN8_9_DESC" = "La carne está siempre disponible, incluso en invierno, y puede ser un substituto del pan. Asegurémonos de que hay suficiente carne para todo el invierno.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Produce 50 de carne.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Milord, el invierno es más crudo de lo que esperábamos y los townies no están nada contentos. ¡Tenemos que actuar enseguida o no llegaremos a la primavera!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Consigue que la ciudad sobreviva el invierno.";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Milord, ¡los townies están muy satisfechos con el progreso que hemos hecho! Ya tenemos suficientes suministros para que nos duren hasta la primavera. Incluso hemos podido ayudar a la provincia vecina. ¡Ya estamos preparados para el invierno!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Milord, he oído que tienes problemas con los insurgentes de la zona. Me ofrezco para dirigir un equipo de búsqueda para ir al bosque, pero mis mercenarios piden un pago por adelantado.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Paga a los mercenarios.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Pero tengo otra petición, mi leal sirviente. Necesito un buque insignia propio de un rey, es decir, ¡con decoración ostentosa en oro! Te ordeno que me entregues el oro que necesito para ello. No me decepciones.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Entrega metal de oro al rey dentro del límite de tiempo.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Mi leal sirviente: la construcción de mi nueva flota progresa adecuadamente, pero aún necesito grandes cantidades de lona para las velas. Entrégame la suficiente tela como para las velas de todos mis barcos.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Entrega la tela para fabricar la lona para las velas.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Mis hombres han descubierto algo. Hemos encontrado huellas de bandidos en el bosque. Pero, antes de continuar con la investigación, necesitamos más alimentos.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Entrega alimentos a los mercenarios.";
"T_GAME_QUEST_SCEN9_14_DESC" = "¡Gobernador! Los bandidos de tu provincia se han llevado un cargamento entero de tablones. Esto tiene que acabar. Entrega más tablones de madera cuanto antes.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Entrega tablones de madera para la construcción de la flota del rey.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Milord, el recaudador de impuestos ha encontrado pruebas de la conexión entre los bandidos del bosque y el saboteador de la ciudad. Se niega a contarnos más, ya que teme por su vida.\n\nPide que le cesen de su cargo como recaudador de impuestos. También quiere un atuendo nuevo para poder escapar de la ciudad y poder ocultarse. Solo entonces nos dirá todo lo que ha descubierto.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Despacha al recaudador de impuestos de sus tareas en la tesorería y dale ropa nueva para que pueda salir de la ciudad sin que lo detecten.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Milord, tal y como prometió, el recaudador de impuestos, antes de huir, ha revelado la identidad del saboteador. ¡Se trata del mercenario y sus hombres! ¡Son estafadores! Van de ciudad en ciudad y, a cambio de dinero, ofrecen “protección” de los bandidos y del sabotaje a los que ellos mismos se han comprometido.";
"T_GAME_QUEST_SCEN9_17_DESC" = "¡Traigo malas noticias, milord! ¡Alguien ha entrado a la fuerza al almacén y ha robado nuestra carne! Mejor será que coloquemos algunas antorchas por la ciudad para que nos ayuden a atrapar a los ladrones por la noche.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Coloca 7 antorchas por la ciudad para disuadir a los ladrones.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Mi amo, como los mercaderes ambulantes tardarán en llegar, necesitamos más sitio para almacenar todas las mercancías. \n\nAdemás, deberíamos detener cualquier producción innecesaria para no sobrecargar excesivamente los almacenes.\n\nMientras tanto, deberíamos construir otro almacén.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Construye otro almacén en la ciudad.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Los townies están muy asustados por el saboteador. Ni siquiera se atreven a salir y reparar los edificios. Imagino que tendremos que construir un taller de carpintería si queremos que se ejecuten las reparaciones.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Construye un taller de carpintero.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Buenos días, milord. Es un hermoso día de invierno. En los próximos meses, vamos a tener mucho trabajo. Es por ello que es mejor empezar ahora: construyamos un par de casetas para guardas forestales.";
"T_GAME_QUEST_SCEN9_1_NAME" = "Construye casetas para los guardas forestales.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Milord, me han pedido que me presente ante ti. Por todo el reino hay demanda de herramientas. Pagaré generosamente si me entregas un cargamento de herramientas. Además, volveré a tu ciudad para comerciar.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Entrega un cargamento de herramientas al mercader.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Milord, ¡traigo noticias importantes! Una banda de mercenarios acaba de llegar y ya se están quejando de que no hay ninguna taberna. \n\nDeberíamos evitar tener a un grupito de mercenarios aburridos e infelices en la ciudad. Mejor será que construyamos una taberna. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Incrementa la felicidad con la taberna.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Gobernador, me complace ver que tus esfuerzos por aumentar la producción de madera están yendo bien. ¿Podrías encargarte ya de hacer la primera entrega?";
"T_GAME_QUEST_SCEN9_3_NAME" = "Envía un tributo de madera al rey.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Milord, han llegado hasta mis oídos varios rumores de que hay disturbios en la ciudad. Tal vez, algunos townies estén conspirando contra la corona. \n\nSi no actuamos ya, podríamos encontrarnos con una auténtica rebelión. Deberíamos asegurarnos de que los townies están contentos... ¡Y rápido!";
"T_GAME_QUEST_SCEN9_4_NAME" = "Mantén la felicidad por encima del 100 % durante un par de minutos.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Milord, ¡esto es un ultraje! ¡Han destruido la taberna! Hablan de un saboteador prófugo en la ciudad. \n\nTenemos que controlar la situación antes de que se nos vaya completamente de las manos. Seguro que las horcas y las picotas nos ayudarán a conseguirlo.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Construye una horca y 2 picotas.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Milord, convendría aumentar un poco más la moral de los townies. \n\nSi muestras amabilidad, su felicidad seguro que serán más felices. ¿Por qué no construimos una iglesia o embellecemos la ciudad con jardines?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Construye jardines y una iglesia.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Gobernador, siento informarle de que, por ahora, no puedo visitar la ciudad.\nHay rumores de que hay bandidos en el bosque que rodea la ciudad. La zona es demasiado peligrosa para los mercaderes.\n\nSin embargo, el rey ha enviado un mensaje. Ordena que construyamos dos aserraderos.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Construye 2 aserraderos.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Tengo una idea, milord. Deberíamos construir una tesorería. El recaudador de impuestos visitará todas las casas y, tal vez, consiga algo de información sobre el saboteador.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Construye una tesorería y espera a que el recaudador de impuestos investigue las casas.";
"T_GAME_QUEST_SCEN9_9_DESC" = "¡El saboteador ha destruido el aserradero! Además, el recaudador de impuestos no ha conseguido aún descubrir la identidad del saboteador, milord.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "¡No has conseguido evitar a tiempo la sublevación social!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "¡Has fracasado! Por culpa de tu incompetencia, he tenido que pedir mi oro a otra ciudad.";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Gobernador, pronto encargaré la construcción de una gran flota de barcos de guerra. Tu ciudad tiene el potencial de convertirse en mi mejor proveedor de madera para este enorme proyecto. Asegúrate de que así sea.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Milord, el mercenario y su banda han huido de la región. Mis hombres los seguirán sin piedad.\n\nTambién quiero agradecerte por haberme ayudado a construir mi nueva flota y quiero invitarte al viaje inaugural del buque insignia. Hasta entonces, que tengas un buen día.";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Apoya al rey en su proyecto.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "¡Fenomenal! ¡Has prevenido las tensiones sociales!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "¡Fenomenal! ¡Has entregado justo a tiempo!";
"T_GAME_QUEST_SCEN_10_DESC" = "¡Nuestros caballeros merecen divertirse en las tabernas después del torneo! Pero me preocupa que no tengamos ni suficientes tabernas ni suficiente zumo de uva. ¡Soluciona este problema inmediatamente!";
"T_GAME_QUEST_SCEN_10_NAME" = "Construye una taberna y produce suficiente zumo.";
"T_GAME_QUEST_SCEN_11_DESC" = "¡Excelente, corregidor! La ciudad está lista, pero mis hijas no. ¡Necesito que los sastres confeccionen las prendas más esplendorosas del reino!";
"T_GAME_QUEST_SCEN_11_NAME" = "Paga un tributo de 35 prendas.";
"T_GAME_QUEST_SCEN_12_DESC" = "¡Queda poco para que comience el torneo y no quiero ver a nadie triste en la ciudad! ¡Asegúrate de que los townies estén contentos!";
"T_GAME_QUEST_SCEN_12_NAME" = "Aumenta la felicidad.";
"T_GAME_QUEST_SCEN_1_DESC" = "¡Bienvenido, mi buen corregidor! Como sabrás, quiero celebrar las justas más importantes de la región. ¡Espero que construyas, al menos, 3 campos de justas para la ocasión! ¡No me decepciones!";
"T_GAME_QUEST_SCEN_1_NAME" = "Construye 3 campos de justas.";
"T_GAME_QUEST_SCEN_2_DESC" = "¡Los invitados al torneo querrán comer mucho! Quiero que comiences a elaborar pan y se lo entregues al rey como tributo.";
"T_GAME_QUEST_SCEN_2_NAME" = "Entrega un tributo de 25 panes.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Construye un molino y produce harina.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Construye 2 panaderías y produce pan.";
"T_GAME_QUEST_SCEN_3_DESC" = "Mi amo, ¡no podemos hacer esperar al rey! ¡Necesitamos trigo y harina para empezar a elaborar pan!";
"T_GAME_QUEST_SCEN_3_NAME" = "Construye una granja y produce trigo.";
"T_GAME_QUEST_SCEN_4_DESC" = "¡Muy bien, mi buen corregidor! Pero solo con pan no vamos a satisfacer los estómagos de los invitados. ¡Demando pescado fresco como tributo al rey!";
"T_GAME_QUEST_SCEN_4_NAME" = "Entrega un tributo de 25 unidades de pescado.";
"T_GAME_QUEST_SCEN_5_DESC" = "¡Quiero que el torneo sea inolvidable! ¡Nuestros caballeros deben portar lanzas de oro y los campos de justas deben vestir sus mejores galas! ¡Recauda impuestos para tu rey!";
"T_GAME_QUEST_SCEN_5_NAME" = "Paga un tributo de 1000 táleros.";
"T_GAME_QUEST_SCEN_6_DESC" = "¡Seguro que a los invitados les encantaría saborear nuestros sabrosos zumos de uva recién hechos! Construye lagares. ¡Puedes servir los restos de peor calidad en las tabernas locales!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "¡Seguro que a nuestros huéspedes les encantaría el delicioso sabor de nuestro zumo de uva recién exprimido!";
"T_GAME_QUEST_SCEN_6_NAME" = "Construye un lagar y produce zumo.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Construye un telar y produce tela.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Construye una sastrería y produce ropa.";
"T_GAME_QUEST_SCEN_7_DESC" = "Corregidor, ¡los tabardos de nuestros caballeros están viejos y descoloridos! ¡No puedo ni verlos! ¡Consigue unos nuevos! Si quieres conservar tu cargo, construye pastos para ovejas, contrata a un tejedor y construye una sastrería.";
"T_GAME_QUEST_SCEN_7_NAME" = "Construye 2 pastos para ovejas.";
"T_GAME_QUEST_SCEN_8_DESC" = "Tendríamos que vender más artículos para conseguir dinero, milord. Siempre viene bien tener táleros de sobra para cubrir gastos futuros.";
"T_GAME_QUEST_SCEN_8_NAME" = "Consigue 500 táleros comerciando.";
"T_GAME_QUEST_SCEN_9_DESC" = "Las cosas marchan bien. pero la ciudad no es muy bonita que digamos. Quiero ver fuentes, muros de piedra blancos, árboles y espléndidas estatuas. ¡Embellece la ciudad con más decoraciones!";
"T_GAME_QUEST_SCEN_9_NAME" = "Aumenta la felicidad con decoraciones.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Primero te aconsejo asignar a un trabajador a una de las cabañas forestales de la zona.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Asigna a un trabajador a la cabaña de guarda forestal.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Una de las tareas principales es construir un mercado.\nPara conseguirlo, debes establecer varias cadenas de producción de recursos y obtener los recursos necesarios, mi señor.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Construye un mercado.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Mi señor, te recomiendo que asignes a un townie al aserradero para que podamos empezar a producir tablas cuanto antes.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Asigna a un trabajador al aserradero.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Mi señor, te aconsejaría que pases a obtener piedra en las minas en lugar de mineral de hierro.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "En cuanto hayas acumulado tablas y madera, debes asignar a unos de los trabajadores a la mina para empezar a obtener piedra.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Muy bien, mi señor. Ahora solo tenemos que esperar a que se termine de construir el mercado.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Asigna a un trabajador a la mina.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Tu segunda tarea principal es construir una taberna.\n\nDeberíamos empezar a construirla inmediatamente.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Construye una taberna";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Buenas noticias, mi señor. Han venido varios townies a ofrecernos su apoyo para la tarea. Debes construirles una casa.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Construye una casa.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Para construir la taberna necesitamos un taller de herramientas. Para empezar, te recomiendo que construyas una carbonera.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Construye una carbonera.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "El siguiente edificio que necesitamos es una fundición. Así podremos empezar a producir vigas de hierro.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Construye una fundición.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "¡Mi señor! Para empezar la producción de herramientas necesitamos construir un taller de herramientas.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Construye un taller de herramientas.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "El suministro de comida está descendiendo, mi señor. Deberías ordenar a un townie que pesque o cace algo. Si los townies no consiguen comida pronto, bajará su productividad.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Produce algo de comida.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Mi señor, como humilde mercader estoy a tu servicio. Veo que necesitas monedas para tus proyectos de construcción.\nSi lo deseas, te puedo comprar mineral de hierro.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Intercambia mercancías con el mercader.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "¿Te has quedado sin dinero, mi señor? No hay problema. Estoy dispuesto a comprarte pieles de animales.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Gobernador, necesito pepitas de oro. ¿Estás dispuesto a vendérmelas?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Mi señor, no me encuentro muy bien. Debería verme un doctor.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Cura a los townies enfermos.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "¡Fuego! Hay que enviar a un townie para que lo apague de inmediato.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Apaga el fuego.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Los bandidos nos incordian incluso aquí. Mi señor, deberíamos asignar algunos townies a las torres de vigilancia hasta que hayamos rechazado el ataque.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Defiende la ciudad de los bandidos.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Mi señor, ¿podemos descansar un poco y tomar un bocado?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Produce algo de pan.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Mi señor, tenemos muy pocos townies para este reto. Debemos asignarlos y desasignarlos a los edificios según convenga.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Enhorabuena. Has superado este desafío.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Usa a los townies con sabiduría para resolver todos los problemas.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Buenas noticias, señor. Ya están creciendo árboles en la península que está junto al castillo.\n\nSugiero que construyamos cabañas de guarda forestal allí para conseguir madera más fácilmente.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "¡Mi señor, las cabañas de guarda forestal están abandonadas y en mal estado!\n\nEn esta región se han talado todos los árboles. Las cabañas ya no sirven de nada. \nTe aconsejo que destruyas todos los edificios que ya no son necesarios para obtener madera.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Derriba las cabañas de guarda forestal.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Mi señor, creo que deberías preguntar a la gente de esta aldea. Puede que les sobre algo de madera.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "El rey espera el primer cargamento de tablas.\n\nPodríamos asignar a un townie al aserradero y empezar a producirlas. Te aconsejo que vigiles de cerca las existencias de madera. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Destina a un townie al aserradero.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "¿Cómo te va, gobernador? Espero un total de tres remesas.\n\nDebes prepararte para hacer el primer envío cuanto antes. ¡No me decepciones!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Envía la mercancía al rey.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Mi señor, el rey está satisfecho con el primer envío de tablas.\nDebemos preparar el segundo en cuanto podamos.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "El rey espera el último envío. Cuando haya recibido las tablas, se podrá aumentar la armada real a un tamaño considerable..\n\nTenemos que cumplir nuestra tarea.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "¿Te estás preguntando por qué tu rey no ha recibido todavía el envío? Pues creo que tengo la respuesta.\n\nPara resumirlo: entrégame un pequeño rescate y el rey recibirá tu envío sin más dilación.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Paga el rescate.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Para la construcción de la armada real, necesito muchas tablas.\nPor desgracia, hace tiempo que no recibimos ninguna remesa.\n\n¡Gobernador, tengo una misión para ti! ¡Averigua por qué se han detenido los envíos y soluciona el problema!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Buen trabajo, gobernador. Sabía que podía contar contigo.\n\nGracias a tus esfuerzos, la armada estará lista enseguida.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Acaba con la escasez de madera y entrega suficientes tablas al rey.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "¡Mi señor, sugiero que usemos la madera con sentido común!\n\nPodríamos construir un mercado para poder comprar madera a los mercaderes.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "¿Necesitas madera? Creo que podemos llegar fácilmente a un acuerdo. Hay una pequeña pila totalmente disponible, si la quieres.\n\n¡Ven a comprar todo lo que necesites!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Compra madera al mercader.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Mi señor, necesitarás enviar remesas de madera con regularidad.\n\nSi construyes un gremio comercial podrías preparar pedidos.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Construye un gremio comercial.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "En el gremio comercial puedes preparar órdenes de compra y venta.\n\nPrepara un pedido de madera, mi señor.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "¡Excelente! Mientras tengas monedas para pagar, atenderé tus pedidos.\n\nTus pedidos se gestionarán hasta que los canceles.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Prepara un pedido para comprar madera.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "¡Se ha desatado un incendio en la ciudad! Debemos construir suficientes torretas de incendio para reducir el riesgo de que se vuelvan a producir.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Alcanza una cobertura contra incendios del 80 % con torretas de incendio.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "¡Bandidos! Intentan destruir nuestros edificios. Necesitamos más soldados para rechazarlos y construir más torres de vigilancia.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Construye suficientes torres de vigilancia y garantiza la seguridad de la ciudad con más soldados.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "¡Otra epidemia! Una ciudad tan grande necesita otra enfermería.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "¡Otra epidemia! Una ciudad tan grande necesita otra enfermería.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Construye una enfermería y acaba con la epidemia.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Mi señor, muchos townies no pueden acudir a la iglesia porque siempre está llena.\n\nNecesitamos más iglesias para satisfacerlos.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Mi señor, los townies llevan demasiado tiempo esperando sus bebidas. Necesitamos más tabernas y debemos aumentar la producción de zumo y cerveza.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "No hay entretenimiento en esta ciudad. Debemos construir un campo de justas.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Los townies están satisfechos, pero ahora quieren algunos lujos.\n\nPodemos proporcionarles telas o joyas.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Algunos townies se quejan de que el mercado está abarrotado.\n\nDeberíamos construir uno nuevo o mejorar el que tenemos. De lo contrario, los townies descontentos abandonarán la ciudad.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Me decepcionas, gobernador. Es una desgracia que no hayas podido cumplir tus tareas.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Excelente, gobernador, has satisfecho todos mis deseos sin que un solo townie deje la ciudad.\n\nDoblaré tu recompensa.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Gobernador, varios townies han dejado la ciudad. Esperaba más de ti.\n\nAl menos podrías completar todas mis exigencias. Obtendrás tu recompensa.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Mi señor, tenemos que atraer a más townies a la ciudad o el rey se pondrá muy furioso.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Oh, no, mi señor. Muchos townies han dejado la ciudad. No podemos dejar que se marchen más.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Aumenta la población.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Señor, algunos townies ya se han marchado de la ciudad. Tenemos que ocuparnos mejor de nuestros townies para que no se vayan.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Gobernador, muchos townies se han mudado a esta pequeña aldea.\n\nSatisface todas sus necesidades para impedir que se vuelvan a marchar. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Aumenta la población antes de que se agote el tiempo.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Completa todas las tareas antes de la llegada del rey y mantén la población por encima de 150.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Los porteadores de esta ciudad están sobrecargados de trabajo, mi señor. Debemos construir un nuevo almacén y asignar más townies para el transporte.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Construye un nuevo almacén y asigna más townies para el transporte al castillo.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Nos estamos quedando sin comida. Construyamos una nueva cabaña de pescador. Eso nos servirá.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Mi señor, la pequeña panadería no produce suficiente pan. Podemos mejorarla y asignar a un panadero adicional.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Mejora la panadería a nivel 2 y asigna a otro panadero.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "La necesidad de agua ha aumentado considerablemente. Podemos proporcionar agua a todos los townies construyendo varios pozos.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Construye varios pozos en la ciudad.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Mi señor, debemos aumentar nuestras existencias de comida. Lo que necesitamos es un nuevo pabellón de caza o una carnicería.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Construye un pabellón de caza o una carnicería.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Excelente, mi señor, hemos establecido un buen suministro. Pero debemos seguir atentos a los deseos de nuestros townies.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Mi señor, primero tenemos que conseguir materiales de construcción y destinar a un townie a la cabaña de guarda forestal que está al otro lado del río.\n\nConstruye un camino pavimentado sobre el río para que el townie pueda empezar a trabajar.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Construye un camino pavimentado sobre el río y destina a un townie a la cabaña de guarda forestal.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Construye una carretera sobre el río y destina a un townie a la cabaña de guarda forestal.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Mudarme aquí ha sido mi mayor error. ¡Me marcho!\n\nSeñor, tienes que satisfacer nuestros deseos o cada vez se irán más townies.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "No, gracias.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Una gran idea.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Pensaba que tenías una mentalidad progresista... Bueno, pues sigue con tu mediocridad.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, esto ya está empezando a tomar forma. Debemos proseguir con nuestros esfuerzos y preparar el resto de la producción.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "¡Dominamos el mercado de los artículos textiles para el hogar y la alta costura! ¡Vamos a ganar una fortuna!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Ahora que está disponible la materia prima, se requieren los edificios pertinentes. ¡Bastará con un tejedor y un sastre!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Con tu decisión, se avecinan grandes cambios en la villa. Pero no serán posibles sin... ovejas y una granja en condiciones.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Excelencia, acabo de regresar del pueblo vecino y tienen preciosas telas y bordados. Deberíamos inspirarnos en ellos y producir también ropa excepcional.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Flores de seda";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Ya está aquí la temporada de polen, los habitantes están estornudando todo el tiempo. ¿Y si hacemos un concurso de estornudos?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Cada uno de ellos se concentra y suelta su estornudo más potente cuando le toca. ¡Debes elegir cuál es tu favorito para proclamar al ganador!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "¡ACHÍS!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "¡ACHÍOOOM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "¡AAACHÍUAAAM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "¡Y ya tenemos ganador! ¡El estornudo más estruendoso! ¡Felicidades! ¡Ha sido extraordinario!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "El townie se muestra orgulloso con su premio. El concurso no te ha aportado mucho, pero quizás la ciudad se haga famosa por celebrar el primer concurso de estornudos de la historia.";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Ni hablar.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Desde el castillo, ya se oye a la multitud congregada en la plaza del pueblo. También los estornudos. ¡El concurso promete ser la mar de divertido!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Numerosos townies hacen cola y se aguantan los estornudos para desatar toda su potencia cuando les toque pasar frente al jurado, formado por ti y tu consejero.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Juzgas a un townie tras otro. Has escrito tres nombres y le pasas la lista a tu consejero, que los lleva al centro de la plaza para la final del concurso de estornudos.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Decides hacer correr la voz por la villa y se organiza un concurso en la plaza del pueblo. ¡El townie ganador recibirá un premio!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Excelencia, mientras esperamos a que se reúnan los townies en la plaza, ¡deberíamos preparar las festividades! Empecemos con unos adornos.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Decora la ciudad.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Esto hace que nuestra ciudad resulte mucho más atractiva.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "También deberíamos comprobar nuestras existencias.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Perfecto, tendremos todo lo necesario durante las festividades.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "El concurso de estornudos";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "¡Hagámoslo!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Tienes razón, pongamos algunas estatuas.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "No... no quiero tener estatuas en mi ciudad.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "¡Bravo, señor! Estas esculturas le dan un encanto especial a nuestra ciudad.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ah, señor, algún día tendrías que preocuparte por esta clase de detalles.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Señor, nuestra ciudad no tiene estatuas. ¿Qué tal si añadimos unas cuantas más? Además, es creencia popular que las estatuas protegen a los habitantes.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Ángeles duros como piedras";
"T_GAME_QUEST_SUCCESS" = "¡Misión completada!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "Muy loable su intención, que lo haga.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Qué persona más rara.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Señor, no podemos dejar que el tipo haga esto. Construyamos un campamento de malabaristas y pongamos a este lunático a cargo del entretenimiento.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "¡Excelente! La población parece encantada con el resultado.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Observas la aldea a lo lejos.\n\nEl cazador de lágrimas sigue persiguiendo a los townies. Cada vez son más los que se niegan a salir de sus casas.\n\nTe apartas despacio de la ventana para no ser testigo de los perjuicios causados por tu decisión.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Quizá deberías haber hecho algo.... Este extraño townie tiene aterrorizados a los habitantes y la moral no hace más que bajar. ¡Esperemos que no dure!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Gobernador, esta mañana me han dicho que uno de los aldeanos se ha empeñado en hacer feliz a todo el mundo. Así que se ha puesto a perseguir a los habitantes para hacerles reír... a la fuerza.";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "El cazador de lágrimas";
"T_GAME_QUEST_THE_BATH_B_001" = "Por los pelos. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Proclamemos que el baño es obligatorio. ¡Esto reducirá las enfermedades!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Baños no obligatorios.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "¡Nunca aprenderás de tus errores!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Excelencia, se ha declarado otro brote de enfermedad. En esta ocasión, mucho más grave que el anterior.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Esta vez, excelencia, te guste o no, ¡declaro obligatorio bañarse!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Tu consejero ha salvado a mucha gente de la enfermedad. Incluso ha entrado en los anales de la historia. Sin embargo, tú fuiste el que rechazó los baños y, por eso, serás venerado por cientos de niños —pasados incluso años— porque, cito: «El baño es lo peor». ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "¡Baños obligatorios!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Sabia decisión, excelencia. Ahora tendremos menos enfermedades.";
"T_GAME_QUEST_THE_BATH_DESC" = "Hace unos días, hiciste instalar unos baños públicos en tu ciudad. Pese a lo excelente de la idea, los townies le tienen miedo al agua y no se atreven a lavarse. \n\n¿Qué hacemos?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Calienta el agua.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Almacenemos suficiente madera para poder calentar el agua de los baños.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Es perfecto. El agua está a buena temperatura y hemos logrado convencer a algunos residentes para que se laven.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Por desgracia, tus esfuerzos han sido en vano y la enfermedad comienza a propagarse por la ciudad.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Déjalos en paz.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Como quieras. Pero luego no me vengas llorando si hay algún brote en la villa.";
"T_GAME_QUEST_THE_BATH_NO_003" = "Durante varios meses, pocos habitantes se lavaron, y cuando cayó enfermo uno de nuestros townies, ¡infectó a otros tres! Algunos incluso estaban convencidos de que la enfermedad provenía de los baños.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Cura a los townies.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Hora del baño";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Sobornos.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Vas a ver a los religiosos y les pides, a cambio de unas monedas, que proclamen en sus sermones que el baño los hará hermosos.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Da el dinero necesario.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Lo único que falta es pagar a los religiosos, excelencia.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Gracias, gobernador, difundiré su mensaje.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Parece que tus esfuerzos han dado sus frutos. La enfermedad es y será menos virulenta por algún tiempo.";
"T_GAME_QUEST_THE_BATH_YES_001" = "¡Obligarlos!";
"T_GAME_QUEST_THE_BATH_YES_002" = "¡Que nuestros pregoneros anuncien la buena noticia!";
"T_GAME_QUEST_THE_BATH_YES_003" = "No todos los aldeanos están contentos con la idea de bañarse regularmente, algunos incluso afirman que se sienten más débiles después de mojarse.\n\nOtros dicen que el agua está demasiado fría y se niegan a bañarse.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Interroga al mago.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Cuando estás a punto de interrogarlo, un denso humo comienza a envolver todo el feudo. No puedes ver ni a un metro de ti.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Ahora te enfrentas a un dilema: entregar los recursos necesarios o dejar que la situación empeore, pase lo que pase. Date prisa y actúa, quién sabe lo que son capaces de hacer los dos magos.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "¡Excelencia! Hemos fracasado, los magos se las arreglaron para coger nuestros recursos y huir.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Da recursos.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "¡Probemos a darle todos los recursos a este mago de pacotilla!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Pudimos producir todos los recursos solicitados y ahora solo queda entregarlos en el lugar indicado.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "A espaldas de tu consejero, pusiste una trampa para los magos para que, tan pronto como vengan a recoger la mercancía, queden atrapados en una red. Esperemos que tu ingeniosa idea funcione.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "¡Excelencia! ¡Hemos conseguido atrapar a un segundo mago!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Has apostado a dos guardias cerca los recursos. Los otros dos magos hacen acto de presencia y se acercan despacio a recoger los recursos. Cuando están a mitad de camino, los guardias activan la trampa.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "No te rindas.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Conque quieres provocar la ira de mis hermanos. No me gustaría estar en tu pellejo, gobernador.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "¡El hombre para el que trabajamos te hará pagar por ello!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "¡Ah! ¡Conque por fin admites que estáis bajo las órdenes de alguien! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "El mago se muerde el labio, en un gesto de arrepentimiento por el desliz. Así que los ha enviado alguien que está personalmente enfadado contigo.\n\nPor más vueltas que le das, no se te ocurre ningún nombre.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Tu consejero viene corriendo, parece asustado: «¡Excelencia! ¡Los magos llaman a nuestra puerta! Nos piden hospitalidad por unos días. ¿Se la damos?»";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Gobernador... Todo esto solo ha sido un desafortunado malentendido. Mis hermanos y yo no queríamos causarte tantos problemas.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Así que sois hermanos. ¡¿Y por qué provocasteis los incendios?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Fue sin querer, excelencia. Somos un poco torpes, eso es todo...";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "¿Para quién trabajáis? ¡¿Para los bandidos?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "¡Para nada! Sin embargo, si quieres deshacerte del denso humo que cubre poco a poco todo el territorio, será mejor que accedas a mi petición.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "¿Y cuál es tu petición? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "¡Quiero que me des recursos y dinero!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "¿Y luego qué más? ¡Dinos dónde están tus hermanos!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Si te niegas, cabe esperar que se produzcan más desastres.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Excelencia, la persona que contrató a los magos, ¿no podría ser el duque de Cannes? Me acabo de acordar de que profirió amenazas contra ti cuando empezaste a cartearte con la reina Frygith.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Puede que tu consejero no ande desencaminado; te viene a la memoria que el duque de Cannes le había propuesto matrimonio a la reina Frygith, pero que, después de tu reunión y de aquel famoso baile, ella rechazó su proposición.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "¡Tú, mago de tres al cuarto! ¡Así que el duque de Cannes es tu jefe! ¡Lo sabemos todo!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "Ciertamente... Ya lo sabes. Hagamos un trato. Dame una buena suma de dinero y mis hermanos y yo te dejaremos en paz. No te molestaremos más.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Excelencia, no estamos en posición de negociar. Démosle la cantidad que pide y terminemos con este asunto de la magia. No podemos luchar contra desastres sobrenaturales.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Aunque no te gusta que te extorsionen, has de admitir que tu consejero tiene razón. El bienestar de los townies es más importante que tu ego.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Solo tenemos que liberar al mago y pagarle su dinero.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Encantado de hacer negocios contigo, gobernador.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "El mago se desvanece con el fajo de billetes. Pero nunca más tienes que volver a lidiar con ellos.\n\nEn cuanto al duque de Cannes, le envías una carta a la reina, que promete ocuparse del asunto personalmente. Bien está lo que bien acaba.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Tras recobrarte del susto y salvar a tu ciudad de las llamas, le pides a la guardia que te traiga a los tres magos. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Tus soldados te dicen que solo han podido encontrar a uno de los tres magos. \n\nLos otros dos no aparecen.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "¡Excelencia! ¿Estás bien? ¡Los magos han hecho volar los edificios! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "¡Hay que apagar los incendios lo antes posible!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "El último de los focos de incendio ya está controlado, excelencia.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "Hay tres magos, que parecen aliviados de que hayas respondido positivamente a su petición. Les das una habitación en la posada y, al ver que ya no necesitan nada, regresas a tus quehaceres como gobernador.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Nada más salir de la posada, oyes una gran explosión. ¡PUUUMBA! ¡Hay varios edificios en llamas!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Ciérrales el paso.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "¡Oh, no! ¡Tenemos una epidemia de peste y varios edificios que se han incendiado! ¡Probablemente sea cosa de los magos!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "¡Ja, ja, ja, ja, ja, ja, ja!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Démonos prisa, ¡curemos a los townies y apaguemos los incendios!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Una vez más, nos hemos librado de un verdadero desastre...";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Que continúe la búsqueda.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "¡Continuaremos la búsqueda, excelencia!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "¡Allí hay uno! ¡Atrapadlo!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Tus guardias empiezan a perseguir al segundo mago cuando, de repente, un denso humo cubre la aldea. Tus guardias cesan la persecución ya que no pueden ver por dónde van.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "¡Excelencia, nos enfrentamos a un nuevo problema! ¡Ya no nos podemos mover rápido! ¡Es como si camináramos a través de gelatina!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Deberíamos retirarnos al castillo e interrogar al mago que logramos capturar.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Siguiendo el consejo, decides atrincherarte en el castillo para iniciar el interrogatorio del primer mago y pedirle al jefe de la guardia que asegure el recinto para que nadie entre ni salga de él.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Decides mantener a los dos magos alejados entre sí e interrogas al mago recién atrapado gracias a tu increíble trampa.\n\nPor desgracia, no lograste recuperar los recursos; se los llevó el tercer mago.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "El segundo mago parece mucho más seguro que el primero y, sin dudarlo, te dice: «Felicidades, gobernador, me has pillado con las manos en la masa, pero si no me liberas de inmediato, le ocurrirán cosas terribles a tu villa».";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Libéralo.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Estás demasiado asustado por lo que le pueda pasar a tu pueblo y decides liberarlo:\n\n«Eres un jugador, gobernador», dice el mago antes de desaparecer en un halo de humo en el preciso instante en que los guardias le quitan las cadenas.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "¡Excelencia! ¡El primer mago también ha escapado! ¡Su hermano apareció a su lado y, luego, ambos desaparecieron!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "... Volvemos al punto de partida.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "¡Patrullaremos en busca de esos bribones, excelencia! Puede confiar en nosotros.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Lo único que tenemos que hacer ahora es esperar a que regresen las patrullas, excelencia.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Durante mucho tiempo, tus guardias tratan sin éxito de encontrar a los magos, pero día tras día la ciudad ve disiparse poco a poco la extraña nube de humo que ralentizaba a todo el mundo.\n\nEl misterio que rodea a los magos seguirá sin resolverse.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Mantenlo prisionero.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Los magos";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Que entren.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Azul.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Verde.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Una elección audaz, he de decir. El azul. ¿A quién no le gusta un color tan bonito? El color del sueño, de la sabiduría y de la lealtad. Eso dice mucho de ti, gobernador.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Hemos alojado a un huésped en la estancia renovada del castillo, excelencia.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Por desgracia, los colores de la habitación le han impedido pegar ojo y te hace a ti responsable.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Oh, excelencia, nuestro huésped se mostró encantado con la estancia, sobre todo le gustó el color. Ha decidido darnos prestigio.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "Es cierto que el verde tiene fama de significar desgracia, pero también es un símbolo de esperanza, suerte y estabilidad. Está en armonía con todos los demás colores de la naturaleza, y tengo que decir que es una buena elección.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Gobernador, acabamos de renovar una de las estancias del castillo. ¿Qué color sería mejor?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "La estancia";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Por supuesto que no.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Manda espías.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "La magia no existe.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Llama a la bruja.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Excelencia, eso es horrible. ¿Cómo es posible? ¿Será un practicante de la magia negra? ¡Nadie debería tener tales poderes!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "Sabia decisión. Enviemos a nuestros mejores espías para que sigan a este townie chiflado y esperemos su informe.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Tus espías han vuelto con un informe.\n\n«Seguimos al townie, el ladrón de la alegría, y parece que sus palabras provocan una gran tristeza en los habitantes. Los townies no recuerdan los momentos alegres de sus vidas.»";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "¡Excelencia! Uno de nuestros habitantes parece estar robándoles la alegría a sus vecinos. \n\nVarios townies han presentado quejas contra él. He aquí el testimonio de una de las víctimas: «Vino a hablar conmigo una mañana. Le escuché atentamente y, de repente, me sentí muy triste».";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Excelencia, ¿hacemos algo para resolver este problema?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Gobernador, ¿qué hacemos?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Ayuda a la bruja.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "¡Los fantasmas no existen!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Las medidas que hemos tomado parecen estar funcionando, excelencia. \n\nEl ladrón de la alegría prosigue con sus fechorías, pero ahora lo combatiremos. \n\n¿Mandamos a los guardias para llevarle ante la justicia por sus actos? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Que se haga justicia.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "No hagas nada.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Eres una persona lógica. Solo la ciencia puede explicar y resolver este problema del ladrón de la alegría.\n\nLlamas a tus mejores científicos para que trabajen en una fórmula que devuelva la felicidad a los townies.\n\nPor supuesto, la ciencia no sale gratis, los científicos piden mucho dinero. Si no se lo das, puedes irte despidiendo de la felicidad.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Este problema del ladrón de la alegría no te ha alarmado, sin embargo, los casos de townies deprimidos se han multiplicado exponencialmente.\n\nConfundido, te refugiaste en tu castillo, sin saber qué hacer con este desastre. Dicen que el tiempo cura todas las heridas. \n\nEsperemos que no se te esté agotando la paciencia.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "La bruja se ha ido. Algunos dicen que incluso se fue de la aldea, no quería sufrir como todos los demás por tu culpa.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Poco después de su marcha, la situación se ha vuelto insoportable. Todos los aldeanos están muy tristes.\n\n¿Quién sabe cuánto tiempo durará esto?";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "¡Enviemos a guardias a buscarlo!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Tus guardias se han pasado horas buscando y nada. Todos han regresados tristes y deprimidos. Dicen que oyeron al ladrón de la alegría, pero que nunca lo vieron.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Poco después de regresar los guardias, llegó un búho con un mensaje de la bruja.\n\nDice que el ladrón de la alegría no era otro que un fantasma que se alimentaba de la alegría de la gente, dejándolos sin nada más que tristeza y desesperación. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "A pesar de los esfuerzos de tus científicos para retrasar el proceso, todo el pueblo se acabó poniendo triste, y sin la bruja, no te quedó más remedio que defenderte tú mismo de este fantasma. \n\nEsperemos que el tiempo cure a los townies.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "El tiempo ha pasado y el pueblo vuelve a estar de buen humor. El ladrón de alegría ya no es más que un lejano recuerdo.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Pide consejo a la bruja.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Negocia.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Excelencia, intentaré negociar con estos científicos. Déjame a mí, yo me encargo de todo.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Tu consejero, ese buen negociador, ha logrado bajar el precio de los científicos. ¡Bien hecho! ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Uf, tu consejero ha sido muy torpe negociando. Los científicos han subido el precio y ya no quieren hablar contigo.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Paga a los científicos.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Si tenemos que pagar, paguemos, porque si seguimos esperando, será nuestra perdición.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Tus habitantes solo sufren una simple depresión, gobernador. No le ven el lado positivo a nada. \n\nLa solución es mostrarles el lado bueno de las cosas y demostrarles que la vida no es tan deprimente. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Empecemos añadiendo adornos y construyendo un recinto para festivales de cerveza. La música sube la moral. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "La ciudad empieza a sentirse mejor, algunos habitantes, cuya alegría se había desvanecido, parecen ganar conciencia otra vez de las pequeñas alegrías de la vida.\n\nPero el ladrón de la alegría sigue sembrando el terror entre los corazones de la gente.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Ladrón de la alegría";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Hace años que no recurrimos a esta bruja, gobernador... Espero que esto no traiga más desgracias al pueblo de las que ya tenemos.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Buenos días, gobernador. Me alegro de volver a verte. ¿Tienes problemas?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Tras explicarle la situación a la bruja, se limita a sonreír. ¿Ha encontrado la solución para tu problema o te la va a jugar?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "¡Bueno, habla pues! ¿Por qué te sonríes así? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Tu ladrón de la alegría no existe, excelencia.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Pero... tiene que ser verdad, ¡uno de nuestros espías sufrió en sus carnes las consecuencias de hablar con él!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "Lo que vio fue un fantasma de la tristeza. A veces, se aparecen después de construir algún edificio religioso. Son espíritus que se alimentan de la alegría de la gente. \n\nAl absorber la alegría, el fantasma se hace más fuerte y aumenta sus poderes. Por desgracia, la gente no recobra la alegría que le fue robada.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "¿Y cómo nos deshacemos de él?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Conozco una solución, pero necesitaría tu ayuda.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Te ayudaremos. ¿Qué necesitas?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Necesitamos un mausoleo y lápidas.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "¡Dalo por hecho!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Hemos hecho lo que nos has pedido, bruja. Es hora de que nos muestres lo que puedes hacer.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "La bruja se dirige al mausoleo y desaparece en su interior. Oyes conjuros. Súbitamente, se alza el viento, parece que se avecine una gran tormenta.\n\nLa bruja aún no ha salido del mausoleo. \n\nDe repente, sientes una gran tristeza.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Luego, a lo lejos, aparece un rayo de sol. Uno muy pequeño. Te centras en él. Cada vez se vuelve más intenso. \n\nEl rayo de sol parece tomar la forma de un recuerdo. Tuyo. Tu recuerdo más feliz.\n\nTe sientes bien otra vez.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Gobernador... ¿qué ha sido eso? ¿Tú también lo has sentido?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Excelencia, ya estáis libres del fantasma de la tristeza. Por vuestras expresiones, deduzco que os lo habéis encontrado. Se acabó. Está atrapado.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "¡Fue horrible! ¡Muchas gracias!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "El pueblo se ha librado del extraño fantasma. Los habitantes han recuperado su alegría y te lo agradecen.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Excelencia, si no me ayudas en este proyecto contra el fantasma, te aseguro que será vuestra perdición.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "¡Que así sea! ¡Desaparece de mi vista con tu malvada brujería!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Déjalos jugar.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "¡Yo también quiero jugar!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "¡¿Un festival de juegos de mesa?! Qué idea más rara, señor. ¿Cómo vamos a hacer eso? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Señor, nuestros soldados juegan tanto en sus torres de vigilancia que los habitantes no se sienten nada protegidos.";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Apuestas en las torres";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Necesitamos madera y piedra.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Necesitamos encontrar ideas y diseñadores de juegos.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Con una pequeña donación podríamos mejorar nuestra reputación ante el rey, excelencia.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Construye un torre de vigilancia al alcance de un barracón.";
"T_GAME_QUEST_WATER" = "Agua";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Cállate, ¿quieres?";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Empecemos a construir el pozo para evitar este tipo de incidentes.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Oh, señor, por favor, nuestras cosechas están en peligro. Si no haces nada, nunca habrá posibilidad de tener un invierno tranquilo.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "El gobernador ya se ha pronunciado sobre este asunto. Si sigues viniendo al castillo a contarnos quejas, tendremos que encerrarte. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "... ¡Pronto te darás cuenta de tu error!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "¡SEÑOR! ¡LOS CAMPOS! ¡Es horrible! Ya no crece nada, el calor ha sido tan intenso que nuestras cosechas están arruinadas... Deberías haber confiado un poco más en ese granjero... Ahora es demasiado tarde.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "No perdamos tiempo y construyamos pozos, señor.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "Hemos terminado la construcción de los pozos. ¡Más vale prevenir que curar! El futuro dirá si hicimos bien en escuchar a este granjero.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "¡Señor! Los agricultores me han dicho que una ola de calor asoló sus campos, PERO que, gracias a los pozos construidos, has evitado muchos problemas.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "¡Señor! ¡He tenido otro sueño premonitorio! Los campos eran pasto de las llamas. Ya no crecía nada. No había agua disponible.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Premonición";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Dale un té de hierbas y que se calme. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Bueno, hablando de té de hierbas, vamos a propagar la idea: busquemos un eslogan pegadizo y que las ciudades cercanas sepan lo estupenda que es una infusión de hierbas.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "¡Mejora las defensas!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "¡Mejoremos las defensas militares, gobernador!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Hemos hecho un gran trabajo. «El té de hierbas con el que no te hierve la sangre» es un eslogan muy pegadizo...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Esperemos... Por lo que sabemos, hemos montado todo este jaleo por nada. Deberíamos haberle dado un té de hierbas...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Pese a tus expectativas, y a la mejora de las defensas en caso de ataques sorpresa por parte de bandidos, la bruja no hizo acto de presencia. No obstante, ahora tienes unos preciosos edificios militares que admirar.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Oh, no, señor, ¡la vieja vuelve a las andadas! Está gritando desde los tejados que la bruja del bosque pasará por nuestra aldea y destruirá todo lo que se interponga en su camino.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "El camino de la bruja";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "¡Ah, excelencia! \n\n¡Lo de allí abajo ha sido increíble! ¡Un lago de gran inmensidad y belleza! \n\n¡La mujer estaba allí! Corrí tras ella durante un kilómetro largo por los túneles de la mina, antes de perderla de vista.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "Y entonces... cuando creía que me volvería con las manos vacías, vi miles de luces. Oh, excelencia, deberías haber estado allí, ¡nunca he visto nada igual! \n\nLa mujer me contó sus planes para escapar con todo el botín y empezar una nueva vida en otro lugar. Desde la muerte de su marido, le cuesta seguir aquí, demasiados recuerdos...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Excelencia, ya estamos listos para entrar en la mina y encontrar el botín. Hay varias cruces en el mapa.\n\n¿Por dónde empezamos? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Escondite del norte";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Escondite del sur";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "¡Oh, EXCELENCIA! ¡Ha habido suerte! Nuestro equipo logró escapar ileso. ¡Los túneles se han derrumbado!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "El resultado de esta primera expedición es muy satisfactorio. Tu gente ha logrado regresar sana y salva de esta expedición y con parte del tesoro del pirata como recompensa.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Excelencia, ya estamos listos para entrar en la mina por segunda vez.\n\n¿En qué escondite miramos?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Escondite del este";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Escondite del oeste";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "¡La suerte nos sonríe, excelencia! ¡Dos veces hemos salido triunfantes de esta búsqueda del tesoro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Estudias detenidamente los planos. Se puede ver la ubicación de un lago subterráneo, alimentado por un río que lleva directamente al mar, un acceso muy útil para los piratas.\n\nNo obstante, estos túneles no son seguros y corren peligro de derrumbarse en cualquier momento.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "¡Buenas noticias! Mientras ayudabas al herrero, tu consejero pudo hacerse con los planos de la mina.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Asegura la mina.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "¡Envía exploradores a la mina!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Invirtamos en la mina para que sea segura, excelencia. Es una tarea que requerirá muchos recursos de nuestra parte, pero seguro que no te arrepentirás.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "¡Increíble, excelencia! ¡Logramos asegurar la mina! Nuestros primeros exploradores salieron de patrulla y ¡encontraron a la esposa del pirata!\nLa mujer consiguió escapar, pero se dejó un mapa de la mina con zonas marcadas con una cruz. Creo que son los sitios donde se oculta el tesoro.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Lo único que resta es pagar el tributo, excelencia.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Exploradores, exploradores.... ¡No tenemos 50! Voy a hacerlo yo mismo. Pero antes necesito equiparme, al menos.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Muy bien, ¡estoy listo!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Tu consejero ha ido a las minas a averiguar un poco más sobre la mujer.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Tráeme el equipo necesario para que esta misión sea un éxito.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "De repente, pierdes la paciencia con el herrero. Le ordenas que vaya a por sus herramientas lo antes posible y que su pedido urgente no es problema tuyo. Te importa un bledo, como si se declara en quiebra.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Lo... lo traeré lo antes posible, señor...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Has sido grosero al negarte a ayudar a este herrero. Has de entender que tiene que trabajar para ganarse la vida y esta entrega parecía ser muy importante para la economía de tu ciudad. Espero que no nos lo reproche.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Uf, excelencia... Deberías haber tenido más tacto. El herrero le ha contado a todo el mundo cómo lo has tratado. Varios townies están protestando. Y el herrero se niega a volver al castillo.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Excelencia, no veo otra alternativa que construir un campo de justas. Eso distraerá a la gente y les permitirá liberar tensiones.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Los habitantes parecen haberse calmado, pero no hemos terminado con esta historia de piratas.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Excelencia, hace falta un campo de justas. De lo contrario, los townies no serán ni felices ni productivos. Esta huelga nos hará perder un tiempo precioso por este asunto de piratas y minas.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Excelencia, mientras estábamos ocupados con la revuelta, la esposa del pirata aprovechó para recuperar el botín que había en las minas. ¡Ahí estaba el tesoro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Nuestros espías han encontrado una nota de la mujer diciendo que ya no soportaba la ausencia de su marido y que se retiraba a una isla paradisíaca donde posee un pequeño castillo.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Parece que se nos ha escapado una buena suma de dinero, excelencia. ¿Ves adónde nos llevan tus decisiones apresuradas? En fin, pasemos página";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Construyamos un campo de justas.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Es un error tomarse esta cuestión tan a la ligera, excelencia. ¿Quién sabe lo que podríamos haber descubierto?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Pocos días después de que te negaras a tratar esta queja, la mina se vino abajo. La gente te hace responsable de este trágico suceso.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "Tu gente está empezando a olvidar el tema de la mina derrumbada. El tiempo ha pasado y su moral está alta.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "No pudimos acceder a los lugares indicados en el mapa, excelencia. No hemos podido traer botín alguno. Pero estamos vivos, que es lo más importante.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Pese a tu fracaso, esta aventura te reporta prestigio. ¿Quién iba a pensar que los piratas podrían esconder tales tesoros en tus minas?\n\nAunque, por ahora, tu carrera como buscador de tesoros ha terminado.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Oh, excelencia. ¡Me han dicho que los túneles de la mina se han derrumbado! Hemos tenido suerte de poder volver dos veces con tesoros.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Por una vez, decides organizar un gran banquete para tus soldados, para agradecerles que te hayan traído estos tesoros.\n\nEsta historia de piratas queda ya atrás. ¿Quién sabe? A lo mejor un día encuentras un mapa que te lleve a otros misterios.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "¡El tesoro pronto será tuyo! \n\nDas orden a tus soldados de que vayan a buscar el tesoro y que te lo traigan.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "¡Increíble! ¡Mira todo lo que hemos encontrado en las minas! Has hecho bien en asegurarlas antes de enviar a tu gente allí. ¡Cuántas riquezas! Los rumores sobre ese pirata resultaron ser ciertos. ¡Somos ricos!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Con la información que tenemos, no hay mucho que podamos hacer. Sería aconsejable pedir consejo a un experto.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Llama a un minero.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "Buena idea, excelencia. Quizá pueda darnos un mapa de las minas y ayudarnos a entender más cosas.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Excelencia, me alegro de que me pidieras ayuda. He traído los planos de las minas. Espero que sirvan.\n\nEstos túneles son viejos y temo que se derrumben.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Llama al herrero.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Seguro que el herrero sabrá informarnos de las piedras que la mujer está tratando de romper.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Excelencia, hemos recibido varias quejas sobre las minas.\nUna mujer va allí todos los días, mueve piedras y, a veces las rompe. Pero lo peor es que cada vez se interna más en los túneles.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Ve a indagar sobre la mujer.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "No es asunto mío.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Los townies están preocupados, los túneles no son seguros y la mina podría derrumbarse en cualquier momento.\n\nEs nuestro deber comprobar lo que hay tras esta historia.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "¡Espero que hayas aprendido la lección!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Mientras tu consejero busca pistas, sería buena idea que cuides de tu pueblo por un tiempo y trates de mejorar la vida de tu gente.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "¡Aquí estoy de nuevo, excelencia! Me dediqué a seguir a la mujer sin que se diera cuenta. No ha sido fácil.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Parece que está buscando un objeto. La vi rompiendo varias piedras y mirando detenidamente los trozos.\n\nPor desgracia, no pude seguirla muy lejos, ¡parece que se conoce las minas como la palma de su mano!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Tu consejero ha regresado de su misión con noticias:\nen su informe se afirma que esta mujer se ha quedado viuda hace poco. \n\nSu marido era un pirata muy famoso. Dicen que poseía el mayor tesoro de todos los tiempos y que lo había escondido no muy lejos de aquí.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Tengo una teoría, excelencia. Creo que esta mujer fue amenazada por otros piratas para que revelase la ubicación exacta del tesoro";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Continúa con la investigación.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Déjalo correr.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "La mujer y la mina";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "El herrero llega enseguida. Tus guardias lo sacaron de su herrería a toda prisa. Parece preocupado.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Señor, ¿qué puedo hacer por ti?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Estamos en una misión y necesitamos de tu experiencia.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Soy todo oídos.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Tu consejero le explica el caso al herrero.\n\nTambién le muestra las piedras rotas que pudo recoger. Con el rabillo del ojo, puedes ver que el herrero parece reconocer este tipo de piedra.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "¡Recórcholis! ¡Son muchas geodas!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "¿Geodas, dices? ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "Son cristales especiales que pueden contener tesoros. A menudo, cristales que pueden ser muy valiosos.\n\nAlgunos piratas usaban códigos basados en geodas para recordar dónde habían escondido sus tesoros.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Tengo algunas en mi taller, te puedo enseñar cómo abrirlos con la herramienta adecuada.\n\nPero... tengo un encargo importante que terminar con urgencia y agradecería algo de ayuda, como muestra de gratitud por la información que he dado.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Rehúsa.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Acepta.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Tengo que fabricar herramientas para los mineros. Es un pedido muy grande.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Estas son las geodas. Mira, te lo mostraré. Con este artilugio, se pueden abrir fácilmente. Casi nunca tienen nada de particular, pero a veces nos encontramos con absolutas maravillas.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "CRR... CRR… ¡CLING!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "¡Oh, señor, mira esta geoda! ¡Es algo magnífico!";
