"BUILDING_UPGRADE_TAXBONUS" = "Bonificación por impuestos";
"EVENT_WITCHHUNT_08_SUCCESS" = "Al fin tenemos un médico en la aldea. Seguro puede ayudarnos con la enfermedad.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Espera a que el médico regrese de la capital.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Los aldeanos serían mucho más felices si tuvieran un local comunitario para reunirse a tomar una copa de jugo de uva o una cerveza luego de un duro día de trabajo. ¿Sería mucho pedir, mi señor?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Aumentar la satisfacción de la comunidad.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Muy bien, gobernador. Si no vas a negociar conmigo, entonces mis hombres se llevarán lo que necesitamos.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Tuviste suerte esta vez, pero no será tan fácil la próxima.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ja, ja, ja. Que esto te sirva de lección. No dudarás en negociar conmigo la próxima vez.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Mi señor, necesito mucha piedra. Lo ayudaré con madera si puede conseguirme un poco de piedra.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Mi señor, recolecté algo de madera para las construcciones de la aldea. Se la cambio por trigo.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Mi hija se moría de frío anoche. ¿Me haría el favor de conseguirme un poco de lana? Puedo darle madera a cambio.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Mi señor, tengo una petición. Verá, mi hijo quiere aprender a trabajar con pieles, pero necesita algunas para practicar. Se las cambiaría por madera.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Mi señor, ¿tiene hierbas que le sobren? Quiero sazonar mi comida y no tengo ninguna.\nLe daré mi mejor madera a cambio.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Mi señor, quiero hacer reparaciones a mi casa. ¿Me cambiaría algunas herramientas por mi último montón de madera?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Mi señor, voy a preparar un festín. ¿Podría ayudarme? A cambio, le daré un poco de madera.";
"SCENARIO_CW_QUEST_B_NAME" = "Intercambiar con el granjero.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Mi señor, mi familia tiene mucha hambre. ¿Podría darnos un poco de pescado? Le daré a cambio un poco de madera para usar como leña.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Tengo un poco de madera para hacer reparaciones. Se la cambiaré por piedra, mi señor.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Mis hombres necesitan más pescado. Tráeme unos cuantos, te daré madera y no acabaré con tu aldeíta.";
"SCENARIO_CW_QUEST_C_20_DESC" = "¡Gobernador! Quiero hacerle un favor y sacar algunas rocas pesadas de su almacén. Si me permite hacerlo, le daré algo de madera.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Antes de desperdiciar el trigo con tus granjeros, deberías dármelo y te daré mi madera más fina.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Queremos ablandar la empuñadura de nuestras espadas con lana. No te preocupes, no actuaremos en tu contra si cooperas.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Mis hombres están aburridos. Si nos traes pieles, podemos mejorar los muñecos de entrenamiento para que parezcan más reales. Si no quieres hacer negocios conmigo, tendré que practicar con tus lugareños.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Uno de mis hombres enfermó. Supe que las hierbas pueden ayudarlo. Si no te molesta, las buscaré en tu almacén. Seguro las encuentro.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Nuestras herramientas ya no sirven. Usted tiene muchas, gobernador. Sea tan amable de darme algunas y tendré la amabilidad de no tomarlas por mi cuenta.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Mis hombres quieren un poco de carne. Tráela y tendré la cortesía de darte madera a cambio. \n\nO si no, los chicos visitarán tu pequeña aldea y la tomarán por su cuenta…";
"SCENARIO_CW_QUEST_C_NAME" = "Intercambiar con el bandido.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, un nuevo gobernador…\nYa que es nuevo aquí, le explicaré las reglas. Usted me da lo que le pido y yo le permito hacer lo que tenga que hacer.\n\n Parece un buen trato, ¿no? Bien, comencemos con una tarea fácil. ¡Tráigame pescado!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "¿Te falta madera? ¡No hay problema!\nYo rob… emm… almacené una pila. Te daré un poco de madera a cambio de algunas piedras.";
"SCENARIO_THIEF_FAIL" = "Entonces no quieres hacer negocios conmigo, ¿eh?\n\nMuy bien, verás cómo te va.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Mi señor, mire qué tenemos aquí… Parece un diente. De origen no humano. ¡Y aquí! Más trufas. No tengo el conocimiento para ofrecer una teoría, pero sé quién nos puede ayudar. ¡Veamos al viejo!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "¿Quién si no el comerciante podría culpar tanto a los residentes? ¡Es un cómplice!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "¡El comerciante!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "¡Probablemente sea la joven! Es la hermana de la lugareña desterrada. ¡Eso es un motivo!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "¡La joven muchacha!";
"THEBEAST_CHOICE_A_REASON_DESC" = "La joven desterrada injustamente por la reina provocó estos ataques. Buscaba venganza por su exilio forzado.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "¡V de vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "La búsqueda de bienestar del pueblo se tornó en una pesadilla… Probablemente no lo hizo con maldad, solo quería ayudar a su vecino.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "¡Héctor, el artista!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "¡Claramente es él! Odia a los nuevos y atacó a la hermana de la chica desterrada para asegurarse de que no le pueda hacer nada a su viñedo.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Basil, el granjero.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Al asustar a los lugareños, el infractor quería botarlos de la ciudad y evitar que nuevos aldeanos vinieran acá.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "¡Para disuadir a más nuevos de que migren al pueblo!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Sin duda ayudó económicamente al culpable.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "¡La reina Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "¡Fue el panadero! ¡Fingió ser atacado para no levantar sospechas! ¡Qué genialidad!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "El panadero.";
"THEBEAST_CHOICE_C_REASON_DESC" = "¡La reina Frygith, arrepentida de su decisión de abrir las fronteras, unió sus fuerzas con algunos residentes para asustar a los recién llegados y cerrar las fronteras de nuevo!";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Conspiración de Estado.";
