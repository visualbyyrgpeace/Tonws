"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_2" = "¡Desasigna un trabajador de un edificio!";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_3" = "Quita a un trabajador para detener la producción del aserradero.";
