"T_GAME_TUTORIAL_QUEST_NAME_4" = "Construisez une cabane de pêcheur.";
"T_GAME_TUTORIAL_QUEST_NAME_5" = "Collectez 40 écus d'impôts.";
"T_GAME_TUTORIAL_QUEST_NAME_6" = "Construisez une scierie, mais cette fois, avec la fonction Construction express.";
"T_GAME_TUTORIAL_QUEST_NAME_7" = "Construisez deux maisons de plus.";
"T_GAME_TUTORIAL_QUEST_NAME_8" = "Construisez un marché.";
