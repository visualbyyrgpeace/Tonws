"BUILDING_UPGRADE_TAXBONUS" = "Bonus d'imposition";
"EVENT_WITCHHUNT_08_SUCCESS" = "Enfin, nous avons un médecin au village. Il peut certainement nous aider avec la maladie.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Attendez que le médecin revienne de la capitale.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Les villageois seraient plus heureux s'il y avait un lieu commun pour se rencontrer et boire un verre de jus de raisin ou un breuvage, après une dure journée de travail. Serait-ce trop demander, mon seigneur ?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Augmenter la satisfaction de la communauté.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Très bien, gouverneur. Si vous refusez de faire affaires avec moi, mes hommes vont s'emparer de ce dont ils ont besoin.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Vous avez eu de la chance cette fois, mais ce ne sera pas si simple la prochaine fois.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ha ha ha. Que cela vous serve de leçon. Je suis certain que vous accepterez de faire affaires la prochaine fois.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Mon seigneur, il me faut beaucoup de pierres. Je vous donnerai du bois si vous m'aidez en me fournissant des pierres.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Mon seigneur, j'ai récupéré du bois pour la construction du village. Je vous l'échange contre du blé.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Ma fille grelottait de froid la nuit dernière. Pourriez-vous être assez aimable pour nous fournir un peu de laine ? Je vous donnerais du précieux bois en échange.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Mon seigneur, j'ai une question... mon fils souhaite apprendre la profession de tanneur. Il a besoin de peaux pour s'entraîner. Je peux donner du bois en échange.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Mon seigneur, auriez-vous quelques herbes ? Je n'ai rien pour épicer ma viande.\nJe vous donnerai mon meilleur bois en échange.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Mon seigneur, je veux réparer ma maison. Pourriez-vous m'échanger des outils contre ma dernière pile de bois ?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Mon seigneur, je souhaite organiser un festin. Pourriez-vous m'aider ? En retour, je vous donnerai un peu de bois.";
"SCENARIO_CW_QUEST_B_NAME" = "Commercez avec le fermier.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Mon seigneur, ma famille commence à avoir faim. Seriez-vous assez bon pour nous livrer du poisson ? Je pourrais même vous donner un peu de bois de mon stock en échange.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "J'ai une petite réserve de bois pour mes réparations. Je vous en échange contre des pierres, seigneur.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Mes hommes ont besoin de plus de poissons. Apportez-en et je vous donnerai du bois ! J'épargnerai aussi votre petit village.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Salut, gouverneur ! Je veux vous rendre service en vous débarrassant de lourdes pierres qui encombrent votre entrepôt. En échange, je vous donnerai plus de bois.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Avant de gâcher votre blé en le donnant aux fermiers, offrez-le-moi et je vous donnerai mon meilleur bois.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Nous voulons décorer le manche de nos épée avec de la douce laine. Ne vous inquiétez pas, si vous coopérez, nous ne les utiliserons pas contre vous.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Mes hommes s'ennuient. Si vous nous offrez des peaux, nous pourrons améliorer nos mannequins d'entraînement pour les rendre plus réalistes. Et si vous refusez de faire affaires avec moi, nous nous entraînerons sur vos habitants.";
"SCENARIO_CW_QUEST_C_60_DESC" = "L'un de mes hommes est malade. J'ai entendu dire que des herbes pouvaient l'aider. Si cela ne vous dérange pas, je les chercherai dans votre entrepôt. Je suis sûr qu'il y en a.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Nos outils ne sont plus utilisables. Vous en avez beaucoup, gouverneur. Soyez gentil, donnez-les-moi, cela m'évitera d'aller les chercher moi-même.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Mes hommes veulent manger de la viande. Donnez-en et nous serons ravis de vous offrir du bois en échange. \n\nSinon, mes hommes risquent de venir se servir tous seuls en ville...";
"SCENARIO_CW_QUEST_C_NAME" = "Commercez avec le bandit.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, un nouveau gouverneur...\nComme vous venez d'arriver, je vais vous expliquer les règles. Vous me donnez ce que je demande et je vous laisse faire ce que vous avez à faire.\n\nC'est un marché équitable, pas vrai ? Bon, commençons par une tâche simple : apportez-moi du poisson !";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Des problèmes de bois ? Pas de soucis !\nJ'ai dérob... euh... stocké un gros paquet de bois. J'échangerai cela avec plaisir contre quelques pierres.";
"SCENARIO_THIEF_FAIL" = "Alors, vous refusez vraiment de négocier avec moi ?\n\nBon, vous verrez bien ce qui va se passer.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Sire, regardez ce que nous avons ici.... On dirait une dent. Une origine non humaine. Et ici ! Encore de la truffe. Je n'ai pas les connaissances nécessaires pour présenter une théorie, mais je connais quelqu'un qui peut nous aider. Allons voir le vieillard !";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "Qui d'autre que le marchand pourrait blâmer les villageois à ce point ? C'est le complice !";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "Le marchand !";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "C'est probablement la jeune femme, c'est la soeur de la demoiselle bannie de la ville. C'est une raison !";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "La jeune femme.";
"THEBEAST_CHOICE_A_REASON_DESC" = "Cette jeune femme bannie à tort par la Reine est à l'origine de ces attaques. Elle voulait se venger de son exil forcé.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "V pour Vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "La quête du bien-être du village a tourné au cauchemar...Il ne voyait surement pas le mal, il voulait seulement aider son prochain.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "Hector l'artiste !";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "C'est certain que c'est lui. Il déteste les nouveaux habitants et il a attaqué la soeur de la fille bannie afin d'être sûr qu'elle ne puisse plus rien contre ses cultures.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Basil le fermier.";
"THEBEAST_CHOICE_B_REASON_DESC" = "En effrayant les habitants, l'agresseur voulait les expulser de la ville et empêcher de nouveaux villageois de s'y installer.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "Pour dissuader plus de nouveaux arrivants d'immigrer au village !";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Il est certain qu'elle a aidé le coupable financièrement.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "La reine Frygith !";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "C'est le boulanger ! Il a fait semblant d'avoir été attaqué pour éviter les soupçons ! Quel génie !";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "Le boulanger.";
"THEBEAST_CHOICE_C_REASON_DESC" = "La reine Frygith, regrettant la décision d'ouvrir les frontières, s'est jointe à certains résidents pour effrayer les nouveaux arrivants et refermer les frontières !";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Complot de l'État.";
