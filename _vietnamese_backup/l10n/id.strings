"T_GAME_QUEST_SCEN16_11_START" = "Kita harus beternak hewan untuk menghidupi penduduk kota.\nKarena itu kita perlu peternakan babi dan rumah jagal.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Babi makan gandum. Coba dapatkan dari pedagang, supaya kita bisa menyiapkan kiriman untuk sang Raja lagi.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Buatlah peternakan babi dan rumah jagal.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Kau tentu paham bahwa cadanganku sangat diminati.\nMulai sekarang aku hanya mau menukar gandum dengan bijih besi.";
