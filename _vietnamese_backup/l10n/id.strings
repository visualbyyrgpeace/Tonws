"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_001_A" = "Kau berani mengusir tukang roti itu?! Bagaimana kita akan membuat roti kita sekarang?! Kau seharusnya memikirkannya lebih matang. Aku yakin ini ada konsekuensinya!";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_01" = "Kecelakaan biasa terjadi, kita akan memberi kompensasi kepada warga desa yang terkena dampak kebakaran ini.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_02" = "Terima kasih atas perhatiannya, Tuan. Dengan uang ini, kami bisa membeli kebutuhan hidup sementara perbaikan dilakukan.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_03" = "Moral townie meningkat sebagai akibat dari tindakanmu. Kau telah mengambil pilihan tepat.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_003_01" = "Aku kecewa melihatmu tidak peduli kepada rakyatmu, Gubernur.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_003_02" = "Moral townie menurun sebagai akibat dari tindakanmu. Produktivitas mereka akan berkurang.";
"T_GAME_QUEST_BAKERY_ON_FIRE_DESC" = "Tuan! Kabar buruk. Tukang roti meletakkan terlalu banyak kayu di dekat oven dan toko roti itu terbakar! Api menyebar ke bangunan-bangunan di dekatnya dan warga sangat marah dengan tukang roti ini.\n\nApa yang harus kita lakukan? ";
"T_GAME_QUEST_BAKERY_ON_FIRE_EXPLAIN_MONEY_001" = "Berikan bantuan uang kepada warga desa untuk bisa pulih dari kejadian ini.";
"T_GAME_QUEST_BAKERY_ON_FIRE_TITLE" = "Kebakaran Toko Roti";
"T_GAME_QUEST_BANDIT_ATTACK_WARNING" = "Gerombolan bandit terlihat di daerah kita, Tuanku!";
"T_GAME_QUEST_BANDIT_ATTACK_WARNING_KLOSTER" = "Gerombolan bandit menyerang biara!";
"T_GAME_QUEST_BOARDGAME_001_END_001" = "Selamat, Tuan. Kita bisa melanjutkan ke langkah berikutnya! Aku memasang pengumuman dan tiga perancang permainan sekarang siap bekerja. Masing-masing ahli dalam sebuah jenis permainan.";
"T_GAME_QUEST_BOARDGAME_001_STARTED_001" = "Aku mengerti, Tuan. Kau ingin menggunakan sumber daya ini untuk membuat dadu dan peralatan lainnya. Itu ide bagus! Mari kita mulai dengan mengumpulkan sumber daya yang kita butuhkan.";
"T_GAME_QUEST_BOARDGAME_002_END_002" = "Dengan tim yang bagus ini, kita dapat memulai persiapan tempat dengan tenang!";
"T_GAME_QUEST_BOARDGAME_002_GD_001" = "Tuan, aku senang menjadi bagian dari timmu. Aku seorang spesialis dalam permainan strategi.";
"T_GAME_QUEST_BOARDGAME_002_GD_002" = "Kalau aku, aku ahli dalam permainan puzzle. Aku bisa membuatkanmu ruangan yang penuh teka-teki, pesertanya harus bisa keluar dalam waktu tertentu.";
"T_GAME_QUEST_BOARDGAME_002_GD_003" = "Sedangkan aku adalah seorang veteran permainan kartu. Permainanku dijamin bisa dimainkan oleh segala usia!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_001" = "Tuan, penduduk memberontak! Perang saudara benar-benar terjadi di wilayah kita!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_002" = "Butuh waktu hingga penduduk bisa tenang. Jika situasi ini terjadi lagi, berhati-hatilah dengan keputusan yang kaubuat, Tuan. Semoga kita bisa menghindari perang saudara lagi...";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_003" = "Tuan, pemberontakan masih berlangsung! Mengerikan sekali hasil dari keputusan yang kau ambil!";
"T_GAME_QUEST_BOARDGAME_FIRE_001" = "Serdadumu telah menderita hukuman paling memalukan dalam hidup mereka. Beberapa bahkan tak mampu lagi menatap diri mereka sendiri di cermin. Salah satu dari mereka, sang pemimpin regu, memutuskan untuk membalas dendam pada warga. Salah satu mata-matamu segera melaporkannya kepadamu.\n\nApa yang ingin kaulakukan?";
"T_GAME_QUEST_BOARDGAME_FIRE_002" = "Cegah balas dendam.";
"T_GAME_QUEST_BOARDGAME_FIRE_004" = "Tuan, sebelum kita mengurus para serdadu ini, kita harus memadamkan apinya!";
"T_GAME_QUEST_BOARDGAME_FIRE_005" = "Karena kota ini sudah selamat dari kebakaran, mari kita urus para serdadu ini.";
"T_GAME_QUEST_BOARDGAME_REVOLT_001" = "Townie tidak mendukung keputusan yang kaubuat dan memutuskan untuk mengambil tindakan sendiri.\n\nMereka memaksa penjaga untuk memakai sepatu jelek dan topi hukuman. Mereka sekarang harus berkeliling kota dengan pakaian ini.\nBeberapa orang melemparkan tomat ke arah mereka.\n\nHaruskah kita melakukan sesuatu?";
"T_GAME_QUEST_BOARDGAME_REVOLT_002" = "Jangan lakukan apa pun.";
"T_GAME_QUEST_BOARDGAME_REVOLT_003" = "Panggil bantuan.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_001" = "Setelah berunding sejenak dengan penasihatmu, kau dihadapkan pada dua solusi. Mengasingkan serdadumu ke kapal untuk menghukum mereka karena tidak hanya lalai dalam tugasnya, tetapi juga karena memicu kebakaran. Atau, menghukum mereka dengan kerja bakti...";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_002" = "Ke kapal.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_003" = "Kerja bakti.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_004" = "Dengan berat hati, kau memutuskan untuk mengasingkan serdadumu ke kapal. Bagaimanapun, mereka harus dijadikan contoh, jika tidak, desas-desus akan menyebar bahwa kau tidak memiliki ketegasan.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_005" = "Serdadumu telah kembali. Dipaksa menginap di laut membuat pikiran mereka jernih kembali.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_006" = "Lagi pula, mengapa tidak membuat kondisinya menjadi bermanfaat dan menyenangkan? Berkat para serdadu, tenaga kerja akan lebih produktif untuk sementara.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_007" = "Semua hal baik ada akhirnya. Para serdadu membayar utang mereka kepada townie, membantu mereka dalam tugas sehari-hari.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_A" = "Kau mengambil pilihan tepat untuk turun tangan, Tuanku. Mereka tidak pantas dilempari tomat.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_B" = "Mari kita selesaikan ini dengan menyelenggarakan pertarungan demi keadilan. Penduduk akan memilih jagoan mereka dan begitu juga para serdadu. Para jagoan ini akan bertanding secara adil. Dengan begitu, keadilan akan ditegakkan.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_C" = "Mari kita bangun arena pertarungan. Jagoan merah akan bertarung untuk rakyat. Jagoan biru akan bertarung untuk para serdadu.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_002" = "PERTEMPURAN DIMULAI!";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_003" = "Kesatria merah memenangkan duel ini. Oleh karena itu, kemenangan adalah milik rakyat.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_004" = "Para serdadu dinyatakan bersalah dan dijatuhi hukuman kerja bakti. Jika mereka mulai bermain-main lagi, mereka akan diusir dari kota.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_005" = "Kesatria biru memenangkan duel. Oleh karena itu, kemenangan adalah milik para serdadu.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_006" = "Townie harus memberi kompensasi kepada serdadu karena melemparkan tomat ke mereka. Namun, serdadu tetap dijatuhi hukuman kerja bakti. Jika mereka mulai bermain-main lagi, mereka akan diusir dari kota.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_007" = "Tuan, raja mendengar tentang penggunaan arena pertarungan untuk memastikan keadilan ditegakkan. Dia ingin memberi tahu bahwa dia memberi persetujuan, jadi dia memberimu sejumlah prestige. Pada akhirnya semuanya berakhir baik.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_001" = "Kirim pemburu.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_002" = "Itu bukan urusanku.";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_A" = "Tapi Tuan... untuk berburu, kita harus memiliki setidaknya satu pemburu... Jangan buang waktu dan bangun pondok pemburu ini!";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_B" = "Misi selesai! Perburuan yang kita lakukan tadi cukup mengesankan. Wilayah kita terselamatkan.";
"T_GAME_QUEST_BOAR_REGULATION_TITLE" = "Regulasi babi hutan";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_001" = "Saudaramu itu MEMANG burung.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_002" = "Wah, wah, wah. Penjaga! Pergi dan tangkap dia.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Aku mengizinkanmu melakukannya.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Baiklah, sudah cukup, bawa orang ini ke dokter.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Apa maksudmu? Saudaraku memang seekor burung? Kau pasti bercanda.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Apa yang ingin gubernur katakan kepadamu adalah bahwa kau harus percaya kepadanya. Saudaramu tahu apa yang dia lakukan. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Jika kau mengatakan demikian.... Jika sesuatu terjadi kepadanya, aku akan memintamu bertanggung jawab!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Gubernur, kami memberinya sedikit obat penenang dan dia tertidur sekarang. Dia menggumamkan hal-hal aneh, tentang teknik yang bisa membuatnya terbang ke atas pegunungan, kau mengambil keputusan yang benar dengan membawanya kepadaku. Jika terlambat, dia mungkin akan memberitahu kita kalau bumi itu bulat!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Tuan! Kami bertemu seorang utusan dari istana dan dia memberitahu bahwa penemu kita benar-benar luar biasa dan sang Raja ingin dia tinggal lebih lama di ibu kota untuk terus mengerjakan penemuannya. Pengaruh budaya kota ini telah berkembang pesat! Raja memutuskan untuk mengirimi kita prestige.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Tuanku, aku datang kepadamu karena saudaraku sudah gila. Dia menganggap bahwa dia adalah burung dan bisa terbang! Aku takut dia akan melakukan sesuatu yang bodoh dan memutuskan untuk memanjat terlalu tinggi untuk membuktikan bahwa dia bisa terbang seperti burung.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Oh, Tuan! Terima kasih karena tidak memasukkanku ke penjara! Saudariku terlalu mengkhawatirkanku. Aku ingin membuatmu terkejut dengan penemuanku! Aku menciptakan mesin yang bisa terbang! SEPERTI BURUNG! Aku berniat mempresentasikannya di ibu kota pada pameran tahunan besar.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Saudara burung";
"T_GAME_QUEST_COVERAGE_DESC" = "Tuanku, kota tidak siap menghadapi serangan bandit!\nSebagian besar wilayahnya tidak diamankan dengan menara jaga. Tuanku perlu memilih lokasi menara jaga agar mencakup bangunan sebanyak mungkin.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Tuanku, kota ini tidak siap menghadapi serangan bandit! Ada bagian kota yang tidak terjangkau oleh bangunan pertahanan. ";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Tingkatkan jangkauan kota dengan bangunan pertahanan";
"T_GAME_QUEST_COVERAGE_TITLE" = "Amankan desa dengan menara jaga.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Gerombolan bandit menyerang desa, Gubernur!\nKita harus menghalau sebanyak mungkin penyerang untuk meminimalkan kerugian untuk ekonomi dan bangunan kita.";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Tuanku,\npenduduk kota takut diserang bandit! Kita harus memperlihatkan kepada para Townie dan terutama kepada para bandit bahwa kita bisa mempertahankan diri!";
"T_GAME_QUEST_DESIRES_01_START" = "Daerah pedalaman ini tertinggal jauh dibandingkan kota besar.\n\nBanyak sekali yang harus diubah agar kota ini menjadi metropolis yang hidup!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Setelah gerombolan bandit berhasil ditumpas dan desa berkembang, tempat ini menjadi sangat indah.\nSungguh ide yang baik untuk pindah ke sini, Sayang.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Pastikanlah istrimu merasa betah.";
"T_GAME_QUEST_DESIRES_02_START" = "Desa ini juga perlu toko penjahit, supaya aku bisa punya baju baru yang dibuat khusus untukku.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Terima kasih, Sayang!\nBajuku yang lama sudah usang sekali.";
"T_GAME_QUEST_DESIRES_03_START" = "Aku merindukan keramaian kota.\nCobalah datangkan lebih banyak orang agar kota menjadi hidup!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Tingkatkan jumlah penduduk.";
"T_GAME_QUEST_DESIRES_04_START" = "Oh, desa yang indah!\n\nKau pasti takkan keberatan kalau aku memilih menetap di sini.";
"T_GAME_QUEST_DESIRES_05_START" = "Bandit di hutan!?\nBentuklah pasukan penjaga kota untuk menghalau para penjahat itu!";
"T_GAME_QUEST_DESIRES_06_START" = "Oh, ada menara penjaga…\n\nAsal tahu saja, perilaku seperti ini justru membuat marah anak buahku!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Gerombolan bandit membuat kacau kota.\n\nSegeralah perkuat pasukan penjaga kota!";
"T_GAME_QUEST_DESIRES_07_START" = "Pastikan pasukan penjaga kota mencegah para bandit masuk ke kota!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Bagus sekali! Aku merasa jauh lebih aman sekarang.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Halau semua serangan bandit.";
"T_GAME_QUEST_DESIRES_08_START" = "Untuk memastikan para penjaga bertugas dengan baik, sajikan bir dan sosis kepada mereka.";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Hasilkan bir dan sosis.";
"T_GAME_QUEST_DESIRES_09_START" = "Para penjaga perlu senjata dan baju zirah agar mampu menghalau gerombolan bandit!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Sekarang para penjaga akan mampu mengusir semua bandit!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Hasilkan senjata dan baju zirah.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Seharusnya kukatakan bahwa anak buahku pasti akan mengambil bagian mereka!";
"T_GAME_QUEST_DESIRES_10_START" = "Cara kau memenuhi setiap permintaan istrimu membuatku curiga kau ada masalah dengan koin yang terlalu banyak.\n\nBiarlah aku membebaskanmu dari beban berat ini!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Adalah bijaksana kalau semua dikirim kepadaku sekarang, Tuan Pembantu Raja!";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Sumbangkan koin.";
"T_GAME_QUEST_DESIRES_11_START" = "Kau takkan menyerah terhadap pemerasan, bukan?\nMenghabiskan koin untuk membeli baju baru adalah investasi yang jauh lebih baik!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Belilah kain dari pedagang.";
"T_GAME_QUEST_DESIRES_12_START" = "Desa ini membosankan, tidak ada hiburan!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "Desa ini membosankan. Tidak ada arena pertarungan!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "Ini lebih baik! Sekarang sudah mulai lumayan di sini.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Bangunlah arena pertarungan.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Ternyata kau belum belajar juga. Anak buahku akan berkunjung untuk membuat inventaris.";
"T_GAME_QUEST_DESIRES_13_START" = "Sepertinya kau masih menderita kelebihan. Serahkan emasmu kepadaku!\nDan jangan coba-coba memberikannya kepada istrimu!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Sepertinya kau sudah belajar. Mungkin anak buahku tidak perlu lagi mengambil bagian mereka secara paksa.";
"T_GAME_QUEST_DESIRES_15_START" = "Emas itu sebaiknya diproses jadi perhiasan untukku, Sayang!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Terima kasih banyak, Sayang!";
"T_GAME_QUEST_DESIRES_16_START" = "Aku ingin mengadakan pesta kecil.\nUntuk itu aku perlu jus dan roti.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Bagus sekali. Mudah-mudahan tidak ada insiden dengan para bandit.";
"T_GAME_QUEST_DESIRES_17_START" = "Oh, pesta yang meriah! Kau lupa mengundang kami? ";
"T_GAME_QUEST_DESIRES_18_START" = "Cukup sudah. Singkirkan pada bandit itu untuk selama-lamanya!\nHancurkan kamp mereka.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "Akhirnya kita berhasil mengusir para penjahat itu!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Hancurkan semua kamp bandit.";
"T_GAME_QUEST_DESIRES_19_START" = "Pasar pun tidak ada di desa ini!? \nBangunlah pasar, Sayang, supaya aku bisa berdagang barang-barang dari kota.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Kalau begini sudah sedikit lebih mudah untuk tinggal di sini.";
"T_GAME_QUEST_DESIRES_20_START" = "Tidak ada yang dijual selain ikan?\nTolong buatkan toko roti dan mulai produksi roti.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Terima kasih banyak! Aku sudah mulai muak kalau melihat ikan.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Tuanku, para pengintai melaporkan gerombolan bandit berkumpul di perbatasan kota. Aku khawatir akan ada serangan besar-besaran.\nKita perlu menyiapkan pertahanan!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "Gerombolan bandit mulai menyerang!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "Serangan bandit berikut melanda kota, Tuanku!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Tuan Gubernur, para bandit melancarkan serangan berikut!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Satu lagi serangan bandit akan menghantam kota, Tuanku!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Gerombolan bandit menyerang lagi, Tuanku. Sepertinya ini gelombang terakhir. Kita harus bertahan!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Tuanku, penjaga kota melaporkan serangan sudah berakhir. Sisa bandit sudah diusir dari kota dan lari.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "Populasi hewan mulai meningkat. Akhirnya kita bisa berburu lagi!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Ladang-ladang mulai pulih, Tuanku. Serangan penyakit tanaman rupanya sudah berlalu.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Ladang perlahan pulih, Tuanku. Bencana kekeringan sepertinya sudah berakhir.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "Kota dilanda kebakaran, Tuan Pembantu Raja!\n\nKita harus segera memadamkan api sebelum menyebar ke seluruh kota.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Bagus sekali, Tuanku.\n\nSeluruh kebakaran berhasil dipadamkan dan kota kembali aman.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Semua kebakaran di kota sudah dipadamkan, Tuanku.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Pastikan tak ada bangunan yang terbakar.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Tuanku, wabah hitam mengancam seluruh negeri.\n\nKita harus merawat orang-orang yang sakit sebelum seluruh kota tertular penyakit sampar.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Kita berhasil, Tuanku!\n\nSerangan penyakit sampar bisa ditangkal. Kota berhasil diselamatkan.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Pengobatan modern.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Pengobatan nenek.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Dokter dengan sangat marah memutuskan untuk menghancurkan rumah sakit! Dia berkata, "Jika kau memilih pengobatan tradisional, kau tidak membutuhkan labku lagi!"";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Keputusan bijaksana, Tuan.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Berkat pilihanmu, perawatan yang diberikan oleh dokter jadi jauh lebih efektif!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Tuan, banyak warga desa yang tidak tahu lagi harus bagaimana saat mengalami masalah kesehatan. Apa sebaiknya kita mengarahkan mereka menuju pengobatan modern atau tradisional?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Dokter dan tradisi";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Lanjutkan saja tidurmu.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Aku mempercayaimu.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Oh, tidak! Tidak! Kita seharusnya mendengarkan pemimpi itu! Beberapa orang mulai menderita penyakit aneh.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Kita beruntung telah berhasil menghentikan penyakit ini. Sebaiknya kita mendengarkan firasat di masa depan...";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Townie ini telah menyelamatkan kita dari bencana lebih dari sekali. Mari kita bangun rumah sakit, Tuan, untuk jaga-jaga.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Oh Tuan! Kita baru saja selesai membangun rumah sakit dan beberapa townie kita sakit. Untung kau memutuskan untuk mendengarkan townie ini! Dampaknya menjadi terkendali! Bagus sekali, Tuan.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Kita masih harus menyembuhkan mereka, Tuan. Kalau tidak, penyakitnya bisa menyebar.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Bagus sekali! Seluruh desa kembali sehat. Kita bisa melanjutkan bisnis kita.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Tuanku, tadi malam aku bermimpi desa kita akan terinfeksi penyakit aneh. Semua penduduk menderita hidung tersumbat. \n\nApa menurutmu mimpiku mungkin adalah pertanda?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Waktu bermimpi";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Aku tak sabar melihatnya!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Oh, aku lebih suka dengan yang sebelumnya.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "Tidak, aku tak punya waktu untuk itu.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Kubilang tidak, ya tidak.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Izinkan dia masuk.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Kabulkan.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Tak ada gunanya menarik lebih banyak pengembara.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "Dalam curahan kemurahan hati yang tak tertandingi, kau mulai bekerja. Penginapan ini akan penuh dengan bunga!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Yah, baiklah.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = ""Dengarlah semuanya! Penginapan memiliki pemilik baru! Datanglah ke penginapan untuk acara pembukaan kembali!"\n\nPenyebar berita di kota sedang bahagia hari ini. Konon, setiap kali ada tamu baru datang ke penginapan, dia menerima tip.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Tuan, kita mendapat kunjungan dari pemilik penginapan yang baru. Apakah kau ingin menyambutnya?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Tuan, tolong. Penginapan menjadi salah satu tempat favorit para pengembara. Kita dapat meningkatkan reputasi kota dengan meningkatkan fasilitas ini.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Selamat pagi, Tuanku. Terima kasih telah menyambutku di istanamu.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "Apa maksud dari kedatanganmu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Nah, jadi begini, penginapan sedang dalam keadaan yang buruk. Pemilik sebelumnya benar-benar ceroboh. Tidak hanya terhadap pemasok, tetapi juga terhadap pelanggan!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Um, baiklah, kalau itu keputusanmu. Kita memang tidak benar-benar menghabiskan banyak waktu di penginapan.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Jadi, aku di sini untuk meminta bantuanmu. Aku ingin memulai dengan menambahkan bunga di sekitar tempat usahaku untuk memberikan tampilan yang lebih menawan. Aku ingin menarik perhatian lebih banyak pengembara agar mereka datang lagi.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Sekarang, mari kita lanjutkan ke langkah kedua! Minuman.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! Langkah kedua... Nah, karena kita sudah sampai di sini, sebaiknya kita teruskan saja. Jadi, apa langkah selanjutnya dalam programmu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Kita membutuhkan logam dan kayu kualitas terbaik.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Bukankah sebelumnya kau membicarakan tentang minuman? Kenapa sekarang kayu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Untuk membuat tong yang bagus, tentunya! Pemilik sebelumnya bahkan tidak memiliki tong yang layak untuk menyimpan minuman. Pemasok pasti menggunakan kayu yang buruk. Jadi, kita harus mengumpulkan cukup banyak kayu dan batang besi untuk membuatnya sendiri.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Bagus! Cantik sekali!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Jika kau memandangnya seperti itu. Aku akan mengurusnya sendiri!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "Mulai sekarang, penyebar berita kota akan mengutamakan penginapan dalam pengumumannya.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "Mulai sekarang, penyebar berita kota akan mengutamakan kedai minum dalam pengumumannya.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Terima kasih, Gubernur! Yang penting semuanya berakhir dengan baik.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Oh, terima kasih, Tuanku! Penginapan menjadi jauh lebih nyaman dengan bunga-bunga.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Ayolah, Tuan, luangkan waktu untuk memikirkannya. Penginapan merupakan sumber pemasukan penting bagi desa. Ini dapat membantumu menyelesaikan beberapa proyekmu.\n\nApa kau yakin ingin menghentikan upayamu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Apa yang kaukatakan, Tuan?! Kau membantu wanita muda ini dengan penginapannya dan bagaimana denganku? Kau tidak membantuku dengan kedai minumku!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Ayolah, jaga perilakumu saat bicara dengan gubernur.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Aku menuntut hak yang sama dengan wanita ini!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Apa kau juga ingin bunga untuk tempat usahamu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Bunga-bunga? Tidak! Aku ingin penyebar berita kota yang juga mendukung tempat usahaku!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Tuan, apa yang harus kita lakukan?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Promosikan kedai minum.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Promosikan penginapan.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Bunga dan Musuh";
"T_GAME_QUEST_FEAST_TITLE" = "Siapkan festival untuk kota.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Lindungi desa dengan menara penjaga kebakaran.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Tuanku, kota ini tidak siap menghadapi kebakaran besar! Sebagian desa tidak terlindung oleh menara penjaga kebakaran. Tempatkan menara agar bisa menjangkau sebanyak mungkin bangunan.";
"T_GAME_QUEST_FOOD_STARTED" = "Jangan lupa hidangannya, Tuan! Festival tidak akan lengkap tanpa sajian lengkap. Ayo segera kita dapatkan bahan-bahannya. Makin cepat kita memilikinya, makin cepat proyekmu bisa berhasil.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Peserta Festival kita tak akan mati kelaparan! Tuan, kita hampir mencapai target! Aku tidak sabar!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Seorang gubernur yang tak bisa menyajikan minuman kepada seorang ratu!? Aku diberitahu untuk curiga terhadapmu, tetapi aku tidak mendengarkannya!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Ratu Frygith, ayolah, jangan marah tentang hal kecil seperti itu. Ini hanya tentang minuman. Jangan dibesar-besarkan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Kulihat bahkan penasihatmu mulai tidak menghormati aku...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "Situasi benar-benar di luar kendali, kau tidak tahu lagi apa yang harus dilakukan dan tingkat stresmu meningkat. \n\nBagaimana reaksimu?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Coba tenangkan Ratu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Jadi begini, gubernur menyimpan perasaan kepadamu dan dia tidak tahu harus bersikap bagaimana. Sebenarnya, ini adalah pertama kalinya dia jatuh cinta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "Ratu juga merasa emosional. Sepertinya dia juga menyimpan perasaan kepadamu. Mungkinkah ini awal dari kisah cinta sejati? Apakah peramal ini benar selama ini?\n\nHanya waktu yang tahu. Sementara itu, sang ratu memutuskan untuk berdansa lagi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Beberapa bulan berlalu sejak perayaan termasyhur itu. Kau dan Ratu Frygith saling berkirim surat. Terkadang, dia datang menemuimu saat cuaca memungkinkan.\n\nMungkin suatu hari, dia akan memilihmu sebagai Raja di kerajaannya. Namun, untuk saat ini, dia punya terlalu banyak hal yang harus diurus sebagai seorang ratu.\n\nBegitu juga kau! Kau harus terus mengeluarkan segala daya dan upaya untuk menjaga kotamu berjalan lancar.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Townie ikut senang untukmu dan Ratu. Mereka melihat peningkatan jumlah pengembara, tujuan kedatangan mereka terutama adalah untuk mencicipi jus anggur dan minuman yang ditolak ratu selama pesta. Rumor mengatakan, minuman itu kualitasnya bagus sekali sehingga stoknya habis dalam kurang dari satu jam.\n\nProduktivitas kedua bangunan ini meningkat!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Kartu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Aku akan menarik kartu seperti biasa untukmu, Tuanku. Ini akan memberi tahu kita sedikit banyak informasi tentangmu dan nasib apa yang menantimu. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Setelah penarikan pertama ini, dia melanjutkan mengocok kartu lainnya.\n\nDia memintamu untuk menarik tiga kartu. Masing-masing satu untuk masa lalu, masa sekarang, dan masa depan.\n\nSetelah semua kartu dipilih, dia membaliknya satu per satu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Tuan, tiga kartu ini memberitahuku bahwa kau akan mengalami masa yang sangat sulit. Kau harus mencurigai orang-orang di gereja. Kartu-kartu itu memberitahuku bahwa di masa lalu, mereka pernah berusaha mendekatimu, tetapi tidak berhasil.\n\nKau telah diperingatkan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Tarikan yang luar biasa, Tuanku! Semuanya positif. Kau akan bertemu seorang wanita, wanita hebat yang akan memikat hatimu. Cinta ada di depan mata! Bersiaplah ketika dia mengetuk pintumu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Kau melihat wanita muda ini mengocok kartu, dia membisikkan namamu ke kartu itu untuk mengirimkan energimu.\n\nKemudian, dia memintamu untuk memilih tumpukan kanan atau kiri.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Semoga prediksi ini tidak menjadi kenyataan dan orang-orang religius di kota kita bahagia.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Keesokan paginya, seorang biarawan mendekatimu. Dia memberitahumu bahwa gereja membutuhkan lebih banyak sumber daya dan penambahan tempat ibadah akan sangat dihargai.\n\nPrediksi sang peramal melintas di benakmu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Tuan, sebuah gereja baru dapat membantu penduduk untuk membangkitkan spiritualitas mereka. Terima kasih banyak.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Bangun tempat ibadah baru.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Sempurna! Kami akan memanfaatkan tempat ibadah baru ini dengan baik.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Tumpukan kiri.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Kartu ini menunjukkan bahwa kau memiliki bagian yang sangat gelap dalam dirimu dan itu akan membawamu pada penghancuran diri. Aku khawatir ini akan mempengaruhi produktivitas wargamu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Aku merasakan kebingunganmu, dan penasihatmu menganjurkanmu untuk pergi. Namun, tunggu sebentar, ini belum berakhir. Tarikan kedua dapat memberikan jawaban yang lebih spesifik.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Tuan, peramal ini mengatakan yang sebenarnya, kita ada jadwal kunjungan untuk akhir pekan mendatang. Itu memberi kita cukup waktu untuk menyiapkan pesta dan bersiap-siap!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Siapkan pesta";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Pesta yang bagus tidak lengkap tanpa makanan dan minuman. Mari kita mulai dengan itu, Tuanku.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Sempurna! Kita sekarang punya cukup makanan dan minuman untuk memuaskan tamu kita.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Tuan, kau harus melakukan segala yang bisa dilakukan untuk perayaan ini. Bayangkan seandainya kau bertemu jodohmu di sana?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Penasihatmu mungkin ada benarnya. Jadi, kau memutuskan untuk berdandan dengan pakaianmu yang paling indah. Seluruh kota bersinar, kau tidak ragu sedetik pun untuk memamerkan kekayaanmu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Ini akan tercatat dalam sejarah! Ini pasti akan membuat calon kekasihmu terkesan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Tumpukan kanan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Kau adalah orang yang peduli dan kartu memberitahuku bahwa ini akan memengaruhi produktivitas pendudukmu!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "Bola kristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Pilihan yang bagus sekali, Gubernur. Silakan mendekat dan lihat ke dalam bola kristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "Peramal itu mendekati bola kristal dengan tangannya dan tiba-tiba, asap biru muncul.\n\n"Tuan, kemalangan besar mungkin akan menimpamu. Aku melihat biarawan. Mungkin itu akan menjadi penyebab kemalanganmu," katanya dengan nada sedih.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "Peramal mendekati bola kristal dengan tangannya dan tiba-tiba, asap merah muda muncul.\n\n"Tuan, kau akan menemukan cinta! Cinta yang sejati! Kau akan mengalami kisah yang luar biasa, aku jamin!", dia memberitahumu dengan percaya diri.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Pergi dan menangis di ruanganmu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Karena panik, kau melarikan diri dari aula dan lari ke ruanganmu untuk meringkuk sambil menangis di tempat tidurmu.\n\nSemuanya menunjukkan bahwa kau menderita patah hati. Hanya waktu yang bisa memperbaiki ini.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Selama beberapa bulan ini, kau perlahan-lahan pulih dari patah hati yang kau derita.\n\nRatu Frygith tidak pernah mencoba mencaritahu kabarmu, dia sama sekali tidak peduli padamu.\n\nDi sisi lain, kau mencetak sejarah dan sekarang tercatat di buku-buku sebagai gubernur yang jatuh cinta. Ini telah memenangkan simpati orang-orang dan mereka sekarang bekerja lebih efisien.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Bawakan dia minuman.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "Ditemani penasihatmu, kau memutuskan untuk pergi ke rumah si peramal. Mungkin dia bisa membantumu mencegah sejumlah kemalangan atau mungkin memberimu kabar baik.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "Peramal itu berada tidak jauh dari istana. Kau memasuki tenda kecil. Kau dikelilingi banyak benda mistis. Entah mengapa, benda-benda itu menenangkanmu.\n\n"Tuan, silakan duduk. Aku senang sekali kau menerima undanganku. Metode mana yang kaupilih?"";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Bawakan dia jus anggur.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Kau dapat mengagumi parade dari atas istanamu. Dan tiba-tiba, di kejauhan, kau melihat sebuah prosesi kedatangan. Perhatianmu jatuh pada seorang wanita cantik. Jantungmu berdebar-debar. \n\nApakah itu yang dimaksud cinta pada pandangan pertama?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Tergila-gila karena cinta, kau memutuskan untuk pergi menemui orang asing yang cantik ini. Hampir melewatkan satu anak tangga saat menuruni istanamu, kau akhirnya menuruni tangga dengan merangkak. Penasihatmu, yang berdiri tegap di sampingmu tidak mengerti apa yang terjadi denganmu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Tuan, ini Ratu Frygith. Aku tidak tahu apa yang memotivasimu untuk menemuinya begitu cepat.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Gubernur, senang bertemu denganmu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "Ratu Frygith membuatmu terpesona dengan kehadirannya sampai kau tidak tahu lagi bagaimana harus bertindak. Untungnya bagimu, penasihat tepercayamu membantumu dan membuatmu sadar kembali.\n\nKau memutuskan untuk mengundang Ratu Frygith ke pesta dansa malam ini. Mudah-mudahan dia akan menerima kencan romantis pertama ini.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Ratu Frygith, Gubernur mengundangmu ke pesta malam ini untuk menjadi pasangan kencannya. Bersediakah kau memberi kami kehormatan untuk menerimanya?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "Itu sangat tidak pantas! Aku sudah bertunangan dengan Adipati Cannes, aku tak pantas terlihat di pelukan seorang gubernur.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Aku akan dengan senang hati menerima undangan ini.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "Waktu untuk perayaan akhirnya tiba. Kau sudah meminta musisi paling bergengsi untuk bermain untukmu di sepanjang malam ini. Kau ingin segalanya sempurna untuk kekasihmu.\n\nRatu Frygith akhirnya tiba dengan gaun yang elegan. Setiap detik yang kauhabiskan di hadapannya membuat cintamu menjadi semakin kuat.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "Musiknya mengalun indah, Ratu Frygith juga tampaknya terpesona. Sudah waktunya istirahat dan dia memintamu menyajikan minuman.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Tak ada yang bisa kautawarkan kepadanya.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Tolak undangan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Kau melakukan hal yang benar, Gubernur. Siapa tahu masalah macam apa yang akan kita hadapi!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Karena patah hati, kau memutuskan untuk tidak menghadiri pesta sama sekali. Kau berduka untuk waktu yang lama dan itu tercermin di kotamu. Produktivitas dan kebahagiaan warga makin menurun. Mari kita berharap itu tidak bertahan lama.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Kau mulai melihat cahaya di ujung jalan lagi dan kesedihanmu sekarang teratasi. Kau perlahan mulai keluar dari ruanganmu lagi.\n\nOrang-orang senang dengan pemulihanmu dan ini memengaruhi produktivitas serta moral mereka secara positif.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Terima kasih Gubernur, kau adalah pria yang sangat menawan. Apakah kau ingin memanfaatkan malam ini untuk menjalin kesepakatan dagang? Dengan begitu, kita akan mendapat kesempatan untuk bertemu lagi…";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Aku akan meninggalkanmu bersama Ratu, Gubernur.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Kau dan ratu berduaan di taman kerajaan, seperti di dalam dongeng. Waktu terhenti untukmu dan Ratu Frygith. Kau mengumpulkan semua keberanianmu dan berbagi perasaanmu. Ternyata sang ratu membalas perasaanmu!\n\nSayangnya, matahari sudah terbit dan ratu harus kembali. Ada banyak hal yang harus diurus di negaranya. Dan kau tahu bahwa tidak mudah untuk menjalankan sebuah negara sendirian.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Townie juga ikut senang untukmu. Mereka jadi lebih jarang melakukan pemogokan, yang merupakan hal bagus.\n\nAkhirnya, kau melakukan hal yang benar dengan berkonsultasi dengan peramal ini.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Aku akan hadir dengan senang hati!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Tuanku, ini mengerikan. Orang-orang yang dipaksa pergi ke gereja benar-benar mengalami penurunan semangat. Mereka sudah tak tahan lagi. Mari kita berdoa agar mereka bisa bersabar! Merupakan keputusan buruk untuk mewajibkan kebaktian itu!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Masalah gereja dan peramal itu sudah tinggal masa lalu. Kebahagiaan warga mulai pulih kembali.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Keputusan ini bermanfaat bagi kita, Tuan! Kau melakukan hal yang benar dengan mewajibkan kebaktian itu. Townie sekarang lebih bahagia dan lebih produktif.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "Pemimpin agama di desamu kembali untuk menemuimu.\n\n"Tuan, izinkan aku juga meminta sesuatu kepadamu. Bisakah kau mewajibkan kebaktian? Jadi, dengan keberadaan para peramal ini, aku khawatir warga kita akan menjadi mudah terpengaruh. Aku ingin menyelamatkan mereka sebelum terlambat."";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Terima permintaannya.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Aku berjanji, Tuanku! Kau tidak akan menyesal!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Tolak permintaannya.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Aku mengerti, Tuanku. Peramal itu yang telah mengubah pikiranmu. Seharusnya kau menjauhinya!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Karena agama tidak begitu penting bagimu, kami akan menghancurkan tempat-tempat ibadah! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Tuan, ini buruk sekali! Biarawan yang marah menghancurkan bangunan di kota! Dan kita tidak mungkin menangkap mereka, mereka melarikan diri! Ini akan mengajarimu untuk berkonsultasi dengan peramal dan lihat ke mana mereka mengarahkan kita.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Sebagai penasihatmu, aku tak akan pernah membiarkanmu menemui peramal lagi! Sekarang, mari kita kembali ke urusan kita, Tuanku. Suasana hati penduduk sedang buruk sekali.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Tuan, beberapa pengembara tiba di kota sore ini. Di antara mereka, terdapat seorang peramal. Dia mengirimimu undangan agar dia bisa meramalmu.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "Sang Peramal";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Bagaimana kalau kau berhenti memakannya? ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Lakukan investigasi.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Hancurkan pondok nelayan.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "Parah sekali! Penduduk terus makan ikan karena kekurangan makanan yang lebih baik dan penyakit pun menyebar!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "Penyakitnya terkendali, Tuan. Kita beruntung bisa selamat.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Kendali kualitas ini menghabiskan banyak biaya, tetapi selalu lebih baik daripada harus berurusan dengan epidemi!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Semua pondok nelayan sudah diperiksa dan ikannya bisa dimakan lagi! Kau mengambil keputusan yang tepat. Kita menghindari masalah serius.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "Penghancuran pondok nelayan membuat kita bisa menghilangkan potensi kontaminasi ikan. Namun, patut disayangkan bangunan bagus seperti itu harus dihancurkan.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Gubernur, aku tidak ingin cerewet, tetapi harus kuakui bahwa ikanmu... Tak seperti dulu lagi. Aku tak tahu apa itu karena sungai atau karena hal lain, tetapi mereka benar-benar menjijikkan! Akan ada orang yang sakit jika kau tidak mengatasi masalah ini.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Ikan segar!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Raih tingkat kepuasan dengan komunitas yang tinggi.";
"T_GAME_QUEST_GETREWARD" = "Dapatkan hadiah!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Tuan, aku tak tahu bagaimana cara mengatakannya... Ambil napas dalam-dalam. Siap? Baiklah... Beberapa warga desa mengatakan mereka melihat kelinci raksasa.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Ya, memangnya aneh?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "KELINCI RAKSASA?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "Lalu?! Tapi, Tuan! Ini benar-benar menakutkan! Bayangkan jika dia melompat-lompat di sekitar istana dan merobohkan rumah-rumah kita!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Padahal rumah kita hanya sedikit…";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Ayo bertindak dan CEPAT!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Ah, ini reaksi yang lebih logis darimu, Tuan.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Mari kita bangun pondok pemburu.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Kirim surat ke istana, minta mereka mengirim utusan.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Terlepas dari upaya kita untuk berburu kelinci, kita tak bisa menangkap kelinci raksasa itu. Namun, kita sekarang memiliki banyak persediaan...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Ada petunjuk?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Aku sudah melakukan tugasku dan sekarang aku akan tidur siang.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "Utusan telah tiba, Tuan.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Aku meminta bantuan Pasukan Kerajaan.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Temani utusan ini untuk melihat bukti.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Apa yang kudengar barusan? Seekor kelinci raksasa berkeliaran di sekitar wilayahmu? Apa kau terlalu lama terjemur sinar matahari?...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Aku mengerti. Jejak kelinci raksasa... Ini adalah kisah yang diceritakan kepada anak-anak yang nakal. "Kelinci raksasa akan datang saat kalian tidur dan menggigit telingamu." ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "Lalu apa lagi? Aku ada urusan lagi.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Temui penyihir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Kita bisa pergi ke penyihir dan meminta masukannya. Mungkin dia tahu sesuatu tentang kelinci raksasa yang terkenal itu.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Aku sudah menantimu. Burung gagak meramalkan kedatanganmu. Betapa berisiknya mereka. Namun, tidak lebih berisik daripada lompatan kelinci itu.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Berdoa.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Gunakan sihir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Jangan lakukan apa pun.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Jadi, itu benar?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Pastinya! Sudah cukup banyak waktu yang terlewatkan hingga akhirnya kau sampai di sini. Untung masih ada waktu. Kau sekarang memiliki beberapa opsi untuk dipertimbangkan.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Sepertinya kau tak peduli dengan wargamu dalam kondisi apa pun, Tuan... Ini akan menjadi bumerang pada akhirnya.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Baiklah, mari kita bangun dua pondok pemburu dan memanen dagingnya. Siapa tahu, dengan sedikit keberuntungan, kita akan menemukan sarang kelinci raksasa.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Ini adalah keahlianku. Aku akan membuatkanmu ramuan, tetapi kau harus membawakan sejumlah bahan. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Bagaimana? Apakah kau akan memberiku bahan-bahan ini?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Terima kasih banyak, Tuan. Astaga! Aku malah lupa setengah bahan lainnya.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Oh, kita tak punya waktu seharian, Tuan. Ada ramuan yang harus kubuat. Bagaimana kalau kau beri aku bahan-bahannya sekarang?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Terima kasih banyak, Tuan. Ambil ramuannya. Tempatkan di sumur desa dan tunggu sebentar. Kelinci raksasa akan pergi dengan sendirinya setelah mencium baunya.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Tuan... Kita harus membangun pemandian umum dan menambahkan banyak minyak esensial untuk menghilangkan bau townie... Benar-benar menjijikkan.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Bagus! Kota akhirnya bisa bernapas lega lagi!\nKelinci itu pergi tanpa jejak, seolah-olah kita hanya membayangkannya saja. Untuk saat ini, Tuanku, mari kita kembali ke kegiatan kita sehari-hari.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Akhirnya, kelinci itu pergi sendiri. Dalam lompatan-lompatan terakhirnya, dia menggali peti yang disembunyikan oleh bandit sejak lama. Peti itu berisi 2000 koin emas dan raja menganggap kita layak menerima prestige!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Yah... Harus sampai ada kelinci raksasa bagimu untuk akhirnya mempertimbangkan membangun gereja!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Mari kita bergegas membangun gereja ini dan kumpulkan warga sekitar untuk berdoa.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Yang tersisa hanyalah menunggu bantuan yang di atas.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Kelinci itu pergi tanpa jejak, seolah-olah kita hanya membayangkannya saja. Untuk saat ini, Tuanku, mari kita kembali ke kegiatan kita sehari-hari.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Aduh. Seharusnya kau memilih ramuannya, tetapi kaulah bosnya! Semoga beruntung, Tuan, menghadapi kemalangan yang akan datang.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Kelinci raksasa";
"T_GAME_QUEST_INN_STARTED" = "Tuan, akomodasi tambahan akan diperlukan. Bagaimana kalau kita membangun penginapan? Dengan begini, kita dapat menyediakan kebutuhan para pengunjung festival.";
"T_GAME_QUEST_INN_SUCCESS" = "Nah, setidaknya itu sudah selesai. Sekarang, ayo kita pikirkan tentang persiapannya lainnya.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Ini terlalu berisiko.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Mengapa tidak.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Pelawak.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "Istana raja senang! Itulah yang dibutuhkan! Prestige menjadi milik kita! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "Townette jago teka-teki.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Sayangnya, teka-teki itu... terlalu rumit bagi mereka. Istana raja lebih menyukai sesuatu yang ringan. Kita tak mendapatkan prestige kali ini.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "Townie jago akrobat.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "Istana raja kagum dengan jago akrobat berbakat ini! Raja akan mengirimkan prestige kepada kita sebagai hadiah.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Kau benar, siapa tahu apa yang akan terjadi pada kita jika raja tidak puas dengan kandidat kita.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Tuan, kami menerima pesan dari ibu kota. Raja kecewa karena tidak ada penduduk kota kita yang datang untuk menawarkan jasanya. Untungnya, dia tidak akan mencela kita karena hal sepele seperti itu. Raja sangat penyayang!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Aku menemukan tiga kandidat potensial. Yang mana yang harus kita kirim?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Tuanku, raja ingin memiliki seorang badut untuk menghiburnya. Haruskah kita mengirim beberapa calon potensial yang bisa menjadi badut kerajaan yang baru?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Badut Kerajaan";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Perbaiki atap.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Kita harus memperbaikinya secepat mungkin!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Tidak sekarang.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Kita memiliki prioritas lain saat ini. Festival lavender akan segera dimulai, namun persiapannya belum selesai.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "Omong-omong, kita harus menyelesaikan semua persiapannya.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Itu lebih baik! Ini akan menjadi event yang menguntungkan!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Tuan, aku mendengar bahwa para pedagang lavender sangat menyukai katedral kita. Mereka enggan pergi ke festival kita!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "Festival lavender berlangsung tanpa hambatan… namun, pengunjung kita tidak sebanyak dulu! Event ini tidak memberi kita prestige apa pun.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Kita sepakat!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Kalau begitu, ayo cepat produksi barang yang diperlukan untuk sang ratu.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Sekarang kita tinggal melakukan pertukarannya.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Senang berbisnis denganmu.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Tuan! Kabar buruk! Simbol budaya kita yang mendunia terbakar di malam hari! Katedral besar tak lagi memiliki atap!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Para ahli mengatakan bahwa kita tak lagi punya cukup kayu mulia di wilayah kita untuk memperbaikinya. Namun, Ratu Frygith kebetulan memiliki sumber daya yang diperlukan, apa sebaiknya kita meminta bantuannya?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Minta bantuan.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Kau segera mengirim utusan ke ratu. \n\n"Bantu aku Ratu Frygith! Bolehkah aku meminjam kayu mulia ini dari wilayahmu? Katedralku sebentar lagi runtuh."";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Halo, waktunya pas sekali karena aku perlu menambah persediaan jus, apakah kau tertarik dengan sebuah pertukaran yang saling menguntungkan ini? Persediaan jus ditukar dengan kayu yang kauperlukan.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Tuan, ini bukan penawaran yang menguntungkan kita…";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Kau menimbang keuntungan dan kerugian dari kesepakatan ini. Mungkin ratu akan menjadi solusi bagi segala kekhawatiranmu... Kecuali, ada cara lain?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Pikirkan tentang itu.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Permintaan ini dapat merusak reputasi kita. Kita akan menggunakan cara lain. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Penasihatmu mungkin ada benarnya. Meminta bantuan Ratu Frygith akan mendorongmu untuk bergantung pada niat baiknya. Jika ada masalah, kau akan berisiko kehilangan banyak.\n\nMengapa tidak menggunakan batu saja? Kau punya banyak batu di tambang.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Itu keputusan bagus, Tuanku! Kita bebas dan mandiri.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "Festival lavender sukses. Kisah baru-baru ini tentang restorasi katedral telah menimbulkan banyak antusiasme dan kita pun diuntungkan darinya!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Aku tidak pernah suka lavender.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Yah, tidak apa-apa! Kita sedang memperbaikinya.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Tidak bisa diterima.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Tuan, itu terdengar seperti pemerasan! Mari kita gunakan batu sebagai gantinya, jadi kita tidak perlu berurusan dengan ratu ini!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Baiklah, aku tidak akan melupakannya.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Raja Kayu";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Aku akan mengurusnya.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Kalau mereka tidak suka, mereka tidak usah datang lagi ke sini.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "Memang benar bahwa pedagang akan diuntungkan dari tempat yang dikhususkan untuk mereka selain pasar. Serikat Dagang sepertinya akan menjadi bangunan yang cocok, Tuan.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Luar biasa, Tuan! Terima kasih telah menyetujui ini. Kami berhutang budi selamanya!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Seorang gubernur modern sepertimu seharusnya memenuhi permintaan para pedagang…";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Tuan, aku datang sebagai perwakilan para pedagang. Untuk menunjukkan kekecewaan kami, kami tidak akan datang ke kotamu untuk sementara waktu! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Tuan, federasi pedagang memintamu membangun bangunan yang sesuai dengan fungsinya.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Kurangnya ruang";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Saat kau baru saja bangun, penasihatmu memiliki berita buruk untukmu! Kota sedang diserbu oleh tikus-tikus kecil! Ini tidak seberbahaya tikus besar, tentu saja, tetapi tetap saja. Kita harus melakukan sesuatu!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Tuan, Akademi Kucing Berburu Tikus telah didirikan, tetapi... kita tetap harus menjaga kesehatan mereka dan memberi mereka makan. Kita harus menyediakan ikan yang cukup untuk akademi.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Kita sekarang memiliki cukup ikan untuk menunjang pelatihan. Beberapa rekrutan sudah berhasil menangkap banyak tikus, Tuan.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Tuan, kita harus menghadiahi kucing terbaik dengan catnip untuk mengurangi stres mereka.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "Ada peningkatan yang nyata dalam keefektifan penangkap tikus, Tuan. Para guru melakukan pekerjaan mereka dengan baik dalam melatih kucing-kucing itu. Tikus yang tersisa tinggal sedikit.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Tikus tak lagi mengganggu, Tuan. Selamat atas pilihanmu yang berujung pada hasil ini.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Siapkan rencana.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Kau masih memutuskan untuk sarapan. Sambil memakan roti panggangmu, kau melihat seekor tikus di sudut ruangan! Mereka bahkan ada di dalam istana! Dan tiba-tiba, kau melihat Chouquette, kucing setiamu, melompat. Dia memakan tikus itu dengan cepat. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Itu memberimu ide. Kau menginstruksikan penasihatmu untuk menangkap kucing sebanyak mungkin dan melatih mereka berburu tikus, termasuk kucing rumah. Kau ingin mereka dilatih untuk menyingkirkan semua tikus ini.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Tidur lagi.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Ketika bangun, ada begitu banyak tikus di mana-mana sehingga sulit bagi semua orang untuk berjalan. Semua wargamu melambat!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Tikus-tikus itu akhirnya pergi sendiri setelah sekian lama. Bersembunyi dari tanggung jawabmu dengan tidur tidak selalu menjadi solusi.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Kucing dan Tikus";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "Di sisi kanan terlihat pengaruh yang aktif saat ini.\nBeberapa pengaruh hanya aktif sementara dan bisa berubah selama berlangsungnya skenario.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Tuanku,\nDengan segala hormat, tampaknya Tuanku tidak sadar warga desa tidak bahagia. Ini tidak boleh berlanjut.\nSelain itu, barang yang kita produksi tidak diproses secara benar.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Sekarang sudah terungkap pengaruh apa saja yang ada di kota. Mungkin kamu juga sudah melihat bahwa ada bandit di daerah sekitar dan kebahagiaan umum berkurang karena kehadiran mereka.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Buka menu pause untuk melihat semua pengaruh saat ini di peta.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Tolong datangi penggergajian. \nProduksi harus dihentikan! Kita kekurangan kayu dan sudah kelebihan papan!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Info lebih banyak tentang suatu bangunan bisa diperoleh dengan mendatanginya!\n\nMenu kontekstual menunjukkan info berguna tentang bangunan itu, para pekerjanya, dan rantai produksi terkait. Sementara menu ini dibuka, permainan dalam keadaan pause.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Penggergajian butuh lebih banyak penebang pohon agar produksi papan lebih efektif. Kegiatan penggergajian perlu dihentikan dulu sampai kita membangun lebih banyak pondok rimbawan dan mengumpulkan lebih banyak sumber daya bangunan.\n";
"T_GAME_QUEST_MIL_TUT_04_START" = "Sumber daya jangan sampai memenuhi gudang, Tuanku. \nKalau perlu tempat di gudang, gunakanlah fitur hancurkan sumber daya di menu statistik.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Buka menu gudang.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Sumber daya jangan sampai memenuhi gudang, Tuanku. \nKalau perlu tempat di gudang, gunakanlah fitur hancurkan sumber daya di tab gudang pada menu di dalam game.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Hancurkan papan kayu sampai persediaan menjadi kurang dari 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Hancurkan beberapa papan untuk mendapatkan ruang di gudang.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Kau meremehkan ancamanku, Gubernur. \n\nMulai sekarang kita akan main kasar!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Kotamu kelihatan cukup bagus. Masalahnya, ini daerah kekuasaanku!\nBawakan permata dan pakaian untukku! Dan jangan lama-lama, atau kotamu bakal tinggal nama...";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Melontarkan ancaman ternyata ampuh. Aku tidak menyangka kau akan mengirim semua barang itu kepadaku.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Bayar upeti kepada para bandit.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Anak buahku lagi jenuh. Aku akan menyuruh mereka jalan-jalan…\n\n...KE TEMPATMU!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Seperti yang kau lihat, aku akan mengambil apa saja yang kusuka!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Selamat pagi, Tuanku.\n\nAku datang atas perintah Raja. Ia menyuruhku mengajarimu seni perang.\n\nMasalah bandit di sini pasti segera teratasi, Tuanku.";
"T_GAME_QUEST_MIL_TUT_10_START" = "\nBarak adalah pusat untuk operasi militer di daerah sekitar dan memungkinkan pembangunan dan suplai menara jaga. Serdadu bertempur dengan baik hanya jika suplai lancar.\nMenara jaga perlu ditempatkan sehingga mencakup sebanyak mungkin wilayah kota.\n\nBangunlah barak dan menara jaga, Tuanku.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Rupanya kau mendapat bantuan dari seorang ksatria…\nWah, aku jadi ketakutan.\n\nCoba kita lihat bagaimana militermu melawan anak buahku…\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Para bandit membakar bangunan-bangunan kita. Mana petugas pemadam kebakarannya?!\n\nKalau ingin tahu di mana seorang townie sedang berada, pilihlah opsi “temukan townie” di menu kontekstual bangunan.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Di sini bisa dilihat apa sedang dilakukan oleh para pekerja.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Hasilkan bir dan sosis";
"T_GAME_QUEST_MIL_TUT_14_START" = "Serdadu kita butuh bir untuk menambah keberanian, Tuanku.\n\nUntuk bisa memproduksi bir, Tuanku harus memerintahkan pembangunan tempat pembuatan bir di biara dan tempat pengeringan hop.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Serdadu kita butuh bir, Tuanku.\nUntuk mendapatkan bir, perintahkanlah pembangunan biara dan pembuatan ladang hop, Tuanku.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "Tempat pembuatan bir di biara butuh beberapa sumber daya dari bangunan lain.\nTempat pengeringan hop harus memasok hop kering. Pertanian dan sumur harus memasok gandum dan air.\n\nBaru setelah itu para rahib bisa mulai membuat bir, Tuanku.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "Di biara, para rahib bisa diperintahkan untuk memanen hop di ladang atau menangani proses pembuatan bir.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Bangunlah biara dan tempat pengeringan hop.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Bangun biara dan buat ladang hop";
"T_GAME_QUEST_MIL_TUT_15_START" = "Untuk produksi sosis, kita butuh peternakan babi dan rumah jagal, Tuanku.\n\nSerdadu kita suka sosis dengan citarasa kuat. Rempah-rempah yang diperlukan untuk sosis bisa dipanen oleh petani di kebun herba.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Rumah jagal bisa memproduksi daging biasa dan juga sosis kesukaan para serdadu.\nIni bisa menjadi pilihan supaya tidak tergantung hasil perburuan di hutan.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Buatlah peternakan babi dan rumah jagal.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Sebaiknya kau meningkatkan pertahananmu!\nSampai lain kali...dan terima kasih untuk semua sumber daya ini.\n";
"T_GAME_QUEST_MIL_TUT_16_START" = "Bir dan sosis!\n\nAnak buahku suka itu. Kurasa ada baiknya kau berbagi produk-produk lezat itu denganku.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Kali ini kau beruntung, Gubernur. Lain kali anak buahku akan datang dalam jumlah lebih besar.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Pertahankan kotamu";
"T_GAME_QUEST_MIL_TUT_17_START" = "Keadaan kota perlu ditingkatkan lagi. Sebagian besar desa tidak terlindungi dengan baik. Kita harus mencakup lebih banyak wilayah desa dengan menara jaga.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Sebagian besar desa di bawah perlindungan serdadu kita sekarang. Para bandit takkan bisa mencuri seenaknya, Tuanku.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Amankan paling tidak 50% wilayah desa dengan menara jaga";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Kalau perlu info lebih lanjut tentang militer, cobalah buka tab militer di layar statistik.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Serdadu kita perlu senjata dan baju tempur!\nSenjata meningkatkan daya serang sedangkan baju tempur menambah kemampuan bertahan serdadu kita.\n\nKarena itu, kita perlu membangun gudang senjata di kota. Untuk membuat baju tempur, kita juga perlu tempat penyamakan untuk mendapat kulit.\nKulit hewan akan disuplai oleh pemburu atau tukang jagal.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Bangunlah tempat penyamakan kulit dan gudang senjata.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Tuanku,\nSudah waktunya memperbesar pasukan. Setelah itu, kirimlah gugus tugas untuk menghancurkan kamp bandit.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Perbesarlah pasukanmu";
"T_GAME_QUEST_MIL_TUT_21_START" = "Waktunya telah tiba, Gubernur!\n\nKita akan menyerang pemimpin para bandit. Kamp mereka tersembunyi di hutan.\nKau tinggal memilih kamp bandit dan mengerahkan serdadu dalam jumlah memadai untuk menyerang.\n\n\nSelamat berburu!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Hancurkan kamp bandit";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Untung kita bertemu, Tuanku.\nAku habis dirampok bandit untuk ketiga kalinya dalam minggu ini. Kita harus bertindak melawan para penjahat itu!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Kemenangan besar, Tuanku.\nPara bandit sudah kita beri pelajaran! Daerah ini aman lagi dan Raja pasti sangat senang. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Selesaikan latihan dasar dan kalahkan gerombolan bandit.";
"T_GAME_QUEST_NEW" = "Misi baru!";
"T_GAME_QUEST_NEW2" = "Misi baru:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Tak ada yang punya waktu untuk mengurusnya.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Kau benar.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Baiklah, Tuan. Kalau begitu, kita tidak akan melakukan apa pun terhadap roti yang mengerikan ini. Aku sudah bisa mendengar keluhan tentang makanan yang menjijikkan ini. Namun, bagaimanapun juga..., aku akan menjalankan sesuai perintahmu, Tuanku.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Tuan, rotinya sekarang enak! Harga jual juga naik.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = "“Kualitas gandum harus kauperhatikan, kau harus memecahkan masalah tersebut sampai ke akarnya. Beri tahu tukang giling untuk menggunakan air yang lebih bersih. Semoga raginya berkualitas baik.”\n\nPenasihatmu menyampaikan pesanmu itu kepada pembuat roti dan menjanjikan bahwa roti tersebut akan memiliki kualitas yang lebih baik.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Tuan, kita harus melakukan sesuatu. Roti tidak seperti dulu. Banyak orang datang untuk mengeluhkan kualitasnya. Kita harus mengubah resepnya.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Resep baru";
"T_GAME_QUEST_NOQUEST" = "Tidak ada misi tersedia.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Bergegas produksi perisai dan senjata. Jika orang-orang ini berbahaya, lebih aman untuk bersiap.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Gubernur, kami sudah selesai mempersiapkan pertahanan kota.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Serdadumu melaporkan pergerakan pasukan di utara. Di situlah gurun terbesar di kerajaan itu berada.\n\nNamun, kau tahu bahwa tak ada yang cukup gila untuk mencoba menyerang dari sisi perbatasanmu ini. Kau memutuskan untuk mengabaikan ancaman ini. Apa pun yang terjadi, terjadilah!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Beberapa hari kemudian, serdadumu melaporkan sekelompok orang datang langsung dari gurun utara. Mereka akan tiba di kota dalam beberapa jam.\n\nMereka bisa saja hanya pengembara, tetapi siapa tahu, mungkin mereka adalah bandit berbahaya yang datang untuk menyerang desamu!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Siapkan pertahanan.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Siapkan sambutan hangat.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Gurun Utara";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Sebuah kelompok berjumlah sekitar sepuluh orang mendekati kotamu. Serdadumu tetap berjaga-jaga menunggu perintahmu.\n\nKau membiarkan mereka mendekat. Pemimpin kelompok ini berjalan sendirian menuju gerbang kota. "Selamat pagi, Tuanku yang baik, kami baru saja melintasi gurun utara. Maukah kau menawarkan tempat bermalam untuk satu malam saja?"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Datanglah ke kota kami yang indah, kau akan menginap di penginapan, kami memiliki cukup ruang di sana.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Saat penasihatmu mengantarmu pulang, kau masih tetap waspada. Mengapa mereka mengambil risiko menyeberangi gurun, padahal mereka bisa berlayar menyusuri sungai? Mengapa memilih jalan yang berbahaya jika tidak untuk bersembunyi?\n\nMungkin mata-matamu dapat mengetahui lebih lanjut tentang mereka. Atau, kau bisa langsung tidur.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Langsung tidur.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Kirim mata-mata.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Mata-matamu terjaga sepanjang malam dan berhasil menguping beberapa percakapan dari penginapan: para pengembara sedang dalam pelarian. Mereka dituduh melakukan suatu kejahatan di negara mereka di seberang gurun. Pasukan telah dikirim untuk mengejar mereka dan mereka sudah mempersiapkan rute untuk melanjutkan pelarian mereka dari keadilan.\n\nApa solusi terbaik yang akan kau ambil?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Penjarakan para pengembara.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Kami baru saja menerima pesan dari Raja. Penjahat berbahaya telah melarikan diri dari penjara negara tetangga. Ada sekitar sepuluh orang dan mereka mencuri benda berharga. Apa menurutmu itu adalah pengembara yang ada di sini beberapa hari lalu?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Kirim pesan ke Raja.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Rahasiakan.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Aku akan mengirim pesan kepada raja untuk memberitahu bahwa mereka telah melewati desa kita. Mungkin mereka akan bisa menemukan mereka.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Tuan! Pasukan Kerajaan berhasil menangkap orang-orang berbahaya ini. Mereka berhasil mengambil kembali harta yang dicuri.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Terima kasih atas bantuanmu, Gubernur. Orang-orang ini telah mencuri salah satu permata berhargaku. Mereka berencana menjualnya di pasar gelap. Kau melakukan hal yang benar dengan memberitahuku tentang keberadaan mereka di sekitar kotamu.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Baiklah, Tuanku. Jika ada yang bertanya kepada kami tentang hal itu, kami akan bilang bahwa kami tidak tahu.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Sudah lama sejak terakhir kali terjadi sesuatu yang spektakuler di kota. Namun hari ini, kau merasa akan ada sesuatu yang terjadi.\n\nDan kau benar! Penasihatmu datang sambil membawa surat dari para pengembara yang diburu Pasukan Kerajaan. Pesan itu berbunyi sebagai berikut: \n\n"Terima kasih karena tidak melaporkan kami, Gubernur. Sebenarnya, kami adalah korban fitnah dan seluruh keluarga kami dalam bahaya besar. Dengan merahasiakan bahwa kami datang ke desamu, kami punya waktu untuk mencari bukti bahwa kami tidak bersalah. Tanpamu, itu tidak mungkin terjadi. Oleh karena itu, terimalah penghargaan ini sebagai tanda terima kasih kami. Kau adalah Gubernur yang baik."";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Aku telah membebaskan para pengembara, Tuan, seperti yang kauperintahkan kepada kami. Kuharap itu tak akan menjadi bumerang bagi kita.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Para pengembara berterima kasih atas kebaikanmu dan berjanji bahwa setelah terbukti tak bersalah, mereka akan memberimu hadiah sebagai tanda terima kasih mereka.\n\nKau sangat berharap telah mengambil keputusan yang tepat dan para pengembara ini tidak membodohimu dengan berbohong.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Sudah beberapa bulan sejak terakhir kali kau mendengar kabar dari para pengembara ini. Terkadang, kau memikirkannya lagi. Kau tidak ada masalah dengan raja, tetapi kau juga tidak mendapatkan hadiah yang dijanjikan.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Namun tiba-tiba, di suatu pagi yang cerah, penasihatmu datang membawa paket berisi surat. Surat itu berisi pesan dari para pengembara misterius. Mereka mengungkapkan rasa terima kasih mereka. Dalam paket tersebut, kau dapat melihat hadiah yang dijanjikan. Prestige dan emas.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Kau senang telah mengambil keputusan yang benar dan tidak ditipu.\n\nPenasihatmu melaporkan bahwa kau telah menjadi pahlawan bagi para pengembara ini dan mereka memujimu. Enaknya jadi Gubernur.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Tuan, para pengembara meninggalkan penginapan di pagi hari. Mereka tampaknya terburu-buru.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Para pengembara menunggu jawabanmu. Beberapa terlihat agresif, beberapa terlihat takut.\n\n"Aku tak bisa menawarkan tempat bermalam, Pengembara. Kami tak memiliki cukup kamar untuk kalian malam ini."\n\n"BOHONG!", salah satu pengembara tiba-tiba berteriak sambil menerjangmu dengan pedangnya.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Lindungi gubernur!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Cepat, Tuan! Ayo! Cepat sembunyi!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Kau berhasil berlindung di tempat persembunyian bersama penasihatmu yang tampaknya sangat panik: "Tuan, apa yang akan kita lakukan?! Para pengembara jahat ini menghancurkan desa kita dan tak ada yang bisa kita lakukan! Kita seharusnya mempersiapkan pertahanan kita, bukannya roti gulung!"\n\nSayangnya, satu-satunya hal yang dapat kaulakukan hanyalah menunggu.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Di pagi harinya, kau berani keluar dari tempat persembunyianmu. Desa tidak rusak. Tampaknya para pengembara ini hanya melumpuhkan penjaga dan mengambil beberapa perbekalan untuk sisa perjalanan mereka.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Untungnya, kita sudah menyiapkan penanggulangannya, Tuan. Dengan senjata dan perisai yang kita produksi, kita akan dapat mengusir mereka. Aku yakin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Tuan, kami telah berhasil menangkap semua pengembara dan memasukkan mereka ke penjara. Ini saatnya bagimu untuk mengambil keputusan.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Pengembara-pengembara ini makin aneh saja. Mereka sekarang sudah dipenjara, jadi kau merasa sedikit lebih aman. Namun, ada sesuatu yang membuatmu khawatir.\n\nApa yang akan kaulakukan?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Interogasi mereka.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Beritahu raja.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Baiklah, Tuanku. Aku akan mengajukan beberapa pertanyaan kepada mereka untuk memperjelas cerita ini.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Penasihatmu kembali dan memberimu informasi tentang para pengembara itu. \n\nMereka kabur dari negara mereka karena tuduhan yang salah. Bukti bahwa mereka tidak bersalah ada di selatan, di salah satu kota di sekitarnya.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Bebaskan mereka.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Kalau begitu, aku akan memberitahu raja agar pasukan kerajaan datang dan menangkap penjahat berbahaya ini!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Pasukan kerajaan akhirnya datang. Kau menyerahkan para pengembara. Raja mengirimimu hadiah karena memberikan informasi yang diperlukan untuk menangkap orang-orang berbahaya ini.\n\nDesamu perlahan pulih, sedangkan kau dengan damai melanjutkan aktivitasmu sebagai gubernur.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Mata-matamu melakukan kesalahan dan ketahuan oleh para pengembara. Mereka menyanderanya dan menuntut uang tebusan jika kau ingin dia kembali hidup-hidup.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Kita akan kehilangan banyak uang, tetapi setidaknya mata-mata kita akan selamat.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Terima kasih, Tuan, karena telah membayar uang tebusan untuk membebaskanku! Aku takut akan kehilangan nyawaku. Menjadi mata-mata memang pekerjaan yang berbahaya.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Itu ide bagus. Kita harus menyiapkan makanan untuk orang-orang ini ketika mereka tiba di depan pintu kita. Roti dan ikan akan jadi suguhan yang pas.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Sempurna. Sekarang, kita tinggal menunggu mereka.";
"T_GAME_QUEST_PLACE_STARTED" = "Sekarang saatnya membangun lokasi yang tepat untuk event sebesar ini!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Wah, itu benar-benar luar biasa! Dan pastinya semua ini tak akan berhasil tanpa penjaga yang penuh semangat. Kau punya ide bagus saat memanfaatkan kesempatan ini! Festival ini pasti sukses.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Tanam lebih banyak bunga.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Itu tidak perlu.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Cantik sekali! Oh, bunga memang benar-benar menakjubkan, aromanya membuatku terbang ke awang-awang.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Kau orang yang tak berselera. Kota kita semestinya akan jauh lebih cantik dengan bunga!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Musim semi telah kembali, Tuanku. Desa bisa mendapatkan keuntungan dari bunga yang banyak.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Kelopak Cantik";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "Penggergajian telah terbakar, Tuanku. Apakah kau akan memerintahkan pembangunan kembali? Kita membutuhkan bangunan itu untuk memproduksi papan!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Bangun kembali penggergajian.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Jangan berikan apa pun kepada siapa pun.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Bagikan sejumlah pemasukan ke townie.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Investasikan uang ini di tambang.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Tuan, kita memiliki banyak uang di tempat penyimpanan kita dan redistribusi sebagian dari pemasukan ini akan bermanfaat bagi kota.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Warga desa mendengar tentang keputusanmu. Mereka tidak senang. Coba tunjukkan sedikit kepedulian kepada rakyatmu, Tuan.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "Produktivitas townie tak lagi terpengaruh oleh keputusan yang kauambil terkait redistribusi pemasukan. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Kau membuat townie menjadi sangat bahagia! Mereka senang sekali!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Inisiatif yang bagus sekali, Tuan. Mari kita mulai membangun tambang dan menggali sumber daya.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Menginvestasikan uang yang kita miliki untuk pembangunan tambang baru mungkin merupakan keputusan terbaik yang kita ambil. Kita akan dapat berkembang lebih mudah dengan sumber daya ini.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Kau sangat murah hati, Tuanku. Uang ini akan memungkinkan mereka untuk meningkatkan taraf hidup mereka sehari-hari.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Redistribusi Pemasukan";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Kita beruntung, Tuan. Tanaman tidak terpengaruh. Babi hutan telah pergi dan kita tak perlu mengkhawatirkan mereka lagi.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Babi hutan telah menghancurkan tanaman kita, Tuan! Mereka sekarang menuju ke peternakan. Ini parah sekali.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "Penduduk kecewa akibat kerugian ini dan kebahagiaan serta produktivitas mereka terpengaruh.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Tuan, tanaman kita mulai pulih dari kerusakan yang diakibatkan oleh babi hutan beberapa waktu lalu. Kehidupan mulai kembali normal dan orang-orang mulai melupakan peristiwa itu.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Penduduk merasa diabaikan sebagai akibat dari keputusanmu! Semoga tanaman kita tak akan dirusak oleh para babi hutan ini.";
"T_GAME_QUEST_REWARD" = "Hadiah:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Selamat datang, Steward!\n\nCoba lihat garis pantai ini! Aku kira kotamu akan pantas mendapat pemandangan indah ini!\nJaga para Townie baik-baik dan jangan lupa selalu memberi upeti kepada Raja, supaya kau bisa terus mengabdi kepadaku!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Pinjaman dari Raja";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Gubernur, \nkalau kau kekurangan uang, pihak kerajaan bisa memberikan pinjaman sekadarnya untuk membantumu.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Selamat datang di desa kami yang bersahaja, Gubernur!\nDaerah ini terbelah oleh bukit berbatu. Di sebelah barat daya bukit terdapat cadangan bijih, Tuanku.\n\nAku senang kita bisa bekerja sama.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Selamat datang, Gubernur!\n\nAku Ratu Frigyth, penguasa kerajaan ini. Aku minta bantuanmu untuk membawa kejayaan ke desa ini. Tanahnya kaya sumber daya, jadi seharusnya ini tugas yang mudah untukmu. Jangan kecewakan aku.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Tuanku, lihatlah betapa luas daerah ini. Tanah datar ke segala arah! Kita pasti bisa membangun kota besar dalam waktu tidak terlalu lama, bukan begitu?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Salam, Gubernur.\nDi tepi sungai besar ini ada banyak kesempatan untuk bertambah makmur. Ada banyak tempat untuk mencari ikan dan semua tambang penuh bijih. Di sinilah kita akan mendirikan kota atas nama sang Raja.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Bagus, Gubernur.\nLembah ini merupakan salah satu jalur terpenting untuk melintasi pegunungan. Letak kota kita ideal untuk menjadi persinggahan pedagang keliling. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Tuanku, di kaki air terjun ini ada banyak tempat untuk mencari ikan. Selain itu, cadangan bijih yang besar membuat daerah ini ideal untuk mendirikan kota.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Selamat datang di Benteng Es, Tuanku.\nPara Townie tidak mudah naik sampai ke kastel, tapi pemandangan dataran ini sepadan dengan usaha mereka. Tanahmu seakan tidak terbatas kalau dilihat dari atas sini.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Selamat pagi, Tuanku.\n\nLihatlah perbukitan di wilayah kekuasaanmu. Pemandangannya mengagumkan, bukan? Ini tempat yang baik untuk mendirikan kota, Tuanku.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Selamat pagi, Tuanku.\n\nSelamat datang di kota kecil kami. Kabarnya legok ini tercipta karena bingang jatuh. Semoga ini membawa keberuntungan bagi kita. Paduka Raja sudah berpesan bahwa segera akan ada beberapa tugas untuk kita.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Upeti untuk raja.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festival untuk para Townie.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Sumbangan untuk kaum miskin.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Festival bir di kota.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Jual babi di pasar.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Berdaganglah di pasar hewan.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Jual-lah hewan di pasar.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Ransum untuk pasukan.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Perlengkapan untuk para serdadu sang Raja.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Halau serangan bandit.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Hancurkan kamp bandit.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Selamat datang, pembantu raja! Coba lihatlah pesisir pantai ini! Saya yakin kotamu layak atas pemandangan indah ini!\nRawatlah para Townie dan jangan lupa untuk mengirim upeti rajamu, sehingga kau bisa terus mengabdi padaku!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Sungguh tempat yang baik untuk mencari ikan. Tidakkah kau setuju, Tuan? Tentu kita tidak akan kehabisan makanan di sini!\nKami ingin kau sesekali mengadakan festival - jika kau bisa membiayainya setelah mengirim upetimu kepada sang raja!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Oh sayang, terima kasih telah tinggal di sini! Danau ini sangat indah!\nTownie akan tentu akan senang di sini, jika kau merawat mereka dengan baik!\nOh, dan jangan lupa membayar raja sehingga kita bisa tinggal di sini selamanya!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Yang mulia, sungguh sebuah keputusan yang bijak untuk pindah ke lembah sungai ini!\nTownie tentu akan senang jika kau membantu kaum miskin dan yang membutuhkan!\nNamun, atas kederwananmu, saya sarankan untuk tidak melupakan kewajibanmu kepada sang raja!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Terima kasih! Anak buahku sangat bangga bisa melayani membangun kekuasaanmu di sini pada waktu yang bersejarah bagi tanah kami saat ini!\nTahun ini akan menjadi tahun perayaan!\nJayalah sang raja dan sama halnya bagimu!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Gubernur, saya telah mendengar banyak hal tentangmu! Karena itulah aku memilihmu untuk membangun kotamu di lereng ini menjadi semegah istanaku!\nAlangkah baiknya segera kau mulai! Sampai jumpa!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Paduka, kita diberi tugas mendirikan kota di dekat dasar sungai kering ini. Raja akan memberi banyak hadiah jika kita bekerja dengan baik.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Yang Mulia, dataran tinggi tempat istana Paduka juga tempat sempurna untuk kota kecil yang menyenangkan. Raja juga telah mengirimkan kepada Anda sejumlah tugas yang harus dipenuhi.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Di lepas pantai ditemukan gugusan pulau. Kuperintahkan kalian mendiami pulau-pulau itu atas namaku.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Tuanku, lihatlah wilayah hutan nan cantik ini. Membangun kota di sini akan sangat berat, namun setidaknya di sini ada rusa dan kayu yang melimpah. Hal ini seharusnya mempermudah kita dalam memenuhi tugas yang diberikan raja.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Abdiku yang setia, memenuhi kewajiban upeti ke raja akan sulit karena musim dingin yang parah. Mari segera mulai bekerja…";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Lembah hijau yang indah. Ada cukup sumber daya untuk membayar upeti raja. Tapi awas, terbatasnya lahan untuk bangunan menuntut perencanaan matang.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Ini pulau yang benar-benar indah! Saya sangat senang kita datang ke sini. Kita harus segera memulai perencanaan desa kita!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Dari sini kita bisa mengawasi seluruh daerah sekitar. Sayangnya, musim dingin jauh lebih lama di ketinggian ini, sehingga mempersulit cocok tanam.\n\nAda baiknya menimbun persediaan selama musim panas.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Salam! Kami telah menunggu Anda! Orang-orangku telah menjelajahi wilayah tersebut dan menemukan banyak urat bijih yang menjanjikan. \n\nAnda lebih baik segera memulai penambangan sebelum seseorang bertindak lebih cepat!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Syukurlah Tuanku sudah datang.\n\nGubernur sebelumnya melarikan diri. Sambil kabur, dia berseru bawah ini daerah terkutuk.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Pendahulu Tuanku tidak sepenuhnya salah. Daerah ini tidak cocok untuk pertanian, nyaris tidak ada yang tumbuh di sini. Air pun langka. Tapi aku yakin Tuanku bisa menemukan jalan keluar.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Townie-mu merasa kurang puas dengan kehidupan religi mereka, Tuanku. Mungkinkah untuk membangun gereja di kota?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Capailah kebahagiaan religi yang tinggi.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Anda benar-benar mengharapkan orang seperti saya berjalan di jalan kotor ini, gubernur? Bangunlah jalanan yang layak dari sebuah kota yang sebenarnya!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Bangunlah jalanan berbatu di kotamu";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Bangunlah jalan tanah di kotamu.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Seseorang telah melakukan hal yang buruk di sini, Tuanku. Semua gedung perlu perbaikan total.\n\nKita perlu menyewa tukang kayu untuk memperbaiki semua gedung sebelum rusak secara total.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Bangun bengkel tukang kayu. Capai kepuasan yang tinggi dengan kondisi gedung.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Gubernur! Mengapa kotamu masih begitu kecil? Kita jauh tertinggal dari archduke! \n\nKita akan kehilangan taruhan, kecuali engkau segera menambah populasi kota!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Tingkatkan populasi desamu.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Keluarga baru yang pindah ke kota telah mengalami perjalanan yang jauh dan melelahkan dan sangat lapar. Mari kita jamu mereka dan rayakan awal resmi taruhan, Tuanku!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Hasilkan cukup makanan untuk desamu.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Kita harus mulai berdagang dengan kafilah dagang. Apakah pedagang di kota akan menarik tamu dan meningkatkan reputasi kota kita, Tuanku!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Raih uang yang banyak melalui berdagang dengan pedagang.";
"T_GAME_QUEST_SCEN10_16_DESC" = "Jumlah pajak yang kau kumpulkan sangat payah! Mungkin kau harus membangun gudang harta untuk menambah penerimaan pajak.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Bangunlah gudang harta dan kumpulkan pajak secukupnya.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Perhiasan, aku butuh perhiasan! Aku masih sangsi tentang caramu bisa mengirim perhiasan jika engkau belum pernah membangun pandai emas.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Bangunlah pandai emas dan mulai dengan menghasilkan perhiasan.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Luar biasa, Tuanku. Sekarang Anda bisa mengirim sekereta perhiasan.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Kirim perhiasan ke pedagang.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Tuanku, prioritas utama kita adalah suplai makanan. Kita perlu nelayan dan pemburu.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Bangunlah beberapa pondok nelayan dan pemburu.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Gubernurku yang baik, Aku tidak bisa mendukung usahamu sampai kau membangun pasar.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Pasar diperlukan untuk memperluas desa kita.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Tuanku! Sudahkah engkau membangun bengkel pembuat peralatan? Archduke telah mulai menghasilkan peralatan!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Bangunlah bengkel pembuat peralatan dan mulai hasilkan peralatan.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Dengan semua kerja keras kita akan punya tempat bersantai, bertemu rekan dan minum secangkir jus anggur. Sebuah bar akan sangat bagus.\n\nTentu saja semuanya terserah Anda, Tuanku.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Capai kepuasan yang tinggi dengan beberapa bar.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Apakah kita punya lahan perumahan yang cukup, Tuanku? Semua pekerja baru yang pindah ke kota perlu tempat berteduh, Anda setuju?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Bangunlah 2 balai kota yang besar dan 4 yang biasa.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Bangunlah lebih banyak rumah tinggal besar.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Bangunlah lebih banyak rumah tinggal kecil.";
"T_GAME_QUEST_SCEN10_7_DESC" = "Kota butuh beberapa hiburan yang mewah. Sebagai contoh, arena adu tombak. Pastikan engkau bisa menyediakan jenis hiburan ini sebelum tamu penting tiba.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Mencapai kepuasan yang tinggi dengan hiburan.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Capai kepuasan yang tinggi dengan arena adu tombak.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Tuanku, mungkin kita bisa mempercantik kota suram ini dengan membangun beberapa patung dan dekorasi? Mari selesaikan sebelum raja berkunjung kembali.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Percantik kotamu dengan dekorasi.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Hari yang cerah, gubernur. Apakah Anda tertarik untuk berdagang?\n\nAku sangat butuh pakaian yang banyak guna mengungguli archduke. Aku akan membayar sangat mahal jika engkau bisa mengirimkan apa yang kubutuhkan.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Kirimkan muatan pakaian ke pedagang.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Ini benar-benar bencana, gubernur! Archduke of Canterborough telah mengalahkan kita dengan telak dan telah menyelesaikan kotanya sebelum kita!\n\nAku mengandalkan dukunganmu dan sekarang aku benar-benar kecewa. Mungkin memenangkan taruhan hanyalah impian gila nomor satu. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Luar biasa, gubernurku yang baik! Kita mengalahkan Archduke dalam membangun dan memperluas kota kita. Taruhannya telah dimenangkan!\n\nAku terkesan dengan kinerjamu dan akan memastikan engkau dihargai secara mewah. Aku juga akan menganugerahkan jabatan Duke, dengan semua hak dan keistimewaan yang terkait dengan itu.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Abdiku yang setia, mungkin aku terlalu memaksakan diri.\n\nAku telah bertaruh dengan Archduke of Canterborough bahwa aku akan mampu mengubah kerajaanku yang paling terbelakang menjadi kota besar yang makmur sebelum ia bisa melakukan hal yang sama terhadap kotanya.";
"T_GAME_QUEST_SCEN12_01_START" = "Terima kasih Tuan sudah mengunjungi kami. Saya ucapkan selamat datang atas nama semua rahib yang ada di sini. Ini adalah biara Tardishingen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Selamat datang di Tardishingen, Tuanku.\nTentu saja kami bisa mengusahakan hadiah yang sempurna untuk sang Raja. Tapi kami lagi menghadapi masalah bandit. Mungkin Tuanku juga bisa membantu kami.";
"T_GAME_QUEST_SCEN12_02_START" = "Keterlaluan sekali!\n\nAda yang mencuri kayu kami! Kami tidak bisa menyimpan bir tanpa kayu untuk membuat gentong.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Terima kasih banyak, Tuanku! Sekarang kami bisa membuat gentong bir lagi.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Bangunlah beberapa pondok rimbawan.";
"T_GAME_QUEST_SCEN12_04_START" = "Tuanku, kota perlu diperbesar agar tugas kita bisa dirampungkan. Pertama-tama kita perlu ekonomi yang stabil. Untuk itu kita harus memproduksi peralatan.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Bagus sekali, Tuanku. Sekarang kota bisa semakin diperluas.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Siapkan rantai produksi peralatan.";
"T_GAME_QUEST_SCEN12_05_START" = "Kota perlu disuplai dengan lebih banyak makanan, Tuanku. Kita punya pertanian, tapi tidak punya kincir angin atau toko roti?";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Bagus sekali! Desa mulai berkembang menjadi kota.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Kembangkan produksi pangan yang stabil.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "Aduh! Dasar gerombolan bandit! Mereka menghancurkan biara!";
"T_GAME_QUEST_SCEN12_06_START" = "Tuanku, biara ini sudah empat abad berdiri di atas bukit ini. Sungguh mengerikan kalau bangunan ini sampai dihancurkan oleh gerombolan bandit. Sudah berminggu-minggu mereka mengancam akan menghancurkannya...";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Syukurlah, Tuanku.\nBiara mampu bertahan menghadapi serangan bandit dan kita berhasil membuat bir yang sempurna! \n\nMinuman ini lezat sekali! Sungguh luar biasa.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Lindungi biara.";
"T_GAME_QUEST_SCEN12_07_START" = "Biara harus dibangun kembali atau tugas kita takkan selesai pada waktunya!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Bagus sekali, Tuanku! Biara sudah dibangun kembali! Tugas kita bisa diteruskan: Membuat bir yang sempurna!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Bangun kembali biara.";
"T_GAME_QUEST_SCEN12_08_START" = "Kita harus meningkatkan pengamanan biara, Tuanku! Penempatan menara jaga di sebelahnya akan membuat pertahanannya semakin kuat.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Bangunlah menara jaga di sebelah biara.";
"T_GAME_QUEST_SCEN12_09_START" = "Sudah tahu serdadu sangat suka sosis?\nCobalah membuat peternakan babi dan rumah jagal untuk memproduksi sosis.";
"T_GAME_QUEST_SCEN12_09_START2" = "Tuanku,\n\nAku merekomendasikan pembangunan peternakan babi dan rumah jagal. Dengan begitu kita bisa memproduksi daging untuk penghuni desa dan sosis kesukaan para serdadu kita.";
"T_GAME_QUEST_SCEN12_10_START" = "Hmm, para serdadu malang ini perlu diberi pedang dan baju tempur. Dengan begitu, lebih besar kemungkinan mereka akan selamat di medan tempur. Untuk itu kita perlu gudang senjata dan tempat penyamakan kulit.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Kita berhasil, Tuanku! Sekarang kita bisa membuat baju tempur untuk serdadu kita.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Bangunlah gudang senjata dan tempat penyamakan kulit.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Membangun gudang senjata.";
"T_GAME_QUEST_SCEN12_11_START" = "Setelah ada gudang senjata dan tempat penyamakan kulit, sudah waktunya kita mulai memproduksi peralatan.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Bagus, Tuanku! Sekarang para serdadu akan lebih perkasa di medan tempur!";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Buatlah perlengkapan untuk para serdadu.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Bagus sekali, Tuanku. Sekarang biara seharusnya aman kalau ada serangan bandit lagi!";
"T_GAME_QUEST_SCEN12_15_START" = "Ladang hop yang rusak belum berhasil diperbaiki.\n\nBoleh minta tolong membuat ladang baru?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Buatlah ladang hop.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Buatlah pertanian hop berikut ladang hop.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Hahaha. Biara kecilmu tinggal sejarah. Sekarang aku penguasa daerah ini!";
"T_GAME_QUEST_SCEN12_16_START" = "Kau pikir kau sanggup melindungi para rahib? Aku tidak yakin. Biar kutunjukkan bagaimana aku akan menghancurkan biaramu itu.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Arghhh! Lain kali kau akan rasakan balasanku! Ini belum selesai...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Tangkal semua serangan.";
"T_GAME_QUEST_SCEN12_17_START" = "Tuanku, para rahib dan aku akan segera mulai memproduksi bir terbaik di seluruh negeri.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Proses pembuatan bir sudah selesai, Tuanku. Ada bermacam-macam resep yang dicoba. Sekarang tinggal memilih mana yang terbaik lalu menyempurnakannya lebih lanjut.";
"T_GAME_QUEST_SCEN12_18_START" = "Ahli bir kami berpesan bahwa perlengkapannya perlu ditingkatkan agar birnya bisa disempurnakan. Kita ingin menyenangkan sang Raja, bukan? Ini harus menjadi bir terbaik di seluruh negeri...";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Bagus, Tuanku! Sekarang kita tinggal mencari bahan-bahan terbaik.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Tingkatkan biara ke level 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Tuanku, birnya hampir selesai. Tetapi masih ada beberapa bahan yang kurang. Herba dan debu emas akan membuat birnya sempurna.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Sediakan herba dan bijih emas. ";
"T_GAME_QUEST_SCEN12_20_START" = "Ramuan bir perlu didiamkan beberapa waktu.\n\nTidak boleh ada gangguan dari luar, agar proses pematangan dapat berjalan dengan baik.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Sudah selesai, Tuanku. Siap merasakan bir yang sempurna?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Pertahankan biara sampai proses pembuatan bir selesai.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Aku ingin menyampaikan ucapan terima kasih secara langsung, pembantu raja.\nIni memang hadiah ulang tahun yang terbaik untukku. Aku tidak menyangka kau tahu pembuatan bir itu hobiku.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Buatlah bir yang sempurna untuk sang Raja.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Siapkan kota untuk kedatangan sang Raja. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Kaukira bisa mengelabuiku? Aku kecewa kamu tidak berhasil mengelola kota kecil ini.\n\nAku mengelola satu kerajaan, tapi tidak perlu mengelabui siapa pun!";
"T_GAME_QUEST_SCEN13_01_START" = "Aku akan menginspeksi wilayah kekuasaanku selama tahun depan.\nKotamu yang termasyhur akan menjadi puncak perjalananku!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Aku sangat puas dengan kerjamu!\nKau berhasil mengelola kota dengan baik dan berhak atas penghargaan tertinggi dariku.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Lewati inspeksi sang Raja.";
"T_GAME_QUEST_SCEN13_02_START" = "Salam, Tuan Pembantu Raja! Aku memutuskan datang lebih awal untuk melihat kotamu yang indah!\n\nRupanya kau sudah menantikan kedatanganku.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Jangan sampai Raja menjadi curiga.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Pertama-tama, produksi barang harus dijalankan lagi!\n\nPekerjakan rimbawan dan perbaiki penggergajian agar produksi bisa mulai berjalan lagi.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Bagus sekali, Tuanku.\nTapi tidak ada waktu untuk beristirahat!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Pekerjakan rimbawan dan perbaiki penggergajian.";
"T_GAME_QUEST_SCEN13_05_START" = "Aduh! Akibat bandit di hutan, seluruh kota terbengkalai.\n\nPembangunan kembali harus segera dimulai!";
"T_GAME_QUEST_SCEN13_06_START" = "Pasar terbakar habis dan perlu dibangun kembali!\n\nKita sangat memerlukan barang-barang untuk mempersiapkan kota menghadapi kedatangan sang Raja.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Kita juga perlu tukang kayu, Tuanku. Banyak bangunan perlu diperbaiki dengan segera!";
"T_GAME_QUEST_SCEN13_07_START" = "Kita perlu gedung kas, supaya penarik pajak bisa meneruskan pekerjaannya.\nKeping uangnya sangat diperlukan untuk pekerjaan perbaikan!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Kita harus menggunakan uang pajak untuk membayar perbaikan yang diperlukan.";
"T_GAME_QUEST_SCEN13_08_START" = "Kita perlu memperbaiki rumah-rumah dan membangun rumah baru untuk menarik lebih banyak pekerja ke kota.\nProduksi harus berjalan lagi!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Sekarang sudah ada tempat untuk lebih banyak pekerja, tapi urusan kita belum selesai.";
"T_GAME_QUEST_SCEN13_09_START" = "Ini kacau-balau!\nKita hanya bisa menambal tempat-tempat yang akan dikunjungi Raja dan berharap ia takkan curiga.\n\nManfaatkanlah waktu istirahat sang Raja dengan bijaksana!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Tunggu sampai Raja mengumumkan tempat pertama yang akan dikunjungi.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Raja melihat bandit dan menjadi curiga! Kita harus lebih berhati-hati!";
"T_GAME_QUEST_SCEN13_10_START" = "Raja ingin menjelajahi hutan.\nKita harus menghancurkan kamp bandit sebelum ia sampai di sana!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Hampir saja! Tapi ini belum selesai...";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Hancurkan semua kamp bandit. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Aduh! Kita tidak berhasil mengelabui sang Raja.\nBerhubung ia sudah curiga, kita tidak boleh membuat kesalahan lagi!";
"T_GAME_QUEST_SCEN13_11_START" = "Raja ingin jalan-jalan di kota.\nJika ia melihat penduduk yang tidak puas, ia pasti akan curiga bahwa ada yang tidak beres.\n\nKita juga perlu membuat patung san Raja!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Bagus sekali! Semua townie sangat bersemangat ketika sang Raja berjalan-jalan.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Tingkatkan kepuasan penduduk kota dan buatlah patung sang Raja.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Raja tidak terkesan!\nKita tidak boleh membuat kesalahan lagi!";
"T_GAME_QUEST_SCEN13_12_START" = "Raja akan menginspeksi pasukan kita.\nPastikan penjaga kota tampil mengesankan saat menanti kedatangan sang Raja!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Pasukan penjaga kota pasti akan membuat sang Raja terkesan!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Pastikan ada cukup banyak serdadu.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Kita gagal, Tuanku. Pesta ternyata tidak sesuai standar sang Raja dan ia tidak senang! \n\nMungkin malah lebih baik seandainya kita jujur saja…";
"T_GAME_QUEST_SCEN13_13_START" = "Raja ingin membuat pesta besar. Pastikan kita punya persediaan perhiasan dan pakaian kebesaran.\nSemuanya akan kacau kalau kita gagal!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "Pesta sangat berhasil! Sepertinya kita berhasil mengelabui sang Raja.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Timbun persediaan pakaian dan perhiasan.";
"T_GAME_QUEST_SCEN13_14_START" = "Terlalu berbahaya bagiku untuk menyusuri jalan kalian dengan barang-barangku saya yang berharga.\n\nSilakan cari jalan keluar sendiri!";
"T_GAME_QUEST_SCEN13_15_START" = "Setelah kalian berhasil menumpas gerombolan bandit, aku dengan senang hati akan berkunjung lagi untuk berdagang.";
"T_GAME_QUEST_SCEN13_16_START" = "Pedagang itu pengecut, tapi ucapannya benar!\nHutan di sekeliling kota memang berbahaya. Kita perlu melatih penjaga untuk menghalau para bandit.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Tuanku telah membangun landasan untuk pertahanan kota. Tapi sebaiknya kita kembangkan lagi.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Bangunlah barak dan menara jaga.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Aduh! Gerombolan bandit berhasil menerobos pertahanan kita? Sang Raja takkan senang kalau mendengarnya. ";
"T_GAME_QUEST_SCEN13_19_START" = "Kehadiran bandit tidak baik untuk citra kota yang aman.\nJangan sampai terjadi terlalu banyak serangan selama inspeksi, atau kita pasti ketahuan!";
"T_GAME_QUEST_SCEN14_01A_START" = "Tuanku, bukankah tingkah orang ini agak aneh?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Kirim kain.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Tuanku, kita gagal menjalankan tugas!\nPenasihat medis itu ternyata penipu dan membawa lari seluruh emas yang ada di gedung kas.\n\nTapi kita beruntung dan menemukan obatnya di laboratoriumnya…";
"T_GAME_QUEST_SCEN14_01_START" = "Selamat pagi, Tuanku. Kerajaan dilanda penyakit.\nBahkan sang Raja pun sakit keras! Kita harus membantu penasihat medis istana untuk segera menemukan obatnya. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Kita berhasil menemukan obatnya, Tuanku!\n\nRaja sedang diobati sekarang! Ini kabar baik untuk kerajaan!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Temukan obat untuk sang Raja.";
"T_GAME_QUEST_SCEN14_02A_START" = "Ada yang tidak benar, Tuanku! Permintaan si penasihat medis terlalu aneh. Aku punya firasat buruk...\n\nKita harus berhati-hati terhadap orang ini.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Aku akan mengantarkan bir ini kepada sang dokter begitu Tuanku memberi perintah.\nSemoga ia segera menemukan obatnya. Waktu sang Raja tidak banyak lagi!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Antarkan bir.";
"T_GAME_QUEST_SCEN14_02_START" = "Tempat pembuatan bir di biara sepertinya tempat terbaik untuk mendapatkan bir untuk sang Raja.\n\nSemoga bisa mengurangi penderitaan sang Raja.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Kukira tempat pembuatan bir di biara dan pertanian hop adalah cara terbaik mendapatkan bir untuk sang Raja. \n\nSemoga bisa mengurangi penderitaan sang Raja.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Bagus, Tuanku! Para rahib akan membantu kita mendapatkan bir! Raja akan senang.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Bangunlah biara.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Bangunlah biara dan tempat pengeringan hop.";
"T_GAME_QUEST_SCEN14_03_START" = "Kita perlu peternakan babi untuk mensuplai babi kepada penasihat medis!\nSegeralah beri perintah untuk membangunnya, Tuanku.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Bagus sekali, Tuanku. Sekarang kita bisa mulai beternak babi.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Bangunlah peternakan babi.";
"T_GAME_QUEST_SCEN14_05_START" = "Tuanku, kota membutuhkan barak. Kita harus menegakkan hukum dan ketertiban di masa sulit ini.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Tuanku! Apa kubilang!\n\nPenasihat medis itu ternyata penipu. Dari awal ia sudah punya obat untuk sang Raja.\nSepertinya ia sengaja menyebarkan penyakit ini ke seluruh negeri. \n\nAku sudah minta para penjaga untuk menangkapnya.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "Ini sungguh keterlaluan!\n\nBeraninya kau menangkapku! Aku penasihat khusus sang Raja. \nKau tidak bisa berbuat begini…";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Kau mengecewakanku, Gubernur!\n\nSemalam aku mendapat bisikan! Aku diberi tahu bahwa kota ini akan celaka karena ketidakmampuanmu.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Gubernur! Aku Rasiksin, penujum dan penasihat medis sang Raja.\nAku perlu dukungan penuh darimu!\nYang pertama: Kirimkan herba obat secukupnya secepat mungkin!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Semua herba yang kuperlukan sudah kausediakan.\n\nSemalam aku mendapat bisikan ...kau takkan mengecewakan Raja.\n\nSekarang suruh penasihatmu mengantarkan herba itu kepadaku dan menyingkirlah dari sini. Aku harus bekerja.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Kirim herba.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Seharusnya aku tidak mengandalkanmu, Gubernur! Aku sudah mendapat bisikan bahwa kota akan celaka karena ketidakmampuanmu! Kau telah mengecewakan sang Raja dan aku, Gubernur!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Aku butuh kain untuk menyaring obat ini. Kau harus membuatkan kain untukku. Dan jangan lama-lama, supaya aku segera bisa mulai menyaring.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Syukurlah kau tidak buang-buang waktu, Gubernur!\n\nSekarang perintahkan agar semua sumber daya diantarkan! Aku sangat sibuk!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Buatlah kain.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "Obat ini perlu diencerkan untuk produksi massal. Cairan pengencer yang paling cocok adalah bir! \n\nAyo, segera mulai bekerja!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Sudah waktunya! Segera antarkan ke laboratoriumku.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Buatlah bir.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Aduh… sudah terlambat! Kota akan dilanda bencana berikut.\n\nIni salahmu!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Kita harus mengambil langkah lebih drastis untuk menyelamatkan Raja!\n\nAku perlu babi untuk dikorbankan kepada dewa-dewa tradisional.\nMungkin itu bisa membantu...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Kau lama sekali, Gubernur. Kukira kau takkan datang...";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Antarkan babi.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Aku butuh...ehm...maksudku, sang Raja butuh daun pipa khusus untuk mengurangi nyerinya.\n\nAntarkan uang sepeti untuk membeli obat!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nSerahkan kepadaku! Aku…ehm... maksudku, sang Raja akan senang karena segera mendapat obatnya. Ia sangat kesakitan.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Antarkan uang.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Aku telah memastikan bahwa pakaian sang Raja-lah yang membuatnya sakit. Ia perlu pakaian baru yang terbuat dari bahan khusus.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Akhirnya kau datang membawa pakaian. Sang Raja sudah mulai tidak sabar.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Antarkan pakaian.";
