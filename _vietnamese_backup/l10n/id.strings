"T_GAME_QUEST_SCEN16_06_START" = "Raja sangat puas dengan kiriman kita.\nIa minta kita juga kirim makanan.\n\nSumbangkan jus anggur dan roti untuk pesta kerajaan. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Bagus sekali, Tuanku. Ini adalah upeti terakhir.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Kirim sosis dan roti.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Kirim jus dan roti.";
