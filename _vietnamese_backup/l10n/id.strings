"T_GAME_HELPPAGE_DLC_AZURE_CHOICE_POPUP_01" = "Cerita singkat dapat dipicu ketika kondisi tertentu terpenuhi. Misalnya, jika bangunan tertentu telah didirikan atau jumlah warga telah mencapai ukuran tertentu.";
"T_GAME_HELPPAGE_DLC_AZURE_CHOICE_POPUP_02" = "Kadang-kadang, satu atau lebih pilihan dalam pengambilan keputusan cerita singkat tidak tersedia. Hal ini terjadi karena tidak terpenuhinya salah satu syarat.";
"T_GAME_HELPPAGE_DLC_AZURE_CONTENT" = "Isi";
"T_GAME_HELPPAGE_DLC_AZURE_CONTENT_ONLYAZURE" = "Beberapa konten, seperti pelabuhan, hanya tersedia di "The Seaside Empire".";
"T_GAME_HELPPAGE_DLC_AZURE_HARBOR_PLACEHOLDER" = "Pelabuhan hanya dapat dibangun di peta "The Seaside Empire" di tempat-tempat khusus di pantai. Tempat ini ditandai dengan tiang kayu.";
"T_GAME_HELPPAGE_DLC_AZURE_INTRO" = "Pengantar";
"T_GAME_HELPPAGE_DLC_AZURE_NEWCONTENT_01" = "Bangunan dan dekorasi baru dapat ditemukan di menu bangunan. Latar baru hanya dapat dicapai dengan memilih peta di menu utama dan memulai kota baru di "The Seaside Empire".";
"T_GAME_HELPPAGE_DLC_AZURE_NEWCONTENT_02" = "Cerita singkat dan event, serta istana militer hanya tersedia saat kau memulai game tanpa akhir baru. Di sini, kau juga akan menemukan beberapa opsi untuk mempersonalisasi permainan dalam mode tanpa akhir.";
"T_GAME_HELPPAGE_DLC_AZURE_SANDBOX_SETTINGS" = "Bandit, bencana, tugas acak, atau cerita singkat dapat diaktifkan dan dinonaktifkan dalam pengaturan peta tanpa akhir. Pengaturan ini hanya dapat diubah saat memulai peta tanpa akhir.";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_AZURE" = "Latar Baru – "The Seaside Empire"";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_AZURE_DESC" = ""The Seaside Empire" menawarkan iklim Mediterania dengan pantai yang indah dan air yang jernih. Tak ada salju yang turun di sini saat musim dingin, tetapi kekeringan dan gelombang panas di musim panas serta badai besar di musim gugur dan musim dingin mungkin akan ditemui. Wilayah ini memiliki topografi yang unik dan gaya bangunan khas yang mewakili daerah ini.";
"T_GAME_HELPPAGE_DLC_AZURE_SETTING_BEACHES_DESC" = "Di pantai pasir "The Seaside Empire", gandum dan produk pertanian lainnya tak dapat dibudidayakan. Namun, mereka tumbuh di padang rumput di daerah itu.";
"T_GAME_HELPPAGE_DLC_AZURE_TOWNHOUSES" = "Rumah tinggal sedang dan rumah kota";
"T_GAME_HELPPAGE_DLC_AZURE_TOWNHOUSES_01" = "Rumah tinggal sedang dan rumah kota menawarkan masing-masing 4 dan 3 ruang tinggal keluarga secara default.";
"T_GAME_HELPPAGE_PRESTIGE_01" = "Prestige adalah sumber daya khusus yang melambangkan reputasimu di dunia townie. Banyak fungsi khusus dapat digunakan dengan Prestige. Prestige dapat diperoleh dengan menyelesaikan tugas dalam skenario dan peta tanpa akhir. Jumlah Prestige-mu unik di setiap peta.";
"T_GAME_HELPPAGE_PRESTIGE_02" = "Dengan Prestige, bangunan dapat segera diselesaikan atau ditingkatkan dan dekorasi khusus dapat didirikan.";
