"T_MAP_CANALGRANDE_DESC" = "Laguna dengan banyak pulau kecil adalah tempat sempurna untuk membangun kota yang dihubungkan oleh jembatan dan dilewati kanal.";
"T_MAP_COASTALISLAND_DESC" = "Di teluk ini ada pulau yang cantik. Sanggupkah kau membangun kota yang berpengaruh di tempat terpencil ini?";
"T_MAP_COASTSANDCLIFFS_DESC" = "Kastil berada di atas tebing tinggi dan menghadap ke samudra. Dataran di sekelilingnya cocok untuk membangun kota pesisir yang bagus.";
"T_MAP_COASTSANDCLIFFS_NAME" = "Tebing dan Pesisir";
"T_MAP_DESC_10" = "Lembah yang subur ini sangat cocok untuk membangun kota yang maju.";
"T_MAP_DESC_11" = "Peta ini dibuat untuk menguji kinerja semua perangkat. Sebuah kota yang sangat besar terbentang pada peta tersebut.";
"T_MAP_DESC_12" = "Gemercik air sungai di dataran ini mengundang para Townie untuk memancing atau berenang di air yang sangat jernih.";
"T_MAP_DESC_13" = "Di bawah dataran tinggi yang teduh, sebuah desa kecil bisa tumbuh menjadi kota yang besar.";
"T_MAP_DESC_14" = "Kerajaan ini menderita karena kemarau. Sungai telah mengering. Ini membuat penggarapan lahan menjadi tugas menantang bagi Penduduk Kota Anda.";
"T_MAP_DESC_15" = "Membuat pos dagang yang berkembang di dataran tinggi. Transaksi menguntungkan dengan pedagang dan kesatria menanti Anda.";
"T_MAP_DESC_16" = "Bentuk koloni pertambangan dan berikan sumber daya untuk pembangunan katedral monumental.";
"T_MAP_DESC_17" = "Persiapkan pernikahan istana yang agung.";
"T_MAP_DESC_18" = "Bangun kota besar di dekat dasar sungai kering ini, tapi ingat bahwa air adalah komoditas langka di daerah ini.";
"T_MAP_DESC_19" = "Ada dataran kecil dekat tepi rawa. Tempat terbaik untuk sebuah kota.";
"T_MAP_DESC_2" = "Tempat tenang di pesisir pantai ini adalah lokasi yang ideal untuk mendirikan desamu.";
"T_MAP_DESC_20" = "Wilayah gunung terpencil di tengah negeri antah-berantah. Tak ada air, tapi urat bijih tak terhitung. Tempat sempurna untuk menjadi kaya!";
"T_MAP_DESC_2016_01" = "Raja memerlukan banyak papan untuk membangun armada besar. Coba cari tahu kenapa kiriman kayu terhenti dan bangunlah Perkumpulan Saudagar.";
"T_MAP_DESC_2016_02" = "Kawasan ini sempurna untuk membangun kota besar. Perbukitan luas ini menyediakan tempat yang cukup untuk tidak terhitung banyaknya bangunan.";
"T_MAP_DESC_2016_03" = "Kota kecil telah menjadi metropolitan besar. Penuhi keinginan dan kebutuhan para Townie dalam waktu yang tersedia.";
"T_MAP_DESC_2016_04" = "Ubahlah pekerjaan para Townie untuk membangun pasar dan kedai minum.";
"T_MAP_DESC_2016_05" = "Rencanakan kotamu dengan baik, ruang untuk bangunan terbatas di antara air terjun dan medannya mungkin sulit dilalui.";
"T_MAP_DESC_2016_06" = "Di daerah ini rawan longsor. Tapi di luar itu, ada baiknya mendirikan kota kecil dan memanfaatkan cadangan bijih yang besar.";
"T_MAP_DESC_2016_08" = "Bangunlah kotamu di lembah. Kau bisa mendapatkan semua yang diperlukan, tetapi beberapa daerah sulit dijangkau.";
"T_MAP_DESC_2016_09" = "Seberangi sungai untuk mencapai sumber daya yang diperlukan untuk kotamu.";
"T_MAP_DESC_2016_10" = "Simpanlah keping-keping uang. Tapi awas, para bandit bersarang di daerah ini. Selain ancaman bandit, Townie yang tidak bahagia tidak akan membayar pajak.";
"T_MAP_DESC_21" = "Buat desa di pulau yang luar biasa dan tersembunyi. Nikmati udara laut yang segar!";
"T_MAP_DESC_21_NOBANDITS" = "Dirikan sebuah desa di pulau yang indah dan terpencil. Nikmati udara laut yang segar!";
"T_MAP_DESC_22" = "Antarkan kotamu melewati musim dingin yang tak kenal ampun.";
"T_MAP_DESC_23" = "Di dataran beku ini, kau harus membangun kota yang berfungsi sangat cepat atau kelaparan selama musim dingin.";
"T_MAP_DESC_24" = "Dukung raja dalam membangun armada kapal yang hebat, sembari mengendalikan kerusuhan di kotamu.";
"T_MAP_DESC_25" = "Gunakan hutan di sekitar wilayah ini untuk kau manfaatkan ketika mencoba mendirikan kotamu. Air sangat jarang di sini, jadi mencari ikan tidak bisa diandalkan sebagai sumber makanan.";
"T_MAP_DESC_26" = "Rajamu telah memasukkan taruhan dan tugasmu untuk membangun kota besar sebelum archduke. Kau punya setahun untuk menyelesaikan semua tugas. Jangan kecewakan rajamu!";
"T_MAP_DESC_27" = "Wilayah rawa mempersulit menemukan lahan bangunan yang cocok. Pastikan menggunakan lahan bangunan yang tersedia secara efisien!";
"T_MAP_DESC_28" = "Lembah berbatu dengan banyak sumber daya, tapi lahan terbatas untuk bangunan.";
"T_MAP_DESC_29" = "Gugusan pulau kecil yang sulit dijadikan tempat bermukim.";
"T_MAP_DESC_29_NOBANDITS" = "Kelompok kepulauan kecil. Mendudukinya akan cukup menantang.";
"T_MAP_DESC_3" = "Ini adalah peta tutorial. Di sini kamu akan belajar dunia Townsmen.";
"T_MAP_DESC_30" = "Bangunlah kota di sekeliling bentengmu di atas gunung. Musim dingin yang panjang mempersulit pasokan makanan di sini.";
"T_MAP_DESC_31" = "Sang Raja akan menginspeksi daerah kekuasaannya. Bersiaplah untuk kedatangannya.";
"T_MAP_DESC_32" = "Sebentar lagi Raja berulang tahun. Sekarang carilah resep bir yang sempurna sebagai hadiah. Para rahib di biara mungkin tahu lebih banyak...";
"T_MAP_DESC_33" = "Sang Raja terserang penyakit misterius. Tugasmu adalah menyembuhkannya dan mencari sumber penyakitnya.";
"T_MAP_DESC_34" = "Negeri dilanda perang. Jauh dari garis depan, kamu harus membangun kota yang berkembang dan mendukung pasukan Raja.";
"T_MAP_DESC_35" = "Raja ingin bersiap-siap menghadapi zaman susah, dan kotamu terpilih untuk mensuplai barang yang dibutuhkan.";
"T_MAP_DESC_36" = "Pelajari detail perang dari seorang veteran.";
"T_MAP_DESC_37" = "Penuhilah harapan istrimu sambil menangani bandit pemeras.";
"T_MAP_DESC_4" = "Kastilmu terletak pada pulau sungai kecil. Gunakan tepi sungai dengan bijak dan bangunlah perekonomian yang berkembang.";
"T_MAP_DESC_6" = "Bangunlah desa kecil di tepi sungai dari danau yang indah.";
"T_MAP_DESC_7" = "Kotamu telah dipilih raja untuk menyelenggarakan pertempuran terhebat!";
"T_MAP_DESC_8" = "Musim dingin segera tiba! Bantulah para Townie untuk bersiap menghadapi musim yang sangat dingin!";
"T_MAP_DESC_9" = "Bantulah istrimu dan bangun perekonomian desa yang sekarat untuk berkembang kembali!";
"T_MAP_DESC_APOCALYPSE" = "Kota terkena kutukan. Penyakit aneh dan bencana menghantui para penduduk. Sekarang tergantung kepadamu untuk mencari jalan mengatasi kutukan ini secepat mungkin. Dengan cara apapun...";
"T_MAP_DESC_FESTIVITIES" = "Sang Raja menikah lagi. Untuk menghormati istri barunya, kamu harus mengadakan beberapa festival musiman. Tapi perencanaan dan pelaksanaannya mungkin sulit. Kamu akan berlomba melawan waktu...";
"T_MAP_DESC_ICYHOLD" = "Benteng Es berdiri kokoh di puncak tebing. Tempat ini sulit dijangkau, tapi begitu berada di sana, orang bisa memandang jauh ke tundra yang membeku. Musim dingin berlangsung sangat lama di sini!";
"T_MAP_DIPLOMATICVISIT_DESC" = "Ratu sebuah negeri bersahabat mengunjungi kota. Perjanjian dagang yang menguntungkan sudah ditandatangani, tapi ada kendala bahasa yang harus diatasi dulu.";
"T_MAP_DIPLOMATICVISIT_NAME" = "Kunjungan diplomatik";
"T_MAP_DIVIDEDSHORELINE_DESC" = "Sebuah gunung megah membelah negerimu. Selain itu, kau bisa menaklukkan sebuah pulau yang tidak jauh dari kastilmu.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "Garis pantai terbelah";
"T_MAP_FRIGYTHKINGDOM_DESC" = "Ratu Frigyth perlu gubernur baru untuk mengelola bagian ini dari kerajaannya. Bangunlah kota yang megah di negeri baru ini.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "Kerajaan Frigyth";
"T_MAP_FROZENFRONT_DESC" = "Sebagian besar kota tinggal puing akibat perang terakhir. Reruntuhan kota yang berselimutkan salju kini menandai bekas garis depan di antara kedua pasukan. Sekarang waktunya kota dibangun kembali.\n\nPeta ini khusus musim dingin!";
"T_MAP_HIGHLANDS_DESC" = "Negeri ini ditandai oleh pegunungan dan perbukitan. Pemandangan dari puncak-puncak sangat indah.";
"T_MAP_HIGHLANDS_INTRO" = "Selamat datang di dataran tinggi, Gubernur. Daerah ini penuh misteri. Asal kau memperhatikan dan memedulikan para penduduk, aku yakin negeri ini akan segera mengungkapkan semua rahasianya kepadamu.";
"T_MAP_HIGHLANDS_NAME" = "Dataran tinggi";
"T_MAP_INSANECHOICES_DESC" = "Kau dipanggil ke sebuah desa di mana sang Adipati sepertinya sakit jiwa. Para Townie tidak mau membayar pajak!\nSetiap pilihanmu akan membawa akhir yang berbeda.";
"T_MAP_INSANECHOICES_NAME" = "Pilihan Gila";
"T_MAP_LEGACY_DESC" = "Paduka Raja punya tugas baru untukmu. Ia semakin tua dan khawatir akan meninggalkan dunia ini tanpa sempat meneruskan hikmah yang diperolehnya selama menjadi Raja kepada generasi berikut.";
"T_MAP_LEGACY_NAME" = "Peninggalan";
"T_MAP_LOWLANDS_DESC" = "Dataran luas dan ruang kosong untuk bangunan membentang hingga ke cakrawala. Di sini bisa dibangun kota yang benar-benar besar.";
"T_MAP_LOWLANDS_NAME" = "Tanah rendah";
"T_MAP_MARSH_DESC" = "Di daerah ini ada banyak padang rumput basah yang menambah keragaman hayati. ";
"T_MAP_MARSH_INTRO" = "Tuanku, lihatlah keseimbangan yang sempurna antara tanah dan air ini. Aku senang bisa menyambut Tuanku di tempat tenang ini.\n\nPara penduduk akan segera menyaksikan upaya Tuanku untuk membantu membawa kejayaan ke daerah ini!";
