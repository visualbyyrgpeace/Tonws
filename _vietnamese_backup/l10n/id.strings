"BUILDING_UPGRADE_TAXBONUS" = "Bonus pajak";
"EVENT_WITCHHUNT_08_SUCCESS" = "Akhirnya, kita punya dokter di desa. Dia pasti bisa membantu kita menangani penyakit ini.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Tunggu sampai dokter kembali dari ibu kota.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Warga desa di kota akan lebih bahagia jika ada tempat bersama bagi mereka untuk bertemu dan minum jus anggur atau meneguk minuman setelah seharian bekerja keras. Apakah permintaanku terlalu besar, Tuanku?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Meningkatkan kepuasan komunitas.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Baiklah, Gubernur. Jika kau tidak mau bertransaksi denganku, anak buahku terpaksa mengambil sendiri apa yang mereka butuhkan.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Kali ini kau beruntung. Lain kali takkan semudah ini.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ha ha ha. Biarlah ini menjadi pelajaran untukmu. Aku yakin lain kali kau pasti mau bertransaksi denganku.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Tuanku, aku butuh banyak batu. Aku akan menyediakan kayu untuk Tuanku jika Tuanku memberiku beberapa batu.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Tuanku, aku telah mengumpulkan kayu untuk membantu pembangunan desa. Aku ingin menukarnya dengan gandum.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Putriku kedinginan semalam. Maukah Tuanku memberiku wol? Aku bisa menyediakan kayu yang berharga sebagai gantinya.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Tuanku, aku ada pertanyaan...putraku ingin belajar menjadi penyamak kulit. Ia perlu kulit untuk latihan. Aku bisa menyediakan kayu sebagai gantinya.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Apakah Tuanku punya herba? Aku tidak punya herba untuk mengolah persediaan dagingku.\nAku rela memberikan kayu terbaikku sebagai gantinya.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Tuanku, aku ingin memperbaiki rumahku. Maukah Tuanku menukar beberapa alat dengan persediaan kayu bakarku yang terakhir?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Tuanku, aku ingin menyiapkan sebuah perayaan. Maukah Tuanku membantuku? Sebagai gantinya, aku akan memberi kayu kepada Tuanku.";
"SCENARIO_CW_QUEST_B_NAME" = "Lakukan transaksi dengan si petani.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Tuanku, keluargaku kelaparan. Maukah Tuanku mengirim ikan untuk kami? Sebagai gantinya aku akan memberikan kayu dari persediaan kayu bakarku.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Aku punya sedikit persediaan kayu untuk pekerjaan perbaikan. Aku bersedia menukarnya dengan beberapa batu, Tuanku.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Anak buahku butuh ikan lagi. Bawakan aku ikan dan aku akan memberimu kayu! Desa kecilmu juga akan selamat.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Hei, Gubernur! Aku akan berbaik hati dan mengambil beberapa batu besar dari gudangmu. Kalau kau setuju, aku akan memberimu kayu.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Daripada gandum-mu sia-sia karena diberikan kepada para petani, lebih baik berikan kepadaku dan aku akan memberimu kayu terbaik milikku.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Kami ingin membungkus gagang pedang dengan wol agar empuk. Jangan takut, asal kau mau bekerja sama, pedang kami takkan digunakan untuk melawanmu.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Anak buahku bosan. Kalau kau menyediakan kulit untuk kami, boneka latihan kami bisa dibuat lebih mirip orang. Kalau kau enggan bertransaksi denganku, kami akan bertransaksi dengan para Townie saja.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Anak buahku ada yang sakit. Aku dengar herba bisa jadi obat. Kalau kau tidak keberatan, aku akan mencari herba di gudangmu. Aku yakin ada di sana.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Alat-alat kami sudah usang. Sedangkan persediaanmu berlimpah, Gubernur. Serahkanlah sebagian dan aku akan berbaik hati dan tidak mengambilnya sendiri.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Anak buahku mau makan daging. Sediakanlah daging untuk mereka dan aku akan bermurah hati dengan memberimu kayu sebagai gantinya.\n\nAtau mungkin anak buahku perlu datang ke kota kecilmu dan mengambilnya sendiri...";
"SCENARIO_CW_QUEST_C_NAME" = "Lakukan transaksi dengan si bandit.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, ada gubernur baru...\nBerhubung masih baru, aku akan menjelaskan aturan yang berlaku. Berikan yang aku minta, dan aku akan membiarkanmu berbuat sesukamu.\n\nCukup adil, bukan? Oke, kita mulai dengan tugas yang mudah: Bawakan aku ikan!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Masalah kayu? Itu bukan masalah!\nAku punya timbunan kayu cur... ehm...simpanan. Untuk beberapa batu aku bersedia menukar beberapa potong kayu.";
"SCENARIO_THIEF_FAIL" = "Jadi, kau benar-benar tidak mau bertransaksi denganku, heh?\n\nBaiklah, kita lihat saja nanti.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Tuanku, apa ini... Kelihatannya seperti gigi. Bukan gigi manusia. Dan ini! Ada jamur truffle lagi. Aku tidak cukup ilmu untuk membuat teori, tapi aku kenal seseorang yang bisa membantu kita. Mari kita temui orang tua itu!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "Siapa lagi selain si pedagang yang selalu menyalahkan warga asli? Dia pasti terlibat!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "Si pedagang!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "Kemungkinannya perempuan muda itu. Dia adik Townette yang dibuang. Itu bisa jadi motif.";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "Si perempuan muda!";
"THEBEAST_CHOICE_A_REASON_DESC" = "Perempuan muda yang secara semena-mena dibuang oleh sang Ratu berada di balik serangan ini. Dia mau membalas dendam karena diasingkan secara paksa.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "V untuk Vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "Upaya desa untuk mencapai kesejahteraan berubah menjadi mimpi buruk... Kemungkinan dia tidak bermaksud buruk, dia hanya mau membantu tetangganya.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "Hector, si seniman!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "Pasti dia! Dia benci semua pendatang baru dan menyerang adik dari perempuan yang dibuang untuk memastikan ladang anggurnya takkan diganggu.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Basil, si petani.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Dengan menakut-nakuti para Townie, si pelaku ingin membuat mereka dibuang dari kota dan mencegah warga desa pindah kemari.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "Untuk mencegah lebih banyak pendatang baru pindah ke desa itu!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Sang Ratu jelas-jelas membantu si pelaku secara finansial.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "Ratu Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "Si tukang roti pelakunya! Dia berpura-pura diserang untuk mengalihkan kecurigaan! Cerdik sekali!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "Si tukang roti.";
"THEBEAST_CHOICE_C_REASON_DESC" = "Ratu Frygith, yang menyesali keputusannya untuk membuat perbatasan, berkomplot dengan beberapa warga untuk menakut-nakuti para pendatang dan untuk menutup perbatasan lagi.";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Konspirasi negara.";
