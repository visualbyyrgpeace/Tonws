"T_SCENARIO_2016_06_BANDIT_01_DESC" = "Jadi kalian mau mencuri bijih emasku? Baiklah, kita lihat apa ganjaran untuk kalian. LOONGSOOOR!";
"T_SCENARIO_2016_06_BANDIT_025_DESC" = "Mau tahu apa yang terjadi dengan orang yang tidak mau menurut? LOONGSOOOR!";
"T_SCENARIO_2016_06_BANDIT_02_DESC" = "Dari mana kalian dapat roti itu? Masa bodoh, aku juga mau! Atau kalian lebih suka kena longsor lagi?";
"T_SCENARIO_2016_06_BANDIT_02_NAME" = "Penuhi permintaan si bandit.";
"T_SCENARIO_2016_06_BANDIT_03_DESC" = "Oh, besinya banyak sekali. Aku yakin sebagian akan kaupakai untuk membuatkan peralatan untukku.";
"T_SCENARIO_2016_06_BANDIT_04_DESC" = "Kebetulan sekali, bijih emasnya sudah dilebur menjadi batangan. Aku sudah bilang itu emas"ku" dan sekarang aku minta kembali! Oh, dan coba murnikan sedikit lagi, oke?";
"T_SCENARIO_2016_06_BANDIT_05_DESC" = "Aku lagi mau cari baju baru. Ada yang ukurannya pas untukku?";
"T_SCENARIO_2016_06_INTRO_01_DESC" = "Setidaknya semua Townie selamat dari longsor, tetapi bangunan yang terkena longsoran telah hancur.";
"T_SCENARIO_2016_06_MAIN_00_DESC" = "Kiriman sumber daya dari desa ini terhenti. Gubernur, aku berharap kau bisa mengatasi masalah ini.";
"T_SCENARIO_2016_06_MAIN_00_END" = "Ancaman bencana longsor bukan masalah untukmu. Aku tahu kau bisa diandalkan, Gubernur.";
"T_SCENARIO_2016_06_MAIN_00_NAME" = "Rampungkan tugas utama dan uruslah tambang.";
"T_SCENARIO_2016_06_QUEST_00_DESC" = "Kita perlu memperbaiki gudang, kalau tidak, gudangnya akan ambruk juga.";
"T_SCENARIO_2016_06_QUEST_00_NAME" = "Perbaiki gudang.";
"T_SCENARIO_2016_06_QUEST_01_DESC" = "Pertama-tama kita perlu penggergajian untuk mendirikan kembali semua bangunan di kota.";
"T_SCENARIO_2016_06_QUEST_01_NAME" = "Bangunlah penggergajian.";
"T_SCENARIO_2016_06_QUEST_02_DESC" = "Tuanku, walaupun ada bahaya longsor, produksi besi dan emas harus kita mulai lagi. Sang Raja menantikan kiriman besar dari desa ini.";
"T_SCENARIO_2016_06_QUEST_02_NAME" = "Suruhlah para penambang mencari bijih besi dan emas.";
"T_SCENARIO_2016_06_QUEST_03_DESC" = "Peleburan logam lebih efektif kalau ditempatkan di dekat tambang, tapi akan ikut rusak kalau ada longsor. Putuskanlah dengan bijaksana, Tuanku.";
"T_SCENARIO_2016_06_QUEST_04_DESC" = "Bagus sekali, Tuanku. Sang Raja mengharapkan ganti rugi untuk kiriman yang terlewatkan. Sebaiknya kita membayar upeti dalam jumlah besar.";
"T_SCENARIO_2016_06_QUEST_04_NAME" = "Bayar upeti kepada sang Raja.";
"T_SCENARIO_2016_06_QUEST_05_DESC" = "Produksi berjalan sangat lamban, Tuanku. Dengan menambah jumlah tambang kita bisa menaikkan kecepatan gali.";
"T_SCENARIO_2016_06_QUEST_06_DESC" = "Persediaan batu bara menipis. Sebaiknya Tuanku memerintahkan pembuatan pondok perapian batu bara.";
"T_SCENARIO_2016_06_QUEST_10_DESC" = "Tuanku, ada baiknya kita membuat emas batangan untuk membayar upeti tambahan. Sang Raja akan sangat senang.";
"T_SCENARIO_2016_06_QUEST_AVALANCHE_00_DESC" = "Awas, Tuanku! Ada longsor lagi, mengerikan sekali!";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_DESC" = "Tuanku, banyak tambang runtuh. Sang Raja telah memberi perintah untuk membangunnya kembali.";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_NAME" = "Bangunlah lebih banyak tambang.";
"T_SCENARIO_2016_06_QUEST_SIDE_025_DESC" = "Istriku mau berdoa agar tidak ada lagi ancaman longsor. Maukah kau berbaik hati dan membangun gereja untuk kami?";
"T_SCENARIO_2016_06_QUEST_SIDE_02_DESC" = "Tuanku, aku tahu kita perlu banyak kayu untuk pembangunan kembali, tapi keluargaku kehabisan kayu bakar dan udara mulai dingin sekali. Mungkin Tuanku bisa menolong kami?";
"T_SCENARIO_2016_06_QUEST_SIDE_03_DESC" = "Sulit sekali untuk berjalan menembus salju. Jalanan berlapis batu pasti membantu.";
"T_SCENARIO_2016_06_QUEST_SIDE_045_DESC" = "Gubernur, gandum tidak tumbuh di daerah ini. Tapi kita bisa beli roti di pasar. Atau kita bisa beli gandum dan membuat roti sendiri.";
"T_SCENARIO_2016_06_QUEST_SIDE_04_DESC" = "Ikan dan daging melulu. Tuanku, kenapa kami tidak bisa makan roti sekali-sekali?";
"T_SCENARIO_2016_06_QUEST_SIDE_04_NAME" = "Penuhilah keinginan para Townie.";
"T_SCENARIO_2016_06_QUEST_SIDE_05_DESC" = "Pakaian kami compang-camping karena cuaca yang keras. Kami benar-benar butuh pakaian baru.";
"T_SCENARIO_2016_06_QUEST_SIDE_06_DESC" = "Peralatan karatan ini nyaris hancur. Sepertinya Tuanku memerlukan besi, tapi menggunakan sedikit besi untuk kami akan sangat membantu kami.";
"T_SCENARIO_2016_06_QUEST_SIDE_07_DESC" = "Di daerah bersalju ini kami bersyukur atas hal sekecil apapun. Andaikan Tuanku tidak terlalu sibuk, maukah Tuanku memperindah kota kami?";
"T_SCENARIO_2016_10_BANDIT_01_DESC" = "Kawan-kawan! Lancarkan serangan!";
"T_SCENARIO_2016_10_BANDIT_04_DESC" = "Kalian mencari si pedagang? Hmm, dia tersesat dan akhirnya tersangkut di kamp-ku. Tapi jangan khawatir, dia baik-baik saja. Berikanlah sumbangan sekadarnya dan dia akan bebas lagi.";
"T_SCENARIO_2016_10_BANDIT_04_END" = "Baiklah, kami akan membebaskan si pedagang. Silakan berdagang dengan dia, supaya ada lebih banyak yang bisa kucuri lagi.";
"T_SCENARIO_2016_10_BANDIT_04_NAME" = "Bayar uang tebusan untuk membebaskan si pedagang.";
"T_SCENARIO_2016_10_BANDIT_END_DESC" = "Kawan-kawan bandit! Ayo, kita menyingkir dari sini! Anggap saja sebagai taktik. Hasil curian kita toh sudah cukup banyak.";
"T_SCENARIO_2016_10_BANDIT_TIMER_10_DESC" = "Kalian hancurkan satu kamp kami? Berarti kalian menantang. Ayo, kawan-kawan, serang kota!";
"T_SCENARIO_2016_10_HAPPYNESS_DESC" = "Gawat, Tuanku. Para Townie kecewa dan tidak mau membayar pajak. Kita harus memenuhi keinginan mereka untuk mendapatkan uang pajak lagi.";
"T_SCENARIO_2016_10_HAPPYNESS_NAME" = "Tingkatkan kebahagiaan untuk mendapatkan uang pajak lagi.";
"T_SCENARIO_2016_10_MAIN_00_DESC" = "Gubernur, aku butuh banyak keping uang. Galakkan perekonomian dan bayarlah upeti. Tapi awas, ada banyak bandit di sekitar. Seluruh kerajaan mengandalkanmu.";
"T_SCENARIO_2016_10_MAIN_00_END" = "Bagus sekali, Gubernur. Aku tahu kau bisa diandalkan. Kau akan menerima hadiah dan reputasimu akan naik.";
"T_SCENARIO_2016_10_NEED_BREAD_DESC" = "Tuanku, persediaan roti di gudang mulai menipis. Ini membuat rakyat menjadi tidak bahagia.";
"T_SCENARIO_2016_10_NEED_BREAD_NAME" = "Sediakan cukup banyak roti untuk meningkatkan kebahagiaan.";
"T_SCENARIO_2016_10_NEED_BREW_DESC" = "Ketidakpuasan semakin meluas, Tuanku. Orang-orang mendambakan bir.";
"T_SCENARIO_2016_10_NEED_BREW_NAME" = "Tambah persediaan bir untuk mencegah aksi mogok para Townie.";
"T_SCENARIO_2016_10_NEED_CARPENTER_DESC" = "Tukang kayu sangat sibuk. Ada banyak bangunan yang harus diperbaiki, Tuanku. Aku sarankan kita menambah jumlah tukang kayu.";
"T_SCENARIO_2016_10_NEED_CARPENTER_NAME" = "Bangunlah bengkel tukang kayu untuk meningkatkan kebahagiaan.";
"T_SCENARIO_2016_10_NEED_CLOTHS_DESC" = "Aku tidak punya baju. Kita perlu lebih banyak baju dan pakaian.";
"T_SCENARIO_2016_10_NEED_CLOTHS_NAME" = "Sediakan cukup banyak pakaian untuk meningkatkan kebahagiaan.";
"T_SCENARIO_2016_10_NEED_FIREWATCH_DESC" = "Tuanku, jumlah menara pemadam kebakaran tidak cukup, kita perlu bangun menara lagi.";
"T_SCENARIO_2016_10_NEED_FISH_DESC" = "Persediaan ikan pun tidak cukup di desa ini. Aku tidak mau membayar pajak!";
"T_SCENARIO_2016_10_NEED_FISH_NAME" = "Sediakan cukup banyak ikan di gudang untuk mengurangi peluang terjadinya aksi mogok.";
"T_SCENARIO_2016_10_NEED_JEWELRY_DESC" = "Aku ingin memberi kejutan kepada istriku dengan menghadiahkan perhiasan. Sayangnya aku tidak ada perhiasan di kota ini.";
"T_SCENARIO_2016_10_NEED_JEWELRY_NAME" = "Sediakan cukup banyak perhiasan untuk mencegah aksi mogok para Townie.";
"T_SCENARIO_2016_10_NEED_JOUSTING_DESC" = "Tidak banyak yang bisa dilakukan di kota. Tidak cukup banyak tempat hiburan. Sepertinya sudah waktunya menambah bangunan hiburan.";
"T_SCENARIO_2016_10_NEED_JUICE_DESC" = "Aku ingin sekali minum jus, Tuanku. Bisakah disediakan jus lagi?";
"T_SCENARIO_2016_10_NEED_JUICE_NAME" = "Sediakan cukup banyak jus untuk meningkatkan kebahagiaan dan mencegah aksi mogok.";
"T_SCENARIO_2016_10_NEED_MEAT_DESC" = "Lagi-lagi tidak ada persediaan daging di kota. Kapan kita bisa mendapat daging lagi?";
"T_SCENARIO_2016_10_NEED_MEAT_NAME" = "Sediakan cukup banyak daging untuk meningkatkan kebahagiaan dan mencegah aksi mogok.";
"T_SCENARIO_2016_10_NEED_MEDICUS_DESC" = "Gubernur, dengan begitu banyak orang di kota, aku tidak sanggup menangani semuanya. Aku butuh dukungan kalau harus mengurus mereka semua.";
"T_SCENARIO_2016_10_NEED_MEDICUS_NAME" = "Bangunlah rumah sakit untuk mencegah aksi mogok di kota.";
"T_SCENARIO_2016_10_NEED_TAVERN_DESC" = "Tidak ada tempat lagi di kedai minum. Tempatnya penuh sesak. Gubernur yang baru menghambur-hamburkan uang, bukannya memenuhi kebutuhan kita.";
"T_SCENARIO_2016_10_QUEST_00_DESC" = "Tuanku, pertama-tama kita harus mendirikan bangunan dasar untuk perekonomian kita. Aku menyarankan tambahan pondok nelayan dan sebuah penggergajian.";
"T_SCENARIO_2016_10_QUEST_00_NAME" = "Dirikan penggergajian dan pondok nelayan.";
"T_SCENARIO_2016_10_QUEST_01_DESC" = "Kita bisa membangun tambang di sekitar sini untuk mengumpulkan sumber daya dengan sangat cepat.";
"T_SCENARIO_2016_10_QUEST_01_NAME" = "Bangunlah tambang.";
"T_SCENARIO_2016_10_QUEST_02_DESC" = "Rakyat menuntut roti. Kita bisa membuatnya sendiri atau membelinya di pasar. Tapi yang jelas, kita harus memastikan persediaan roti kita selalu cukup.";
"T_SCENARIO_2016_10_QUEST_02_NAME" = "Sediakan roti dalam jumlah cukup.";
"T_SCENARIO_2016_10_QUEST_03_DESC" = "Bir saja tidak ada. Untuk apa aku membayar pajak kalau minuman sederhana seperti bir pun tidak bisa kami dapat?";
"T_SCENARIO_2016_10_QUEST_03_NAME" = "Pastikan ada persediaan bir yang cukup di gudang.";
"T_SCENARIO_2016_10_QUEST_04_DESC" = "Tuanku, orang senang makan berbagai jenis makanan. Ikan dan roti saja tidak cukup, mereka juga ingin daging.";
"T_SCENARIO_2016_10_QUEST_04_NAME" = "Pastikan persediaan daging di gudang cukup.";
"T_SCENARIO_2016_10_QUEST_05_DESC" = "Betapa senangnya kalau bisa punya baju lebih dari satu. Maukah Tuan Gubernur bermurah hati?";
"T_SCENARIO_2016_10_QUEST_05_NAME" = "Tambah persediaan baju.";
"T_SCENARIO_2016_10_QUEST_06_DESC" = "Karena kota terus tumbuh, semakin banyak bangsawan menetap di sini. Mereka ingin minum jus.";
"T_SCENARIO_2016_10_QUEST_06_NAME" = "Sediakan cukup banyak jus di gudang.";
"T_SCENARIO_2016_10_QUEST_07_DESC" = "Kota ini bagus, hanya saja kekurangan barang mewah. Maukah Tuanku berbaik hati dan menyediakan perhiasan?";
"T_SCENARIO_2016_10_QUEST_07_NAME" = "Sediakan perhiasan di gudang.";
"T_SCENARIO_2016_10_QUEST_10_DESC" = "Para Townie menuntut adanya gereja.";
"T_SCENARIO_2016_10_QUEST_11_DESC" = "Kita butuh kedai minum untuk membuat rakyat lebih bahagia, Tuanku.";
"T_SCENARIO_2016_10_QUEST_12_DESC" = "Tuanku, kita perlu membangun arena pekan raya untuk rakyat.";
"T_SCENARIO_2016_10_QUEST_13_DESC" = "Rakyat khawatir karena bahaya kebakaran. Kita perlu membangun menara pemadam kebakaran.";
"T_SCENARIO_2016_10_QUEST_14_DESC" = "Gubernur, apakah sudah ada dokter yang kompeten di kota?";
"T_SCENARIO_2016_10_QUEST_14_NAME" = "Bangunlah puskesmas";
"T_SCENARIO_2016_10_QUEST_15_DESC" = "Untuk meningkatkan kebahagiaan rakyat, kita perlu membangun arena pertarungan.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "Tuanku, kota berkembang pesat. Agar semua bangunan tetap terawat, kita perlu membuat bengkel tukang kayu.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "Kalau kita tidak bertindak untuk menghalau para bandit, mereka akan merampas rumah dan harta benda kita.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "Kita sudah punya serdadu. Aku berharap kita bisa mempertahankan kota terhadap serangan bandit.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "Tuanku, sudah waktunya memberi pelajaran kepada para bandit dan mengusir mereka dari daerah ini.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "Rupanya perlu ada tindakan yang lebih tegas. Seluruh kota mogok sekarang!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "Para Townie sedang mogok. Tunggu sampai mereka tenang lagi.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "Tuanku, ini hari yang indah, bukan?\n\nAku datang untuk bertanya apakah bisa dipastikan bahwa kota dihias cukup meriah untuk acara perayaan.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "Naikkan tingkat kepuasan dengan dekorasi kota.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "Dekorasi baru ini sangat menawan, Tuanku. Seluruh kota kelihatan semarak!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "Tuanku, para pekerja yang menyiapkan jamuan kesal karena kurangnya hiburan di antara perayaan. Aku sempat mendengar beberapa dari mereka minta tempat sirkus.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "Bangunlah tempat sirkus.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "Bagus, Tuanku! Para pekerja kembali menyiapkan perayaan. Mereka senang karena sekarang sudah ada tempat sirkus di kota.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "Badai petir ini menimbulkan kerusakan parah di kota. Kita harus memastikan semua bangunan diperbaiki secara memadai, Tuanku. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "Tingkatkan kepuasan mengenai kondisi bangunan.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "Bagus, Tuanku! Semua bangunan sudah dalam kondisi sangat baik lagi.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "Tuanku! Badai petir mengancam kota. Sebaiknya Tuanku berlindung di kastil. Sudah ada beberapa bangunan yang tersambar petir...";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "Bolehkah aku minta sedikit waktu Tuanku?\n\nDengan semua persiapan ini... jangan sampai kita lupa tujuan sebenarnya... Perayaan baru bisa berlangsung setelah panen selesai, Tuanku!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "Selesaikan panen anggur.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "Pemandangan yang indah, Tuanku. Panen sudah selesai dan persiapan untuk perayaan juga hampir rampung. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "Tuanku, kita kehabisan waktu. Sekarang sudah terlambat untuk memulai festival. Sang Raja takkan senang mendengar kabar ini...";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "Bagus sekali, Tuanku!\n\nPersiapan untuk perayaan sudah rampung. Kami tinggal menunggu perintah Tuanku untuk memulai perayaan.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = "Atas titah Raja, kuperintahkan kau untuk mengadakan perayaan setahun penuh. Di setiap musim harus ada festival untuk menghormati istri baruku!\n\nSekarang mulailah bersiap-siap! Jangan kecewakan aku...";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "Aku sangat kecewa denganmu, Gubernur!\n\nMengurus beberapa festival itu tugas sepele, tapi kau tetap gagal! Apakah permintaanku berlebihan? Sekarang enyahlah dari hadapanku!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "Siapkan semua perayaan tepat waktu!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "Gubernur! Perayaan tahun ini luar biasa.\n\nKau membuktikan bahwa kau bisa kuandalkan kalau ada tugas sulit.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "Festivalnya sukses, Tuanku!\n\nTapi sekarang kita harus memastikan persiapan festival musim gugur sesuai rencana dan rampung sebelum musim dingin tiba! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "Siapkan festival musim gugur sebelum musim dingin tiba.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "Kita harus bergerak cepat untuk menyiapkan festival musim semi, Tuanku.\n\nFestival itu harus rampung sebelum musim panas tiba dan waktu kita tidak banyak.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "Siapkan festival musim semi sebelum musim panas tiba.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "Festivalnya sukses, Tuanku!\nTapi sekarang kita harus memastikan persiapan festival musim panas sesuai rencana dan rampung sebelum musim gugur! \n\nWaktunya mendesak, Tuanku!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "Siapkan festival musim panas sebelum musim gugur tiba.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "Festivalnya sukses, Tuanku!\n\nTapi sekarang kita harus memastikan persiapan festival musim dingin sesuai rencana dan rampung sebelum musim semi tiba! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "Siapkan festival musim dingin sebelum musim gugur tiba.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "Tuanku, kusarankan kita secepatnya membangun arena pekan raya. Semua festival akan diadakan di sana.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "Bangunlah arena pekan raya.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "Bagus, Tuanku! Arena perayaan sudah siap. Bangunan ini sangat penting untuk tugas-tugas yang kita hadapi, jadi kita harus terus memperhatikannya.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "Tuanku, kita memerlukan arena pekan raya untuk mengadakan festival! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "Hal pertama yang kita perlukan adalah tiang perayaan yang sesuai, Tuanku. Penebang pohon bisa memotong pohon yang cocok. Tapi dia harus memotong banyak pohon untuk mendapatkan yang terbaik.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "Kumpulkan kayu untuk tiang perayaan.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "Tiang perayaan kita harus dihias meriah. Untuk itu kita perlu kain yang cukup, Tuanku.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "Buatlah kain untuk tiang perayaan.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "Tiang perayaan yang bagus. Tahukah kau bahwa kawan-kawanku punya tradisi mencuri tiang perayaan di daerah ini setiap tahunnya?";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "Hahaha! Tiang perayaan kalian milik kami sekarang! Ini akan jadi hiasan yang bagus di depan kamp bandit kami. Kalau berani, coba saja datang dan mengambilnya kembali...";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "Amankan tiang perayaan dari serangan bandit!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "Brengsek! Kami hampir berhasil merebut tiang perayaan kalian. Kau mempertahankannya dengan baik, Gubernur!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "Tuanku! Ada kamp bandit di dekat kota. Kita perlu lebih banyak orang dan satu menara jaga lagi untuk mengamankan desa.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "Bangunlah satu menara jaga lagi dan kerahkan cukup banyak serdadu.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "Baiklah! Sekarang serdadu kita jauh lebih mudah mempertahankan arena pekan raya kalau ada serangan bandit!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "Tiang perayaan dicuri dari gudang kita. Kita harus menyerang kamp bandit dan merebutnya kembali untuk memastikan festival bisa mulai tepat waktu.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "Serang kamp bandit dan rebut kembali tiang perayaan!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "Kita menang! Tiang perayaan sedang dibawa kembali ke gudang kita, Tuanku.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "Tuanku! Pertaniannya terbakar! Tolonglah, Tuanku harus melakukan sesuatu!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "Ini malapetaka, Gubernur! Pertanian terbakar habis dan hasil panen hancur...";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "Selamatkan pertanian!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "Aku berhutang budi selamanya, Tuanku!\n\nTapi api menghanguskan hasil panen! Masih ada kemungkinan festival terpaksa dibatalkan kalau ladang tidak dipanen secepatnya.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "Pertanian keluargaku terbakar habis, Tuanku. Aku takkan sanggup membuat roti pertama tahun ini sesuai jadwal festival. Maukah Tuanku berbaik hati dan memerintahkan pertanian dibangun kembali.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "Bangunlah pertanian baru.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "Terima kasih, Tuanku.\n\nTanpa bantuanmu, aku pasti bangkrut dan jamuan musim panas mungkin batal!\n\nTapi kita harus bergegas supaya gandum bisa dipanen tepat waktu!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "Tuanku, kita harus mengurus panen sekarang. Masih ada waktu sampai festival dimulai. Kita harus pastikan bahwa panen gandum mencukupi kebutuhan.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "Selesaikan panen gandum.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "Belakangan ini udara panas sekali, Tuanku. Mudah-mudahan tidak ada kebakaran lagi atau kekeringan yang bisa mengancam perayaan. Tapi persediaan gandum kita cukup. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "Tuanku, semua ladang kering kerontang dan sepertinya akan ada bencana kekeringan lagi pada musim panas ini. Maukah Tuanku bermurah hati dan membangun sejumlah sumur untuk mengairi ladang?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "Bangunlah sejumlah sumur untuk mengairi ladang.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "Pekerjaan yang bagus, Tuanku! Ladang-ladang sudah diairi. Sekarang kita tinggal tunggu sampai gandum tumbuh lagi. \n\nMudah-mudahan tidak terlalu lama…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "Perayaan bisa dimulai begitu kita selesai memanggang roti pertama dari hasil panen ini, Tuanku. Maukah Tuanku memastikan pemanggangan selesai tepat waktu?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "Pangganglah roti yang cukup untuk festival musim panas.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "Bagus sekali, Tuanku! Roti untuk perayaan sudah selesai dipanggang!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "Tuanku! Masih ada yang kurang untuk festival kita... kita butuh bir! Sebaiknya Tuanku perintahkan pembangunan tempat pembuatan bir di biara agar kita bisa mendapat bir buatan para rahib!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "Buatlah bir untuk festival musim panas.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "Bagus, Tuanku. Bir ini benar-benar lezat dan menyegarkan di musim panas seperti ini.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "Aku punya ide bagus untuk festival musim dingin, Tuanku. Selagi berkeliling negeri kutemukan anggur khas musim dingin yang disebut anggur hangat. Minuman itu cocok sekali untuk festival musim dingin.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "Siapkan bahan-bahan untuk membuat anggur hangat.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "Bagus sekali, Tuanku. Kita sudah punya semua bahan untuk anggur hangat. Sebaiknya kita segera mulai menyiapkannya.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "Tuanku, aku datang untuk menanyakan hiasan pohon. Akan bagus sekali kalau kita punya ornamen emas.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "Siapkan bijih emas untuk membuat hiasan.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "Luar biasa, Tuanku. Hiasan ini indah sekali. Aku mengucapkan terima kasih karena Tuanku telah meluangkan waktu membuat hiasan pohon. Aku yakin festival ini akan sangat berhasil.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "Teman-teman dan aku mau membuat sandiwara kelahiran Yesus. Sayangnya, kami masih kekurangan perlengkapan penting. Maukah Tuanku berbaik hati dan menyediakan perlengkapan itu untuk kami?";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "Siapkan perlengkapan untuk sandiwara kelahiran Yesus.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "Terima kasih, Tuanku. Sekarang kami bisa mulai membuat kostum untuk sandiwara kelahiran Yesus.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "Tuanku, aku terpikir untuk menyediakan roti jahe di perayaan kita. Tapi bahan-bahannya mungkin sulit diperoleh.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "Siapkan bahan-bahan untuk roti jahe.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "Bagus, Tuanku. Aku akan segera mulai membuat roti jahe.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "Kita tidak boleh melupakan mereka yang kekurangan. Karena itu aku mengumpulkan uang untuk kaum miskin. Alangkah baiknya kalau Tuanku mau menyumbangkan sebagian pajak kota untuk urusan ini.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "Kumpulkan pajak untuk kaum miskin.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "Terima kasih untuk sumbangan Tuanku yang dermawan!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "Gubernur,\nmohon maaf tapi aku tidak bisa mengunjungi kotamu saat ini.\nAda gerombolan bandit di hutan di sekeliling kotamu. Keadaan terlalu berbahaya untuk para pedagang keliling.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "Terima kasih banyak, Tuanku. Setelah para bandit berhasil diusir dari daerah ini, aku akan kembali mengunjungi kotamu secara teratur.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "Gedung gereja ambruk, Tuanku. Di masa sulit seperti sekarang kita butuh dukungan semua pihak. Kita harus membangun gereja baru di kota.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "Gubernur, ada yang aneh di kota ini. Dalam semusim ini saja sudah ada tujuh bencana! Kita harus cari tahu apa masalahnya. Aku mulai percaya bahwa kita kena kutukan.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "Kita harus segera meninggalkan kota, Tuanku. Semuanya sudah terlambat... Kita pasti celaka! Kutukan ini takkan pernah berakhir.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "Carilah jalan untuk mengatasi kutukan.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "Kau berhasil menyelamatkan kota! Ini berita bagus. Kutukan sudah berakhir dan kau bahkan selamat melewati upacara.\n\nTapi kota akan butuh waktu untuk pulih kembali…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "Kota butuh pasokan tanaman obat secepat mungkin, Tuanku. Kalau tidak, bahaya wabah akan terus mengintai di kota kita.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "Dapatkan tanaman obat.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "Kita takkan pernah bisa mengatasi wabah tanpa membangun setidaknya satu rumah sakit, Tuanku. Aku malah menyarankan lebih dari itu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "Para dokter di kota perlu lebih banyak material untuk perban, supaya bisa merawat para korban wabah dengan seharusnya. Kirimlah kain kepada mereka.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "Tuanku, kota tersersang wabah! Gawatnya, tidak ada yang pedagang yang mau mampir selama masih ada bencana seperti ini...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "Kita butuh kincir angin untuk mengolah gandum menjadi tepung, Tuanku. Di masa sulit ini, kita perlu menyesuaikan produksi pangan kita!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "Untuk membuat roti, kita perlu memerintahkan pembangunan toko roti, Tuanku.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "Sekarang waktunya untuk menambah persediaan roti. Kota perlu diberi makan. Jangan sampai para penduduk kelaparan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "Tuanku, ternak kita... semua hewan, dan ikan-ikan di sungai... semuanya sekarat! Ada apa ini?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "Gereja kebakaran, Gubernur! Tuhan telah berpaling dari kita! Tuanku harus membantu...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "Aku sempat membongkar arsip gereja dan menemukan dokumen yang bisa membantu kita, Tuanku.\n\nTapi sekarang gereja tidak aman dimasuki dan aku tidak bisa mengambil dokumenku.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "Terima kasih, Tuanku. Mari lihat dokumen ini. Kota kecil kita ternyata berdiri di atas bekas pemakaman kuno.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "Dulu ada penasihat khusus di istana. Dia ahli nujum, tapi juga menguasai ilmu sihir dan sebagainya. Dia menjadi gila dan berusaha meracuni Raja, sehingga dia dipenjarakan\n\nAku akan menghubungi sang Raja. Mungkin beliau mengizinkan kita bicara dengan orang itu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "Perbaiki gereja.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "Raja tidak mau membantu, jadi kita harus bergerak sendiri dan membebaskan ahli nujum itu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "Tuanku! Para Townie panik! Kita harus memamerkan kekuatan militer kita untuk menenangkan mereka.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "Gubernur, laki-laki hina dan culas itu takkan pernah keluar dari penjaraku. Aku tidak peduli tentang kutukanmu, orang itu mencoba membunuhku. Biar dia membusuk di dalam penjara.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "Persetan, Gubernur... kenapa kami diserang? Memang, kami sudah sering merampok kalian, tapi ini...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "Kami sudah lihat sendiri akibat dari kutukan itu, Gubernur. Kami para bandit tidak bisa merampok pedagang kaya selama masih ada kejadian aneh di sini.\n\nKami akan membantumu membebaskan orang itu dari penjara...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "Di dekat kota kita ada kamp bandit, Tuanku. Mungkin mereka bisa 'dibujuk' untuk membantu kita membebaskan ahli nujum itu dari penjara.\n\nOrang itu pasti tahu apa yang harus kita lakukan. Perintahkanlah serangan ke kamp itu untuk memulai... ehm 'negosiasi'.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "Kita berhasil menaklukkan para bandit, Tuanku. Sekarang mari bicara dengan mereka...\n\nMungkin mereka bisa membantu kita menangkal kutukan itu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "Sepertinya alam murka kepada kita, Tuanku. Para petani melaporkan bencana kekeringan!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "Persiapan untuk serangan ke penjara mungkin perlu perlengkapan militer, tempat latihan yang sesuai, dan juga perbekalan. Kita mulai dengan persenjataan saja, oke?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "Anak buahku perlu latihan untuk serangan ke penjara, Gubernur. Kalau memang jadi, kami perlu tempat untuk latihan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "Bangunlah arena lomba panahan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "Gubernur, sepertinya enak juga kalau ada makanan dan minuman, paling tidak untuk pemimpin serangan, yaitu AKU!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "Siapkan perbekalan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "Sudah waktunya ganti perlengkapan, Gubernur. Pedang dan kampak kayu yang biasa kami pakai takkan berguna melawan sipir penjara.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "Siapkan perlengkapan militer.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "Tuanku, mataharinya! Bakal ada gerhana! Kita harus bergerak cepat atau kita semua akan celaka!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "Bagus! Kita hampir siap untuk membebaskan orang itu dari penjara! Kali berikut kita ketemu, kau bisa bicara langsung dengan dia.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "Mungkin kau bisa membujukku kalau ada untungnya untukku. Aku sudah lama tidak makan sosis.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "Baiklah, aku akan membantumu. Kutukan ini sepertinya cukup ampuh, tapi bisa dibatalkan dengan upacara sederhana.\n\nKenapa juga kotamu harus dibangun di atas pemakaman kuno?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "Untungnya, kutukan itu bisa dibalik. Tapi kita butuh bahan-bahan yang tidak mudah didapat.\n\nKita perlu kristal kuarsa bermuatan, ramuan keabadian, dan penangkal petir.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "Gubernur, kebetulan saja aku 'ketemu' kristal kuarsa seperti itu selagi menjarah. Sayangnya, sobatku ‘si Begal’ membawanya waktu kami pecah kongsi.\n\nDia punya kamp bandit sendiri di sekitar sini.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "Dapatkan kristal kuarsa bermuatan dari kamp bandit.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "Gubernur, penangkal petir bisa dibuat dengan batang besi biasa dan beberapa peralatan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "Buatlah penangkal petir.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "Tuanku, aku bisa menyiapkan ramuan itu kalau Tuan bisa mendapatkan bahan-bahan yang diperlukan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "Dapatkan bahan-bahan ramuan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "Sekarang kau harus meminum ramuan sambil memegang penangkal petir di tangan kiri dan kristal kuarsa bermuatan di tangan kanan. Lalu kau harus berdiri di lapangan terbuka sampai penangkal petirnya disambar.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "Selenggarakanupacara.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "Tidak kusangka bahwa ternyata kau yang bakal membebaskanku dari penjara. Padahal justru gara-gara KAU aku harus masuk bui!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "Hmm, sepertinya kau kewalahan menghadapi kutukan. Dan sekarang kau mau minta bantuanku?";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "Tuanku! Kota kecil kita akan dilanda badai petir yang dahsyat. Kita harus pastikan semua menara pemadam kebakaran siap siaga!";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "Tuan Gubernur, bagiku terlalu berbahaya untuk datang ke kota Tuan. Tapi aku bisa mengatur sesuatu asal Tuan sanggup membayar...";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "Tuan sependapat, bukan, bahwa para serdadu di kota ini menghabiskan terlalu banyak sumber daya berharga? Seharusnya kami bisa menjual semuanya untuk penghasilan sampingan. Satu-satunya yang perlu dilakukan adalah mengalihkan perhatian kepala barak.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "Liburkan kepala barak.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "Alihtugaskan para pengangkut dari kastil.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "Gubernur, anak buahku perlu waktu tanpa gangguan di tembok kota. Tahu sendiri, mereka lebih suka sendirian kalau lagi "menyimpan" barang di luar tembok. Para penjaga di tembok harus ada di tempat lain.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "Alihtugaskan semua serdadu.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "Aku ada sedikit masalah dengan para warga di kota ini. Begini, kehadiran kami membantu mereka tapi mereka tidak mau membayar untuk kebaikan kami itu.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "Tarik uang keamanan.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "Gubernur, jumlah uang yang Tuan tarik sayangnya tidak cukup untuk menutup "pengeluaranku" di kota ini. Aku butuh sisa uangku kembali. Bagaimana kalau Tuan sendiri "menginvestasikan" sejumlah uang?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "Faksiku mau mengadakan turnamen judi kecil-kecilan di kedai minum malam ini, "semi legal". Bagaimana kalau Tuan mengurus hiburan di kedai minum dan mengirim bir dan jus?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = "Para "mitra bisnisku" minta makanan yang pantas selama turnamen judi berlangsung. Kirimkan sosis dan roti, biar tidak ada yang kelaparan, oke?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "Antarkan sosis dan roti.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "Gubernur, aku datang dengan satu permintaan lagi. Para tukang pukulku... ehm... maksudnya, para mitra bisnisku perlu perangkat baru untuk memperlancar pekerjaan mereka. Bagaimana kalau Tuan mengirimkan senjata dan baju zirah?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "Antarkan senjata dan baju zirah.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "Para "mitra bisnisku" perlu hiburan, Gubernur. Kami butuh kedai minum untuk bersantai sejenak. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "Selamat datang, Gubernur. Terima kasih Tuan mau bertemu denganku. Aku wakil faksi... ehm... "bayang-bayang". Kami bisa mendukung Tuan agar terpilih kembali, tapi sebelumnya ada yang harus Tuan kerjakan untuk kami.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "Tuan Gubernur telah membantu kami dan sekarang giliran kami membalas budi.\n\nSebagai imbalan atas kebaikan Tuan, aku akan mengubah hasil pemilu agar menguntungkan Tuan. ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "Selesaikan semua tugas untuk faksi bayang-bayang.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = "Pilihlah faksi bayang-bayang.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "Bekerjalah dengan klub pecinta bunga.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "Bekerjalah dengan perkumpulan saudagar.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "Pilihlah faksi militer.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "Pilihlah faksi bangsawan.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "Tuanku perlu memutuskan faksi mana yang akan Tuan dukung. Setelah menjatuhkan pilihan, Tuan harus berkonsentrasi untuk memenuhi permintaan faksi itu. Nanti kalau mereka sudah mantap memilih Tuan, Tuan bisa memilih faksi lain lagi.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "Kunjungilah faksi religius.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "Pilihlah faksi pelayan.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "Kunjungilah rakyat kecil.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "Kota ini sangat membosankan. Kelihatan sekali Tuan tidak peduli tentang detail dan keindahan. Kenapa Tuan Gubernur tidak menyiapkan rencana untuk mengubah ini?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "Siapkan lebih banyak tempat menanam bunga.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "Kenapa Tuan Gubernur jadi malas lagi? Tuan tidak melihat semua bunga sudah layu? Seharusnya Tuan lebih memperhatikan keindahan alam di sekeliling Tuan.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "Kota ini bau, Tuan Gubernur! Ini jelas salah Tuan. Saluran pembuangan air tersumbat dan airnya luber.\n\nAtasilah situasi ini!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "Bangunlah lebih banyak saluran pembuangan air.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "Kacau! Kota kita akhirnya bisa dibanggakan, bunga-bunga bermekaran, tapi ini malah begini! Coba lihat deretan rumah tinggal itu! Semuanya kumuh.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "Tuan Gubernur, ini keterlaluan!\nKumpulan hewan yang berkeliaran ini memakan sebagian besar bungaku yang paling indah. Kenapa Tuan biarkan?\n\nAku minta lebih banyak pondok pemburu sekarang juga, supaya makhluk-makhluk ini bisa disingkirkan dari kebun bungaku.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "Untuk pameran hortikultura provinsi, Tuan harus memastikan bahwa ada cukup banyak tempat untuk duduk. Beberapa bangku di berbagai sudut kota seharusnya cukup.\n\nAturlah pelaksanaannya!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "Bangunlah bangku di kota.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "Kasihanilah binatang yang malang, Gubernur.\n\nKawanan babi itu terpaksa mendekam di kandang sempit dan tidak bisa bebas berkeliaran seperti seharusnya.\n\nKlub pecinta bunga meminta Tuan segera merobohkan peternakan babi dan rumah jagal!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "Robohkan peternakan babi dan rumah jagal.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "Tuan Gubernur, aku ketua klub pecinta bunga. Tuan minta dukungan kami di pemilu mendatang. Kenapa bukan perempuan kompeten seperti aku yang dipilih sebagai gubernur kota ini?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "Meskipun aku sempat meragukan kompetensi Tuan sebagai gubernur, Tuan telah membuktikan diri sebagai sahabat sejati klub pecinta bunga.\nKami akan memilih Tuan di pemilu mendatang.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "Penuhi semua permintaan klub pecinta bunga.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "Tuanku, tidak lama lagi akan ada pemilihan gubernur baru di kota ini.\n\nAku sarankan Tuan mulai meyakinkan faksi-faksi di kota agar memilih Tuan. Sepertinya waktu yang ada tidak cukup untuk meyakinkan semuanya, jadi Tuan perlu memilih dengan cermat siapa saja yang perlu kita dukung.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "Hasil pemilu baru saja masuk, Tuanku\n\nMohon maaf, tapi sepertinya kita gagal meraih suara yang cukup dari faksi-faksi di kota.\n\nKita harus mengosongkan kastil sebelum minggu depan, ketika gubernur yang baru akan mengambil alih jabatan kita…";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "Tuanku, kita berhasil meyakinkan cukup banyak faksi di kota agar memberi suara untuk kita. Mandat kita di kota ini sudah aman.\n\nMari bersulang untuk merayakan beberapa tahun lagi di jabatan ini.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "Tuan Gubernur, hanya tinggal sedikit waktu sebelum pemilu dimulai. Kita harus bergerak cepat dan meyakinkan cukup banyak faksi agar memilih Tuan.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "Sisa waktu: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "Yakinkan paling tidak 3 faksi untuk menang pemilu.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "Tuanku, perkumpulan saudagar marah besar. Pasar kami dirobohkan dan seharusnya sudah lama dibangun kembali.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "Keterlaluan! Para Townie pengangkut terlalu banyak menumpuk barang di gedung perkumpulan saudagar. Sekarang gedungnya roboh! Bagaimana kami bisa berdagang kalau kejadian seperti ini selalu terulang.\n\nTolong bangun kembali gedung perkumpulan saudagar.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "Bangun kembali gedung perkumpulan saudagar.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "Bagus sekali, Tuanku. Sekarang kami bisa berdagang lagi. Apakah Tuan berkenan mengeluarkan perintah transaksi di perkumpulkan saudagar? Itu akan mengembalikan kota kita ke posisi seharusnya di kawasan ini.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "Siapkan perintah transaksi aktif di perkumpulan saudagar.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "Duit! Segala sesuatu ujung-ujungnya duit, Gubernur. Prioritas tertinggi kami adalah memastikan bahwa perdagangan menghasilkan untung yang cukup.\n\nMari kita cari uang, Gubernur!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "Lapak kosong di pasar tinggal sedikit, Gubernur. Ada baiknya Tuan pertimbangkan peningkatan pasar untuk menambah tempat agar kami bisa berdagang lebih efisien.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "Tingkatkan pasar.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "Banyak Townie minta disediakan kios di semua sudut kota, Tuan Gubernur. Ini bisa meningkatkan perdagangan dalam kota. Ide yang bagus, bukan?";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "Tempatkan lapak pasar di kota.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "Aku telah menyiapkan kontrak dagang yang sangat menguntungkan, Tuan Gubernur. Harga untuk pakaian dan bir meningkat pesat!\n\nAku bisa mencium uang! Uang melimpah!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "Jualan pakaian dan bir di pasar.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "Tuan Gubernur, aku wakil perkumpulan saudarar. Untuk mendapatkan suara perkumpulan kami di pemilu mendatang, Tuan harus memperbaiki perdagangan di kota ini.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "Hari ini bagus untuk berdagang, Tuanku.\n\nTuan berhasil menjadikan kota kita sebagai pusat perdagangan terbesar di kawasan ini. Perkumpulan saudagar sangat bersyukur karenanya. \n\nSebagai tanda terima kasih, kami akan memilih Tuan dalam pemilu mendatang.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "Selesaikan semua tugas untuk perkumpulan saudagar.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "Keterlaluan! Benar-benar keterlaluan!\n\nBagaimana kami bisa mengurusi menara jaga kalau barak saja tidak ada di kota ini.\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "Bangunlah barak.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "Akhirnya ada gubernur yang tahu cara mengatasi masalah. Ada baiknya Tuan menugaskan serdadu ke menara jaga.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "Sebagai komandan aku tidak mungkin mengatur pasukan lalu mencuri-curi waktu istirahat sehabis bertempur. Tubuhku yang letih berperang ini mengharapkan tenda perwira yang nyaman.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "Bangunlah tenda perwira.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "Gubernur, serdadu kita masih kurang banyak. Bandit kelas teri pun akan terpingkal-pingkal kalau melihat pasukan kita yang menyedihkan.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "Kita butuh perbekalan untuk pasukan, Gubernur. Perbekalan terbaik adalah sosis. Sosis tahan lama dan mudah dimakan di medan tempur.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "Bagaimana serdadu kita yang gagah berani bisa latihan tempur kalau tidak ada tempat latihan, Gubernur? Sebagai komandan pasukan aku minta Tuan segera membangun arena lomba panahan.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "Selamat datang, Tuan Gubernur. Tuan mengharapkan dukungan faksi militer untuk pemilu mendatang.\n\nNah, ada banyak yang perlu dilakukan untuk meyakinkan kami agar memilih Tuan.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "Terima kasih banyak, Tuan Gubernur. Sebagai prajurit kami bangga atas sepak terjang Tuan. Pihak militer di kota ini tidak pernah segagah sekarang sebelum Tuan menjadi Gubernur. Kami pasti akan memilih Tuan.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "Selesaikan semua tugas untuk faksi militer.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "Kota besar tidak pantas membatasi minuman untuk para warga, Tuanku. Terutama kami kaum bangsawan ingin sesuatu yang istimewa seperti jus anggur.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "Kaum bangsawan merayakan rantai produksi terbaru yang sudah siap beroperasi, Tuanku.\n\nUntuk perayaannya kita perlu jus anggur dalam jumlah besar. Tapi tolong jangan yang murahan…";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "Tuanku, masa kami disuruh pergi ke kedai minum seperti orang kebanyakan. Tempat turnamen di luar tembok kota sudah lama terbengkalai.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "Seorang pahlawan kaum bangsawan baru saja wafat, Tuanku. Jika Tuan mau membangun monumen dan tempat peristirahatan terakhir yang layak, Tuan akan membuat senang banyak bangsawan di kota itu.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "Bangunlah mausoleum dan patung pahlawan.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "Tuanku, kota ini kekurangan barang berharga untuk kaum bangsawan. Orang tidak bisa memperlihatkan statusnya tanpa perhiasan yang bernilai tinggi, Tuanku.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "Bagus sekali, Tuanku. Permintaan akan perhiasan lagi sangat tinggi sekarang ini. Semua orang mendambakan perhiasan seperti yang biasa dipakai di istana.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "Syukurlah kita akhirnya bisa bertemu, Tuanku. Aku mewakili faksi bangsawan di kota Tuan. Kalau Tuan menginginkan suara kami di pemilu mendatang, Tuan harus memenuhi aneka permintaan kami.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "Tuanku benar-benar memenuhi semua permintaan kaum bangsawan! Di kota Tuan para bangsawan mendapat hak istimewa yang sama seperti di istana kerajaan!\n\nKami pasti akan mendukung Tuan di pemilu mendatang.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "Penuhi semua permintaan kaum bangsawan.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "Komunitas religius kami terus menciut. Penduduk sibuk minum-minum atau berpesta pora. Ini harus diakhiri.\n\nKedai minum itu sumber masalahnya. Tuan harus merobohkannya! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "Bagus! Tempat maksiat itu seharusnya sudah lama dirobohkan. Akhirnya ada yang berani melakukannya.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "Robohkan kedai minum.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "Gereja kami tidak mampu menampung semua orang yang baru tobat. Setelah kedai minum dirobohkan, gereja selalu penuh sesak.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "Puji Tuhan, betapa megah gereja yang baru ini. Pembantu Raja sungguh berhati mulia.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "Tingkatkan gereja atau bangun gereja baru.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "Komunitas religius kami tidak puas dengan kesempatan beribadah di kota ini. Kepuasan warga mengenai agama harus ditingkatkan!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "Pembantu raja berhasil. Kepercayaanku ternyata tidak salah alamat. Kau berhasil membuat komunitas religius kembali senang.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "Rekan-rekan rahib mengeluhkan rendahnya produksi hop di kota. Kami para biarawan tidak bisa membuat bir tanpa persediaan hop yang cukup.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "Bangunlah tempat pengeringan hop.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "Berhubung produksi hop sudah pulih lagi, ada baiknya produksi bir juga digiatkan.\n\nTingkatkanlah biara. Atau bangunlah biara baru.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "Biara yang baru ini berkilau dalam cahaya Tuhan. Selamat, Tuan Gubernur.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "Tingkatkan biara atau bangun biara baru.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "Untuk acara peresmian biara baru, sebaiknya kita memproduksi bir dalam jumlah yang cukup. Para tamu tentu akan haus.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "Proses pembuatan bir sudah selesai, Tuan Gubernur. Tuan berkenan menjadi orang pertama yang mencicipi bir kami?";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "Tempat pemakaman kota terlalu kecil untuk menambah makam. Tuan perlu memerintahkan pembangunan beberapa mausoleum dan tempat pekuburan.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "Perbesar tempat pemakaman: Bangunlah mausoleum dan makam.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "Perluasan tempat pemakaman harus termasuk pembangunan tembok baru untuk batas pemakaman. Tuan perlu memerintahkan pembangunan tembok baru agar batas pemakaman menjadi jelas.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "Bangunlah tembok pembatas pemakaman yang baru.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "Selamat datang, Gubernur. Kami para biksu dari faksi religius siap mendukung Tuan di pemilu mendatang, kalau Tuan memenuhi permintaan kami.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "Puji Tuhan, Tuan Gubernur. Tuan telah memenuhi semua permintaan kami. Tuan telah mengamankan tempat di surga, dan suara faksi religius sudah pasti menjadi milik Tuan.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "Selesaikan semua tugas untuk faksi religius.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "Tuanku, kemampuan para petugas pemadam kebakaran untuk melawan si jago merah di kota ini sangat terbatas. Akan sangat membantu andai kata ada lebih banyak menara pemadam kebakaran.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "Beberapa anggota faksi pelayan akan senang kalau ada tempat sirkus di kota. Dengan begitu kami pun bisa terhibur.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "Tuan Gubernur yang terhormat, kami para Townie pengangkut kewalahan dengan semua tugas pengangkutan di kota. Akan sangat membantu kalau Tuan mau memerintahkan pembangunan gudang tambahan.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "Tuanku, para tukang kayu mengeluhkan pakaian mereka. Pekerjaan reparasi di seluruh kota membuat pakaian mereka cepat rusak. Mereka benar-benar memerlukan pakaian baru.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "Antarkan pakaian.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "Tuanku, para Townie pengangkut butuh sepatu baru. Tuan tidak perlu menyediakan sepatu, kami bisa membuatnya sendiri.\n\nKami hanya butuh kulit dan kain.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "Antarkan kain dan kulit.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "Tuanku, sumbangan sekadarnya untuk faksi pelayan akan membuat kami yakin sepenuhnya bahwa Tuanku gubernur paling murah hati sepanjang zaman.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "Sumbangkan uang untuk para pelayan.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "Tuan Gubernur, ada baiknya penarik pajak diberi libur. Dia tidak muda lagi dan tulang-tulangnya sudah ngilu semua.\n\nTuanku sanggup menarik pajak sendiri selama beberapa waktu, bukan?";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "Liburkan penarik pajak dan tarik pajak sendiri.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "Tuanku, aku wakil faksi pelayan di kota ini.\n\nKami bekerja sebagai pengangkut, petugas pemadam kebakaran, tukang kayu dan penarik pajak. Berhubung kami punya hak suara dalam pemilu, Tuan sebaiknya "merayu" kami dengan membuat hidup kami sedikit lebih nyaman.";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "Tuanku sudah berbuat banyak untuk kami para pelayan. Ini zaman keemasan bagi kami. Tidak pernah terbayangkan bahwa Tuan benar-benar akan meningkatkan taraf hidup kami di kota ini.\n\nSuara kami akan menjadi milik Tuan dalam pemilu nanti!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "Selesaikan semua tugas untuk faksi pelayan.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "Tuanku! Wabah semakin menyebar di kota! Tolong, selamatkan kami! Anak-anakku ada di bagian kota yang terserang dan kami tidak punya rumah sakit.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "Tuan Gubernur, pasokan pangan di kota kita tidak memadai. Para petani melaporkan bahwa kita kekurangan bangunan penting. Sebaiknya Tuan segera memerintahkan pembangunan pertanian dan toko roti.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "Bangunlah pertanian dan toko roti.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "Tuanku, kami rakyat kecil jarang bisa tertawa dan rutinitas sehari-hari kami meletihkan. Kami akan senang sekali kalau ada tempat di mana kami bisa melupakan segala masalah. Arena pekan raya cocok sekali untuk itu.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "Tuanku, sebagian warga hidup dalam kemiskinan. Tuan bisa menaikkan reputasi kalau mengembalikan sebagian pajak kepada rakyat.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "Kembalikan sebagian pajak kepada rakyat.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "Setelah menambah prasarana yang diperlukan, kita juga perlu menambah pilihan pangan untuk rakyat. Sebagian besar Townie yang hidup miskin tidak mampu membeli daging. Tuan bisa mengubah ini.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_TITLE" = "Antarkan daging.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_DESC" = "Tuanku, kami memanen gandum, menggilingnya, lalu membuat roti. Tapi rotinya jarang mampir di piring kami untuk dimakan.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_TITLE" = "Antarkan roti.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_07_DESC" = "Tuanku, kami nyaris sepenuhnya mendukung Tuan. Tinggal satu hal terakhir yang perlu Tuan lakukan, yaitu membuat semua penduduk kota bahagia. Kami akan berterima kasih dengan menjadi lebih produktif lagi.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_START" = "Selamat datang, Tuan Gubernur. Sebagai tukang giling gandum aku penyambung lidah para petani. Jika Tuan bisa mempermudah hidup kami di kota ini, kami akan memilih Tuan dalam pemilu berikut.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_SUCCESS" = "Tuan benar-benar pembela orang kecil. Tuan membantu rakyat kebanyakan dengan menyelesaikan semua tugas kami. Hidup kami di kota jadi lebih mudah sekarang. Terima kasih, Tuanku.\n\nTuan bisa mengandalkan suara kami dalam pemilu mendatang.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_TITLE" = "Selesaikan semua tugas untuk para petani.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_DESC" = "Tuanku, perekonomian kita tidak mampu mendukung tukang kayu. Kita tidak memiliki sumber daya yang diperlukan. Sebaiknya tukang kayu dialihtugaskan untuk sementara waktu.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_TITLE" = "Alihtugaskan tukang kayu.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_02_DESC" = "Produksi pangan kita tidak mencukupi, Tuanku. Ada baiknya kita membangun lebih banyak pondok nelayan.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_03_DESC" = "Sebelum kita memilih salah satu faksi kota, Tuan perlu memerintahkan pembangunan penggergajian. Ini penting untuk memajukan perekonomian kota, Tuanku.";
"T_SCENARIO_7_QUEST_INTRO_DESC" = "Pelayanku yang baik, putriku akan menikahi Pangeran William Clemens III dari Giebelstadt. Aku ingin kau tangani seluruh persiapan bagi peristiwa penting ini. Anda tidak punya banyak waktu, jadi bergegaslah. Saya percaya Anda sepenuhnya!";
"T_SCENARIO_7_QUEST_INTRO_NAME" = "Lakukan persiapan untuk pesta besar dengan menyelesaikan seluruh tugas!";
"T_SCENARIO_7_QUEST_OUTRO_DESC" = "Terima kasih atas kerja hebat Anda! Anda bekerja sangat baik, pernikahannya dapat dimulai sekarang! Dan, tentu saja, Anda diundang!";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_DESC" = "Kaum bandit akan segera melancarkan serangan. Kita harus bersiap-siap. Tempatkan orang di menara-menara jaga.";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_NAME" = "Gerombolan bandit siap menyerang!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_DESC" = "Tuanku, perekonomian kota terpuruk akibat serangan bandit yang tanpa henti. Semoga kita bisa bertahan selama pengepungan berlangsung.";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_END" = "Bagus sekali, Tuanku! Tuan menangani pengepungan dengan baik dan bahkan berhasil menggiatkan perekonomian. Sang ksatria pun tampak terkesan. ";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_NAME" = "Bangunlah prasarana sambil mempertahankan kota.";
"T_SCENARIO_BESIEGEMENT_QUEST_01_DESC" = "Hanya seorang gubernur dan penasihatnya? Bukan itu bantuan yang kuharapkan. Aku sangsi kalian banyak gunanya menghadapi kaum bandit. Yang lain segera angkat senjata semua!";
"T_SCENARIO_BESIEGEMENT_QUEST_01_END" = "Gelombang serangan bandit berhasil dihalau. Sekarang kita bisa melepas lelah sejenak, sampai pengintai melaporkan serangan berikut.";
"T_SCENARIO_BESIEGEMENT_QUEST_02_2_DESC" = "Kita perlu lebih banyak menara jaga untuk mempertahankan kota. Segeralah mulai membangun menara!";
"T_SCENARIO_BESIEGEMENT_QUEST_02_DESC" = "Gubernur, cobalah berguna sedikit dan perintahkan pembangunan lebih banyak menara jaga.";
"T_SCENARIO_BESIEGEMENT_QUEST_03_DESC" = "Barak kita roboh dan kita harus membangun yang baru. Mestinya kau bisa mengerjakan tugas ini, Gubernur.";
"T_SCENARIO_BESIEGEMENT_QUEST_04_DESC" = "Aku sarankan kita mengutus kurir kepada sang Raja, Tuanku. Tapi kita perlu penyamaran. Kita mulai dengan beberapa potong kain.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_DESC" = "Sekarang kita perlu kulit untuk menyempurnakan penyamaran. Supaya semakin mirip dengan pakaian bandit.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_NAME" = "Antarkan kulit.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_DESC" = "Untuk janggut kita perlu wol. Semoga ini menambah peluang kurir untuk sampai ke hadapan Raja.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_NAME" = "Antarkan wol.";
"T_SCENARIO_BESIEGEMENT_QUEST_07_DESC" = "Kita tidak bisa hanya duduk dan menanti bantuan Raja. Baju tempur pasukan penjaga kota dalam kondisi buruk. Kita harus membuat baju tempur baru agar mampu mempertahankan kota. ";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_DESC" = "Ya ampun, Tuanku. Mereka menghancurkan barak. Kita harus membangunnya kembali agar bisa memasok serdadu kita.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_NAME" = "Bangun kembali barak.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_DESC" = "Gerombolan bandit sedang bersiap menggempur barak kita. Barak sangat penting dan tidak boleh hancur!";
"T_SCENARIO_BESIEGEMENT_QUEST_08_NAME" = "Pertahankan barak.";
"T_SCENARIO_BESIEGEMENT_QUEST_09_DESC" = "Pasukan Raja belum tiba juga. Kita tidak bisa menunggu lebih lama. Untuk itu kita perlu pedang-pedang paling tajam yang bisa kita buat, atau kota akan jatuh.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_DESC" = "Tuan Gubernur, kamp bandit di sebelah tenggara menutup jalan ke kota-kota lain. Kalau kita mengharapkan bantuan lebih banyak townie, kita harus menghancurkan kamp di sebelah tenggara itu.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_END" = "Kamp bandit berhasil dihancurkan! Semakin banyak townie yang bisa membantu kita sekarang.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "Hancurkan kamp bandit sebelah tenggara.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "Kami berhasil menemukan si pedagang, Tuanku. Dia ditawan di kamp di dekat sungai di sebelah barat laut.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "Tuanku, sang pedagang sudah aman lagi. Mulai sekarang dia akan kembali mengunjungi kita secara berkala.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_NAME" = "Hancurkan kamp bandit di sebelah barat laut.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_DESC" = "Tuanku, kaum bandit membawa rabuk dari kamp di pegunungan di sebelah timur laut. Kalau kita menghancurkannya, mereka takkan bisa lagi membakar bangunan-bangunan kita.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_NAME" = "Hancurkan kamp bandit sebelah timur laut.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_DESC" = "Kamp bandit utama ada di sebelah barat daya. Ayo kita hancurkan dan kita paksa mereka untuk menyerah. Serbu!";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_NAME" = "Hancurkan kamp bandit sebelah barat daya.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_DESC" = "Betapa kasar ksatria itu. Tuanku, perekonomian kota bisa dibilang hancur. Setelah serdadu kita berhasil menghalau gelombang pertama serangan para bandit, kita perlu memerintahkan penduduk untuk membuat beberapa sumber daya pokok.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_NAME" = "Buatlah papan kayu.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_02_DESC" = "Baiklah, Tuanku. Sebaiknya kita mulai dengan membangun kembali pertanian, sebab persediaan makanan kita sudah menipis.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_DESC" = "Sekarang kita bisa membuat roti lagi. Tapi kita perlu berjaga-jaga terhadap serangan bandit dan memberlakukan wajib militer, kalau diperlukan.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_NAME" = "Buatlah roti.";
