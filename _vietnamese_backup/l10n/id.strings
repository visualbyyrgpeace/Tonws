"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Dengan senang hati, Tuanku. Kirimkan emasnya, dan aku akan melihat apakah bisa mengusahakan lebih banyak lagi.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Tukar emas dengan gandum.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Aku mendengar tentang nasib buruk kalian dan mau menawarkan barter. Aku masih punya cadangan gandum untuk ditukar dengan barang lain.";
"T_GAME_QUEST_SCEN16_12_START" = "Aku mau menukar batu dengan gandum.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Sepertinya barangmu cukup untuk barter. Mudah-mudahan ada kesempatan lagi di masa mendatang.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Tukar batu dengan gandum.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Apa kau pernah mencoba roti buatan keponakanku? Kau harus mencobanya! Dan katakan padanya untuk membuat cukup roti hingga musim dingin!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Buat 50 potong roti.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Membangun penenun.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Membangun penjahit.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Katakan, apa kau kedinginan seperti kami? Istriku bahkan terkena flu karena semua lubang di pakaiannya itu. Bisakah Anda membantu kami membuat beberapa baju hangat?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Bangun padang domba.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Saya kira persiapan kota ini sudah hampir sempurna untuk musim dingin mendatang! Namun, ini antara kita berdua saja, bukankah mengasyikkan jika kita bisa menikmati segelas jus di kedai saat di luar sangat dingin?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Bangun pabrik jus dan hasilkan 50 kendi jus.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Tuanku, bukan saya bermaksud tidak sopan namun kita kekurangan perkebunan! Bagaimana mungkin kita mampu memanen semua gandum tepat waktu sebelum musim dingin tiba?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Bangunlah 2 perkebunan.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrrr, aku sudah kedinginan, Tuanku! Saya yakin musim dingin kali ini akan sangat dingin! Saya dan Istri saya berharap Anda tidak lupa untuk memastikan terdapat cukup kayu bakar!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Bangunlah 3 pondok rimbawan.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Terima kasih! Kirimakan salamku pada saudara-saudaraku, jika kau bertemu mereka! Katakan bahwa mereka harus mengumpulkan kayu sebanyak mungkin!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Kumpulkan 35 kayu.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Akhirnya kita bisa memulai panen! Saya harap ini akan memenuhi kebutuhan kita!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Panen 35 gandum.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Sungguh panen yang melimpah! Kita bahkan tidak tahu di mana harus menimpan semua gandum itu! Alangkah baiknya untuk membuat roti dari beberapa gandum itu!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Bangunlah kincir angin dan hasilkan tepung.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Tuanku, kami sangat senang tinggal di sini namun kami cemas rumah kami tidak akan bertahan dari musim dingin yang akan tiba...";
"T_GAME_QUEST_SCEN2_6_NAME" = "Jagalah agar kondisi semua rumah tetap baik.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Saya masih khawatir tentang sesuatu... sayang sekali, kita tidak memiliki persediaan peralatan. Saya yakin Anda tahu betapa pentingnya peralatan untuk memperbaiki bangunan! Bisakah Anda memberikan beberapa peralatan untuk kami?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Kirimkan upeti 50 peralatan.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Saya khawatir semua saudaraku tidak mampu menyelesaikan semua pekerjaan mereka... mungkin Anda bisa mencari tambahan pekerja untuk desa kita?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Tingkatkan populasi hingga 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Air di hidung saya sudah mulai membeku... namun beberapa pengelana yang mencari tempat tinggal kondisinya lebih buruk lagi. Sebaiknya kita izinkan mereka tinggal di desa kita!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Bangun 6 rumah.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Sayang, jangan sampai kau lupa kalau besok adalah ulang tahun pernikahan kita! Aku sangat menginginkan perhiasan baru! Seandainya saja kau kenal pengrajin emas...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Bangun pengrajin emas.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Aku yakin raja dan para Townie akan senang sekali dengan peralatan baru! Peralatan yang lama telah berkarat dan tidak berfungsi!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Bangun bengkel peralatan.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Bangun kedai penjahit dan hasilkan pakaian.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Oh, lihatlah domba yang lucu itu! Sayang, apa kau melihatnya? Dan liat semua wool yang sudah dihasilkan dari domba-domba itu! Sekarang kita hanya butuh penenunan dan toko penjahit!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Bangunlah pabrik tenun dan hasilkan kain yang cukup.";
"T_GAME_QUEST_SCEN3_13_DESC" = "Anak-anak sangat keasyikan dan menanti semua roti yang akan segera mereka dapatkan! Bukankan kau sudah membangun beberapa toko roti? Sayang?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Coba tebak! Saudaraku akhirnya akan menikah! Namun kita membutuhkan gereja di kota kita! Bukan hanya untuk pernikahan namun juga untuk Townie yang saleh!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Capai keyakinan religi yang tinggi.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Sekarang lihatlah, sayang! Kota telah pulih dan semuanya berjalan dengan lancar! Jadi kau kuizinkan bersantai bersama teman-temanmu dan membangun kedai, jika kau mau! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "Capai kepuasan yang tinggi dengan beberapa bar.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Sayang, lihatlah desa yang sekarat ini... para Townie malang, sungguh kasihan mereka! Kukira kamu harus meminta bantuan raja! Mungkin kamu bisa meyakinkannya dengan mengirim beberapa hadiah!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Kirimkan gelar ke raja dan penuhi semua tugas.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Kamu harus mengatasi masalah sendiri hingga raja mengirim bantuan! Townie sangat membutuhkan lebih banyak air!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Bangunlah sumur di desamu.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Nenek moyangmu bahkan tidak mampu memenuhi kebutuhan pangan! Sangat tidak bisa dipercaya! Sayang, kau harus segera mengatasi ini! Kenapa tidak kau bangun pondok nelayan?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Bangunlah 2 pondok nelayan.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Anak-anak malang itu... sayang, kita tidak bisa hanya memberi mereka ikan! Kau harus membangun perkebunan, jadi kita bisa memanen gandum untuk tepung dan roti!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Bangunlah 2 lahan pertanian dan hasilkan gandum.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Bangunlah smelter.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Hei, sayang, tidakkah kau lupa sesuatu? Bukankah kau berencana mengirim hadiah untuk raja untuk meyakinkannya untuk membantu kita? Sungguh beruntung kau memilikiku... kita tentu membutuhkan tambang dan smelter sebelum kita bisa menghasilkan sesuatu yang berharga!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Bangunlah sebuah tambang.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Semua Townie kelelahan bekerja! Bisakah kau bangun beberapa rumah untuk menarik lebih banyak pekerja?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Bangun 3 rumah.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Oh, aku sangat senang! Kondisi semakin membaik dan terus membaik! Bahkan sekarang kita bisa mulai mengumpulkan lebih banyak pajak dari Townie!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Kumpulkan 1500 Thaler pajak.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Kumpulkanlah cukup banyak Thaler lewat pajak.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Tahukah kau apa yang akan lebih baik lagi untuk dimiliki? Beberapa pakaian! Maksudku, utamanya untuk raja, tentunya... tapi kita membutuhkan beberapa padang domba jadi kita memanen wool!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Bangun 2 padang domba.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Para petani sudah bekerja sangat keras dalam memanen gandum! Sekarang kau bisa membangun kincir angin jadi kita bisa menghasilkan tepung untuk roti!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Bangun kincir angin dan hasilkan tepung.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Istanaku tidak benar-benar sesuai untuk status kebangsawananku, jadi aku berencana memperluas perkebunan musim panas. \n\nSebagai rajamu, aku perintahkan pengiriman banyak batu. Aku percaya keandalanmu, pengawalku yang baik.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Kirimkan sekeranjang batu ke raja.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Panas yang melepuh telah mengambil tol di rumah kami. Rumah telah rusak dan banyak keluarga menuntut agar Anda meningkatkan kondisi bangunan.\n\nSangat baik jika Anda mempertimbangkan peningkatkan kondisi bangunan sekitar kota.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Capai kebahagiaan kondisi bangunan tinggi.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Paduka yang mulia, hamba masih menunggu pengiriman jus anggur. Jamuan yang saya adakan akan segera dimulai.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Berikan jus anggur kepada raja.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Yang Mulia, tepung sangat dibutuhkan di seluruh kerajaan. Ladang tidak dapat menghasilkan cukup gandum agar penggilingan dapat bekerja pada kapasitas penuh.\n\nSeandainya Anda mengirimkan cukup tepung kepada saya, saya dapat menyudutkan pasar dan membangun monopoli di wilayah ini. Tentu saja, saya akan menghadiahkan kepada Anda banyak laba.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Berikan tepung kepada pedagang.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Penduduk Kota ingin membangun tempat bernaung dari matahari untuk melindungi mereka agar tidak hangus terbakar matahari sepanjang hari. Kita harus memberi mereka papan kayu tebal, jadi mereka dapat segera mulai!";
"T_GAME_QUEST_SCEN4_14_NAME" = "Buat 35 papan tebal.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Yang Mulia, Anda telah bekerja dengan baik. Ukuran kota tumbuh sangat mengagumkan.\n\nTetapi, Penduduk Kota masih tidak senang karena kemarau. Anda harus mencoba menaikkan kebahagiaan dengan memenuhi lebih banyak harapan mereka. Tentu saja, ini hanya usulan sederhana.";
"T_GAME_QUEST_SCEN4_15_NAME" = "Capai kebahagiaan tinggi di kota Anda.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Benar-benar mengagumkan, Paduka Yang Mulia!\nWalaupun kemarau, Anda telah menyelesaikan pembangunan kota yang besar. Penduduk Kota Anda benar-benar senang dengan perubahan yang Anda lakukan.\n\nSebagai raja, aku sangat senang dengan pekerjaanmu. Kau telah bekerja dengan hebat di bidang itu dan kau akan diberi hadian.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Yang Mulia, Penduduk Kota hidup dalam kemiskinan dan kesengsaraan. Negeri ini menderita karena kemarau. Lihatlah sungai yang dulu cemerlang ini mengalir tepat di samping istana Anda. Hanya tersisa sedikit genangan air...\n\nRaja telah menugaskan kita untuk memperluas kota. Mari mulai dengan membangun beberapa rumah lagi.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Bangun 8 rumah lagi.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Paduka, raja sangat senang mendengar kesuksesan perluasan kota, tapi beliau memerintahkan kita membangun kota yang lebih besar.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Capai total penduduk 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Paduka Yang Mulia, sebagai pedagang, saya bisa menjadi bantuan penting dalam kesulitan Anda. \n\nKerajaan mungkin menderita karena kemarau, tapi saya dapat memberikan banyak persediaan yang dibutuhkan bagi kota Anda segera setelah Anda membangun pasar.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Dapatkan kebahagiaan tinggi di pasar.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Yang Mulia, saya mohon perintahkan pembangunan sumur tambahan untuk memberikan cukup air bagi penduduk dalam situasi panas ini.";
"T_GAME_QUEST_SCEN4_3_NAME" = "Bangun 2 sumur.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Saya membawa berita baik, Paduka. Seorang Penduduk Kota menemukan bahwa genangan air di dasar sungai yang kering masih ada ikannya. \n\nKita harus memerintahkan pembuatan beberapa pondok nelayan.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Bangun 2 pondok nelayan.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Paduka Yang Mulia, saya ingin mengajukan usul.\n\nJika kita dapat memperluas hubungan dagang, saya dapat mengatur pengiriman makanan secara teratur ke kota Anda.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Dapatkan laba 1000 Thaler dari penjualan di pasar.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Sekali lagi, saya datang ke hadapan Anda dengan suatu usul. Saya sangat membutuhkan batu bara. Berikan kepada saya batu bara dan saya akan membayarnya dengan sekantung besar Thaler.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Berikan batu bara kepada pedagang.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Paduka, pengadilan saya sangat membutuhkan jus anggur. Kemarau masih menyengsarakan kerajaan saya dan telah memusnahkan panen anggur kami.\n\nSaya perintahkan untuk membangun pabrik jus. Saya berencana segera mengadakan jamuan di istana, jadi jangan mengecewakanku!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Bangunlah pabrik jus dan hasilkan jus.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Yang Mulia, keluarga hamba hampir tidak menggarap tanah kering ini. Panennya akan buruk, jadi ladang tidak akan cukup.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Bangun ladang lagi.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Persediaan roti kita sangat sedikit, Paduka. Kita harus mengurangi konsumsi roti dengan memberikan lebih banyak ikan.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Hasilkan cukup daging.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Selesaikan semua tugas, atasi kemarau dan tumbuhkan kota Anda menjadi kota besar!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Sekarang, hanya kurang satu hal, Paduka, dan itu adalah jus anggur untuk merayakan kemenangan kita!\n\nMohon berikan jus anggur yang berlimpah ke perkemahan tentara!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Berikan 45 jus anggur kepada kesatria.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Benar-benar luar biasa, Paduka!\nLord Blankenstein berhasil menyelesaikan kampanye dan berbicara sangat tinggi tentang Anda dan dukungan Anda.\n\nAnda ingin membuat satu perdagangan terakhir sebelum saya meninggalkan wilayah ini?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Dapatkan laba 2500 Thaler melalui perdagangan.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Pagi yang indah, paduka. Saya punya kabar yang bagus. Kita telah dihubungi pedagang.\n\nIa akan mengunjungi kota kita dan membutuhkan papan kayu untuk membangun stan pasar.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Buat 30 papan tebal.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Yang Mulia, Paduka telah membuat pos dagang kecil yang baik di sini. Tapi, pos ini kekurangan satu hal penting, yakni kedai minuman. Seandainya ktia membangun kedai minuman, kota kecil kita akan menarik lebih banyak pedagang dan pelancong.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Capai kepuasan yang tinggi dengan beberapa bar.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Sangat baik, Paduka. Kedai minuman itu akan membuka banyak peluang dagang di masa mendatang.\nSekarang mari kita masuk ke bagian menarik dari persiapan kita. Mari tukar beberapa barang... ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Dapatkan laba 1500 Thaler melalui perdagangan.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Sudikah Anda memberikan kain juga, Paduka? Saya memiliki mitra dagang yang sangat tertarik dengan kain.\n\nSaya juga bertemu kesatria di perjalanan. Dia sedang menuju ke sini dan mungkin memiliki tugas menarik bagi Anda.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Simpan 35 unit kain di gudang.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Paduka! Saya Kunibert von Blankenstein, kesatria raja yang setia.\n\nPos dagang Anda sangat cocok membantu pencarian saya untuk menggerakkan penjahat dari tanah ini. Maukah Anda memberi saya batu sehingga saya dapat membangun menara pengawas untuk melindungi wilayah ini?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Berikan 50 batu kepada kesatria.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Paduka Yang Mulia, tempat pembuatan senjata sangat memerlukan besi untuk memberikan pedang kepada tentara.\n\nAda beberapa endapan bijih dekat pos dagang Anda. Dapatkah Anda berikan besi kepada pelayan saya?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Berikan 65 besi kepada kesatria.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Saya menghadapi masalah, Yang Mulia. Beberapa baju zirah prajurit pejalan kaki rusak selama pertempuran terakhir melawan penjahat. \n\nHarap berikan juga alat sehingga para prajurit dapat memperbaiki baju zirahnya saat mengunjungi pos dagang.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Buat 25 alat.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Saya membawa berita baik, Paduka! Kampanye saya sukses besar dan para penjahat telah terusir dari wilayah ini.\n\nSelama kampanye panjang ini, kami telah membelanjakan seluruh persediaan. Saya perlu memberi makanan kepada tentara.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Berikan 25 ikan dan 25 roti kepada kesatria.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Pasukanku mau merayakan kemenangan atas gerombolan bandit, tapi setelah para bandit berhasil dikalahkan, anak buahku malah gelisah. \n\nMaukah Tuanku membangun tempat hiburan di kota?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Pasukan saya ingin merayakan kemenangan terhadap penjahat, tapi sekarang para penjahat telah dikalahkan, pasukan saya menjadi risau. \n\nBersediakah Anda membangun tempat latihan adu tombak berkuda sehingga para prajurit dapat berlatih, Paduka?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Capai kepuasan yang tinggi dengan arena adu tombak.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Bangun pos perdagangan yang sukses dengan menyelesaikan semua tugas!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Bagus sekali, Paduka. \nAnda berhasil mendirikan pos dagang dalam lokasi penting strategis ini. Raja dan Lord Blankenstein sangat senang dengan pekerjaan dan dukungan Anda terhadap kampanye melawan bandit di wilayah ini.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Raja telah mengirimkan perintah! Dia meminta material yang sangat banyak untuk membangun katedral! Pembangunan gedung monumental ini telah dimulai, jadi kita harus memberikan sumber daya secepat mungkin.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Berikan sumber daya untuk pembangunan katedral.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Tukar wol dengan ikan.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Tukar bijih besi dengan ikan.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Tukar jus anggur dengan ikan.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Tukar bijih emas dengan ikan.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Tukar papan kayu tebal dengan ikan.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Saya tidak melihat danau atau sungai di dekatnya, jadi Anda tidak dapat menghasilkan ikan. Bangun pasar dan saya dapat menjual ikan dengan penukar berbagai barang!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Bangun 2 tambang lagi.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Bangun 3 tambang lagi.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Kita harus segera mulai menambang! Pastikan bahwa kita memiliki cukup tambang yang berproduksi sehingga dapat memenuhi jadwal pengiriman.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Bangun satu tambang.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Penduduk Kota Anda bekerja sekeras mungkin untuk menambang seluruh bijih itu! Pastikan Anda memberi mereka cukup makanan agar mereka tetap segar bekerja!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Bangun toko pembuat roti.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Kita bekerja dengan baik, tapi kita masih harus melebur bijih tersebut!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Bangun 2 tempat peleburan.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Bekerja di tambang yang gelap dan lembap tanpa pakaian yang memadai bisa jadi sangat tak nyaman! Anda harus memberikan pakaian hangat kepada Penduduk Kota. Saya yakin mereka akan sangat menghargainya!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Berikan 25 potong pakaian.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Yang Mulia, kita menghasilkan sumber daya yang sangat banyak! Kita perlu membangun gudang lagi untuk menyimpan seluruh sumber daya ini!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Bangun 2 gudang.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Bekerja di tambang adalah kerja keras! Penduduk Kota Anda ingin memiliki tempat bersantai setelah kerja keras seharian. Kedai minuman sangat tepat untuk in! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "Bangun kedai minuman.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Hebat! Anda bekerja dengan hebat mengirimkan seluruh sumber daya yang dibutuhkan untuk katedral! Meski, pembangunan perlu sedikit waktu.\n\nKatedral akan mengenang raja kita yang hebat, yang tindakannya telah membawa masa damai dan selaras yang akan berlangsung selama berabad-abad!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Ingat, Anda dapat menyingkirkan pohon yang menghalangi! Gunakan sekop untuk menandai pohon yang ingin disingkirkan.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Paduka Yang Mulia, kita tidak dapat membuat kue pengantin tanpa resep yang benar! Apakah Paduka bersedia membangun ladang sehingga kami dapat membuat tepung sendiri?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Bangun ladang.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Bangun kincir angin.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Buat 25 roti.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "Ini akan menjadi pernikahan yang mengagumkan! Pertama, kita perlu memastikan bahwa kita memiliki kue pengantin yang luar biasa. Dapatkah Anda buatkan toko pembuat roti saat saya memilih baju pengantin?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Bangun toko pembuat roti.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Hamba perlu pasar sehingga dapat menjual semua hadiah pernikahan yang tidak saya suka!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Dapatkan kebahagiaan tinggi di pasar.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Yang Mulia, perkembangan persiapan pernikahan berjalan lancar! Tapi kita perlu lebih banyak alat untuk membangun tenda pernikahan!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Bangun bengkel pembuat alat.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Buat 20 alat.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Saya ingin pesat pernikahan diadakan di gereja yang indah. Apakah Anda telah membangunnya?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Capailah kebahagiaan religi yang tinggi.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Bangun penggembalaan domba.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Bangun pabrik tenun.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Buat 20 pakaian.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Apakah ini masuk akal? Saya tidak menemukan pakaian pernikahan yang layak! Saya perlu pakaian sekarang! Minta penjahit terbaikmu membuatkannya.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Bangun toko penjahit.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Bangun dekorasi.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Tingkatkan kebahagiaan penduduk kota Anda!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Tempat ini suram... bisakah Anda buat kota ini lebih cantik? Saya ingin semua orang merasa sebahagia saya!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Saya tidak peduli kue dan bunga; Saya menginginkan perayaan besar dengan banyak jus! Dan saya ingin mengundang seluruh kota! Tapi kita tidak memiliki cukup ruang untuk menampung seluruh tamu pernikahan!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Bangun rumah lagi.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Saya ingin tempat yang nyaman untuk bertemu teman saat pernikahan selesai. Kota ini benar-benar membutuhkan kedai minuman!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Capai kepuasan yang tinggi dengan beberapa bar.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Buat 25 jus anggur.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Teman-teman saya akan sangat haus! Apakah Anda telah mengurus jusnya?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Bangun pabrik jus.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Tamunya akan lebih banyak dari yang kita duga. Bangun rumah besar.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Bangun rumah besar.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Buat 15 perhiasan.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Oh, tidak! Saya dalam masalah serius! Saya kehilangan cincin pernikahan! Tolong dia jangan sampai tahu! Adakah tukang emas di kota yang dapat membuatkan cincin baru?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Bangun tukang emas.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Sebelum menikah, saya ingin mengesankan tunangan saya di tempat latihan adu tombak berkuda!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Bangun tempat latihan adu tombak berkuda.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Tuanku, gudang kastil kita telah penuh sesak dengan barang. Sudikah saya sarankan agar kita memerintahkan membangun gudang tambahan?";
"T_GAME_QUEST_SCEN8_10_NAME" = "Bangunlah gudang baru.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Orang-orang di kota akan lebih senang jika ada tempat bagi mereka untuk bertemu dan minum jus anggur setelah seharian bekerja keras. Apakah tidak terlalu berlebihan meminta bar, Tuanku?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Capai kepuasan yang tinggi dengan beberapa bar.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Tuanku, pandai besi telah membangun tungku pemanas sederhana untuk Townie kita, namun kita masih perlu batu bara sebagai bahan bakar.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Hasilkan 50 batu bara.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Tuanku, kota kekurangan kayu bakar untuk menghangatkan rumah. Sangat penting bagi kita untuk menambah stok kayu!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Hasilkan 75 kayu bakar.";
"T_GAME_QUEST_SCEN8_2_DESC" = "Kota dalam bentuk yang jelek. Lihatlah semua rumah yang rusak ini. Mungkin sekali badai salju cukup untuk merobohkan banyak rumah. Ajaklah tukang kayu ke kota untuk membantu memperbaiki gedung.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Bangun bengkel tukang kayu.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Tuanku, musim dingin yang berat ini jelas adalah pertanda dari langit! Kita harus bertaubat atas dosa kita! Mari bangun rumah tuhan untuk menyenangkan Yang Maha Kuasa!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Capai keyakinan religi yang tinggi.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Townie semakin gelisah, Tuanku. Di rumah mereka sangat dingin. Saya rasa kita harus menambah stok kain wol. Townie bisa menggunakan untuk melindungi rumahnya terhadap dingin.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Hasilkan 55 kain wol.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Gubernur propinsi tetangga telah mengirim merpati pos ke kita untuk mohon bantuan! Mereka sangat memerlukan pakaian hangat untuk warganya.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Kirimkan sekeranjang pakaian ke provinsi tetangga.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Lahan pertanian tidak bisa menghasilkan gandum di musim dingin, tuanku. Ajaklah beberapa Townie ke hutan untuk berburu rusa.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Bangunlah beberapa pondok pemburu.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Abdiku yang setia, kerajaan telah terpukul oleh musim dingin yang amat parah ini. Penerimaan pajak telah turun drastis. Kuperintahkan engkau membangun gudang harta untuk menambah pendapatan pajak dan kirim saya sekereta Thaler sebagai upeti.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Bangunlah gudang harta dan kirimkan upeti koin ke raja.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Sekarang kita punya tukang kayu di kota, memperbaiki semua rumah yang rusak bukanlah masalah yang berat. Townie akan sangat senang.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Pastikan semua balai kota diperbaiki dengan benar.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Daging selalu tersedia, bahkan di musim dingin, dan bisa menjadi pengganti roti. Pastikan terdapat cukup daging untuk semua orang di musim dingin.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Hasilkan 50 daging.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Tuanku, musim dingin jauh lebih parah dari yang kami duga, dan Townie tidak senang dengan situasi ini. Kita harus bertindak cepat atau kita tidak akan bertahan melewati musim dingin!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Antarkan kota melewati musim dingin...";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Tuanku, Townie sangat senang dengan kemajuan yang kita buat! Sekarang kita cukup suplai untuk semua orang melewati bulan-bulan musim dingin dan bahkan kita bisa membantu propinsi tetangga. Sekarang kita telah siap dan musim dingin ini tidak akan membahayakan kita!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Tuanku, saya dengar Anda bermasalah dengan pemberontak di wilayah Anda. Saya bersedia memimpin tim pencari ke hutan, tapi serdadu bayaran saya ingin pembayaran di muka.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Sewa serdadu bayaran.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Aku belum punya permintaan lain, abdiku yang setia. Aku butuh kapal yang benar-benar cocok untuk raja dan itu berarti hiasan emas yang mewah!\n\nKuperintahkan engkau memberiku emas yang kubutuhkan untuk tujuan ini. Jangan kecewakan aku, atas hal ini!";
"T_GAME_QUEST_SCEN9_11_NAME" = "Kirim bijih emas ke raja dalam batas waktu.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Abdiku yang setia, pembangunan armada baruku berjalan dengan baik, namun kita masih butuh banyak kain layar. Kuperintahkan engkau mengirim kain yang cukup untuk semua layar kapal kita.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Kirim kain untuk produksi kain layar.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Anak buah saya telah menemukan sesuatu. Kami menemukan jejak penjahat di hutan. Bagaimana pun kami perlu bekal lebih banyak, sebelum bisa menyelidiki lebih jauh.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Kirim bekal ke serdadu bayaran.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Gubernur! Saya kehilangan seluruh kiriman papan kayu karena penjahat di propinsi Anda. Ini harus dihentikan. Kirim papan kayu sesegera mungkin.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Kirim papan kayu untuk mendukung konstruksi armada raja.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Tuanku, pemungut pajak menemukan bukti kaitan antara penjahat di hutan dan penyabotase di kota. Ia menolak menceritakan kepada kami karena khawatir atas nyawanya.\n\nIa minta dilepaskan dari tanggung jawabnya sebagai pemungut pajak. Ia juga minta seperangkat pakaian baru sehingga bisa meninggalkan kota dan bersembunyi. Barulah ia akan menceritakan temuannya kepada kita.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Lepaskan tugas pemungut pajak dari gudang harta dan beri ia pakaian baru sehingga ia bisa menyusup ke kota tanpa tercium.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Tuanku, seperti yang ia janjikan, pemungut pajak telah mengungkap identitas penyabotase sebelum ia meninggalkan kota.\n\nItu adalah serdadu bayaran dan anak buahnya! Mereka penipu! Mereka pergi dari kota ke kota dan menawarkan "perlindungan" dari penjahat demi uang dan menyabotase komitmen mereka secara diam-diam!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Kabar buruk, Tuanku! Seseorang membobol gudang dan mencuri semua daging kita!\n\nTempatkan beberapa obor di sekitar kota. Ini bisa membantu menangkap pencuri di malam hari.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Bangunlah 7 obor di sekitar kota untuk mencegah pencuri.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Paduka, karena kita tidak akan dikunjungi kafilah dagang dalam waktu dekat, maka kita perlu gudang tambahan untuk menyimpan semua barang kita. \n\nSelain itu, kita harus menjeda produksi yang tidak perlu untuk memastikan gudang kita tak sesak.\n\nSebaiknya membangun gudang yang lain.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Bangunlah gudang lain di kota.";
"T_GAME_QUEST_SCEN9_19_DESC" = "\nTownie tercekam takut terhadap penyabotase dan tak bernyali untuk keluar dan memperbaiki rumahnya. Saya sarankan kita harus membangun bengkel tukang kayu jika ingin perbaikan selesai.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Bangun bengkel tukang kayu.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Selamat pagi, tuanku. Ini musim dingin yang menyenangkan. Kita punya pekerjaan yang cocok dalam beberapa bulan mendatang. \n\nMulai sekarang mari bangun beberapa pondok rimbawan, oke?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Bangunlah beberapa pondok rimbawan.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Saya datang kepada Anda dengan permintaan, tuanku. Peralatan sangat dibutuhkan di seluruh kerajaan. Saya akan membayar sangat mahal jika Anda bisa mengirimkan kepada saya sekereta peralatan. Selain itu saya akan mengunjungi kota Anda lagi untuk berdagang.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Kirimkan muatan peralatan ke pedagang.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Saya punya berita penting, tuanku! Segerombolan serdadu bayaran telah tiba dan mereka mengeluhkan bahwa desa kita kekurangan bar. \n\nKita harus mencoba menghindari banyak ketidaksenangan dan kebosanan para serdadu bayaran di kota, jadi mari kita bangun bar. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Menambah kebahagiaan bar.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Governor, aku senang melihat bahwa usahamu untuk menambah produksi kayu berjalan dengan baik.\n\nSekarang, sudikah kau melakukan pengiriman perdana…";
"T_GAME_QUEST_SCEN9_3_NAME" = "Kirimkan upeti kayu untuk raja.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Tuanku, masih tetap ada rumor tentang kerusuhan di kota. Mungkinkah beberapa Townie berkomplot melawan raja?\n\nJika kita tidak bertindak sekarang, mungkin kita akan menghadapi pemberontakan yang hebat. Kita harus memastikan bahwa Townie bahagia serta puas dan kita harus cepat menanganinya.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Pertahankan kebahagiaan lebih dari 100% untuk beberapa menit berikutnya.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Tuanku, ini biadab! Bar telah dihancurkan! Ini masalah sabotase besar-besaran di kota kita. \n\nKita harus menangani situasi ini sebelum semuanya diluar kendali. Tiang gantungan dan tiang hukuman seharusnya berhasil menakuti.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Bangunlah tiang gantungan dan 2 tiang hukuman di kota.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Tuanku, meningkatkan semangat di kota adalah tindakan bijaksana. \n\nMenunjukkan beberapa kebaikan ke Townie-mu akan menambah kebahagiaan mereka. Mengapa tidak membangun gereja atau mempercantik kota dengan kebun bunga?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Bangunlah beberapa kebun bunga dan gereja.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Gubernur, saya minta maaf bahwa saya tidak bisa mengunjungi kota Anda untuk sementara.\nSaya mendengar tentang penjahat di hutan sekitar Anda. Sekarang ini terlalu berbahaya untuk para pedagang.\n\nMeski saya mendapatkan pesan dari raja. Ia memerintahkan pembangunan dua penggergajian.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Bangunlah 2 penggergajian.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Tuanku, saya punya ide. Kita harus membangun gudang harta. Pemungut pajak akan mengunjungi setiap rumah di kota...dan mungkin ia bisa mendapat info tentang penyabotase ini.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Bangunlah gudang harta dan tunggu pemungut pajak menyelidiki balai kota.";
"T_GAME_QUEST_SCEN9_9_DESC" = "Penyabotase telah menghancurkan penggergajian! Pemungut pajak juga tidak berhasil mengungkap identitas penyabotase, tuanku.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Engkau tidak mencegah kerusuhan di waktu yang tepat!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Engkau gagal! Karena ketidakcakapanmu aku harus memesan emasku dari kota lain!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Gubernur, saya segera menugaskan pembangunan armada kapal perang baru yang hebat. \n\nKotamu berpotensi menjadi penyuplai kayu terbesar untuk kegiatan besar ini. Pastikan itu dilakukan.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Serdadu bayaran dan gangnya telah meninggalkan kawasan ini, Tuanku. Pasukanku akan mengejar mereka dengan kejam.\n\nAku juga ingin berterima kasih atas dukunganmu dalam membangun armada baru dan mengundangmu untuk pelayaran perdana kapalku. Sampai saat itu tiba, semoga harimu menyenangkan...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Dukung usaha Raja.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Bagus sekali! Engkau mencegah kerusuhan di kota!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Bagus sekali! Engkau telah mengirim dengan tepat waktu!";
"T_GAME_QUEST_SCEN_10_DESC" = "Ksatria kita harus menemukan kesenangan di kedai lokal setelah turnamen berakhir! Aku khawatir, karena, kita tidak memiliki cukup kedai dan jus anggur! Segera atasi permasalahan ini!";
"T_GAME_QUEST_SCEN_10_NAME" = "Bangun kedai dan hasilkan cukup jus.";
"T_GAME_QUEST_SCEN_11_DESC" = "Luar biasa, pembantu raja! Kota sudah siap, tapi tidak untuk aku dan putriku! Aku membutuhkan pakaian terbaik yang bisa dibuat penjahitmu!";
"T_GAME_QUEST_SCEN_11_NAME" = "Kirim upeti 35 pakaian.";
"T_GAME_QUEST_SCEN_12_DESC" = "Pembukaan turnamen semakin dekat namun aku tidak ingin melihat satu pun wajah sedih di kota! Sebaiknya kau pastikan bahwa para Townie bahagia!";
"T_GAME_QUEST_SCEN_12_NAME" = "Tingkatkan kebahagiaan.";
"T_GAME_QUEST_SCEN_1_DESC" = "Selamat datang, pembantu raja yang baik! Asal tahu saja, aku berencana mengadakan pertarungan terhebat di dataran ini! Aku berharap kamu membangun setidaknya 3 arena pertarungan untuk acara ini! Jangan kecewakan aku!";
"T_GAME_QUEST_SCEN_1_NAME" = "Bangun 3 arena pertarungan.";
"T_GAME_QUEST_SCEN_2_DESC" = "Tamu untuk turnamen ini tentu akan lapar! Aku ingin kau segera memulai pembuatan roti dan mengantarkannya sebagai upeti untuk rajamu!";
"T_GAME_QUEST_SCEN_2_NAME" = "Kirim upeti 25 potong roti.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Bangun kincir angin dan hasilkan tepung.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Bangun 2 rumah roti dan hasilkan roti.";
"T_GAME_QUEST_SCEN_3_DESC" = "Tuanku, kita tidak boleh membuat raja terus menunggu! Kita membutuhkan gandum dan tepung untuk membuat roti!";
"T_GAME_QUEST_SCEN_3_NAME" = "Bangun ladang dan hasilkan gandum.";
"T_GAME_QUEST_SCEN_4_DESC" = "Luar biasa, pembantu raja yang baik! Sayang roti tidak akan cukup untuk memuaskan tamu kita! Aku ingin ikan segar sebagai upeti untuk rajamu!";
"T_GAME_QUEST_SCEN_4_NAME" = "Kirimkan upeti 25 ikan.";
"T_GAME_QUEST_SCEN_5_DESC" = "Aku ingin turnamen ini agar tidak tidak terlupakan! Ksatria kita harus membawa tombak emas dan arena pertempuran kita harus bersinar dan berkilauan! Bantu aku dan kumpulkan pajak untuk rajamu!";
"T_GAME_QUEST_SCEN_5_NAME" = "Kirimkan upeti 1000 Thaler.";
"T_GAME_QUEST_SCEN_6_DESC" = "Aku yakin tamu kita akan menikmati lezat dan segarnya jus anggur perasan kita! Pergilah bangun pabrik jus! Bahkan kau juga bisa menghidangkan sampah berkualitas rendah di kedai lokal!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Aku yakin para tamu akan menikmati rasa lezat jus anggur segar kita!";
"T_GAME_QUEST_SCEN_6_NAME" = "Bangunlah pabrik jus dan hasilkan jus.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Bangun kedai pintal dan hasilkan kain.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Bangunlah toko penjahit dan buat pakaian.";
"T_GAME_QUEST_SCEN_7_DESC" = "Jubah ksatria kita sudah tua dan usang dan itu menyiksa mataku, pembantu raja! Buatlah jubah baru! Bangunlah padang domba, rekrut penenun dan bangunlah toko penjahit, jika kau ingin melanjutkan kerjaku!";
"T_GAME_QUEST_SCEN_7_NAME" = "Bangun 2 padang domba.";
"T_GAME_QUEST_SCEN_8_DESC" = "Kita harus menjual lebih banyak barang untuk mendapat uang, tuanku. Sebaiknya kita memiliki cadangan Thaler untuk keperluan mendadak di waktu mendatang.";
"T_GAME_QUEST_SCEN_8_NAME" = "Dapatkan 500 Thaler dari perdagangan.";
"T_GAME_QUEST_SCEN_9_DESC" = "Kulihat semuanya berjalan baik, namun kotamu masih jelek! Aku ingin air mancur dan tembok batu putih dan pepohonan hijau dan patung yang menarik! Kau harus mempercantik kotamu dengan lebih banyak dekorasi!";
"T_GAME_QUEST_SCEN_9_NAME" = "Tingkatkan kebahagiaan deco.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Pertama-tama ada baiknya menugaskan seorang pekerja di salah satu pondok rimbawan di sekitar.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Tugaskan seorang pekerja di pondok rimbawan.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Salah satu tugas utama adalah membangun pasar.\nUntuk merampungkan tugas ini, siapkanlah rantai produksi beberapa sumber daya dan kumpulkan sumber daya yang diperlukan, Tuanku.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Bangunlah pasar.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Tuanku, sebaiknya kita menugaskan seorang Townie di penggergajian agar kita bisa memproduksi papan secepat mungkin.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Tugaskan seorang pekerja di penggergajian.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Tuanku, rasanya kita lebih baik menambang batu daripada bijih besi.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Begitu ada beberapa papan dan kayu yang terkumpul, tugaskanlah salah satu pekerja di tambang dan mulailah menambang batu.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Baik, Tuanku. Sekarang kita tinggal menunggu sampai pembangunan pasar selesai.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Tugaskan seorang pekerja di tambang.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Tugas utama yang kedua adalah membangun kedai minum.\n\nSebaiknya kita segera mulai mendirikan bangunan itu.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Bangunlah kedai minum";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Berita bagus, Tuanku. Beberapa Townie datang untuk membantu kita merampungkan tugas. Sebaiknya kita membangun rumah tinggal untuk mereka.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Bangunlah rumah tinggal.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Kita perlu bengkel pembuat alat untuk mendirikan kedai minum. Sebaiknya kita mulai dengan membuat perapian batu bara.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Bangunlah pondok perapian batu bara.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Bangunan berikut yang kita perlukan adalah tempat peleburan logam. Dengan begitu kita bisa mulai memproduksi batang besi.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Bangunlah tempat peleburan logam.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Tuanku! Untuk memulai produksi alat, kita perlu bengkel pembuat alat di kota.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Bangunlah bengkel pembuat alat.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Persediaan pangan mulai menipis, Tuanku. Kita perlu menugaskan seorang Townie untuk menangkap ikan atau berburu. Jika para Townie tidak segera mendapat bahan makanan, produktivitas mereka akan berkurang.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Produksi pangan.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Tuanku, sebagai pedagang sederhana aku siap melayanimu. Sepertinya Tuanku memerlukan uang untuk proyek pembangunan.\nAku ingin membeli bijih besi, kalau Tuanku berkenan.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Tukarkan sejumlah komoditas dengan pedagang.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Tuanku kehabisan uang? Tidak masalah. Aku bersedia membeli kulit hewan dari Tuanku.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Gubernur, aku perlu bijih emas. Maukah kau menjualnya kepadaku?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Tuanku, aku merasa kurang sehat. Sepertinya aku perlu diperiksa oleh dokter.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Sembuhkan Townie yang sakit.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Kebakaran! Api harus segera dipadamkan oleh seorang Townie.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Padamkan api.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Di sini pun kita tidak aman dari bandit. Tuanku, kita perlu menugaskan beberapa Townie di menara jaga sampai serangan ini berhasil dihalau.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Pertahankan kota terhadap serangan bandit.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Tuanku, apakah kita bisa beristirahat sejenak dan makan sedikit?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Buatlah roti.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Tuanku, kini hanya tersisa beberapa Townie untuk tantangan ini. Sebaiknya mereka ditugaskan bergantian sesuai kebutuhan.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Selamat. Kau berhasil mengatasi tantangan.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Manfaatkanlah para Townie dengan bijaksana untuk merampungkan semua tugas.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Kabar bagus, Tuanku. Semenanjung di sebelah kastil sudah mulai ditumbuhi pohon lagi.\n\nSebaiknya kita membangun pondok rimbawan di sana supaya kita lebih mudah mendapatkan kayu.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Tuanku, semua pondok rimbawan sudah reyot dan ditinggalkan!\n\nPepohonan di daerah ini sudah ditebang semua. Pondok rimbawan tidak ada gunanya lagi. \nSebaiknya semua bangunan yang sudah tidak berguna dirobohkan saja untuk diambil kayunya.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Robohkan pondok rimbawan.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Tuanku, sebaiknya kita tanya penduduk desa ini. Siapa tahu mereka punya kayu sisa.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Raja menunggu kiriman papan yang pertama.\n\nKita bisa menugaskan seorang Townie di penggergajian dan mulai memproduksi papan. Jangan lupa perhatikan persediaan kayu. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Tugaskan seorang Townie di penggergajian.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Bagaimana perkembangannya, Gubernur? Aku menunggu tiga kiriman.\n\nSiapkan kiriman pertama secepat mungkin. Jangan kecewakan aku!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Antarkan kiriman kepada Raja.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Tuanku, Raja merasa puas dengan kiriman papan yang pertama.\nKiriman kedua perlu kita siapkan secepatnya.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Raja menunggu kiriman yang terakhir. Setelah semua papan diterima, armada kerajaan bisa diperbesar.\n\nKita harus segera merampungkan tugas ini.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Kau bingung kenapa kirimanmu belum diterima oleh Raja? Mari kuberi tahu jawabannya.\n\nSingkat kata: Bayarlah sedikit uang tebusan dan kirimanmu akan segera sampai ke tangan Raja.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Bayar uang tebusan.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Aku perlu banyak papan untuk membangun armada kerajaan.\nSayangnya sudah lama tidak ada kiriman apapun.\n\nGubernur, aku punya tugas untukmu! Cari tahu kenapa kiriman terhenti dan atasi masalahnya!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Bagus, Gubernur. Aku tahu kau bisa diandalkan.\n\nBerkat bantuanmu armada akan segera siap.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Akhiri kekurangan kayu dan antarkan papan secukupnya kepada raja.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Tuanku, persediaan kayu sebaiknya digunakan dengan bijaksana!\n\nKita bisa membangun pasar, supaya kita membeli kayu dari para pedagang.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Kau perlu kayu? Kukira kita bisa dengan mudah mencapai kesepakatan yang saling menguntungkan. Ada setumpuk kayu yang langsung siap, kalau kau berminat.\n\nMari, belilah sebanyak yang kaubutuhkan!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Beli kayu dari pedagang.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Tuanku akan memerlukan kiriman kayu secara berkala.\n\nDengan membangun Perkumpulan Saudagar, Tuanku bisa membuat perintah transaksi.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Bangunlah perkumpulan saudagar.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Di perkumpulan saudagar Tuanku bisa memerintahkan transaksi jual-beli.\n\nSiapkanlah perintah transaksi untuk kayu, Tuanku.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Bagus! Selama kau punya uang untuk membayar, aku akan menjalankan semua perintah transaksi.\n\nPerintah transaksi akan dilaksanakan sampai dibatalkan.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Siapkan perintah transaksi untuk membeli kayu.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "Kebakaran melanda kota! Kita perlu menara pemadam kebakaran yang cukup untuk memadamkan api dan mengurangi risiko kebakaran.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Pastikan 80% kota tercakup oleh menara pemadam kebakaran.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Bandit! Mereka berusaha menghancurkan bangunan kita! Kita perlu lebih banyak serdadu di kota untuk menghalau para bandit. Sebaiknya kita membangun lebih banyak menara jaga.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Bangunlah menara jaga dalam jumlah memadai dan amankan kota dengan serdadu secukupnya.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Ada wabah lagi! Kota sebesar ini memerlukan satu rumah sakit lagi.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Ada wabah lagi! Kota sebesar ini memerlukan satu rumah sakit lagi.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Bangunlah rumah sakit dan atasi serangan penyakit.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Tuanku, tidak semua Townie bisa pergi ke gereja karena gereja selalu penuh.\n\nKita perlu membangun lebih banyak gereja untuk memuaskan semua Townie.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Tuanku, para Townie harus menunggu terlalu lama untuk mendapatkan minuman. Kita perlu membangun lebih banyak kedai minum dan meningkatkan produksi jus dan bir.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Tidak ada hiburan di kota ini. Sebaiknya kita membangun arena pertarungan.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Para Townie merasa puas. Tapi sekarang mereka menuntut barang mewah.\n\nKita bisa menyediakan kain tenun atau perhiasan untuk mereka.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Beberapa Townie mengeluh bahwa pasar terlalu padat.\n\nKita perlu membangun pasar baru atau meningkatkan pasar yang ada. Kalau tidak, para Townie yang kecewa akan meninggalkan kota.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Kau mengecewakanku, Gubernur. Sayang sekali kau tidak bisa merampungkan semua tugas dariku.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Bagus sekali, Gubernur, kau merampungkan semua tugas dariku tanpa ada satu Townie pun yang meninggalkan kota.\n\nAku akan menggandakan imbalanmu.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Gubernur, beberapa Townie meninggalkan kota. Sebenarnya aku berharap lebih banyak darimu.\n\nTapi paling tidak kau berhasil merampungkan semua tugas dariku. Kau akan mendapatkan imbalanmu.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Tuanku, kita harus menarik lebih banyak Townie ke kota kita, atau Raja akan sangat murka.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Ya ampun, Tuanku. Banyak Townie telah meninggalkan kota. Kita tidak bisa membiarkan lebih banyak lagi pindah.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Tingkatkan populasimu.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Tuanku, beberapa Townie telah meninggalkan kota. Kita harus mengurus mereka dengan lebih baik agar mereka jangan pindah.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Gubernur, banyak Townie telah pindah ke kota kecil ini.\n\nPenuhilah semua kebutuhan mereka agar mereka tidak meninggalkan kota lagi. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Tingkatkan populasi sebelum waktu habis.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Rampungkanlah semua tugas sebelum kedatangan Raja dan pertahankan populasi di atas 150.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Beban kerja para pengangkut di kota ini terlalu berat. Kita perlu membangun gudang baru dan menugaskan lebih banyak Townie sebagai pengangkut.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Bangunlah gudang baru dan tugaskan lebih banyak pengangkut di kastil.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Kita mulai kekurangan pangan. Sebaiknya kita membangun pondok nelayan baru. Ini seharusnya membantu.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Tuanku, produksi roti di toko roti tidak mencukupi. Kita bisa meningkatkan toko roti dan menugaskan satu tukang roti lagi.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Tingkatkan toko roti ke level 2 dan tugaskan satu tukang roti lagi.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Kebutuhan akan air meningkat pesat. Kita bisa menyediakan air untuk semua Townie dengan menggali sumur yang cukup.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Galilah beberapa sumur di kota.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Tuanku, kita perlu menambah persediaan pangan. Kita membutuhkan pondok pemburu atau rumah jagal baru.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Bangunlah pondok pemburu atau rumah jagal.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Bagus sekali, Tuanku, kita sudah mengamankan persediaan. Tapi kita tetap harus memperhatikan keinginan para Townie.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Tuanku, pertama-tama kita perlu mengumpulkan bahan bangunan dan menugaskan seorang Townie di pondok rimbawan di seberang sungai.\n\nBangunlah jalan batu melintasi sungai agar Townie itu bisa mulai bekerja.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Bangunlah jalan batu melintasi sungai dan tugaskan seorang Townie di pondok rimbawan.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Bangun jalan di atas sungai dan tugaskan Townie ke pondok rimbawan.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Pindah ke sini adalah kesalahanku yang paling besar. Aku akan pergi!\n\nTuanku, penuhilah keinginan kami atau semakin banyak Townie akan pindah.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Tidak, terima kasih.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Itu ide bagus.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Kukira kau memiliki pola pikir progresif... Baiklah, silakan nikmati pola pikirmu yang biasa-biasa saja.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, perubahannya sudah mulai terlihat. Kita harus melanjutkan upaya kita dan menyiapkan langkah produksi selanjutnya.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Kita menguasai pasar tekstil rumah tangga dan adibusana! Kita akan menghasilkan banyak uang!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Sekarang, bahan baku mentah sudah tersedia, tetapi bangunan masih diperlukan. Seorang penenun dan penjahit akan bisa melakukannya!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Mengikuti keputusanmu, perubahan besar akan terjadi di desamu. Namun, tidak ada yang akan mungkin tanpa... domba dan peternakan yang kondisinya baik.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Tuan, aku baru saja kembali dari kota terdekat. Mereka memiliki kain yang indah dan sulaman yang cantik. Kita harus mengambil inspirasi darinya dan membuat pakaian yang luar biasa juga.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Bunga sutra";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Musim serbuk sari kembali, warga bersin sepanjang waktu. Bagaimana jika kita mengadakan kontes bersin?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Masing-masing dari mereka berkonsentrasi dan melakukan bersin paling kuat pada gilirannya. Kau harus memilih mana yang menjadi favoritmu agar dia dapat dipilih sebagai pemenang!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "HATCHI !";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "HATCHUH!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "HUATCHOUH!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "Dan inilah pemenang kita! Bersin paling sukses! Selamat! Bersinmu luar biasa!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Townie tersebut membanggakan diri bersama hadiahnya. Kontes ini tidak memberimu banyak keuntungan, tetapi mungkin kotamu akan menjadi terkenal karena mengadakan kontes bersin pertama dalam sejarah!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Jangan.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Dari istana, kau sudah bisa mendengar kerumunan orang berkumpul di alun-alun desa. Kau juga mendengar suara bersin. Kontes ini akan sangat menyenangkan!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Banyak townie menunggu dalam antrean sambil menahan bersin demi melepaskan semua kekuatan mereka ketika mereka ada di hadapan juri, yaitu kau dan penasihatmu.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Kau menilai Townie satu per satu. Kau telah menuliskan tiga nama townie. Kau menyerahkan daftar tersebut ke penasihatmu, yang akan membawa mereka ke tengah alun-alun desa untuk final kontes bersin!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Kau memutuskan untuk menyebarkan berita di kota, bahwa sebuah kompetisi diselenggarakan di alun-alun desa. Townie yang dinilai sebagai yang terbaik akan menerima hadiah!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Tuan, sambil menunggu townie berkumpul di alun-alun, kita harus mempersiapkan festivalnya! Mari kita mulai dengan sedikit dekorasi.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Hias kota.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Ini membuat kota kita jauh lebih menarik.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Kita juga harus memeriksa persediaan kita.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Sempurna, kita akan memiliki semua yang kita butuhkan selama perayaan itu.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "Kontes Bersin";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Ayo lakukan!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Kau benar, mari kita membuat beberapa patung.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "Tidak... Aku tak ingin ada patung di kotaku.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Bravo, Tuan! Patung-patung ini memberikan pesona tersendiri bagi kota kita.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Tuan, suatu hari mungkin kau akan memikirkan detail semacam ini.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Tuan, kota kita sangat kekurangan patung. Bagaimana kalau menambahkan beberapa patung lagi? Selain itu, diyakini bahwa patung melindungi para penduduk.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Malaikat sekeras batu";
"T_GAME_QUEST_SUCCESS" = "Misi selesai!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "Itu niat yang bagus, biarkan dia melakukannya.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Sungguh orang yang aneh.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Tuan, kita tidak bisa membiarkan warga melakukan ini. Mari kita bangun kamp sirkus dan tempatkan orang gila ini sebagai penanggung jawab hiburan.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Bagus sekali! Penduduk tampaknya senang dengan hasilnya.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Kau mengamati desa di kejauhan.\n\nPemburu air mata masih mengejar Townie. Makin banyak orang yang sekarang menolak meninggalkan rumah mereka.\n\nKau perlahan menjauh dari jendela agar kau tidak lagi menyaksikan kerugian yang diakibatkan oleh keputusanmu.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Mungkin kau harus melakukan sesuatu... Townie yang aneh ini meneror warga dan moral townie lainnya malah menurun. Mari kita berharap itu tidak bertahan lama!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Gubernur, aku diberitahu pagi ini bahwa salah satu warga desa telah memutuskan untuk membuat semua orang bahagia. Dia mulai mengejar warga dan memaksa mereka untuk tertawa…";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "Pemburu Air Mata";
"T_GAME_QUEST_THE_BATH_B_001" = "Kita berhasil menghindari bahaya. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Sekarang, mari kita nyatakan kalau mandi itu wajib. Ini akan mengurangi penyakit!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Mandi itu tidak wajib.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "Kau tak pernah belajar dari kesalahanmu!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Tuan, penyebaran wabah penyakit baru telah muncul. Ini jauh lebih parah dari yang sebelumnya.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Kali ini, Tuan, suka atau tidak suka, aku menyatakan mandi itu wajib!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Penasihatmu menyelamatkan banyak orang dari penyakit ini. Dia bahkan berhasil masuk ke buku sejarah. Namun, kau adalah orang yang menolak mandi. Ratusan anak, bahkan bertahun-tahun kemudian, mencintaimu karena hal itu, karena, "Mandi itu sangat menyebalkan sekali". ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Mandi itu wajib!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Itu bijaksana, Tuanku. Penularan penyakit sekarang menurun.";
"T_GAME_QUEST_THE_BATH_DESC" = "Beberapa hari yang lalu, kau memiliki pemandian umum di kotamu. Meskipun ini adalah ide yang bagus, townie takut air dan tidak berani membersihkan diri. \n\nApa yang harus kita lakukan?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Panaskan airnya.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Mari kita simpan kayu yang cukup agar bisa memanaskan air untuk mandi.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Sempurna. Air ada di suhu yang nyaman dan kita berhasil meyakinkan beberapa penduduk untuk membersihkan diri.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Sayangnya, upayamu sia-sia dan penyakit masih mulai menyebar di kotamu.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Biarkan mereka.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Sesuai keinginanmu. Jika wabah terjadi di desa, kau sebaiknya tidak menyesalinya!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Selama beberapa bulan, hanya sedikit penduduk yang membersihkan diri. Dan ketika salah satu townie jatuh sakit, dia menulari tiga orang lainnya! Beberapa bahkan yakin bahwa penyakit itu berasal dari pemandian.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Sembuhkan townie.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Waktunya mandi";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Suap.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Kau pergi menemui pemuka agama dan mengajukan permintaan. Dengan imbalan beberapa koin, mereka harus mengumumkan dalam khotbah mereka bahwa mandi akan membuat mereka cantik.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Sediakan uang yang diperlukan.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Yang tersisa hanyalah membayar sejumlah uang kepada pemuka agama, Tuan.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Terima kasih Gubernur, aku akan menyampaikan pesanmu.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Tampaknya upayamu membuahkan hasil. Penyakit ini berkurang penularannya dan akan bertahan untuk beberapa waktu!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Paksa mereka!";
"T_GAME_QUEST_THE_BATH_YES_002" = "Dan ini dia! Semoga para penyebar berita kita mengumumkan kabar baik ini!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Tidak semua warga desa senang dengan gagasan mandi secara teratur. Beberapa bahkan mengatakan mereka merasa lebih lemah setelah berendam.\n\nYang lain mengatakan airnya terlalu dingin dan menolak untuk mandi.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Tanyai penyihir itu.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Saat kau hendak menanyainya, asap tebal mulai menyelimuti seluruh wilayah, kau bahkan tak bisa melihat jarak satu meter pun di depanmu.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Sekarang, kau dihadapkan dengan dilema: memberikan sumber daya yang diperlukan atau membiarkan situasi memburuk, apa pun musibah yang akan terjadi. Kau harus bergegas dan bertindak, siapa tahu apa yang bisa dilakukan oleh kedua penyihir itu.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Tuan! Kami gagal, para penyihir berhasil mengambil sumber daya kita dan melarikan diri.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Berikan sumber daya.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Mari kita coba sediakan semua sumber daya untuk penyihir sampah ini!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Kita mampu memproduksi semua sumber daya yang diminta. Yang harus kita lakukan sekarang adalah mengirimkannya ke lokasi yang ditentukan.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Atas saran penasihatmu, kau memasang jebakan untuk para penyihir. Begitu mereka datang untuk mengambil barang, mereka akan langsung ditangkap! Mari berharap ide cerdikmu efektif.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Tuan! Kita berhasil menangkap penyihir kedua!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Kau menempatkan dua penjaga di dekat sumber daya. Dua penyihir lainnya muncul dan perlahan mendekat untuk mengambil sumber daya. Ketika mereka sudah setengah jalan, penjagamu mengaktifkan jebakan.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Jangan menyerah.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Jadi, kau ingin memprovokasi kemarahan saudara-saudaraku. Aku tidak ingin berada di posisimu, Gubernur.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "Atasan kami akan memastikan kau membayarnya!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Ah! Akhirnya kau mengakui bahwa kau diperintah seseorang! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "Penyihir itu menggigit bibirnya, sebagai tanda penyesalan karena bicara terlalu cepat. Jadi, dia dikirim oleh seseorang yang punya dendam pribadi kepadamu.\n\nTak peduli sekeras apa kau berusaha memikirkan siapa pelakunya, tak ada nama yang muncul di benakmu.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Penasihatmu datang dengan tergesa-gesa, dia terlihat panik: "Tuanku! Ada penyihir di depan gerbang kita! Mereka meminta untuk bisa tinggal di tempat kita selama beberapa hari. Haruskah kami menerimanya?"";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Gubernur... Ini semua adalah kesalahpahaman. Saudara-saudaraku dan aku tak ingin menimbulkan begitu banyak kesulitan.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Jadi, mereka adalah saudaramu. Mengapa kalian menyulut kebakaran itu?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Bukan niat kami untuk melakukannya, Tuan. Kami hanya sedikit ceroboh, itu saja…";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Kau bekerja untuk siapa? Para bandit?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "Jauh dari itu! Namun, jika kau ingin menghilangkan asap tebal yang secara bertahap menelan seluruh wilayahmu, lebih baik kau mengabulkan permintaanku.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "Dan apa permintaanmu? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Aku ingin kau memberiku sumber daya dan uang!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "Lalu apa lagi? Beritahu di mana kami bisa menemukan saudara-saudaramu!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Jika kau menolak, bencana lebih besar akan terjadi.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Tuan, orang yang menyewa para penyihir ini, mungkinkah dia Adipati Cannes? Aku tiba-tiba ingat bahwa dia sempat mengancammu ketika kau mulai berkirim surat kepada Ratu Frygith.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Penasihatmu mungkin tidak salah, kau baru ingat bahwa Adipati Cannes telah melamar Ratu Frygith, tetapi setelah bertemu denganmu dalam acara dansa yang terkenal itu, ratu menolak lamarannya.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Dasar penyihir murahan! Jadi Adipati Cannes adalah atasanmu!? Kami sudah tahu segalanya!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "Benar... Kau berhasil memecahkannya. Mari kita membuat kesepakatan. Beri aku sejumlah uang dan aku dan saudara-saudaraku tak akan mengganggumu lagi.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Tuan, kita tidak dalam posisi yang menguntungkan untuk bernegosiasi. Mari beri dia sejumlah uang yang dia minta dan selesaikan masalah sihir ini. Kita tidak bisa melawan bencana supernatural.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Meskipun kau tidak suka ditekan, kau harus mengakui bahwa penasihatmu benar. Kesejahteraan townie lebih penting daripada egomu.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Yang harus kita lakukan sekarang adalah melepaskan penyihir dan memberinya uang.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Senang berbisnis denganmu, Gubernur!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "Si penyihir menghilang bersama segepok besar uang. Namun, kau tidak akan berurusan dengan mereka lagi.\n\nSedangkan untuk Adipati Cannes, kau mengirim surat kepada Ratu, yang berjanji untuk menangani kasusnya secara pribadi. Pada akhirnya, semuanya berakhir dengan baik.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Setelah tersadar dan selesai menyelamatkan kotamu dari kebakaran, kau meminta penjaga untuk memanggil ketiga penyihir. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Serdadumu memberitahumu bahwa mereka hanya berhasil menemukan satu dari tiga penyihir. \n\nDua lainnya hilang.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Tuan! Apa kau baik-baik saja? Para penyihir meledakkan bangunan! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Kita harus memadamkan api secepat mungkin!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "Kebakaran terakhir telah dikendalikan, Tuan.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "Ada tiga penyihir. Mereka tampak lega bahwa kau menanggapi permintaan mereka secara positif. Kau memberi mereka kamar di penginapan. Melihat mereka tidak membutuhkan apa-apa lagi, kau kembali meneruskan tugasmu sebagai Gubernur.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Segera setelah kau meninggalkan penginapan, kau mendengar ledakan besar. DHUUUAAARRRR! Sekarang beberapa bangunan terbakar!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Tutup akses.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "Oh, tidak! Kita terkena wabah epidemi dan beberapa bangunan terbakar! Ini mungkin trik penyihir!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Hahahahahahahaha!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Ayo cepat sembuhkan townie dan padamkan api!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Sekali lagi, kita lolos dari bencana besar…";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Lanjutkan pencarian.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Kami akan melanjutkan pencarian, Tuanku!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "Ada satu! Tangkap dia!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Penjagamu mulai mengejar penyihir kedua, ketika tiba-tiba, asap tebal menutupi desa. Penjagamu menghentikan pengejaran mereka karena tak bisa melihat arah mereka berjalan.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Tuan, kita menghadapi masalah baru! Kita tak bisa lagi bergerak cepat! Kita seperti berjalan melalui agar-agar!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Kita harus mundur ke dalam istana dan menanyai penyihir yang berhasil kita tangkap ini.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Mengikuti saran itu, kau memutuskan untuk membarikade dirimu di halaman istana untuk memulai interogasi penyihir pertama. Selain itu, kau meminta kepala penjaga untuk mengamankan istana agar tidak ada yang bisa masuk atau keluar dari istana.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Kau memutuskan untuk memisahkan kedua penyihir itu dari satu sama lain dan menanyai penyihir yang berhasil kautangkap berkat jebakanmu yang luar biasa.\n\nSayangnya, kau gagal menjaga sumber dayanya, penyihir ketiga membawanya kabur.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "Penyihir kedua tampaknya jauh lebih percaya diri daripada yang pertama dan tanpa ragu-ragu dia memberitahumu ini: "Selamat Gubernur, kau membuatku tertangkap basah. Namun, ketahuilah bahwa jika kau tidak segera membebaskanku, hal buruk akan terjadi di desamu."";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Bebaskan dia.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Kau terlalu takut dengan apa yang mungkin dialami desamu dan memutuskan untuk membebaskannya.\n\n"Kau memang bisa diandalkan, Gubernur," kata si penyihir, sebelum menghilang menjadi lingkaran asap begitu para penjaga melepaskan rantainya.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Tuan! Penyihir pertama juga lolos! Saudaranya muncul di sebelahnya, lalu mereka berdua menghilang!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "...Kita kembali ke titik awal.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "Kami akan berpatroli untuk mencari para bajingan ini, Tuan! Kau dapat mempercayai kami.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Yang harus kita lakukan sekarang adalah menunggu patroli kembali, Tuanku.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Untuk waktu yang lama, penjagamu berusaha menemukan para penyihir ini. Sejauh ini tidak berhasil. Namun, hari demi hari, awan asap aneh di kota yang memperlambat semua orang perlahan menghilang.\n\nMisteri seputar para penyihir ini akan tetap tidak terpecahkan.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Tahan dia.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Para Penyihir";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Izinkan mereka masuk.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Biru.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Hijau.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Pilihan yang berani, jika aku boleh jujur. Warna biru. Siapa yang akan membenci warna cantik seperti itu? Warna impian, kebijaksanaan, dan kesetiaan. Itu menunjukkan banyak hal tentangmu, Gubernur.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Kita menempatkan tamu di ruangan istana yang telah direnovasi, Tuan.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Sayangnya, warna ruangan membuatnya tak bisa tidur dan dia menyalahkanmu.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Tuan, tamu kita senang dengan ruangan ini. Dia sangat menyukai warnanya! Dia memutuskan untuk memberi kita prestige.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "Memang benar bahwa hijau memiliki reputasi menandakan kemalangan. Namun, itu juga merupakan simbol harapan, keberuntungan, dan stabilitas. Ini selaras dengan semua warna alam lainnya. Bisa kukatakan itu pilihan yang bagus.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Gubernur, kami baru saja merenovasi salah satu ruangan istana. Warna apa yang lebih baik?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "Ruangan";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Sama sekali tidak.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Kirim mata-mata.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "Sihir itu tidak ada.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Panggil si penyihir.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Tuan, itu mengerikan sekali. Bagaimana mungkin? Mungkinkah dia seorang penyihir yang mahir dalam ilmu hitam?! Tak ada yang boleh memiliki kekuatan seperti itu!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "Itu keputusan yang bijaksana. Mari kita kirim mata-mata terbaik kita untuk mengikuti townie gila ini dan menunggu laporan mereka.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Mata-matamu kembali dengan sebuah laporan.\n\n"Kami mengikuti townie ini, si pencuri kebahagiaan. Tampaknya kata-katanya memicu kesedihan besar pada warga. Townie menjadi tidak ingat saat-saat menyenangkan dalam hidup mereka."";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Tuan! Salah satu penghuni kita tampaknya mencuri kebahagiaan dari rekan-rekannya. \n\nBeberapa townie telah mengajukan keluhan tentang pencuri ini. Ini kesaksian salah satu korban: "Dia datang untuk bicara denganku di suatu pagi. Aku mendengarkannya dengan saksama dan tiba-tiba aku merasa sangat sedih. Seolah-olah kata-katanya memakan kebahagiaanku."";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Tuan, haruskah kita melakukan sesuatu untuk mengatasi masalah ini?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Gubernur, apa yang harus kita lakukan?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Bantu penyihir itu.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "Tidak ada yang namanya hantu!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Langkah-langkah yang kita ambil tampaknya berhasil, Tuan. \n\nSi pencuri kebahagiaan melanjutkan perbuatan buruknya, tetapi kita akan melawannya sekarang. \n\nHaruskah kita mengirim penjaga dan mengadilinya atas tindakannya? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Tegakkan keadilan.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Jangan lakukan apa pun.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Kau orang yang bijaksana. Hanya sains yang dapat menjelaskan dan memecahkan masalah pencuri kebahagiaan ini.\n\nKau memanggil ilmuwan terbaikmu untuk membuat formula yang bisa membuat townie kembali bahagia.\n\nTentu saja, sains tidak gratis. Para ilmuwan meminta banyak uang. Jika tidak, kau bisa mengucapkan selamat tinggal pada kebahagiaan untuk selamanya.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Masalah pencuri kebahagiaan ini tidak cukup membuatmu khawatir. Namun, kasus townie yang depresi terus meningkat secara drastis.\n\nMerasa kebingungan, kau memutuskan berlindung di istanamu, tak tahu apa yang harus dilakukan dengan bencana ini. Mereka mengatakan bahwa waktu akan menyembuhkan semua luka. \n\nSemoga kesabaranmu tidak menipis.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "Penyihir itu sudah pergi. Ada yang bilang dia bahkan meninggalkan desa, tidak ingin celaka seperti orang lain karenamu.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Tak lama setelah dia pergi. Situasi menjadi tak terkendali. Semua warga desa diliputi kesedihan yang mendalam.\n\nSiapa yang tahu berapa lama ini akan berlangsung?";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Ayo kirim penjaga untuk menangkapnya!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Penjagamu melakukan pencarian selama berjam-jam. Tidak ada hasilnya. Mereka semua pulang dalam kondisi sedih dan depresi. Namun, mereka mengatakan kalau mereka mendengar tentang si pencuri kebahagiaan, tetapi tidak pernah melihatnya.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Tak lama setelah para penjaga kembali, burung hantu datang membawa pesan dari penyihir.\n\nDia mengungkapkan bahwa pencuri kebahagiaan itu sebenarnya adalah hantu yang memakan kebahagiaan orang-orang, menyisakan kesedihan dan keputusasaan dalam hati mereka. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Terlepas dari upaya para ilmuwanmu untuk menunda prosesnya, seluruh desa tetap tidak bahagia. Dengan perginya penyihir itu, kau tidak punya cara lain lagi untuk membela diri melawan hantu ini. \n\nMari berharap waktu akan menyembuhkan para Townie.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "Seiring berjalannya waktu suasana hati desa kembali membaik. Pencuri kebahagiaan ini sekarang tinggal masa lalu.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Minta saran dari si penyihir.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Negosiasi.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Tuan, aku akan mencoba bernegosiasi dengan para ilmuwan ini. Biarkan aku melakukannya, aku akan mengurus semuanya!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Penasihatmu, juru runding yang baik ini telah berhasil menurunkan harga para ilmuwan! Bagus. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Aduh. Penasihatmu tak dapat bernegosiasi dengan benar. Para ilmuwan sekarang malah menaikkan harga mereka dan tak ingin berdiskusi lagi denganmu.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Bayar para ilmuwan.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Jika kita harus membayar, mari kita bayar, karena jika terus menunggu, itu akan menjadi bencana bagi kita.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Pendudukmu hanya menderita depresi, Gubernur. Mereka tidak dapat melihat sisi baik dari segala hal. \n\nSolusinya adalah menunjukkan kepada mereka sisi positif kehidupan dan membuktikan kepada mereka bahwa hidup tidak sesuram itu. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Mari kita mulai dengan menambahkan dekorasi dan membangun tempat festival minuman. Musik menaikkan moral. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "Suasana kota mulai membaik. Beberapa warga, yang kebahagiaannya hilang sebelumnya, nampak mulai menyadari tentang kebahagiaan hidup.\n\nNamun, pencuri kebahagiaan itu terus menanamkan ketakutan di hati orang-orang.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Pencuri kebahagiaan";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Sudah bertahun-tahun sejak kita meminta bantuan penyihir ini, Gubernur... Kuharap ini tidak membawa lebih banyak kesengsaraan ke desa kita daripada yang sudah kita alami.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Selamat pagi, Gubernur. Senang bertemu denganmu lagi. Jadi, kau dalam masalah?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Setelah menjelaskan situasinya kepada penyihir, dia hanya tersenyum. Apakah dia menemukan solusi untuk masalahmu atau dia mempermainkanmu?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Hei, bicaralah! Kenapa kau tersenyum seperti itu? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Pencuri kebahagiaanmu itu sebenarnya tidak ada, Tuan.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Tetapi pencuri kebahagiaan itu pasti benar-benar ada karena salah satu mata-mata kita celaka akibat bicara dengannya!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "Dia hanya melihat hantu kesedihan. Kadang-kadang muncul setelah pembangunan tempat keagamaan. Mereka adalah roh yang memakan kebahagiaan orang. \n\nDengan menyerap kebahagiaan, hantu itu memperoleh kekuatan dan meningkatkan kemampuannya. Sayangnya, orang-orang yang dicuri kebahagiaannya tidak bisa gembira lagi.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "Bagaimana kita menyingkirkannya?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Aku tahu solusinya, namun aku membutuhkan bantuanmu.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Kami akan membantumu. Apa yang kau butuhkan?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Kita membutuhkan kuburan mewah dan batu nisan.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "Anggap saja beres!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Kami sudah memenuhi permintaanmu, penyihir. Saatnya kau menunjukkan kepada kami apa yang bisa kaulakukan.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "Penyihir menuju ke kuburan mewah dan masuk ke dalamnya. Lalu kau mendengar mantra-mantra. Tiba-tiba, angin bertiup, masalah yang mengerikan tampaknya akan terjadi.\n\nPenyihir itu masih belum keluar dari kuburan mewah ini. \n\nKau tiba-tiba merasakan kesedihan yang luar biasa. Kau merasa sangat dingin dan dikelilingi kegelapan.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Kemudian, di kejauhan, seberkas sinar matahari. Sinar matahari yang sangat redup. Kau fokus padanya. Sinar ini menjadi makin intens. \n\nSinar matahari itu tampaknya membentuk suatu kenangan. Salah satu kenanganmu. Kenangan terindahmu.\n\nKau merasa senang kembali.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Gubernur... Apa itu tadi? Apa kau juga merasakannya?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Tuan, kau sekarang bebas dari hantu kesedihan. Dari ekspresimu, kurasa tadi kau sudah bertemu dengannya. Ini sudah berakhir sekarang. Dia sudah terkurung.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "Tadi mengerikan sekali! Terima kasih banyak!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "Desa sekarang terbebas dari hantu aneh ini. Penduduk telah mendapatkan kembali kebahagiaan mereka dan mereka berterima kasih kepadamu.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Tuan, jika kau tidak membantuku dalam proyek hantu ini, bisa kupastikan ini akan menjadi bencana bagimu.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "Coba saja kalau bisa! Pergi dari pandanganku bersama sihir jahatmu!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Biarkan mereka bermain.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Aku ingin main!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Festival permainan papan?! Ide yang aneh, Tuan. Bagaimana kita akan melakukannya? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Tuan, serdadu kita terlalu banyak bermain-main di menara pengawas sehingga warga tidak merasa terlindungi. Apa yang perlu kita lakukan?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Permainan Menara";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Kita membutuhkan kayu dan batu.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Kita perlu mencari ide dan perancang permainan.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Sumbangan sekadarnya bisa menaikkan reputasi kita di mata sang Raja, Tuanku";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Bangunlah menara jaga dalam jangkauan barak.";
"T_GAME_QUEST_WATER" = "Air";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Tolong diam!";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Mari kita mulai membangun sumur untuk mencegah kejadian seperti ini.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Oh Tuan, tolong, tanaman kita dalam bahaya. Jika kau tidak melakukan apa-apa, kita akan kehilangan kesempatan menjalani musim dingin yang damai.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "Gubernur sudah angkat bicara soal ini. Jika kau terus datang ke istana dan merengek, kami akan memenjarakanmu. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "… Kau akan kecewa tidak lama lagi!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "TUAN! LADANGNYA! Ini buruk! Tak ada yang tumbuh lagi, panasnya sangat menyengat sehingga tanaman kita rusak. Kau seharusnya lebih mempercayai petani itu.... Sekarang sudah terlambat.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Mari kita bergegas membangun sumur, Tuan.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "Pembangunan sumur telah selesai. Mencegah lebih baik daripada memperbaiki! Masa depan akan memberitahu apakah kita mengambil keputusan yang benar dengan mendengarkan petani ini.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Oh, Tuan! Para petani melaporkan bahwa gelombang panas melanda ladang mereka TAPI berkat pembangunan sumur, kita terhindar dari banyak masalah.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Tuan! Aku mendapatkan mimpi pertanda lainnya! Ladang terbakar. Tak ada yang bisa tumbuh lagi. Tak ada air yang tersedia.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Firasat";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Beri dia teh herbal untuk menenangkannya. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Bicara tentang teh herbal - kita akan menyebarkan ide itu. Biarkan kota-kota sekitarnya tahu bahwa air panas dengan herba dan slogan yang menarik itu bagus.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Tingkatkan pertahanan!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Mari kita tingkatkan pertahanan militer, Gubernur!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Kita telah melakukan hal yang luar biasa, "teh herbal yang membuatmu mudah tidur", adalah slogan inovatif…";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Mari kita tunggu sekarang... Sejauh yang kita tahu, kita repot-repot seperti ini untuk hal yang sia-sia. Kita seharusnya memberinya teh herbal...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Terlepas dari anggapanmu, serta peningkatan pertahanan jika terjadi serangan mendadak oleh bandit, mereka tidak pernah datang. Namun, kau sekarang memiliki beberapa bangunan militer yang indah untuk dikagumi.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Oh tidak, Tuan. Wanita tua itu melakukannya lagi! Dia berteriak dari atap bahwa penyihir hutan akan melewati desa kita dan menghancurkan semua yang dilewatinya.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "Jalan Penyihir";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Tuan! \n\nDi sana luar biasa! Danau yang luas dan indah! \n\nWanita itu ada di sana! Aku mengejarnya sejauh satu kilometer di terowongan tambang, sebelum aku kehilangan jejaknya.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "Kemudian... saat kukira aku akan pulang dengan tangan kosong, aku melihat ribuan cahaya. Oh Tuan, kau seharusnya melihat itu, aku belum pernah melihat yang seperti itu! \n\nDia memberitahuku tentang rencananya untuk melarikan diri dengan semua harta karun itu dan memulai hidup baru di tempat lain. Sejak kematian suaminya, dia kesulitan tinggal di sini, terlalu banyak kenangan…";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Tuan, kita sekarang siap memasuki tambang untuk mencari harta karun. Ada beberapa tanda silang di peta.\n\nDi mana sebaiknya kita memulai? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Tempat Persembunyian Utara";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Tempat Persembunyian Selatan";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "TUAN! Kita beruntung! Tim kami berhasil melarikan diri tanpa cedera. Terowongan itu runtuh!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "Hasil ekspedisi pertama ini sangat memuaskan! Orang-orangmu berhasil kembali dengan selamat dari ekspedisi ini dan dengan membawa sebagian harta bajak laut sebagai bonus.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Tuan, sekarang kita siap memasuki tambang untuk kedua kalinya.\n\nTempat persembunyian mana yang harus kita periksa?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Tempat Persembunyian Timur";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Tempat Persembunyian Barat";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "Kita mendapatkan kesempatan yang luar biasa, Tuan! Sudah dua kali kita berhasil dalam perburuan harta karun ini!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Kau dengan hati-hati mempelajari peta tambang. Kau bisa melihat lokasi danau bawah tanah yang dialiri sungai yang mengarah langsung ke laut. Akses yang sangat berguna bagi bajak laut!\n\nNamun, terowongan ini tidak aman dan mungkin runtuh kapan saja.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "Kabar baik! Selagi kau membantu pandai besi ini, penasihatmu berhasil mendapatkan peta tambang.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Amankan tambang.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Kirim pengintai ke tambang ini!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Mari kita berinvestasi untuk tambang ini agar bisa aman, Tuan. Ini adalah tugas yang membutuhkan banyak sumber daya kita, tetapi kujamin kau tak akan menyesalinya.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "Luar biasa, Tuanku! Kita berhasil mengamankan tambang! Pengintai pertama kita berpatroli dan menemukan si istri bajak laut!\nDia berhasil melarikan diri, tetapi dia meninggalkan peta tambang dengan tanda silang. Kupikir ini adalah tempat harta karun itu disembunyikan!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Yang harus kita lakukan sekarang adalah membayar upeti, Tuan.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Pengintai, pengintai... Kita tidak memiliki 50! Aku akan melakukannya sendiri. Namun, aku setidaknya membutuhkan perlengkapan tertentu dulu.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Baiklah, aku sudah siap!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Penasihatmu pergi ke tambang untuk mencari tahu lebih banyak tentang wanita ini.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Bawakan aku perlengkapan yang diperlukan agar misi ini sukses.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Kau tiba-tiba kehilangan kesabaran dengan pandai besi ini. Kau memerintahkannya untuk menyediakan perlengkapan ini sesegera mungkin dan pesanan mendesaknya bukan urusanmu. Kau tak peduli jika dia bangkrut.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Aku... Aku akan membawakannya kepadamu sesegera mungkin, Tuan...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Kau tidak sopan menolak membantu pandai besi ini. Kau harus mengerti, dia harus bekerja untuk mencari nafkah dan pesanan ini tampaknya sangat penting bagi perekonomian kotamu. Aku harap dia tidak akan menyimpan dendam kepada kita.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Aduh, Tuan.... Kau seharusnya lebih berhati-hati. Pandai besi menyebarkan ke semua orang tentang perlakuanmu kepadanya. Beberapa townie sekarang berdemo. Dan pandai besi menolak untuk kembali ke istana.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Tuan, aku tak melihat alternatif selain membangun arena pertarungan. Ini akan mengalihkan perhatian orang-orang dan memungkinkan mereka untuk melepaskan ketegangan.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Warga terlihat sudah lebih tenang. Namun, kita belum selesai dengan cerita bajak laut ini!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Tuan, arena pertarungan diperlukan. Jika tidak, townie tak akan bahagia atau produktif. Pemogokan ini akan membuang-buang waktu berharga hanya untuk urusan bajak laut dan tambang ini.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Tuan, selagi kita sibuk dengan pemberontakan ini, si istri bajak laut mencuri kesempatan untuk mengambil kembali harta yang ada di tambang. Di situlah harta karun itu berada!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Mata-mata kita menemukan catatan dari wanita ini yang mengatakan bahwa dia tidak tahan lagi dengan ketidakhadiran suaminya dan bahwa dia akan mengasingkan diri sebentar di pulau surgawi tempat istana kecilnya berada.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Sepertinya kita melewatkan lumayan banyak uang, Tuan. Lihat bagaimana hasil dari keputusan tergesa-gesamu? Setidaknya sekarang kita terbebas dari masalah ini.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Mari kita bangun arena pertarungan.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Kau salah mengambil keputusan seperti ini dengan enteng, Tuan. Siapa yang tahu apa yang mungkin kita temukan?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Beberapa hari setelah kau menolak untuk menangani keluhan ini, tambang itu runtuh. Rakyatmu menganggap kau bertanggung jawab atas peristiwa tragis ini.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "Rakyatmu mulai melupakan peristiwa tambang yang runtuh ini. Waktu berlalu dan moral mereka tinggi.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Kita tidak dapat mengakses lokasi yang ditunjukkan pada peta, Tuanku. Kita tidak dapat membawa pulang harta apa pun. Namun, kita hidup, itu yang terpenting.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Terlepas dari kegagalanmu, petualangan ini telah memberimu beberapa prestige. Siapa sangka bajak laut bisa menyembunyikan harta karun seperti itu di tambangmu?\n\nUntuk sekarang, kariermu sebagai pemburu harta karun telah berakhir.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Tuan, aku diberitahu bahwa terowongan di tambang telah runtuh! Kita beruntung bisa kembali dua kali dengan membawa harta karun.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Untuk sekali ini, kau memutuskan untuk mengadakan jamuan besar untuk serdadumu sebagai ucapan terima kasih kepada mereka karena telah membawakanmu harta karun.\n\nKisah bajak laut ini sekarang sudah jauh di belakangmu. Siapa yang tahu? Mungkin suatu hari kau akan menemukan peta yang akan membawamu ke misteri lain.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "Harta karun itu akan segera menjadi milikmu! \n\nKau memerintahkan serdadumu untuk mencari harta karun ini dan membawanya kembali kepadamu.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "Sulit dipercaya! Lihat semua yang kita temukan di tambang itu! Kau mengambil keputusan tepat dengan mengamankan tambang sebelum mengirim orang-orangmu ke sana. Ini harta yang luar biasa! Desas-desus tentang bajak laut itu ternyata benar. Kita kaya sekarang!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Dengan informasi yang kita miliki, tidak banyak yang bisa kita lakukan. Akan lebih bijaksana jika kita mencari seorang ahli untuk meminta masukan.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Panggil seorang penambang.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "Itu ide bagus, Tuan. Mungkin mereka bisa memberi kita peta tambang dan membantu kita memahami lebih dalam.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Tuan, aku senang kau memintaku untuk membantu. Aku membawa peta tambang. Aku harap ini akan membantumu.\n\nTerowongan ini sudah tua dan aku khawatir akan runtuh.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Panggil pandai besi.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Pandai besi pasti bisa memberi kita informasi tentang bebatuan yang ingin dihancurkan wanita ini.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Tuan, kita menerima beberapa keluhan tentang tambang.\nSeorang wanita pergi ke sana setiap hari, dia memindahkan bebatuan, terkadang memecahkannya. Namun, yang pasti dia selalu masuk makin jauh ke dalam terowongan.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Cari tahu tentang wanita ini.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "Ini bukan urusanku.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Townie khawatir, terowongan tidak aman dan tambang bisa runtuh kapan saja.\n\nMerupakan tugas kita untuk memeriksa yang sebenarnya terjadi di balik cerita ini.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Semoga kau bisa mengambil pelajaran dari peristiwa ini!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Selagi penasihatmu mencari petunjuk, merupakan ide bagus bagimu untuk mengurus kotamu untuk sementara. Berusahalah untuk meningkatkan taraf hidup rakyatmu.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "Ini aku lagi, Tuan! Aku mengikuti wanita ini dalam operasi mata-mata. Ini tidak mudah.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Sepertinya dia sedang mencari sebuah benda. Aku melihatnya memecahkan bebatuan dan memeriksa puing-puingnya dengan hati-hati.\n\nSayangnya, aku tidak bisa mengikutinya terlalu jauh. Dia sepertinya sangat mengenali kondisi tambang!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Penasihatmu telah kembali dari misinya dengan membawa berita.\nDalam laporannya, disebutkan bahwa wanita ini baru saja menjadi janda. \n\nSuaminya adalah bajak laut yang sangat terkenal. Dikatakan bahwa dia memiliki harta terbesar sepanjang masa dan menyembunyikannya tidak jauh dari sini.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Aku punya teori, Tuanku. Aku pikir wanita ini diancam oleh bajak laut lain untuk mengungkapkan lokasi harta tersebut!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Lanjutkan penyelidikan.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Biarkan saja.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "Wanita dan tambang";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "Pandai besi datang dengan tergesa-gesa. Penjagamu menariknya keluar dari bengkelnya. Dia tampaknya sibuk.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Tuan, apa yang bisa kulakukan untukmu?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Kami sedang menjalankan misi dan kami membutuhkan keahlianmu.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Aku mendengarkan.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Penasihatmu menjelaskan kasus ini kepada pandai besi.\n\nDia juga menunjukkan pecahan bebatuan yang bisa dia ambil. Kau dapat melihat dari sudut matamu bahwa si pandai besi sepertinya mengenali jenis batu ini.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Astaga! Itu batu-batu geode!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Geode, katamu? ";
