"T_GAME_QUEST_SCEN15_15_TITLE" = "Sumbangkan peralatan untuk para pekerja.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Penduduk kota masih kelaparan, Tuanku. Jika tidak disediakan makanan untuk mereka, suasana hati mereka pasti segera memburuk.";
