"T_GAME_QUEST_SCEN15_16_TITLE" = "Berikan makanan untuk penduduk kota.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "Ketidakpuasan semakin meluas. Tuanku harus segera mengambil tindakan! ";
