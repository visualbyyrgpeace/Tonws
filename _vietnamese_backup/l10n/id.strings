"T_TUTORIAL_01_WELCOME_01" = "Aku bukan pesuruh biasa! Aku adalah penasihat Penguasa dan membantunya menjalankan tugasnya sehari-hari.";
"T_TUTORIAL_01_WELCOME_02" = "Terserah...";
"T_TUTORIAL_01_WORKERPAGE_HINT" = "Untuk membebaskan pekerja, pilih simbol "tidur".";
"T_TUTORIAL_02_ASSIGN_TITLE" = "Tugaskan pekerja ke bangunan.";
"T_TUTORIAL_02_BAKERY_01_STARTED" = "Jika kau membangun toko roti, kita bisa mulai mengolah tepung menjadi roti, Tuanku.";
"T_TUTORIAL_02_BAKERY_01_SUCCESS" = "Bagus sekali, Tuanku. Sekarang, rantai produksi roti kita sudah selesai. Makanan tak akan menjadi masalah untuk sementara waktu. Kita sekarang punya waktu untuk mempersiapkan kota untuk musim dingin.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_01" = "Ketika persediaan bangunan penuh, produksi di bangunan itu terhenti sampai ada ruang untuk menyimpan barang lagi, Tuanku.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_01_NEW" = "Ketika persediaan bangunan penuh, produksi di bangunan itu berhenti sampai ada ruang untuk menyimpan barang lagi.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_02" = "Ketika banyak persediaan bangunan terlalu penuh, sebaiknya kita menugaskan lebih banyak pengangkut di istana atau gudang untuk menghindari terhentinya seluruh rantai produksi.";
"T_TUTORIAL_02_CONSTRUCTION_HINT" = "Untuk mempercepat proses pembangunan, kau bisa memerintahkan pekerja kedua untuk membantu membangunnya, Tuanku.";
"T_TUTORIAL_02_DEASSIGN_TITLE" = "Alihtugaskan pekerja dari bangunan.";
"T_TUTORIAL_02_ERASE_STARTED" = "Gunakan mode hapus untuk membersihkan area pohon dan objek yang menghalangi.";
"T_TUTORIAL_02_ERASE_STARTED_OLD" = "Toko roti harus ditempatkan di dekat pertanian dan kincir angin, Tuanku.";
"T_TUTORIAL_02_ERASE_TREES" = "Hapus objek yang menghalangi dengan mode hapus.";
"T_TUTORIAL_02_ERASE_TREES_OBJECTIVE" = "Hapus objek";
"T_TUTORIAL_02_FREE_WORKERS_01" = "Tuanku, kita tak punya pekerja menganggur lagi. Kau harus mempertimbangkan untuk membangun rumah tinggal baru.";
"T_TUTORIAL_02_FREE_WORKERS_02" = "Dengan rumah tinggal baru, kita mendapatkan lebih banyak pekerja untuk desa.";
"T_TUTORIAL_02_FREE_WORKERS_03" = "Untuk pembangunan, kau juga bisa mengalihtugaskan pekerja dari bangunan lain dan langsung menugaskannya ke lokasi pembangunan.";
"T_TUTORIAL_02_FREE_WORKERS_04" = "Selain itu, kita juga bisa menggunakan Prestige untuk menyelesaikan pembangunan dengan cepat. Hal ini bisa dilakukan melalui menu kontekstual lokasi pembangunan.";
"T_TUTORIAL_02_INTRO_STARTED" = "Selamat pagi, Tuanku. Kau tak bisa rebahan di tempat tidur sepanjang hari.";
"T_TUTORIAL_02_INTRO_SUCCESS" = "Kau kedatangan tamu. Seorang bangsawan telah tiba di istana. Dia bilang kalian berdua saling kenal dari istana Raja dan ingin bertemu.";
"T_TUTORIAL_02_MAINQUEST_OBJECTIVE_01" = "Siapkan persediaan makanan.";
"T_TUTORIAL_02_MAINQUEST_STARTED" = "Tuanku, kita tak punya cukup makanan di kota kita. Satu-satunya nelayan kita tak akan sanggup memberi makan seluruh kota di musim dingin. Kusarankan untuk memulai produksi roti.";
"T_TUTORIAL_02_MAINQUEST_SUCCESS" = "Bagus sekali, Tuanku. Kota ini siap menghadapi musim dingin. Warga desa akan senang mendengar hal ini.\n\nIkutlah denganku, Nyonya Fitz-Givens telah menyiapkan hidangan besar untukmu, Tuanku.";
"T_TUTORIAL_02_MAINQUEST_TITLE" = "Hasilkan makanan yang cukup untuk musim dingin yang akan datang.";
"T_TUTORIAL_02_NOBLEMAN_01_STARTED" = "Selamat pagi, Gubernur! Ingat aku? Kita bertemu sekali di istana Raja...";
"T_TUTORIAL_02_NOBLEMAN_01_SUCCESS" = "Apakah warga desa di kota ini tahu bahwa kau dilarang masuk ke istana Raja? Kupikir mereka akan sangat kecewa jika mereka tahu, bukan?";
"T_TUTORIAL_02_NOBLEMAN_02_STARTED" = "Sudah kukira!";
"T_TUTORIAL_02_NOBLEMAN_02_SUCCESS" = "Hmm... Tindakanmu di istana akan menjadi rahasia kecil kita. Untuk saat ini. Sampai jumpa, Gubernur.";
"T_TUTORIAL_02_NOBLEMAN_03_SUCCESS" = "Tuanku! Jika warga desa mendengar tuduhan yang menimpamu, mereka pasti akan memasukkan kita ke penjara...";
"T_TUTORIAL_02_NOBLEMAN_04_STARTED" = "Aku tahu, Tuanku... Kita tak mengambil uangnya. Tuduhan itu semuanya salah, tetapi tak ada seorang pun yang mengetahui hal ini, kecuali kita dan si bangsawan.";
"T_TUTORIAL_02_NOBLEMAN_04_SUCCESS" = "Orang ini bisa memeras kita. Kita harus hati-hati mengambil keputusan...";
"T_TUTORIAL_02_QUESTS_HINT_STARTED" = "Gambaran umum dari semua tugas saat ini tersedia di tab "misi" di menu. Di sana, hadiah untuk tugas yang sudah selesai juga bisa diambil.";
"T_TUTORIAL_02_STOCK_HINT_STARTED" = "Gambaran rinci tentang sumber daya yang tersimpan di kota tersedia di bagian "gudang" di menu.";
"T_TUTORIAL_02_WELCOME_01_SUCCESS" = "Ada beberapa warga desa yang punya permintaan dan menunggumu di ruang pertemuan, Tuanku. Aku percaya mereka ingin bicara denganmu tentang pasokan makanan di kota.";
"T_TUTORIAL_02_WINDMILL_01_REWARD" = "Petani itu sangat senang kau telah membangun kincir angin dan mengirimkan rasa terima kasihnya padamu. Dia memberikan sejumlah barang untukmu.";
"T_TUTORIAL_02_WINDMILL_01_STARTED" = "Tuanku, aku adalah petani lokal. Pertanian di kaki bukit ini adalah milikku. Karena kincir angin terbakar di musim lalu, gandumku tak diproses sama sekali. Aku akan sangat berterima kasih jika kincir anginku bisa dibangun kembali.";
"T_TUTORIAL_02_WINDMILL_02_SUCCESS" = "Bagus sekali, Tuanku. Sekarang, kita bisa mengolah gandum menjadi sesuatu yang lebih enak dimakan. Tepung bisa diolah menjadi roti di toko roti.";
"T_TUTORIAL_02_WINDMILL_03_SUCCESS" = "Kincir angin menghasilkan tepung dari gandum. Tak ada ruginya memerintahkan beberapa petani untuk selalu memasok sebuah kincir angin.";
"T_TUTORIAL_02_WORKERS_ASSIGN_STARTED" = "Tuanku, kita butuh batu untuk pembangunan sejumlah bangunan maju.\n\nKau perlu mempertimbangkan untuk menugaskan seorang pekerja ke tambang. Dengan begini, kita bisa menghasilkan sendiri sumber daya yang diperlukan.";
"T_TUTORIAL_03_CLIENT_MARKETBUILT_STARTED" = "Luar biasa, Tuanku. Makin banyak keinginan yang kaupenuhi, makin tinggi kesediaan Townie untuk membayar pajak yang lebih tinggi tanpa harus takut terjadi pemberontakan.";
"T_TUTORIAL_03_CLOTHING_QUEST_DESC" = "Warga desa kita menginginkan pakaian untuk mereka pakai, Tuanku.\n\nKau harus memerintahkan pembangunan penjahit. Penjahit nantinya bisa menghasilkan pakaian dari kain.";
"T_TUTORIAL_03_CLOTHING_QUEST_SUCCESS" = "Bagus sekali, Tuanku. Sekarang, kita memuaskan keinginan warga desa akan pakaian. Pakaian bisa diperoleh warga desa melalui pasar.";
"T_TUTORIAL_03_CLOTHING_QUEST_TITLE" = "Dapatkan kepuasan tinggi dengan pakaian.";
"T_TUTORIAL_03_INTRO_SUCCESS" = "Tuanku, gedung kas hampir kosong. Kau harus melakukan sesuatu atau kita berisiko tak bisa membayar utang!\n\nTanpa koin, kita tak akan bisa menjalankan tugas-tugas kita dan kota tak akan berkembang.";
"T_TUTORIAL_03_MAINQUEST_CONV_01" = "Warga desa kita punya kebutuhan lain selain kebutuhan dasar berupa makanan dan air, Tuanku. ";
"T_TUTORIAL_03_MAINQUEST_CONV_02" = "Mereka juga punya keinginan lain, seperti pakaian baru untuk mereka pakai, kota yang didekorasi dengan baik, atau pasar untuk membeli barang.";
"T_TUTORIAL_03_MAINQUEST_DESC" = "Warga desa punya beberapa permintaan. Pakaian baru dan pasar menjadi prioritas mereka.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_01" = "Selesaikan tugas perempuan muda.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_02" = "Selesaikan tugas pedagang.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_03" = "Selesaikan urusan dengan bangsawan.";
"T_TUTORIAL_03_MAINQUEST_SUCCESS" = "Tuanku, kau sangat rajin. Kota ini tumbuh dengan mantap dan kita bahkan punya cukup pakaian untuk musim dingin. Aku bisa melihat bahwa kita sekarang punya Gubernur yang berbakat dan peduli.\n\nAku telah menyiapkan pesta untuk menghormatimu, Tuanku. Ikuti aku.";
"T_TUTORIAL_03_MAINQUEST_TITLE" = "Penuhi permintaan warga desa.";
"T_TUTORIAL_03_MAKE_PROFIT" = "Cari untung dengan berdagang.";
"T_TUTORIAL_03_MARKETPLACE_CONST_TOOLTIP" = "Pilih lokasi pembangunan tetap dan bangun pasar di sana.";
"T_TUTORIAL_03_MARKET_TOOLTIP" = "Bangunan umum, seperti pasar, atau bahkan sumur kita, hanya bisa memasok warga desa dalam jumlah yang terbatas. ";
"T_TUTORIAL_03_MARKET_TOOLTIP_02" = "Dalam menu pembangunan atau menu kontekstual bangunan, kau bisa melihat berapa banyak keluarga yang bisa masuk ke dalam bangunan umum.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT" = "Untuk melakukan perdagangaan, kunjungi menu di dalam game, kemudian tab untuk persediaan. Ada sub kategori bernama perdagangan. Perdagangan hanya bisa dilakukan ketika ada pedagang yang datang ke desa. Gerobak pedagang akan terlihat di depan istana.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT_SHORT" = "Untuk berdagang, kunjungi menu di dalam game, kemudian tab untuk persediaan. Ada sub kategori bernama perdagangan.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_TOOLTIP" = "Atau, kamu juga bisa berdagang dengan mengunjungi menu kontekstual bangunan pasar itu sendiri ketika seorang pedagang berada di desa.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_STARTED" = "Tuanku, aku adalah pedagang lokal. Sama seperti perempuan muda cantik sebelumnya, aku juga punya permintaan.\n\nKota kita perlu pasar. Dengan ini, kamu... dan juga diriku... bisa membeli atau menjual sumber daya.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_SUCCESS" = "Tampaknya warga desa kita menginginkan pakaian baru. Pasar akan memungkinkanmu untuk membeli pakaian. Kau tak perlu memproduksinya sendiri, Tuanku.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_TITLE" = "Terima sumber daya.";
"T_TUTORIAL_03_MERCHANT_MARKET_STARTED" = "Tuanku, aku mengambil inisiatif membeli sebidang tanah dan menempatkan fondasi untuk pasar yang baru.\n\nApakah kau bersedia memerintahkan seorang pekerja untuk menyelesaikan pembangunannya?";
"T_TUTORIAL_03_MERCHANT_MARKET_SUCCESS" = "Di pasar, kita bisa mendistribusikan barang-barang mewah dari gudang. Dengan demikian, kita bisa memuaskan keinginan townie yang kaya, Tuanku.";
"T_TUTORIAL_03_MERCHANT_OFFER_STARTED" = "Bukan rahasia lagi bahwa gedung kas kota cukup menipis, tetapi karena aku ingin melihat kota ini berkembang, aku akan membayar di muka biaya pembangunan pasar.\n\nAnggap saja ini investasi untuk masa depan kota tercinta kita.";
"T_TUTORIAL_03_MERCHANT_TIMER_TOOLTIP" = "Di sini, kamu bisa melihat berapa lama seorang pedagang berada di desa untuk berdagang denganmu.";
"T_TUTORIAL_03_SHEPHERD_QUEST_DESC" = "Tuanku, untuk menghasilkan wol, kau harus mengirim pekerja tambahan ke peternakan untuk bekerja sebagai penggembala. Aku sibuk memanen gandum, jadi aku butuh seseorang untuk membantuku mengurus domba.";
"T_TUTORIAL_03_SHEPHERD_QUEST_SUCCESS" = "Bagus, Tuanku. Sekarang, kita bisa memanen wol, bukan cuma gandum.";
"T_TUTORIAL_03_SHEPHERD_QUEST_TITLE" = "Tugaskan penggembala ke peternakan.";
"T_TUTORIAL_03_TAILOR_QUEST_DESC" = "Sekarang, dengan adanya tempat penenunan di kota, yang menghalangi kita memproduksi pakaian tinggal toko penjahit yang belum ada, Tuanku.";
"T_TUTORIAL_03_TAILOR_QUEST_SUCCESS" = "Bagus sekali, Tuanku. Sekarang, kita bisa memulai produksi pakaian. Warga desa akan senang sekali! Kita punya industri pakaian kita sendiri.";
"T_TUTORIAL_03_TRIBUTE_DESC" = "Gubernur! Aku memikirkan tentang kota kecilmu yang lemah dan keberadaanmu yang menyedihkan akhir-akhir ini. Aku menyimpulkan bahwa jika kau tak ingin aku menyebarkan kabar tentang dicabutnya gelar penguasamu, kau harus memberiku uang tutup mulut.\n\nBiaya tutup mulut untukku adalah pembayaran koin secara berkala dan pembayaran pertamanya jatuh tempo sekarang!";
"T_TUTORIAL_03_TRIBUTE_SUCCESS" = "Kau membuatku menunggu terlalu lama! Waktumu habis. Apa kau akan membayarku sekarang, atau haruskah kupanggil penjaga?";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_1" = "... akhirnya dia pergi.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_2" = "Tuanku, kita harus berpikir tentang bagaimana caranya kita akan menghadapi musuh ini di masa depan. Dia akan terus datang kembali dan memeras kita lagi dan lagi.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_3" = "Mungkin kita harus berusaha memulihkan nama baik kita lagi dan membuktikan bahwa kita tak ada hubungannya dengan pencurian di gedung kas nasional Raja.";
"T_TUTORIAL_03_TRIBUTE_TITLE" = "Pembayaran upeti";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_DESC" = "Tuanku, jika kau memutuskan untuk memproduksi pakaian di kota, kita perlu tempat penenunan untuk memproduksi kain dari wol.";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_SUCCESS" = "Bagus, Tuanku. Kulihat pembangunan tempat penenunan sudah selesai. Sekarang, produksi kain bisa dimulai.\n";
"T_TUTORIAL_03_WOMAN_INQUIRY_STARTED" = "Selamat siang, Tuanku!\n\nAku punya permintaan khusus dari townie. Beberapa warga desa yang kaya raya menginginkan pakaian yang lebih baik untuk membedakan diri mereka dari rakyat biasa.\n\nApakah kau bersedia untuk menyediakan pakaian di pasar?   ";
"T_TUTORIAL_04_AVALANCHE_STARTED" = "Ini, lempar botol ke bangunan demi keberuntungan, Tuanku...";
"T_TUTORIAL_04_AVALANCHE_STARTED_2" = "Apa kau dengar suara itu? Apa itu ya...";
"T_TUTORIAL_04_AVALANCHE_SUCCESS" = "Apakah kau baik-baik saja, Tuanku?! Tadi itu adalah longsoran salju! Setidaknya kedai minum kita masih berdi...";
"T_TUTORIAL_04_COALBURNER_STARTED" = "Tuanku, kayu bakar normal di kastel tak sanggup menjaga bangunan besar ini tetap hangat. Dengan batu bara, kita tak hanya bisa memanaskan rumah kita, tetapi kau juga bisa mengolahnya menjadi bijih dan batang besi. \n\nApakah kau bersedia membangun pondok perapian batu bara?";
"T_TUTORIAL_04_COALBURNER_STARTED_02" = "Batu bara pada intinya digunakan dalam produksi besi dan emas batangan. Apa kau bersedia membangun pondok perapian batu bara agar kita bisa menghasilkan batu bara dari kayu?";
"T_TUTORIAL_04_COALBURNER_SUCCESS" = "Akan lebih bijaksana jika kita meningkatkan produksi kayu karena penambahan produksi arang akan mengonsumsi banyak persediaan kayu.";
"T_TUTORIAL_04_COUNTDOWN_STARTED" = "Tuanku, kita harus bertahan selama musim dingin ini sampai musim semi tiba.";
"T_TUTORIAL_04_COUNTDOWN_SUCCESS" = "Untunglah! Musim dingin yang buruk ini akhirnya berakhir. Kita bisa segera menanam tanaman lagi, Tuanku!";
"T_TUTORIAL_04_COUNTDOWN_TITLE" = "Tunggu sampai musim semi.";
"T_TUTORIAL_04_EXTINGUISH_FAIL" = "Bangunan telah terbakar habis, Tuanku.";
"T_TUTORIAL_04_EXTINGUISH_STARTED" = "Kebakaran! Tuanku! Ada kebakaran! \n\nKau harus melakukan sesuatu! Kenapa kita tak punya menara pemadam kebakaran di kota?";
"T_TUTORIAL_04_EXTINGUISH_SUCCESS" = "Terima kasih banyak, Tuanku. Kau benar-benar penyelamat.";
"T_TUTORIAL_04_FOOD_HINT_WINTER" = "Tuan, kita kehabisan makanan. Sangat sulit untuk memberi makan warga desamu di musim dingin.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_01" = "Bangun kembali kedai minum.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_02" = "Tunggu sampai musim semi.";
"T_TUTORIAL_04_MAINQUEST_SUCCESS" = "Tuanku. Kau telah memimpin kota ini melalui musim dingin yang sangat sulit. Townie sedang mempersiapkan perayaan kecil untukmu di musim semi.";
"T_TUTORIAL_04_MAINQUEST_TITLE" = "Berhasil melewati musim dingin.";
"T_TUTORIAL_04_MINE_STARTED" = "Tambang batu kita hancur oleh longsoran salju, tetapi ada cadangan bijih besi di timur kota. Sepertinya ini lokasi bagus untuk tambang baru.";
"T_TUTORIAL_04_MINE_SUCCESS" = "Bagus sekali, Tuanku. Selain bijih besi, tambang ini juga bisa menambang batu. Setelah pembangunan, pekerja akan langsung mulai menambang bijih. Tetapi, kau juga bisa memberinya perintah untuk menambang batu.\n";
"T_TUTORIAL_04_MINE_TITLE" = "Bangun tambang di cadangan bijih di timur kota.";
"T_TUTORIAL_04_START_NEXT_STARTED" = "...sial... kedai minum baru kita... itu tak berjalan sesuai rencana...!?!";
"T_TUTORIAL_04_START_NEXT_SUCCESS" = "Untuk membangun kembali kedai minum, kita butuh alat. Sayangnya, suplai alat kita benar-benar habis untuk pembangunan kedai minum yang lama.";
"T_TUTORIAL_04_TAVERN_STARTED" = "Tuanku, akhirnya kita bisa membangun kembali kedai minum itu. Ini akan meningkatkan kebahagiaan warga desa secara drastis.";
"T_TUTORIAL_04_TAVERN_SUCCESS" = "Bagus, Tuanku. Kota kita akhirnya punya kedai minum lagi dan warga desa bisa bersantai di sini setelah bekerja. \n\nTentu saja, kedai minum akan jauh lebih efisien jika disuplai dengan minuman, seperti minuman atau jus. Namun, ini musim dingin, jadi kita tak bisa menghasilkan minuman atau jus sendiri, tetapi kita bisa membeli bahan-bahannya di pasar.";
"T_TUTORIAL_04_TAVERN_SUCCESS_02" = "Tentu saja, kedai minum akan jauh lebih efisien jika disuplai dengan minuman, seperti minuman atau jus. Namun, ini musim dingin dan kita tak bisa menanam anggur atau hop, tetapi kita bisa membelinya di pasar.";
"T_TUTORIAL_04_TOOLMAKER_STARTED" = "Karena sekarang kita bisa memproduksi batu bara, kita bisa menggunakan bengkel tukang perkakas, Tuanku. Kemudian, kita bisa menghasilkan alat kita sendiri dan akan lebih mandiri.";
"T_TUTORIAL_04_TOOLMAKER_SUCCESS" = "Hebat! Sekarang, rantai produksi kita untuk alat sudah selesai.";
"T_TUTORIAL_04_TOWNHOUSE_STARTED" = "Tuanku! Sebuah rumah tinggal hancur oleh longsoran salju. Kita harus segera membangunnya kembali sebelum warga desa kita meninggalkan kota.";
"T_TUTORIAL_04_TOWNHOUSE_SUCCESS" = "Bagus sekali, Tuanku. Sekarang, kita bisa berkonsentrasi untuk pembangunan kembali kedai minum.";
"T_TUTORIAL_04_TOWNHOUSE_TITLE" = "Membangun rumah tinggal besar atau kecil.";
"T_TUTORIAL_04_TRADE_CLOTHES_STARTED" = "Tuanku, keluargaku kedinginan. Kami perlu pakaian yang lebih baik. Apakah kau bersedia mengirim beberapa pakaian ke rumahku?";
"T_TUTORIAL_04_TRADE_CLOTHES_SUCCESS" = "Kulihat kau punya cukup persediaan pakaian untuk kami. Terimalah, kami telah mengumpulkan beberapa alat dan koin yang kami simpan untuk saat-saat seperti ini. Aku berterima kasih kepadamu.";
"T_TUTORIAL_04_WELCOME_SUCCESS" = "Hari yang menyenangkan, Tuanku. Sedikit dingin, tetapi cukup bagus. Akhirnya pembangunan kedai minum baru selesai. Mari kita pergi ke pesta pembukaannya.";
"T_TUTORIAL_05_ADVISOR_TALKS_01" = "Tuanku, kita harus memerintahkan seseorang untuk mengikuti dan memata-matai orang itu! Dia sangat mencurigakan.";
"T_TUTORIAL_05_ADVISOR_TALKS_02" = "Mengapa kau memandangku dengan tatapan yang aneh, Tuanku? ";
"T_TUTORIAL_05_ADVISOR_TALKS_03" = "...Oh ayolah... jangan aku lagi, Tuanku! Bisakah aku setidaknya diberi semacam penyamaran kali ini?";
"T_TUTORIAL_05_ADVISOR_TALKS_04" = "Apa? Kostum hewan? Aku tak mau memakainya... ini menjijikkan...";
"T_TUTORIAL_05_ARMORY_CONV_01" = "Tuanku! Tanpa gudang senjata, kita tak bisa menghasilkan senjata atau baju zirah. Kau harus memerintahkan pembangunan gudang senjata sesegera mungkin.";
"T_TUTORIAL_05_BANDITS_SIGHTED" = "Tuanku, pengintai melaporkan bahwa bandit berkeliaran di daerah itu. Kita harus hati-hati, mereka mungkin menyerang kota...";
"T_TUTORIAL_05_BANDIT_ATTACK_01" = "Apa kau benar-benar berpikir aku tak akan menyadari mata-mata bodohmu dalam kostum jelek itu, Gubernur?";
"T_TUTORIAL_05_BANDIT_ATTACK_02" = "Mulai sekarang, aku akan mengunjungi kotamu dari waktu ke waktu. Mari kita lihat apakah kau punya barang untukku...";
"T_TUTORIAL_05_CARPENTER_SUCCESS_CONV_01" = "Bagus sekali, Tuanku. Sekarang, tukang kayu akan mengurus semua bangunan yang rusak selama ada cukup sumber daya yang tersedia.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_DESC" = "Raja mengirim perwakilan khusus ke kotamu untuk menyelidiki perampokan di gedung kas ibu kota. Kau sekarang menjadi tersangka utamanya.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_TITLE" = "Perwakilan Raja akan segera tiba.";
"T_TUTORIAL_05_GEOLOGIST_ASSIGN" = "Untuk menugaskan ahli geologi ke tambang, pilih kaca pembesar.";
"T_TUTORIAL_05_HERB_GARDEN_CONV" = "Tuanku, aku bisa membuat beberapa kamuflase rumput untuk penyamaran, tetapi aku butuh kebun herba di dekat pertanianku untuk melakukannya.";
"T_TUTORIAL_05_HERB_GARDEN_DESC" = "Untuk memanen herba, kita memerlukan kebun herba. Herba bisa dipanen oleh petani. Dianjurkan untuk membangun kebun herba di sebelah pertanian.";
"T_TUTORIAL_05_HERB_GARDEN_TITLE" = "Bangun kebun herba.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_DESC" = "Untuk membuat penyamaran yang bagus untuk si penasihat, kau harus mencarikan sejumlah kulit dan rumput liar untuk penyamarannya. Beberapa pakaian sebagai lapisan pertama juga bagus.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_TITLE" = "Buat penyamaran.";
"T_TUTORIAL_05_KNIGHT_02_CONV_01" = "Gubernur! Aku butuh sudut pandang yang lebih baik ke kota dan hutan di sekitarnya kalau-kalau bandit menyerang lagi. Lakukan segera, ini perintah!";
"T_TUTORIAL_05_KNIGHT_02_CONV_02" = "Luar biasa, Gubernur. Sekarang, aku bisa mengawasi semua bagian kota dan sekitarnya. ";
"T_TUTORIAL_05_KNIGHT_02_CONV_03" = "Kau harus selalu menjaga agar menara jagamu tetap beroperasi dan dipasok oleh barak untuk melindungi desa secara efisien.";
"T_TUTORIAL_05_KNIGHT_02_CONV_04" = "Tuanku! Beberapa orang mencurigakan terlihat di dekat kota. Mereka mungkin bandit!";
"T_TUTORIAL_05_KNIGHT_02_DESC" = "Kesatria menuntut sudut pandang yang baik atas daerah sekitarnya. Sebuah menara jaga harus dibangun. Ini akan memastikan kita punya setidaknya beberapa penjaga yang melindungi kota.";
"T_TUTORIAL_05_KNIGHT_03_CONV_01" = "Kita diserang, Tuanku!";
"T_TUTORIAL_05_KNIGHT_03_CONV_02" = "Bandit merampok bangunan kita, Tuanku! Kita tak berdaya...";
"T_TUTORIAL_05_KNIGHT_03_DESC" = "Kota ini diserang bandit. Kau harus melawan para penyerang. Bangun lebih banyak menara jaga dan tugaskan lebih banyak serdadu untuk meningkatkan peluangmu untuk menang. ";
"T_TUTORIAL_05_KNIGHT_03_TITLE" = "Lawan para penyerang.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_01" = "Selamat pagi, Gubernur. Aku diutus oleh Raja untuk melakukan penahanan atas dirimu. Kau dituduh mencuri koin dari Yang Mulia, Raja. Apa yang ingin kaukatakan sebagai pembelaan?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_02" = "Gubernur tak ada hubungannya dengan ini, aku bersumpah. Kami dijebak. Pelakunya pasti orang lain.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_03" = "Apa kau benar-benar berpikir aku akan percaya omong kosong ini? Seorang bangsawan terkemuka dan saudara ipar Raja melaporkan telah melihatmu dan penasihatmu melakukan kejahatan itu.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_04" = "Kami akan membuktikan bahwa kami tak bersalah! Bukan begitu, Tuanku?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_05" = "Diam! Aku tak mau mendengar alasan kalian. Untuk sekarang, aku akan mendirikan kemah di desamu. Apa kau punya barak di kota yang bisa kugunakan sebagai pusat komando?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_01" = "Bagus, Gubernur. Sekarang, orang-orangku punya markas operasi di kotamu dan kau bisa melatih penjaga kotamu.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_02" = "Kita sekarang bisa fokus menyelesaikan masalah yang kita miliki. Emas yang hilang dari gedung kas Raja dan pertahanan desa ini.";
"T_TUTORIAL_05_MAINQUEST_DESC" = "Bangsawan itu kembali lagi, meminta uang dan barang-barang. Kau harus menyelesaikan masalahnya sebelum menjadi tak terkendali!";
"T_TUTORIAL_05_MAINQUEST_OBJECTIVE_01" = "Cari tahu apa yang dilakukan bangsawan.";
"T_TUTORIAL_05_MAINQUEST_STARTED" = "Ini sudah berlangsung cukup lama, Tuanku. Jika kita tak mengurus bangsawan itu, masalahnya akan memburuk dengan cepat!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_DESC" = "Kesatria telah meminta bala bantuan, tetapi penjaga kota harus menahan para penyerang sampai pasukan Raja tiba.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_STARTED" = "Gubernur, aku telah mengirim kabar kepada Raja untuk meminta bala bantuan. Namun, ini akan memakan waktu. Sampai mereka tiba, kita harus mempertahankan desa dengan segala cara.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_01" = "Kita berhasil, Gubernur! Serangan bandit telah berhenti. Mereka mundur...";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_02" = "Tuanku, penjaga kota menemukan si bangsawan bersembunyi di dekat istana. Sepertinya dia ingin menyampaikan sesuatu kepadamu.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_03" = "Gubernur, terima kasih karena telah mengalahkan para penyerang. Kita tidak sedang dalam bahaya, bukan?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_04" = "Katakan padaku mengapa kau terlihat melakukan pertemuan dengan para bandit. SEKARANG!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_05" = "Baiklah... Aku membuat kesalahan beberapa bulan yang lalu.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_06" = "Aku sempat mengunjungi tempat perjudian di ibu kota, di sana pertama kalinya aku bertemu dengan Ketua Bandit itu. Aku tak tahu dia siapa sampai aku kehilangan banyak uang dalam permainan dadu melawannya.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_07" = "Singkat cerita... Pada akhirnya, aku berutang sangat banyak dan kemudian dia mulai memerasku untuk mencuri emas Raja dari gedung kas.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_08" = "Dan kemudian kau menuduh Gubernur telah mencuri emasnya?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_09" = "Itu hal mudah. Kepala Pengurus Rumah Tangga adalah teman lamaku dan aku berhasil membuat Gubernur dialihtugaskan ke tempat terpencil ini.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_10" = "Jangan berani-beraninya bicara seperti itu tentang desa kecil kami. Jadi kaulah yang menjebak Gubernur yang mulia ini. Kau memalukan!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_11" = "Seiring berjalannya waktu, para bandit itu menginginkan tebusan yang makin besar. Pada akhirnya, mereka meminta senjata dan baju zirah... dan aku melakukannya, dengan bantuan Gubernurmu.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_12" = "Kita harus menghentikan kegilaan ini! Menemukan kamp yang dijadikan markas operasi para bandit itu harus menjadi prioritas tertinggi kita.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE" = "Pertahankan desa.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE_02" = "Bertahanlah";
"T_TUTORIAL_05_MAINQUEST_TITLE" = "Tangani masalah dengan bangsawan itu.";
"T_TUTORIAL_05_MILITARY_EXPLANATIONS" = "Kita hanya bisa menghentikan serangan ini dengan membangun penjaga kota!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01" = "Gubernur, aku punya penawaran yang tak bisa kautolak! Kirimi aku senjata dan baju zirah! Cepat!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01B" = "Kau membantuku dan aku balik membantumu, ya bukan? Aku akan mengatakan hal-hal bagus tentangmu kepada serdadu Raja. Bagaimana menurutmu?";
"T_TUTORIAL_05_NEW_DEAL_CONV_02" = "Bagus sekali! Sekarang, berikan barangnya. Aku harus segera mengirimkannya!";
"T_TUTORIAL_05_NEW_DEAL_DESC" = "Bangsawan itu mengusulkan kesepakatan baru. Dia akan mengatakan hal-hal bagus tentangmu kepada perwakilan Raja jika kau mengiriminya senjata dan baju zirah.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_01" = "Salam, Gubernur. Hari yang indah, bukan?! Aku ingin mengingatkanmu bahwa pembayaran berikutnya sudah jatuh tempo, yang tujuannya adalah membuatku tetap diam, tentu saja.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_02" = "Dan kau harus cepat! Sekelompok serdadu sedang dalam perjalanan. Mereka mencari emas yang hilang dari gedung kas Raja, Gubernur! Demi kebaikanmu, kuharap mereka tak menemukanmu di sini.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_03" = "Sekarang, serahkan. Aku akan menghabiskan uang itu dengan sangat bijak, Gubernur! Cepatlah, aku tak punya waktu. Aku ada pertemuan penting...";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_04" = "Beraninya kau tak membayarku, Gubernur! Ini akan ada konsekuensinya, aku jamin... Sekarang, minggir, ada pertemuan penting yang harus kuhadiri!";
"T_TUTORIAL_05_NOBLEMAN_MONEY_DESC" = "Bangsawan itu meminta uang lagi. Dia mengancam kita dengan kedatangan penyelidik Raja yang mencari emas curian. ";
"T_TUTORIAL_05_NOBLEMAN_MONEY_TITLE" = "Bayar bangsawan.";
"T_TUTORIAL_05_REPAIR_TOWN_CONV_01" = "Sekarang, tukang kayu akan memperbaiki bangunan yang rusak selama dia punya sumber daya yang cukup, Tuanku.";
"T_TUTORIAL_05_REPAIR_TOWN_DESC" = "Setidaknya bangunan terpenting di kota harus diperbaiki sesegera mungkin, Tuanku.";
"T_TUTORIAL_05_REPAIR_TOWN_SUCCESS" = "Bagus sekali, Tuanku. Tukang kayu melaporkan semua bangunan penting telah diperbaiki. ";
"T_TUTORIAL_05_REPAIR_TOWN_TITLE" = "Perbaiki bangunan terpenting di kota.";
"T_TUTORIAL_05_START_2_CONV_01" = "Dengan begini, kita bisa fokus pada tugas-tugas yang akan datang.";
"T_TUTORIAL_05_START_2_CONV_02" = "Tuanku, musim dingin sudah berakhir, tetapi bangunan-bangunan di kota mengalami kerusakan karena kondisi cuaca yang keras.";
"T_TUTORIAL_05_START_2_DESC" = "Banyak bangunan menjadi rusak karena musim dingin yang keras, Tuanku. Seorang tukang kayu bisa memperbaiki bangunan yang mengalami kerusakan dari waktu ke waktu. ";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR" = "Baiklah, Tuanku. Aku sudah memakai 'penyamaranku' dan akan mengikuti si bangsawan ke pertemuannya. Ini akan memakan waktu. Harap bersabar.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_DESC" = "Sementara penasihat yang menyamar mengikuti si bangsawan, kau harus menunggu sampai dia kembali dan melaporkan temuannya.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_TITLE" = "Sang penasihat mengikuti dan memata-matai si bangsawan.";
"T_TUTORIAL_05_START_INVESTIGATION_FAILED" = "...akhirnya, aku kembali ke kota. Aku ketahuan dan hampir tak bisa melarikan diri. Ternyata mereka adalah bandit, Tuanku. Si bangsawan berkomplot dengan bandit!";
"T_TUTORIAL_05_STOCKFULL_01" = "Gudang penuh, Tuanku. Disarankan untuk menjual atau bahkan menghancurkan beberapa barang untuk memberi ruang di gudang.";
"T_TUTORIAL_05_STOCKFULL_02" = "Bagus sekali, Gubernur. Sekarang, kita punya ruang kosong lagi. Penting untuk memiliki ruang penyimpanan yang tersedia untuk menjaga aliran produksi tetap berjalan lancar.";
"T_TUTORIAL_05_STOCKFULL_TITLE" = "Sediakan ruang di gudang.";
"T_TUTORIAL_05_STOCKFULL_TOOLTIP" = "Tak ada ruang lagi di gudang!";
"T_TUTORIAL_05_TANNERY_CONV_02" = "Hebat, Tuanku. Tempat penyamakan kulit akan menghasilkan kulit yang diperlukan ketika dipasok dengan kulit mentah dari pemburu.";
"T_TUTORIAL_05_TANNERY_DESC" = "Untuk menghasilkan baju zirah, kita membutuhkan kulit, yang kita dapatkan dari tempat penyamakan kulit, Tuanku.";
"T_TUTORIAL_05_TANNERY_TITLE" = "Bangun tempat penyamakan kulit dan hasilkan kulit.";
"T_TUTORIAL_05_TOWN_UNDER_ATTACK" = "Tuanku, bandit menyerang kota! Kita harus mengambil tindakan pencegahan terhadap mereka! Kita butuh penjaga kota.";
"T_TUTORIAL_05_TRIBUTE_TIMER_DESC" = "Bayar upeti sebelum kamu kehabisan waktu.";
"T_TUTORIAL_05_UPGRADE_HINT_01" = "Kapasitas bangunan umum bisa ditambah dengan meningkatkannya.";
"T_TUTORIAL_05_UPGRADE_HINT_02" = "Peningkatan bangunan sangatlah kuat. Sebagai contoh, peningkatan bangunan memungkinkan lebih banyak pekerja untuk ditugaskan ke sebuah bangunan.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_01" = "Tuanku, kita bisa melakukan pencarian di hutan utara untuk menemukan kamp bandit.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_02" = "Cukup kirimkan sumber daya yang diperlukan ke penjaga kota dan kami akan langsung bertugas.";
"T_TUTORIAL_06_EXPEDITION_01_STARTED" = "Akan memakan waktu beberapa lama sampai kami kembali, Tuanku. Doakan kami, ya!";
"T_TUTORIAL_06_EXPEDITION_02_CONV_01" = "Haruskah kita mengirim pasukan pengintai ke hutan selatan, Tuanku? Mungkinkah kamp bandit ada di suatu tempat di arah selatan?";
"T_TUTORIAL_06_EXPEDITION_03_CONV_01" = "Mungkinkah kamp bandit ada di suatu tempat di hutan barat? Haruskah penjaga kota membentuk tim pencari?";
"T_TUTORIAL_06_EXPEDITION_04_CONV_01" = "Kita belum melakukan pencarian kamp bandit di hutan timur, Tuanku. Beri perintah dan penjaga kota akan segera bersiap-siap.";
"T_TUTORIAL_06_EXPEDITION_DESC_01" = "Penjaga kota bisa mulai mencari kamp bandit di hutan. Namun, mereka membutuhkan sejumlah perbekalan dan perlengkapan untuk melakukannya.";
"T_TUTORIAL_06_EXPEDITION_RDYTOSTRT" = "Cukup beri kami perintah dan kami akan langsung berangkat, Tuanku.";
"T_TUTORIAL_06_EXPEDITION_RUNNING_DESC" = "Sementara ekspedisi berjalan, tak banyak yang bisa dilakukan selain menunggu.";
"T_TUTORIAL_06_EXPEDITION_RUNNING_TITLE" = "Sebuah ekspedisi sedang berlangsung...";
"T_TUTORIAL_06_EXPEDITION_TITLE_01" = "Biayai ekspedisi ke hutan.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_01" = "Hah! Kau berhasil menangkapku... Seharusnya dari dulu aku menghancurkan desamu dan merampas semua koin dari gedung kasmu! Sial... Gara-gara bangsawan pengkhianat ini, tipu muslihatku terungkap!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_02" = "Bajingan! Kau memanfaatkan kecanduan judiku untuk mencuri dari Raja. Akhirnya mimpi buruk ini berakhir dan emas Raja telah ditemukan.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_03" = "Dan Gubernur yang mulia ini telah mengalahkanmu. Ini adalah hari yang besar bagi kita, desa kita, dan seluruh Kerajaan.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_04" = "Lihat! Pasukan Raja akhirnya tiba!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_05" = "Beri jalan! Beri jalan untuk Rajamu! Menyingkir, Raja mau lewat...";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_06" = "Selamat siang, Tuan-Tuan. Aku bisa melihat, aku dan anak buahku tiba tepat waktu dan melihatmu berhasil menang melawan bandit. ";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_07" = "Kau Grimlock Redbeard, bukan? Bandit paling terkenal di Kerajaan akhirnya tertangkap.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_08" = "Ya, benar, Yang Mulia. Gubernur ini telah menangkapku.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_09" = "Kau memang pahlawan sejati, Gubernur. Kudengar kau dituduh mencuri emas dari gedung kasku dan kehilangan gelar Penguasamu. Apa ini benar?";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_10" = "Dia tak bersalah, Yang Mulia. Akulah yang mencuri koin itu. Aku diperas oleh Redbeard. Aku benar-benar minta maaf!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_11" = "Baiklah. Masukkan keduanya ke penjara. Gubernur dan aku perlu membahas masa depan Kerajaan...";
"T_TUTORIAL_06_MAINQUEST_EXPEDITION_FAILED" = "Tuanku, orang-orang kita kembali. Sayangnya, mereka belum menemukan kamp bandit.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_01" = "Tuan, ada beberapa masalah besar di desa. Kita harus segera menyelesaikannya!";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_02" = "Pertama, kebahagiaan di kota sangat rendah. Kusarankan kau mulai memuaskan keinginan warga desa.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_03" = "Kedua, Tuanku, kami para serdadu penjaga kota hampir tak punya perbekalan dan perlengkapan. Untuk mempertahankan kota, kami membutuhkan lebih banyak perbekalan, Tuan.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_04" = "Prioritas utama kita adalah menemukan kamp bandit itu. Jika kita menemukannya, kita bisa menghancurkannya, Tuanku.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_01" = "Temukan kamp bandit.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_02" = "Beri pasokan kepada pasukan.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_03" = "Buat warga desa bahagia lagi.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_DESC" = "Pertahankan kotamu sampai kau menemukan kamp bandit. Jaga kebahagiaan warga desa dan pasok penjaga kota dengan perbekalan.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_01" = "Tuanku, serangan-serangan ini telah berlangsung selama beberapa hari. Kurasa kita tak bisa bertahan lebih lama lagi.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_02" = "Kita hanya punya satu harapan, Gubernur. Sarang bandit itu harus ditemukan sesegera mungkin. Kita perlu menghancurkannya dan mengakhiri mimpi buruk ini untuk selamanya.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_03" = "Kau, Bangsawan! Beri tahu kami di mana tepatnya kau bertemu dengan para bandit itu? Beri tahu kami lokasi kamp bandit itu SEKARANG!";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_04" = "Aku tak tahu. Kau harus percaya padaku. Mereka menutup mataku dan berjalan melalui hutan. Tempatnya dekat, aku yakin.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_SUCCESS" = "Tuanku! Pengintai kita berhasil menemukan kamp bandit itu!";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_TITLE" = "Selesaikan semua tugas dan kalahkan bandit.";
"T_TUTORIAL_06_NEXT_QUEST_CONV_01" = "Anak buahku kelelahan. Pertempuran terus-menerus selama beberapa hari terakhir memakan korban.";
"T_TUTORIAL_06_NEXT_QUEST_CONV_02" = "Kita kekurangan perbekalan dasar, Tuanku. Kita hanya bisa bertempur dengan efisien jika memiliki barang yang tepat.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_01" = "Sangat disarankan untuk menyiapkan cukup persediaan perbekalan untuk para penjaga kita yang gagah berani, Tuanku.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_02" = "Ini berarti senjata dan baju zirah, serta sosis dan minuman.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_03" = "Minuman membuat pasukan kita lebih berani dan sosis mengisi perut mereka sebelum pertempuran.";
"T_TUTORIAL_06_PROVISIONS_01_DESC" = "Serdadu penjaga kota akan bertempur lebih efektif jika dipasok dengan perbekalan. Senjata dan baju zirah memberikan bonus besar pada serangan dan pertahanan, sedangkan minuman dan sosis memberikan bonus besar pada inisiatif dan bonus kecil pada serangan dan pertahanan.";
"T_TUTORIAL_06_PROVISIONS_01_TITLE" = "Pasok penjaga kota dengan perbekalan";
"T_TUTORIAL_06_PROVISIONS_MONASTERY_CONV_01" = "Tuanku, memiliki tempat pembuatan bir akan memungkinkan kita untuk menghasilkan minuman. Itu tak hanya akan meningkatkan kinerja serdadu kita dalam pertempuran.";
"T_TUTORIAL_06_PROVISIONS_MONASTERY_CONV_02" = "Kita juga bisa memasok kedai minum kita dengan minuman. Dengan begini, setiap warga desa yang mengunjungi kedai akan jauh lebih puas karena ada minuman yang tersedia.";
