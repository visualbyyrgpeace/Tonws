"T_LEGACY_BEER_DESC" = "Tuanku, bagaimana kalau kita mempertahankan momentum untuk terus membangun desa. Pertanian di sini bisa diperluas. Bagaimana dengan tempat pengolahan hop? Dengan begitu kita bisa memproduksi dan memproses hop.";
"T_LEGACY_BEER_SUCCESS" = "Bravo, Tuanku! Mulai sekarang, kota kita akan terkenal karena hop yang berkualitas baik.";
"T_LEGACY_COUNTRY_NEED_DESC" = "Tuanku, kita baru saja menerima pesan dari negeri tetangga. Mereka mengalami bencana kelaparan dan meminta kita berbagi pangan. Apakah kita akan mengirim bahan baku yang diperlukan?";
"T_LEGACY_COUNTRY_NEED_FAILED" = "Tuanku, ini gawat! Ada berita dari negeri tetangga. Bencana kelaparan membuat orang-orang turun ke jalan. Ada pemberontakan dan banyak orang mati. Sang Raja tewas dibunuh... Negeri itu menjadi kacau dan gelombang pengungsi sedang menuju kemari. Seharusnya kita menolong mereka waktu itu...";
"T_LEGACY_COUNTRY_NEED_ONLY_TIMER_TITLE" = "Waktu tersisa untuk membantu tetangga kita:";
"T_LEGACY_COUNTRY_NEED_SUCCESS_001" = "Kita punya persediaan sumber daya yang diperlukan, Tuanku. Kita tinggal mengantarkan barang-barang itu untuk membantu tetangga kita. Waktu tinggal sedikit!";
"T_LEGACY_COUNTRY_NEED_SUCCESS_002" = "Negeri tetangga berterima kasih dengan tulus, Tuanku! Aku yakin kita sudah menyelamatkan mereka dari kelaparan. Siapa yang tahu apa yang akan terjadi kalau kita tidak bertindak?";
"T_LEGACY_COUNTRY_NEED_TITLE" = "Bantu negeri tetangga.";
"T_LEGACY_DECO_DESC" = "Astaga, Gubernur! Coba perhatikan sekelilingmu! Apa yang kau lihat?\n\nYA, persis! Mana dekorasinya? Semuanya kelihatan begitu suram! Cepatlah siapkan dekorasi sebelum Paduka Raja tiba di kota.";
"T_LEGACY_DECO_SUCCESS" = "Nah, ini jauh lebih baik! Untung saja aku kemari untuk mengingatkan kalian akan hal-hal sepele seperti ini.";
"T_LEGACY_FISHER_HUNTER_HUT_DESC" = "Tuanku, akhirnya aku bisa bertemu. Desa kami memerlukan sumber pangan selain roti. Bagaimana kalau dibangun pondok nelayan dan juga pondok pemburu? Dengan begitu kami bisa memperoleh makanan yang lebih berimbang.";
"T_LEGACY_FISHER_HUNTER_HUT_SUCCESS" = "Terima kasih untuk kebaikan Tuanku. Sekarang kami punya cukup sumber pangan untuk meningkatkan makanan kami. Jadi, para penduduk akan menikmati hidup yang jauh lebih sehat.";
"T_LEGACY_FISHER_HUNTER_HUT_TITLE" = "Bangun pondok nelayan dan pondok pemburu.";
"T_LEGACY_HOUSE_DESC" = "Mengingat pekerjaan yang akan kita lakukan, ada baiknya kita membangun rumah tinggal lagi.";
"T_LEGACY_HOUSE_SUCCESS" = "Ini lebih baik! Rumah tinggal yang baru ini juga akan menjadi sumber penghasilan tambahan.";
"T_LEGACY_INTRODUCTION_001_DESC" = "Selamat datang, Gubernur. Sekarang ini hanya kota kecil, tapi aku yakin kau akan mampu membuatnya berkembang.";
"T_LEGACY_INTRODUCTION_002_DESC" = "Bicara soal kemakmuran, aku punya tugas penting untukmu. Seperti yang kau lihat, aku tidak muda lagi, dan meskipun sisa usiaku mungkin masih bertahun-tahun, waktuku di sini akan segera berakhir.";
"T_LEGACY_INTRODUCTION_003_DESC" = "Aku ingin meninggalkan jejak kekuasaanku di sini untuk mengilhami generasi mendatang. Aku sudah punya beberapa ide, tapi aku perlu bantuanmu untuk mewujudkan semuanya.";
"T_LEGACY_INTRODUCTION_004_DESC" = "Aku akan mengirim surat berisi kenangan hidupku. Setiap kenangan akan menjadi pokok tugas untukmu. Jangan kecewakan aku. Setelah surat terakhir terkirim, aku akan datang dan mengunjungimu di desa ini.";
"T_LEGACY_LETTER_001_DESC" = "Dengan berada lebih dekat ke rakyatnya, dia bisa melayani mereka lebih baik. Karena itu dia ingin sebuah kedai minum dibangun di sini, di mana cerita dan legenda dari negeri lain bisa diteruskan.";
"T_LEGACY_LETTER_001_DESCRIPTION_001_DESC" = "Surat pertama sudah tiba. Isinya sangat menarik, Tuanku! Ketika Raja kita masih muda, ia diharuskan oleh ayahnya untuk berbaur dengan orang kebanyakan agar bisa memahami pekerjaan tiap-tiap Townie.";
"T_LEGACY_LETTER_001_DESCRIPTION_002_DESC" = "Jadi, setiap minggu dia mempelajari profesi baru. Satu minggu sebagai penebang pohon, minggu berikut sebagai pemancing atau bahkan pemilik kedai. Setelah itu, dia bisa lebih tepat memperkirakan kebutuhan rakyatnya. Itu luar biasa, Tuanku!";
"T_LEGACY_LETTER_001_DESCRIPTION_003_DESC" = "Profesi pemilik kedai menjadi tantangan tersendiri baginya. Mula-mula dia menyangka kedai itu hanya soal pesta dan minuman, tapi akhirnya dia menyadari bahwa banyak lagi yang ditawarkan di sana.";
"T_LEGACY_LETTER_001_DESCRIPTION_004_DESC" = "Kedai minum menjadi tempat debat informal. Dari filsafat sampai kisah perjalanan pelancong asing, segala sesuatu menjadi sumber kekaguman dan perenungan.";
"T_LEGACY_LETTER_001_SUCCESS" = "Bagus sekali, Tuanku! Para penduduk senang sekali dengan tempat baru yang hidup dan hangat ini. Malam-malam yang panjang di musim dingin akan menjadi lebih menyenangkan.";
"T_LEGACY_LETTER_002_DESC" = "Bisa dikatakan bahwa komitmen kita untuk bekerja bisa membawa harta terbesar. Demi menghormati leluhurnya, Paduka Raja memerintahkan kita untuk membuat ladang anggur di tanah kita. Tuanku sudah memikirkan lokasi yang cocok?";
"T_LEGACY_LETTER_002_DESCRIPTION_001_DESC" = "Kita baru saja menerima surat kedua. Paduka Raja bercerita tentang masa kecilnya di ladang anggur di selatan. Dia sering pergi ke sana di musim panas untuk menjumpai neneknya. ";
"T_LEGACY_LETTER_002_DESCRIPTION_002_DESC" = "Neneknya itu suka bercerita. Kisah yang paling mengesankan bagi Paduka Raja adalah kisah tentang seorang petani dan para putranya, yang mengajarkan pentingnya bekerja. ";
"T_LEGACY_LETTER_002_SUCCESS" = "Paduka Raja sangat bangga melihat ladang anggur di desa kita. Para petani akan mengurusnya dengan baik.";
"T_LEGACY_LETTER_003_DESC" = "Untuk itu, Paduka Raja memerintahkan kita untuk membangun gudang dan menyampaikan pesannya kepada rakyat. Dengan begitu kita bisa menolong para sahabat saat persediaan kita cukup dan mereka kekurangan.";
"T_LEGACY_LETTER_003_DESCRIPTION_001_DESC" = "Satu surat lagi baru saja tiba. Di dalam surat itu Paduka Raja bercerita tentang bencana kelaparan yang terjadi waktu beliau berusia sepuluh tahun. Seluruh kerajaan terdampak. ";
"T_LEGACY_LETTER_003_DESCRIPTION_002_DESC" = "Keluarga kerajaan memutuskan untuk turun tangan dan mengirim diplomat ke semua negara tetangga untuk meminta bantuan. ";
"T_LEGACY_LETTER_003_DESCRIPTION_003_DESC" = "Namun, negara-negara lain tidak peduli dan tidak ada yang mau menolong Paduka Raja. Tapi dia tidak menyerah dan menemukan kerajaan lain yang bersedia membantu. Kerajaan itu punya sumber daya makanan yang berlimpah dan dengan murah hati berbagi dengan kerajaan lain.";
"T_LEGACY_LETTER_003_DESCRIPTION_004_DESC" = "Moral dari kisah ini: Tanpa melihat besar atau kecil, kita selalu bisa saling membantu. Bagi Paduku Raja penting bahwa rakyatnya mau saling membantu di saat susah. Jadi kita harus membuat persediaan barang di masa senang agar bisa berbagi di masa sulit.";
"T_LEGACY_LETTER_003_SUCCESS" = "Gudang baru ini sempurna! Sekarang kita bisa menyimpan persediaan semua barang yang diperlukan untuk mengantisipasi keadaan yang tidak diharapkan.";
"T_LEGACY_LETTER_004_DESC" = "Misi kita adalah mendirikan patung Paduka Raja di kota kita, supaya keinginan beliau bisa terwujud.";
"T_LEGACY_LETTER_004_DESCRIPTION_001_DESC" = "Tuanku, ada surat dari Paduka Raja. Pada waktu upacara penobatannya dulu ada perayaan besar-besaran. Semua gubernur dari kota-kota di kerajaannya berkumpul di istana.";
"T_LEGACY_LETTER_004_DESCRIPTION_002_DESC" = "Tapi impian beliau adalah hadir di semua kota dan desa pada waktu bersamaan, agar semua orang bisa diperlakukan setara. Hadir secara fisik tentu saja mustahil. Tapi kalau ada patung Paduka Raja di setiap kota, keinginan beliau bisa menjadi kenyataan.";
"T_LEGACY_LETTER_004_SUCCESS" = "Betapa bagusnya! Paduka Raja akan senang sekali. Sebuah monumen megah untuk menghormati beliau!";
"T_LEGACY_LETTER_004_TITLE" = "Buatlah patung Paduka Raja.";
"T_LEGACY_LETTER_005_BOOK_HERE" = "Tuanku, bukunya sudah selesai. Paduka Raja yang kita cintai akan senang sekali.";
"T_LEGACY_LETTER_005_DESC" = "Untuk melakukan ini, kita perlu mengumpulkan kulit hewan secukupnya. Itulah yang akan digunakan para biarawan kita untuk menuliskan kisah Paduka Raja. ";
"T_LEGACY_LETTER_005_DESCRIPTION_001_DESC" = "Surat terakhir baru saja tiba, Tuanku. Paduka Raja menulis tentang tokoh-tokoh besar di dunia dan bagaimana mereka berbagi kenangan lewat buku, yang kemudian menyebar ke seluruh dunia. ";
"T_LEGACY_LETTER_005_DESCRIPTION_002_DESC" = "Paduka Raja ingin kenangannya dikumpulkan di dalam sebuah buku. Membuat buku itu sangat sulit, tapi aku rasa itu akan membuat Yang Mulia senang sekali.";
"T_LEGACY_LETTER_005_SUCCESS" = "Penulisan buku bisa dimulai! Para biarawan kita akan memastikan bukunya siap pada waktu Paduka Raja datang. Ini sangat menggairahkan. Kita bisa menjadi terkenal di seluruh dunia karena buku ini!";
"T_LEGACY_LETTER_005_TITLE" = "Buatlah buku berisi kenangan Paduka Raja.";
"T_LEGACY_LETTER_006_DESCRIPTION_001_DESC" = "Tuanku! Paduka Raja segera tiba! Semoga kita tidak membuat kesalahan dan beliau akan mengapresiasi upaya kita.";
"T_LEGACY_LETTER_006_DESCRIPTION_002_DESC" = "Salam, Gubernur. Aku lihat kotamu berkembang baik selama aku tidak di sini. Oh! Patung itu bagus sekali! Dan ladang anggur ini! Persis seperti ladang anggur nenekku!";
"T_LEGACY_LETTER_006_SUCCESS" = "Semua suratku diperhatikan, terutama soal buku yang begitu kuinginkan. Buku ini sempurna! Sekarang aku bisa menikmati hari tua karena ada kepastian bahwa pengetahuanku takkan hilang.";
"T_LEGACY_MAINQUEST_DESC" = "Aku mengandalkanmu untuk membuat peninggalanku patut dikenang; jadikan setiap kenangan sebagai pelajaran kebijakan untuk mereka yang ingin mengikuti langkahku.";
"T_LEGACY_MAINQUEST_SUCCESS" = "Terima kasih atas usahamu yang luar biasa, Gubernur! Kau sungguh cermat dan semua permintaanku dipenuhi. Aku bangga kepadamu. Seluruh kerajaan berutang kepadamu.";
"T_LEGACY_MAINQUEST_TITLE" = "Dukung usaha Raja.";
"T_LEGACY_MINE_DESC" = "Tuanku, kita akan segera kehabisan bahan baku karena sebagian besar digunakan untuk pembangunan bangunan baru. Mungkin kita perlu membuat tambang?";
"T_LEGACY_MINE_SUCCESS" = "Selamat, Tuan Gubernur. Sekarang kita punya persediaan bahan baku yang cukup untuk menangani proyek pembangunan lain di desa dengan tenang.";
"T_LEGACY_SECURITY_DESC" = "Selamat sore, Tuan. Aku utusan Paduka Raja dan aku diperintah untuk memastikan bahwa segala sesuatu di desa ini sudah siap untuk menyambut beliau.\n\nApa INI? Desa kalian kurang aman! Segera bangun menara pemadam kebakaran! Bayangkan apa yang bisa terjadi seandainya ada kebakaran?!";
"T_LEGACY_SECURITY_SUCCESS" = "Ini jauh lebih baik! Kita takkan pernah tahu apa yang bisa terjadi. Kalian bertindak tepat dengan mendengarkanku.";
"T_LEVELENDSCENE_BUTTON_NEXT" = "Skenario berikutnya";
"T_LEVELENDSCENE_COMPLETE_DESC" = "Selamat, kamu berhasil menyelesaikan skenario ini dengan menyelesaikan semua tugas!";
"T_LEVELENDSCENE_COMPLETE_TITLE" = "Skenario selesai!";
"T_LEVELENDSCENE_FAILED_DESC" = "Skenarionya gagal. Kamu gagal menyelesaikan tugas utama...";
"T_LEVELENDSCENE_FAILED_TITLE" = "Skenario gagal!";
"T_LEVELSELECTION_ENABLE_BANDITS_QUESTION" = "Aktifkan serangan bandit di peta ini?";
"T_LEVELSELECTION_PROPERTIES_BANDITS_ENABLED" = "Bandit aktif";
"T_LEVELSELECTION_PROPERTIES_DIFFICULTY" = "Kesulitan";
"T_LEVELSELECTION_PROPERTIES_MAPSIZE" = "Ukuran peta";
"T_LEVELSELECTION_PROPERTIES_MILITARY_ENABLED" = "Peta militer";
"T_LEVELSELECTION_SETTINGS" = "Pengaturan";
"T_LEVELSELECTION_START_GAME" = "Mulai game";
"T_LOADINGTIP_001" = "Petani tidak bisa bekerja hingga tanaman ditumbuhkan kembali. Jika kamu membangun beberapa ladang kecil, petani bisa beralih ladang dan mencegah waktu menganggur.";
"T_LOADINGTIP_002" = "Pastikan untuk menugaskan cukup Townie di gudang untuk mencegah keterlambatan pengangkutan.";
"T_LOADINGTIP_003" = "Kedai minum lebih efektif kalau dipasok jus anggur dari pabrik jus atau bir dari biara.";
"T_LOADINGTIP_004" = "Bangunan publik, seperti gereja, hanya bisa melayani beberapa Townie saja.";
"T_LOADINGTIP_005" = "Beberapa dekorasi akan lebih efektif dalam meningkatkan kebahagiaan daripada dekorasi yang lainnya. Populasi yang lebih besar membutuhkan lebih banyak dekorasi untuk menjaga kesetaraan level kebahagiaan.";
"T_LOADINGTIP_006" = "Perhatikan kebahagiaan para Townie. Gunakan menu statistik untuk terus mengetahui kebutuhan dan harapan para Townie. ";
"T_LOADINGTIP_007" = "Semakin baik kamu dalam memenuhi kebutuhan dan kebahagiaan para Townie, semakin tinggi pajak yang bisa kamu kenakan kepada mereka sebelum mereka mogok.";
"T_LOADINGTIP_008" = "Saat pedagang berkunjung ke kotamu, kamu bisa membeli sumber daya yang mendesak atau menjual barang yang berlebih untuk mendapatkan uang.";
"T_LOADINGTIP_009" = "Pertanian bisa menghasilkan gandum, wol, atau rempah-rempah. Untuk gandum perlu ada ladang gandum. Untuk domba perlu ada padang domba, dan untuk herba perlu ada kebun herba. Tempatkan semuanya di dekat pertanian.";
"T_LOADINGTIP_010" = "Segeralah membangun beberapa rumah sehingga kamu memiliki banyak Townie untuk bekerja di bangunan produksimu.";
"T_LOADINGTIP_011" = "Desa kecil bisa dengan mudah disuplai oleh pemancing atau pemburu, tapi toko roti atau rumah jagal lebih cocok untuk desa lebih besar.";
"T_LOADINGTIP_012" = "Selalu perhatikan produksi kayu. Banyak bangunan membutuhkan kayu sebagai sumber daya produksinya.";
"T_LOADINGTIP_013" = "Beberapa bangunan bisa menghasilkan lebih dari satu sumber daya, misalnya tambang dan perkebunan.";
"T_LOADINGTIP_014" = "Cobalah mendapatkan rasio input-output rantai bangunan produksimu. Dengan cara itu kamu bisa memastikan bangunan beroperasi pada kapistas penuh. ";
"T_LOADINGTIP_015" = "Kamu bisa mendapatkan Prestige di game sandbox dengan menyelesaikan misi upeti opsional.";
"T_LOADINGTIP_016" = "Skenario terdiri dari beberapa tugas yang harus diselesaikan untuk menyelesaikan skenario tersebut.";
"T_LOADINGTIP_017" = "Setelah menyelesaikan skenario kamu akan diberi opsi untuk melanjutkan permainan.";
"T_LOADINGTIP_018" = "Bangun gedung kas! Penarik pajak berkeliling kota dan meningkatkan pendapatan pajak dari setiap rumah yang dikunjunginya.";
"T_LOADINGTIP_019" = "Bengkel tukang kayu sangat berguna. Tukang kayu berkeliling kota dan memperbaiki bangunan rusak dengan menggunakan sumber daya dan koin.";
"T_LOADINGTIP_020" = "Kondisi gedung sangat penting. Rumah-rumah yang runtuh membuat Townie-mu resah dan gedung produksi yang kondisinya jelek kurang produktif. Gedung yang tidak diperbaiki dengan benar juga berisiko kebakaran.";
"T_LOADINGTIP_021" = "Townie memiliki rutinitas harian mereka masing-masing. Saat mereka tidak bekerja, mereka menggunakan waktu luangnya untuk pulang ke rumah untuk makan atau memenuhi harapan mereka.";
"T_LOADINGTIP_022" = "Saat merobohkan bangunan, setengah biaya pembangunannya bisa disimpan. Sayangnya, sumber daya harus didapatkan dari reruntuhan bangunan oleh Townie. Jika kamu membangun bangunan lain di lahan yang sama sebelum itu terjadi, kamu akan kehilangan sumber daya tersebut.";
"T_LOADINGTIP_023" = "Tambang hanya bisa ditempatkan di lereng gunung berbatu. Tambang yang ditempatkan pada cadangan bijih selain menghasilkan batu bisa menghasilkan bijih besi atau emas.";
"T_LOADINGTIP_024" = "Jalan mempercepat pengangkutan barang dan sumber daya. Para Townie biasanya lebih memilih menggunakan jalan. Pengangkutan pada jalan batu lebih cepat dari jalan kasar.";
"T_LOADINGTIP_025" = "Jika nilai pajakmu terlalu tinggi, para Townie menjadi tidak bahagia dan mungkin akan mogok. Jika kamu memenuhi semua harapan, kemungkinan mereka akan mau membayar pajak yang lebih tinggi.";
"T_LOADINGTIP_026" = "Townette memasok rumah dengan makanan dan air. Mereka juga mengunjungi pasar untuk membeli perhiasan dan pakaian, setelah barang tersebut tersedia. Townie pria, di lain pihak, bekerja di bangunan produksi.";
"T_LOADINGTIP_027" = "Jika gudang bangunanmu sering penuh, kamu harus membangun lebih banyak gudang dan menugaskan pengangkut tambahan.";
"T_LOADINGTIP_028" = "Townie pekerja keras pasti akan kelelahan dan beristirahat. Mereka akan melanjutkan pekerjaan setelah beristirahat.";
"T_LOADINGTIP_029" = "Seluruh siklus tahunan membutuhkan waktu 60 menit. Tidak semua peta mempunyai perubahan musim dan beberapa mempunyai musim yang lebih lama.";
"T_LOADINGTIP_030" = "Ladang tidak berproduksi di musim dingin!\n\nBersiaplah menghadapi musim dingin dengan menimbun stok gandum, herba, hop, dan jus anggur. ";
"T_LOADINGTIP_031" = "Berburu adalah sumber makanan yang sangat baik di musim dingin. Pemburu akan menyediakan daging dan kulit mentah untuk kota selama ada cukup rusa atau kelinci di sekitarnya. ";
"T_LOADINGTIP_032" = "Beberapa tugas bisa gagal jika kamu tidak menyelesaikannya dalam waktu yang ditentukan.\nGagal menyelesaikan tugas biasanya berarti kamu tak akan menerima hadiah untuk tugas tersebut, sedangkan tugas tertentu bisa mengakibatkan kamu gagal dalam suatu skenario.";
"T_LOADINGTIP_033" = "Setelah menyelesaikan skenario engkau akan diberi opsi untuk melanjutkan permainan. Selanjutnya game akan beralih ke mode sandbox.";
"T_LOADINGTIP_034" = "Terlalu banyak pemburu bisa mengurangi populasi hewan buruan.\nSeberapa cepat rusa atau kelinci baru bermunculan tergantung kepada luas daerah hutan di peta.";
"T_LOADINGTIP_035" = "Beberapa tugas mempunyai batas waktu. Waktu tersisa untuk menyelesaikan tugas ditampilkan sebagai pesan peringatan di sisi kiri atas layar.";
"T_LOADINGTIP_036" = "Nonaktifkan bangunan yang memproduksi berlebihan untuk mencegah gudang terlalu penuh atau hancurkan sumber daya di menu gudang.";
"T_LOADINGTIP_037" = "Kamu bisa meningkatkan levelmu dengan menyelesaikan tugas dan meningkatkan kotamu. Makin tinggi levelmu, makin bagus juga hadiah yang terbuka!";
"T_LOADINGTIP_038" = "Dokter bisa menyembuhkan Townie yang sakit dengan herba dari kebun herba.";
"T_LOADINGTIP_039" = "XP bisa diperoleh dengan membangun bangunan, berdagang di pasar, mencapai kebahagiaan tinggi di kota, menyelesaikan tugas, atau mencapai jumlah penduduk besar.";
"T_LOADINGTIP_040" = "Pemutakhirkan gedung sangat ampuh: \n\nMisalnya, pemutakhiran tersebut memungkinkan Anda bisa menetapkan lebih banyak pekerja pada sebuah gedung atau meningkatkan daya simpan gedung!";
"T_LOADINGTIP_041" = "Kamu memiliki beberapa pilihan ketika cadangan sumber daya tambang habis. Cari cadangan lain dan bangun tambang baru di sana atau tugaskan ahli geologi ke tambang yang sudah habis untuk mengakses lebih banyak cadangan.";
"T_LOADINGTIP_042" = "Dengan menaikkan level kotamu, kamu membuka riset yang hebat. Misalnya, upgrade bangunan akan dibuka dan opsi riset baru akan tersedia, yang bisa menghasilkan meningkatnya penerimaan pajak atau imbalan pencarian yang lebih baik!";
"T_LOADINGTIP_043" = "Gedung yang dimutakhirkan juga memiliki kerugian:\n\nPekerja tambahan meningkatkan konsumsi sumber daya dan biaya perbaikan gedung pun meningkat!";
"T_LOADINGTIP_044" = "Begitu Anda mencapai level kota tertentu, pemutakhiran gedung akan dibuka. Anda bisa memutakhirkan gedung dari menu gedungnya. \n\nMemutakhirkan gedung sangat mahal, jadi pastikan Anda bisa menjangkaunya, terutama di awal game ini.";
"T_LOADINGTIP_045" = "Meriset Geolog sangat berguna!\n\nSaat Anda menugaskan geolog ke sebuah tambang, ia perlahan-lahan mengisi deposit bijih.\n\n";
"T_LOADINGTIP_046" = "Ketika level kota baru tercapai, opsi riset baru akan terbuka. Ketika suatu riset selesai, bonusnya akan tersedia secara permanen untuk semua kotamu! ";
"T_LOADINGTIP_047" = "Begitu kotamu mencapai ukuran tertentu, ada risiko terjangkit wabah! Kamu akan membutuhkan puskesmas dan kebun herba untuk mengobati Townie-mu.";
"T_LOADINGTIP_048" = "Saat wabah menyerang atau terjadi kebakaran di kotamu, kamu harus segera membangun puskesmas atau menara api. Dokter mengobati Townie yang sakit dan pemadam kebakaran memadamkan gedung yang terbakar.";
"T_LOADINGTIP_049" = "Tingkatkan bangunan untuk meningkatkan kinerjanya. Kamu bisa menemukan tab peningkatan di menu kontekstual bangunan yang bersangkutan.";
"T_LOADINGTIP_050" = "Rawatlah gedung Anda! Jika Anda tidak rutin memperbaikinya, gedung bisa memercikkan api dan bahkan bisa terbakar.";
"T_LOADINGTIP_051" = "Saat kotamu dirusak oleh wabah atau api, Townie-mu mungkin meninggalkan kota. Pada akhirnya, mereka akan kembali lagi begitu bahaya berlalu dan jika tersedia rumah kosong yang memadai.";
"T_LOADINGTIP_052" = "Satu barak hanya bisa mensuplai menara jaga di daerah pengaruhnya.";
"T_LOADINGTIP_053" = "Kalau serdadumu kalah bertempur, mereka akan pulang dan memulihkan luka-luka.";
"T_LOADINGTIP_054" = "Menu kontekstual suatu bangunan berisi berbagai informasi yang berguna. Cukup pilih sebuah bangunan di peta.";
"T_LOADINGTIP_055" = "Kalau gerombolan bandit menyerang sebuah bangunan, mereka bisa mencuri sumber daya, membuat kebakaran, atau menghancurkan bangunan itu.";
"T_LOADINGTIP_056" = "Serangan bandit terhadap sebuah bangunan bisa dihentikan oleh serdadumu, tapi waktunya terbatas.";
"T_LOADINGTIP_057" = "Kulit hewan untuk tempat penyamakan didapat dari pondok pemburu atau dari rumah jagal.";
"T_LOADINGTIP_058" = "Riset militer bisa memberimu keuntungan dalam pertempuran dan dalam perlindungan desamu.";
"T_LOADINGTIP_059" = "Usahakan untuk mencakup sebanyak mungkin wilayah desamu dengan menara jaga dan menara pemadam kebakaran.";
"T_LOADINGTIP_060" = "Para pengangkut yang bekerja di barak akan mengambil suplai untuk serdadu dari gudang dan mengantarkannya ke menara jaga yang ada dalam jangkauan.";
"T_LOADINGTIP_061" = "Periksalah menu pause untuk melihat pengaruh yang sedang aktif di kotamu. Pengaruh ada yang aktif sementara atau permanen di atas peta. Contohnya: bandit yang aktif, musim dingin yang panjang, atau penghasilan pajak yang berkurang.";
"T_LOADINGTIP_062" = "Ketika serdadu mendapat suplai peralatan dan makanan, statistik ofensif dan defensif mereka langsung terpengaruh. Serdadu yang mendapat suplai pedang, misalnya, akan mempunyai daya serang lebih tinggi.";
"T_LOADINGTIP_063" = "Usahakanlah untuk mensuplai serdadumu dengan makanan dan minuman untuk meningkatkan statistik ofensif dan defensif.\nSerdadu dengan suplai yang baik adalah serdadu yang bertempur dengan baik!";
"T_LOADINGTIP_064" = "Pertempuran terdiri dari beberapa tahap: Kedua pihak harus mengundi siapa yang mendapat giliran pertama pada tahap awal. Setelah itu, kedua pihak menyerang dan bertahan secara bergantian. ";
"T_LOADINGTIP_065" = "Gunakan modus "Ikuti Townie" di menu kontekstual sebuah bangunan untuk melihat apa yang sedang dilakukan oleh para penghuni atau pekerja.";
"T_LOADINGTIP_066" = "Serangan bandit mungkin datang dari luar peta atau dari kamp bandit yang tercantum pada peta. Kamp bandit bisa ditingkatkan, yang berarti pertahanannya bertambah kuat.";
"T_LOADINGTIP_067" = "Barak, menara jaga, dan menara pemadam kebakaran punya daerah jangkauan tertentu. Di luar jangkauan itu, petugas pemadam kebakaran, misalnya, takkan bereaksi jika ada bangunan yang terbakar.";
"T_LOADINGTIP_068" = "Daerah jangkauan suatu bangunan bisa dilihat pada waktu pembangunannya, atau pada menu kontekstual bangunan dengan menggunakan "Tampilan Daerah Jangkauan". Modus tampilan ini tersedia untuk barak, menara jaga, dan menara pemadam kebakaran.";
"T_LOADINGTIP_069" = "Jika kamu ingin tahu lebih banyak tentang suatu bangunan dan produksinya, buka menu kontekstual bangunan dan buka "info bangunan".";
"T_LOADINGTIP_070" = "Banyak rantai produksi dan juga seluruh perekonomian tergantung kepada gandum. Pastikan stok gandum memadai sebelum musim dingin tiba.";
"T_LOADINGTIP_071" = "Semakin banyak lidah api berkobar di sebuah bangunan, semakin besar kebakaran tersebut. Bangunannya mungkin ambruk!";
"T_LOADINGTIP_072" = "Hasrat akan hiburan di kota bisa dipenuhi dengan beberapa bangunan hiburan. Masing-masing bangunan hanya bisa memuaskan Townie dalam jumlah terbatas.";
"T_LOADINGTIP_073" = "Setiap musim membawa pengaruh tersendiri untuk kotamu. Musim dingin, misalnya, meningkatkan kebutuhan akan pakaian.";
"T_LOADINGTIP_074" = "Di musim dingin, desamu bisa terancam badai salju dan bencana longsor.";
"T_LOADINGTIP_075" = "Di musim panas, kotamu bisa dilanda kekeringan. Tanaman di ladangmu akan layu sampai pengaruh itu berlalu.";
"T_LOADINGTIP_076" = "Biara memerlukan tempat pengeringan hop supaya pasokan hop terjamin.";
"T_LOADINGTIP_077" = "Pabrik jus memerlukan kebun anggur supaya persediaan buah anggur terjamin.";
"T_LOADINGTIP_078" = "Dokter di rumah sakit tidak memanen herba. Panen herba menjadi tanggung jawab pertanian. Dokter mendapatkan herba dari gudang.";
"T_LOADINGTIP_079" = "Kondisi cuaca membawa pengaruh khusus untuk kotamu. Setelah hujan, pertanianmu akan lebih efektif untuk sementara waktu. Sewaktu kotamu dilanda badai salju, para Townie berjalan lebih lambat.";
"T_LOADINGTIP_080" = "Sewaktu badai petir melintas di atas kota, bangunanmu bisa tersambar dan terbakar.";
"T_LOADINGTIP_081" = "Setiap musim, akan ada festival di arena pekan raya. Setiap kali ada festival yang sedang berlangsung, kebahagiaan secara umum akan meningkat sementara.";
"T_LOADINGTIP_082" = "Perhatikan layar pengaruh di menu pause. Di sana bisa dilihat pengaruh apa saja yang sedang berlangsung di kotamu.";
"T_LOADINGTIP_083" = "Ketika salah satu bangunanmu hancur, kamu bisa memilih tanda di reruntuhan untuk membangunnya kembali.";
"T_LOADINGTIP_084" = "Selama badai salju memengaruhi kota, townie-mu berjalan lebih lambat dan bangunan rusak lebih cepat.";
"T_LOADINGTIP_085" = "Ketika salah satu bangunanmu tampil terkunci atau tidak tersedia, bisa jadi bangunan itu kekurangan satu kebutuhan khusus. Kamu bisa langsung melompat ke kebutuhan itu lewat quicklink di menu konteks bangunan tersebut.";
"T_LOADINGTIP_086" = "Awas: Pada waktu ada badai petir, bangunanmu bisa tersambar!";
"T_LOADINGTIP_087" = "Awas: Bangunanmu akan rusak lebih cepat saat hujan salju lebat.";
"T_LOADINGTIP_088" = "Menu cepat adalah cara bagus untuk memperbaiki bangunan, tugaskan/alihtugaskan pekerja dan ikuti warga desa dengan sangat cepat.";
"T_LOADINGTIP_089" = "Di bagian "bangunan" di tab "statistik", kamu memiliki gambaran umum tentang semua bangunan. Memilih salah satunya memungkinkanmu untuk melihat-lihat semua bangunan dengan tipe tersebut.";
"T_LOADINGTIP_090" = "Dalam gambaran umum jangkauan, kamu bisa melihat-lihat berbagai jenis hamparan.";
"T_LOADINGTIP_091" = "Menu event memungkinkan untuk langsung melompat ke event yang kamu inginkan, seperti misi atau riset yang sudah selesai.";
"T_LOADINGTIP_092" = "Dalam kategori "info kota", kamu bisa mengubah nama kotamu.";
"T_LOADINGTIP_093" = "Jumlah keluarga saat ini bisa ditemukan di bagian "info kota".";
"T_LOADINGTIP_094" = "Di menu event, kamu bisa mengurutkan peringatan berdasarkan tingkat keparahan dan bahkan menyembunyikannya pada layar.";
"T_LOADINGTIP_095" = "Kincir angin perlu dipasok dengan gandum oleh beberapa pertanian agar bisa beroperasi secara efisien.";
"T_LOADINGTIP_096" = "Kebakaran bisa dipadamkan dengan hujan.";
"T_LOADINGTIP_097" = "Warga desa yang sakit memiliki kesempatan kecil untuk sembuh dengan sendirinya.";
"T_LOADINGTIP_098" = "Bahasa Townie adalah campuran bahasa Belanda, Finlandia, dan Volapük.";
"T_LOADINGTIP_099" = "Semua efek bangunan yang sedang aktif bisa dilihat di menu kontekstual suatu bangunan.";
"T_LOADINGTIP_100" = "Serikat dagang bisa mengotomatiskan perdagangan. Transaksi beli atau jual akan dimulai setiap kali pedagang berada di kota.";
"T_LOADINGTIP_101" = "Pajak dikumpulkan secara otomatis secara berkala. Kamu bisa menyesuaikan pajak di menu 'kebahagiaan' di bawah kategori 'pajak'.";
"T_LOADINGTIP_102" = "Penduduk di Townsmen terdiri dari keluarga Townie dan Townette. Kapasitas bangunan selalu mengacu pada keluarga.";
"T_LOADINGTIP_103" = "Salju longsor hanya bisa terjadi di musim dingin dan di beberapa lereng gunung. Jika terjadi salju longsor, bangunan di area tubrukan akan rusak atau bahkan roboh, tergantung kondisinya.";
"T_LOADINGTIP_104" = "Terkadang, bandit menyerang kota dalam beberapa gelombang besar. Penjaga kota harus cukup besar agar kota tak terlalu terdampak oleh serangan. ";
"T_LOADINGTIP_105" = "Memperbaiki bangunan membutuhkan sumber daya. Makin maju sebuah bangunan, makin tinggi biayanya.";
"T_LOADINGTIP_106" = "Untuk mengakses semua tindakan yang tersedia untuk suatu bangunan melalui menu kontekstual, gunakan tombol tindakan di sana.";
"T_LOADINGTIP_107" = "Pondok nelayan dan pondok berburu adalah satu-satunya pemasok makanan yang bisa diandalkan di musim dingin.";
"T_LOADINGTIP_108" = "Konten tertentu, seperti pelabuhan, hanya tersedia di "The Seaside Empire".";
"T_LOADINGTIP_109" = "Cerita singkat dalam game tanpa akhir adalah event kecil dengan kesempatan pengambilan keputusan dalam dialog. Beberapa keputusan memiliki konsekuensi permanen!";
"T_LOADINGTIP_110" = "Terkadang, opsi dalam cerita singkat dan event tidak dapat dipilih atau bahkan disembunyikan jika kondisi tertentu tidak terpenuhi.";
"T_LOADINGTIP_111" = "Banyak event yang hanya dapat dipicu sekali per kota. Kebanyakan cerita singkat bersifat unik.";
"T_LOADINGTIP_112" = "Cerita singkat dan event dapat dibatalkan dalam sebagian besar kasus. Namun, begitu mereka dimulai, cerita singkat hanya dapat diakhiri dengan sebuah keputusan.";
"T_LOADINGTIP_113" = "Cerita singkat, event, serta istana militer hanya tersedia saat kau memulai game tanpa akhir baru. Di sini, kau juga akan melihat beberapa opsi untuk mempersonalisasi game tanpa akhir.";
"T_LOADINGTIP_114" = "Bandit, bencana, tugas acak, atau cerita singkat dapat diaktifkan dan dinonaktifkan dalam mode tanpa akhir. Pengaturan ini hanya dapat diubah saat memulai peta tanpa akhir.";
"T_LOADINGTIP_115" = "Cerita singkat dapat dipicu ketika kondisi tertentu terpenuhi. Misalnya, jika bangunan tertentu telah didirikan atau jumlah warga telah mencapai ukuran tertentu.";
"T_LOADINGTIP_116" = "Kadang-kadang, satu atau lebih pilihan dalam pengambilan keputusan cerita singkat tidak tersedia. Hal ini terjadi karena tidak terpenuhinya salah satu syarat.";
"T_LOADINGTIP_117" = "Istana militer hanya memiliki kapasitas penyimpanan yang kecil, tetapi dapat memasok bangunan pertahanan dengan perbekalan. Memungkinkan penugasan pengangkut, serdadu, dan kepala barak.";
"T_LOADINGTIP_118" = "The Seaside Empire. Nikmati konten berjam-jam, bangunan baru, dekorasi, peta, skenario, dan event seru yang menawarkan pilihan dan konsekuensi dalam latar yang benar-benar baru dengan pantai yang indah!";
"T_LOADINGTIP_119" = "Rumah tinggal sedang dan rumah kota secara default menawarkan masing-masing 4 dan 3 ruang tinggal keluarga.";
"T_LOADINGTIP_120" = "Hampir semua bangunan di "The Seaside Empire" telah menerima pembaruan tampilan.";
"T_LOADINGTIP_121" = "Mulai sekarang, pemain bisa memilih jenis istana dalam mode tanpa akhir. Istana normal memiliki tampilan yang dirombak untuk "The Seaside Empire". Selain itu, sekarang ada istana militer, yang menawarkan keuntungan penentu saat melawan serangan bandit.";
"T_LOADINGTIP_122" = "Jika kau ingin mengetahui lebih lanjut tentang "The Seaside Empire", kau bisa melihat informasi terperinci di halaman bantuan. Ada informasi tambahan yang menjelaskan DLC tersebut.";
"T_LOADINGTIP_123" = "Terkadang, ada event yang mengubah produktivitas bangunan. Ini bisa berupa meningkatnya produktivitas pertanian setelah hujan, tetapi juga bisa karena keputusan tertentu, misalnya menurunnya produktivitas setelah tugas yang tak terselesaikan.";
"T_LOADINGTIP_CLOUDSAVE_01" = "Upload game tersimpan ke cloud secara berkala untuk mencegah kehilangan data!";
"T_LOADINGTIP_CLOUDSAVE_02" = "Game tersimpan tidak secara otomatis disinkronkan dengan cloud! Untuk menyimpan game ke cloud, gunakan tombol cloud di menu game atau Google Game Services.";
"T_LOADINGTIP_CLOUDSAVE_03" = "Game tersimpan tidak secara otomatis disinkronkan dengan cloud!";
"T_LOADINGTIP_CLOUDSAVE_04" = "Para townie akan mengingatkanmu untuk menyimpan game ke cloud. Kamu bisa mengaktifkan atau mematikan peringatan penyimpanan ke cloud di menu opsi.";
"T_LOADINGTIP_CLOUDSAVE_05" = "Untuk menyimpan game ke cloud, gunakan tombol di menu game atau Google Game Services.";
"T_LOADINGTIP_COLLECTALL" = "Gudang harta memperbolehkan engkau memungut semua pajak yang jatuh tempo dengan sekali klik. Hal ini sangat praktis dalam kota besar. Meski membutuhkan sedikit poin Prestige untuk melakukan hal ini.";
"T_LOADINGTIP_DAILY_REWARD" = "Kembalilah dan sering-sering kunjungi Townie-mu! Kembali ke game akan membuatmu mendapatkan hadiah poin Prestige.";
"T_LOADINGTIP_EXTINGUISHALL" = "Bangunan khusus, seperti rumah sakit atau menara pemadam kebakaran, membuka fungsi "Padamkan semua!" dan "Sembuhkan semua!" di menu bangunan bersangkutan.";
"T_LOADINGTIP_KEYBINDINGS_01" = "Kamu bisa menggerakkan kamera dengan tombol {KEY_BINDING_CAMERA_UP}, {KEY_BINDING_CAMERA_DOWN}, {KEY_BINDING_CAMERA_LEFT} dan {KEY_BINDING_CAMERA_RIGHT}.";
"T_LOADINGTIP_KEYBINDINGS_02" = "Kamu bisa menggunakan pintasan untuk tombol HUD:\n\nPercepatan – {KEY_BINDING_FF}\nMenu pembangunan – {KEY_BINDING_BUILDMENU}\nLog tugas – {KEY_BINDING_QUESTS} \nLayar statistik – {KEY_BINDING_STATISTICS}\nHapus objek – {KEY_BINDING_SHOVEL}\nMenu riset – {KEY_BINDING_RESEARCH}\nAmbil cuplikan gambar – {KEY_BINDING_SCREENSHOT}\nMenu ingame – {KEY_BINDING_INGAMEMENU}\nLog insiden – {KEY_BINDING_ALERTS}\nToko – {KEY_BINDING_TOWNSHOP}";
"T_LOADINGTIP_KEYBINDINGS_03" = "Kalau terjadi di insiden di kotamu, kamu bisa melompat langsung ke log insiden dengan menekan {KEY_BINDING_ALERTS}.";
"T_LOADINGTIP_KEYBINDINGS_04" = "Sub–halaman dari layar statistik bisa diakses langsung dengan pintasan:\n\nMenu dagang – {KEY_BINDING_TRADE}\nInventaris gudang – {KEY_BINDING_STOCK}\nMenu kebahagiaan – {KEY_BINDING_HAPPINESS} \nMenu militer – {KEY_BINDING_MILITARY}\nHapus sumber daya – {KEY_BINDING_DELETE} \n";
"T_LOADINGTIP_KEYBINDINGS_05" = "Game–mu bisa disimpan kapan saja di menu ingame atau dengan pintasan {KEY_BINDING_QUICKSAVE}.\n";
"T_LOADINGTIP_KEYBINDINGS_06" = "Di dalam game ada banyak kombinasi tombol. Di menu pause ada daftarnya.";
"T_LOADINGTIP_PRESTIGE" = "Prestige memiliki banyak kegunaan. Prestige bisa digunakan untuk meningkatkan bangunan, membuat dekorasi, atau menyelesaikan pembangunan bangunan secara instan.";
"T_LOADINGTIP_PRESTIGEFEATURES" = "Beberapa bangunan punya fitur hebat di menu kontekstualnya.\n\nBangunan itu adalah: bengkel tukang kayu, gedung kas, rumah sakit, menara pemadam kebakaran, dan tambang.";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP" = "Bagaimana dengan mendapat XP Ganda secara permanen?\n\nRaih level kota baru jauh lebih cepat dan buka opsi riset yang baru dan hebat!\n\nTunggu apa lagi? Kunjungi Tokota!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_02" = "Gunakan “2x XP” untuk memperoleh dua kali sebanyak XP saat memainkan game ini!\n\nIni akan membantu Anda mencapai level kota berikutnya lebih cepat dan membuka opsi riset baru yang hebat!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_03" = "Dapatkan lebih banyak XP dan capai level kota baru lebih cepat dengan menggunakan kemujuran XP Ganda!";
"T_LOADINGTIP_PURCHASE_FASTFORWARD" = "Dapatkan percepatan tak terbatas - secara permanen!\n\nMainkan dengan kecepatan 5x selama yang Anda ingin!\nJangan pernah lagi habiskan poin Prestige pada waktu maju cepat!\n\nTunggu apa lagi? Kunjungi Toko!";
"T_LOADINGTIP_PURCHASE_NOADS" = "Anda tidak suka spanduk iklan dan ruang iklan? Bagaimana kalau versi bebas iklan?\n\nMainkan Townsmen tanpa iklan - selamanya!\n\nTunggu apa lagi? Kunjungi Tokota!";
"T_LOADINGTIP_PUSH_NOTIFICATIONS" = "Perangkat selulermu akan memberi tahu ketika townie milikmu kehilanganmu dan jika ada hadiah Prestige untuk dikumpulkan. Engkau bisa menonaktifkan pemberitahuan di opsi aplikasi Townsmen. ";
"T_LOADINGTIP_REFILLDEPOSIT" = "Anda memiliki beberapa opsi, saat deposit sumber daya seorang penambang habis:\n- mengisi tambang dengan poin Prestige\n- mencari deposit lain dan membangun tambang baru di sana\n- menetapkan Geolog (bisa dibuka melalui riset)";
"T_LOADINGTIP_REPAIRALL" = "Bengkel tukang kayu memungkinkan kamu memperbaiki semua bangunan di kota dengan satu klik. Biaya dalam poin Prestige tergantung keseluruhan kerusakan bangunan yang harus diperbaiki.";
"T_LOADINGTIP_YOUTUBE_GENERIC" = "Kamu bisa menonton video tutorial dan cara bermain di saluran Townsmen di YouTube. Kamu tinggal memilih tombol YouTube di menu utama.";
"T_LOADINGTIP_YOUTUBE_MOUSE" = "Dari menu utama, kamu bisa menonton video tutorial dan cara bermain di saluran Townsmen di YouTube. Kamu tinggal klik tombol YouTube.";
"T_LOADINGTIP_YOUTUBE_TOUCH" = "Dari menu utama, Anda dapat menonton tutorial dan video permainan dari saluran YouTube Townsmen. Ketuk saja tombol YouTube.";
