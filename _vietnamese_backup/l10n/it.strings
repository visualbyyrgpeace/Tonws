"T_SCENARIO_2016_06_BANDIT_01_DESC" = "Dunque vorresti rubare le mie pepite? Bene, ora ti faccio vedere io. VAAAALAAANGAAAAAA!";
"T_SCENARIO_2016_06_BANDIT_025_DESC" = "Vuoi sapere cosa succede alle persone che non ascoltano? VAAAALAAANGAAAAAA!";
"T_SCENARIO_2016_06_BANDIT_02_DESC" = "Dove hai preso questo pane? Ne voglio anch’io! O preferisci un’altra valanga?";
"T_SCENARIO_2016_06_BANDIT_02_NAME" = "Soddisfa le richieste dei banditi.";
"T_SCENARIO_2016_06_BANDIT_03_DESC" = "Oh, quello è un bel mucchio di ferro. Sono sicuro che non vedi l’ora di costruirmi un po’ di attrezzi.";
"T_SCENARIO_2016_06_BANDIT_04_DESC" = "Che gentile, hai già fuso le pepite in lingotti. Ti ho già detto che questo è il “mio” oro e che lo rivoglio, vero? Oh, e raffinalo un po’ di più, OK?";
"T_SCENARIO_2016_06_BANDIT_05_DESC" = "Pensavo di farmi degli abiti nuovi. Hai qualcosa della mia taglia?";
"T_SCENARIO_2016_06_INTRO_01_DESC" = "Almeno i cittadini sono riusciti a sfuggire alla valanga, ma gli edifici colpiti sono stati distrutti.";
"T_SCENARIO_2016_06_MAIN_00_DESC" = "Le consegne regolari da questo villaggio si sono interrotte. Governatore, mi aspetto che ti occupi di questo problema.";
"T_SCENARIO_2016_06_MAIN_00_END" = "La minaccia di valanghe non è stata un problema per te. Sapevo che potevo contare su di te, mio Governatore.";
"T_SCENARIO_2016_06_MAIN_00_NAME" = "Completa i compiti primari e occupati delle miniere.";
"T_SCENARIO_2016_06_QUEST_00_DESC" = "Dobbiamo riparare il magazzino, altrimenti crollerà.";
"T_SCENARIO_2016_06_QUEST_00_NAME" = "Ripara il magazzino.";
"T_SCENARIO_2016_06_QUEST_01_DESC" = "Per cominciare ci serve una segheria per ricostruire tutti gli edifici della città.";
"T_SCENARIO_2016_06_QUEST_01_NAME" = "Costruisci una segheria.";
"T_SCENARIO_2016_06_QUEST_02_DESC" = "Milord, nonostante il rischio valanghe, dobbiamo riavviare la produzione di ferro e oro. Il Re si aspetta una grossa spedizione da questo villaggio.";
"T_SCENARIO_2016_06_QUEST_02_NAME" = "Fai scavare ferro e oro ai minatori.";
"T_SCENARIO_2016_06_QUEST_03_DESC" = "Una fonderia è più efficiente se piazzata vicino alle miniere, ma in caso di una valanga anch’essa verrà danneggiata. Decidi saggiamente, milord.";
"T_SCENARIO_2016_06_QUEST_04_DESC" = "Eccellente, milord. Il Re si aspetta una sostituzione per le consegne mancate. Dobbiamo pagare un grosso tributo.";
"T_SCENARIO_2016_06_QUEST_04_NAME" = "Paga un tributo al Re.";
"T_SCENARIO_2016_06_QUEST_05_DESC" = "La produzione è molto lenta, mio signore. Con altre miniere potremmo aumentare la quantità di minerale estratto.";
"T_SCENARIO_2016_06_QUEST_06_DESC" = "Siamo a corto di carbone. Dovresti dare ordine di costruire una fornace a carbone.";
"T_SCENARIO_2016_06_QUEST_10_DESC" = "Milord, dobbiamo produrre lingotti d’oro per pagare tributi supplementari. Il Re ne sarà molto soddisfatto.";
"T_SCENARIO_2016_06_QUEST_AVALANCHE_00_DESC" = "Attenzione, milord! Un’altra valanga, è terribile!";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_DESC" = "Milord, molte miniere sono già crollate. Il Re ha dato ordine di ricostruirle.";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_NAME" = "Costruisci altre miniere.";
"T_SCENARIO_2016_06_QUEST_SIDE_025_DESC" = "Mia moglie vorrebbe pregare affinché le valanghe non ci causino danni. Saresti così generoso da costruirci una chiesa?";
"T_SCENARIO_2016_06_QUEST_SIDE_02_DESC" = "Milord, so che abbiamo bisogno di molto legname per la ricostruzione, ma la mia famiglia non ha più legna da ardere e sta arrivando il freddo. Puoi aiutarci?";
"T_SCENARIO_2016_06_QUEST_SIDE_03_DESC" = "È molto difficile muoversi nella neve. Qualche strada di ciottoli aiuterebbe.";
"T_SCENARIO_2016_06_QUEST_SIDE_045_DESC" = "Governatore, non possiamo coltivare grano in questa regione. Ma possiamo comprare il pane al mercato. Oppure possiamo semplicemente comprare il grano e cuocerci il pane da soli.";
"T_SCENARIO_2016_06_QUEST_SIDE_04_DESC" = "Sempre solo carne e pesce. Milord, non potremmo mangiare pane per cambiare?";
"T_SCENARIO_2016_06_QUEST_SIDE_04_NAME" = "Soddisfa i desideri dei tuoi cittadini.";
"T_SCENARIO_2016_06_QUEST_SIDE_05_DESC" = "I nostri abiti si stanno rovinando a causa del clima difficile. Abbiamo davvero bisogno di nuovi abiti.";
"T_SCENARIO_2016_06_QUEST_SIDE_06_DESC" = "Questi attrezzi arrugginiti ci si rompono in mano. Immagino che il ferro ti serva, ma usarne una parte per nuovi attrezzi ci sarebbe di grande aiuto.";
"T_SCENARIO_2016_06_QUEST_SIDE_07_DESC" = "In questa regione nevosa ci accontentiamo di qualsiasi novità. Milord, se non sei troppo impegnato, potresti abbellire la nostra cittadina?";
"T_SCENARIO_2016_10_BANDIT_01_DESC" = "Uomini! Cominciate l’attacco!";
"T_SCENARIO_2016_10_BANDIT_04_DESC" = "Stai cercando il mercante? Beh, si è perso e per qualche motivo si è ritrovato legato nel mio accampamento. Ma non ti preoccupare, sta bene. Ci basta una piccola donazione e sarà libero in men che non si dica.";
"T_SCENARIO_2016_10_BANDIT_04_END" = "Bene, lasceremo andare il mercante. Compra tante cose da lui, così avrò di più da rubare.";
"T_SCENARIO_2016_10_BANDIT_04_NAME" = "Paga il riscatto per liberare il mercante.";
"T_SCENARIO_2016_10_BANDIT_END_DESC" = "Banditi! Andiamocene di qui! Si chiama ritirata strategica. Abbiamo già rubato a sufficienza, in ogni caso.";
"T_SCENARIO_2016_10_BANDIT_TIMER_10_DESC" = "Hai appena distrutto uno dei nostri accampamenti? Questa è una sfida. Attaccate la città, miei prodi!";
"T_SCENARIO_2016_10_HAPPYNESS_DESC" = "Oh no, mio signore. I cittadini sono insoddisfatti e non vogliono più pagare le tasse. Dobbiamo soddisfare i loro desideri per riscuotere di nuovo le tasse.";
"T_SCENARIO_2016_10_HAPPYNESS_NAME" = "Aumenta la felicità per riscuotere di nuovo le tasse.";
"T_SCENARIO_2016_10_MAIN_00_DESC" = "Governatore, mi serve molto contante. Crea un’economia fiorente e paga i tuoi tributi. Ma attenzione, ci sono molti banditi nella zona. L’intero regno conta su di te.";
"T_SCENARIO_2016_10_MAIN_00_END" = "Molto bene, mio Governatore. Sapevo di poter contare su di te. Sarai ricompensato e la tua reputazione aumenterà.";
"T_SCENARIO_2016_10_NEED_BREAD_DESC" = "Milord, le scorte di pane in magazzino sono ridotte. La gente è scontenta.";
"T_SCENARIO_2016_10_NEED_BREAD_NAME" = "Accumula pane a sufficienza per aumentare la felicità.";
"T_SCENARIO_2016_10_NEED_BREW_DESC" = "L’insoddisfazione si estende, milord. La gente vuole più birra.";
"T_SCENARIO_2016_10_NEED_BREW_NAME" = "Accumula birra a sufficienza per impedire uno sciopero dei cittadini.";
"T_SCENARIO_2016_10_NEED_CARPENTER_DESC" = "Il carpentiere ha troppo lavoro. Molti edifici devono essere riparati, mio signore. Io ti consiglio di costruire altre carpenterie.";
"T_SCENARIO_2016_10_NEED_CARPENTER_NAME" = "Costruisci un laboratorio di carpentiere per aumentare la felicità.";
"T_SCENARIO_2016_10_NEED_CLOTHS_DESC" = "Non ho nulla da indossare. Ci servono più abiti.";
"T_SCENARIO_2016_10_NEED_CLOTHS_NAME" = "Accumula abiti a sufficienza per aumentare la felicità.";
"T_SCENARIO_2016_10_NEED_FIREWATCH_DESC" = "Signore, le torri dei pompieri non coprono un numero sufficiente di edifici, dobbiamo costruirne altri.";
"T_SCENARIO_2016_10_NEED_FISH_DESC" = "Non abbiamo nemmeno abbastanza pesce in questo villaggio. Non pagherò più le tasse!";
"T_SCENARIO_2016_10_NEED_FISH_NAME" = "Immagazzina abbastanza pesce nel magazzino per ridurre le probabilità di uno sciopero.";
"T_SCENARIO_2016_10_NEED_JEWELRY_DESC" = "Voglio fare una sorpresa a mia moglie con nuovi gioielli. Peccato che in città non riesca a trovarne.";
"T_SCENARIO_2016_10_NEED_JEWELRY_NAME" = "Accumula gioielli a sufficienza per impedire uno sciopero dei cittadini.";
"T_SCENARIO_2016_10_NEED_JOUSTING_DESC" = "Non c’è molto da fare in città. Non c’è abbastanza intrattenimento. Credo che sia il momento di aumentare il numero di edifici di intrattenimento.";
"T_SCENARIO_2016_10_NEED_JUICE_DESC" = "Ho voglia di succo. Signore, puoi rifornirci di succo ancora?";
"T_SCENARIO_2016_10_NEED_JUICE_NAME" = "Accumula succo a sufficienza per aumentare la felicità e impedire uno sciopero.";
"T_SCENARIO_2016_10_NEED_MEAT_DESC" = "Di nuovo, non c’è abbastanza carne in città. Quando ne potremo avere di nuovo?";
"T_SCENARIO_2016_10_NEED_MEAT_NAME" = "Accumula carne a sufficienza per aumentare la felicità e impedire uno sciopero.";
"T_SCENARIO_2016_10_NEED_MEDICUS_DESC" = "Governatore, con tanta gente in città, non posso prendermi cura di tutti. Mi serve aiuto per curare la popolazione.";
"T_SCENARIO_2016_10_NEED_MEDICUS_NAME" = "Costruisci un’infermeria per impedire uno sciopero in città.";
"T_SCENARIO_2016_10_NEED_TAVERN_DESC" = "Non c’è spazio nella nostra taverna. È troppo affollata. Il nuovo governatore spreca il nostro denaro anziché spenderlo per le nostre necessità.";
"T_SCENARIO_2016_10_QUEST_00_DESC" = "Milord, per cominciare dobbiamo costruire gli edifici fondamentali per la nostra economia. Consiglio altri capanni per pescatori e una segheria.";
"T_SCENARIO_2016_10_QUEST_00_NAME" = "Costruisci una segheria e un capanno per pescatori.";
"T_SCENARIO_2016_10_QUEST_01_DESC" = "Possiamo costruire una miniera nelle vicinanze per raccogliere risorse molto in fretta.";
"T_SCENARIO_2016_10_QUEST_01_NAME" = "Costruisci una miniera.";
"T_SCENARIO_2016_10_QUEST_02_DESC" = "La gente ora chiede pane. Possiamo produrlo noi, o comprarlo al mercato. Ma dobbiamo fare in modo di avere sempre pane a sufficienza.";
"T_SCENARIO_2016_10_QUEST_02_NAME" = "Accumula pane a sufficienza.";
"T_SCENARIO_2016_10_QUEST_03_DESC" = "Non abbiamo nemmeno un po’ di birra. Con tutte le tasse che pago, non posso avere nemmeno della birra?";
"T_SCENARIO_2016_10_QUEST_03_NAME" = "Immagazzina birra sufficiente nel magazzino.";
"T_SCENARIO_2016_10_QUEST_04_DESC" = "Mio signore, alla gente piace mangiare diversi tipi di cibo. Solo pesce e pane non è sufficiente, vogliono anche carne.";
"T_SCENARIO_2016_10_QUEST_04_NAME" = "Assicura che carne sufficiente sia nel magazzino.";
"T_SCENARIO_2016_10_QUEST_05_DESC" = "Sarebbe meraviglioso avere più di un vestito. Saresti così gentile, signor Governatore?";
"T_SCENARIO_2016_10_QUEST_05_NAME" = "Accumula vestiti.";
"T_SCENARIO_2016_10_QUEST_06_DESC" = "Siccome la città è in crescita, sempre più aristocratici si stanno stabilendo da noi. Vorrebbero bere del succo.";
"T_SCENARIO_2016_10_QUEST_06_NAME" = "Procurati succo a sufficienza nel magazzino.";
"T_SCENARIO_2016_10_QUEST_07_DESC" = "Una città meravigliosa. Ma mancano dei beni di lusso. Saresti così gentile da offrirmi gioielli?";
"T_SCENARIO_2016_10_QUEST_07_NAME" = "Procurati gioielli a sufficienza nel magazzino.";
"T_SCENARIO_2016_10_QUEST_10_DESC" = "I cittadini richiedono una chiesa.";
"T_SCENARIO_2016_10_QUEST_11_DESC" = "Richiediamo una taverna per rendere più felice la gente, milord.";
"T_SCENARIO_2016_10_QUEST_12_DESC" = "Milord, ci occorre un centro fieristico per la nostra gente.";
"T_SCENARIO_2016_10_QUEST_13_DESC" = "La nostra gente si preoccupa della sicurezza del fuoco. Dobbiamo costruire una torre dei pompieri.";
"T_SCENARIO_2016_10_QUEST_14_DESC" = "Governatore, c’è già un dottore competente in città?";
"T_SCENARIO_2016_10_QUEST_14_NAME" = "Costruisci un'infermeria.";
"T_SCENARIO_2016_10_QUEST_15_DESC" = "Per aumentare la felicità della nostra gente, dobbiamo costruire un percorso per giostra.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "Milord, la città cresce molto bene. Per tenere tutti gli edifici in buone condizioni, dobbiamo costruire un negozio di carpentiere.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "Se non facciamo qualcosa contro i banditi, ci ruberanno tutte le nostre case e i nostri averi.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "Abbiamo già dei soldati. Spero che possiamo difendere la città dagli attacchi dei banditi.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "Mio signore, è tempo di mettere i banditi al loro posto, e bandirli da questa regione.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "Sembra che servano misure più drastiche. La città è in sciopero!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "I cittadini sono in sciopero. Aspetta finché non si saranno calmati.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "Mio signore, è una bellissima giornata, non credi?\n\nVengo a te per chiedere se è possibile far decorare la città degnamente per le festività.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "Aumenta la soddisfazione decorando la città.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "Hai fatto un lavoro meraviglioso con queste nuove decorazioni, milord. La città ha un aspetto splendido.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "Milord, i lavoratori che preparano il festino sono molto seccati per la mancanza di distrazioni tra una festività e l’altra. Ho sentito molti di loro dire che vorrebbero veder arrivare una carovana di giocolieri.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "Costruisci una carovana di giocolieri.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "Ottimo milord! I lavoratori sono tornati a preparare i festeggiamenti. Sono molto allegri perché ora abbiamo una carovana di giocolieri in città.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "Queste tempeste stanno danneggiando enormemente la città. Dovremmo assicurarci che tutti gli edifici siano adeguatamente riparati, signore. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "Aumenta la soddisfazione per la condizione degli edifici.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "Ottimo milord! Ora gli edifici sono di nuovo in buone condizioni.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "Milord! Una terribile tempesta si sta abbattendo sulla città. Meglio tornare al sicuro nel castello. I fulmini hanno già colpito diversi edifici...";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "Posso rubarti un momento, milord?\n\nCon tutti questi preparativi... non dovresti dimenticare il significato di questa festività... essa può svolgersi solo dopo che la vendemmia è stata completata, milord!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "Completa la vendemmia dell’uva.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "Che vista meravigliosa, mio signore! La vendemmia è terminata e anche i preparativi per la festa sono quasi finiti. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "Milord, non abbiamo più tempo. È troppo tardi per iniziare il festival. Il Re non sarà contento di saperlo...";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "Ottimo, mio signore!\n\nI preparativi per le festività sono completi. Ora attendiamo solo il tuo ordine per dare inizio ai festeggiamenti.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = "Per decreto reale, ti ordino di organizzare un intero anno di festeggiamenti. Ad ogni stagione voglio che tu organizzi un festival in onore della mia nuova sposa!\n\nOra vai, e non mi deludere...";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "Sono davvero deluso, Governatore!\n\nOrganizzare un paio di festeggiamenti non era un compito difficile, eppure hai fallito! Ti ho chiesto troppo? Ora sparisci dalla mia vista!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "Organizza tutti i festival in tempo!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "Governatore! È stato un magnifico anno di festeggiamenti.\n\nHai dimostrato che posso fidarmi di te ogni volta che ho un compito difficile.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "Che bel festival, mio signore!\n\nMa ora dobbiamo fare in modo che il festival d’autunno venga organizzato come previsto, prima dell’inizio dell’inverno! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "Organizza il festival d’autunno prima dell’inizio dell’inverno!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "Per prepararci al festival di primavera dobbiamo fare in fretta, mio signore.\n\nIl festiva dev’essere completato prima dell’inizio dell’estate, e non abbiamo molto tempo.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "Organizza il festival di primavera prima dell’inizio dell’estate.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "Che bel festival, mio signore!\nMa ora dobbiamo fare in modo che il festival d’estate venga organizzato come previsto, prima dell’inizio dell’autunno!\n\nIl tempo è tiranno, mio signore!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "Organizza il festival d’estate prima dell’inizio dell’autunno.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "Che bel festival, mio signore!\n\nMa ora dobbiamo fare in modo che il festival d’inverno venga organizzato come previsto e terminato prima dell’inizio della primavera! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "Organizza il festival d’inverno prima dell’inizio della primavera!";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "Mio signore, ti consiglio di costruire un centro fieristico al più presto. Tutti i festival si terranno lì.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "Costruisci un centro fieristico.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "Ottimo, mio signore! Il centro fieristico è stato completato. Questo edificio è molto importante per i compiti che ci aspettano, quindi è meglio tenerlo d’occhio.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "Milord, ci occorre un centro fieristico per le festività! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "La prima cosa che ci serve è un albero della cuccagna come si deve, mio signore. Il taglialegna può procurarci un tronco adatto. Ma dovremo abbattere molti alberi per trovare il migliore.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "Raccogli legname per l’albero della cuccagna.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "Il nostro albero della cuccagna deve essere decorato bene. Per questo si serve stoffa a sufficienza, milord.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "Produci del tessuto per l’albero della cuccagna.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "Che bell’albero della cuccagna. Sapevi che è tradizione tra i miei confratelli rubare gli alberi della cuccagna della zona, ogni anno?";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "Ahr ahr ahr! Il tuo albero della cuccagna è nostro ora! Sarà una bella decorazione per il nostro accampamento. Vieni a riprendertelo, se hai il coraggio...";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "Proteggi l’albero della cuccagna dagli attacchi dei banditi!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "Maledizione! Si erano quasi presi l’albero della cuccagna. Lo hai difeso bene, Governatore!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "Milord! C’è un accampamento di banditi nei pressi della città. Ci serviranno più uomini e un’altra torre di guardia per mettere in sicurezza il villaggio.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "Costruisci un’altra torre di guardia e assegnale sufficienti soldati.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "Molto bene! Ora i nostri soldati possono difendere il centro fieristico molto più facilmente dagli attacchi dei banditi!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "L’albero della cuccagna è stato rubato dai nostri magazzini. Dobbiamo attaccare l’accampamento dei banditi e riprendercelo, se vogliamo che il festival cominci in tempo.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "Attacca l’accampamento dei banditi e riprenditi l’albero della cuccagna!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "Vittoria! L’albero della cuccagna è stato riportato nel nostro magazzino, milord.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "Milord! La fattoria va a fuoco! Per favore, devi fare qualcosa!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "Che disastro, Governatore! La fattoria è andata a fuoco e il raccolto è distrutto...";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "Salva la fattoria!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "Te ne sarò per sempre grato, mio signore!\n\nMa il fuoco ha distrutto il raccolto! I festeggiamenti rischiano comunque di saltare se non completiamo il raccolto in tempo.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "La fattoria della mia famiglia è andata a fuoco, milord! Non riusciremo mai a produrre il primo pane dell’anno in tempo per il festiva! Saresti così gentile da ordinare la ricostruzione della fattoria?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "Costruisci una nuova fattoria.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "Grazie, milord.\n\nSenza di te sarei rovinato e la festa d’estate avrebbe dovuto essere cancellata!\n\nMa dobbiamo fare presto per raccogliere il grano in tempo!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "Milord, ora dobbiamo curare il raccolto. C’è ancora un po’ di tempo prima dell’inizio del festival. Dobbiamo fare in modo che venga raccolto grano a sufficienza.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "Completa il raccolto di grano.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "Fa molto caldo in questi giorni, mio signore. Spero che non scoppino altri incendi o siccità a mettere in pericolo i festeggiamenti. Però ora abbiamo abbastanza grano per i festini. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "Milord, i miei campi sono così secchi che temo che quest’estate avremo un’altra siccità. Saresti così generoso da costruire un altro paio di pozzi per irrigare i campi?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "Costruisci diversi pozzi per irrigare i campi.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "Ben fatto, mio signore! I campi sono stati irrigati. Ora dobbiamo solo attendere che il grano cresca di nuovo.\n\nSpero che non ci voglia tanto...";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "Il banchetto inizierà quando avremo terminato di cuocere il primo pane del raccolto, mio signore. Potresti assicurarti che la preparazione venga completata in tempo?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "Cuoci pane a sufficienza per il festival d’estate.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "Splendido, mio signore. Il pane per il banchetto è pronto!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "Milord! Ci manca qualcosa per il festival... la birra! Dovresti ordinare la costruzione di un monastero-birreria per far produrre della birra ai monaci!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "Produci della birra per il festival d’estate.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "Molto bene, mio signore. Quella birra è molto buona e rinfrescante, in un’estate calda come questa.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "Ho un’idea meravigliosa per il festival invernale, mio signore. Nel corso dei miei viaggi sono venuto a conoscenza di uno speciale vino invernale chiamato vin brulé.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "Consegna gli ingredienti per il vin brulé.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "Perfetto, mio signore. Ora abbiamo tutti gli ingredienti per il vin brulé. Inizierò immediatamente a preparare la bevanda.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "Signore, vengo a chiederti le decorazioni per l’albero. Sarebbe davvero bello avere delle decorazioni dorate.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "Produci pepite d’oro per le decorazioni.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "Magnifico, signore. Queste palline sono davvero belle. Ti ringrazio per aver speso il tuo tempo prezioso per queste decorazioni natalizie. Credo che questo sarà un festival meraviglioso.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "Io e i ragazzi vorremmo organizzare una recita natalizia per il festival. Purtroppo ci mancano delle risorse essenziali per la recita. Saresti così gentile da procurarci l’attrezzatura necessaria?";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "Prepara le risorse per la recita sulla natività.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "Grazie, mio signore. Ora possiamo iniziare a creare i nostri costumi per la recita.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "Milord, ho pensato di produrre pan di zenzero per il festino. Le risorse necessarie potrebbero essere difficili da trovare, però.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "Consegna gli ingredienti per il pan di zenzero.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "Ottimo, mio signore. Inizierò immediatamente a cuocere il pan di zenzero.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "In questo periodo non dovremmo dimenticare i meno fortunati. Quindi sto raccogliendo denaro per i poveri. Sarebbe molto gentile da parte sua donare una parte delle tasse cittadine per la nostra causa.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "Riscuoti abbastanza tasse per i poveri.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "Grazie per la tua generosa donazione, mio signore!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "Governatore,\nmi spiace informarti che per il momento non sono in grado di fare visita alla tua città.\nHo saputo che ci sono banditi nei boschi circostanti. Per i mercanti è troppo pericoloso viaggiare.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "Molte grazie, mio signore. Ora che i banditi sono stati allontanati dall’area, visiterò di nuovo la tua città regolarmente.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "Mio signore, la chiesa è crollata. In momenti come questo abbiamo bisogno di tutto il sostegno possibile. Dobbiamo costruire un'altra chiesa per la nostra città.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "Governatore, sta accadendo qualcosa di strano in città. Nell'arco di questa stagione abbiamo già subito sette catastrofi! Dobbiamo scoprire che cosa sta succedendo. Comincio a credere che siamo maledetti...";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "Milord, dobbiamo abbandonare subito la città. È la fine... siamo condannati! Questa maledizione non verrà mai spezzata.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "Trova un modo per spezzare la maledizione.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "Hai salvato la città! Che bella notizia. Finalmente, la maledizione è stata spezzata... e sei anche riuscito a sopravvivere al rituale.\n\nLa città, tuttavia, avrà bisogno di un po' di tempo per riprendersi...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "La città ha bisogno di una fornitura adeguata di erbe medicinali quanto prima, milord, o la pestilenza continuerà a seminare scompiglio in città.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "Crea erbe medicinali.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "Non sconfiggeremo mai la pestilenza se non costruiremo almeno un'infermeria, milord. Anzi, forse sarebbe meglio costruirne più di una...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "I medici cittadini hanno bisogno di altro materiale per i bendaggi, per curare adeguatamente le vittime della pestilenza. Dovresti inviare loro un po' di tessuto.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "Milord, la pestilenza sta imperversando in città! Purtroppo, fintanto che continueranno ad accadere questi disastri, nessun mercante ci farà visita...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "Abbiamo bisogno di un mulino a vento per trasformare il grano in farina, milord. In questi tempi difficili, dobbiamo adattare la nostra produzione alimentare, mio signore.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "Per produrre il pane dobbiamo costruire un forno, milord.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "È giunto il momento di fare scorta di pane. Dobbiamo dare da mangiare ai cittadini! Dio ci scampi da una popolazione affamata...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "Milord, il bestiame... gli animali, i pesci nel fiume... stanno morendo! Che succede?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "La chiesa va a fuoco, Governatore! Dio ci ha abbandonato: ci aiuti lei...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "Ho fatto alcune ricerche nella chiesa e ho trovato dei documenti che potrebbero esserci d'aiuto, mio signore.\n\nPurtroppo, ora non è sicuro entrare in chiesa e non riesco a raggiungere i miei documenti.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "Grazie, mio signore. Dia un'occhiata a questi documenti. Tempo fa, proprio nel luogo in cui si trova la nostra piccola città sorgeva un antico cimitero.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "In passato, vi era un consigliere speciale alla corte del re. Era un veggente, esperto di rituali pagani e... cose simili. Un giorno impazzì e provò ad avvelenare il Re: per questo, fu imprigionato.\n\nMi metterò in contatto con il Re, può darsi che ci permetterà di parlare con lui.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "Ripara la chiesa.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "Il Re non ci aiuterà: dobbiamo farci artefici del nostro destino e liberare il veggente.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "Milord! I cittadini sono nel panico! Dobbiamo dare sfoggio della nostra potenza militare e riportare la calma.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "Governatore, non ho intenzione di scarcerare questo vile marrano. Non mi interessa della maledizione: quest'uomo ha provato a uccidermi, e marcirà in prigione.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "Maledizione, Governatore... perché ci ha attaccato? Certo, vi abbiamo derubato innumerevoli volte, ma non...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "Governatore, siamo anche noi vittime di questa maledizione in prima persona. Noi banditi non possiamo più derubare i ricchi mercanti quando si abbattono sulla città sventure del genere.\n\nLa aiuteremo a far uscire di prigione quel tizio...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "C'è un accampamento di banditi nei pressi della nostra città, milord. Forse potremmo... persuaderli a liberare il veggente dalle prigioni.\n\nQuell'uomo ha le risposte che andiamo cercando! Dia l'ordine di attaccare il campo, per avviare le... trattative.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "Che grande vittoria abbiamo riportato sui banditi, mio signore. È ora di fare due chiacchiere coi loro capi...\n\nForse ci aiuteranno a spezzare la maledizione.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "Pare che l'ira di Dio si stia scatenando su di noi, milord. Gli agricoltori hanno segnalato un'emergenza siccità!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "Per prepararci a dovere all'attacco alla prigione avremo bisogno di attrezzature di livello militare, di un campo di addestramento adatto e di provviste. Suggerisco di iniziare dall'Armeria!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "I miei uomini devono ricevere un addestramento per portare a termine l'attacco alla prigione, Governatore. Se vuole davvero andare fino in fondo, dobbiamo trovare un posto in cui poter affinare le nostre abilità.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "Costruisci un campo di addestramento per arcieri.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "Governatore, sarebbe fantastico se potesse trovarci qualcosa da mangiare e da bere, quantomeno per il capogruppo... vale a dire per ME!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "Consegna le provviste.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "Ci servono delle attrezzature, Governatore. Le nostre spade di legno e le asce che utilizziamo di solito non ci serviranno a molto contro i guardiani della prigione.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "Consegna le attrezzature militari.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "Milord, il sole! Sta per verificarsi un'eclisse! Dobbiamo fare in fretta, o saremo perduti per sempre!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "Fantastico! Siamo quasi pronti a far evadere il nostro amico di prigione! La prossima volta che ci incontreremo, potrà parlargli di persona...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "Forse potresti convincermi facendo in modo che ne valga la pena. È da un sacco di tempo che non mi mangio una bella salsiccia.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "E va bene, e va bene, vi aiuterò. Questa maledizione non è certo la peggiore che abbia mai visto, ma è comunque molto fastidiosa; tuttavia, è possibile liberarsene con un semplice rituale.\n\nMi chiedo a chi mai sia venuta la brillante idea di costruire una città su un antico cimitero...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "Comunque, ho una buona notizia: la maledizione può essere spezzata. Tuttavia, avremo bisogno di alcune risorse che non saranno facili da reperire.\n\nCi serve un cristallo di quarzo magnetizzato, una pozione dell'atemporalità e un parafulmine.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "Governatore, il caso vuole che durante una delle mie scorribande abbia... trovato un cristallo del tipo che sta cercando. Purtroppo, se l'è portato via il mio compagno "Collo di ferro" quando il nostro gruppo si è diviso per alcune divergenze.\n\nIl suo accampamento è qui in zona.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "Ottieni il cristallo magnetizzato dall'accampamento dei banditi";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "Governatore, per costruire un parafulmine servono alcune sbarre di ferro e un po' di utensili.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "Costruisci il parafulmine.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "Milord, posso preparare la pozione se mi porterà gli ingredienti di cui ho bisogno.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "Ottieni gli ingredienti per la pozione.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "Ora devi bere la pozione, tenendo il parafulmine nella mano sinistra e il quarzo magnetizzato in quella destra. Dopodiché, devi restare all'aperto fino a quando un fulmine non colpirà il parafulmine.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "Esegui il rituale.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "Non mi sarei mai aspettato di venir liberato da te. È grazie a TE se sono finito in carcere...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "Beh, allora siete sotto l'influenza di una terribile maledizione. E così, volete che vi aiuti?";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "Mio Dio! Una terribile tempesta di fulmini si sta abbattendo sulla nostra umile città. Assicuriamoci che le nostre torri dei pompieri siano pronte all'azione.";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "Governatore, è troppo pericoloso per me seguirvi nella vostra città. Ma posso comunque dare il mio contributo, se siete disposto a pagarne il prezzo...";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "Credo che i soldati di questa città siano uno spreco di risorse! Perché non li vendiamo al miglior offerente e ci facciamo su un bel gruzzoletto? Si accerti solamente che il quartiermastro sia... assente per qualche tempo, e tutto filerà liscio.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "Licenzia il quartiermastro dalla caserma.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "Licenza i trasportatori dal castello.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "Governatore, i miei ragazzi hanno bisogno di un po' di tranquillità nei pressi delle mura cittadine. Sa com'è, a loro piace starsene da soli mentre "spostano" le merci fuori dalle mura. Dovrebbe far sì che le guardie andassero a farsi un giro per qualche tempo...";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "Licenzia i soldati.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "Ho un piccolo problema con la popolazione di questa città. Vede, noi li proteggiamo e li aiutiamo e loro si rifiutano di riconoscerci un rimborso spese per la nostra gentilezza innata... ma in che mondo siamo finiti?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "Raccogli il pizzo.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "Governatore, mi spiace doverla avvisare che non ha raccolto denaro a sufficienza da coprire le "spese" che abbiamo in città. Ho bisogno che qualcuno ci metta la grana che manca. Che ne dice di... investire un po' di denaro lei stesso?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "I miei compari vorrebbero organizzare un piccolo torneo di giochi d'azzardo presso la taverna stasera... è quasi tutto legale, non si preoccupi. Che ne dice di inviare alla taverna un po' di birra e succo d'uva per animare la festa?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = "I miei "colleghi" vorrebbero rifocillarsi adeguatamente durante il torneo. Perché non invia loro alcune salsicce e un po' di pane, in modo che nessuno debba fare la fame?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "Consegna le salsicce e il pane.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "Governatore, ho un'altra richiesta per lei. I miei scagnozzi... volevo dire, i miei colleghi hanno bisogno di altri mezzi per esercitare pressione in modo più convincente. Ci servirebbe che mandasse un po' di armi e armature, va bene?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "Consegna le armi e le armature.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "I miei "colleghi" vogliono divertirsi un po', Governatore. Abbiamo bisogno di una taverna per rilassarci. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "Benvenuto, Governatore. La ringrazio per avermi concesso udienza. Sono il rappresentante dei... beh, di coloro che di solito si fanno i fatti loro. Se possiamo sostenere la sua campagna alla rielezione? Ma certo! Ma prima vorremmo che sistemasse alcune cose per noi.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "Governatore, è stato di parola: ci ha sostenuti e aiutati, e ora è il nostro turno di dimostrarle la nostra riconoscenza.\n\nSa come si dice... una mano lava l'altra. E vedrà che le elezioni saranno un grande successo! ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "Completa tutte le missioni dei lestofanti.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = "Scegli i lestofanti.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "Lavora con il club del giardinaggio.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "Lavora con la gilda dei mercanti.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "Scegli l'esercito.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "Scegli la nobiltà.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "Milord, dovrebbe decidere a quale fazione dare il proprio sostegno. Dopo aver preso questa decisione, dovrebbe fare in modo di soddisfare le loro richieste: una volta che li avrà convinti a votare per noi, potrà scegliere un'altra fazione.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "Fai visita al clero.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "Scegli i servitori.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "Fai visita al popolino.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "Questa città è così sciatta. È evidente che lei non è una persona di buon gusto ed eleganza. Perché non fa qualcosa per cambiare la situazione, Governatore?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "Pianta altre aiuole.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "Governatore, se ne sta ancora lì a perder tempo? Non vede che i fiori stanno appassendo? Dovrebbe fare più attenzione all'ambiente e alla meravigliosa natura che la circonda.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "Questa città puzza, Governatore! E stavolta è solo colpa sua. Le fogne sono ostruite e il liquame ristagna nelle strade.\n\nDeve fare qualcosa!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "Costruisci altri tombini.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "Rieccoci! Finalmente la città è tornata presentabile e i fiori sbocciano nuovamente a ogni angolo di strada... ma date un'occhiata alle case! Cadono a pezzi, per non dir di peggio.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "Governatore, che disgrazia!\nQuesti animali si sono mangiati gran parte dei miei splendidi fiori. Come ha potuto permettere che accadesse?\n\nRichiedo immediatamente altri avamposti di caccia per eliminare queste creature immonde e far prosperare le mie aiuole.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "In occasione della fiera statale dell'orticoltura, dovrà assicurarsi che siano disponibili posti a sedere a sufficienza. Basteranno alcune panchine, sparse adeguatamente per tutta la città.\n\nNon se ne dimentichi, mi raccomando!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "Costruisci panchine in città.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "Governatore, quei poveri animali...\n\nI maiali vengono allevati in condizioni disumane e non possono correre liberi come sarebbe giusto che fosse.\n\nIl club del giardinaggio richiede l'immediata distruzione della porcilaia e della macelleria!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "Demolisci la porcilaia e la macelleria.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "Governatore, io sono la presidentessa del club del giardinaggio. E così vuole il nostro sostegno alle prossime elezioni? Non capisco perché un'esperta e competente signora come me non possa essere eletta Governatrice di questa città...";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "Nonostante i miei dubbi riguardo alla sua competenza da Governatore, si è rivelato un vero amico del club del giardinaggio.\nVoteremo per lei alle prossime elezioni.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "Completa tutte le richieste del club del giardinaggio.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "Milord, presto verrà eletto un nuovo Governatore in questa città.\n\nLe consiglio di iniziare a convincere le fazioni di questa città a votare per lei. Non credo che avremo tempo a sufficienza per convincere tutti, quindi scelga con attenzione a chi chiedere sostegno.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "Sono appena stati pubblicati i risultati delle elezioni, milord.\n\nTemo di doverle comunicare che non siamo riusciti a ottenere la maggioranza dei voti dalle fazioni cittadine.\n\nDobbiamo sgomberare il nostro castello entro la prossima settimana, quando il nuovo Governatore entrerà in carica...";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "Milord, siamo riusciti a convincere abbastanza fazioni della città a votare per noi. Il nostro mandato in questa città è al sicuro!\n\nBrindiamo alla nostra vittoria... e alla conservazione della nostra poltrona!";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "Mio Governatore, manca molto poco alla data delle elezioni. Dobbiamo sbrigarci e convincere un numero sufficiente di fazioni a votare per lei.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "Tempo residuo: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "Convinci un minimo di 3 fazioni per vincere le elezioni.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "Milord, la gilda dei mercanti è inferocita! Il nostro mercato è stato distrutto e avrebbe dovuto ricostruirlo molto tempo fa.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "Che affronto! I cittadini viaggiatori hanno stoccato troppe merci nell'edificio della gilda dei mercanti, che è crollato! Sarà impossibile fare affari in questa città, se continueranno ad accadere cose del genere.\n\nLa prego di ricostruire la gilda dei mercanti!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "Ricostruisci la gilda dei mercanti.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "Fantastico, mio signore. Ora sì che si ragiona: possiamo ricominciare a commerciare. Che ne dice di porre in essere un accordo commerciale presso la gilda? In questo modo, la nostra città riconquisterà il lignaggio che le spetta nella regione.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "Poni in essere un accordo commerciale attivo presso la gilda dei mercanti.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "Denaro! Tutto gira attorno al denaro, Governatore. Dobbiamo assolutamente assicurarci che il commercio porti entrate a sufficienza.\n\nGovernatore, è tempo di diventare ricchi!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "Il mercato si riempie troppo in fretta, Governatore. Dovrebbe considerare la possibilità di ampliarlo, in modo da avere più spazio e poter commerciare meglio.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "Amplia il mercato.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "Molti cittadini ci stanno chiedendo di aprire delle bancarelle sparse qua e là per la città, Governatore. In questo modo potremmo aumentare la domanda interna. Mi pare un'ottima idea... e a lei?";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "Posiziona alcune bancarelle in città.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "Governatore, ho appena siglato un accordo commerciale molto redditizio. I prezzi di vestiti e birra sono schizzati alle stelle!\n\nRiesco già a sentire l'odore dei soldi! Un sacco di soldi.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "Vendi vestiti e birra presso il mercato.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "Governatore, sono il rappresentante della gilda dei mercanti. Per ricevere il nostro voto durante le prossime elezioni, è necessario migliorare notevolmente le condizioni commerciali cittadine.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "È un bel giorno per fare affari, milord.\n\nÈ riuscito a trasformare questa città nel cuore pulsante dei commerci della regione, e per questo motivo i mercanti della mia gilda le saranno per sempre grati. \n\nIn segno di ringraziamento, voteremo per lei alle prossime elezioni.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "Completa tutte le missioni della gilda dei mercanti.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "È inaccettabile! Davvero inaccettabile!\n\nCome possiamo rifornire le nostre torri di guardia, se non abbiamo nemmeno una caserma in città?\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "Costruisci una caserma.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "Finalmente un Governatore che sa far funzionare le cose. Beh, sarebbe auspicabile che assegnasse alcuni soldati alle torri di guardia.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "In qualità di comandante in capo, mi è impossibile riorganizzare le truppe e trovare qualche minuto per riposarmi dopo la battaglia. Il mio corpo, usurato dalle fatiche di guerra, brama una tenda confortevole...";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "Costruisci alcune tende per gli ufficiali.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "Governatore, le nostre forze attuali non sono sufficienti. Qualsiasi bandito da due soldi si metterebbe a ridere a crepapelle al cospetto del nostro patetico esercito!";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "Abbiamo bisogno di provviste per l'esercito, Governatore. Le migliori provviste sono ovviamente le salsicce. Hanno una resistenza elevata e possono essere consumate rapidamente sul campo.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "I nostri valorosi soldati non possono addestrarsi per affrontare le prossime battaglie, Governatore, perché non abbiamo lo spazio adatto per farlo! In qualità di comandante delle forze armate, le chiedo di costruire un campo di addestramento per arcieri.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "Benvenuto, Governatore. E così sta cercando il sostegno dell'esercito per le prossime elezioni?\n\nBeh, dovrà fare qualcosa per convincerci a votare per lei.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "Molte grazie, Governatore. Ha saputo rendere noi soldati semplici fieri di ciò che facciamo. L'esercito non è mai stato così potente come durante il suo governatorato. Si è guadagnato il nostro voto alle prossime elezioni.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "Completa tutte le missioni dell'esercito.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "Non esiste alcuna grande città che non offra un'ampia scelta di bevande per i suoi cittadini, milord. Specialmente noi appartenenti alla nobiltà vogliamo qualcosa di stravagante... per esempio, succo d'uva.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "La nobiltà festeggia il completamento della nuova catena di produzione, milord.\n\nPer le celebrazioni avremo bisogno di un immane quantitativo di succo d'uva. Ma la prego, non ci rifili della brodaglia da due soldi...";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "Milord, non starà dicendo che dovremo andarcene alla taverna come i comuni mortali? Il sito del torneo fuori dalla città è in rovina da anni.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "Un grande campione della nobiltà ci ha lasciato recentemente, milord. Se fosse così gentile da costruire un mausoleo e una statua in suo onore, renderebbe felici moltissimi nobili della città.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "Costruisci un mausoleo e una statua dell'eroe.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "Milord, a questa città mancano alcuni oggetti di valore che la nobiltà giudica indispensabili. Non esiste modo migliore di rimarcare il proprio rango sociale che indossare gioielli di lusso, mio signore.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "Splendido, mio signore. La domanda di gioielli è attualmente alle stelle, perché tutti vogliono quelli indossati dalla corte.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "Sono onorato di fare la sua conoscenza, mio signore. Rappresento la nobiltà di questa città. Se vorrà guadagnarsi il nostro voto per le prossime elezioni, dovrà soddisfare le nostre... stravaganti richieste.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "È incredibilmente riuscito a soddisfare tutte le richieste della nobiltà, mio signore. Nella sua città un nobile ha gli stessi privilegi di cui godrebbe alla corte del Re. Sta facendo grandi cose per questa città!\n\nHa ottenuto il nostro voto per le prossime elezioni.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "Completa tutte le richieste della nobiltà.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "La nostra comunità religiosa si sta riducendo sempre di più, mio signore: la popolazione passa tutto il tempo a bighellonare e far festa. Tutto ciò deve finire.\n\nÈ necessario sbarazzarci di quella taverna peccaminosa. La distrugga per noi! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "Molto bene! Quella struttura blasfema avrebbe già dovuto venire rasa al suolo mesi fa. Finalmente, qualcuno ha avuto il coraggio di farlo.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "Demolisci la taverna.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "La nostra chiesa è troppo piccola per contenere il fervore dei nuovi credenti. Da quando la taverna è stata distrutta, la chiesa è sempre affollatissima.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "Sia lode a Dio! Che chiesa meravigliosa. Lei è benedetto dal Signore.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "Amplia la chiesa o costruiscine una nuova.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "La nostra comunità non è soddisfatta dall'offerta spirituale attualmente presente in città. Il popolo deve poter soddisfare la propria sete di salvezza!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "Mio signore, ce l'ha fatta. Sapevo che la nostra fiducia in lei sarebbe stata ben riposta. Ha reso nuovamente felice la nostra comunità.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "I miei confratelli si sono recentemente lamentati della carenza di luppolo in città. Non possiamo produrre birra senza la quantità di luppolo necessaria!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "Costruisci un essiccatoio.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "Adesso che la produzione di luppolo è ritornata a crescere, sarebbe opportuno aumentare anche la produzione di birra...\n\nAmplia il monastero. In alternativa, possiamo accettare anche la costruzione di un monastero nuovo.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "Il nostro nuovo monastero splende della gloria del Signore. Ben fatto, Governatore!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "Amplia il monastero o costruiscine uno nuovo.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "Per l'inaugurazione del nostro nuovo monastero avremo bisogno di una montagna di birra! I nostri ospiti avranno sete.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "La produzione è birra è stata completata, Governatore. Vuole avere l'onore di assaggiarne il primo sorso?";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "Il cimitero cittadino è troppo piccolo e non ha spazio a sufficienza per le tombe. È necessario che ordini la costruzione di alcuni nuovi mausolei e tombe.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "Amplia il cimitero costruendo mausolei e tombe.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "Adesso che abbiamo ampliato il cimitero è ora di considerare la costruzione di nuove mura. È auspicabile che ordini la costruzione di nuove mura per delimitare il perimetro del cimitero.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "Costruisci nuove mura per il cimitero.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "Benvenuto, Governatore. Noi monaci potremmo sostenerla durante la prossima campagna elettorale a nome del clero tutto... sempre che si dimostri disponibile a farci un piccolo favore.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "Sia lode a Dio, Governatore. Ha soddisfatto appieno le nostre necessità. Oltre a essersi guadagnato un meritatissimo posto in paradiso, ha ottenuto anche il voto del clero per le prossime elezioni.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "Completa tutte le missioni del clero.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "Milord, i pompieri hanno pochi mezzi a disposizione per combattere gli incendi che divampano in tutta la città. Sarebbe di grande aiuto se potessero disporre di altre torri dei pompieri.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "Alcuni membri della nostra fazione vorrebbero che in città ci fosse una carovana di giocolieri. In questo modo, potremmo divertirci e distrarci un po'!";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "Mio Governatore, i cittadini che si occupano dei trasporti sono sovraccarichi di lavoro: i compiti a loro assegnati in città sono davvero troppi! Sarebbe molto utile se ordinasse la costruzione di nuovi magazzini.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "Milord, i carpentieri si stanno lamentando dei loro abiti. Le attività di riparazione che devono effettuare portano i loro indumenti ad usurarsi più spesso. Hanno davvero bisogno di nuovi vestiti.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "Consegna gli abiti.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "Milord, i nostri trasportatori hanno bisogno di nuove scarpe. Non c'è bisogno che ce ne acquisti di nuove: possiamo crearle da soli.\n\nAbbiamo solo bisogno di un po' di cuoio e tessuto.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "Consegna il tessuto e il cuoio.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "Milord, una piccola donazione per la nostra fazione ci renderebbe ancora più convinti del fatto che lei è davvero il Governatore migliore di tutti i tempi...";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "Dona una moneta ai servitori.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "Mio Governatore, l'esattore avrebbe bisogno di un giorno di ferie: non è più nel fiore dei suoi anni e i suoi reumatismi non gli danno tregua.\n\nChe ne dice di riscuotere le tasse in prima persona per un po' di tempo?";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "Licenzia l'esattore e riscuoti le tasse.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "Milord, sono il rappresentante della fazione dei servitori della città.\n\nNoi siamo i corrieri, i pompieri, i carpentieri e gli esattori delle tasse che permettono a questa città di andare avanti. Anche noi voteremo alle prossime elezioni; se migliorerà le nostre condizioni di vita e di lavoro, potrebbe guadagnarsi il nostro sostegno.";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "Milord, lei si è dimostrato un vero amico dei servitori. Si preannunciano tempi di vacche grasse per noi! Non avremmo mai pensato di poter migliorare così tanto le nostre condizioni.\n\nIl nostro voto alle prossime elezioni andrà a lei!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "Completa tutte le missioni dei servitori.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "Milord! La pestilenza si sta diffondendo in tutta la città. La prego, ci aiuti! I miei figli si trovano nel quartiere che è stato infettato, e non ci sono infermerie in città.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "Mio Governatore, le provviste cittadine sono inadeguate. I contadini hanno segnalato che ci mancano edifici fondamentali. Dovrebbe ordinare la costruzione di una nuova fattoria e di un nuovo forno.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "Costruisci una fattoria e un forno.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "Milord, il popolino non ha niente che lo intrattenga e le nostre attività quotidiane sono faticosissime. Sarebbe fantastico avere un luogo in cui poter dimenticare per un momento i nostri dolori! Perché non costruire un centro fieristico?";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "Milord, gran parte della popolazione vive in condizioni di indigenza. Dia nuovo lustro al suo nome ridistribuendo parte delle tasse riscosse al popolo.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "Ridistribuisci parte delle tasse riscosse al popolo.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "Ora che abbiamo le infrastrutture necessarie, dovremmo fornire al nostro popolo cibi più variegati. La dieta della maggior parte dei cittadini poveri attualmente non comprende carne. Lei può porre fine a tutto questo.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_TITLE" = "Consegna la carne.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_DESC" = "Milord, siamo noi che mietiamo il grano, lo maciniamo e inforniamo il pane. Eppure, questo alimento scarseggia sulle nostre tavole.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_TITLE" = "Consegna il pane.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_07_DESC" = "Milord, le manca molto poco per ottenere il nostro totale appoggio. L'ultima cosa che le chiediamo di fare è rendere l'intera città più felice, e noi in cambio ci impegneremo ad aumentare la nostra produttività.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_START" = "Benvenuto, Governatore. In qualità di mugnaio, sono il portavoce del gruppo di contadini della città. Se riuscirà a rendere più semplice la nostra vita, voteremo per lei alle prossime elezioni.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_SUCCESS" = "Lei ha davvero a cuore le sorti del nostro popolo, milord. Completando le missioni che le abbiamo assegnato, ha aiutato i deboli e i bisognosi. Ora la nostra vita è molto più semplice. La ringrazio, mio signore.\n\nPotrà contare sul nostro voto alle prossime elezioni.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_TITLE" = "Completa tutte le missioni per i contadini.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_DESC" = "Milord, la nostra economia non può sostenere un carpentiere. Non abbiamo le risorse necessarie. Dovrebbe licenziare il carpentiere dal proprio edificio, per ora.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_TITLE" = "Licenzia il carpentiere.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_02_DESC" = "Non produciamo abbastanza cibo, milord. Sarebbe consigliabile costruire qualche altra capanna per i pescatori.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_03_DESC" = "Prima di scegliere una delle fazioni cittadine, dovrebbe ordinare la costruzione di una segheria! Milord, si tratta di un edificio fondamentale per l'economia della città.";
"T_SCENARIO_7_QUEST_INTRO_DESC" = "Mio buon Siniscalco, mia figlia sposerà il Principe Guglielmo Clemente III di Giebelstadt. Voglio che organizzi tutti i preparativi per questa importante occasione. Non hai molto tempo da perdere, quindi presto! Hai la mia completa fiducia.";
"T_SCENARIO_7_QUEST_INTRO_NAME" = "Organizza i preparativi per il grande matrimonio reale completando tutti gli incarichi!";
"T_SCENARIO_7_QUEST_OUTRO_DESC" = "Grazie per il tuo fantastico lavoro! Sei stato perfetto, il matrimonio ora può cominciare! E tu sei invitato, naturalmente!";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_DESC" = "I banditi attaccheranno molto presto; dobbiamo farci trovare pronti. Mandate degli uomini a presidiare le torri di guardia.";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_NAME" = "I banditi stanno per attaccare!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_DESC" = "Milord, l'economia della città è in ginocchio, a causa dei continui attacchi dei banditi. Spero che riusciremo a fermare l'assedio!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_END" = "Ottimo lavoro, milord. Avete respinto l'assalto ottimamente e siete addirittura riuscito a far fiorire le attività economiche. Persino il cavaliere è rimasto impressionato dalle sue azioni. ";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_NAME" = "Stabilisci un'infrastruttura e difendi la città.";
"T_SCENARIO_BESIEGEMENT_QUEST_01_DESC" = "Un misero Governatore e il suo consigliere? Non è certo l'aiuto che speravo di ottenere. Non credo che sarete di grande aiuto contro i banditi. Tutti gli altri... alle armi!";
"T_SCENARIO_BESIEGEMENT_QUEST_01_END" = "L'ondata di banditi è stata respinta. Possiamo riposare un po', fin quando i nostri ricognitori non porteranno notizie di un altro attacco.";
"T_SCENARIO_BESIEGEMENT_QUEST_02_2_DESC" = "Abbiamo bisogno di altre torri di guardia per difendere la città. Costruiscile immediatamente!";
"T_SCENARIO_BESIEGEMENT_QUEST_02_DESC" = "Governatore, che ne dice di rendersi utile dando l'ordine di costruire altre torri di guardia?";
"T_SCENARIO_BESIEGEMENT_QUEST_03_DESC" = "La nostra caserma è crollata! Dobbiamo costruirne una nuova. Credo che questo sia un lavoro che fa al caso suo, Governatore.";
"T_SCENARIO_BESIEGEMENT_QUEST_04_DESC" = "Le suggerisco di inviare un messaggio alla corte del Re, milord. Ma avremo bisogno di un travestimento. Iniziamo con un po' di tessuto.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_DESC" = "Abbiamo bisogno di un po' di cuoio per il travestimento. In modo che sembrano i vestiti di un bandito.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_NAME" = "Consegna il cuoio.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_DESC" = "Per fare la barba avremo bisogno di un po' di lana. In questo modo, aumenteremo la probabilità che il nostro messaggero riesca a raggiungere il Re.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_NAME" = "Consegna la lana.";
"T_SCENARIO_BESIEGEMENT_QUEST_07_DESC" = "Non possiamo starcene qui con le mani in mano ad attendere che il Re invii le sue truppe. Le armature della guardia cittadina sono in pessime condizioni; dobbiamo produrne di nuove per garantire la sicurezza della nostra città. ";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_DESC" = "Oh no, milord. Hanno distrutto la nostra caserma. Dobbiamo ricostruirla per poter rifornire adeguatamente i nostri soldati.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_NAME" = "Ricostruisci la caserma.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_DESC" = "I banditi si preparano ad assaltare in forze la caserma. Si tratta di un edificio essenziale, non possiamo permettere che venga distrutto!";
"T_SCENARIO_BESIEGEMENT_QUEST_08_NAME" = "Difendi la caserma.";
"T_SCENARIO_BESIEGEMENT_QUEST_09_DESC" = "L'esercito del Re non si è ancora fatto vedere. Non possiamo attendere oltre. Avremo bisogno delle lame più affilate che siamo in grado di produrre, oppure la nostra città cadrà nelle mani dei nemici.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_DESC" = "Governatore, l'accampamento sudorientale dei banditi sta bloccando la via che porta alle altre città. Se vogliamo che altri cittadini ci aiutino, dobbiamo distruggere quell'accampamento.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_END" = "L'accampamento dei banditi è stato distrutto! Adesso potranno accorrere in nostro aiuto molti altri cittadini.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "Distruggi l'accampamento sudorientale dei banditi.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "Siamo riusciti a trovare il mercante, milord. È tenuto prigioniero nell'accampamento accanto al fiume, a nordovest della città.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "Milord, il mercante è sano e salvo! Da ora in poi ricomincerà a farci visita a intervalli regolari.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_NAME" = "Distruggi l'accampamento nordoccidentale dei banditi.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_DESC" = "Milord, i banditi fanno incetta di legname nei dintorni dell'accampamento situato sulle montagne nordorientali. Se lo distruggeremo non saranno più in grado di dare fuoco ai nostri edifici.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_NAME" = "Distruggi l'accampamento nordorientale dei banditi.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_DESC" = "Il campo base dei banditi si trova a sudovest della città. Andiamo a distruggerlo e costringiamo i banditi alla resa. Carica!!!";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_NAME" = "Distruggi l'accampamento sudoccidentale dei banditi.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_DESC" = "Che cavaliere maleducato! Milord, l'economia della città è sostanzialmente devastata. Quando i nostri soldati avranno respinto i primi assalti dei banditi, dovremmo ordinare alla popolazione di produrre alcune risorse di base.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_NAME" = "Produci assi.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_02_DESC" = "Bene, milord. Dovremmo fare in modo di ricostruire la fattoria perché stiamo rimanendo senza cibo.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_DESC" = "Possiamo ricominciare a produrre pane. Ma dovremmo fare attenzione agli assalitori e insegnare alla popolazione a trasformarsi in soldati, quando ve ne sarà la necessità.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_NAME" = "Produci pane.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_11_DESC" = "Governatore, potremmo aumentare l'efficacia dei soldati fornendo loro della birra.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_12_DESC" = "Potremmo ulteriormente aumentare la potenza di combattimento dei soldati, milord. Ci servono solo delle salsicce.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_DESC" = "Lavorare e combattere tutto il giorno stanca, capo. Possiamo riposarci un po', milord? Sarebbe fantastico concedere un giorno di festa all'intera città.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_NAME" = "Non assegnare i cittadini ad alcuna lavorazione.";
