"T_GAME_QUEST_BOARDGAME_DO_NOTHING_001" = "Sire, la popolazione si sta ribellando! È una vera e propria guerra civile quella che sta avendo luogo sulle nostre terre!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_002" = "Ci è voluto un po' perché la popolazione si calmasse. Se questa situazione dovesse ripetersi, state attento alle decisioni che prendete, sire. Meglio evitare un'altra guerra civile...";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_003" = "Sire, la rivolta continua a imperversare! Che decisione orribile avete preso!";
"T_GAME_QUEST_BOARDGAME_FIRE_001" = "I vostri soldati hanno provato la vergogna peggiore della loro vita, alcuni non riescono nemmeno guardarsi allo specchio. Uno di loro, il capo del gruppo, ha deciso di vendicarsi sugli abitanti. Una delle vostre spie vi ha informato immediatamente.\n\nCosa volete fare?";
"T_GAME_QUEST_BOARDGAME_FIRE_002" = "Evita la vendetta.";
"T_GAME_QUEST_BOARDGAME_FIRE_004" = "Sire, prima di occuparci di questi soldati, dobbiamo fermare gli incendi!";
"T_GAME_QUEST_BOARDGAME_FIRE_005" = "Ora che gli incendi sono spenti e la città è al sicuro, prendiamoci cura di questi soldati.";
"T_GAME_QUEST_BOARDGAME_REVOLT_001" = "I cittadini non appoggiano la decisione che avete preso e hanno deciso di farsi giustizia da soli.\n\nHanno obbligato le guardie a indossare le scarpe coi campanelli e un cappello della vergogna. Ora devono andare in giro per la città vestiti così.\nAlcuni stanno tirando loro dei pomodori. \n\nDobbiamo fare qualcosa?";
"T_GAME_QUEST_BOARDGAME_REVOLT_002" = "Non fare nulla.";
"T_GAME_QUEST_BOARDGAME_REVOLT_003" = "Chiama i rinforzi.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_001" = "Dopo aver deliberato per un momento con il tuo consigliere, ti trovi di fronte a due soluzioni. Mandare i tuoi soldati sulle galee per punirli non solo per non aver mantenuto la posizione, ma anche per aver appiccato incendi, oppure obbligarli al servizio civile...";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_002" = "Sulle galee.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_003" = "Servizio civile.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_004" = "A malincuore decidi di mandare i tuoi soldati sulla galea. Dopotutto, devono essere d'esempio, altrimenti si potrebbe diffondere la voce che tu non sia abbastanza autoritario.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_005" = "I vostri soldati sono tornati. Questo breve soggiorno in mare ha rimesso loro la testa a posto.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_006" = "Dopotutto, perché non rendere le cose utili e piacevoli? Grazie ai soldati, la forza lavoro sarà più produttiva per qualche tempo.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_007" = "Tutte le cose belle prima o poi finiscono. I soldati hanno pagato i loro debiti ai cittadini, assistendoli nei loro compiti quotidiani.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_A" = "Avete fatto bene a intervenire, sire. Non meritano di ricevere dei pomodori addosso.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_B" = "Facciamola finita con questa storia organizzando una lotta per la giustizia. La popolazione sceglierà un campione e anche i soldati, e questi campioni si sfideranno in modo leale. Allora sarà fatta giustizia.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_C" = "Costruiamo una giostra. Il campione rosso combatterà per il popolo, mentre il campione blu combatterà per i soldati.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_002" = "CHE LA LOTTA ABBIA INIZIO!";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_003" = "Il cavaliere rosso ha vinto questo duello, la vittoria appartiene quindi al popolo.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_004" = "I soldati sono stati giudicati colpevoli e hanno dovuto prestare servizio alla comunità. Se ricominceranno a organizzare serate di gioco, saranno banditi dalla città.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_005" = "Il cavaliere blu è risultato il vincitore di questo duello, la vittoria appartiene quindi ai soldati.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_006" = "I cittadini dovranno risarcire i soldati per aver lanciato loro i pomodori. Tuttavia, i soldati devono svolgere un servizio alla comunità. Se ricominceranno a organizzare serate di gioco, saranno banditi dalla città.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_007" = "Sire, il re ha sentito parlare dell'uso della giostra per garantire la giustizia. Desidera dirvi che ha gradito l'idea e che quindi vi conferisce un certo prestigio. Tutto è bene quel che finisce bene.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_001" = "Invia cacciatori.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_002" = "Questo non mi riguarda.";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_A" = "Ma signore... per cacciare, dovremmo avere almeno un cacciatore... Non perdiamo tempo e costruiamo questo capanno di caccia!";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_B" = "Missione compiuta! Non male come battuta di caccia. La terra è salva.";
"T_GAME_QUEST_BOAR_REGULATION_TITLE" = "Sfoltimento cinghiali";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_001" = "Tuo fratello È un uccello.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_002" = "Ehi, ehi, ehi! Guardie! Prendetelo!";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Ti autorizzo a farlo.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Ok, basta così, portate quest'uomo da un guaritore.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Come sarebbe a dire? Mio fratello è un uccello? Siete tutti fuori di testa.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Quello che il Governatore sta cercando di dirvi è che dovete fidarvi di lui, vostro fratello sa quello che fa. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Se lo dite voi... Se gli succede qualcosa, vi riterrò responsabile!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Governatore, gli abbiamo dato un po' di sedativo, ora dorme. Stava borbottando cose strane su una tecnica che avrebbe potuto fargli superare le montagne, avete fatto bene a portarmelo. Un altro po' e ci avrebbe detto che la terra è rotonda!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Signore! Abbiamo incontrato un messaggero del palazzo, dice che il nostro inventore è assolutamente incredibile e che vorrebbe che rimanesse più a lungo nella capitale per continuare a lavorare alle sue invenzioni. L'influenza culturale della città ha fatto un balzo in avanti! Il re ha deciso di mandarci del prestigio.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Mio Signore, vengo da voi perché mio fratello è impazzito. Dice di essere un uccello e di saper volare! Ho paura che faccia qualcosa di stupido e decida di salire un po' troppo in alto per dimostrare che può volare come un uccello.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Oh signore! Grazie per non avermi rinchiuso nelle segrete! Mia sorella si preoccupa troppo per me. Volevo sorprendervi con la mia scoperta! Ho inventato una macchina che vola! Come gli UCCELLI! Vorrei presentarla alla grande fiera annuale della capitale.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Un uccello per fratello";
"T_GAME_QUEST_COVERAGE_DESC" = "Milord, la città non è pronta agli attacchi dei banditi!\nLa maggior parte del villaggio non è coperta dalle torri di guardia. Devi piazzare torri di guardia in modo che coprano più edifici possibile.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Mio signore, la città non è preparata per gli attacchi dei banditi! Alcune parti della città non sono coperte da edifici difensivi. ";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Aumenta la copertura della città con edifici difensivi";
"T_GAME_QUEST_COVERAGE_TITLE" = "Proteggi il villaggio con le torri di guardia.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "I banditi stanno attaccando il villaggio, Governatore!\nDobbiamo respingere quanti più predoni possibile per minimizzare i danni alla nostra economia e agli edifici!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Milord,\ni cittadini temono gli attacchi dei banditi. Dobbiamo dimostrare a loro, e soprattutto ai banditi, che siamo in grado di difenderci!";
"T_GAME_QUEST_DESIRES_01_START" = "Che regione squallida. Mancano tutti i vantaggi di una grande città.\n\nDovranno cambiare molte cose prima che questa cittadina provinciale diventi una metropoli fiorente!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Ora che i banditi sono stati sconfitti e il villaggio è cresciuto, qui è molto più gradevole.\nSono felice di essermi trasferita in questa città, amore mio.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Assicurati che tua moglie si senta a proprio agio.";
"T_GAME_QUEST_DESIRES_02_START" = "Questo villaggio ha bisogno anche di una sartoria, così potrò avere abiti su misura.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Grazie, amore!\nI miei vecchi abiti sono già logori.";
"T_GAME_QUEST_DESIRES_03_START" = "Mi manca l'attività fremente della città.\nAumenta la popolazione per donare vita a questo posto, te ne prego!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Incrementa la popolazione.";
"T_GAME_QUEST_DESIRES_04_START" = "Che villaggio pieno di vita!\n\nDi certo non avrai obiezioni se mi stabilisco qui.";
"T_GAME_QUEST_DESIRES_05_START" = "Dei banditi nella foresta?!\nCostruisci una torre di guardia per respingerli!";
"T_GAME_QUEST_DESIRES_06_START" = "Oh, una torre di guardia...\n\nQueste cose non fanno altro che stuzzicare i miei uomini!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Quei banditi causano problemi in città.\n\nVoglio che rinforzi immediatamente la guardia cittadina!";
"T_GAME_QUEST_DESIRES_07_START" = "Assicurati che la guardia cittadina scacci i banditi dalla città.";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Meraviglioso! Ora mi sento molto più al sicuro.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Respingi tutti gli attacchi dei banditi.";
"T_GAME_QUEST_DESIRES_08_START" = "Per assicurarci che le guardie facciano il loro dovere, dovremmo dare loro birra e salsicce.";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Produci birra e salsicce.";
"T_GAME_QUEST_DESIRES_09_START" = "Le guardie hanno bisogno di armi e armature per tenere a bada in banditi.";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Ora le guardie riusciranno a respingere tutti gli assalti dei banditi.";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Produci armi e armature.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Ho dimenticato di avvisarti che i miei uomini ti attaccheranno comunque!";
"T_GAME_QUEST_DESIRES_10_START" = "Il modo in cui soddisfi tutti i desideri di tua moglie mi fa pensare che tu non sappia come spendere tutto il tuo denaro.\n\nLascia che ti alleggerisca di questo peso!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Sarebbe una decisione saggia inviarmi subito quelle monete, amministratore.";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Offri monete.";
"T_GAME_QUEST_DESIRES_11_START" = "Non vorrai cedere a questo ricatto, vero?\nSpendere le monete in nuovi abiti sarebbe un investimento molto migliore!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Acquista tessuto dal mercante.";
"T_GAME_QUEST_DESIRES_12_START" = "Questo villaggio è noioso: manca l’intrattenimento!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "Questo villaggio è noioso: manca una giostra!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "Così va molto meglio!";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Costruisci un percorso per giostra.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Non hai imparato nulla dall'ultima volta. I miei ragazzi verranno a fare l'inventario!";
"T_GAME_QUEST_DESIRES_13_START" = "Pare che tu sia ancora troppo ricco. Dammi il tuo oro!\nE non osare sperperarlo per tua moglie!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Forse hai imparato la lezione. Magari i miei uomini potranno sospendere le incursioni.";
"T_GAME_QUEST_DESIRES_15_START" = "Dovresti lavorare l'oro e creare dei gioielli per me, tesoro!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Grazie, amore mio!";
"T_GAME_QUEST_DESIRES_16_START" = "Vorrei organizzare una festa.\nMi serviranno pane e succo d'uva.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Molto bene. Spero che non ci saranno incidenti con i banditi.";
"T_GAME_QUEST_DESIRES_17_START" = "Oh, che bella festicciola! Hai dimenticato di invitarci? ";
"T_GAME_QUEST_DESIRES_18_START" = "Quando è troppo, è troppo. Liberati di quei banditi una volta per tutte!\nDistruggi i loro accampamenti.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "Finalmente ci siamo liberati di quelle canaglie!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Distruggi tutti gli accampamenti dei banditi.";
"T_GAME_QUEST_DESIRES_19_START" = "In questo villaggio non c'è nemmeno un mercato?!\nCostruiscine uno, amore mio, così potremo acquistare merci dalla città.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Ora vivere qui è leggermente più sopportabile.";
"T_GAME_QUEST_DESIRES_20_START" = "Non c'è nient'altro oltre al pesce?\nCostruisci un forno e produci del pane.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Grazie mille! Il pesce cominciava già a nausearmi.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Mio signore, i nostri esploratori hanno scoperto che i banditi della regione si stanno ammassando intorno alla città. Temo un attacco su vasta scala.\nDobbiamo preparare le difese!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "I banditi stanno iniziando il loro attacco!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "La nuova ondata di banditi saccheggiatori ha raggiunto la città, milord!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Signor Governatore, i banditi hanno avviato il nuovo attacco!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Un’altra ondata di bambini si avvicina alla città, mio signore!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Una massiccia ondata di banditi è in arrivo, mio signore. Sembra che sia l’ultima. Dobbiamo difenderci e resistere!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Milord, la guardia cittadina segnala che l’attacco è terminato. I banditi rimasti vengono respinti dalla città e si stanno ritirando.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "La fauna è in aumento. Finalmente possiamo riprendere la caccia!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "I campi si stanno riprendendo, mio signore. La malattia delle colture è stata risolta.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "I campi si stanno riprendendo, mio signore. La siccità sembra essere terminata.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "La città è in fiamme, mio signore!\n\nDobbiamo estinguere l'incendio in fretta, prima che si diffonda.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Eccellente, mio signore.\n\nTutti gli incendi sono stati spenti e la città è al sicuro.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Non ci sono più incendi in città, mio signore!";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Assicurati che nessun edificio venga distrutto dalle fiamme.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Mio signore, la morte nera imperversa.\n\nDobbiamo curare i malati prima che l'intera città venga contagiata.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Ce l'abbiamo fatta, mio signore!\n\nLa peste è stata arginata e la città è al sicuro.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Medicina moderna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Rimedi della nonna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Il medico, con grande indignazione, ha deciso di distruggere l'infermeria! Ha detto: "Se scegliete i rimedi delle nonne, non avete più bisogno del mio laboratorio!".";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Saggia decisione, signore.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Grazie alla vostra scelta, la cura fornita dal medico è molto più efficace!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Signore, molti abitanti del villaggio non sanno più a chi rivolgersi quando hanno problemi di salute: dobbiamo indirizzarli verso la medicina moderna o verso i rimedi della nonna?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Nonne e medici";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Tornatene a letto.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Ti credo.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Oh no! No! Avremmo dovuto ascoltare quel sognatore! Alcune persone hanno iniziato a sviluppare una strana malattia.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Fortunatamente per noi, siamo riusciti a fermare la malattia. Sarà meglio dare retta alle premonizioni, la prossima volta...";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Questo cittadino ci ha salvato più di una volta dalle catastrofi. Costruiamo un'infermeria, sire, non si sa mai.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Oh sire! Abbiamo appena finito di costruire l'infermeria e alcuni dei nostri cittadini si sono ammalati. Meno male che avete deciso di ascoltare quel cittadino! Il danno è stato limitato! Ben fatto, sire.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Dobbiamo comunque guarirli, sire, altrimenti la malattia potrebbe diffondersi.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Splendido! Tutto il villaggio è di nuovo in perfetta salute e possiamo tornare ai nostri affari.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Mio signore, stanotte ho sognato che il nostro villaggio veniva infettato da una strana malattia. Tutti gli abitanti avevano il naso chiuso. \n\nPensate che il mio sogno possa essere una premonizione?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "È ora di sognare";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Non vedo l'ora!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Oh, preferivo il precedente.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "No, non ho tempo per questo.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Ho detto di no.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Fatela entrare.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Concesso.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "È fuori questione attirare più viaggiatori.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "In un impareggiabile slancio di generosità, ti metti al lavoro. Questa locanda nuoterà in un mare di fiori!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "E va bene.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = ""Udite, udite, brava gente! La locanda ha una nuova proprietaria! Venite alla locanda per la riapertura!"\n\nIl banditore è di buon umore oggi. Si dice che riceva mance ogni volta che un nuovo ospite arriva alla locanda.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Sire, abbiamo una visita da parte della nuova proprietaria della locanda, volete darle il benvenuto?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Sire, vi prego, la locanda è uno dei luoghi preferiti dai viaggiatori. Potremmo migliorare la reputazione della città, se miglioriamo questa struttura.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Buongiorno, sire, grazie per avermi accolta nel vostro castello.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "A cosa dobbiamo l'onore della vostra visita?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Beh, vedete, la locanda è in cattivo stato. Il precedente proprietario è stato davvero negligente. Non solo con i fornitori, ma anche con i clienti!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Oh, beh, se lo dite voi. Noi non passiamo molto tempo alla locanda.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Quindi sono qui per chiedere il vostro aiuto. Vorrei iniziare ad aggiungere qualche fiore intorno al mio locale per renderlo più accogliente. Voglio attirare più viaggiatori, e fare in modo che tornino una seconda volta.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Ora passiamo alla fase due: le bevande!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! Una seconda fase... Beh, visto che siamo qui, tanto vale continuare. Allora, qual è la prossima fase del vostro programma?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Abbiamo bisogno di metallo e di legno di alta qualità.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Non parlavate di bevande? Perché il legno ora?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Per fare dei barili decenti, ovviamente! Il vecchio proprietario non aveva nemmeno barili adatti a conservare le bevande. I fornitori probabilmente usano legno scadente. Quindi dobbiamo raccogliere abbastanza legno e sbarre di ferro per farceli da soli.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Fantastico! Sono bellissimi!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Se la pensate così, me la caverò da sola!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "D'ora in poi, il banditore favorirà la locanda nei suoi annunci.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "D'ora in poi, il banditore favorirà la taverna nei suoi annunci.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Vi ringrazio, Governatore! Tutto è bene quel che finisce bene.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Oh, grazie, sire! La locanda è molto più accogliente con i fiori.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Su, sire, prendetevi del tempo per pensarci. La locanda è un'importante fonte di reddito per il villaggio e può aiutarvi a realizzare alcuni dei vostri progetti.\n\nSiete sicuro di non volerlo fare?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Cosa dite, sire? Aiutate questa giovane donna con la sua locanda, e io? Non ricevo aiuti per la mia taverna!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Su, comportatevi bene quando vi rivolgete al Governatore.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Esigo di avere gli stessi privilegi di questa signora!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Volete anche voi dei fiori per il vostro locale?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Fiori? No! Voglio un banditore che sostenga anche la mia taverna!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Sire, cosa dobbiamo fare?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Pubblicizza la taverna.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Pubblicizza la locanda.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Di fiori e di nemici";
"T_GAME_QUEST_FEAST_TITLE" = "Organizza un festival per la città.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Proteggi il villaggio con le torri di guardia antincendio.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Mio signore, la città non è preparata per gli incendi di grossa entità! Alcune parti del villaggio non sono sorvegliate da torri di guardia antincendio. Dovreste cercare di posizionare le torri in modo che coprano il maggior numero possibile di edifici.";
"T_GAME_QUEST_FOOD_STARTED" = "Non dimentichiamo il cibo, signore! Non c'è festival senza una dispensa piena. Sbrighiamoci e facciamo rifornimento di risorse. Prima le avremo, prima il vostro progetto potrà avere successo.";
"T_GAME_QUEST_FOOD_SUCCESS" = "I partecipanti del festival non moriranno di fame! Oh, signore, ci stiamo avvicinando alla meta! Non vedo l'ora!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Un Governatore che non è capace di offrire un rinfresco a una regina?! Mi era stato detto di diffidare di voi, ma non ho voluto ascoltare!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Regina Frygith, dai, non arrabbiatevi per una cosa così futile, è solo un rinfresco, non esagerate.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Vedo che anche il vostro consigliere comincia a mancarmi di rispetto...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "La situazione è completamente fuori controllo, non sai più cosa fare e il tuo livello di stress non fa che aumentare. \n\nCome reagisci?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Cerca di calmare la regina.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Sentite, il Governatore prova dei sentimenti per voi e non sa come comportarsi. Vedete, è la prima volta che si innamora.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "La regina è emozionata e sembra che anche lei provi qualcosa per te. Potrebbe essere l'inizio di una vera storia d'amore? La veggente aveva ragione fin dall'inizio?\n\nSolo il tempo potrà dirlo. Nel frattempo, la regina ha deciso di voler ballare di nuovo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Sono passati diversi mesi dal famoso ballo. Tu e la regina Frygith avete un rapporto epistolare. A volte lei viene a trovarti quando il tempo lo permette.\n\nForse un giorno ti sceglierà come re del suo regno, ma per ora ha troppe cose da fare per consolidare la sua posizione di regina.\n\nE anche tu! Devi continuare a fare tutto ciò che è in tuo potere per mandare avanti la tua città senza problemi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Anche i cittadini sono felici per te e la regina. Hanno notato un aumento dei viaggiatori, che vengono soprattutto per assaggiare il succo d'uva e le bevande che la regina non ha bevuto durante la festa. Si dice che siano così buoni che hanno finito le riserve in meno di un'ora.\n\nLa produttività di questi due edifici è aumentata!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Le carte.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Pescherò una carta per voi, sire, che ci dirà un po' di più sulla persona che siete e su quale destino vi aspetta. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Dopo aver pescato la prima carta, la veggente mescola il mazzo.\n\nTi chiede di pescare tre carte: una per il passato, una per il presente e una per il futuro.\n\nUna volta che tutte le carte sono state scelte, le gira una per una.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Oh sire, queste tre carte mi dicono che avrete un periodo molto difficile. Dovreste diffidare delle persone della chiesa. Le carte mi dicono che in passato hanno già cercato di avvicinarvi, ma senza molto successo.\n\nSiete stato avvertito.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Ottime carte, sire! È tutto positivo. Incontrerete una donna, una grande donna che sconvolgerà il vostro cuore. L'amore è all'orizzonte! Siate pronto per quando busserà alla vostra porta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Osservi la giovane donna mescolare le carte e sussurrare loro il tuo nome per trasmettere la tua energia.\n\nPoi ti chiede di scegliere la pila di destra o quella di sinistra.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Spero che questa profezia non si avveri e che i religiosi siano felici nella nostra città.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Il mattino seguente, un monaco ti avvicina e ti informa che la chiesa ha bisogno di più risorse e che un ulteriore luogo di culto sarebbe molto apprezzato.\n\nLa profezia della veggente ti attraversa la mente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Sire, una nuova chiesa potrebbe aiutare la popolazione a risvegliarsi spiritualmente. Grazie mille.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Costruisci nuovo luogo di culto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Oh, è perfetto! Vedrete, faremo buon uso di questo nuovo luogo di culto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Sinistra.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Questa carta indica che c'è molta oscurità in voi, e vi porterà all'autodistruzione. Temo che questo influirà sulla produttività della vostra gente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Sento che siete confuso, e che il vostro consigliere vi sta spingendo ad andarvene. Ma restate ancora un po', non è finita. Pescando di nuovo, potremo ricevere risposte più specifiche.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Sire, questa veggente dice la verità, abbiamo una visita programmata per il prossimo fine settimana. Questo ci dà abbastanza tempo per organizzare una festa e vestirci bene!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Organizzate una festa";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Una festa non è una vera festa senza cibo e bevande. Cominciamo da questi, sire.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Perfetto! Ora abbiamo cibo e bevande a sufficienza per soddisfare i nostri ospiti.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Sire, dovreste fare tutto il possibile per questi festeggiamenti. Immaginate se incontraste lì la vostra anima gemella!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Il tuo consigliere potrebbe avere ragione, quindi decidi di vestirti con il tuo abito più bello. Tutta la città risplende e tu non esiti un secondo ad esibire la tua ricchezza.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Questo passerà alla storia! E sicuramente farà colpo sulla tua potenziale amata.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Destra.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Siete una persona premurosa e le carte mi dicono che questo influenzerà la produttività dei vostri abitanti!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "La sfera di cristallo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Ottima scelta, Governatore. Avvicinatevi e guardate nella sfera di cristallo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "La veggente avvicina le mani alla sfera di cristallo e, improvvisamente, appare del fumo blu.\n\n"Oh sire, una grande disgrazia sta per abbattersi su di voi. Vedo dei monaci. Forse saranno loro la causa", dice con una vena di tristezza.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "La veggente avvicina le mani alla sfera di cristallo e improvvisamente appare del fumo rosa.\n\n"Oh sire, troverete l'amore! Quello vero! Avrete una storia incredibile, ve lo assicuro!", ti dice con sguardo sicuro.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Vai a piangere in camera.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Preso dal panico, fuggi dalla sala da ballo e corri nella tua stanza per crollare a piangere nel tuo letto.\n\nTutto fa pensare che tu abbia il cuore spezzato. Solo il tempo potrà rimediare.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Da diversi mesi ti stai lentamente riprendendo dal tuo cuore spezzato.\n\nLa regina Frygith non si è mai informata sulle tue condizioni, non le importa affatto di te.\n\nD'altra parte, hai fatto la storia, e ora appari nei libri come il Governatore innamorato. Questo ti ha fatto guadagnare la simpatia del popolo, che ora lavora in modo più efficiente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Portale da bere.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "In compagnia del tuo consigliere, decidi di andare a casa della veggente, che forse può aiutarti a prevenire qualche disgrazia o darti qualche buona notizia.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "La veggente non è lontana dal castello. Entri nella piccola tenda. Sei circondato da una varietà di oggetti mistici. In un certo senso, ti tranquillizza.\n\n"Oh sire, accomodatevi. Sono felice che abbiate accettato il mio invito. Quale metodo preferite?"";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Portale del succo d'uva.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Puoi ammirare le sfilate dall'alto del tuo castello. E all'improvviso, in lontananza, vedi arrivare una processione. La tua attenzione ricade su una bella donna. Il tuo cuore viene travolto. \n\nÈ questo l'amore a prima vista?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Pazzo d'amore, decidi di andare a conoscere questa bella sconosciuta. Ti precipiti giù per le scale del tuo castello quattro gradini alla volta, rischiando di cadere. Il tuo consigliere, sempre al tuo fianco, non capisce cosa ti stia succedendo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Sire, questa è la regina Frygith. Non so cosa vi abbia spinto a raggiungerla così in fretta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Governatore, piacere di conoscervi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "La regina Frygith ti ha abbagliato con la sua presenza, e non sai più come comportarti. Fortunatamente per te, il tuo fidato consigliere ti aiuta e ti permette di riacquistare il senno.\n\nDecidi di invitare la regina Frygith al ballo di stasera. Speriamo che accetti questo primo appuntamento romantico.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Regina Frygith, il Governatore vi invita al ballo di stasera come sua accompagnatrice. Ci farebbe l'onore di accettare?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "Questo è assolutamente inappropriato! Sono promessa al duca di Cannes, non posso essere vista tra le braccia di un Governatore.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Sarei felice di accettare questo invito.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "Il momento del ballo è finalmente arrivato. Hai chiesto ai musicisti più prestigiosi di suonare per te durante la festa, e vuoi che tutto sia assolutamente perfetto per la tua amata.\n\nLa regina Frygith arriva finalmente, sfoggiando un abito elegantissimo. Ogni secondo che passi in sua presenza rende il tuo amore più forte.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "La musica sta prendendo piede, e anche la regina Frygith sembra come sotto un incantesimo. È ora di fare una pausa e lei ti chiede un piccolo rinfresco.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Non hai niente da offrirle.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Rifiuta l'invito.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Avete fatto bene, Governatore, chissà in quali problemi ci saremmo cacciati!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Con il cuore spezzato, decidi di non partecipare affatto al ballo. Sei addolorato da molto tempo, e questo si riflette sulla tua città. La produttività e la felicità degli abitanti stanno diminuendo. Speriamo che non duri.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Cominci a vedere di nuovo la luce alla fine del tunnel e la tua tristezza è ormai superata. Lentamente ricominci a uscire dalla tua stanza.\n\nLe persone sono contente del tuo recupero e questo influisce positivamente sulla loro produttività e sul loro morale.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Grazie Governatore, voi siete un uomo molto affascinante. Vorreste sfruttare questa serata per stringere accordi commerciali? Così avremmo l'opportunità di incontrarci di nuovo...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Vi lascio con la regina, Governatore.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Tu e la regina vi isolate nel giardino reale, come nelle favole. Il tempo si ferma per te e la regina Frygith. Raccogli tutto il tuo coraggio e condividi con lei i tuoi sentimenti. A quanto pare sono ricambiati!\n\nPurtroppo il sole sta sorgendo e la regina deve tornare a casa. Ha molto da fare nel suo paese e tu sai che non è così facile gestire un paese in solitaria.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Anche i cittadini sono contenti per te: ora sono meno inclini agli scioperi, il che è un'ottima notizia.\n\nIn fin dei conti, hai fatto bene a consultare quella veggente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Ci vado con piacere!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Oh sire, è terribile. Le persone costrette ad andare in chiesa sono completamente esasperate. Sono allo stremo delle forze. Preghiamo che lo superino! È stata una pessima decisione rendere il servizio obbligatorio!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Tutta questa storia della chiesa e della veggente è ormai alle spalle e la gente comincia a ritrovare la felicità.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Questa decisione è stata vantaggiosa per noi, sire! Avete fatto bene a rendere il servizio obbligatorio, ora i cittadini sono più felici e più produttivi.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "Il capo religioso del tuo villaggio è tornato a trovarti.\n\n"Sire, permettetemi di chiedervi una cosa. Potreste rendere il servizio obbligatorio? Vedete, con questi veggenti in giro, ho paura che la nostra gente sia facilmente influenzabile. Vorrei salvarli prima che fosse troppo tardi".";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Accetta la richiesta.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Ve lo prometto, sire, non ve ne pentirete!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Rifiuta la richiesta.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Capisco, sire. È stata quella veggente a farvi cambiare idea. Dovevate stare lontano da lei!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Poiché la religione ha poca importanza per voi, distruggeremo i luoghi di culto! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Sire, è terribile! I monaci arrabbiati stanno distruggendo gli edifici della città! Ed è stato impossibile catturarli, sono fuggiti! Così imparate a consultare le veggenti: ecco dove portano.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "In qualità di vostro consigliere, non vi lascerò mai più consultare una veggente! Ora torniamo agli affari, sire. La popolazione è in vena di uccidere.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Sire, alcuni viaggiatori sono arrivati in città questo pomeriggio. Tra loro, c'è una veggente. Vi manda un invito, desidera leggere il futuro per voi.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "La veggente";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Perché non smettete di mangiarli? ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Indaga.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Distruggi i capanni dei pescatori.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "È terribile! Gli abitanti hanno continuato a mangiare pesce in mancanza di qualcosa di meglio e la malattia si è diffusa!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "La malattia è sotto controllo, signore. L'abbiamo scampata bella.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Questi controlli qualità costano un occhio della testa, ma è sempre meglio che avere a che fare con un'epidemia!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Tutti i capanni dei pescatori sono stati controllati e il pesce è di nuovo commestibile! Avete fatto bene a investire in questo senso: abbiamo evitato problemi più gravi.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "La distruzione di questi capanni dei pescatori ha fermato la possibile contaminazione del pesce, ma è un peccato che siano stati distrutti edifici così belli.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Governatore, non per essere pignoli, ma bisogna ammettere che i vostri pesci... non sono più quelli di una volta. Non so se sia a causa del fiume o di qualcos'altro, ma sono assolutamente disgustosi! Qualcuno si sentirà male, se non fate qualcosa.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Pesce fresco!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Ottieni un alto grado di soddisfazione nella comunità.";
"T_GAME_QUEST_GETREWARD" = "Ricompensa!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Signore, non so come dirvelo... Fate un respiro profondo. Siete pronto? Beh... diversi abitanti del villaggio dicono di aver visto un coniglio gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Sì, e allora?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "UN CONIGLIO GIGANTE?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "E allora?! Ma signore! È assolutamente spaventoso! Immaginate se saltasse intorno al castello e sradicasse le nostre case!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Per quelle quattro case che abbiamo...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Agiamo, SUBITO!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Ah, ecco una reazione più logica da parte vostra, signore.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Costruiamo un capanno di caccia.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Invia una lettera al palazzo affinché mandino un emissario.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Nonostante la nostra organizzazione per la caccia, non siamo riusciti a mettere le mani sul coniglio gigante. Ora però abbiamo un sacco di scorte...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Indizi?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Ho fatto il mio dovere, ora schiaccio un pisolino.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "L'emissario è arrivato, signore.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Chiedo l'aiuto dell'esercito reale.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Accompagna l'emissario a vedere le prove.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Cosa sento? Un coniglio gigante che si aggira per la vostra terra? Non siete stato al sole un po' troppo a lungo...?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Ehm, capisco. Tracce di conigli giganti... È una storia che si racconta ai bambini sprovveduti: "Il coniglio gigante verrà mentre dormi e ti tirerà le orecchie". ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "E poi che altro? Ho di meglio da fare.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Vai dalla strega.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Potremmo andare dalla strega e chiederle un consiglio, forse lei sa qualcosa su questo famigerato coniglio gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Vi stavo aspettando. I corvi avevano previsto il vostro arrivo. Hanno fatto così tanto chiasso... Ma sempre meno dei salti di quel coniglio.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Pregare.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Usare la magia.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Non fare nulla.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Allora è vero?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Ci potete scommettere! Ci avete messo molto per arrivare qui. Fortunatamente, c'è ancora tempo. Ora avete diverse opzioni da considerare.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Vedo che non vi preoccupate dei vostri abitanti in nessun caso, signore... Questo vi si ritorcerà contro, alla fine.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Va bene, costruiamo due capanni di caccia e raccogliamo un po' di carne. Chissà, con un po' di fortuna forse troveremo la tana del coniglio gigante.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Questo è il mio campo. Vi preparerò una piccola pozione, ma dovete portarmi gli ingredienti. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Bene, mi date questi ingredienti?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Grazie mille, signore. Accidenti! Ora ho dimenticato l'altra metà degli ingredienti.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Oh, non abbiamo tutto il giorno, signore. Ho una pozione da preparare, perché non mi date gli ingredienti adesso?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Grazie mille, signore. Prendete la pozione, versatene un po' nel pozzo del villaggio e aspettate. Il coniglio gigante se ne andrà da solo dopo averla annusata.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Signore... Dobbiamo costruire dei bagni pubblici e rifornirli di oli essenziali in abbondanza per sbarazzarci dell'odore che emanano i cittadini... È assolutamente orribile.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Fantastico! La città può respirare di nuovo!\nIl coniglio se n'è andato senza lasciare traccia, come se l'avessimo solo immaginato. Per il momento, mio signore, torniamo ai nostri affari.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Dopotutto, il coniglio se n'è andato da solo. Con uno degli ultimi salti, ha dissotterrato un forziere nascosto dai banditi molto tempo fa. Il forziere conteneva 2000 monete d'oro e il re ci trova degni di ricevere prestigio!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Beh... C'è voluto un coniglio gigante perché prendeste finalmente in considerazione la costruzione di una chiesa!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Affrettiamoci a costruire questa chiesa e riuniamo gli abitanti affinché preghino.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Non resta che aspettare che il divino faccia il suo lavoro.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Il coniglio se n'è andato senza lasciare traccia, come se l'avessimo solo immaginato. Per il momento, mio signore, torniamo ai nostri affari.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Ahi, io avrei scelto la pozione, ma siete voi il capo! Buona fortuna con le disgrazie che verranno, signore.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Il coniglio gigante";
"T_GAME_QUEST_INN_STARTED" = "Signore, ci sarà bisogno di altri alloggi. Perché non costruire una locanda? In questo modo saremo in grado di provvedere ai bisogni dei visitatori del festival.";
"T_GAME_QUEST_INN_SUCCESS" = "Bene, questa è fatta. Ora prendiamoci del tempo per pensare al resto dei preparativi.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Troppo pericoloso.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Perché no?";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Il burlone.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "La corte del re lo adora! È proprio quello che ci voleva! Il prestigio è nostro! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "La cittadina degli indovinelli.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Purtroppo, gli indovinelli... erano troppo complicati per loro. La corte del re avrebbe preferito qualcosa di meno intellettuale. Non guadagneremo prestigio questa volta.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "L'acrobata.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "La corte del re è stupita da questo acrobata di talento! Il re ci manderà prestigio, come ricompensa.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Avete ragione, chissà cosa ci succederebbe se il re non fosse soddisfatto dei nostri candidati.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Signore, abbiamo ricevuto un messaggio dalla capitale. Il re è deluso dal fatto che nessun membro della nostra città sia andato a offrire i suoi servigi. Fortunatamente, però, non ci denuncerà per questa banalità. Il re è molto clemente!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Ho trovato tre potenziali candidati. Quale dovremmo mandare?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Mio signore, il re desidera avere un giullare per essere intrattenuto. Dovremmo mandare alcuni potenziali candidati che potrebbero diventare il nuovo buffone di corte?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Il giullare di corte";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Aggiusta il tetto.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Dobbiamo risolvere il problema il prima possibile!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Non ora.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Abbiamo altre priorità al momento; la festa della lavanda sta per iniziare e i preparativi non sono terminati.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "A proposito, dovremmo finire di preparare tutto.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Così va meglio! Questo promette di essere un evento redditizio!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Sire, ho sentito che i mercanti di lavanda tengono in grande considerazione la nostra cattedrale. Sono restii a venire alla nostra festa!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "La festa della lavanda si è svolta senza problemi... Tuttavia, abbiamo avuto meno visitatori del solito! Questo evento non ci ha portato alcun prestigio.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Affare fatto!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Quindi sbrighiamoci a produrre la merce per la regina.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Ora non ci resta che fare lo scambio.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "È un piacere fare affari con voi.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Sire! Ho brutte notizie! Il simbolo mondiale della nostra cultura ha preso fuoco durante notte! La cattedrale maggiore non ha più il tetto!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Gli esperti dicono che non abbiamo più abbastanza legno nobile sulla nostra terra per ripararlo, ma si dà il caso che la regina Frygith abbia le risorse necessarie. Dovremmo chiederle aiuto?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Chiedi aiuto.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Ti affretti a mandare un messaggero alla regina. \n\n"Aiuto, regina Frygith! Posso prendere in prestito questo legno nobile dalla vostra terra? La mia cattedrale sta cadendo a pezzi."";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Caro Governatore, mi scrivete proprio al momento giusto, visto che devo fare scorta di succo. Siete interessato a uno scambio amichevole? Giare di succo in cambio del legno che vi serve.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Sire, questa non è un'offerta a nostro favore...";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Ponderi i pro e i contro di questo accordo. La regina potrebbe risolvere il tuo problema... A meno che non ci sia un altro modo!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Pensaci.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Questa richiesta potrebbe danneggiare la nostra reputazione, procederemo diversamente. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Il tuo consigliere potrebbe avere ragione. Chiedere aiuto alla regina Frygith ti spingerebbe a dipendere dalla sua benevolenza. Se mai ci sarà un problema, rischierai di perdere molto.\n\nPerché non usare le pietre? Ne hai molte nelle miniere.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "È stata una buona decisione, sire! Siamo liberi e indipendenti.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "La festa della lavanda è un successo. Le storie recenti sul restauro della cattedrale hanno suscitato molto entusiasmo e noi ne abbiamo beneficiato!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Non ho mai amato la lavanda.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Qual è il problema?! La stiamo aggiustando.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Scandaloso.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Sire, questo suona come un ricatto! Usiamo invece la pietra, così non avremo a che fare con questa regina!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Va bene, non lo dimenticherò, caro.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Il re del legno";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Me ne occuperò io.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Se non sono felici, che non vengano più.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "È vero che i mercanti trarrebbero beneficio dall'avere un luogo dedicato a loro, oltre al mercato. Una gilda dei mercanti sembrerebbe l'edificio perfetto, sire.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Meraviglioso, sire! Grazie per aver accettato, ve ne saremo grati per sempre!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Un Governatore moderno come voi avrebbe dovuto accettare la richiesta dei mercanti...";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Sire, sono qui in veste di rappresentante dei mercanti. Per mostrare il nostro disappunto, non verremo nella vostra città per un po'! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Sire, la federazione dei mercanti esige che voi costruiate edifici che corrispondano alle loro funzioni.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Mancanza di spazio";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Ti sei appena svegliato, ma il tuo consigliere ha notizie terribili per te: la città è invasa dai topi! Sono meno pericolosi dei ratti, certo, ma bisogna fare qualcosa!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Sire, l'Accademia dei gatti cacciatori di topi è stata istituita ma... dobbiamo ancora occuparci del loro benessere e di nutrirli. Dovremmo fornire pesce a sufficienza all'Accademia.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Ora abbiamo abbastanza pesci per l'addestramento. Alcune reclute hanno già catturato molti topi, sire.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Sire, dovremmo premiare i gatti migliori con l'erba gatta, per ridurre il loro stress.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "L'efficacia dei cacciatori di topi è aumentata notevolmente, sire. Gli insegnanti stanno facendo un buon lavoro nell'addestrare i gatti. È rimasto solo un numero ridotto di topi.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "I topi non sono più una seccatura, sire. Complimenti per le vostre scelte, che hanno portato a questo risultato.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Escogita un piano.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Decidi comunque di fare colazione. Mentre mangi il tuo toast, vedi un topo in un angolo della stanza! Sono addirittura nel castello! E all'improvviso, vedi Chouquette, il tuo fedele gatto, fare un balzo e mangiare il topo in men che non si dica. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Questo ti fa venire un'idea: incarichi il tuo consigliere di catturare il maggior numero possibile di gatti e di addestrarli alla caccia ai topi. Vuoi che anche i gatti domestici siano addestrati a sbarazzarsi di quei mostriciattoli.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Torna a dormire.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Quando ti svegli, ci sono così tanti topi ovunque che la gente quasi non riesce a camminare per strada. Tutti i tuoi abitanti sono rallentati!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "I topi alla fine se ne sono andati da soli dopo molto tempo. Ignorare le proprie responsabilità dormendo non è sempre la miglior soluzione.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Gatto e topo";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "Nella parte destra puoi vedere le influenze attive.\nAlcune sono solo temporanee e possono cambiare durante uno scenario.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Mio signore!\nCon il dovuto rispetto, forse non hai notato che gli abitanti del villaggio sono molto infelici. Non possiamo continuare così.\nE poi, le merci che produciamo non vengono lavorate adeguatamente.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Ora sai quali influenze ci sono in città. Come avrai forse notato, nell'area ci sono dei banditi e la felicità generale dei cittadini è calata per causa loro.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Vai al menu di pausa per vedere le influenze attuali su questa mappa.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Saresti così gentile da andare alla segheria?\nDobbiamo interrompere la produzione: abbiamo troppo poco legname e troppe assi.";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Per ottenere maggiori informazioni su un edificio, non devi fare altro che visitarlo.\n\nIl menu contestuale mostra dati utili in merito alla struttura, ai lavoratori e alle catene produttive. Mentre visualizzi questo menu, il gioco rimane in pausa.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Servono più taglialegna alla segheria affinché possa produrre assi in modo più efficiente. Metti in pausa la segheria finché non avrai costruito altri capanni del taglialegna e accumulato ulteriori risorse.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Le risorse non dovrebbero bloccare il magazzino, mio signore.\n\nQuando hai bisogno di spazio in magazzino, puoi usare la funzionalità Distruggi risorse nel menu delle statistiche.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Vai al menu del magazzino.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Le risorse non dovrebbero bloccare il magazzino, mio signore. \nQuando avete bisogno di spazio in magazzino, potete usare la funzionalità Distruggi risorse nella scheda Magazzino del menu di gioco.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Distruggi assi finché la rimanenza scende sotto i 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Distruggi alcune assi per fare spazio nel magazzino.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Governatore, non prendi sul serio le mie minacce.\n\nDa ora in poi si fa sul serio!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Hai costruito una gran bella città... Peccato che si trovi nel mio territorio!\nPortami gioielli e abiti! E fai in fretta, altrimenti la tua città farà una brutta fine...";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "A volte basta una piccola minaccia per ottenere grandi risultati. Non avrei mai pensato che mi avresti davvero consegnato quelle merci.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Paga un tributo ai banditi.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "I miei ragazzi si annoiano. Li manderò a fare una passeggiata...\n\nNella tua città!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Come vedi, io mi prendo sempre quello che voglio.";
"T_GAME_QUEST_MIL_TUT_09_START" = "Buongiorno, mio signore.\n\nSono qui su ordine del Re per insegnarti l'arte della guerra.\n\nPresto i problemi con i banditi saranno solo un brutto ricordo.";
"T_GAME_QUEST_MIL_TUT_10_START" = "\nLa caserma costituisce la spina dorsale delle operazioni militari e rende possibile la costruzione e il funzionamento delle torri di guardia. I soldati combattono bene solo se sono forniti di un equipaggiamento adeguato.\nColloca le torri in modo tale da coprire la maggior superficie cittadina possibile.\n\nCostruisci una caserma e una torre di guardia.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Un cavaliere ti ha aiutato...\nGià tremo tutto dalla paura.\n\nVediamo come se la cavano i tuoi soldati contro i miei uomini...\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "I banditi vogliono dare fuoco ai nostri edifici. Dove sono i pompieri quando servono?\n\nSe vuoi sapere dove si trova un cittadino, seleziona l'opzione "Trova cittadino" nel menu contestuale degli edifici.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Qui puoi vedere che cosa stanno facendo i lavoratori.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Produci birra e salsicce";
"T_GAME_QUEST_MIL_TUT_14_START" = "I nostri soldati hanno bisogno di birra per il morale, mio signore.\n\nPer produrla, devi ordinare la costruzione di un monastero-birreria e di un essiccatoio.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "I nostri soldati hanno bisogno di birra, mio signore.\nPer produrla, devi ordinare la costruzione di un monastero e seminare alcuni campi di luppolo.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "La birreria del monastero necessita di molte risorse da altri edifici.\nDall’essiccatoio ottiene il luppolo essiccato. Una fattoria e un pozzo forniscono grano e acqua.\n\nPoi i monaci del monastero possono iniziare la produzione della birra, mio signore.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "I monaci del monastero possono mietere luppolo dai campi oppure produrre birra.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Costruisci un monastero e un essiccatoio.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Costruisci un monastero e semina dei campi di luppolo.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Per produrre salsicce, ti servono una porcilaia e un macellaio, mio signore.\n\nI nostri soldati adorano il gusto speziato delle salsicce. Nell'orto, il contadino può raccogliere le erbe che ci servono.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Il macellaio produce carne normale, oltre alle salsicce tanto amate dai nostri soldati.\nSi tratta di una buona alternativa alla caccia di selvaggina.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Costruisci una porcilaia e un macellaio.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Le tue difese sono debolucce!\nAlla prossima... e grazie per le risorse.\n";
"T_GAME_QUEST_MIL_TUT_16_START" = "Birra e salsicce!\n\nI miei uomini adorano queste leccornie. Credo che dovresti condividerle con me.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Stavolta hai avuto fortuna, governatore, ma la prossima arriveremo in massa e non avrai scampo.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Difendi la tua città";
"T_GAME_QUEST_MIL_TUT_17_START" = "Bisogna apportare ulteriori migliorie in città. Le difese non sono sufficienti: dobbiamo proteggere una superficie maggiore con le torri di guardia.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Ora gran parte della superficie del villaggio è protetta dai nostri soldati. I banditi non avranno vita facile, mio signore.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Proteggi almeno il 50% del villaggio con le torri di guardia";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Se vuoi ulteriori informazioni sulle tue forze militari, consulta la schermata delle statistiche nella scheda Militari.";
"T_GAME_QUEST_MIL_TUT_19_START" = "I nostri soldati hanno bisogno di armi e armature!\nLe armi aumentano la potenza, mentre le armature incrementano la difesa dei soldati.\n\nPer cui dobbiamo costruire un'armeria in città. Per produrre armature, sarà necessaria anche una conceria che realizzi il cuoio.\nLe pelli di animali saranno fornite da un cacciatore o da un macellaio.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Costruisci una conceria e un'armeria.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Signore,\nè tempo di aumentare le dimensioni dell'esercito per poter poi inviare uno squadrone a distruggere l'accampamento dei banditi.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Amplia il tuo esercito";
"T_GAME_QUEST_MIL_TUT_21_START" = "È il grande momento, governatore!\n\nOra possiamo attaccare il capo dei banditi. Il loro accampamento è nascosto nella foresta.\nSeleziona l'accampamento dei banditi e ordina a uno squadrone di soldati di attaccarlo.\n\n\nBuona caccia!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Distruggi l'accampamento dei banditi";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Sono felice di incontrarti, mio signore.\nSono stato derubato dai banditi per la terza volta solo nell'ultima settimana. Dobbiamo fare qualcosa!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Una grande vittoria, mio signore.\nAbbiamo dato una bella lezione a quei banditi! La regione è di nuovo al sicuro e il Re ne sarà felice. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Completa l'addestramento di base e sconfiggi i banditi.";
"T_GAME_QUEST_NEW" = "Nuova missione!";
"T_GAME_QUEST_NEW2" = "Nuova missione:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Nessuno ha tempo per questo.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Hai ragione.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Molto bene, sire, allora non faremo nulla per questo pane orribile. Sento già le lamentele per il cibo immangiabile. Ma, in ogni caso... ai vostri ordini, sire.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Oh signore, il pane ora è delizioso! Anche i prezzi di vendita stanno aumentando.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = ""Il grano è la tua preoccupazione, e devi affrontarla alla radice. Di' al mugnaio di usare acqua più pulita. E che il lievito sia di buona qualità."\n\nIl tuo consigliere trasmette la tua saggezza al fornaio e ti promette che il pane sarà migliore.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Signore, dobbiamo fare qualcosa. Il pane non è più quello di una volta. Molte persone sono venute a lamentarsi della sua qualità. Dovremmo cambiarne la ricetta.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Una nuova ricetta";
"T_GAME_QUEST_NOQUEST" = "Nessuna missione disponibile.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Sbrighiamoci a produrre scudi e armi. Se queste persone sono pericolose, è meglio essere pronti.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Governatore, abbiamo terminato i preparativi per la difesa della città.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "I tuoi soldati segnalano movimenti di truppe a nord, dove si trova il più grande deserto del regno.\n\nTuttavia, sai che nessuno è così pazzo da tentare un attacco da quel lato dei tuoi confini. Decidi di ignorare questa minaccia. Quel che succede, succede!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Qualche giorno dopo, i tuoi soldati segnalano un gruppo di persone proveniente proprio dal deserto settentrionale. Saranno in città tra qualche ora.\n\nPotrebbero essere solo dei viaggiatori, ma chissà, magari sono pericolosi banditi venuti a invadere il tuo villaggio!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Prepara le difese.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Prepara un benvenuto.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Il deserto settentrionale";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Un gruppo di dieci persone si sta avvicinando alla tua città. I tuoi soldati restano di guardia, in attesa dei tuoi ordini.\n\nLi lasci avvicinare. Il capogruppo cammina da solo verso le porte del villaggio. "Buongiorno, mio buon signore, abbiamo appena attraversato il deserto del nord. Potete offrirci ospitalità per una notte?"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Allora venite nella nostra bella città, alloggerete alla locanda, abbiamo abbastanza spazio lì.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Mentre il tuo consigliere ti accompagna a casa, sei ancora all'erta. Perché hanno rischiato di attraversare il deserto quando avrebbero potuto navigare lungo il fiume? Perché scegliere una strada pericolosa se non per nascondersi?\n\nForse le tue spie potrebbero scoprire di più sul loro conto. O potresti anche andare a letto.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Vai a letto.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Manda una spia.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "La tua spia è rimasta sveglia tutta la notte ed è riuscita ad origliare alcune conversazioni alla locanda: i viaggiatori sono in fuga. Si dice che abbiano commesso alcuni crimini nel loro paese, dall'altra parte del deserto. L'esercito è stato mandato a cercarli e loro si stanno preparando per continuare la loro fuga dalla giustizia.\n\nQual è la soluzione migliore?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Rinchiudili.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Abbiamo appena ricevuto un messaggio dal re. Alcuni pericolosi criminali sono scappati dalla prigione del paese vicino. Sono una decina e hanno rubato un oggetto prezioso. Pensi che siano stati i viaggiatori che erano qui qualche giorno fa?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Invia un messaggio al re.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Non informare nessuno.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Invierò un messaggio al re per fargli sapere che sono passati per il nostro villaggio, forse riusciranno a trovarli.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Sire! L'esercito reale è riuscito a mettere le mani su questi pericolosi individui. Hanno recuperato il tesoro rubato.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Grazie per il vostro aiuto, Governatore. Queste persone avevano rubato uno dei miei preziosi gioielli e avevano intenzione di venderlo al mercato nero. Avete fatto bene a informarmi della loro presenza nella vostra città.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Molto bene, sire. Se qualcuno ce lo chiede, diremo che non lo sappiamo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Era da un po' che non succedeva nulla di spettacolare in città, ma oggi hai la sensazione che cambierà qualcosa.\n\nE avevi ragione! Il tuo consigliere viene a portarti una lettera dei viaggiatori ricercati dall'esercito reale. Il messaggio recita: \n\n"Grazie per non averci denunciato, Governatore. Vedete, siamo stati vittime di un complotto e tutta la nostra famiglia era in grande pericolo. Venendo nel vostro villaggio in gran segreto, abbiamo avuto il tempo di trovare le prove della nostra innocenza. Senza di voi, sarebbe stato impossibile. Pertanto, vi preghiamo di accettare questo premio in segno di gratitudine. Siete un buon Governatore".";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Ho liberato i viaggiatori, sire, come ci avete ordinato. Spero che non ci si ritorca contro.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "I viaggiatori ti ringraziano per la tua gentilezza e ti promettono che, una volta provata la loro innocenza, ti daranno una ricompensa in segno di gratitudine.\n\nTu speri sinceramente di aver preso la decisione giusta e che questi viaggiatori non ti abbiano ingannato dicendoti bugie.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Sono passati ormai diversi mesi dall'ultima volta in cui hai avuto a che fare con questi viaggiatori. A volte ci ripensi. Non hai avuto problemi con il re, ma non hai nemmeno ottenuto la tua cosiddetta ricompensa.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Poi improvvisamente, una mattina soleggiata, il tuo consigliere viene a portarti un pacco con una lettera. La lettera contiene un messaggio dei misteriosi viaggiatori che ti esprimono la loro gratitudine. Nel pacco trovi la ricompensa promessa: prestigio e oro.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Sei felice di aver avuto ragione e di non essere stato ingannato.\n\nIl tuo consigliere ti riferisce che sei diventato un eroe per questi viaggiatori e che ti stanno acclamando. Che bello essere Governatore!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Sire, i viaggiatori hanno lasciato la locanda al mattino presto, sembravano avere fretta.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "I viaggiatori stanno aspettando la tua risposta. Alcuni sembrano aggressivi, altri impauriti.\n\n"Non posso offrirvi ospitalità, viaggiatori. Non abbiamo abbastanza spazio per voi, stasera."\n\n"MENZOGNE!" grida improvvisamente uno dei viaggiatori, precipitandosi verso di te con la sua spada.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Proteggete il Governatore!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Sbrigatevi, sire! Sbrigatevi! Togliamoci dal loro campo visivo!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Sei riuscito a rifugiarti in un nascondiglio con il tuo consigliere, che sembra notevolmente in preda al panico: "Sire, cosa facciamo? Questi viaggiatori malvagi stanno radendo al suolo il nostro villaggio e noi non possiamo fare nulla! Avremmo dovuto preparare le difese invece dei panini!"\n\nPurtroppo, l'unica cosa da fare è aspettare.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Di mattina presto, ti avventuri fuori dal nascondiglio. Il villaggio non è stato danneggiato. Sembra che questi viaggiatori abbiano semplicemente messo fuori combattimento le guardie e preso delle provviste per il resto del loro viaggio.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Per fortuna avevamo pianificato tutto, sire. Con le armi e gli scudi che abbiamo prodotto, saremo sicuramente in grado di respingerli.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Sire, siamo riusciti a catturare tutti i viaggiatori e li abbiamo rinchiusi nella prigione. È il momento di prendere una decisione.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Questi viaggiatori stanno diventando sempre più strani. Ora che sono rinchiusi, ti senti un po' più al sicuro. Tuttavia, qualcosa ti preoccupa.\n\nChe fare?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Interrogali.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Informa il re.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Va bene sire, farò loro qualche domanda per chiarire questa storia.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Il tuo consigliere è tornato e ti fornisce alcune informazioni sui viaggiatori. \n\nSono fuggiti dal loro paese perché accusati ingiustamente. La prova della loro innocenza si trova più a sud, in una delle città circostanti.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Liberali.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Informerò quindi il re, affinché l'esercito reale possa venire a prendere questi pericolosi criminali!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "L'esercito reale sta finalmente arrivando. Consegni i viaggiatori. Il re ti manda una ricompensa per aver fornito le informazioni necessarie a catturare questi pericolosi individui.\n\nIl tuo villaggio si sta lentamente riprendendo, mentre tu ricominci tranquillamente le tue attività di Governatore.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "La tua spia ha commesso un errore ed è stata individuata dai viaggiatori, che la tengono in ostaggio e chiedono un riscatto se vuoi recuperarla viva.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Perderemo un sacco di soldi, ma almeno la nostra spia sarà al sicuro.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Grazie, sire, per aver pagato il riscatto che mi ha liberato! Temevo per la mia vita. Che lavoro pericoloso essere una spia.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Ottima idea. Dovremmo preparare del cibo per quando arriveranno alla nostra porta. Pane e pesce andranno bene.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Perfetto, ora non ci resta che aspettarli.";
"T_GAME_QUEST_PLACE_STARTED" = "Ora è il momento di costruire il luogo adatto per un evento di questa portata!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Oh la la, è assolutamente incredibile! E pensare che niente di tutto questo sarebbe stato possibile se le guardie non fossero state zelanti. Avete avuto un'idea meravigliosa ad approfittare di questa opportunità! Il festival promette di essere un successo.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Pianta più fiori.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Non è necessario.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Che bello! Oh, i fiori sono davvero una gran cosa, il loro aroma mi manda in estasi.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Siete una persona orribile. La nostra città sarebbe stata molto più bella con i fiori!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "La primavera è tornata, mio signore. Il villaggio potrebbe trarre beneficio da qualche fiore in più.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Petali graziosi";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "La segheria è bruciata, mio signore. Volete ordinarne la ricostruzione? Ne abbiamo bisogno per produrre assi!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Ricostruisci la segheria.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Non dare niente a nessuno.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Ridistribuisci i guadagni tra i cittadini.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Investi questo denaro nelle miniere.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Signore, abbiamo molti soldi nelle casse e una ridistribuzione di una parte di questi guadagni sarebbe vantaggiosa per la città.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Gli abitanti del villaggio hanno saputo della vostra decisione e non sono contenti. Cercate di mostrare un po' più di riguardo nei confronti della vostra gente, signore.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "La produttività dei cittadini non è più influenzata dalla decisione sulla redistribuzione dei guadagni. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Come avete reso felici i cittadini! Sono entusiasti!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Eccellente iniziativa, signore. Cominciamo a costruire miniere e a estrarre risorse.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Investire il denaro che avevamo nella costruzione di nuove miniere è probabilmente la migliore decisione che abbiamo mai preso: con queste risorse potremo svilupparci più facilmente.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Siete molto generoso, sire. Questo denaro permetterà loro di avere una vita quotidiana migliore.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Ridistribuzione dei guadagni";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Siamo stati fortunati, sire. I raccolti non sono stati colpiti. I cinghiali se ne sono andati e non dobbiamo più preoccuparci di loro.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "I cinghiali hanno distrutto i nostri raccolti, sire! Si sono diretti verso la fattoria. È un massacro.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "I cittadini sono devastati da questa perdita e a farne le spese sono la loro felicità e la loro produttività.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Sire, i nostri raccolti stanno cominciando a riprendersi dai danni inflitti dai cinghiali qualche tempo fa. Le colture stanno ricrescendo e la gente ha cominciato a dimenticare quello che è successo.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "La popolazione viene trascurata, come conseguenza della vostra decisione. Speriamo che i raccolti non vengano danneggiati da questi cinghiali.";
"T_GAME_QUEST_REWARD" = "Ricompensa:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Ti do il benvenuto, vassallo!\n\nGuarda che litorale! Mi aspetto che la tua città sia degna di questo meraviglioso panorama!\nPrenditi cura dei tuoi cittadini e non dimenticare di pagare i tributi al Re, così potrai continuare a servirmi!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Prestito dal tesoro del Re";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Governatore, \nse sei a corto di fondi, la corona può offrirti un piccolo prestito per rimetterti in piedi.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Ti do il benvenuto nel nostro umile villaggio, Governatore!\nLa regione è divisa da un crinale roccioso. Nel lato sudoccidentale del crinale si trovano depositi di minerali, milord.\n\nNon vedo l'ora di lavorare insieme a te.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Benvenuto, Governatore!\n\nSono la Regina Frigyth, governante di questo Regno. Ho chiesto il tuo aiuto per portare grande prosperità a questo villaggio. La terra è ricca di risorse, quindi non sarà difficile. Non deludermi.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Milord, osserva l'infinita vastità di questa regione. Pianure in tutte le direzioni! Riusciremo a costruire una grande città nel prossimo futuro, non credi?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Salute, Governatore.\nSulle rive di questo maestoso fiume abbiamo l’opportunità di prosperare. La pesca è ricca e le miniere sono piene di minerali. Dobbiamo fondare qui una città fiorente in nome del re.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Meraviglioso, Governatore.\nQuesto canyon ospita una delle strade più importanti che attraversano le montagne. La città è in una posizione ideale per offrire un piacevole soggiorno ai mercanti di passaggio. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Milord, alla base di queste cascate ci son zone pescose in abbondanza. Inoltre, ampi depositi di minerale rendono questa regione ideale per stabilirvi la nostra città.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Benvenuto nella fortezza ghiacciata, milord.\nNon è facile per i cittadini inerpicarsi fino al castello, ma la vista sulle pianure vale lo sforzo. Da quassù i tuoi possedimenti sembrano infiniti.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Buongiorno, mio signore.\n\nGuarda le morbide colline dei tuoi possedimenti. Non è una vista magnifica? Questo è un posto bellissimo ove fondare una città, mio signore.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Ti auguro una buona giornata, milord.\n\nTi do il benvenuto nella nostra piccola città. Si dice che la fossa sia stata creata da una stella cadente. Speriamo che ci abbia portato fortuna. Il Re ha già scritto che avrà presto dei compiti per noi.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Tributo al re.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festival per i paesani.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Donazione ai poveri.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Festa della birra in città.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Vendi maiali al mercato.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Affari al mercato degli animali.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Vendi animali al mercato.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Razioni per l'esercito.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Equipaggiamento per i soldati del Re.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Respingi gli attacchi dei banditi.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Distruggi gli accampamenti dei banditi.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Benvenuto, Siniscalco! Guarda questa costa! Mi aspetto che tu ti renda degno di questa meravigliosa vista!\nPrenditi cura dei tuoi paesani e non dimenticare di pagare il tuo tributo al re, così da poter continuare a servirmi!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Che posto meraviglioso per pescare. Non trovate, signor Siniscalco? Qui di sicuro non manca il cibo!\nCi piacerebbe tanto che organizzaste un festival ogni tanto, se dopo aver pagato il tributo al re vi rimane qualche tallero!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Oh tesoro, grazie per esserti stabilito qui! Questo lago è bellissimo!\nI paesani saranno felici qui, se ti prenderai cura di loro!\nOh, e non dimenticare di di foraggiare il re, così potremo restare qui per sempre!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Mio signore, trasferirsi in questa valle è stata una saggia decisione!\nI paesani saranno felici se aiuterete i poveri e i bisognosi!\nMa, malgrado la vostra generosità, vi suggerisco di non dimenticare i vostri doveri verso il re!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Benvenuto! I miei uomini sono orgogliosi di servirvi nella costruzione del vostro centro di potere in questo importante punto di snodo delle nostre terre!\nQuesto sarà un anno di festeggiamenti!\nLunga vita al re, e anche a voi!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Mio caro Siniscalco, ho già sentito parlare molto di te!\nPer questo ti ho scelto per far fiorire questa città alle pendici del mio castello!\nComincia immediatamente! Ti auguro buon lavoro!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Mio signore, abbiamo l'incarico di costruire una città vicino a questo fiume asciutto. Il re ci ricompenserà profumatamente se riusciamo nell'intento.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Mio signore, l'altopiano sul quale sorge il tuo castello è anche un posto perfetto per costruire una piccola città. Il re ti ha anche dato una serie di incarichi da svolgere.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "È stato scoperto un arcipelago appena al largo della costa. Ti ordino di colonizzare queste isole in mio nome!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Mio signore, guarda che bellissima regione boscosa. Costruire una città qui sarà un duro lavoro, ma almeno avremo selvaggina e legname in abbondanza. Ciò dovrebbe rendere più semplice svolgere i compiti che il re ci ha assegnato.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Mio signore, sarà difficile pagare i nostri tributi al re, a causa del duro inverno. Mettiamoci subito al lavoro.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Che valle meravigliosa. Ci sono abbastanza risorse per pagare i tributi al Re. Ma fai attenzione, il poco spazio a disposizione per gli edifici esige una buona pianificazione.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Quest'isola è bellissima! Sono così felice che siamo venuti qui. Dobbiamo immediatamente iniziare a progettare il nostro villaggio!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Possiamo ammirare perfettamente l’area circostante da qui. Sfortunatamente le stagioni invernali sono molto più lunghe a questa altitudine, cosa che influenza gravemente la crescita del raccolto.\n\nSarebbe una cosa saggia costruire un magazzino in estate.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Salute! Ti stavamo aspettando! I miei uomini hanno già esplorato la regione e hanno trovato molti giacimenti promettenti.\n\nDovresti iniziare a estrarre immediatamente prima che qualcun altro ti preceda!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Milord, meno male che sei qui.\n\nL'ex governatore è fuggito. Mentre scappava, ha gridato che quest'area è maledetta.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Il tuo predecessore non ha affatto torto. L'agricoltura è difficile, qui praticamente non cresce nulla. Persino l'acqua è limitata. Ma sicuramente tu riuscirai a trovare una soluzione.";
"T_GAME_QUEST_SCEN10_10_DESC" = "I cittadini sentono un vuoto nella loro vita spirituale, mio signore. Sarebbe possibile costruire una chiesa in città?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Ottieni un alto grado di soddisfazione religiosa.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Ti aspetti davvero che un uomo della mia levatura cammini su queste strade fangose, governatore? Costruisci strade degne di una vera città!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Costruisci delle strade di ciottoli nella tua città.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Costruisci delle strade sterrate nella tua città.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Qualcuno ha fatto un pessimo lavoro qui, mio signore. Tutti gli edifici hanno bisogno di riparazioni.\n\nDobbiamo assumere un carpentiere per aggiustarli tutti prima che crollino completamente.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Costruisci un laboratorio di carpentiere. Ottieni un alto grado di soddisfazione per lo stato degli edifici.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Governatore! Perché la tua città è ancora così piccola? Stiamo perdendo terreno sull'Arciduca!\n\nSe non riesci ad incrementare la popolazione in fretta, perderemo la scommessa!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Aumenta la popolazione del tuo villaggio.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Le nuove famiglie che si sono trasferite in città hanno compiuto un viaggio lungo e faticoso, e sono affamate. Organizziamo un banchetto per loro, e festaggiamo l'inizio ufficiale della scommessa, mio signore!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Produci cibo a sufficienza per nutrire il tuo villaggio.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Dovremmo iniziare a commerciare con i mercanti. Avere dei mercanti in città attirerà visitatori e migliorerà la reputazione della nostra città, mio signore!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Guadagna molto denaro commerciando con il mercante.";
"T_GAME_QUEST_SCEN10_16_DESC" = "La quantità di tasse che raccogli è pietosa! Forse dovresti costruire una tesoreria per aumentare gli incassi.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Costruisci una tesoreria e riscuoti tasse a sufficienza.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Gioielli, ho bisogno di gioielli! E mi chiedo come potrai fornirmeli se ancora non hai nemmeno costruito un'oreficeria.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Costruisci un'oreficeria e avvia la produzione di gioielli.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Eccellente, mio signore. Ora puoi consegnarmi un carico di gioielli.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Consegna i gioielli al mercante.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Mio signore, la nostra prima priorità è il cibo. Ci servono pescatori e cacciatori.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Costruisci un po' di capanni per pescatori e per cacciatori.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Mio buon governatore, non posso assisterti nel tuo lavoro se non costruisci un mercato.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Serve un mercato per espandere il villaggio.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Miol signore! Hai già costruito un'utensileria? L'Arciduca ha già avviato la sua produzione di utensili!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Costruisci un'utensileria e avvia la produzione di utensili.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Alla fine del nostro duro lavoro quotidiano, ci piacerebbe avere un luogo dove rilassarci, incontrare gli amici e berci una tazza di succo d'uva. Una taverna sarebbe perfetta.\n\nNaturalmente con vostro assoluto comodo, mio signore.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Ottieni un alto grado di soddisfazione con le taverne.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Abbiamo abitazioni a sufficienza, mio signore? Tutti i nuovi lavoratori che stanno arrivando in città avranno bisogno di un tetto sulle loro teste, non credi?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Costruisci 2 case grandi e 4 normali.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Costruisci più grandi abitazioni.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Costruisci più piccole abitazioni.";
"T_GAME_QUEST_SCEN10_7_DESC" = "La città necessita di intrattenimento. Un percorso per giostra, ad esempio. Cerchiamo di offrire questo tipo di divertimento prima che arrivino visitatori importanti.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Raggiungere alta soddisfazione per l'intrattenimento.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Ottieni un alto grado di soddisfazione con la giostra.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Mio signore, forse potremmo abbellire questa città grigia costruendo un po' di statue e decorazioni? Facciamolo, prima della prossima visita del re.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Abbellisci la città con decorazioni.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Buon giorno, governatore. Interessa un affare?\n\nHo urgente bisogno di un grande quantitativo di capi di abbigliamento per poter concludere un affare molto lucroso con l'Arciduca. Pagherò molto bene se mi potrai consegnare quel che mi occorre.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Consegna un carico di abiti al mercante.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Questo è un totale disastro, governatore! L'Arciduca di Canterborough ci ha battuto e ha terminato la città prima di noi!\n\nContavo sul tuo aiuto e ora sono molto deuso. Forse l'idea della scommessa non è stata che un sogno un po' folle.";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Eccellente, mio buon governatore! Abbiamo battuto l'Arciduca nella costruzione e nell'espansione della città. La scommessa è vinta!\n\nSono impressionato dal tuo lavoro e mi assicurerò personalmente che tu sia lautamente ricompensato. Inoltre ti insignisco del titolo di Duca, con tutti i diritti e i privilegi che ne conseguono.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Mio leale servitore, credo di essermi messo in un'impresa più grande di me.\n\nHo scommesso con l'Arciduca di Canterborough che sarei riuscito a trasformare la città più povera del mio regno in una fiorente metropoli prima che lui riesca a fare lo stesso.";
"T_GAME_QUEST_SCEN12_01_START" = "Grazie per averci fatto visita. A nome di tutti i monaci, ti do il benvenuto al monastero di Tardishingen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Benvenuto a Tardishingen, mio signore.\nCerto che possiamo aiutarti a fare un bel regalo al Re, tuttavia al momento abbiamo dei problemi con i banditi. Magari tu potresti aiutarci?";
"T_GAME_QUEST_SCEN12_02_START" = "Che impudenza!\n\nQualcuno ha rubato il nostro legname! Se non possiamo costruire le botti, dove mettiamo la birra per il Re?";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Grazie mille, mio signore! Ora possiamo costruire dei barili per la birra.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Costruisci qualche capanno di taglialegna.";
"T_GAME_QUEST_SCEN12_04_START" = "Mio signore, per poter completare i nostri incarichi dobbiamo espandere la città. Per prima cosa, ci serve un'economia stabile e per raggiungere questo obiettivo dobbiamo produrre degli utensili.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Splendido, mio signore. Ora possiamo ampliare ulteriormente la città.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Stabilisci una catena produttiva di utensili.";
"T_GAME_QUEST_SCEN12_05_START" = "La città ha bisogno di altro cibo, mio signore. Abbiamo una fattoria, ma ci mancano mulini a vento e forni.";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Molto bene! Il villaggio sta diventando una vera città.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Stabilisci una produzione stabile di cibo.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "No! Quegli infami banditi hanno distrutto il monastero!";
"T_GAME_QUEST_SCEN12_06_START" = "Mio signore, il monastero si erge su questa collina da quattro secoli. Sarebbe terribile se venisse distrutto da quei banditi che da settimane minacciano di raderlo al suolo...";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Molto bene, mio signore.\nIl monastero ha resistito agli attacchi dei banditi e abbiamo prodotto la birra perfetta!\n\nÈ una bevanda assolutamente deliziosa!";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Proteggi il monastero.";
"T_GAME_QUEST_SCEN12_07_START" = "Devi ricostruire il monastero, altrimenti non porteremo a termine il nostro incarico in tempo.";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Molto bene, mio signore! Il monastero è stato ricostruito. Ora possiamo riprendere a produrre la birra perfetta.";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Ricostruisci il monastero.";
"T_GAME_QUEST_SCEN12_08_START" = "Dobbiamo assicurarci che il monastero sia ben difeso, mio signore. Erigendovi accanto una torre di guardia dovremmo riuscire a proteggerlo.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Costruisci una torre di guardia accanto al monastero.";
"T_GAME_QUEST_SCEN12_09_START" = "Sai quanto i soldati adorano le salsicce?\nPuoi costruire una porcilaia e un macellaio per produrle.";
"T_GAME_QUEST_SCEN12_09_START2" = "Mio signore,\n\nti consiglio di ordinare la costruzione di una porcilaia e di un macellaio. In questo modo, potremo produrre carne per gli abitanti e salsicce per i soldati.";
"T_GAME_QUEST_SCEN12_10_START" = "Uhm, credo che dovremmo fornire spade e armature a quei poveri soldati per aumentare le loro probabilità di sopravvivenza in battaglia. Per raggiungere questo scopo, ci serviranno un'armeria e una conceria.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Ce l'abbiamo fatta, mio signore! Ora possiamo produrre delle armature per i nostri soldati.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Costruisci un'armeria e una conceria.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Costruisci un'armeria.";
"T_GAME_QUEST_SCEN12_11_START" = "Ora che abbiamo un'armeria e una conceria, sarebbe fantastico cominciare a produrre dell'equipaggiamento.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Magnifico, mio signore! Ora i soldati se la caveranno molto meglio in battaglia!";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Produci equipaggiamento per i soldati.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Molto bene, mio signore. Ora il monastero è protetto dagli attacchi dei banditi.";
"T_GAME_QUEST_SCEN12_15_START" = "Non siamo riusciti a sistemare i campi di luppolo distrutti.\n\nSaresti così gentile da seminarle alcuni?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Crea dei campi di luppolo.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Costruisci una fattoria di luppolo e qualche campo di luppolo.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Ah ah ah. Il tuo inutile monastero è un cumulo di macerie. Ora sono io che governo quest'area!";
"T_GAME_QUEST_SCEN12_16_START" = "Credi di poter proteggere quei monaci? Ne dubito. Vedrai come distruggo quell'inutile monastero!";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Argh! La prossima volta me la pagherai! Non finisce qui...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Respingi tutti gli attacchi.";
"T_GAME_QUEST_SCEN12_17_START" = "Mio signore, io e gli altri monaci cominceremo immediatamente a produrre la birra migliore della nazione.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Abbiamo terminato la produzione della birra, mio signore. Ne abbiamo creati diversi tipi e ora dobbiamo scegliere i migliori per proseguire la lavorazione.";
"T_GAME_QUEST_SCEN12_18_START" = "Il nostro mastro birraio dice che dobbiamo migliorare le attrezzature per produrre una birra migliore. Vogliamo che il Re sia soddisfatto, vero? Dev'essere la birra migliore della nazione...";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Fantastico, mio signore! Ora ci servono altri ingredienti di qualità.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Potenzia il monastero al livello 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Signore, la birra è quasi pronta, ma mancano alcuni ingredienti: qualche erba e della polvere d'oro sarebbero perfette come tocchi finali.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Consegna erbe e pepite d'oro. ";
"T_GAME_QUEST_SCEN12_20_START" = "La birra deve maturare per qualche tempo.\n\nIl processo di maturazione richiede riposo indisturbato e al riparo da influenze esterne.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "È pronta, mio signore. Posso mostrarti la birra perfetta?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Difendi il monastero fino al completamento del processo produttivo.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Volevo ringraziarti personalmente.\nQuesto è davvero il regalo di compleanno perfetto per me. Non sapevo che fossi a conoscenza della mia passione per la birra.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Produci la birra perfetta per il Re.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Prepara la città per l'arrivo del Re. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Credi di potermi ingannare? Sono deluso, non riesci nemmeno ad amministrare una piccola città!\n\nIo governo un regno intero e non inganno nessuno!";
"T_GAME_QUEST_SCEN13_01_START" = "L'anno prossimo ispezionerò i miei possedimenti.\nLa tua famosa città sarà la tappa culminante del mio viaggio.";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Sono molto soddisfatto.\nStai gestendo al meglio la tua città e per questo hai il mio rispetto.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Supera l'ispezione del Re.";
"T_GAME_QUEST_SCEN13_02_START" = "Salve, amministratore. Ho deciso di venire nella tua città in anticipo: non vedevo l'ora di ammirarla.\n\nDi certo eri pronto per il mio arrivo.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Non destare sospetti nel Re.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Prima di tutto, dobbiamo riprendere la produzione delle merci.\n\nAssumi un taglialegna e ripara la segheria per riavviare i lavori.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Molto bene, mio signore.\nMa non c'è tempo per riposare!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Assumi un taglialegna e ripara la segheria.";
"T_GAME_QUEST_SCEN13_05_START" = "Oh no! A causa dei banditi nella foresta, la città è in rovina.\n\nDobbiamo iniziare immediatamente i lavori di ricostruzione.";
"T_GAME_QUEST_SCEN13_06_START" = "Il mercato è andato a fuoco e dobbiamo ricostruirlo.\n\nCi servono urgentemente delle merci per preparare la città per l'arrivo del Re.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Ci serve anche un carpentiere, mio signore. Molti edifici hanno urgente bisogno di essere riparati.";
"T_GAME_QUEST_SCEN13_07_START" = "Dobbiamo riparare la tesoreria, in modo che l'esattore possa tornare al lavoro.\nCi serve con urgenza il denaro per le riparazioni.";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Dobbiamo usare le tasse riscosse per pagare le riparazioni.";
"T_GAME_QUEST_SCEN13_08_START" = "Dovresti riparare le abitazioni e costruirne altre per attirare ulteriori lavoratori in città.\nDobbiamo riprendere la produzione.";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Ora abbiamo spazio sufficiente per altri lavoratori, ma non è ancora finita.";
"T_GAME_QUEST_SCEN13_09_START" = "È un disastro!\nPossiamo solo sistemare alla bell'e meglio i posti che verranno visitati dal Re, sperando che non si insospettisca.\n\nUsa al meglio il tuo tempo intanto che il Re si riposa.";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Aspetta che il Re annunci il primo luogo che intende visitare.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Il Re ha visto i banditi e si è insospettito. Dovremo stare più attenti.";
"T_GAME_QUEST_SCEN13_10_START" = "Il Re vuole esplorare la foresta.\nDobbiamo distruggere gli accampamenti dei banditi prima che li veda.";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Meno male, ci è mancato poco! Ma non è ancora finita...";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Distruggi tutti gli accampamenti dei banditi. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Oh no! Non siamo riusciti a ingannare il Re.\nOra che si è insospettito non possiamo commettere altri errori.";
"T_GAME_QUEST_SCEN13_11_START" = "Il Re vuole fare una passeggiata in città.\nSe vedrà dei cittadini insoddisfatti, si renderà conto che qualcosa non va.\n\nDobbiamo anche erigere una sua statua!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Magnifico! I cittadini erano di ottimo umore durante la visita del Re.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Aumenta la soddisfazione dei cittadini e costruisci una statua del Re.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Il Re non è rimasto affatto colpito.\nNon possiamo permetterci altri errori.";
"T_GAME_QUEST_SCEN13_12_START" = "Il Re ispezionerà le truppe.\nAssicurati che vi sia un buon numero di guardie ad attenderlo!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Le guardie cittadine faranno di certo colpo sul Re.";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Assumi un numero sufficiente di soldati.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Abbiamo fallito, mio signore. La festa non è stata all'altezza delle aspettative del Re, che ora è irritato.\n\nMagari avremmo dovuto essere onesti fin dall'inizio...";
"T_GAME_QUEST_SCEN13_13_START" = "Il Re vuole organizzare una grande festa. Fai scorta di abiti e gioielli.\nSe falliremo, sarà tutto perduto!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "La festa è stata un grande successo. A quanto pare, siamo riusciti a ingannare il Re.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Fai scorta di abiti e gioielli.";
"T_GAME_QUEST_SCEN13_14_START" = "Per me è troppo pericoloso percorrere queste strade con le mie merci preziose.\n\nDovrai cavartela da solo!";
"T_GAME_QUEST_SCEN13_15_START" = "Ora che hai sconfitto i banditi, per me sarà un piacere tornare a fare affari nella tua città.";
"T_GAME_QUEST_SCEN13_16_START" = "Il mercante è un codardo, ma ha detto il vero.\nLa foresta intorno alla città è pericolosa. Dobbiamo addestrare delle guardie che tengano alla larga i banditi.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Hai gettato le basi della difesa cittadina, mio signore. Ma ora dobbiamo aumentarla.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Costruisci una caserma e una torre di guardia.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Oh no! I banditi hanno superato le difese! Il Re non ne sarà certo felice. ";
"T_GAME_QUEST_SCEN13_19_START" = "I banditi non contribuiscono certo all'immagine di una città sicura.\nImpedisci che si verifichino troppi attacchi durante l'ispezione, altrimenti ci scopriranno di sicuro.";
"T_GAME_QUEST_SCEN14_01A_START" = "Mio signore, non credi che il comportamento di quell'uomo sia sospetto?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Invia del tessuto.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Mio signore, abbiamo fallito nella nostra missione.\nQuel cerusico era un ciarlatano ed è fuggito con tutto l'oro della tesoreria.\n\nMa per fortuna abbiamo trovato la cura nel suo laboratorio...";
"T_GAME_QUEST_SCEN14_01_START" = "Buongiorno, mio signore. Il regno è stato colpito dalla pestilenza.\nPerfino il Re è gravemente malato! Dobbiamo aiutare il cerusico di corte a preparare una cura al più presto. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Abbiamo trovato una cura in tempo, mio signore!\n\nIn questo momento la stanno somministrando al Re. Per il regno è un'ottima notizia!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Trova una cura per il Re.";
"T_GAME_QUEST_SCEN14_02A_START" = "Mio signore, c'è qualcosa che non va! Questo cerusico fa strane richieste e ho un brutto presentimento...\n\nDobbiamo stare attenti a quell'uomo.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Porterò la birra al cerusico non appena me lo chiederai.\nSpero che ci consegnerà presto una cura. Al Re non rimane molto tempo!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Consegna la birra.";
"T_GAME_QUEST_SCEN14_02_START" = "Credo che una birreria del monastero sarebbe il modo migliore per produrre birra per il Re.\n\nSperiamo che la birra lenisca le sofferenze di Sua Maestà.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Credo che una birreria del monastero e una fattoria di luppolo sarebbero il modo migliore per produrre birra per il Re.\n\nSperiamo che la birra lenisca le sofferenze di Sua Maestà.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Molto bene, mio signore! I monaci ci aiuteranno con tanta birra e il Re ne sarà contento.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Costruisci un monastero.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Costruisci un monastero e un essiccatoio.";
"T_GAME_QUEST_SCEN14_03_START" = "Ci serve una porcilaia per consegnare i maiali al cerusico!\nDovresti ordinarne immediatamente la costruzione, mio signore.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Splendido, mio signore. Ora possiamo cominciare ad allevare i maiali.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Costruisci una porcilaia.";
"T_GAME_QUEST_SCEN14_05_START" = "Mio signore, la città ha bisogno di una caserma. Sono tempi difficili e dobbiamo mantenere l'ordine pubblico.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Mio signore, lo sapevo!\n\nQuel cerusico è un ciarlatano. Aveva la cura per il Re fin dall'inizio.\nA quanto pare, è stato lui a diffondere il contagio.\n\nMi sono preso la libertà di ordinare alle guardie di arrestarlo.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "È oltraggioso!\n\nCome osate arrestarmi?! Sono il consigliere personale del Re.\nNon potete farmi questo...";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Mi deludi, governatore!\n\nLa notte scorsa ho avuto una visione: la tua incompetenza sarà fonte di grave sventura per questa città.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Governatore! Mi chiamo Rasiksin e sono un chiaroveggente, nonché il cerusico reale.\nHo bisogno del tuo pieno supporto.\nPer cominciare, portami subito delle erbe medicinali!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Vedo che mi hai procurato tutte le erbe di cui ho bisogno.\n\nLa notte scorsa ho avuto una visione secondo la quale non deluderai le aspettative del Re.\n\nOra ordina al tuo consigliere di consegnarmi le erbe e levati di torno. Ho del lavoro da fare.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Invia le erbe.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Sapevo di non poter contare su di te, governatore. Le mie visioni mi hanno mostrato che la tua incompetenza sarà una disgrazia per questa città. Hai deluso me e il tuo sovrano!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Mi serve del tessuto per filtrare la cura e dovrai produrne un po' quanto prima.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Mi fa piacere constatare che non mi fai perdere tempo, governatore.\n\nAdesso ordina la consegna delle risorse. Sono una persona molto impegnata!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Produci del tessuto.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "La cura dev'essere diluita per poter essere somministrata a tutti. La birra sarebbe l'ideale.\n\nDatti da fare!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Era ora! Adesso consegnala al mio laboratorio.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Produci della birra.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Nooo... È troppo tardi! La sventura si abbatterà sulla città.\n\nEd è tutta colpa tua!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Per salvare Sua Maestà, dovremo adottare misure più drastiche.\n\nMi servono dei maiali da sacrificare agli dèi.\nMagari sarà sufficiente...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Ce ne hai messo di tempo, governatore. È gentile da parte tua farti finalmente vedere...";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Consegna i maiali.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Mi serve... Volevo dire... Al Re serve dell'erba pipa speciale per lenire i suoi dolori.\n\nConsegnami un forziere di monete per comprare l'erba medicinale!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nDammi qui! Sarò... Cioè... Il Re sarà felice di sapere che presto avrà la sua medicina. Sta soffrendo molto.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Consegna il denaro.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Ho scoperto che gli abiti del Re peggiorano le sue condizioni di salute. Gli servono degli abiti nuovi realizzati con un materiale speciale.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Finalmente mi hai portato gli abiti. Il Re cominciava già a perdere la pazienza.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Consegna gli abiti.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Non sopporto di continuare a lavorare in questo vetusto laboratorio!\n\nCostruiscimi una torre di guardia da poter convertire in un laboratorio moderno. E vedi che sia una torre: mi piacciono le torri.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nAccetto questa torre in nome del Re. Diventerà il mio nuovo laboratorio. E ora levati di torno!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Costruisci una torre di guardia.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Manca un'ultima cosa, governatore.\n\nMi servono dei lingotti d'oro per finire la cura. Portamene alcuni.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "Finalmente! Ora mi serve un po' di tempo per terminare la cura.\n\nDovrò fare alcuni preparativi per andarm... voglio dire, per somministrare la cura.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Consegna i lingotti d'oro";
"T_GAME_QUEST_SCEN15_01_FAIL" = "È tutto perduto! Dovrai vivere con il peso della morte di molti uomini coraggiosi sulla coscienza...";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "È tutto perduto! Senza le scorte necessarie abbiamo perso la guerra.\n\nDovrai vivere con il peso della morte di molti uomini coraggiosi sulla coscienza!\n\nIl Re è seriamente indignato...";
"T_GAME_QUEST_SCEN15_01_START" = "Salve, mio signore.\nSono qui su richiesta del re a ritirare rifornimenti per la guerra in corso.\n\nSo che i tuoi cittadini soffrono per via del conflitto, ma i soldati al fronte hanno urgente bisogno del tuo sostegno!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Salve, mio signore.\nSono qui su richiesta del re a ritirare rifornimenti per la guerra in corso. So che i tuoi cittadini soffrono per via del conflitto, ma i soldati al fronte hanno urgente bisogno del tuo sostegno!\n\nLa vittoria sarà possibile solo se tutte le scorte arriveranno in tempo.\n\nIl Re conta sul vostro sostegno.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Abbiamo vinto!\nIl tuo supporto è stato fondamentale e i miei uomini ti sono molto grati. Presto tornerà a regnare la pace.";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Supporta i soldati.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Invia tutte le scorte all’esercito reale in tempo.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "Molte vite dipendono dal tuo supporto!";
"T_GAME_QUEST_SCEN15_02_START" = "Abbiamo conquistato nuovi territorio e ora dobbiamo rinfrancare la linea del fronte.\nInvia assi e tessuto al più presto per erigere degli accampamenti.";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Molto bene. Ora manda le risorse ai miei soldati!";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Invia tessuto e assi.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "Come credi che potremo vincere delle battaglie senza gli armamenti adeguati?!";
"T_GAME_QUEST_SCEN15_03_START" = "Le ultime battaglie hanno rovinato parecchi armamenti.\n\nMi serve un carico di armi per equipaggiare i miei uomini.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Con queste nuove armi, i soldati vinceranno sicuramente la prossima battaglia.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Consegna le armi.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Senza la tua consegna, non abbiamo speranze per la battaglia decisiva.";
"T_GAME_QUEST_SCEN15_04_START" = "Le nostre provviste scarseggiano.\nInvia pane e carne, così potremo recuperare le forze in vista della battaglia finale.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "I soldati attendono il cibo: invialo subito!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Invia pane e carne.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "Consegna birra e salsicce.";
"T_GAME_QUEST_SCEN15_08_START" = "Non possiamo abbandonare i nostri soldati, ma anche i cittadini sono molto provati, mio signore.\nLa decisione spetta a te.\nPrima di tutto, costruisci una segheria e un capanno del cacciatore.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Ora speriamo di essere pronti.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Costruisci una segheria e un capanno del cacciatore.";
"T_GAME_QUEST_SCEN15_09_START" = "Per consegnare quelle risorse ci servono un pascolo e una bottega del tessitore.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Bel lavoro, mio signore. Puoi sempre velocizzare la produzione potenziando gli edifici o costruendone altri.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Costruisci un pascolo e una bottega del tessitore.";
"T_GAME_QUEST_SCEN15_10_START" = "Ci servono strutture per la lavorazione del ferro al fine di supportare i nostri soldati.";
"T_GAME_QUEST_SCEN15_10_SUCCESS" = "Il fabbro è al lavoro, quindi forniscigli ferro a sufficienza per non interrompere la produzione.";
"T_GAME_QUEST_SCEN15_10_TITLE" = "Costruisci un'utensileria e un'armeria.";
"T_GAME_QUEST_SCEN15_11_START" = "Per sostenere le truppe con dei generi alimentari, abbiamo bisogno di un forno e di altri capanni del cacciatore.";
"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Molto bene, mio signore. Presto avremo le risorse richieste.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Costruisci un forno e altri capanni del cacciatore.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "Concentrandoti sulle truppe, hai trascurato i tuoi cittadini!";
"T_GAME_QUEST_SCEN15_13_START" = "Abbiamo sopportato un lungo periodo di privazioni, mio signore. Ti chiedo umilmente di dirottare verso i poveri parte delle provviste destinate ai soldati.";
"T_GAME_QUEST_SCEN15_13_SUCCESS" = "Sei un signore onorevole. Nonostante le richieste dei soldati, non hai ignorato i tuoi cittadini.";
"T_GAME_QUEST_SCEN15_13_TITLE" = "Opzionale: supporta i cittadini.";
"T_GAME_QUEST_SCEN15_13_TITLE_OLD" = "Supporta i cittadini.";
"T_GAME_QUEST_SCEN15_14_FAIL" = "La vista di tante risorse preziose consumate dalla guerra è frustrante per i cittadini, mio signore!";
"T_GAME_QUEST_SCEN15_14_START" = "Fuori fa freddo e i lavoratori non hanno abiti adeguati. Sii buono e producine in quantità.\nNon possiamo pagarti, mio signore, ma lavoreremo più duramente che mai!";
"T_GAME_QUEST_SCEN15_14_START_2" = "Fuori fa freddo e i lavoratori non hanno abiti adeguati. Sii buono e producine in quantità.\nNon possiamo pagarti, mio signore, ma lavoreremo più duramente che mai!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "Sei così buono, mio signore! Ora non patiremo più il freddo.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Produci abiti per il popolo.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Senza utensili, la gente non potrà lavorare bene.";
"T_GAME_QUEST_SCEN15_15_START" = "Se potessi inviare del ferro all'utensileria, potremmo avere nuovi attrezzi da lavoro.\nIn questo modo, potremmo lavorare meglio in questi tempi difficili.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "La tua generosità non conosce limiti, mio signore!";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Dai degli utensili ai lavoratori.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "I tuoi cittadini continuano a morire di fame, mio signore. Se non li sfami, il morale colerà a picco.";
"T_GAME_QUEST_SCEN15_16_START" = "I cittadini muoiono di fame, mio signore.\nLascia a noi queste provviste e non ci lamenteremo mai più!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "Gli dèi ti benedicano!";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Dai del cibo ai cittadini.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "L'insoddisfazione si diffonde, mio signore. Devi fare qualcosa al più presto.";
"T_GAME_QUEST_SCEN15_17_FAIL" = "Peccato, mio signore. Il morale è basso e temo che i cittadini furibondi possano compiere qualche gesto insensato.";
"T_GAME_QUEST_SCEN15_17_START" = "Mio signore, tutti soffrono per via della guerra.\nSe il morale dei cittadini scende troppo, potrebbe scoppiare una rivolta.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Straordinario, mio signore. Hai soddisfatto i cittadini e supportato le truppe.";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Non far diminuire troppo la soddisfazione.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Mantieni un grado di soddisfazione superiore al 75% per i prossimi due minuti.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Non far scendere la soddisfazione troppo in basso troppo a lungo.";
"T_GAME_QUEST_SCEN15_19_START" = "Ho sentito dire che l'incendio non è stato accidentale, mio signore.\nPotrei andare in una taverna e raccogliere informazioni. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "I cittadini chiacchierano molto alla taverna. Cercherò di saperne di più sugli incendi.";
"T_GAME_QUEST_SCEN15_20_START" = "Si dice che c'è un piromane che appicca incendi per fomentare la popolazione.\nDobbiamo addestrare delle guardie.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Ora non ci resta che attendere...";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Possiamo stare tranquilli, mio signore. Le guardie hanno arrestato il piromane.\nLa città è di nuovo al sicuro.";
"T_GAME_QUEST_SCEN16_01_START" = "Salve, venerato signore. Il Re sta per richiedere dei tributi.\nDobbiamo sostenere l'agricoltura locale.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Magnifico!\n\nGrazie alle tue doti di economista, mio signore, siamo riusciti a esaudire la richiesta del Re.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Soddisfa le richieste del Re.";
"T_GAME_QUEST_SCEN16_02_2_START" = "Oh no! Il Re ha richiesto un'altra consegna di grano.\nForse riusciremo a procurarci il resto del grano richiesto dal mercante.";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "È fatta! Ora invia il grano al Re.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Manda altro grano al Re.";
"T_GAME_QUEST_SCEN16_02_START" = "Il Re ha chiesto del grano a tutti i villaggi.\nPer effettuare una consegna tanto ingente, ci serviranno altre fattorie!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Abbiamo accumulato abbastanza grano da poter effettuare la consegna, mio signore.";
"T_GAME_QUEST_SCEN16_03_START" = "Il Re ha bisogno di risorse per costruire altri magazzini.\nInvia i materiali richiesti al Re.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Invia i materiali richiesti per proseguire con le altre consegne.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Consegna i materiali per costruire un magazzino.";
"T_GAME_QUEST_SCEN16_04_1_START" = "Il primo carico era avariato. Inviane un altro dopo aver curato la malattia che affligge la città.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Ottimo lavoro, mio signore! La nuova carne è in magazzino, in attesa di essere consegnata.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Invia la carne.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Invia la carne dopo che l’epidemia è stata debellata.";
"T_GAME_QUEST_SCEN16_04_START" = "Ora il Re vuole della carne.\nCon un numero sufficiente di cacciatori, non dovrebbe essere un problema.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Molto bene, mio signore. Abbiamo accumulato le risorse richieste.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Costruisci altri capanni del cacciatore e consegna la carne.";
"T_GAME_QUEST_SCEN16_05_START" = "Il Re vuole organizzare una festa e vuole che gli inviamo delle bevande.\nInvia birra e succo d'uva alla corte reale.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Molto bene, mio signore. Abbiamo abbastanza abiti e gioielli.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Invia birra e succo d'uva.";
"T_GAME_QUEST_SCEN16_06_START" = "Il Re è stato molto soddisfatto delle nostre consegne.\nOra vuole che inviamo anche del cibo.\n\nOffri succo d'uva e pane per la festa reale. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Magnifico, mio signore. Questo era l'ultimo tributo.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Invia salsicce e pane.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Invia succo di frutta e pane.";
"T_GAME_QUEST_SCEN16_08_START" = "È una catastrofe, mio signore! Il grano ha contratto una malattia misteriosa ed è inutilizzabile!";
"T_GAME_QUEST_SCEN16_09_START" = "I cittadini sono stati colpiti da una terribile pestilenza.\nSe non li curiamo al più presto, non resterà nessun lavoratore!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "La pestilenza è causata dagli animali malati e ha coinvolto anche la consegna per il Re.\nDobbiamo inviarne un'altra!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Risolvi la situazione con l'aiuto di un medico.";
"T_GAME_QUEST_SCEN16_10_START" = "Gli dèi cospirano contro di noi. La pestilenza ha ucciso tutti gli animali selvatici. Ora come faremo a sfamare la popolazione e soddisfare le richieste del Re?";
"T_GAME_QUEST_SCEN16_11_START" = "Dovremo allevare degli animali per sfamare i cittadini.\nPertanto ci serviranno una porcilaia e un macellaio.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "I maiali si nutrono di grano. Scambialo con il mercante, così potremo effettuare la consegna per il Re.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Costruisci una porcilaia e un macellaio.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Comprenderai che le mie provviste sono molto ambite.\nDa ora in poi scambierò il mio grano con del ferro.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Consegna il ferro e presto tornerò con un'altra consegna.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Scambia grano con ferro.";
"T_GAME_QUEST_SCEN16_12_2_START" = "A un prezzo irrisorio posso cederti le ultime riserve di grano della nazione!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "È un piacere, mio signore. Inviami l'oro e vedrò di procurarmi altro grano.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Scambia grano con oro.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Ho saputo della disgrazia che ti ha colpito e voglio proporti un affare. Ho delle scorte di grano che sono disposto a scambiare con delle merci.";
"T_GAME_QUEST_SCEN16_12_START" = "Sarei disposto a cederti del grano in cambio di pietre.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Pare che tu abbia merci a sufficienza per uno scambio. Non vedo l'ora di trattare ancora con te.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Scambia grano con pietra.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Avete mai assaggiato il pane fatto da mio nipote? Dovreste! E ditegli di cuocerne a sufficienza per passare l'inverno!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Cuoci 50 filoni di pane.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Costruire una tessitrice.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Costruire un sarto.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Dite, avete anche voi freddo quanto noi? Mia moglie si è presa l'influenza a causa dei buchi nel vestito. Forse potreste aiutarci a confezionare degli abiti caldi?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Costruisci un pascolo per le pecore.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Credo che la nostra cittadina sia quasi pronta per l'inverno in arrivo! Ma, detto tra noi, non sarebbe bellissimo bersi un bel boccale di succo giù alla taverna quando fuori si gela?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Costruisci una manifattura di succo e produci 50 fiaschi di succo.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Mio Sir Siniscalco, non voglio sembrarvi impertinente ma purtroppo manchiamo di fattorie! Come potremo mietere il grano in tempo prima dell'inverno?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Costruisci 2 fattorie.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrr, si gela già, mio buon Sir Siniscalco. Sono convinto che questo sarà un inverno molto rigido! Mia moglie ed io confidiamo che facciate in modo di procurare legna da ardere a sufficienza!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Costruisci 3 capanni per taglialegna.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Grazie! Portate i miei saluti ai miei fratelli, se li incontrate! Dite loro di raccogliere quanta più legna possibile!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Raccogli 35 unità di legno.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Finalmente possiamo iniziare la mietitura! Speriamo che sia sufficiente per le nostre necessità!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Raccogli 35 unità di grano.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Che raccolto abbondante! Non sappiamo nemmeno dove immagazzinare tutto il grano! Sarebbe una buona idea trasformarlo in pane!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Costruisci un mulino a vento e produci farina.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Gentile Sir Siniscalco, amiamo vivere qui, ma temiamo che le nostre case non siano in grado di sopportare a lungo l'inverno...";
"T_GAME_QUEST_SCEN2_6_NAME" = "Mantieni tutte le case in buone condizioni.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Sono ancora preoccupato per una cosa... Purtroppo, non abbiamo utensili a sufficienza. Sono certo che vi rendiate conto di quanto siano importanti gli utensili per la riparazione degli edifici. Vorreste acquistarne un po' per noi?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Consegna un tributo di 50 utensili.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Temo che i miei fratelli non siano in grado di terminare da soli il lavoro... Forse potreste procurarvi altre braccia per il nostro villaggio?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Aumenta la popolazione a 50 individui.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Ho già i ghiaccioli al naso... Ma alcuni dei viandanti alla ricerca di un posto ove stabilirsi stanno ancora peggio. Credo che dovremo permettere loro di vivere nel nostro villaggio!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Costruisci 6 condomini.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Tesoro, non dimenticare che domani è il nostro anniversario! Mi piacerebbe un gioiello nuovo! Se solo conoscessi un orafo...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Costruisci un'oreficeria.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Sono certo che il re e i tuoi paesani sarebbero felici di avere nuovi utensili! Quelli vecchi sono tutti arrugginiti!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Costruisci un'utensileria.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Costruisci una sartoria e produci abiti.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Oh, guarda che carine quelle pecore! Tesoro, le hai viste? E guarda la lana che è già stata raccolta! Ora ci servono solo un tessitore e un sarto!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Costruisci una bottega di tessitore e produci stoffa a sufficienza.";
"T_GAME_QUEST_SCEN3_13_DESC" = "I bambini sono davvero eccitati all'idea del pane fresco che tra poco avranno! Hai già costruito qualche forno, vero? Tesoro?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Indovina un po'! Mia sorella finalmente si sposa! Ma non abbiamo una chiesa in città! Non solo per i matrimoni, anche per i nostri paesani più religiosi!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Raggiungi un alto grado di soddisfazione religiosa.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Guarda, tesoro! La città è rifiorita e tutto funziona alla perfezione! Adesso hai il permesso di rilassarti con i tuoi amici alla taverna, se vuoi!";
"T_GAME_QUEST_SCEN3_15_NAME" = "Ottieni un alto grado di soddisfazione con le taverne.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Tesoro, guarda questo povero villaggio... Poveri paesani, mi dispiace tanto per loro! Credo che dovresti chiedere aiuto al re! Forse puoi convincerlo inviandogli qualche dono!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Consegna un tributo al re ed esegui tutti i compiti.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Dovresti prendere in mano la situazione fino a che il re non manda i suoi aiuti! I paesani hanno urgente bisogno di più acqua!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Costruisci un pozzo nel villaggio.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Il tuo predecessore non era nemmeno in grado di rifornire cibo a sufficienza! Inconcepibile! Tesoro, dovresti fare qualcosa subito! Perché non costruisci qualche capanno per i pescatori?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Costruisci 2 capanni per pescatori.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Quei poveri bambini... Tesoro, non possiamo nutrirli di solo pesce! Dovresti costruire delle fattorie, così che possiamo coltivare grano per fare farina e pane!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Costruisci due fattorie e produci grano.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Costruisci una fonderia.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Ehi, tesoro, non dimentichi qualcosa? Non avevi pensato di mandare dei doni al re per convincerlo ad aiutarci? Sei fortunato ad avere me... Abbiamo bisogno di una miniera e di una fonderia per produrre qualcosa di valore!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Costruisci una miniera.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Tutti i paesani sono affaticati! Non puoi costruire qualche nuova abitazione per attrarre altri lavoratori?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Costruisci 3 abitazioni.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Oh, sono così felice! Le cose stanno migliorando! Ora possiamo perfino iniziare a riscuotere più tasse dai paesani!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Riscuoti 1500 talleri in tasse.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Raccogli più talleri in tasse.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Sai cosa sarebbe bello avere? Dei vestiti nuovi! Voglio dire, per il re soprattutto, naturalmente... Ma prima ci servono dei pascoli per le pecore, così potremo avere la lana!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Costruisci 2 pascoli per pecore.";
"T_GAME_QUEST_SCEN3_9_DESC" = "I contadini sono già al lavoro per la mietitura del grano! Ora puoi costruire un mulino a vento e produrre la farina per il pane!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Costruisci un mulino e produci farina.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Il mio castello non è all'altezza della mia regalità, quindi sto pensando di espandere la mia dimora estiva.\n\nIl tuo re di ordina di consegnare una grande quantità di pietre. Conto sulla tua efficienza, mio leale Siniscalco.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Consegna un carico di pietre al re.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Il calore ha danneggiato le nostre abitazioni. Le case si sono deteriorate e molte famiglie chiedono che migliori lo stato degli edifici.\n\nSarebbe splendido se prendessi in considerazione qualche miglioria in città.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Consegui un alto grado di soddisfazione per lo stato degli edifici.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Mio buon Siniscalco, sto ancora aspettando la consegna del succo d'uva. Il banchetto inizierà presto.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Consegna unità di succo d'uva al re.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Mio signore, c'è grande richiesta di farina in tutto il regno. Le fattorie non producono grano a sufficienza per far lavorare i mulini a piena capacità.\n\nSe mi consegnerai abbastanza farina, potrei invadere il mercato e creare un monopolio nella regione. Naturalmente ti pagherò profumatamente.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Consegna unità di farina al mercante.";
"T_GAME_QUEST_SCEN4_14_DESC" = "I cittadini vogliono costruire dei parasole per difendersi dal calore eccessivo del giorno. Dovremmo fornire loro delle assi di legno, così potranno iniziare subito.";
"T_GAME_QUEST_SCEN4_14_NAME" = "Produci 35 assi.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Mio signore, ti sei ben comportato. La città è cresciuta a dimensioni ammirevoli.\n\nEppure, i cittadini sono infelici a causa della siccità. Dovresti provare ad aumentare la felicità soddisfando i loro desideri. E' solo una proposta, naturalmente...";
"T_GAME_QUEST_SCEN4_15_NAME" = "Consegui un alto livello di felicità nella città.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Semplicemente meraviglioso, mio buon Siniscalco!\nNonostante la siccità sei riuscito a costruire una grande città. I tuoi cittadini sono davvero soddisfatti dei cambiamenti che hai fatto.\n\nIl tuo re è molto soddisfatto del tuo lavoro. Hai reso un grande servizio al regno e verrai ricompensato adeguatamente.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Mio signore, i cittadini vivono in miseria e povertà. Il regno è preda della siccità. Guarda questo fiume, un tempo magnifico, che scorreva accanto al tuo castello. Ora non rimangono che pozzanghere...\n\nIl re ti ha incaricato di espandere la nostra città. Iniziamo costruendo altre abitazioni.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Costruisci altre 8 abitazioni.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Mio signore, il re è soddisfatto dell'espansione della città, ma ordina di costruirne una ancora più grande.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Raggiungi una popolazione totale di 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Mio signore Siniscalco, come mercante potrei esserti di grande aiuto nella tua attuale situazione.\n\nIl regno soffre la siccità, ma io posso rifornire di provviste la tua città, se costruirai un mercato.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Ottieni un alto livello di soddisfazione al mercato.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Ti supplico, mio signore, ordina la costruzione di altri pozzi per rifornire i cittadini di acqua a sufficienza per quest'ondata di calore.";
"T_GAME_QUEST_SCEN4_3_NAME" = "Costruisci 2 pozzi.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Porto buone nuove, mio signore. Un cittadino ha scoperto che le pozze d'acqua rimaste nel letto del fiume asciutto ospitano ancora qualche pesce.\n\nDovremmo far costruire dei capanni di pescatori.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Costruisci 2 capanni di pescatori.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Mio signore Siniscalco, vorrei proporti un affare.\n\nSe estendiamo i nostri rapporti commerciali, potrei organizzare delle consegne regolari di cibo nella tua città.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Accumula un profitto di 1000 talleri dalle vendite al mercato.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Ancora una volta vengo a te con una proposta. Ho urgente bisogno di carbone. Riforniscimi di carbone e ti ripagherò con una montagna di talleri.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Consegna unità di carbone al mercante.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Siniscalco, la mia corte ha urgente bisogno di succo d'uva. La siccità devasta ancora il mio regno, e ha distrutto il raccolto di uva.\n\nTi ordino di costruire una manifattura di succo. Sto organizzando un banchetto al mio castello, quindi non mi deludere!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Costruisci una manifattura di succo e produci del succo.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Mio signore, la mia famiglia si strugge per coltivare questo suolo arido. Il raccolto sarà scarso, quindi una fattoria non sarà sufficiente.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Costruisci un'altra fattoria.";
"T_GAME_QUEST_SCEN4_9_DESC" = "La nostra scorta di pane scarseggia pericolosamente, mio signore. Dovremmo ridurre il consumo di pane rifornendo la città con più pesce.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Produci carne a sufficienza.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Completa tutti gli incarichi, sconfiggi la siccità e trasforma il tuo villaggio in una città!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Ora manca una sola cosa, mio signore: succo d'uva per festeggiare la nostra vittoria!\n\nPer favore, consegna succo d'uva in grande quantità all'accampamento militare!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Consegna 45 unità di succo d'uva al cavaliere.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Meraviglioso, mio signore!\nLord Blankenstein ha completato la sua campagna e ha parlato molto bene di te e del supporto che hai fornito.\n\nVorresti fare un ultimo affare prima che io lasci questa regione?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Ottieni un profitto di 2500 talleri commerciando.";
"T_GAME_QUEST_SCEN5_1_DESC" = "E' una bellissima giornata, mio signore. Ho grandi notizie. Siamo stati contattati da un libero mercante.\n\nTra poco visiterà la nostra città e ha bisogno di assi di legno per costruire una bottega.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Produci 30 assi.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Mio signore, hai stabilito un bel centro di commercio qui. Ma manca una cosa importante, una taverna. Se costruissimo una taverna, la nostra cittadina attrarrebbe più mercanti e viaggiatori.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Ottieni un alto grado di soddisfazione con le taverne.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Molto bene, mio signore. Quella taverna attirerà molte opportunità in futuro.\nOra passiamo alla parte più interessante del nostro accordo. Vendiamo un po' di merce...";
"T_GAME_QUEST_SCEN5_3_NAME" = "Ottieni un profitto di 1500 talleri commerciando.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Saresti così gentile da rifornirti di stoffe, mio signore? Ho un possibile acquirente estremamente interessato alle stoffe.\n\nInoltre ho incontrato un cavaliere durante i miei viaggi. Si sta dirigendo qui e potrebbe avere del lavoro per te.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Accumula 35 unità di stoffa nel tuo magazzino.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Mio signore! Mi chiamo Kunibert von Blankenstein, e sono un cavaliere del re.\n\nIl tuo centro di commercio è perfetto per aiutarmi nella mia missione di scacciare i banditi da queste terre. Puoi rifornirmi di pietre con le quali costruire torri di guardia per sorvegliare la regione?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Consegna 50 pietre al cavaliere.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Mio signore Siniscalco, i miei armaioli hanno urgente bisogno di ferro per costruire spade per i soldati.\n\nCi sono diversi depositi di minerale vicino al tuo centro di commercio. Puoi spedire un carico di ferro al mio servitore?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Consegna 65 unità di ferro al cavaliere.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Ho un problema, mio signore. Alcuni dei miei fanti hanno danneggiato le loro armature durante l'ultima battaglia contro i banditi.\n\nRifornisciti di utensili, così che i miei soldati possano riparare le armature quando visitano il centro di commercio.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Produci 25 utensili.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Porto buone nuove, mio signore. La mia campagna è stata un grande successo e i banditi sono stati allontanati da questa regione.\n\nDurante questa lunga campagna abbiamo consumato tutte le nostre provviste. Ho bisogno che consegni del cibo al mio esercito.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Consegna 25 pesci e 25 filoni di pane al cavaliere.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Le mie truppe vogliono festeggiare la nostra vittoria contro i banditi, ma ora che i banditi non sono più un problema, i miei uomini sono irrequieti.\n\nPotresti creare delle fonti di intrattenimento, milord?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Le mie truppe vogliono festeggiare la nostra vittoria contro i banditi, ma adesso che i banditi sono stati sconfitti, gli uomini sono irrequieti.\n\nPuoi costruire una giostra in modo che i soldati possano rilassarsi un po', mio signore?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Ottieni un alto grado di soddisfazione con la giostra.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Costruisci un centro di commercio fiorente completando tutti gli incarichi!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Assolutamente splendido, mio signore.\nSei riuscito a stabilire un centro di commercio in un luogo strategicamente importante. Il re e Lord Blankenstein sono molto soddisfatti del tuo lavoro e del tuo aiuto nella campagna contro i banditi in questa regione.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Il re ha inviato un ordine! Pretende una enorme quantità di materiali per costruire una cattedrale! La costruzione di questo monumentale edificio è già iniziata, quindi dobbiamo consegnare le risorse il più rapidamente possibile.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Consegna le risorse per la costruzione della cattedrale.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Scambia lana con pesce.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Scambia minerale di ferro con pesce.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Scambia succo d'uva con pesce.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Scambia minerale d'oro con pesce.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Scambia assi di legno con pesce.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Vedo che non ci sono laghi né fiumi nelle vicinanze, quindi non puoi produrre pesce. Costruisci un mercato e potrò rifornirti di pesce in cambio di altre merci!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Costruisci altre 2 miniere.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Costruisci altre 3 miniere.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Dobbiamo iniziare a estrarre immediatamente! Verifica di avere miniere attive a sufficienza per poter rispettare le date di consegna.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Costruisci una miniera.";
"T_GAME_QUEST_SCEN6_4_DESC" = "I tuoi cittadini stanno lavorando sodo per estrarre tutto quel minerale! Riforniscili di cibo a sufficienza per mantenerli in forze!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Costruisci un forno.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Stiamo procedendo bene, ma dobbiamo ancora fondere il minerale!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Costruisci 2 fonderie.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Lavorare nelle miniere buie e umide senza l'abbigliamento adatto è spiacevole! Dovresti fornire ai tuoi cittadini degli abiti caldi. Sicuramente lo apprezzerebbero!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Consegna 25 capi di abbigliamento.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Mio signore, produciamo risorse a una velocità strepitosa! Dobbiamo costruire altri magazzini per tutto quel materiale!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Costruisci 2 magazzini.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Lavorare in miniera è duro! I tuoi cittadini vorrebbero un luogo dove rilassarsi dopo il lavoro quotidiano. Una taverna sarebbe perfetta!";
"T_GAME_QUEST_SCEN6_8_NAME" = "Costruisci una taverna.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Bel lavoro! Sei stato bravo a consegnare tutte le risorse necessarie per la cattedrale! La costruzione richiederà tempo, però.\n\nLa cattedrale commemorerà il nostro grande re, le cui imprese hanno portato un'era di pace ed armonia che durerà per secoli!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Ricorda che puoi eliminare gli alberi che ti ostacolano! Usa la pala per segnalare gli alberi che vuoi rimuovere.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Mio signore Siniscalco, non possiamo preparare una torta nuziale senza gli ingredienti giusti! Saresti così gentile da costruire una fattoria per produrre la nostra farina?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Costruisci una fattoria.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Costruisci un mulino.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Produci 25 filoni di pane.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "Questo sarà un matrimonio meraviglioso! Innanzitutto ci vuole un'eccellente torta nuziale. Puoi per favore costruire un forno mentre io scelgo il mio abito?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Costruisci un forno.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Ho bisogno di un mercato per sbarazzarmi di tutti i regali di matrimonio che non mi piacciono!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Ottieni un alto livello di soddisfazione al mercato.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Mio signore, stiamo procedendo bene con i preparativi! Ma ci servono più utensili per costruire la tenda nuziale!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Costruisci un laboratorio di utensili.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Produci 20 utensili.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Voglio che il matrimonio si tenga in una bellissima chiesa. Ne hai già costruita una?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Ottieni un alto grado di soddisfazione religiosa.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Costruisci un pascolo per pecore.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Costruisci un laboratorio di tessitura.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Produci 20 pezzi di stoffa.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Riesci a crederci? Non riesco a trovare un abito da sposa decente! Ho bisogno di un abito, subito! Fanne confezionare uno al tuo sarto migliore.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Costruisci una sartoria.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Costruisci delle decorazioni.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Aumenta la felicità dei tuoi cittadini!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Questo posto è triste... puoi rendere più bella questa città? Voglio che tutti si sentano felici come me.";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Non mi interessano la torta e i fiori; voglio una grande festa con fiumi di succo! E voglio invitare tutta la città! Ma non ho spazio sufficiente per ospitare tutti gli ospiti!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Costruisci altre abitazioni.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Voglio un bel posto nel quale incontrarmi con gli amici quando il matrimonio sarà finito. Questa città ha bisogno di una taverna!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Ottieni un alto grado di soddisfazione con le taverne.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Produci 25 unità di succo d'uva.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "I miei amici saranno assetati! Ti sei già occupato del succo?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Costruisci una manifattura di succo.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Ci saranno più ospiti del previsto. Costruisci una abitazione grande.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Costruisci una abitazione grande.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Produci 15 gioielli.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Oh no! Sono nei guai! Ho perduto l'anello nuziale! Non ditelo a lei! C'è un orafo in città dove posso farne un altro?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Costruisci un'oreficeria.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Prima di sposarmi, voglio fare colpo sulla mia fidanzata alle giostre!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Costruisci una giostra.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Mio signore, i magazzini del castello sono già zeppi d'oro. Posso suggerire di ordinare la costruzione di un magazzino supplementare?";
"T_GAME_QUEST_SCEN8_10_NAME" = "Costruisci un nuovo magazzino.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Gli uomini della città sarebbero più soddisfatti se ci fosse un posto dove potersi incontrare e bersi una tazza di succo d'uva dopo una dura giornata di lavoro. Sarebbe troppo chiedere una taverna, mio signore?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Ottieni un alto grado di soddisfazione con le taverne.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Mio signore, il fabbro ha costruito delle semplici stufe per i nostri cittadini, ma ci manca il carbone per alimentarle.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Produci 50 unità di carbone.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Mio signore, la città manca di legna per riscaldare le case. E' molto importante fare scorta di legname!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Produci 75 unità di legna.";
"T_GAME_QUEST_SCEN8_2_DESC" = "La città è in pessimo stato. Guarda tutte quelle case danneggiate. Molte di loro crolleranno alla prima tempesta di neve. Facciamo venire un carpentiere in città per farci aiutare nelle riparazioni.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Costruisci un laboratorio di carpentiere.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Mio signore, questo rigido inverno è senza dubbio un segno del cielo! Dobbiamo pentirci dei nostri peccati! Costruiamo una casa del Signore per rabbonire l'onnipotente!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Raggiungi un alto grado di soddisfazione religiosa.";
"T_GAME_QUEST_SCEN8_4_DESC" = "I cittadini sono in subbuglio, mio signore. Nelle loro case fa molto freddo. Credo che dovremmo fare scorta di lana. I cittadini potrebbero usarla per isolare le case dal freddo.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Produci 55 unità di lana.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Il governatore della provincia di confine ci ha inviato un piccione viaggiatore con una richiesta di aiuto! Hanno urgente bisogno di abiti caldi per la loro gente.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Consegna un carico di abiti alla provincia confinante.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Le fattorie non possono produrre grano in inverno, mio signore. Mandiamo qualche cittadino nei boschi a caccia di cervi.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Costruisci qualche capanno di cacciatori.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Mio leale servitore, il regno è stato colpito duramente da questo inverno straordinariamente rigido. Le tasse si sono ridotte drasticamente. Ti ordino di costruire una tesoreria per aumentare gli introiti e inviarmi un carro pieno d'oro come tributo.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Costruisci una tesoreria e consegna un tributo in oro al re.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Ora che abbiamo un carpentiere in città, riparare tutte quelle case danneggiate non sarà un problema. I cittadini ne saranno molto felici.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Assicurati che tutte le case vengano riparate.";
"T_GAME_QUEST_SCEN8_9_DESC" = "La selvaggina è sempre disponibile, anche d'inverno, e può servire da sostituto per il pane. Assicuriamoci che ci sia carne a sufficienza per farci superare l'inverno.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Produci 50 unità di carne.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Mio signore, l'inverno è molto più rigido di quello che ci aspettassimo e i cittadini sono insoddisfatti della situazione. Dobbiamo agire in fretta o non sopravviveremo all'inverno!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Fai superare l'inverno alla città...";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Mio signore, i cittadini sono molto soddisfatti dei progressi fatti! Ora siamo attrezzati per affrontare i mesi invernali e siamo riusciti anche ad aiutare la provincia confinante. Siamo pronti, questo inverno non ci fa paura!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Mio signore, ho saputo che hai problemi con dei ribelli nella zona. Vorrei guidare una spedizione di ricerca nei boschi, ma i miei mercenari vogliono essere pagati in anticipo.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Paga i mercenari.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Ho un'altra richiesta, mio leale servitore. Voglio che la nave ammiraglia sia davvero degna di un re, e questo significa ornamenti di lusso!\n\nTi ordino di consegnarmi l'oro necessario a tale scopo. Non mi deludere.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Consegna minerale d'oro al re entro il limite di tempo.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Mio leale servitore, la costruzione della mia flotta procede bene, ma abbiamo bisogno di grandi quantità di stoffa per le vele. Ti ordino di consegnare stoffa a sufficienza per produrre tutte le vele delle mie navi.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Consegna stoffa per la produzione di vele.";
"T_GAME_QUEST_SCEN9_13_DESC" = "I miei uomini hanno scoperto qualcosa. Abbiamo trovato tracce dei banditi nella foresta. Ma prima di proseguire nelle ricerche abbiamo bisogno di altre provviste.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Consegna provviste ai mercenari.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Governatore! Ho perduto un intero carico di assi a causa dei banditi che agiscono nella tua provincia. Tutto ciò deve finire. Consegna altro legname al più presto.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Consegna assi di legno per supportare la costruzione della flotta del re.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Mio signore, l'esattore ha trovato le prove di un collegamento tra i banditi della foresta e il sabotatore in città. Ma rifiuta di dirci altro poiché teme per la sua vita.\n\nEgli esige di essere sollevato dal suo incarico di esattore. Inoltre vuole degli abiti nuovi in modo da poter lasciare la città e nascondersi. Solo a quel punto ci dirà quel che ha scoperto.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Licenzia l'esattore dalla tesoreria e riforniscilo di abiti nuovi, così che possa abbandonare la città di nascosto.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Mio signore, come promesso l'esattore ha reso nota l'identità del sabotatore prima di lasciare la città.\n\nSi tratta del mercenario e dei suoi uomini! Sono degli imbroglioni! Vanno di città in città per offrire "protezione" dagli atti di banditismo e sabotaggio che sono loro stessi a commettere!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Brutte notizie, mio signore! Qualcuno è penetrato nel magazzino e ha rubato tutta la nostra carne!\n\nPiazziamo un po' di torce in giro. Ci aiuteranno a vedere i ladri di notte.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Costruisci 7 torce intorno alla città per allontanare i ladri.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Mio sire, dal momento che non verremo visitati da mercanti ancora per molto tempo, abbiamo bisogno di altro spazio per immagazzinare tutte le nostre cose.\n\nInoltre dovremmo interrompere tutte le produzioni non necessarie affinchè i nostri magazzini non si riempiano inutilmente.\n\nSarebbe saggio costruire un nuovo magazzino.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Costruisci un altro magazzino in città.";
"T_GAME_QUEST_SCEN9_19_DESC" = "I cittadini temono il sabotatore e sono troppo terrorizzati per uscire a riparare i loro edifici. Credo che avremo bisogno di un laboratorio di carpentiere per poter eseguire i lavori.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Costruisci un laboratorio di carpentiere.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Buon giorno mio signore. E' una bellissima giornata invernale. Abbiamo il lavoro assicurato per i mesi a venire.\n\nIniziando costruendo un paio di capanni per i taglialegna, d'accordo?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Costruisci qualche capanno di taglialegna.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Vengo da te con una richiesta, mio signore. Gli utensili sono molto richiesti in tutto il regno. Pagherei molto bene per un intero carico di strumenti. Inoltre ricomincerei a commerciare nella tua città.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Consegna un carico di utensili al mercante.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Ho delle notizie importanti, mio signore! Una banda di mercenari è arrivata, e ha già iniziato a lamentarsi per l'assenza di una taverna.\n\nSarebbe meglio evitare di avere una banda di mercenari insoddisfatti e annoiati in città. Costruiamo una taverna.";
"T_GAME_QUEST_SCEN9_2_NAME" = "Aumenta la soddisfazione per le taverne";
"T_GAME_QUEST_SCEN9_3_DESC" = "Governatore, sono lieto di comunicarti che il tuo impegno nella produzione di legname sta producendo i suoi frutti.\n\nOra, se fossi cosìè gentile da procedere alla prima consegna...";
"T_GAME_QUEST_SCEN9_3_NAME" = "Invia un tributo in legno al re.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Mio signore, corrono voci di disordini in città. E' possibile che qualche cittadino stia tramando contro la corona?\n\nSe non agiamo immediatamente potremmo trovarci alle prese con una ribellione. Dobbiamo fare in modo che i cittadini siano felici e soddistatti, e in fretta.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Mantieni un grado di soddisfazione superiore al 100% per i prossimi due minuti.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Mio signore, è inaudito! La taverna è stata distrutta! Si parla di un sabotatore in giro per la città.\n\nDobbiamo rimettere la situazione sotto controllo prima che ci sfugga di mano. Forche e gogne sono quello che ci vuole.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Costruisci una forca e due gogne in città.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Mio signore, sarebbe importante migliorare un po' il morale in città.\n\nMostrare un po' di gentilezza ai cittadini ne aumenterà la soddisfazione. Perché non costruire loro una chiesa o abbellire la città con dei giardini fioriti?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Costruisci dei giardini e una chiesa.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Governatore, mi spiace informarti che per il momento non sono in grado di fare visita alla tua città.\nHo saputo che ci sono banditi nei boschi circostanti. Per i mercanti è troppo pericoloso viaggiare.\n\nMa ho un messaggio da parte del re. Egli ordina la costruzione di due segherie.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Costruisci 2 segherie.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Mio signore, ho un'idea. Dobbiamo costruire una tesoreria. L'esattore potrà fare visita a tutte le case della città... e magari raccogliere informazioni a proposito di questo sabotatore.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Costruisci una tesoreria e aspetta che l'esattore faccia visita a tutte le case.";
"T_GAME_QUEST_SCEN9_9_DESC" = "Il sabotatore ha distrutto la segheria! Inoltre, l'esattore non è ancora riuscito a scoprirne l'identità, mio signore.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Non hai impedito i disordini in tempo!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Hai fallito! A causa della tua incompetenza ho dovuto procurarmi il mio oro in un'altra citta!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Governatore, presto ordinerò la costruzione di una nuova, grande flotta di navi da guerra.\n\nLa tua città ha il potenziale per diventare la mia maggior fornitrice di legname per questa monumentale impresa. Fai in modo che sia così.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Il mercenario e la sua banda hanno abbandonato la regione. I miei uomini li inseguiranno senza tregua.\n\nVorrei anche ringraziarti per il supporto nella costruzione della nuova flotta e invitarti al viaggio inaugurale della nave ammiraglia. Fino ad allora, ti auguro una buona giornata...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Sostieni l'impresa del Re.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Molto bene! Sei riuscito a impedire i disordini in città!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Molto bene! Hai consegnato appena in tempo!";
"T_GAME_QUEST_SCEN_10_DESC" = "I nostri cavalieri troveranno sollazzo nelle locali taverne quando il torneo sarà terminato! Ma non abbiamo né taverne né succo d'uva a sufficienza! Occupati immediatamente di questo problema!";
"T_GAME_QUEST_SCEN_10_NAME" = "Costruisci una taverna e produci succo a sufficienza.";
"T_GAME_QUEST_SCEN_11_DESC" = "Eccellente, Siniscalco! La città è pronta ma io e le mie figlie no! Ho bisogno degli abiti più eleganti che i tuoi sarti sappiano creare!";
"T_GAME_QUEST_SCEN_11_NAME" = "Paga un tributo di 35 abiti.";
"T_GAME_QUEST_SCEN_12_DESC" = "Siamo vicini all'inaugurazione del torneo, ma non voglio vedere facce tristi in città! Fai in modo che i paesani siano contenti!";
"T_GAME_QUEST_SCEN_12_NAME" = "Aumenta la felicità.";
"T_GAME_QUEST_SCEN_1_DESC" = "Benvenuto, mio buon Siniscalco! Come saprai, sto progettando di organizzare la più grande giostra della regione! Mi aspetto che per questo evento tu costruisca almeno 3 percorsi per giostre! Non mi deludere!";
"T_GAME_QUEST_SCEN_1_NAME" = "Costruisci 3 percorsi per giostre.";
"T_GAME_QUEST_SCEN_2_DESC" = "Gli ospiti del torneo saranno affamati! Voglio che cominci immediatamente a produrre pane e consegnarlo quale tributo al tuo re!";
"T_GAME_QUEST_SCEN_2_NAME" = "Consegna un tributo di 25 filoni di pane.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Costruisci un mulino e produci farina.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Costruisci 2 forni e produci del pane.";
"T_GAME_QUEST_SCEN_3_DESC" = "Mio signore, non dovremmo far aspettare il re! Ci serve grano e farina per avviare la produzione di pane!";
"T_GAME_QUEST_SCEN_3_NAME" = "Costruisci una fattoria e produci grano.";
"T_GAME_QUEST_SCEN_4_DESC" = "Molto bene, mio buon Siniscalco! Ma il solo pane non sarà sufficiente per soddisfare i nostri ospiti! Esigo pesce fresco come tributo al tuo re!";
"T_GAME_QUEST_SCEN_4_NAME" = "Consegna un tributo di 25 pesci.";
"T_GAME_QUEST_SCEN_5_DESC" = "Voglio che questo torneo sia indimenticabile! I nostri cavalieri dovranno imbracciare lance d'oro e le nostre giostre dovranno luccicare al sole! Per favore, riscuoti tasse per il tuo re!";
"T_GAME_QUEST_SCEN_5_NAME" = "Paga un tributo di 1000 talleri.";
"T_GAME_QUEST_SCEN_6_DESC" = "Sono certo che i nostri ospiti apprezzeranno il delizioso sapore del nostro succo d'uva fresco! Vai e costruisci delle manifatture di succo! Il prodotto di qualità inferiore puoi farlo servire nelle taverne locali!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Sono sicuro che i nostri ospiti apprezzeranno il delizioso gusto del nostro succo d’uva appena spremuto!";
"T_GAME_QUEST_SCEN_6_NAME" = "Costruisci una manifattura di succo e produci del succo.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Costruisci una bottega di tessitore e produci stoffa.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Costruisci una sartoria e produci abiti.";
"T_GAME_QUEST_SCEN_7_DESC" = "I tabarri dei nostri cavalieri sono vecchi e consunti, e questo mi disturba la vista, Siniscalco! Procuratene dei nuovi! Costruisci dei pascoli per le pecore, assumi un tessitore e un sarto, se vuoi mantenere il tuo impiego!";
"T_GAME_QUEST_SCEN_7_NAME" = "Costruisci 2 pascoli per pecore.";
"T_GAME_QUEST_SCEN_8_DESC" = "Dovremmo vendere più merce per denaro, mio signore. È sempre una buona idea tenere dei talleri a disposizione per coprire future possibili spese.";
"T_GAME_QUEST_SCEN_8_NAME" = "Guadagna 500 talleri commerciando.";
"T_GAME_QUEST_SCEN_9_DESC" = "Vedo che le cose procedono bene, ma la tua città è ancora squallida! Voglio vedere fontane e bianchi muri di pietra e alberi sempreverdi e magnifiche statue! Devi abbellire la città con più decorazioni!";
"T_GAME_QUEST_SCEN_9_NAME" = "Aumenta la felicità mediante decorazioni.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "All’inizio è consigliabile assegnare un lavoratore ad uno dei capanni dei taglialegna della zona.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Assegna un lavoratore al capanno del taglialegna.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Uno dei compiti principali è costruire un mercato.\nPer completare questo compito, dovrai stabilire diverse catene di produzione risorse e raccogliere le necessarie risorse, mio signore.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Costruisci un mercato.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Mio signore, consiglio di assegnare un cittadino alla segheria per produrre assi di legno il più presto possibile.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Assegna un lavoratore alla segheria.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Mio signore, suggerisco di concentrarsi sulla produzione di pietre anziché di metalli.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Appena avrai accumulato assi e legno, dovrai assegnare un lavoratore alla miniera e iniziare a scavare pietre.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Molto bene, mio signore. Ora dobbiamo solo attendere che il mercato venga costruito.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Assegna un lavoratore alla miniera.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Il tuo secondo compito primario è costruire una taverna.\n\nDobbiamo cominciare la costruzione immediatamente.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Costruisci una taverna";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Buone notizie, mio signore. Alcuni cittadini sono arrivati per darci una mano nei nostri compiti. Dovremmo costruire loro un municipio.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Costruisci un municipio.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Ci serve un laboratorio di utensileria per costruire la taverna. Consiglio di cominciare costruendo una fornace a carbone.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Costruisci una fornace a carbone.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Il prossimo edificio che ci occorre è una fonderia, così da poter iniziare la produzione di sbarre di ferro.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Costruisci una fonderia.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Mio signore! Per iniziare la produzione di attrezzi ci occorre un laboratorio di utensileria in città.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Costruisci un laboratorio di utensileria.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Le scorte di cibo si stanno assottigliando, mio signore. Dovresti davvero ordinare a un cittadino di andare a caccia o  a pesca.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Produci del cibo.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Mio signore, come umile mercante sono al tuo servizio. Vedo che hai bisogno di denaro per i tuoi progetti edilizi.\nSe vuoi posso comprarti del minerale di metallo.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Scambia qualche merce con il mercante.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Hai esaurito i fondi, mio signore? Nessun problema: ti comprerò qualche pelle di animale.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Governatore, ho bisogno di pepite d’oro. Vuoi vendermene qualcuna?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Mio signore, non mi sento molto bene. Dovrei farmi vedere da un dottore.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Cura i cittadini malati.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Fuoco! Un cittadino deve spegnere l’incendio immediatamente.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Spegni l’incendio.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "I banditi ci infastidiscono perfino qui. Mio signore, dovremmo assegnare qualche cittadino alle torri di guardia fino a che l’assalto non verrà respinto.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Difendi la città dai banditi.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Mio signore, possiamo riposarci e fare una merenda?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Produci del pane.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Mio signore, abbiamo solo un pugno di cittadini per questa sfida. Dovremo modificare le loro assegnazioni a seconda delle necessità.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Congratulazioni. Hai completato questa sfida.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Usa i cittadini saggiamente per completare tutti i compiti.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Buone notizie, mio signore! Gli alberi stanno già ricrescendo sulla penisola accanto al castello.\n\nConsiglio di costruire laggiù capanni per taglialegna per procurarci il legname più facilmente.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Mio signore, i capanni dei taglialegna sono abbandonati e semidistrutti!\n\nGli alberi in questa regione sono stati tutti abbattuti. I capanni non sono più di nessuna utilità.\nTi consiglio di distruggere gli edifici non più necessari per recuperare un po’ di legname.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Demolisci i capanni dei taglialegna.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Mio signore, credo che dovresti chiedere agli abitanti di questo villaggio. Potrebbero avere delle rimanenze di legname.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Il re attende la prima consegna di assi.\n\nPotremmo assegnare un cittadino alla segheria e iniziare a produrre assi. Ti suggerisco di tenere d’occhio la scorta di legno. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Assegna un cittadino alla segheria.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Come sta andando, governatore? Mi aspetto un totale di tre consegne.\n\nDevi preparare la prima consegna al più presto. Non mi deludere!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Consegna le risorse al re.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Mio signore, il re è rimasto soddisfatto dalla prima consegna di assi.\nDobbiamo preparare la seconda al più presto possibile.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Il re attende l’ultima consegna. Quando avrà ricevuto le assi, la Flotta Reale potrà essere ampliata considerevolmente.\n\nDobbiamo darci da fare.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Ti stai chiedendo perché il re non ha ancora ricevuto la consegna? Beh, credo di avere una risposta.\n\nPer farla breve: pagami un piccolo riscatto e la tua consegna raggiungerà il re senza ulteriori interruzioni.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Paga il riscatto.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Per la costruzione della flotta reale ho bisogno di moltissime assi.\nPurtroppo non arrivano nuove consegne da molto tempo.\n\nGovernatore, ho un compito per te! Scopri perché le consegne sono bloccate e risolvi il problema!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Bel lavoro, governatore. Sapevo di poter contare su di te.\n\nGrazie al tuo impegno, la flotta sarà presto pronta.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Metti fine alla carenza di legname e consegna una quantità sufficiente di assi al re.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Mio signore, ti suggerisco di usare il legno saggiamente.\n\nPotremmo costruire un mercato, così potremo acquistare il legname dai mercanti.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Hai bisogno di legname? Credo che potremmo raggiungere un accordo. Una piccola quantità di legno è già disponibile, se la vuoi.\n\nVieni e compra tutto quello che ti serve!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Acquista legname dai mercanti.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Mio signore, ti occorreranno consegne di legname regolari.\n\nSe costruirai una Gilda dei mercanti, potrai piazzare degli ordini.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Acquista una Gilda dei mercanti.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Presso la Gilda dei mercanti puoi effettuare ordini di acquisto e di vendita.\n\nEffettua un ordine di legname, mio signore.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Eccellente! Finché avrai denaro per pagare, consegnerò tutti i tuoi ordini.\n\nI tuoi ordini di acquisto verranno gestiti finché non li annullerai.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Piazza un ordine per l’acquisto di legname.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "È scoppiato un incendio in città! Dobbiamo costruire abbastanza torri dei pompieri per estinguere le fiamme e ridurre il rischio di nuovi incendi.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Raggiungi una copertura antincendio dell’80%.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Banditi! Vogliono distruggere i nostri edifici. Ci servono altri soldati in città per scacciare i banditi, e dobbiamo costruire altre torri di guardia.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Costruisci abbastanza torri di guardia e metti in sicurezza la città con un numero sufficiente di soldati.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Un’altra epidemia! Una città così grande necessita di un’altra infermeria.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Un’altra epidemia! Una città così grande necessita di un’altra infermeria.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Costruisci un'infermeria e cura l’epidemia.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Mio signore, non tutti i cittadini possono visitare la chiesa perché è sempre piena.\n\nCi occorrono più chiese per soddisfare tutti.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Mio signore, i cittadini devono attendere troppo per le loro consumazioni. Ci servono più taverne e dobbiamo aumentare la produzione di succo e birra.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Non ci sono divertimenti in questa città. Dobbiamo costruire un percorso per giostra.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "I cittadini sono soddisfatti. Ma ora chiedono beni di lusso.\n\nPotremmo fornire loro abiti o gioielli.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Alcuni cittadini si lamentano perché il mercato è troppo affollato.\n\nDobbiamo costruire un nuovo mercato o ampliare quello esistente. Altrimenti i cittadini insoddisfatti lasceranno la città.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Mi hai deluso, governatore. È un vero peccato che tu non abbia saputo eseguire i miei compiti.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Eccellente, governatore; hai eseguito tutti i miei compiti senza che nessun cittadino abbandonasse la città.\n\nRaddoppierò la tua ricompensa.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Governatore, alcuni cittadini se ne sono andati. Mi aspettavo di più da te.\n\nMa almeno sei riuscito ad eseguire tutti i miei compiti. Ti sei meritato la ricompensa.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Mio signore, dobbiamo far stabilire più cittadini nella nostra città, o il re si arrabbierà molto.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Oh no, mio signore. Molti cittadini hanno già lasciato la città. Non possiamo permettere che altri se ne vadano.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Incrementa la popolazione.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Signore, alcuni cittadini hanno già lasciato la città. Dobbiamo prenderci maggior cura di loro, altrimenti se ne andranno tutti.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Governatore, molti cittadini si sono trasferiti in questa piccola città.\n\nSoddisfa tutti i loro bisogni per scoraggiarli dall’abbandonarla di nuovo. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Aumenta la popolazione prima che scada il tempo.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Completa tutti i compiti prima dell’arrivo del re, e mantieni la popolazione sopra le 150 unità.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "I trasportatori di questa città sono sovraccarichi di lavoro, mio signore. Dobbiamo costruire un altro magazzino e assegnare nuovi cittadini trasportatori.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Costruisci un nuovo magazzino e assegna nuovi trasportatori al castello.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Siamo a corto di cibo. Costruiamo un nuovo capanno per pescatori. Dovrebbe funzionare.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Mio signore, il piccolo forno non produce pane a sufficienza. Possiamo ampliarlo e assegnarvi un altro fornaio.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Amplia un forno al livello 2 e assegna un altro fornaio.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Il bisogno di acqua è aumentato significativamente. Possiamo fornire acqua a tutti i cittadini costruendo abbastanza pozzi.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Costruisci diversi pozzi in città.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Mio signore, dobbiamo aumentare le scorte di cibo. Un nuovo capanno da caccia o un macellaio sono esattamente ciò che ci serve.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Costruisci un macellaio o un capanno del cacciatore.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Eccellente, mio signore. Abbiamo stabilito una buona fornitura. Ma dobbiamo comunque tenere d’occhio i desideri dei nostri cittadini.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Mio signore, prima di tutto dobbiamo raccogliere materiale da costruzione e assegnare un cittadino al capanno del taglialegna oltre il fiume.\n\nCostruisci una strada di ciottoli che attraversi il fiume affinché il taglialegna possa iniziare il suo lavoro.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Costruisci una strada di ciottoli che attraversi il fiume e assegna un cittadino al capanno del taglialegna.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Costruisci una strada che attraversi il fiume e assegna un cittadino al capanno del taglialegna.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Trasferirmi qui è stato il mio più grande errore. Me ne vado!\n\nSignore, dovresti davvero soddisfare i nostri desideri, altrimenti sempre più persone se ne andranno.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "No, grazie.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Ottima idea.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Pensavo che la vostra fosse una mentalità progressista... Bene, rimanete nella vostra mediocrità, allora.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, comincia a prendere forma. Dobbiamo continuare a lavorare sodo e impostare il resto della produzione.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Dominiamo il mercato dei tessili per la casa e dell'alta moda! Faremo una fortuna!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Ora che la materia prima è disponibile, sono necessari i rispettivi edifici. Un tessitore e un sarto saranno sufficienti!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "In seguito alla vostra decisione, il villaggio subirà grossi cambiamenti. Ma nulla sarà possibile senza... pecore, e una fattoria in buone condizioni.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Sire, sono di ritorno dalla città vicina. Là ci sono bellissimi tessuti e splendidi ricami. Dovremmo prendere ispirazione da loro e produrre anche noi vestiti così belli.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Fiori di seta";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "La stagione dei pollini è tornata, gli abitanti starnutiscono di continuo. E se facessimo una gara di starnuti?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Ognuno di loro si concentra ed esegue il suo starnuto più potente durante il proprio turno. Devi scegliere qual è il tuo preferito, in modo che lui o lei ottenga la vittoria!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "ECCÌ!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "ETCIÙ!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "BRRRETCIÙ!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "Ed ecco a chi va la vittoria! Lo starnuto più riuscito! Congratulazioni! È stato notevole!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Il cittadino è fiero della sua ricompensa. Questo concorso non ti ha fruttato molto, ma forse la tua città diventerà famosa per aver iniziato la prima gara di starnuti della storia!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Proprio no.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Dal castello si sente già la folla che si raduna nella piazza del paese e si sentono anche un po' di starnuti. La gara si preannuncia molto divertente!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Numerosi cittadini aspettano in coda e trattengono i loro starnuti per liberare tutta la loro potenza quando passano davanti alla giuria, che è composta da te e dal tuo consigliere.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Giudichi un cittadino dopo l'altro, e ti sei annotato tre nomi in particolare. Passi la lista al tuo consigliere, che la porta al centro della piazza del villaggio per la finale della gara di starnuti!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Decidi di spargere la voce che nel villaggio si sta organizzando una competizione. Il cittadino che viene giudicato il migliore riceverà una ricompensa!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Sire, mentre aspettiamo che i cittadini si riuniscano in piazza, dobbiamo preparare i festeggiamenti! Cominciamo con un po' di decorazioni.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Decora la città.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Questo rende la nostra città molto più affascinante.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Dovremmo anche controllare le nostre scorte.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Perfetto, durante i festeggiamenti non ci mancherà nulla.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "Il concorso di starnuti";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Facciamola!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Hai ragione, costruiamo delle statue.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "No... Non voglio statue nella mia città.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Ottimo lavoro signore, queste sculture danno un fascino particolare alla nostra città.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ah signore, un giorno forse vi preoccuperete di questo tipo di dettagli.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Signore, la nostra città è molto carente di statue, che ne dite di aggiungerne qualcuna? Inoltre, si crede che le statue proteggano gli abitanti.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Angeli duri come la roccia";
"T_GAME_QUEST_SUCCESS" = "Missione completata!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "È una nobile intenzione, lascialo fare.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Che persona strana.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Signore, dobbiamo dare un freno questo cittadino. Costruiamo una carovana di giocolieri e mettiamo questo pazzo a capo dell'intrattenimento.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Eccellente, la popolazione sembra contenta di come si è conclusa la faccenda.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Osservi il villaggio in lontananza.\n\nIl cacciatore di lacrime sta ancora inseguendo i cittadini, e sempre più persone si rifiutano di uscire di casa.\n\nTi allontani lentamente dalla finestra in modo da non assistere più ai danni causati dalla tua scelta.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Forse avresti dovuto fare qualcosa... Questo strano cittadino terrorizza gli abitanti e il morale non fa che abbassarsi. Speriamo che non duri!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Governatore, mi è stato detto stamattina che uno degli abitanti del villaggio si è messo in testa di rendere tutti felici. Ha cominciato a inseguire gli abitanti e li costringe a ridere...";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "Il cacciatore di lacrime";
"T_GAME_QUEST_THE_BATH_B_001" = "Ci siamo andati vicini. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Proclamiamo ora che il bagno è obbligatorio: questo ridurrà le malattie!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Bagni facoltativi.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "Non imparerete mai dai vostri errori!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Sire, è stata segnalata un'altra epidemia, questa volta molto più grave della precedente.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Questa volta, sire, che vi piaccia o no, dichiaro i bagni obbligatori!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Il tuo consigliere ha salvato molte persone dalla malattia, ed è riuscito persino a entrare nei libri di storia. Tuttavia, tu sei quello che ha rifiutato i bagni, e centinaia di bambini, anche dopo molti anni, ti amano per questo, perché, cito: "Fare il bagno è davvero terribile". ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Bagni obbligatori!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "È molto saggio, sire. Ora abbiamo una riduzione dell'incidenza delle malattie.";
"T_GAME_QUEST_THE_BATH_DESC" = "Qualche giorno fa avete fatto installare dei bagni pubblici nella vostra città. Anche se è stata un'ottima idea, i cittadini hanno paura dell'acqua e non osano lavarsi. \n\nCosa dobbiamo fare?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Riscalda l'acqua.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Conserviamo legna a sufficienza per poter riscaldare l'acqua per i bagni.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "È perfetto, l'acqua è a una temperatura piacevole e siamo riusciti a convincere alcuni residenti a lavarsi.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Purtroppo i tuoi sforzi sono stati vani e la malattia ha continuato a diffondersi nella città.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Lasciali stare.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Come volete. Se si verificano epidemie nel villaggio, è meglio che non veniate a piangere!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Per diversi mesi, pochi abitanti si sono lavati e quando uno dei nostri cittadini si è ammalato, ne ha contagiati altri tre! Alcuni erano addirittura convinti che la malattia venisse dai bagni.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Guarisci i cittadini.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Il momento del bagno";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Tangenti.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Sei andato dai religiosi e hai chiesto, in cambio di qualche moneta, che annuncino nel loro sermone che fare il bagno rende più belli.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Fornisci il denaro necessario.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Non resta che pagare l'importo ai religiosi, sire.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Grazie Governatore, diffonderò il vostro messaggio.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Sembra che i vostri sforzi siano stati ripagati: la malattia è meno virale e resterà così per qualche tempo!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Costringerli!";
"T_GAME_QUEST_THE_BATH_YES_002" = "Ci siamo! Che i nostri banditori annuncino questa buona notizia!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Non tutti gli abitanti del villaggio sono contenti all'idea di dover fare il bagno regolarmente. Alcuni dicono addirittura di sentirsi più deboli dopo essersi immersi.\n\nAltri dicono che l'acqua è troppo fredda e si rifiutano di fare il bagno.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Interroga il mago.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Mentre stai per interrogarlo, un fumo denso comincia a inghiottire tutto il dominio: non riesci a vedere nemmeno a un metro di distanza.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Ora ti trovi di fronte a un dilemma: consegnare le risorse necessarie o lasciare che la situazione degeneri, succeda quel che succeda. Devi agire in fretta, chissà di cosa sono capaci i due maghi in libertà.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Sire, abbiamo fallito, i maghi sono riusciti a prendere le nostre risorse e a scappare.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Dai le risorse.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Proviamo a fornire tutte le risorse a questo mago da strapazzo!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Siamo stati in grado di produrre tutte le risorse richieste, ora non ci resta che consegnare la merce nel luogo indicato.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "A insaputa del tuo consigliere, hai piazzato una trappola per i maghi: non appena verranno a ritirare la merce, saranno immediatamente catturati da una rete! Speriamo che la tua ingegnosa idea sia efficace.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Sire, siamo riusciti a catturare un secondo mago!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Hai due guardie appostate vicino alle risorse. Gli altri due maghi arrivano e si avvicinano lentamente per prenderle. Quando sono a metà strada, le tue guardie fanno scattare la trappola.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Non cedere.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Dunque, volete provocare la rabbia dei miei fratelli. Non vorrei essere nei vostri panni, Governatore.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "L'uomo per cui lavoriamo ve la farà pagare!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Ah, finalmente ammettete di essere agli ordini di qualcuno! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "Il mago si morde il labbro, in un gesto di rammarico per aver parlato troppo in fretta. Quindi è stato mandato da qualcuno che è personalmente arrabbiato con te.\n\nPer quanto ti sforzi di capire chi possa essere, non ti viene in mente nessun nome.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Il tuo consigliere arriva di corsa, e sembra in preda al panico: "Sire, ci sono dei maghi alla nostra porta! Ci chiedono ospitalità per qualche giorno. Dobbiamo accettare?".";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Governatore... Si tratta di uno sfortunato malinteso. Io e i miei fratelli non volevamo causarvi così tanti problemi.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Quindi sono i vostri fratelli. Perché avete appiccato gli incendi?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Non volevamo, sire. Siamo un po' maldestri, ecco tutto...";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Per chi lavorate? Per i banditi?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "Assolutamente no! Tuttavia, se volete sbarazzarvi del fumo denso che sta gradualmente inghiottendo tutto il vostro territorio, fareste meglio ad accogliere la mia richiesta.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "E qual è questa richiesta? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Vorrei che mi deste risorse e denaro!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "E poi che altro? Diteci dove trovare i vostri fratelli!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Se vi rifiutate, aspettatevi altri disastri.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Sire, questa persona che ha ingaggiato i maghi non potrebbe essere il duca di Cannes? Mi ricordo improvvisamente che vi ha minacciato quando avete iniziato a scrivere lettere alla regina Frygith.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Il tuo consigliere non ha torto; ti ricordi solo ora che il duca di Cannes aveva chiesto in sposa la regina Frygith, ma dopo il vostro incontro e quel famoso ballo lei aveva rifiutato le sue avances.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Siete un mago da quattro soldi! Così il duca di Cannes è il vostro datore di lavoro! Sappiamo tutto!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "Infatti... Avete indovinato. Facciamo un accordo. Datemi una buona somma di denaro e io e i miei fratelli vi lasceremo in pace. Non vi disturberemo più.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Sire, non siamo in grado di negoziare. Diamogli la cifra che chiede e facciamola finita con questa storia della magia. Non possiamo combattere i disastri soprannaturali.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Anche se non ti piace essere messo sotto pressione, devi ammettere che il tuo consigliere ha ragione: il benessere dei cittadini è più importante del tuo ego.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Tutto quello che dobbiamo fare ora è liberare il mago e pagarlo.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Felice di aver fatto affari con voi, Governatore!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "Il mago è sparito con un bel gruzzolo, ma tu non hai più avuto a che fare con tutti loro.\n\nPer quanto riguarda il duca di Cannes, hai mandato una lettera alla regina, che ha promesso di occuparsi personalmente del caso. Tutto è bene quel che finisce bene.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Dopo essere rinsavito e aver salvato la tua città dalle fiamme, chiedi alla guardia di convocare i tre maghi. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "I tuoi soldati ti dicono che sono riusciti a trovare solo uno dei tre maghi. \n\nGli altri due sono scomparsi.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Sire! State bene? I maghi hanno fatto esplodere degli edifici! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Dobbiamo estinguere i fuochi il prima possibile!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "L'ultimo degli incendi è ora sotto controllo, sire.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "I maghi sono tre, e sembrano sollevati dal fatto che tu abbia risposto positivamente alla loro richiesta. Offri loro una stanza alla locanda. Ora che non hanno più bisogno di nulla, torni ai tuoi compiti di Governatore.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Appena usciti dalla locanda, si sente un enorme botto: BOOOOOOOOOOOOOM! Ora diversi edifici sono in fiamme!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Nega l'ingresso.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "Oh, no! Abbiamo un'epidemia di peste e diversi edifici che hanno preso fuoco! Probabilmente è un trucco dei maghi!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Ah ah ah ah ah ah!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Sbrighiamoci a curare i cittadini e a spegnere gli incendi!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Ancora una volta, abbiamo scampato un vero disastro...";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Continua le ricerche.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Continuiamo le ricerche, sire!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "Eccone uno! Prendetelo!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Le tue guardie iniziano a inseguire il secondo mago, quando improvvisamente un fumo denso copre il villaggio. Le tue guardie interrompono l'inseguimento, non vedendo più dove stanno andando.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Sire, siamo di fronte a un nuovo problema! Non riusciamo più muoverci velocemente! È come se camminassimo nella gelatina!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Dovremmo ritirarci nel castello e interrogare il mago che siamo riusciti a catturare.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Seguendo il consiglio, decidi di barricarti nel parco del castello, per iniziare l'interrogatorio del primo mago. Inoltre, chiedi al capo delle guardie di mettere in sicurezza il castello, in modo che nessuno possa entrare o uscire.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Decidi di tenere i due maghi lontani l'uno dall'altro e di interrogare il mago che sei riuscito a catturare grazie alla tua incredibile trappola.\n\nPurtroppo non sei riuscito a recuperare le risorse, il terzo mago le ha portate con sé.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "Il secondo mago sembra molto più sicuro del primo e senza esitare ti dice: "Congratulazioni Governatore, mi avete preso con le mani nel sacco, ma sappiate che se non mi liberate subito, al vostro villaggio accadranno cose terribili".";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Liberalo.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Hai troppa paura di quello che potrebbe passare il tuo villaggio e decidi di liberarlo.\n\n"Siete furbo, Governatore", dice il mago, prima di scomparire in un alone di fumo nel momento stesso in cui le guardie rimuovono le catene.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Sire, anche il primo mago è fuggito! Suo fratello è apparso accanto a lui e poi sono scomparsi entrambi!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "Siamo di nuovo al punto di partenza.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "Faremo la ronda per acchiappare questi furfanti, sire! Potete fidarvi di noi.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Non ci resta che aspettare il ritorno delle pattuglie, sire.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Per molto tempo, le tue guardie hanno cercato di trovare i maghi, finora senza successo. Tuttavia, giorno dopo giorno, la città ha visto la strana nuvola di fumo che rallentava tutti dissiparsi lentamente.\n\nIl mistero che circonda questi maghi rimarrà irrisolto.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Tienilo prigioniero.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "I maghi";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Falli entrare.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Blu.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Verde.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Una scelta audace, devo dire. Il blu. Chi potrebbe odiare un colore così bello? Il colore dei sogni, della saggezza e della lealtà. Questo dice molto di voi, Governatore.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Abbiamo ricevuto un ospite nella sala del castello ristrutturata, sire.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Sfortunatamente, i colori della stanza lo hanno tenuto sveglio e lui vi ritiene completamente responsabile.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Oh sire, il nostro ospite è rimasto estasiato da questa stanza. Gli è piaciuto particolarmente il colore! Ha deciso di darci un po' di prestigio.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "È vero che il verde si dice che porti sventura, ma è anche un simbolo di speranza e stabilità. Ed è in armonia con tutti gli altri colori della natura. Devo dire che è una buona scelta.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Governatore, abbiamo appena ristrutturato una delle stanze del castello. Che colore preferite?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "La stanza";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Certo che no.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Invia delle spie.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "La magia non esiste.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Convoca la strega.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Sire, è tremendo. Com'è possibile? Potrebbe essere uno stregone esperto di magia nera? Nessuno dovrebbe avere tali poteri!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "È una saggia decisione. Mandiamo le nostre migliori spie a seguire questo cittadino pazzo e aspettiamo il loro rapporto.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Le tue spie sono tornate con un rapporto.\n\n"Abbiamo seguito questo cittadino, il ladro di gioia. Sembra che la sua parola scateni una grande tristezza negli abitanti. I cittadini non ricordano più i momenti gioiosi della loro vita".";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Sire, uno dei nostri abitanti sembra rubare la gioia ai suoi compagni. \n\nDiversi cittadini hanno sporto denuncia contro questo ladro. Ecco la testimonianza di una delle vittime: "È venuto a parlarmi una mattina. L'ho ascoltato attentamente e improvvisamente ho sentito molta tristezza, come se le sue parole stessero consumando la mia gioia".";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Sire, dobbiamo fare qualcosa per risolvere questo problema?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Governatore, cosa dobbiamo fare?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Aiuta la strega.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "I fantasmi non esistono!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Le misure che abbiamo preso sembrano funzionare, sire. \n\nIl ladro di gioia continua a perpetrare i suoi misfatti, ma ora noi lo combatteremo. \n\nDobbiamo mandare le guardie e consegnarlo alla giustizia per le sue azioni? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Sia fatta giustizia.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Non fare nulla.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Sei una persona ragionevole. Solo la scienza può spiegare e risolvere questo problema del ladro di gioia.\n\nChiami i tuoi migliori scienziati per lavorare ad una formula che permetta ai cittadini di essere di nuovo felici.\n\nNaturalmente, la scienza non è gratuita. Gli scienziati chiedono molti soldi. L'alternativa è dire addio alla felicità.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Questo problema del ladro di gioia non ti ha allarmato abbastanza. Tuttavia, i casi di cittadini depressi continuano ad aumentare drasticamente.\n\nDisorientato, sei andato a rifugiarti nel tuo castello, non sapendo cosa fare per risolvere questo disastro. Dicono che il tempo guarisca tutte le ferite. \n\nSperiamo che la tua pazienza non si stia esaurendo.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "La strega se n'è andata. Alcuni dicono che abbia persino lasciato il villaggio, non volendo soffrire come tutti gli altri a causa tua.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Poco dopo che se n'è andata, la situazione è diventata insopportabile. Tutti gli abitanti del villaggio sono sopraffatti da una profonda tristezza.\n\nChissà quanto durerà!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Mandiamo le guardie!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Le tue guardie hanno cercato per ore e ore, ma niente. Al ritorno, erano tutti tristi e depressi. Dicono di aver sentito il ladro di gioia, ma in realtà non l'ha visto nessuno.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Poco dopo il ritorno delle guardie, è arrivato un gufo con un messaggio della strega.\n\nElla ha rivelato che il ladro di gioia non è altro che un fantasma che si nutre della gioia del popolo, lasciandolo con nient'altro che tristezza e disperazione. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Nonostante gli sforzi dei tuoi scienziati per ritardare il processo, l'intero villaggio è rimasto insoddisfatto. Con la scomparsa della strega, non ti è rimasta alcuna alternativa per difendervi da questo fantasma. \n\nSperiamo che il tempo guarisca i cittadini.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "Il tempo è passato e il villaggio è tornato al suo buon umore. Questo ladro di gioia non è ormai che un lontano ricordo.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Chiedi consiglio alla strega.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Negozia.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Sire, cercherò di negoziare con questi scienziati. Lasciate fare a me, penserò a tutto io!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Il tuo consigliere, da bravo negoziatore, è riuscito ad abbassare il prezzo chiesto dagli scienziati! Ben fatto. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Ahi, il tuo consigliere non è stato in grado di negoziare correttamente. Gli scienziati hanno ora aumentato i loro prezzi e non vogliono più discutere con te.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Paga gli scienziati.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Se dobbiamo pagare, allora paghiamo, perché se continuiamo ad aspettare, sarà la nostra rovina.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "I vostri abitanti soffrono semplicemente di depressione, Governatore. Non riescono a vedere il lato positivo di nulla. \n\nLa soluzione è mostrare loro le cose belle della vita e dimostrare che non è poi così brutta. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Cominciamo ad aggiungere delle decorazioni e a preparare la festa della cervesia. La musica solleva il morale. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "La città comincia a sentirsi meglio. Alcuni abitanti, la cui gioia era scomparsa, sembrano riprendere coscienza delle piccole gioie della vita.\n\nTuttavia, il ladro di gioia continua a instillare la tristezza nel cuore della gente.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Ladro di gioia";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Sono anni che non ricorriamo a questa strega, Governatore... Spero che questo non porti al nostro villaggio più tristezza di quanta non ne abbiamo già.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Buongiorno, Governatore. È un piacere rivedervi. Quindi siete nei guai?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Dopo aver spiegato la situazione alla strega, lei si limita a sorridere. Ha trovato la soluzione alle tue preoccupazioni o ti sta facendo un brutto scherzo?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Allora parlate! Perché sorridete in quel modo? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Il vostro ladro di gioia non esiste, sire.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Ma deve essere vero, una delle nostre spie ha subito le conseguenze dell'aver parlato con lui!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "Ha semplicemente visto un fantasma della tristezza. Appare occasionalmente dopo la costruzione di un istituto religioso. Sono spiriti che si nutrono della gioia delle persone. \n\nAssorbendo la gioia, il fantasma guadagna forza e i suoi poteri aumentano. Purtroppo, la gioia non viene restituita alle persone a cui l'ha rubata.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "Come possiamo liberarcene?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Conosco una soluzione. Tuttavia, avrei bisogno del vostro aiuto.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Vi aiuteremo, di cosa avete bisogno?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Abbiamo bisogno di un mausoleo e di lapidi.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "Consideratelo fatto!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Abbiamo completato la vostra missione, strega. Ora mostrateci cosa sapete fare.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "La strega si dirige verso il mausoleo e scompare all'interno. Si sentono incantesimi. Improvvisamente si alza il vento, sembra che si stia preparando una terribile tempesta.\n\nLa strega non esce ancora dal mausoleo. \n\nPoi provi all'improvviso una grande tristezza. Hai molto freddo e sei circondato dall'oscurità.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Poi, in lontananza, un raggio di sole. Un piccolissimo raggio di sole. Ti concentri su di esso. Diventa sempre più intenso. \n\nIl raggio di sole sembra prendere la forma di un ricordo. Uno dei tuoi, il più felice.\n\nTi senti di nuovo bene.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Governatore... Cos'è stato? L'avete sentito anche voi?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Sire, ora siete libero dal fantasma della tristezza. Dalla vostra faccia, immagino che lo abbiate incontrato. Ora è finita, è in trappola.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "È stato terribile! Grazie mille!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "Il villaggio si è liberato di questo strano fantasma, gli abitanti hanno ritrovato la loro gioia e ti sono grati.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Sire, se non mi aiutate in questo piano contro il fantasma, vi posso assicurare che sarà la vostra rovina.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "Così sia! Sparite dalla mia vista con la vostra malvagia stregoneria!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Lasciali giocare.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Voglio giocare!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Un festival dei giochi da tavolo?! Che strana idea, signore. Come faremo? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Signore, i nostri soldati giocano così tanto nelle loro torri di guardia che gli abitanti non si sentono affatto protetti. Cosa dobbiamo fare?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "I giochi della torre";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Servono legno e pietre.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Ci servono idee per i giochi e autori.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Con una piccola donazione potremmo migliorare la nostra reputazione presso il Re, mio signore.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Costruisci una torre di guardia entro il raggio d'azione di una caserma.";
"T_GAME_QUEST_WATER" = "Acqua";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Fai silenzio, ok?";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Cominciamo a costruire il pozzo per prevenire questo tipo di incidenti.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Oh signore, vi prego, i nostri raccolti sono in pericolo! Se non fate nulla, non avremo mai la possibilità di passare un inverno tranquillo.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "Il Governatore si è già espresso su questo argomento. Se continuate a venire al castello a piagnucolare, dovremo rinchiudervi. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "Presto ve ne pentirete!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "SIGNORE! I CAMPI! È terribile! Non cresce più niente, il caldo è stato così intenso che i nostri raccolti sono rovinati. Avreste dovuto fidarvi un po' di più di quel contadino... Ora è troppo tardi.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Affrettiamoci a costruire dei pozzi, signore.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "La costruzione dei pozzi è stata completata. Prevenire è meglio che curare! Il futuro ci dirà se abbiamo fatto bene ad ascoltare questo contadino.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Signore! I contadini mi hanno detto che un'ondata di caldo ha colpito i loro campi, TUTTAVIA, grazie alla costruzione dei pozzi, avete evitato un sacco di problemi.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Signore! Ho fatto un altro sogno premonitore! I campi erano in fiamme, non cresceva più niente e non c'era più acqua.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Premonizione";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Dalle una tisana per calmarsi. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Beh, a proposito di tisane... diffondiamo l'idea. Facciamo sapere alle città circostanti che l'acqua calda con le erbe, insieme a un bello slogan, sono fantastici.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Migliora difese!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Miglioriamo le difese militari, Governatore!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Abbiamo fatto un ottimo lavoro: "la tisana che ti fa dimenticare le pecore" è uno slogan originale...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Aspettiamo, ora... Per quanto ne sappiamo, potremmo aver sollevato tutto questo polverone per niente. Avremmo dovuto darle una tisana...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Nonostante le vostre aspettative e il miglioramento delle difese in caso di attacchi a sorpresa da parte dei banditi, questi non sono mai arrivati. Tuttavia, ora avete dei fantastici edifici militari da ammirare.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Oh no, signore. La vecchia signora lo sta facendo di nuovo! Sta gridando dai tetti che la strega della foresta si farà strada nel nostro villaggio e distruggerà tutto quello che troverà sul suo cammino.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "Il cammino della strega";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Ah sire! \n\nEra incredibile laggiù! Un lago immenso e stupefacente! \n\nLa donna era lì! L'ho rincorsa per un buon chilometro nelle gallerie delle miniere, prima di perderla di vista.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "E poi... quando pensavo di tornare a casa a mani vuote, ho visto migliaia di luci. Oh Sire, avreste dovuto vederlo, non ho mai visto niente del genere! \n\nMi ha raccontato dei suoi piani per scappare con tutto il bottino e iniziare una nuova vita altrove. Dalla morte di suo marito, ha avuto problemi a rimanere qui, per i troppi ricordi...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Sire, ora siamo pronti a entrare nelle miniere per trovare il bottino. Ci sono diverse croci indicate sulla mappa.\n\nDa dove cominciamo? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Nascondiglio a nord";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Nascondiglio a sud";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "Oh, SIRE! Siamo stati fortunati! La nostra squadra è riuscita a fuggire illesa. I tunnel sono crollati!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "Il risultato di questa prima spedizione è molto soddisfacente! La vostra gente è riuscita a tornare a casa sana e salva e con una parte del tesoro dei pirati come bonus.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Sire, ora siamo pronti ad entrare nelle miniere una seconda volta.\n\nQuale nascondiglio dobbiamo controllare?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Nascondiglio a est";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Nascondiglio a ovest";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "Un'incredibile opportunità ci viene offerta, sire! Ne siamo usciti vittoriosi due volte da questa caccia al tesoro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Stai studiando attentamente le piantine delle miniere. Puoi vedere la posizione di un lago sotterraneo, alimentato da un fiume che porta direttamente al mare. Un accesso molto utile per i pirati!\n\nTuttavia, questi tunnel non sono sicuri e rischiano di crollare da un momento all'altro.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "Buone notizie: mentre aiutavate questo fabbro, il vostro fidato consigliere è riuscito a ottenere le piantine delle miniere.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Metti in sicurezza la miniera.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Invia ricognitori alla miniera!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Investiamo nelle miniere per metterle in sicurezza, sire. Questo è un compito che richiede molte risorse da parte nostra, ma vi assicuro che non ve ne pentirete.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "Incredibile, sire! Siamo riusciti a mettere in sicurezza le miniere! I nostri primi ricognitori sono usciti in perlustrazione e hanno trovato la moglie del pirata!\nÈ riuscita a scappare, ma ha lasciato una mappa delle miniere con delle X su alcune zone. Credo che questi siano i luoghi dove è nascosto il tesoro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Ora non ci resta che pagare il tributo, sire.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Ricognitori, ricognitori... Non ne abbiamo 50! Lo farò da solo. Ma io, almeno, ho bisogno di determinate attrezzature, prima.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Va bene, sono pronto!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Il vostro consigliere è andato nelle miniere per scoprire qualcosa di più su questa donna.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Portatemi le attrezzature necessarie per il successo di questa missione.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Improvvisamente perdi la pazienza con questo fabbro e gli ordini di procurarsi l'attrezzatura il prima possibile, aggiungendo che il suo ordine urgente non ti riguarda e che non ti importa se va in bancarotta.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Io... ve la porterò il prima possibile, signore...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Siete stato scortese a rifiutarvi di aiutare questo fabbro. Dovete capire che deve lavorare per vivere e questa consegna sembrava essere molto importante per l'economia della vostra città. Spero che non ce l'abbia con noi.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Ahi, sire.... Avreste dovuto essere più cauto. Il fabbro ha detto a tutti come l'avete trattato. Diversi cittadini stanno protestando e il fabbro si rifiuta di tornare al castello.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Sire, non vedo alternative alla costruzione di una giostra, che distrarrà il popolo e gli permetterà di scaricare la tensione.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Gli abitanti sembrano essersi calmati, ma non abbiamo finito con la storia dei pirati!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Sire, la giostra è necessaria, altrimenti i cittadini non saranno né felici né produttivi. Questo sciopero farà perdere tempo prezioso per la questione del pirata e delle miniere.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Sire, mentre eravamo impegnati con la rivolta, la moglie del pirata ne ha approfittato per recuperare il bottino che si trovava nelle miniere. Ecco dov'era il tesoro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Le nostre spie hanno trovato un biglietto di questa donna che diceva di non sopportare più l'assenza del marito e che si sarebbe isolata per un po' su un'isola paradisiaca dove possiede un piccolo castello.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Sembra che abbiamo perso una bella somma di denaro, sire. Vedete dove ci portano le vostre decisioni affrettate? Comunque, ora possiamo voltare pagina su questo evento.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Costruiamo una giostra.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Vi sbagliate a prendere questo tipo di decisione alla leggera, sire. Chissà cosa avremmo scoperto!";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Pochi giorni dopo il tuo rifiuto di occuparti di questa lamentela, le miniere sono crollate. Il popolo ti ritiene responsabile di questo tragico evento.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "La tua gente comincia a dimenticare la tragedia delle miniere crollate, il tempo è passato e il morale è alto.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Non abbiamo potuto accedere ai luoghi indicati sulla mappa, sire. Non siamo riusciti a portare a casa alcun bottino. Ma siamo vivi, è questa la cosa più importante.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Nonostante il tuo fallimento, questa avventura ti ha portato un po' di prestigio. Chi avrebbe mai pensato che i pirati potessero nascondere tali tesori nelle tue miniere?\n\nPer ora, però, la tua carriera di cacciatore di tesori è finita.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Oh, Sire. Mi hanno detto che le gallerie delle miniere sono crollate! Siamo stati fortunati a poter tornare indietro due volte con i tesori.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Per una volta, decidi di organizzare un grande banchetto per i tuoi soldati, per ringraziarli gentilmente di averti portato questi tesori.\n\nQuesta storia dei pirati è ormai alle tue spalle. Chissà, forse un giorno troverai una mappa che ti porterà verso altri misteri.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "Il tesoro sarà presto tuo! \n\nDai l'ordine ai tuoi soldati di andare a cercare il tesoro e di riportartelo.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "Incredibile! Guardate tutto quello che abbiamo trovato in quelle miniere! Avete fatto bene a metterle in sicurezza prima di mandarvi la vostra gente. Una ricchezza incredibile! Le voci su questo pirata sono sempre state vere. Ora siamo ricchi!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Con le informazioni che abbiamo, non c'è molto che possiamo fare. Sarebbe saggio farsi consigliare da un esperto.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Convoca un minatore.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "È una buona idea, sire. Forse può darci una mappa delle miniere e aiutarci a capire meglio.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Sire, sono contento che mi abbiate chiesto di aiutarvi. Ho portato con me le piantine delle miniere, spero che questo vi aiuti.\n\nQueste gallerie sono vecchie e temo che crollino.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Convoca il fabbro.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Il fabbro saprà sicuramente fornirci informazioni sulle pietre che questa donna sta cercando di rompere.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Sire, abbiamo ricevuto diverse lamentele sulle miniere.\nUna donna ci va tutti i giorni, sposta le pietre, a volte le rompe, ma quello che è certo è che si spinge sempre più in là nelle gallerie.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Informati sulla donna.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "Non mi riguarda.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "I cittadini sono preoccupati; le gallerie non sono sicure e le miniere potrebbero crollare in qualsiasi momento.\n\nÈ nostro dovere verificare cosa c'è dietro a questa storia.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Spero che abbiate imparato la lezione!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Mentre il tuo consigliere è a caccia di indizi, sarebbe buona cosa che tu ti prendessi cura della tua città per un po', cercando di migliorare la vita del popolo.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "Eccomi di nuovo, sire! Ho pedinato quella donna, anche se non è stato facile.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Sembra che stia cercando un oggetto. L'ho vista rompere diverse pietre e guardare attentamente i detriti.\n\nSfortunatamente, non ho potuto seguirla per molto. Sembra conoscere le miniere come il palmo della sua mano!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Il tuo consigliere è tornato dalla sua missione con alcune novità.\nNel suo rapporto si legge che questa donna è diventata vedova da poco. \n\nSuo marito era un pirata molto famoso, si dice che possedesse il più grande tesoro di tutti i tempi e che lo abbia nascosto non lontano da qui.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Ho una teoria, sire. Penso che questa donna sia stata minacciata da altri pirati perché rivelasse esattamente dove si trova il tesoro!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Continua l'indagine.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Lascia perdere.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "La donna e le miniere";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "Il fabbro arriva in fretta. Le guardie lo hanno tirato fuori dalla sua fucina. Sembra preoccupato.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Signore, cosa posso fare per voi?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Al momento abbiamo una missione e ci serve la vostra esperienza.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Vi ascolto.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Il tuo consigliere spiega la situazione al fabbro.\n\nGli mostra anche le pietre rotte che è riuscito a raccogliere. Con la coda dell'occhio, noti che il fabbro sembra riconoscere questo tipo di pietra.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Santo cielo! Sono un sacco di geodi!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Geodi, dite? ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "Sono cristalli speciali, possono contenere tesori, e spesso possono essere molto preziosi.\n\nAlcuni pirati usavano codici basati sui geodi per ricordare dove fossero nascosti i loro tesori.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Ne ho alcuni nel mio laboratorio, posso mostrarvi come aprirli con lo strumento giusto.\n\nMa... ho una consegna importante e urgente da inviare e apprezzerei il vostro aiuto. In segno di gratitudine per le informazioni che vi ho fornito.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Rifiuta.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Accetta.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Devo produrre strumenti per i minatori, è un grosso ordine.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Questi sono i geodi. Guardate, vi faccio vedere. Con questo dispositivo, si possono aprire facilmente. Molto spesso non c'è niente di particolare, ma a volte ci si imbatte in pure meraviglie!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "CRR CRR CRR... CLING!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "Oh signore, guardate questo geode! È una cosa magnifica!";
