"BUILDING_UPGRADE_TAXBONUS" = "Bonus tasse";
"EVENT_WITCHHUNT_08_SUCCESS" = "Finalmente abbiamo un medico nel villaggio: può certamente aiutarci.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Aspetta che il medico ritorni dalla capitale.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Gli abitanti del villaggio sarebbero più felici se ci fosse un luogo comune dove potersi incontrare e bere un bel boccale di succo d'uva o di birra dopo una dura giornata di lavoro. Sarebbe troppo da chiedere, mio signore?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Aumenta la soddisfazione della comunità.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Molto bene, governatore. Se non vuoi commerciare con me, i miei uomini prenderanno semplicemente ciò che ci serve.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Questa volta sei stato fortunato. Ma la prossima non sarà così facile.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ah ah ah! Che ti sia di lezione. Sono sicuro che la prossima volta accetterai di fare affari con me.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Mio signore, ho bisogno di molte pietre. Ti rifornirò di legname, se tu mi aiuterai con le pietre.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Mio signore, ho raccolto un po’ di legname per la costruzione del villaggio. Lo potrei scambiare con del grano.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Mia figlia moriva di freddo la scorsa notte. Saresti così generoso da fornirmi della lana? In cambio potrei darti del legname di valore.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Mio signore, ho una domanda... mio figlio vuole imparare la professione di tintore. Ha bisogno di pelli per fare pratica. Le scambierei con del legname.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Mio signore, hai delle erbe? Purtroppo non ne ho più per condire la mia carne.\nIn cambio ti darò il mio legno migliore.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Mio signore, vorrei riparare la mia casa. Vorresti scambiare degli attrezzi con la mia ultima pila di legname?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Mio signore, voglio preparare un banchetto. Potresti aiutarmi? In cambio ti fornirò un po’ di legname.";
"SCENARIO_CW_QUEST_B_NAME" = "Commercia con l’agricoltore.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Mio signore, la mia famiglia soffre la fame. Saresti così generoso da fornirci un po’ di pesce? In cambio posso darti un po’ di legname dalla mia piccola scorta.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Ho una piccola scorta di legno per le riparazioni. Te la darò in cambio di qualche pietra, mio signore.";
"SCENARIO_CW_QUEST_C_10_DESC" = "I miei uomini hanno bisogno di pesce. Portamene un po’ e ti darò il legno! Inoltre, risparmierò il tuo piccolo villaggio.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Ehi, governatore! Voglio farti un favore, liberandoti di qualche pietra pesante dal magazzino. Se mi permetti di farlo potrei perfino darti del legname in cambio.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Invece di sprecare grano dandolo ai tuoi contadini, potresti darlo a me in cambio del mio legno migliore.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Vorremmo ammorbidire le impugnature delle nostre spade con della lana. Non ti preoccupare: se cooperi, non le useremo contro di te.";
"SCENARIO_CW_QUEST_C_50_DESC" = "I miei uomini si annoiano. Se ci rifornisci di pelli, possiamo migliorare i nostri manichini da addestramento rendendoli più realistici. Se non vuoi fare affari con me, allora dovremo fare pratica con i tuoi concittadini.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Uno dei miei uomini è malato. Ho saputo che certe erbe potrebbero salvarlo. Se non ti dispiace le cercherò nel tuo magazzino. Sono certo di trovarle.";
"SCENARIO_CW_QUEST_C_70_DESC" = "I nostri attrezzi sono inutilizzabili. Tu ne hai tanti, governatore. Sii gentile e dammene qualcuno, e io sarò gentile e non me li prenderò da solo.";
"SCENARIO_CW_QUEST_C_80_DESC" = "I miei uomini hanno voglia di carne. Portacene un po’ e io sarò così gentile da darti un po’ di legname in cambio.\n\nOppure i miei ragazzi potrebbero far visita alla tua città e prendersela da soli...";
"SCENARIO_CW_QUEST_C_NAME" = "Commercia col bandito.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, un nuovo governatore...\nVisto che sei nuovo qui, ti spiego le regole. Tu mi dai quello che chiedo e io ti lascio fare tutto quello che devi fare.\n\nMi sembra un accordo equo, no? Ok, cominciamo con qualcosa di semplice: portami del pesce!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Legname? Nessun problema!\nHo rub... ehm... immagazzinato una grande quantità di legno. Per un paio di pietre te ne posso vendere un po’.";
"SCENARIO_THIEF_FAIL" = "Quindi non vuoi proprio fare affari con me, eh?\n\nMolto bene, ne subirai le conseguenze.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Mio Signore, guardate cosa abbiamo qui... Sembra un dente. Non umano. E qui, altri tartufi. Non ne so abbastanza per proporre una teoria, ma conosco qualcuno che può aiutarci. Andiamo a far visita al vecchio!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "Chi altro oltre al mercante potrebbe avercela così tanto con la gente del posto? È un complice!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "Il mercante!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "È stata probabilmente la giovane donna! È la sorella della ragazza bandita. È un movente!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "La giovane fanciulla!";
"THEBEAST_CHOICE_A_REASON_DESC" = "La giovane donna ingiustamente bandita dalla regina ha organizzato questi attacchi. Voleva vendetta per il suo esilio forzato.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "V per Vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "La ricerca del benessere del villaggio si è trasformata in un incubo... Probabilmente era in buona fede: voleva solo aiutare i concittadini.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "Hector, l'artista!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "È stato sicuramente lui! Odia i nuovi arrivati e ha attaccato la sorella della ragazza in esilio per assicurarsi che lei non possa fare nulla per danneggiare la sua vigna.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Basil, l’agricoltore.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Spaventando i locali, il colpevole voleva allontanarli dalla città e impedire a nuovi abitanti di trasferirsi qui.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "Per dissuadere altre persone dal trasferirsi nel villaggio!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Ha senza dubbio aiutato finanziariamente il colpevole.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "La Regina Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "È stato il fornaio! Ha fatto finta di essere stato attaccato per evitare ogni sospetto! Che genio!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "Il panettiere.";
"THEBEAST_CHOICE_C_REASON_DESC" = "La regina Frygith, pentitasi della decisione di aprire le frontiere, si è accordata con alcuni residenti per spaventare i nuovi arrivati e chiudere nuovamente le frontiere!";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Cospirazione di stato.";
