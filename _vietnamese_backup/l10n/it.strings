"T_MAP_CANALGRANDE_DESC" = "Una laguna con tante piccole isole è il luogo perfetto per costruire una città collegata da ponti e attraversata da canali.";
"T_MAP_COASTALISLAND_DESC" = "In questa baia si trova un’isola idilliaca. Puoi stabilire una città di una certa importanza in questo luogo remoto?";
"T_MAP_COASTSANDCLIFFS_DESC" = "Il castello si affaccia sull'oceano da un'alta scogliera. Negli altopiani circostanti, è possibile costruire un città costiera.";
"T_MAP_COASTSANDCLIFFS_NAME" = "Scogliere e coste";
"T_MAP_DESC_10" = "Questa lussureggiante vallata è un luogo ideale per costruire una città fiorente.";
"T_MAP_DESC_11" = "Questa mappa è stata creata per testare le prestazioni su tutti i dispositivi. Una città molto grande si estende su tutta la mappa.";
"T_MAP_DESC_12" = "Le acque increspate dei fiumi di questa regione invitano i paesani alla pesca o a una bella nuotata.";
"T_MAP_DESC_13" = "Sull'ombroso altopiano, un piccolo villaggio può diventare una grande città.";
"T_MAP_DESC_14" = "Il regno soffre per la siccità. Il fiume si è prosciugato. Ciò rende la coltivazione della terra e il nutrimento dei cittadini un'impresa impegnativa.";
"T_MAP_DESC_15" = "Instaura un fiorente centro di commercio sull'altopiano. Affari lucrosi con mercanti e cavalieri ti attendono.";
"T_MAP_DESC_16" = "Crea una colonia mineraria e fornisci le materie prime per la costruzione di una cattedrale monumentale.";
"T_MAP_DESC_17" = "Organizza i preparativi per un grande matrimonio reale.";
"T_MAP_DESC_18" = "Costruisci una grande città vicino a questo fiume asciutto, me ricorda che l'acqua scarseggia da queste parti.";
"T_MAP_DESC_19" = "C'è un piccolo altopiano vicino al limite delle paludi. Un luogo ideale per una città.";
"T_MAP_DESC_2" = "Questa tranquilla località costiera è il luogo ideale per fondare il tuo villaggio.";
"T_MAP_DESC_20" = "Una montagna isolata in mezzo al nulla. Niente acqua, ma innumerevoli giacimenti di minerale. Il posto perfetto per fare fortuna!";
"T_MAP_DESC_2016_01" = "Il re ha bisogno di molte assi di legno per costruire una grande flotta. Scopri perché la fornitura di assi si è interrotta e costruisci una Gilda dei mercanti.";
"T_MAP_DESC_2016_02" = "Questa bellissima regione è il luogo perfetto dove costruire una grande città. Le ampie colline offrono molto spazio per innumerevoli edifici.";
"T_MAP_DESC_2016_03" = "Una piccola cittadina è diventata una grande metropoli. Soddisfa i bisogni e i desideri dei cittadini nel tempo a disposizione.";
"T_MAP_DESC_2016_04" = "Modifica i compiti dei cittadini saggiamente per costruire un mercato e una taverna.";
"T_MAP_DESC_2016_05" = "Pianifica attentamente la città, lo spazio per gli edifici è scarso tra le cascate, e il terreno può essere difficile da attraversare.";
"T_MAP_DESC_2016_06" = "Ci sono massicce valanghe in questa regione. Nonostante questo, dovrai fondare una piccola città e sfruttare i ricchi depositi di minerali.";
"T_MAP_DESC_2016_08" = "Costruisci la tua città nel canyon. Troverai tutto ciò che ti serve, ma alcune aree sono difficili da raggiungere.";
"T_MAP_DESC_2016_09" = "Attraversa il fiume per raggiungere le risorse necessarie per la tua città.";
"T_MAP_DESC_2016_10" = "Accumula molto denaro. Ma attenzione, i banditi hanno un covo nella zona. Oltre alla minaccia dei banditi, i cittadini scontenti non pagheranno le tasse.";
"T_MAP_DESC_21" = "Costruisci un villaggio su una meravigliosa isola segreta. Goditi l'aria di mare!";
"T_MAP_DESC_21_NOBANDITS" = "Fonda un villaggio su una meravigliosa isola nascosta e goditi l'aria fresca del mare!";
"T_MAP_DESC_22" = "Fai superare il durissimo inverno alla tua città.";
"T_MAP_DESC_23" = "In questa gelida pianura devi costruire una città funzionante molto in fretta, o non supererà l'inverno.";
"T_MAP_DESC_24" = "Assisti il re nell'impresa di costruire una grande flotta navale, tenendo sotto controllo le tensioni crescenti nella tua città.";
"T_MAP_DESC_25" = "Usa i boschi circostanti di questa regione a tuo vantaggio per fondare la tua città. Qui l'acqua è scarsa, quindi la pesca non è una fonte di cibo su cui fare affidamento.";
"T_MAP_DESC_26" = "Il tuo re ha fatto una scommessa, e il tuo lavoro è costruire una grande città prima che lo faccia l'arciduca. Hai un anno di tempo per completare tutti i compiti. Non deludere il tuo re!";
"T_MAP_DESC_27" = "Le aree paludose rendono estremamente difficile trovare terreno edificabile. Cerca di fare buon uso del poco che hai a disposizione!";
"T_MAP_DESC_28" = "Una valle rocciosa con molte risorse, ma poco spazio per gli edifici.";
"T_MAP_DESC_29" = "Un piccolo gruppo di isole. Colonizzarle sarà una sfida.";
"T_MAP_DESC_29_NOBANDITS" = "Un piccolo gruppo di isole. Colonizzarle sarà una sfida.";
"T_MAP_DESC_3" = "Questa è la mappa del tutorial. Qui verrai introdotto al mondo di Townsmen.";
"T_MAP_DESC_30" = "Costruisci una città che circondi la roccaforte della tua montagna. Ma fai attenzione, sta arrivando un lungo inverno.";
"T_MAP_DESC_31" = "Il Re visiterà i propri territori. Preparati per il suo arrivo.";
"T_MAP_DESC_32" = "Si avvicina il compleanno del Re. Come regalo, sarebbe bello regalargli la birra perfetta. Forse i monaci al monastero ne sanno di più...";
"T_MAP_DESC_33" = "Il Re soffre di una malattia misteriosa. Scoprine la causa e curala.";
"T_MAP_DESC_34" = "La guerra ha stretto questa terra in una morsa. Lontano dal fronte, dovrai stabilire una città fiorente e supportare l'esercito reale.";
"T_MAP_DESC_35" = "Il Re vuole essere pronto per i tempi più duri e ha scelto la tua città per la consegna delle merci richieste.";
"T_MAP_DESC_36" = "Apprendi le basi della guerra da un veterano.";
"T_MAP_DESC_37" = "Soddisfa i desideri di tua moglie e occupati del bandito ricattatore.";
"T_MAP_DESC_4" = "Il tuo castello è posizionato su una piccola isola fluviale. Usa le coste circostanti saggiamente e crea una economia fiorente!";
"T_MAP_DESC_6" = "Costruisci un piccolo villaggio sulle rive del magnifico lago.";
"T_MAP_DESC_7" = "La tua città è stata scelta dal re per ospitare la più grande giostra della regione!";
"T_MAP_DESC_8" = "L'inverno si avvicina! Aiuta i paesani a prepararsi per la stagione fredda.";
"T_MAP_DESC_9" = "Aiuta tua moglie a riattivare l'economia di un villaggio povero!";
"T_MAP_DESC_APOCALYPSE" = "La città è infestata da una maledizione: strane malattie e disastri stanno affliggendo i suoi abitanti. Tocca a te trovare un modo per spezzare la maledizione quanto prima, costi quel che costi...";
"T_MAP_DESC_FESTIVITIES" = "Il Re si è risposato. In onore della sua nuova moglie, hai l’ordine di organizzare diversi festival stagionali. Ma la pianificazione e l’esecuzione potrebbero rivelarsi difficili. Sarà una corsa contro il tempo...";
"T_MAP_DESC_ICYHOLD" = "In alto sulle colline si erge la fortezza ghiacciata. Difficile da raggiungere, ma una volta scalata offre una vista impareggiabile sulla fredda tundra circostante. L’inverno è molto lungo in quest’area!";
"T_MAP_DIPLOMATICVISIT_DESC" = "La regina di un paese alleato viene a fare visita alla nostra città. Dobbiamo stipulare accordi commerciali redditizi, ma prima dobbiamo superare la barriera linguistica.";
"T_MAP_DIPLOMATICVISIT_NAME" = "Visita diplomatica";
"T_MAP_DIVIDEDSHORELINE_DESC" = "Una montagna maestosa divide la tua terra. Inoltre, puoi conquistare un'isola non lontana dal tuo castello.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "Litorale diviso";
"T_MAP_FRIGYTHKINGDOM_DESC" = "La Regina Frigyth ha bisogno di un nuovo governatore per gestire questa parte del Regno. Costruisci una città grandiosa in questa nuova terra.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "Regno di Frigyth";
"T_MAP_FROZENFRONT_DESC" = "L’ultima guerra ha lasciato la maggior parte della città in rovine. I resti coperti di neve della città ora segnano il luogo dove i due eserciti si scontrarono. Ora è il momento di ricostruire la città.\n\nQuesta è una mappa solo invernale!";
"T_MAP_HIGHLANDS_DESC" = "Questo paese è attraversato da montagne e colline. La vista è splendida quando si raggiungono le vette.";
"T_MAP_HIGHLANDS_INTRO" = "Benvenuto sugli altipiani, governatore. Questa regione è piena di misteri. Sono sicuro che, se sei attento e ti prendi cura degli abitanti, le terre ti sveleranno presto tutti i loro segreti.";
"T_MAP_HIGHLANDS_NAME" = "Altipiani";
"T_MAP_INSANECHOICES_DESC" = "Ti hanno chiamato in un villaggio dove il Duca sembra essere impazzito. I cittadini si rifiutano di pagare le tasse!\nOgni scelta che effettui, conduce a un finale differente.";
"T_MAP_INSANECHOICES_NAME" = "Scelte dissennate";
"T_MAP_LEGACY_DESC" = "Il Re ha un nuovo compito per voi. Sta invecchiando e teme di lasciare questo mondo senza trasmettere un’eredità: qualcosa che consegnerà alle generazioni future le preziose lezioni che lui ha imparato stando sul trono.";
"T_MAP_LEGACY_NAME" = "L'eredità";
"T_MAP_LOWLANDS_DESC" = "Ampie pianure e tanto spazio edificabile si estendono all'orizzonte. Qui è possibile costruire una città molto grande.";
"T_MAP_LOWLANDS_NAME" = "Pianure";
"T_MAP_MARSH_DESC" = "In questa regione molte praterie umide contribuiscono alla diversità biologica del territorio. ";
"T_MAP_MARSH_INTRO" = "Signore, ammirate questo perfetto equilibrio tra terra e acqua. Sono felice di darvi il benvenuto in questo luogo di pace.\n\nGli abitanti del posto saranno presto testimoni dei vostri sforzi per far raggiungere a questa regione il suo pieno potenziale!";
