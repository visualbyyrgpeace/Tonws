"T_MAINQUEST_OBJECTIVE_COMPLETE_TASKS_KING" = "王の任務を果たす";
"T_MAINQUEST_OBJECTIVE_WOODSHORTAGE" = "木の問題を解く。";
"T_MAIN_MENU_INFO" = "情報";
"T_MAIN_MENU_LOADGAME" = "ロードする";
"T_MAIN_MENU_PRESS_TO_CONTINUE" = "キーをどれか押して続ける";
