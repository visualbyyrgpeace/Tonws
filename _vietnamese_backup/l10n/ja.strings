"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "中へ通せ。";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "許可しよう。";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "もっと多くの旅人を惹きつけるなどとは、問題外だ。";
