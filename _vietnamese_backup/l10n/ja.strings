"T_GAME_QUEST_DESIRES_10_SUCCESS" = "コインを今俺に渡したほうが賢明だぞ！";
"T_GAME_QUEST_DESIRES_10_TITLE" = "コインを納める。";
"T_GAME_QUEST_DESIRES_11_START" = "まさかこの脅迫に負けるつもりじゃないでしょうね？\nそのお金を新しい服を買うのに使うほうがよっぽどましだわ！";
"T_GAME_QUEST_DESIRES_11_TITLE" = "商人から衣服を買う。";
