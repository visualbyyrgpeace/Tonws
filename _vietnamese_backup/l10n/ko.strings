"SCENARIO_CW_QUEST_B_40_DESC" = "딸이 지난 밤에 추위에 고생했습니다. 양털을 좀 보내주실 수 있으신지요? 대신 귀중한 목재를 드릴 수 있습니다.";
"SCENARIO_CW_QUEST_B_50_DESC" = "영주님, 질문이 있습니다... 아들이 무두질을 배우고 싶어 하는데 연습에 사용할 가죽이 필요합니다. 가죽을 주시면 목재를 드리겠습니다.";
"SCENARIO_CW_QUEST_B_60_DESC" = "영주님, 허브가 있나요? 불행히도 고기에 향을 가미할 허브가 없습니다.\n허브를 주시면 대신 가장 좋은 목재를 드리겠습니다.";
"SCENARIO_CW_QUEST_B_70_DESC" = "영주님, 집을 수리해야 합니다. 장작 더미와 도구를 거래하시겠습니까?";
"SCENARIO_CW_QUEST_B_80_DESC" = "영주님, 만찬을 준비해야 합니다. 도와주시겠습니까? 대신 목재를 드리겠습니다.";
"SCENARIO_CW_QUEST_B_NAME" = "농부와 거래하세요.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "영주님, 가족들이 굶주리고 있어요. 제게 생선을 주실 수 있나요? 대신 장작 더미에서 목재를 드리겠습니다.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "수리용 목재가 있습니다. 목재를 석재와 거래하겠습니다, 영주님.";
"SCENARIO_CW_QUEST_C_10_DESC" = "부하들에게 생선이 더 필요해요. 생선을 가져오면 목재를 드릴게요! 그리고 당신의 작은 마을도 건들지 않을게요.";
"SCENARIO_CW_QUEST_C_20_DESC" = "영주님! 창고에 있는 무거운 석재를 치워드릴 수 있어요. 허락하시면 목재도 드릴게요.";
"SCENARIO_CW_QUEST_C_30_DESC" = "농부에게 밀을 주어 낭비하는 대신 제게 주면 좋은 목재를 드릴게요.";
"SCENARIO_CW_QUEST_C_40_DESC" = "양털로 검 손잡이를 부드럽게 만들고 싶습니다. 걱정 마시길. 도와주시면 영주님을 상대로 사용하지 않겠습니다.";
"SCENARIO_CW_QUEST_C_50_DESC" = "부하들이 지루해하고 있어요. 가죽을 가져오면 훈련용 인형을 더욱 사실적으로 만들 수 있어요. 저와 거래하고 싶지 않다면 주민을 상대로 훈련하는 수밖에 없죠.";
"SCENARIO_CW_QUEST_C_60_DESC" = "부하 중 한 명이 아파요. 허브가 도움을 줄 수 있다고 들었어요. 괜찮다면 창고에서 허브를 찾아볼게요. 분명히 있을 거예요.";
"SCENARIO_CW_QUEST_C_70_DESC" = "도구를 더 이상 사용할 수 없어요. 영주님은 많이 갖고 계시죠. 아량을 베풀어 제게 도구를 주시면 제가 직접 뺏지는 않을게요.";
"SCENARIO_CW_QUEST_C_80_DESC" = "부하들이 고기를 원하고 있어요. 제게 고기를 주면 정중히 대가로 목재를 드리죠. \n\n아니면 부하들이 마을을 찾아가서 직접 가져올 수 있어요…";
"SCENARIO_CW_QUEST_C_NAME" = "강도와 거래하세요.";
