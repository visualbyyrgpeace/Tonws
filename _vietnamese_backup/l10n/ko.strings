"T_LEGACY_COUNTRY_NEED_SUCCESS_002" = "영주님, 이웃 국가가 따뜻하게 감사의 뜻을 전했어요! 이웃 국가를 기아에서 구한 것 같아요. 우리가 도와주지 않았다면 어떻게 됐을까요?";
"T_LEGACY_COUNTRY_NEED_TITLE" = "이웃 국가를 도와주세요.";
"T_LEGACY_DECO_DESC" = "이런, 영주님! 주변을 보세요! 모르시겠나요?\n\n그거예요! 장식이 어디에 있죠? 너무 쓸쓸해요! 어서 왕이 도착하시기 전에 장식을 만드세요.";
"T_LEGACY_DECO_SUCCESS" = "바로 이거예요! 제가 간단히 조언을 드릴 수 있어 다행이네요.";
"T_LEGACY_FISHER_HUNTER_HUT_DESC" = "영주님, 드디어 만났군요. 마을에 빵 말고도 다른 식량원이 있으면 좋을 거예요. 어부의 오두막과 사냥꾼의 오두막을 지으면 어떨까요? 균형 잡힌 식사를 할 수 있을 거예요.";
"T_LEGACY_FISHER_HUNTER_HUT_SUCCESS" = "영주님, 정말 감사합니다. 이제 충분한 식량원으로 식생활을 개선할 수 있어요. 앞으로 주민들이 더욱 건강하게 생활하게 될 거예요.";
"T_LEGACY_FISHER_HUNTER_HUT_TITLE" = "어부의 오두막과 사냥꾼의 오두막을 지으세요.";
"T_LEGACY_HOUSE_DESC" = "앞으로 맡게 될 작업을 고려할 때 타운하우스를 추가로 건설하는 것이 현명할 거예요.";
"T_LEGACY_HOUSE_SUCCESS" = "훨씬 좋군요! 새 집에서 추가로 소득도 발생할 거예요.";
"T_LEGACY_INTRODUCTION_001_DESC" = "영주, 이 마을에 온 것을 환영해요. 지금은 작은 마을이지만 영주가 이곳을 크게 발전시킬 수 있을 거예요.";
"T_LEGACY_INTRODUCTION_002_DESC" = "마을의 번영을 위해 중요한 작업이 있어요. 보시다시피 난 이제 젊지 않아요. 앞으로도 좋은 날을 보낼 수 있겠지만 곧 끝나겠죠.";
"T_LEGACY_INTRODUCTION_003_DESC" = "미래 세대에게 영감을 줄 왕국의 흔적을 남기고 싶어요. 이미 좋은 생각이 있지만 실현하려면 영주의 도움이 필요해요.";
"T_LEGACY_INTRODUCTION_004_DESC" = "살면서 겪었던 일을 편지에 담아 영주에게 보낼게요. 각 경험이 과제의 주제가 될 거예요. 실망하게 하지 말아요. 마지막 편지를 보낸 후 영주를 만나러 마을로 찾아갈게요.";
"T_LEGACY_LETTER_001_DESC" = "왕은 백성들과 가까워지면서 백성들을 더 잘 도울 수 있었어요. 왕은 마을에 선술집이 있었으면 해요. 다른 지역의 이야기와 전설들을 후대에 전할 수 있게요.";
"T_LEGACY_LETTER_001_DESCRIPTION_001_DESC" = "첫 번째 편지가 도착했습니다. 영주님, 매우 흥미롭군요! 왕이 아직 십 대였을 때 왕의 아버지께서 주민들 각자의 일을 이해하도록 왕을 일반 주민들과 어울리게 하셨어요.";
"T_LEGACY_LETTER_001_DESCRIPTION_002_DESC" = "그래서 왕은 매주 새로운 일을 경험했어요. 한 주는 벌목꾼으로, 그다음 주는 어부나 선술집 주인으로 일하기도 했죠. 왕은 이러한 경험을 통해 백성들이 원하는 것을 더 정확히 알 수 있었어요. 정말 훌륭하네요, 영주님!";
"T_LEGACY_LETTER_001_DESCRIPTION_003_DESC" = "왕에게 선술집 주인의 일은 특히 힘들었어요. 처음에는 파티와 술을 제공하면 그만이라고 생각했는데 훨씬 더 많은 것을 배우면서 자신이 얼마나 부족한 사람인지 깨달았어요.";
"T_LEGACY_LETTER_001_DESCRIPTION_004_DESC" = "선술집에서는 가볍게 논쟁을 할 수 있었어요. 철학부터 외국 여행자가 전하는 이야기까지 놀라움과 생각할 거리를 주었죠.";
"T_LEGACY_LETTER_001_SUCCESS" = "훌륭해요, 영주님! 주민들이 생기와 따스함이 가득한 새로운 장소에 기뻐하고 있어요. 앞으로 긴 겨울 저녁을 즐겁게 보내게 될 거예요.";
"T_LEGACY_LETTER_002_DESC" = "일에 헌신하면 가장 위대한 보물을 받을 수 있다는 교훈을 배웠어요. 왕은 선조를 기리기 위해 포도원을 건설하라고 명령하셨어요. 이미 생각해둔 장소가 있나요?";
"T_LEGACY_LETTER_002_DESCRIPTION_001_DESC" = "방금 두 번째 편지를 받았어요. 왕이 남부 포도원에서 지낸 어린 시절 이야기를 하셨어요. 여름이면 종종 포도원으로 가서 할머니를 만나셨대요. ";
"T_LEGACY_LETTER_002_DESCRIPTION_002_DESC" = "할머니는 우화를 많이 들려주셨죠. 그중에서도 농부와 그의 아들에 대한 우화가 가장 인상 깊게 남으셨대요. 왕은 일의 중요성을 배웠죠. ";
"T_LEGACY_LETTER_002_SUCCESS" = "왕이 마을에 생긴 포도원을 보고 매우 흡족해하고 계세요. 농부들이 잘 관리할 거예요.";
"T_LEGACY_LETTER_003_DESC" = "그래서 왕은 창고를 만들고 백성들에게 메시지를 전달하라고 지시하셨어요. 창고를 가득 채우면 친구들이 어려울 때 도울 수 있어요.";
"T_LEGACY_LETTER_003_DESCRIPTION_001_DESC" = "또 편지가 도착했습니다. 왕이 열 살 무렵에 일어났던 기근에 대해 말씀하시고 계세요. 왕국 전체가 피해를 입었어요. ";
"T_LEGACY_LETTER_003_DESCRIPTION_002_DESC" = "왕실은 문제를 직접 해결하기로 결정하고 이웃 나라에 외교관을 파견하여 도움을 요청했어요. ";
"T_LEGACY_LETTER_003_DESCRIPTION_003_DESC" = "하지만 관심을 주는 나라가 없었고 아무도 왕을 도와주려 하지 않았어요. 그래도 왕은 포기하지 않고 도움을 주려는 왕국을 찾아냈어요. 사실 그 왕국은 식량이 풍족해서 기꺼이 다른 나라에 나누어주려 했어요.";
"T_LEGACY_LETTER_003_DESCRIPTION_004_DESC" = "이 이야기의 교훈은 크기와 관계없이 언제나 다른 사람을 도와줄 수 있다는 거예요. 왕은 백성들이 도움이 필요한 자를 기꺼이 도와야 한다고 생각하세요. 힘들 때 나눌 수 있도록 풍족할 때 물자를 비축해야 해요.";
"T_LEGACY_LETTER_003_SUCCESS" = "완벽한 새 창고예요! 이제 예상치 못한 상황에 대비해서 모든 필수품을 대량으로 보관할 수 있어요.";
"T_LEGACY_LETTER_004_DESC" = "왕의 소원을 실현하려면 마을에 왕의 조각상을 세워야 해요.";
"T_LEGACY_LETTER_004_DESCRIPTION_001_DESC" = "영주님, 편지를 받았습니다. 왕이 보내셨습니다. 성대한 대관식이 열렸습니다. 왕국의 모든 영주들이 궁전에 모였습니다.";
"T_LEGACY_LETTER_004_DESCRIPTION_002_DESC" = "모두를 평등하게 대하기 위해 왕은 모든 도시와 마을에 동시에 존재하고 싶었습니다. 물론 이것은 물리적으로 불가능하죠. 하지만 마을마다 조각상을 세우면 가능해요.";
"T_LEGACY_LETTER_004_SUCCESS" = "훌륭해요! 왕이 무척 기뻐하실 거예요. 정말 훌륭한 기념물이에요!";
"T_LEGACY_LETTER_004_TITLE" = "왕의 조각상을 만드세요.";
"T_LEGACY_LETTER_005_BOOK_HERE" = "영주님, 비망록이 완성됐습니다. 왕이 무척 기뻐하실 거예요.";
"T_LEGACY_LETTER_005_DESC" = "이 과제에는 가죽이 충분히 있어야 해요. 그래야 수도승들이 가죽에 왕의 비망록을 쓸 수 있으니까요. ";
"T_LEGACY_LETTER_005_DESCRIPTION_001_DESC" = "마지막 편지가 방금 도착했어요. 왕은 세계 위인들이 비망록을 작성하고 어떻게 전 세계에 전파했는지 쓰셨어요. ";
"T_LEGACY_LETTER_005_DESCRIPTION_002_DESC" = "왕은 비망록을 남기고 싶어하세요. 책을 만드는 것은 어렵지만 성공하면 왕이 매우 기뻐하실 거예요.";
"T_LEGACY_LETTER_005_SUCCESS" = "비망록 작성을 시작할 수 있어요! 수도승들이 왕이 도착할 때까지 마칠 수 있을 거예요. 정말 기대돼요! 비망록으로 전 세계에 우리의 이름이 알려질 거예요!";
"T_LEGACY_LETTER_005_TITLE" = "왕의 비망록을 만드세요.";
"T_LEGACY_LETTER_006_DESCRIPTION_001_DESC" = "영주님! 왕이 오고 계세요! 왕을 맞이하기 위한 우리의 노력이 왕의 마음에 들었으면 좋겠어요.";
"T_LEGACY_LETTER_006_DESCRIPTION_002_DESC" = "영주, 잘 있었나요. 내가 자리를 비운 사이에 마을을 잘 관리했군요. 오! 조각상이 멋지군요! 포도도 좀 보세요! 할머니의 포도를 닮았네요!";
"T_LEGACY_LETTER_006_SUCCESS" = "내 편지의 소원이 모두 실현됐어요. 특히 내가 몹시 바라던 비망록도요. 완벽해요! 내 지식이 사라지지 않을 것이라는 확신을 갖고 이제 마음 편히 은퇴 생활을 즐길 수 있겠어요.";
"T_LEGACY_MAINQUEST_DESC" = "후대에 길이 남을 유산을 만들어주세요. 내 모든 경험을 내 길을 따르려는 자들에게 교훈이 되게 해주세요.";
"T_LEGACY_MAINQUEST_SUCCESS" = "영주, 정말 훌륭해요! 내 요청을 매우 철저하게 고려했군요. 자랑스러워요. 왕국 전체가 영주에게 큰 빚을 졌어요.";
"T_LEGACY_MAINQUEST_TITLE" = "왕의 퀘스트를 도와주세요.";
"T_LEGACY_MINE_DESC" = "영주님, 새 건물을 짓는 데 원자재를 많이 사용하고 있어서 곧 원자재가 떨어질 거예요. 광산을 건설해야 하지 않을까요?";
"T_LEGACY_MINE_SUCCESS" = "영주님, 축하합니다. 이제 원자재가 충분해서 마을의 다른 건설 프로젝트를 원활히 진행할 수 있어요.";
"T_LEGACY_SECURITY_DESC" = "영주님, 안녕하세요. 저는 왕의 전령입니다. 마을에 왕을 맞이할 준비가 됐는지 확인하라는 명령을 받았습니다.\n\n이건 뭐죠? 마을의 안전이 형편없군요! 즉시 화재 감시탑을 세우세요! 불이라도 나면 어떻게 되겠어요?!";
"T_LEGACY_SECURITY_SUCCESS" = "훨씬 좋군요! 유비무환이죠. 올바른 일을 하신 거예요.";
"T_LEVELENDSCENE_BUTTON_NEXT" = "다음 시나리오";
"T_LEVELENDSCENE_COMPLETE_DESC" = "축하합니다. 모든 과제를 완료하고 이 시나리오를 성공적으로 마무리했습니다!";
"T_LEVELENDSCENE_COMPLETE_TITLE" = "시나리오 완료!";
"T_LEVELENDSCENE_FAILED_DESC" = "시나리오를 실패했습니다. 주 과제를 완료하지 못했습니다…";
"T_LEVELENDSCENE_FAILED_TITLE" = "시나리오 실패!";
"T_LEVELSELECTION_ENABLE_BANDITS_QUESTION" = "이 지도에서 강도 공격을 활성화하시겠습니까?";
"T_LEVELSELECTION_PROPERTIES_BANDITS_ENABLED" = "강도 활성화";
"T_LEVELSELECTION_PROPERTIES_DIFFICULTY" = "난이도";
"T_LEVELSELECTION_PROPERTIES_MAPSIZE" = "지도 크기";
"T_LEVELSELECTION_PROPERTIES_MILITARY_ENABLED" = "군용 지도";
"T_LEVELSELECTION_SETTINGS" = "설정";
"T_LEVELSELECTION_START_GAME" = "게임 시작";
"T_LOADINGTIP_001" = "작물이 자랄때까지 농부들은 일을 할 수 없습니다. 작은 밭을 여러개 지으시면, 일꾼들이 돌아가면서 일을 할 수 있습니다.";
"T_LOADINGTIP_002" = "수송 지연을 막기위하여 주민들을 창고에 충분히 배정하십시오.";
"T_LOADINGTIP_003" = "선술집은 주스 공장에서 포도 주스나 수도원에서 맥주를 공급 받으면 더욱 효과가 있습니다.";
"T_LOADINGTIP_004" = "교회와 같은, 공공 빌딩들은 제한적인 수의 주민들만 수용이 가능합니다.";
"T_LOADINGTIP_005" = "몇몇 장식들은 행복지수를 올리는 데 매우 유용합니다. 인구 수가 많을 수록 행복 지수를 유지하기 위하여 많은 수의 장식이 필요합니다.";
"T_LOADINGTIP_006" = "주민들의 행복 지수에 주의를 기울이세요. 주민들의 필요와 소원을 충족하기 위하여 통계 메뉴를 사용하세요.";
"T_LOADINGTIP_007" = "주민들의 소원과 필요를 잘 충족시킬 수록, 파업 없이 주민들에게 높은 세금을 부과할 수 있습니다.";
"T_LOADINGTIP_008" = "상인들이 마을에 도착하며 긴급 자원을 구매하거나 상품을 판매할 수 있습니다.";
"T_LOADINGTIP_009" = "농장은 밀, 양털 또는 허브를 생산할 수 있습니다. 밀의 경우 밀 밭이 필요합니다. 양의 경우 목초지가 필요하고 허브는 허브 정원이 필요합니다. 이들을 농장 가까이에 배치하세요.";
"T_LOADINGTIP_010" = "생산 빌딩에서 일하는 일꾼들의 수를 확보하기 위하여 빠르게 타운하우스를 지으세요.";
"T_LOADINGTIP_011" = "작은 마을은 어부나 사냥꾼이 쉽게 물자를 제공할 수 있지만 큰 마을에는 빵집이나 푸줏간이 더 어울립니다.";
"T_LOADINGTIP_012" = "항상 나무 생산에 주의를 기울이십시오. 많은 빌딩들이 나무를 자원으로 사용합니다.";
"T_LOADINGTIP_013" = "광산과 농장 등 몇몇 빌딩은 하나 이상의 자원을 생산합니다. ";
"T_LOADINGTIP_014" = "생산 체인의 투입 및 결과를 관찰해보세요. 이를 통하여, 완벽한 실행 능력을 확인할 수 있습니다.";
"T_LOADINGTIP_015" = "옵션 기여 게임을 통하여 샌드박스에서 무료 명망을 얻을 수 있습니다.";
"T_LOADINGTIP_016" = "시나리오는 완성을 위하여 충족하여야 할 여러가지의 작업을 포함하고 있습니다.";
"T_LOADINGTIP_017" = "시나리오를 완성한 후, 지속적으로 게임을 할 수있는 옵션이 제공됩니다.";
"T_LOADINGTIP_018" = "금고를 만드세요! 세금 징수원이 마을을 돌아다니며 집을 방문할 때마다 세금 수입이 늘어납니다.";
"T_LOADINGTIP_019" = "목공소는 매우 유용합니다. 목수는 마을을 돌아다니며 자원과 코인을 사용하여 낡은 건물을 수리합니다.";
"T_LOADINGTIP_020" = "빌딩 상태는 정말 중요합니다. 망가진 타운하우스는 주민들을 불행하게하며 상태가 좋지 않은 생산 빌딩들의 생산력은 감소합니다. 잘 수리되지 않은 빌딩들은 화재를 야기합니다.";
"T_LOADINGTIP_021" = "주민들은 그들만의 일상을 가지고 있습니다. 쉬는 시간에는 집으로 가서 음식을 먹거나 그들의 소원을 충족시킵니다.";
"T_LOADINGTIP_022" = "빌딩을 철거할 경우, 건축에 투자된 금액의 절반을 회수할 수 있습니다. 자원들은 주민들에 의하여 수송되어야 합니다. 만일 자원을 수송하기 전 같은 장소에 건물을 지으실 경우, 자원은 사라집니다.";
"T_LOADINGTIP_023" = "광산은 록키 산맥에만 지을 수 있습니다. 광산에서는 스톤 뿐만 아니라 철 또는 금을 캐낼 수도 있습니다.";
"T_LOADINGTIP_024" = "도로는 상품 및 자원의 수송 속도를 증가시킵니다. 주민들은 도로 사용을 즐깁니다. 조약돌 길의 수송은 흙길보다는 빠른 편입니다.";
"T_LOADINGTIP_025" = "세금율이 너무 높을 경우, 주민들은 불행해지며 파업을 할 수도 있습니다. 만일 주민들의 소원을 들어줄 경우, 높은 세금을 지불할 수도 있습니다.";
"T_LOADINGTIP_026" = "여주민들은 마을에 물과 식량을 공급합니다. 시장을 방문하여 보석 및 의류를 구매하기도 합니다. 남 주민들은 빌딩 생산에서 일하게 됩니다.";
"T_LOADINGTIP_027" = "만일 빌딩 저장소가 자주 가득찬다면, 창고를 더 짓거나 운송 업자를 배정하셔야 합니다.";
"T_LOADINGTIP_028" = "열심히 일하는 주민들은 결국 피곤해지며 휴식을 취하게 됩니다. 휴식 후 다시 일을 시작합니다.";
"T_LOADINGTIP_029" = "현재 계절은 화면의 우측에 표시됩니다. 일년이 한번 가는 데에 60분이 소요됩니다. 모든 맵의 계절이 변하는 것은 아닙니다.";
"T_LOADINGTIP_030" = "겨울 동안 밭에서 아무것도 생산되지 않습니다!\n\n밀, 허브, 홉 그리고 포도 쥬스를 넉넉히 비축하여 추운 계절을 준비해야 합니다. ";
"T_LOADINGTIP_031" = "사냥은 겨울에 음식을 구하는 좋은 방법입니다. 사냥꾼은 주변에 사슴이나 토끼가 충분히 있는 한 마을에 고기와 가죽을 공급합니다. ";
"T_LOADINGTIP_032" = "일부 과제는 주어진 시간 내에 완료하지 못하면 실패합니다.\n과제를 실패하면 대부분 보상을 받지 못하지만 일부 과제의 경우 시나리오를 실패할 수도 있습니다.";
"T_LOADINGTIP_033" = "시나리오를 완료하면 계속 플레이할 것인 지에 대해서 선택할 수 있습니다. 그 후, 게임은 샌드박스 모드로 바뀌게 됩니다.";
"T_LOADINGTIP_034" = "사냥꾼이 너무 많으면 사냥감이 줄어들 수 있습니다.\n사슴이나 토끼가 새로 나타나는 속도는 지도에 있는 숲의 크기에 좌우됩니다.";
"T_LOADINGTIP_035" = "어떤 임무는 시간 제한이 있습니다. 임무 완수까지 남은 시간은 좌측 상단에 경고 메시지로 표시됩니다.";
"T_LOADINGTIP_036" = "과생산 건물을 비활성화하여 창고가 차서 넘치거나 창고 메뉴에서 자원을 파괴하는 것을 막으세요.";
"T_LOADINGTIP_037" = "과제를 완료하고 마을을 개선하여 레벨을 높일 수 있습니다. 레벨이 높아질수록 더 좋은 보상을 받게 됩니다!";
"T_LOADINGTIP_038" = "의사가 허브 정원에서 가져온 약초로 아픈 주민을 치료할 수 있습니다.";
"T_LOADINGTIP_039" = "XP는 건물을 만들거나, 시장에서 거래하거나, 마을의 높은 행복을 달성하거나, 과제를 완료하거나, 많은 인구에 도달함으로써 획득할 수 있습니다.";
"T_LOADINGTIP_040" = "빌딩 업그레이드는 매우 강력합니다: \n\n예를 들어, 이들을 통하여 빌딩에 더 많은 일꾼들을 할당하거나 빌딩의 저장소를 증가시킵니다!";
"T_LOADINGTIP_041" = "광산의 자원층이 고갈되면 여러 가지 옵션이 있습니다. 다른 자원층을 찾아 거기에 새로운 광산을 만들거나 고갈된 광산에 지질학자를 배치하여 자원을 더 캐낼 수 있게 만들 수 있습니다.";
"T_LOADINGTIP_042" = "타운 레벨을 증가시키면, 강력한 리서치를 얻을 수 있습니다..\n\n예를 들어, 빌딩 업그레이드를 잠금해제하면 새로운 리서치 옵션 이용이 가능하며, 세금 증가 및 더 나은 퀘스트 보상으로 이어집니다!";
"T_LOADINGTIP_043" = "업그레이드된 건물에도 단점은 있습니다:\n\n추가 일꾼은 자원 소모를 증가시키고 업그레이드할 때마다 건물의 수리 비용이 증가합니다!";
"T_LOADINGTIP_044" = "특정한 타운 레벨에 도달하면, 빌딩 업그레이드가 잠금해제 됩니다. 빌딩 메뉴에서 빌딩을 업그레이드 할 수 있습니다. \n\n빌딩 업그레이드는 꽤 비싼 편이므로, 게임 초기에, 충분한 자금이 있는지 확인하십시오.";
"T_LOADINGTIP_045" = "지질학자 리서치는 매우 유용합니다!\n\n지질학자를 광산에 배정하면, 광석들을 천천히 보충합니다.\n\n";
"T_LOADINGTIP_046" = "새 마을 레벨에 도달하면 추가 연구 옵션이 잠금 해제됩니다. 연구가 완료되면 모든 마을에 보너스가 영구 적용됩니다! ";
"T_LOADINGTIP_047" = "마을이 특정 규모에 도달하면, 전염병의 위험이 존재합니다! 주민들을 치료하기 위한 병원과 허브 정원이 필요합니다.";
"T_LOADINGTIP_048" = "전염병이 타운에 시작될 경우, 병원 또는 화재 감시탑을 즉시 지으셔야 합니다. 의사들은 아픈 주민들을 치료하며 소방관들은 빌딩의 화재를 진압합니다.";
"T_LOADINGTIP_049" = "건물을 업그레이드하여 성능을 개선하세요. 업그레이드 탭은 건물의 콘텍스트 메뉴에서 찾을 수 있습니다.";
"T_LOADINGTIP_050" = "빌딩을 관리하십시오! 정기적으로 수리하지 않으면, 검게 그을리거나 또는 타버릴 수 있습니다.";
"T_LOADINGTIP_051" = "타운에 화재나 전염병이 발생하면, 주민들은 타운을 떠날 수도 있습니다. 위험이 사라지고 충분한 타운하우스가 존재할 경우, 주민들은 결국 돌아오게 됩니다.";
"T_LOADINGTIP_052" = "병영은 영향권 내에 있는 감시탑에만 물자를 공급할 수 있습니다.";
"T_LOADINGTIP_053" = "군인은 싸움에서 지면 돌아와 부상에서 회복합니다.";
"T_LOADINGTIP_054" = "건물의 콘텍스트 메뉴에는 유용한 정보가 가득합니다. 지도에서 건물을 선택하세요.";
"T_LOADINGTIP_055" = "강도가 건물을 공격하면 자원을 훔치거나, 건물에 불을 지르거나, 건물을 파괴할 수 있습니다.";
"T_LOADINGTIP_056" = "건물에 대한 강도의 습격은 군인이 막을 수 있지만 그렇게 할 수 있는 시간은 제한되어 있습니다.";
"T_LOADINGTIP_057" = "무두질 공장용 동물 외피는 사냥꾼의 오두막이나 푸줏간에서 생산됩니다.";
"T_LOADINGTIP_058" = "군사 연구는 전투와 마을 방어에 큰 도움을 줄 수 있습니다.";
"T_LOADINGTIP_059" = "감시탑과 화재 감시탑으로 되도록 넓은 범위의 마을을 보호하세요.";
"T_LOADINGTIP_060" = "병영에서 일하는 운송 업자는 창고에서 군인용 물자를 받아 범위 내에 있는 감시탑으로 배송합니다.";
"T_LOADINGTIP_061" = "일시 중지 메뉴에서 마을에 대한 현재 영향을 확인하세요. 지도 상에서 일시적이거나 영구적으로 활성화될 수 있습니다. 예로는 활동 중인 강도, 긴 겨울 또는 세수 감소 등이 있습니다.";
"T_LOADINGTIP_062" = "군인에게 공급되는 장비와 식량은 군인의 공격력과 방어력에 직접적인 영향을 줍니다. 즉, 군인에게 검을 공급하면 공격력이 크게 증가합니다.";
"T_LOADINGTIP_063" = "군인에게 식량과 음료를 공급하여 공격력과 방어력을 모두 강화하세요.\n보급을 잘 받은 군인이 잘 싸웁니다!";
"T_LOADINGTIP_064" = "전투는 여러 단계로 구성됩니다. 양 진영이 누가 시작 단계를 시작할지 결정해야 합니다. 이후 양 진영이 번갈아가며 공격과 방어를 합니다. ";
"T_LOADINGTIP_065" = "건물의 상황별 메뉴에서 “주민 따라가기” 모드 를 사용하여 현재 주민이나 일꾼이 무엇을 하고 있는지 확인하세요.";
"T_LOADINGTIP_066" = "지도 경계나 지도에 위치한 강도 캠프에서 강도의 공격이 시작될 수 있습니다. 강도 캠프는 업그레이드될 수 있어 방어가 더 우수합니다.";
"T_LOADINGTIP_067" = "병영, 감시탑 그리고 화재 감시탑은 효력을 발휘하는 영향력의 구가 있습니다. 즉, 이 구 밖에 있는 건물의 화재를 소방수가 진압할 수 없습니다.";
"T_LOADINGTIP_068" = "건물을 만드는 동안 또는 건물의 상황별 메뉴에서 “영향 범위 보기”를 사용하여 영향력의 구를 볼 수 있습니다. 이 보기 모드는 병영, 감시탑 및 화재탑에 사용할 수 있습니다.";
"T_LOADINGTIP_069" = "건물과 해당 건물의 생산에 대해 자세히 알고 싶다면 건물의 콘텍스트 메뉴에서 "건물 정보"를 이용하세요.";
"T_LOADINGTIP_070" = "많은 생산망과 경제가 밀에 의해 좌우됩니다. 겨울이 오기 전에 밀을 많이 비축해야 합니다.";
"T_LOADINGTIP_071" = "건물에 불꽃이 많을수록 화재가 더 심각합니다. 건물이 붕괴될 수 있어요!";
"T_LOADINGTIP_072" = "오락 건물을 여러 채 지어서 주민들을 기쁘게 할 수 있어요. 각 건물이 만족시킬 수 있는 주민의 수는 정해져 있어요.";
"T_LOADINGTIP_073" = "마을을 각 계절로부터 영향을 받아요. 예를 들어 겨울에는 옷이 더 필요하죠.";
"T_LOADINGTIP_074" = "겨울에는 눈보라와 산사태가 마을을 덮칠 수 있어요.";
"T_LOADINGTIP_075" = "여름에는 마을에 가뭄이 찾아올 수 있어요. 가뭄이 끝날 때까지 밭이 마르기 시작하죠.";
"T_LOADINGTIP_076" = "수도원에는 홉 건조장이 있어야 홉을 받을 수 있어요.";
"T_LOADINGTIP_077" = "주스 공장에는 포도를 공급하는 포도원이 필요해요.";
"T_LOADINGTIP_078" = "의사는 더 이상 허브를 수확하지 않아요. 농장이 허브를 수확하죠. 의사는 창고에서 허브를 구할 수 있어요.";
"T_LOADINGTIP_079" = "날씨 상태는 마을에 특별한 영향을 주죠. 비가 온 후 일시적으로 농장의 효과가 올라가요. 마을에 눈보라가 치는 동안 주민들은 느리게 걷죠.";
"T_LOADINGTIP_080" = "폭풍우가 마을에 오면 번개가 건물에 떨어져 화재가 일어날 수 있어요.";
"T_LOADINGTIP_081" = "계절마다 축제장에서 축제가 열립니다. 진행 중인 축제가 있을 때마다 종합 행복이 일시적으로 올라갑니다.";
"T_LOADINGTIP_082" = "일시 중지 메뉴에서 영향 화면을 보세요. 여기서 마을이 어떤 영향을 받고 있는지 알 수 있어요.";
"T_LOADINGTIP_083" = "건물 중 하나가 파괴되면 잔해에서 표지판을 선택하여 재건할 수 있습니다.";
"T_LOADINGTIP_084" = "마을에 눈보라가 치는 동안 주민들이 느리게 걷고 건물이 더 빠르게 붕괴합니다.";
"T_LOADINGTIP_085" = "건물 중 하나가 잠기거나 사용할 수 없게 되면 특별 요건이 부족한 것이 원인일 수 있습니다. 건물의 상황별 메뉴에서 퀵링크를 통해 요건으로 바로 이동할 수 있습니다.";
"T_LOADINGTIP_086" = "주의: 폭풍우 동안 번개가 건물에 떨어질 수 있어요!";
"T_LOADINGTIP_087" = "주의: 눈이 많이 내리면 건물이 더 빨리 붕괴됩니다!";
"T_LOADINGTIP_088" = "간편 메뉴에서 건물을 수리하고, 일꾼을 배치/배치 해제하고, 빠르게 주민을 추적할 수 있습니다.";
"T_LOADINGTIP_089" = ""통계" 탭의 "건물"에서 모든 건물의 개요를 볼 수 있습니다. 건물 하나를 선택하여 해당 유형의 모든 건물을 확인할 수 있습니다.";
"T_LOADINGTIP_090" = "적용 범위 개요에서 다양한 유형의 오버레이를 볼 수 있습니다.";
"T_LOADINGTIP_091" = "이벤트 메뉴에서 완료된 퀘스트나 연구 같은 이벤트로 바로 이동할 수 있습니다.";
"T_LOADINGTIP_092" = ""마을 정보" 카테고리에서 마을 이름을 변경할 수 있습니다.";
"T_LOADINGTIP_093" = "현재 가족 수는 "마을 정보"에서 확인할 수 있습니다.";
"T_LOADINGTIP_094" = "이벤트 메뉴에서 심각성별로 경고를 정렬하고 화면에서 경고를 숨길 수도 있습니다.";
"T_LOADINGTIP_095" = "풍차가 효율적으로 작동하려면 여러 농장에서 밀을 공급해야 합니다.";
"T_LOADINGTIP_096" = "비가 불을 끌 수 있습니다.";
"T_LOADINGTIP_097" = "아픈 주민은 스스로 회복될 가능성이 적습니다.";
"T_LOADINGTIP_098" = "주민의 언어는 네덜란드어, 핀란드어, 볼라퓌크어가 혼합되어 있습니다.";
