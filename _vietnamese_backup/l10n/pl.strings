"T_GAME_QUEST_AWAKENING_THE_TOWN_FARM_001" = "Powinniśmy też założyć gospodarstwo, by zapewnić naszym ludziom odpowiednią ilość jedzenia.";
"T_GAME_QUEST_AWAKENING_THE_TOWN_FARM_002" = "Wspaniale, gubernatorze! Jeszcze kilka składników i możemy upiec chleb.";
"T_GAME_QUEST_AWAKENING_THE_TOWN_NO_001" = "Nie, dzięki.";
"T_GAME_QUEST_AWAKENING_THE_TOWN_NO_002" = "Waszmości, twoje życzenie jest dla mnie rozkazem.";
"T_GAME_QUEST_AWAKENING_THE_TOWN_SAWMILL_001" = "Po pierwsze, niezbędny będzie tartak. Dzięki niemu wytworzysz deski i odblokujesz nowe budynki.";
"T_GAME_QUEST_AWAKENING_THE_TOWN_SAWMILL_002" = "Świetnie ci idzie!";
"T_GAME_QUEST_AWAKENING_THE_TOWN_TITLE" = "Przebudzenie miasta";
"T_GAME_QUEST_AWAKENING_THE_TOWN_WINDMILL_001" = "Teraz powinniśmy zbudować młyn. Bez mąki nie będzie chleba!";
"T_GAME_QUEST_AWAKENING_THE_TOWN_WINDMILL_002" = "Cóż za wspaniały młyn, gubernatorze! ";
"T_GAME_QUEST_AWAKENING_THE_TOWN_YES_001" = "Z przyjemnością, zaczynajcie.";
"T_GAME_QUEST_BAKERY_ON_FIRE_ANSWER_001" = "Niech piekarz zostanie wygnany!";
"T_GAME_QUEST_BAKERY_ON_FIRE_ANSWER_002" = "Przekaż pieniądze.";
"T_GAME_QUEST_BAKERY_ON_FIRE_ANSWER_003" = "To nie moja sprawa.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_001_A" = "Ośmieliłeś się wygnać piekarza?! I jak teraz będziemy wypiekać chleb? Powinieneś lepiej to przemyśleć. Założę się, że to będzie niosło za sobą konsekwencje!";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_01" = "Wypadki się zdarzają, pokryjemy straty mieszkańców dotkniętych przez pożar.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_02" = "Dziękuję ci za ten gest, waszmości. Za te pieniądze będziemy mogli wyżyć do czasu, aż naprawy zostaną ukończone.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_002_03" = "Morale mieszkańców podniosło się ze względu na twoją decyzję. To był dobry wybór.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_003_01" = "Przykro mi patrzeć, jak jesteś tak obojętny wobec swoich ludzi, gubernatorze.";
"T_GAME_QUEST_BAKERY_ON_FIRE_CONSEQUENCE_003_02" = "Morale mieszkańców spadło ze względu na twoją decyzję. Będą mniej produktywni.";
"T_GAME_QUEST_BAKERY_ON_FIRE_DESC" = "Panie! To straszne. Piekarz trzymał zbyt dużo drewna w pobliżu pieca i piekarnia stanęła w ogniu! Pożar rozprzestrzenił się na pobliskie budynki, a ich mieszkańcy są na niego wściekli.\n\nCo powinniśmy zrobić? ";
"T_GAME_QUEST_BAKERY_ON_FIRE_EXPLAIN_MONEY_001" = "Zapewnij wsparcie finansowe mieszkańcom, aby mogli dojść do siebie po pożarze.";
"T_GAME_QUEST_BAKERY_ON_FIRE_TITLE" = "Piekarnia w ogniu";
"T_GAME_QUEST_BANDIT_ATTACK_WARNING" = "W okolicy zauważono bandytów, wasza miłość!";
"T_GAME_QUEST_BANDIT_ATTACK_WARNING_KLOSTER" = "Bandyci atakują klasztor!";
"T_GAME_QUEST_BOARDGAME_001_END_001" = "Gratulacje, waszmości, możemy przejść do kolejnego etapu! Zamieściłem ogłoszenie i trzech projektantów jest do naszych usług. Każdy z nich specjalizuje się w innym rodzaju gry.";
"T_GAME_QUEST_BOARDGAME_001_STARTED_001" = "Ach, rozumiem, waszmości. Chcesz wykorzystać materiały, aby wykonać kostki do gry i inne narzędzia. To świetny pomysł! Zacznijmy od zebrania potrzebnych surowców.";
"T_GAME_QUEST_BOARDGAME_002_END_002" = "Z tym wspaniałym zespołem możemy na spokojnie rozpocząć przygotowania!";
"T_GAME_QUEST_BOARDGAME_002_GD_001" = "Waszmości, miło mi być częścią twego zespołu. Specjalizuję się w grach strategicznych.";
"T_GAME_QUEST_BOARDGAME_002_GD_002" = "Ja natomiast jestem ekspertem od gier logicznych. Mogę stworzyć pokój pełen różnych zagadek, z którego mieszkańcy będą musieli wydostać się w określonym czasie.";
"T_GAME_QUEST_BOARDGAME_002_GD_003" = "A ja zjadłem zęby na grach karcianych. Na pewno przypadną do gustu wszystkim, niezależnie od wieku!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_001" = "Waszmości, ludność się buntuje! Na naszych ziemiach odbywa się prawdziwa wojna domowa!";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_002" = "Uspokojenie ludności zajęło nam trochę czasu. Jeśli ta sytuacja kiedykolwiek się powtórzy, bardziej uważaj na swoje decyzje, waszmości. Jeśli możemy uniknąć kolejnej wojny domowej…";
"T_GAME_QUEST_BOARDGAME_DO_NOTHING_003" = "Waszmości, bunt nadal trwa w najlepsze! Podjąłeś potworną decyzję!";
"T_GAME_QUEST_BOARDGAME_FIRE_001" = "Twoi żołnierze doświadczyli największego wstydu w swoim życiu. Niektórzy z nich nie mogą spojrzeć na siebie w lustrze. Jeden z nich, przywódca grupy, postanowił zemścić się na mieszkańcach. Twój szpieg niezwłocznie cię o tym informuje.\n\nCo masz zamiar z tym zrobić?";
"T_GAME_QUEST_BOARDGAME_FIRE_002" = "Zapobiegnij zemście.";
"T_GAME_QUEST_BOARDGAME_FIRE_004" = "Waszmości, zanim uporamy się z żołnierzami, musimy zająć się pożarami!";
"T_GAME_QUEST_BOARDGAME_FIRE_005" = "Teraz, gdy miasto zostało ocalone od pożarów, możemy zająć się tymi żołnierzami.";
"T_GAME_QUEST_BOARDGAME_REVOLT_001" = "Mieszkańcy nie popierają twojego wyboru i sami postanowili wziąć sprawy w swoje ręce.\n\nZmusili strażników do założenia butów z dzwoneczkami i czapek wstydu. Od teraz muszą paradować po mieście w takim stroju.\nNiektórzy ludzie rzucają w nich pomidorami. \n\nPowinniśmy coś z tym zrobić?";
"T_GAME_QUEST_BOARDGAME_REVOLT_002" = "Nic nie rób.";
"T_GAME_QUEST_BOARDGAME_REVOLT_003" = "Wezwij posiłki.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_001" = "Po krótkiej naradzie z doradcą masz przed sobą dwa rozwiązania. Wysłanie żołnierzy na galery, aby ukarać ich nie tylko za opuszczenie posterunku, ale także za wszczęcie pożarów, lub zlecenie im prac społecznych…";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_002" = "Galery.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_003" = "Prace społeczne.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_004" = "Z ciężkim sercem decydujesz się na wysłanie żołnierzy na galery. Muszą zostać przykładnie ukarani, aby nie rozniosły się plotki, że brak ci autorytetu.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_005" = "Twoi żołnierze powrócili. Ta mała przymusowa wycieczka na morze przywróciła im zdrowy rozsądek.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_006" = "A może połączymy przyjemne z pożytecznym? Dzięki żołnierzom robotnicy będą przez jakiś czas bardziej produktywni.";
"T_GAME_QUEST_BOARDGAME_REVOLT_SOLDIERS_007" = "To co dobre, szybko się kończy. Żołnierze spłacili swój dług u mieszkańców, pomagając im w codziennych zadaniach.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_A" = "Dobrze, że wkroczyłeś do akcji, waszmości. Nie zasługują na to, aby rzucano w nich pomidorami.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_B" = "Dotrzyjmy do sedna problemu poprzez zorganizowanie pojedynku o sprawiedliwość. Ludzie wystawią swojego czempiona, a żołnierze swojego. Stoczą oni uczciwy pojedynek. Sprawiedliwości stanie się zadość.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_001_C" = "Zbudujmy plac turniejowy. Czerwony czempion będzie walczył po stronie ludu, a niebieski po stronie żołnierzy.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_002" = "NIECH ROZPOCZNIE SIĘ WALKA!";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_003" = "Czerwony rycerz zwyciężył pojedynek. Wygrana należy więc do ludu.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_004" = "Żołnierze zostali uznani za winnych i musieli odbyć prace społeczne. Jeśli znów zaczną organizować noce gier, to zostaną wygnani z miasta.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_005" = "Niebieski rycerz zwyciężył pojedynek. Wygrana należy więc do żołnierzy.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_006" = "Mieszkańcy będą musieli wynagrodzić żołnierzom rzucanie w nich pomidorami, ale żołnierze muszą odbyć prace społeczne. Jeśli znów zaczną organizować noce gier, to zostaną wygnani z miasta.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_007" = "Waszmości, król usłyszał o wykorzystaniu placu turniejowego do zapewnienia sprawiedliwości. Przekazuje, że to aprobuje oraz chciałby nagrodzić cię punktami prestiżu. Wszystko dobre, co się dobrze kończy.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_001" = "Poślij tam myśliwych.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_002" = "To nie moja sprawa.";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_A" = "Ależ waszmości, do polowania potrzebujemy co najmniej jednego myśliwego… Nie traćmy czasu i zbudujmy chatę myśliwską!";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_B" = "Misja została wykonana! Musieliśmy przeprowadzić niezłe polowanie. Ziemie zostały ocalone.";
"T_GAME_QUEST_BOAR_REGULATION_TITLE" = "Przepisy dotyczące dzików";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_001" = "Twój brat JEST ptakiem.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_002" = "Zaraz, zaraz. Straż! Przyprowadźcie go.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Masz moje pozwolenie.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Dobra, już wystarczy, zabierzcie go do uzdrowiciela.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Co masz na myśli? Twój brat jest ptakiem? Chyba tracisz rozum.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Gubernator próbuje powiedzieć ci, że musisz mu zaufać. Twój brat wie, co robi. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Skoro tak mówisz… Ale jeśli coś mu się stanie, to ty poniesiesz za to odpowiedzialność!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Gubernatorze, podaliśmy mu trochę środków uspokajających, więc teraz śpi. Mamrocze coś o technice, która pozwoliłaby mu na przemierzenie gór. Dobrze uczyniłeś, przyprowadzając go do mnie. Jeszcze trochę a powiedziałby nam, że ziemia jest okrągła!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Waszmości! Spotkaliśmy posłańca z zamku, który powiedział, że nasz wynalazca wspaniale się spisał i chciałby, aby dłużej pozostał w stolicy i kontynuował prace nad swoimi wynalazkami. Kulturalne wpływy naszego miasta poczyniły wielki krok naprzód! Król postanowił przysłać nam trochę punktów prestiżu.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Mój panie, przychodzę do ciebie, ponieważ mój brat oszalał. Twierdzi, że jest ptakiem i może latać! Obawiam się, że wymyśli coś głupiego i wespnie się zbyt wysoko na drzewo, aby udowodnić, że może latać niczym ptak.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Och, waszmości! Dziękuję, że nie zabrałeś mnie do lochu! Moja siostra za bardzo się o mnie martwi. Chciałem zaskoczyć ją moim odkryciem! Wymyśliłem maszynę, która może latać! Jak ptak!! Chciałbym zaprezentować ją w stolicy na corocznym jarmarku.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Ptasi brat";
"T_GAME_QUEST_COVERAGE_DESC" = "Mój panie, nasze miasto nie jest przygotowane na ataki bandytów!\nWiększość osady nie jest chroniona wieżami strażniczymi. Musisz je zbudować w taki sposób, aby objęły swoim zasięgiem jak najwięcej budynków.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Mój panie, miasto nie jest przygotowane na atak bandytów! Niektóre jego części nie są pokryte budynkami obronnymi. ";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Zwiększ pokrycie miasta budynkami obronnymi";
"T_GAME_QUEST_COVERAGE_TITLE" = "Zabezpiecz miasto wieżami strażniczymi.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Bandyci atakują naszą osadę, gubernatorze!\nMusimy odeprzeć jak najwięcej najeźdźców, aby zminimalizować szkody dla naszej gospodarki i budynków!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Mój panie,\nmieszczanie boją się ataku bandytów. Powinniśmy zademonstrować im, a zwłaszcza bandytom, że potrafimy się bronić!";
"T_GAME_QUEST_DESIRES_01_START" = "Cóż za prowincjonalny region. Brakuje mu zalet dużego miasta.\n\nWiele się musi zmienić, aby ta osada stała się kwitnącą metropolią!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Teraz, gdy bandyci zostali pokonani, a osada znacznie się rozrosła, zrobiło się tutaj naprawdę pięknie.\nWarto było się tutaj przenieść, kochanie.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Zadbaj o dobrobyt swojej żony.";
"T_GAME_QUEST_DESIRES_02_START" = "Ta osada potrzebuje zakładu krawieckiego, abym mogła kupić sobie nowe stroje.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Dziękuję, kochanie!\nMoje stare ubrania były już poprzecierane.";
"T_GAME_QUEST_DESIRES_03_START" = "Tęsknię za tętniącym życiem miastem.\nPrzyciągnij więcej ludzi, aby ożywić tę osadę!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Zwiększ zaludnienie.";
"T_GAME_QUEST_DESIRES_04_START" = "Cóż za urocza, żywa osada!\n\nZ pewnością nie będzie ci przeszkadzać, że się tutaj osiedlę.";
"T_GAME_QUEST_DESIRES_05_START" = "Bandyci w lasach?!\nZorganizuj straż miejską, aby zwalczała tych złoczyńców!";
"T_GAME_QUEST_DESIRES_06_START" = "O, wieża strażnicza…\n\nMusisz wiedzieć, że takie zachowanie tylko podżega moich ludzi!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Ci bandyci sprawiają kłopoty w osadzie.\n\nMusisz czym prędzej wzmocnić szeregi straży miejskiej!";
"T_GAME_QUEST_DESIRES_07_START" = "Zadbaj o to, aby nasi strażnicy trzymali tych bandytów z dala od miasta!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Doskonale! Czuję się teraz o wiele bezpieczniej.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Odeprzyj wszystkie ataki bandytów.";
"T_GAME_QUEST_DESIRES_08_START" = "Zaserwuj naszym strażnikom podpiwek i kiełbasę, aby byli posłuszni!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Wyprodukuj podpiwek i kiełbasę.";
"T_GAME_QUEST_DESIRES_09_START" = "Strażniczy potrzebują uzbrojenia i pancerzy, aby odpędzać bandytów!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Teraz nasi strażnicy powinni sobie poradzić ze wszystkimi bandytami!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Wyprodukuj uzbrojenie i pancerze.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Powinienem był wspomnieć, że moi ludzie i tak wezmą, co im się należy!";
"T_GAME_QUEST_DESIRES_10_START" = "Widząc, jak spełniasz każde życzenie swojej żony, nasuwa mi się myśl, że masz za dużo monet.\n\nPozwól, że uwolnię cię od tego ciężaru!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Mądrze byłoby przekazać mi teraz te monety, mości zarządco!";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Danina.";
"T_GAME_QUEST_DESIRES_11_START" = "Chyba nie zamierzasz się poddać temu szantażowi?\nWydanie tych monet na nowe ubrania byłoby o wiele lepszą inwestycją!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Kup odzież u kupca.";
"T_GAME_QUEST_DESIRES_12_START" = "Ta osada jest nudna, brakuje tu rozrywek!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "Ta osada jest nudna, brakuje tu placu turniejowego!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "O wiele lepiej! Zaczyna się robić przytulnie.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Zbuduj plac turniejowy.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Widzę, że nie wyciągasz żadnych wniosków. Moja ekipa wpadnie tu przeprowadzić drobną inwentaryzację!";
"T_GAME_QUEST_DESIRES_13_START" = "Wygląda na to, że wciąż cierpisz na nadmiar bogactw. Oddawaj złoto!\nI nawet się nie waż przekazywać go żonie!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Wygląda na to, że umiesz wyciągać wnioski. Być może moi ludzie nie będą już musieli brać niczego siłą.";
"T_GAME_QUEST_DESIRES_15_START" = "Lepiej przetop to złoto na biżuterię dla mnie, kochanie!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Dziękuję, kochanie!";
"T_GAME_QUEST_DESIRES_16_START" = "Chcę zorganizować małą uroczystość.\nW związku z tym potrzebuję soku i chleba.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Bardzo dobrze. Mam nadzieję, że nie dojdzie do żadnych incydentów z bandytami.";
"T_GAME_QUEST_DESIRES_17_START" = "Och, jaka miła uroczystość, tylko czy ktoś nas zapomniał zaprosić? ";
"T_GAME_QUEST_DESIRES_18_START" = "Dość tego. Pozbądź się tych bandytów na dobre!\nZniszcz ich obozowiska.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "W końcu udało nam się pozbyć tych złoczyńców!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Zniszcz wszystkie obozy bandytów.";
"T_GAME_QUEST_DESIRES_19_START" = "Ta osada nie ma nawet targowiska?!\nZbuduj go, kochanie, abym mogła sprowadzać towary z miasta.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Dzięki temu życie tutaj stało się odrobinę bardziej znośne.";
"T_GAME_QUEST_DESIRES_20_START" = "Nie mają innych produktów spożywczych poza rybami?\nZbuduj tu piekarnię i rozpocznij produkcję chleba.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Niezmiernie dziękuję! Na widok ryb robi już mi się niedobrze.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Mój panie, nasi zwiadowcy donoszą, że bandyci z całego regionu gromadzą się przy granicach osady. Obawiam się, że może dojść do zmasowanego ataku.\nPowinniśmy przygotować obronę!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "Bandyci rozpoczynają atak!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "Kolejna fala najeźdźców dotarła do osady, mój panie!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Gubernatorze, bandyci rozpoczęli kolejny atak!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Kolejna horda bandytów zmierza do naszej osady, wasza miłość!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Zbliża się ogromna fala bandytów, wasza miłość. To chyba będzie ostatnia. Musimy utrzymać pozycje!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Mój panie, straż miejska donosi, że atak dobiegł końca. Pozostali bandyci zostali wypędzeni z osady i dokonują odwrotu.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "Populacja zwierząt uległa odnowieniu. W końcu możemy wrócić do polowań!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Pola powoli się regenerują, wasza miłość. Wygląda na to, ze to koniec choroby zbóż.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Pola powoli się regenerują, wasza miłość. Wygląda na to, że to koniec suszy.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "Miasto płonie, mości zarządco!\n\nMusimy czym prędzej ugasić pożar, nim rozniesie się po całej osadzie.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Doskonale, wasza miłość.\n\nWszystkie pożary zostały ugaszone i osada znowu jest bezpieczna.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "W osadzie ugaszono wszystkie pożary, wasza miłość.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Zadbaj o to, by żaden budynek nie spłonął.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Mój panie, czarna śmierć pustoszy tę ziemię.\n\nMusimy się zająć chorymi, nim wszyscy mieszczanie padną ofiarą plagi.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Udało się, wasza miłość!\n\nEpidemia dżumy została opanowana. Osada jest bezpieczna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Medycyna nowoczesna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Babcine lekarstwa.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Wzburzony medyk postanowił zniszczyć lecznicę! „Jeśli wybieracie babcine leki, to nie potrzebujecie już mojej pracowni!”, powiedział.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Mądra decyzja, waszmości.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Dzięki twemu wyborowi opieka zapewniana przez lekarzy jest o wiele bardziej efektywna!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Waszmości, wielu mieszkańców nie wie, gdzie zwrócić się o pomoc z problemami zdrowotnymi. Powinniśmy zalecić im medycynę nowoczesną czy babcine lekarstwa?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Lekarze i babcie";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Wracaj do łóżka.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Ufam ci.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "O, nie! Nie! Nie powinniśmy byli ignorować tego snu! Niektórzy mieszkańcy zaczęli zapadać na dziwną chorobę.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Na szczęście udało się nam powstrzymać chorobę. Lepiej, żebyśmy następnym razem słuchali przepowiedni…";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Ten mieszkaniec nie raz uratował nas od katastrofy. Zbudujmy lecznicę, waszmości. Tak na wszelki wypadek.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Och, waszmości! Ledwo ukończyliśmy budowę lecznicy, a kilkoro naszych mieszkańców już jest chorych. Dobrze, że postanowiłeś posłuchać tego mieszkańca! Szkody zostały ograniczone! Dobra robota, waszmości.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Musimy ich wyleczyć, waszmości. Inaczej możliwe, że choroba się rozprzestrzeni.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Znakomicie! Cała osada znów jest w pełni zdrowa. Możemy wracać do naszych interesów.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Mój panie, ostatniej nocy śniło mi się, że nasza osada zostanie zarażona dziwną chorobą. Wszyscy mieszkańcy mieli zatkane nosy.\n\nCzy myślisz, że mój sen mógł być proroczy?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Czas na sen";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Nie mogę się doczekać!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Ech, wolałem poprzedniego właściciela.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "Nie, nie mam na to czasu.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Nie ma mowy.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Przyślij ją.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Zrobione.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Przyciągnięcie większej liczby podróżników nie wchodzi w rachubę.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "W niespotykanym przypływie szczodrości zabierasz się do roboty. Ten zajazd będzie pływać w morzu kwiatów!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "No dobrze.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = "„Słuchajcie, słuchajcie, dobrzy ludzie! Zajazd ma nową właścicielkę! Przyjdźcie na ponowne otwarcie!”\n\nMiejski krzykacz jest dziś w dobrym humorze. Mówi się, że dostaje napiwki za każdym razem, gdy do zajazdu przychodzi nowy klient.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Waszmości, przybyła nowa właścicielka zajazdu. Czy zechcesz ją powitać?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Waszmości, proszę cię. Zajazd to ulubione miejsce podróżników. Poprzez ulepszenie tego przybytku moglibyśmy podnieść reputację miasta.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Dzień dobry, waszmości. Dziękuję ci za przyjęcie mnie w twym zamku.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "Czemu zawdzięczam tę wizytę?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Cóż, zajazd jest w kiepskim stanie. Poprzedni właściciel był bardzo nieostrożny. Nie tylko w kwestii dostawców, ale także klientów!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Hmm, tak, skoro tak mówisz. Nie bywamy w zajeździe zbyt często.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Przybyłam tu poprosić o twoją pomoc. Na początek chciałabym dodać do mojego przybytku nieco kwiatów, aby nabrał on nieco bardziej czarującego wyglądu. Chcę przyciągnąć więcej podróżników, by chętnie do nas wracali.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "A teraz przejdźmy do drugiego etapu! Napitki.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ach… Drugi etap. Cóż, skoro już tu jesteśmy, to możemy iść dalej. Co będzie kolejnym krokiem twojego planu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Potrzebujemy metalu oraz drewna najwyższej jakości.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Czy nie wspominałaś czasem o napojach? To skąd teraz wzięło się drewno?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Oczywiście do budowy porządnych beczek! Poprzedni właściciel nie posiadał odpowiednich beczek do przechowywania napoi. Dostawcy używają kiepskich materiałów, więc musimy uzbierać wystarczająco dużo sztabek żelaza i drewna, żebyśmy sami mogli je wykonać.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Świetnie! Są piękne!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Skoro tak to odbierasz, to sama się tym zajmę!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "Od teraz w swoich ogłoszeniach krzykacz będzie promował zajazd.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "Od teraz w swoich ogłoszeniach krzykacz będzie promował gospodę.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Dziękuję ci, gubernatorze! Wszystko dobre, co się dobrze kończy.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Och, dziękuję ci, waszmości! Z tymi kwiatami zajazd wygląda o wiele bardziej przyjaźnie.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Proszę, panie, zastanów się jeszcze. Ten zajazd to ważne źródło dochodu dla naszej osady. Pomoże ci to ukończyć niektóre z twoich projektów.\n\nCzy na pewno chcesz przestać się tym zajmować?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Co też mówisz, waszmości?! Pomagasz tej młodej kobiecie z zajazdem, a co ze mną? Jakoś nie pomagasz mi przy mojej gospodzie!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Ej, zachowuj się, gdy zwracasz się do gubernatora.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Żądam takich samych praw, jakie ma ta pani!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Ty też potrzebujesz kwiatów dla swojego przybytku?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Kwiatów? Nie! Chcę krzykacza, który będzie wspierał także mój biznes!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Waszmości, co powinniśmy zrobić?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Wypromuj gospodę.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Wypromuj zajazd.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "O kwiatach i wrogach";
"T_GAME_QUEST_FEAST_TITLE" = "Zorganizuj festyn.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Zabezpiecz osadę wieżami strażackimi.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Mój panie, nasze miasto nie jest przygotowane na wielkie pożary! Pewne rejony osady nie są chronione wieżami strażackimi. Umieść je w takich miejscach, aby objęły swoim zasięgiem jak najwięcej budynków.";
"T_GAME_QUEST_FOOD_STARTED" = "Nie zapomnijmy o jedzeniu, waszmości! Żaden festyn nie może się odbyć bez pełnej spiżarni. Pośpieszmy się i uzupełnijmy zapasy. Im szybciej je zdobędziemy, tym szybciej powiedzie się twój projekt.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Uczestnicy naszego festynu nie umrą z głodu! Och, waszmości, zbliżamy się do celu! Nie mogę się doczekać!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Gubernator, który nie częstuje królowej napitkiem? Mówiono mi, żebym na ciebie uważała, ale nie chciałam słuchać!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Bez przesady, królowo Frygith, nie ma co się złościć o drobnostki. To tylko napitek. Nie dramatyzuj.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Widzę, że nawet twój doradca przestał mnie szanować…";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "Sytuacja wymknęła się spod kontroli, nie masz pojęcia co robić i zjada cię stres.\n\nJak reagujesz?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Spróbuj uspokoić królową.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Zrozum, gubernator żywi do ciebie uczucia i nie wie, jak się zachować. Po raz pierwszy się zakochał.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "Królowa też jest poruszona. Najwyraźniej również coś do ciebie czuje. Czy to początek prawdziwej historii miłosnej? Czyżby wróżka miała rację?\n\nCzas pokaże. W międzyczasie królowa ma ochotę na kolejny taniec.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Od wielkiego balu minęło kilka miesięcy. Z królową Frygith łączy cię znajomość korespondencyjna. Czasem przybywa do ciebie w odwiedziny, jeśli pogoda na to pozwala.\n\nMoże kiedyś będziesz władać królestwem razem z nią. Na razie ma zbyt wiele pracy, by osiąść na laurach.\n\nTy też. Staraj się, by miasto funkcjonowało, jak należy.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Mieszczanie cieszą się z twojego związku z królową. Liczba podróżnych zauważalnie się zwiększyła. Przyjeżdżają, by spróbować soku winogronowego i napoju, którego odmówiono królowej na balu. Podobno napitki te są tak pyszne, że ich zapasy zniknęły w niecałą godzinę.\n\nProduktywność tych dwóch budynków wzrosła!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Karty.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Rozłożę ci podstawowe karty, waszmości. Powiedzą nam co nieco o tym, jaką osobą jesteś, oraz jaki los cię czeka. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Po zakończeniu pierwszego rozdania wróżka ponownie tasuje karty.\n\nProsi cię o wybranie trzech z nich. Po jednej na przeszłość, teraźniejszość i przyszłość.\n\nWybierasz karty, a ona odwraca je jedna po drugiej.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Och, waszmości, te trzy karty mówią, że czeka cię bardzo trudny czas. Powinieneś wystrzegać się ludzi z kościoła. Widzę, że w przeszłości już próbowali się do ciebie zbliżyć, ale bez powodzenia.\n\nPamiętaj, że cię ostrzegałam.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Wspaniałe rozdanie, waszmości! Same pozytywy. Poznasz kobietę, cudowną kobietę, która całkowicie zawładnie twoim sercem. Miłość czeka tuż za rogiem! Bądź gotów, gdy zapuka do twych drzwi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Widzisz, jak młoda kobieta tasuje karty i szepcze im twoje imię, aby przekazać im twą energię.\n\nNastępnie prosi cię o wybranie prawego lub lewego stosu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Mam nadzieję, że przepowiednia się nie sprawdzi i że pobożni mieszkańcy miasta są szczęśliwi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Następnego poranka podchodzi do ciebie mnich. Informuje cię, że kościół potrzebuje więcej surowców i przydałoby się kolejne miejsce kultu.\n\nPrzypominasz sobie o przepowiedni wróżki.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Waszmości, nowy kościół rozbudziłby duchowość obywateli. Dziękuję.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Zbuduj nowe miejsce modlitwy.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Doskonale! Zobaczysz, dobrze wykorzystamy to nowe miejsce kultu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Lewy stos.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Ta karta oznacza, że nosisz w sobie mrok, który doprowadzi cię do samozniszczenia. Obawiam się, że będzie to miało wpływ na produktywność twojego ludu.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Wyczuwam, że czujesz się zdezorientowany, a że twój doradca ponagla cię do wyjścia. Ale zostań jeszcze przez chwilę, to nie koniec. Drugie rozdanie może zapewnić bardziej szczegółowe odpowiedzi.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Waszmości, wróżka mówi prawdę, na najbliższy weekend mamy zaplanowaną wizytę. Mamy więc wystarczająco dużo czasu na zaplanowanie przyjęcia i wystrojenie się!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Zorganizuj przyjęcie";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Dobre przyjęcie nie może odbyć się bez posiłku i napoi. Zacznijmy od tego, waszmości.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Idealnie! Teraz mamy wystarczająco dużo prowiantu, by nasi goście byli zadowoleni.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Waszmości, powinieneś jak najbardziej przyłożyć się do tego przyjęcia. Wyobraź sobie, że możesz spotkać na nim swoją bratnią duszę!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Twój doradca może mieć rację, decydujesz się więc na wystrojenie w najpiękniejsze szaty. Całe miasto lśni, a ty bez wahania demonstrujesz swoje bogactwo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Ten moment zapisze się w historii! To na pewno zaimponuje twojej potencjalnej miłości.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Prawy stos.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Jesteś opiekuńczą osobą. Karty mówią mi, że to będzie miało wpływ na produktywność twoich mieszkańców!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "Kryształową kulę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "To bardzo dobry wybór, gubernatorze. Proszę, podejdź bliżej i spójrz w kryształową kulę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "Wróżka zbliża dłonie do kryształowej kuli. Nagle pojawia się niebieski dym.\n\n„Och, waszmości, spadnie na ciebie wielkie nieszczęście. Widzę mnichów. Być może to oni będą źródłem tego niepowodzenia”, mówi z żalem.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "Wróżka zbliża dłonie do kryształowej kuli. Nagle pojawia się różowy dym.\n\n„Och, waszmości, odnajdziesz miłość! Taką prawdziwą! Czeka na ciebie niesamowita historia, widzę to!”, mówi z pewnością w głosie.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Wychodzisz i idziesz płakać do swojej komnaty.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "W panice uciekasz z sali balowej i padasz z płaczem na łóżko w swojej komnacie.\n\nWszystko wskazuje na to, że cierpisz na złamane serce. Tylko czas może wyleczyć tę ranę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Od kilku miesięcy powoli próbujesz sklejać swoje złamane serce.\n\nKrólowa Frygith nawet nie zapytała, jak się masz, twój los w ogóle jej nie obchodzi.\n\nZ drugiej strony, przejdziesz do historii jako zakochany gubernator. Obywatele ci współczują i zaczęli pracować wydajniej.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Przynieś jej napitek.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "Decydujesz się wyruszyć do domu wróżki w towarzystwie swojego doradcy. Być może pomoże ci ona zapobiec jakimś nieszczęściom lub przekaże ci dobre wieści.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "Wróżka mieszka niedaleko zamku. Wchodzisz do niewielkiego namiotu, gdzie otacza cię całe mnóstwo mistycznych przedmiotów. W jakiś sposób cię to uspokaja.\n\n„Och, waszmości, proszę usiąść. Tak się cieszę, że zaakceptowałeś moje zaproszenie. Którą metodę wybierasz?”";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Przynieś jej nieco soku winogronowego.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Podziwiasz paradę ze szczytu swojego zamku. Nagle w oddali dostrzegasz nadciągającą procesję. Twoją uwagę przykuwa piękna kobieta, a twe serce bije jak szalone. \n\nCzy właśnie na tym polega miłość od pierwszego wejrzenia?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Oszalały z miłości decydujesz się na spotkanie się z tą piękną nieznajomą. Po tym, jak prawie potykasz się na schodach, resztę schodów pokonujesz na czworakach. Twój idący normalnie doradca nie może zrozumieć, co się z tobą dzieje.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Waszmości, oto królowa Frygith. Nie wiem, co cię skłoniło, aby dostać się do niej tak prędko.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Gubernatorze, miło mi cię poznać.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "Królowa Frygith oczarowała cię swoją osobą i nie wiesz, jak się zachować. Na szczęście pomaga ci twój zaufany doradca – dzięki niemu odzyskujesz zdrowy rozsądek.\n\nDecydujesz się zaprosić królową Frygith na dzisiejszy bal. Masz nadzieję, że wyrazi zgodę na tę pierwszą romantyczną randkę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Królowo Frygith, gubernator zaprasza cię jako swoją osobę towarzyszącą na bal, który odbędzie się dzisiejszego wieczoru. Czy uczynisz nam ten zaszczyt i zaakceptujesz zaproszenie?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "To wysoce niestosowne! Jestem obiecana księciu Cannes, nie mogę być widziana w ramionach gubernatora.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Z radością przyjmuję to zaproszenie.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "W końcu nadeszła pora balu. Poprosiłeś najbardziej prestiżowych muzyków o wystąpienie tego wieczora. Chcesz, aby wszystko było absolutnie perfekcyjne dla twojej ukochanej.\n\nW końcu królowa Frygith przybywa odziana w elegancką suknię. Każda sekunda spędzona w jej towarzystwie sprawia, że twoja miłość przybiera na sile.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "Muzyka zaczyna grać, a królowa Frygith także zdaje się być oczarowana. Nadeszła pora na przerwę i królowa prosi cię o coś na ochłodę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Nie masz jej nic do zaproponowania.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Odrzuć zaproszenie.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Słusznie postąpiłeś, gubernatorze. Kto wie, w jakie kłopoty mogliśmy się wpakować!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Ze złamanym sercem postanawiasz w ogóle nie pojawić się na balu. Rozpaczasz przez długi czas, co odbija się na twoim mieście. Produktywność oraz szczęście twoich mieszkańców spadają. Miejmy nadzieję, że to tymczasowe.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Pokonujesz smutek i znów zaczynasz widzieć światełko w tunelu. Powoli zaczynasz wychodzić ze swojego pokoju.\n\nLud jest zadowolony z tego, że wydobrzałeś, co pozytywnie wpływa na ich produktywność i morale.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Dziękuję ci, gubernatorze, jesteś niezmiernie urzekającym mężczyzną. Czy zechciałbyś wykorzystać ten wieczór do zawarcia umów handlowych, abyśmy mieli jeszcze okazję do ponownego spotkania?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Zostawię cię z królową, gubernatorze.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Jesteś z władczynią sam na sam w królewskim ogrodzie. Jak w bajkach. Czas stanął dla ciebie i królowej Frygith. Zbierasz się na odwagę i wyznajesz jej swoje uczucia. Okazuje się, że królowa je odwzajemnia!\n\nNiestety, wschodzi słońce i królowa musi wracać. Ma wiele spraw wagi państwowej na głowie. Wiesz, że ciężko jest rządzić krajem w pojedynkę.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Mieszczanie cieszą się razem z tobą, w dodatku prawdopodobieństwo strajku spadło, a to świetna wiadomość.\n\nKoniec końców rozmowa z wróżką okazała się słuszną decyzją.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Chętnie się do niej wybiorę!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Waszmości, masz straszne wieści. Ludzie zmuszani do uczestnictwa w nabożeństwie są zniechęceni i u kresu wytrzymałości. Módlmy się, by im przeszło! Nakazanie uczestnictwa w mszy było złą decyzją!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Sprawa kościoła i wróżki to już przeszłość. Ludzie odzyskują dawne szczęście.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Decyzja okazała się słuszna, waszmości! Dobrze, że msza jest obowiązkowa. Mieszczanie są teraz szczęśliwi i bardziej produktywni.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "Religijny przywódca osady chciał się z tobą zobaczyć.\n\n„Waszmości, muszę o coś zapytać. Czy uczestnictwo w mszy mogłoby stać się obowiązkiem? Nasi obywatele są wodzeni na manowce przez tych wszystkich wróżów. Chcę ich ocalić, nim będzie za późno”.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Zaakceptuj prośbę.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Przysięgam, waszmości, nie pożałujesz!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Odrzuć prośbę.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Rozumiem, waszmości. Wróżka namieszała ci w głowie. Trzeba było trzymać się od niej z daleka!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Skoro religia nie jest dla ciebie ważna, zniszczymy miejsca kultu! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Waszmości, to straszne! Wściekli mnisi zniszczyli budynki w mieście! Nie udało się ich złapać, uciekli! Następnym razem lepiej skonsultuj się z wróżką, żeby tego uniknąć.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Jako twój doradca nigdy więcej nie pozwolę ci spotkać się z wróżką! Wracajmy do konkretów, waszmości. Mieszkańcy są teraz w paskudnym nastroju.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Waszmości, tego popołudnia do miasta przybyło kilku podróżników. Pośród nich znajduje się wróżka. Przesyła ci zaproszenie, aby ci powróżyć.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "Wróżka";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Może po prostu przestaniecie je jeść? ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Przeprowadź śledztwo.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Zniszcz chaty rybackie.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "To okropne! Mieszkańcy nadal jedli ryby z braku lepszego jedzenia, więc choroba się rozprzestrzeniła!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "Mamy zarazę pod kontrolą, waszmości. Mieliśmy szczęście.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Te kontrole jakości słono nas kosztują, ale lepsze to niż użeranie się z epidemią!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Wszystkie chaty rybackie zostały sprawdzone, a ryby znowu są jadalne! Miałeś rację, inwestując w tą decyzję. Uniknęliśmy prawdziwych kłopotów.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "Zniszczenie tych chat rybackich umożliwiło nam wyeliminowanie możliwego źródła skażenia ryb. Szkoda tylko, że tak piękne budynki musiały zostać zrównane z ziemią.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Gubernatorze, nie chcę kaprysić, ale muszę przyznać, że nasze ryby… nie są już takie jak dawniej. Nie wiem, czy to przez rzekę lub coś innego, ale są absolutnie obrzydliwe! Jeśli się tym nie zajmiemy, to ktoś się może rozchorować.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Świeże ryby!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Dbaj o duże zadowolenie członków społeczności.";
"T_GAME_QUEST_GETREWARD" = "Odbierz nagrodę!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Waszmości, nie wiem jak to powiedzieć… Weź głęboki oddech. Jesteś gotów? Cóż… Wielu mieszkańców mówi, że widzieli ogromnego królika.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "No i co z tego?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "Ogromnego królika?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "I co z tego?! Ależ waszmości, to absolutnie przerażające! Wyobraź sobie, że skacze wokół zamku i równa domy z ziemią!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Dla tych kilku domów, które mamy…";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Musimy działać SZYBKO!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Ach, to już bardziej logiczna reakcja, waszmości.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Zbudujmy chatę myśliwską.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Wyślij list do pałacu i poproś o emisariusza.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Zorganizowaliśmy polowanie, ale nie udało nam się dorwać ogromnego królika. Mamy teraz jednak sporo zapasów…";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Mamy jakiś trop?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Mój obowiązek został spełniony, więc teraz utnę sobie drzemkę.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "Waszmości, przybył emisariusz.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Żądam pomocy od armii królewskiej.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Dołącz do emisariusza, aby zobaczyć dowody.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Co ja słyszę? Ogromny królik włóczy się po twoich ziemiach? Czy przypadkiem słońce zbyt mocno ci nie przygrzało…?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Hm, rozumiem. Ślady ogromnych królików… Taka historia opowiadana niegrzecznym dzieciom. „W nocy przyjdzie do ciebie ogromny królik i wyrwie ci uszy”. ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "I co wtedy? Mam inne rzeczy do roboty.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Odwiedź czarownicę.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Moglibyśmy udać się do czarownicy i poprosić ją o poradę. Być może wie coś o tym słynnym ogromnym króliku.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Czekałam na ciebie. Kruki przepowiedziały mi twoje przybycie. Ależ były głośne… ale i tak cichsze niż skoki tamtego królika.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Pomódl się.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Użyj magii.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Nic nie rób.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Więc to prawda?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "No pewnie, że tak! Długo ci zajęło dotarcie tutaj. Na szczęście nadal mamy czas. Masz teraz kilka możliwości do wyboru.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Widzę, że nie dbasz o swoich mieszkańców bez względu na okoliczności, waszmości… Prędzej czy później to obróci się przeciwko nam.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "W porządku, zbudujmy dwie chaty myśliwskie i zbierzmy trochę mięsa. Kto wie, może przy odrobinie szczęścia odnajdziemy jamę tego ogromnego królika.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Znam się na tym. Przyrządzę dla ciebie miksturę, ale musisz dostarczyć mi trochę składników. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Wszystko dobrze? Przekażesz mi te składniki?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Bardzo ci dziękuję, waszmości. Psiakość! Zapomniałam o drugiej połowie składników.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Och, waszmości, nie mamy całego dnia. Mam miksturę do przyrządzenia. Może przekażesz mi teraz te składniki?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Dziękuję ci bardzo, waszmości. Oto mikstura. Wlej ją do studni w osadzie i poczekaj jakiś czas. Ogromny królik sam odejdzie, gdy tylko ją poczuje.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Waszmości… Musimy zbudować łaźnie i dodać sporo olejków eterycznych, aby pozbyć się zapachu, który ciągnie się za mieszkańcami… Jest naprawdę okropny.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Świetnie! Miasto znów może oddychać!\nKrólik zniknął bez śladu, zupełnie tak, jakby był wytworem wyobraźni. Mój panie, na razie możemy powrócić do naszych obowiązków.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Koniec końców królik sam opuścił miasto. Jednym ze swoich ostatnich skoków odkopał skrzynię zakopaną przez bandytów dawno temu. Było w niej 2000 złotych monet, a król uznał, że należą się nam punkty prestiżu!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Cóż… dopiero przybycie ogromnego królika przekonało cię, by rozważyć zbudowanie kościoła!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Pośpieszmy się i zbudujmy ten kościół, aby mieszkańcy mogli zebrać się na modlitwę.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Jedyne, co nam pozostało, to oczekiwanie na boską interwencję.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Królik zniknął bez śladu, zupełnie jakby był wytworem wyobraźni. Mój panie, na razie możemy powrócić do naszych obowiązków.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Auć. Moim wyborem byłaby mikstura, ale to ty tutaj rządzisz! Powodzenia, waszmości, ze wszystkimi nadciągającymi nieszczęściami.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Ogromny królik";
"T_GAME_QUEST_INN_STARTED" = "Waszmości, wymagane będzie dodatkowe zakwaterowanie. Może zbudujemy zajazd? W ten sposób wyjdziemy naprzód potrzebom gości festynu.";
"T_GAME_QUEST_INN_SUCCESS" = "Wykonaliśmy dobrą robotę. Teraz poświęćmy trochę czasu na zastanowienie się nad resztą przygotowań.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "To zbyt ryzykowne.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Dlaczego nie?";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Żartownisia.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "Królewski dwór jest zachwycony! To właśnie tego potrzebowali! Punkty prestiżu są nasze! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "Mieszczankę opowiadającą zagadki.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Niestety, te zagadki… okazały się zbyt skomplikowane. Królewski dwór wolałby coś mniej intelektualnego. Tym razem nie zdobędziemy prestiżu.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "Akrobatę.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "Dwór króla jest pod wrażeniem tego utalentowanego akrobaty! W ramach nagrody król przyśle nam trochę punktów prestiżu.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Masz rację, kto wie, co się stanie, jeśli król nie będzie zadowolony z naszych kandydatów.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Waszmości, otrzymaliśmy wiadomość ze stolicy. Król jest zawiedziony, że nikt z naszego miasta nie przybył, aby zaoferować mu swoje usługi. Na szczęście nie potępi nas za coś tak trywialnego. Nasz władca jest niezmiernie łaskawy!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Znalazłem trzech potencjalnych kandydatów. Którego z nich powinniśmy wysłać?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Mój panie, król zażyczył sobie błazna, który będzie zapewniał mu rozrywkę. Czy powinniśmy posłać mu kilku potencjalnych kandydatów, którzy mogliby zostać nowymi błaznami?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Nadworny błazen";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Napraw dach.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Musimy go jak najszybciej naprawić!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Nie teraz.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Mamy teraz inne priorytety, wkrótce zacznie się festyn lawendy, a nie wszystko jeszcze gotowe.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "A propos, powinniśmy kończyć już przygotowania.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Teraz lepiej! Zapowiada się dochodowe wydarzenie!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Waszmości, podobno kupcom lawendy bardzo spodobała się nasza katedra. Teraz nie chcą przybyć na nasz festyn!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "Festyn lawendy rozpoczął się bezproblemowo, jednak uczestniczyło w nim znacznie mniej ludzi niż kiedyś! To wydarzenie nie przysporzyło nam prestiżu.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Zgoda!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Szybko, wyprodukujmy towar dla królowej.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Teraz musimy tylko dokonać wymiany.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Interesy z tobą to przyjemność.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Waszmości, mam złe wieści! W nocy światowy symbol naszej kultury stanął w płomieniach! Wspaniała katedra straciła dach!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Fachowcy twierdzą, że na naszych ziemiach zabrakło szlachetnego drewna. Ale królowa Frygith posiada niezbędne surowce. Poprosimy ją o pomoc?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Proś o pomoc.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Natychmiast wysyłasz królowej wiadomość. \n\n„Pomóż mi, królowo Frygith! Czy mogę pożyczyć szlachetne drewno z twoich ziem? Moja katedra się rozpada”.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Mój drogi, dobrze się składa. Akurat kończą mi się zapasy soku, może się wymienimy? Antałki soku za drewno, którego ci trzeba.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Waszmości, to niekorzystna propozycja…";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Rozważasz plusy i minusy tej wymiany. Być może królowa rozwiąże wszystkie twoje problemy… Chyba że jest inne wyjście?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Przemyśl to.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Ta prośba może nadszarpnąć naszą reputację, zróbmy inaczej. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Doradca może mieć rację. Proszenie królowej Frygith o pomoc uzależni cię od jej dobrej woli. Jeśli pojawi się kolejny problem, możesz sporo stracić.\n\nA może kamień? W kopalniach jest go w bród.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Mądra decyzja, waszmości! Jesteśmy wolni i niezależni.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "Lawendowy festyn okazał się sukcesem, a opowieści o renowacji katedry spotkały się z entuzjastycznym przyjęciem – dużo na tym zyskaliśmy!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "I tak nie przepadam za lawendą.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "No dobra! Naprawimy ją.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Absurd.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Waszmości, to szantaż! Wykorzystajmy kamień, nie musimy układać się z królową!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Dobrze. Nie zapomnę tego, mój drogi.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Król drewna";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Zajmę się tym.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Jeśli są niezadowoleni, to nie powinni tu więcej przychodzić.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "To prawda, że kupcom przydałoby się miejsce inne niż rynek. Gildia kupiecka byłaby idealnym rozwiązaniem, waszmości.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Cudownie, waszmości! Dziękuję, że się na to zgodziłeś. Będziemy ci dozgonnie wdzięczni!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Tak nowoczesny gubernator jak ty powinien był zaakceptować prośbę kupców…";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Waszmości, przybywam jako przedstawiciel kupców. Aby okazać ci nasze rozczarowanie, przez jakiś czas nie będziemy zaglądać do twojego miasta! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Waszmości, zrzeszenie kupców domaga się postawienia budynków, które spełnią ich potrzeby.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Brak miejsca";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Właśnie się budzisz, gdy doradca przynosi ci okropne wieści! W mieście pojawiła się plaga myszy! Są mniej niebezpieczne od szczurów, ale i tak musimy coś z nimi zrobić!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Waszmości, stworzyliśmy Akademię dla Kocich Łowców Myszy, ale… trzeba je najpierw wykarmić. Musimy dostarczyć do akademii ryby.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Tyle ryb powinno wystarczyć. Niektórzy rekruci już wyłapali sporo myszy, waszmości.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Waszmości, nagródźmy najlepsze koty kocimiętką, będą się mniej stresować.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "Sprawność łowców myszy wyraźnie wzrosła, waszmości. Nauczyciele dobrze wyszkolili koty. Pozostało już niewiele gryzoni.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Waszmości, myszy przestały być problemem. Gratuluję słusznych wyborów, to wszystko dzięki nim.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Opracuj plan.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Postanawiasz zjeść śniadanie. Chrupiąc tosta, zauważasz mysz w kącie pomieszczenia! A więc są nawet w zamku! Nagle znikąd wyskakuje Ptyś, twój wierny kot, który pożera mysz w kilka sekund. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Masz pomysł. Prosisz doradcę, by wyłapał jak najwięcej kotów i wyszkolił je do polowania na myszy. Nawet koty domowe mają przejść szkolenie i pozbyć się gryzoni.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Idź dalej spać.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Gdy się budzisz, myszy jest tak dużo, że nie da się normalnie chodzić. Wszyscy mieszkańcy zostali spowolnieni!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Po dłuższym czasie myszy wyniosły się same. Uciekanie przed odpowiedzialnością w sen nie zawsze jest dobrym rozwiązaniem.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Kotek i myszka";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "Po prawej stronie możesz zobaczyć aktywne obecnie wpływy.\nNiektóre wpływy mogą być aktywne tylko tymczasowo i ulegać zmianie w trakcie trwania scenariusza.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Mój panie,\nz całym szacunkiem, ale chyba nie dostrzegasz niezadowolenia swoich podwładnych. To nie może już dłużej trwać.\nCo więcej, produkowane przez nas towary nie są prawidłowo przetwarzane.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Teraz już wiesz, jakie wpływy oddziałują na miasto. Być może dostrzegasz, że zamieszkujący okolicę bandyci obniżają ogólne szczęście mieszkańców.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Odwiedź menu pauzy, aby zobaczyć obecne wpływy na tej mapie.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Czy możesz udać się do tartaku?\nMusimy wstrzymać produkcję! Mamy za mało drewna, ale za dużo desek!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Aby uzyskać więcej informacji o danych budynku, wystarczy do niego pójść!\n\nMenu kontekstowe zawiera bardzo przydatne informacje na temat danego budynku, jego pracowników i powiązanych łańcuchów produkcji. Gdy je przeglądasz, gra zostaje wstrzymana.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Tartak potrzebuje więcej drwali, aby sprawniej produkować deski.\n\nPowinniśmy wstrzymać pracę tartaku do czasu wybudowania większej liczby leśniczówek i zgromadzenia surowców budowlanych.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Powinniśmy uważać, by surowce nie zapchały magazynu, wasza miłość.\nJeśli będzie ci potrzebna wolna przestrzeń w magazynie, możesz użyć funkcji niszczenia surowców dostępnej w menu statystyk.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Przejdź do menu magazynu.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Powinniśmy uważać, by surowce nie zapchały magazynu, wasza miłość.\nJeśli będzie ci potrzebna wolna przestrzeń w magazynie, możesz użyć funkcji niszczenia surowców dostępnej w zakładce magazynu w menu gry.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Niszcz deski, aż będzie ich mniej niż 100 szt.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Zniszcz trochę desek, aby zrobić miejsce w magazynie.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Nie traktujesz moich gróźb poważnie, gubernatorze.\n\nŻarty się skończyły!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Całkiem niezła osada.\n\nSzkoda, że na moim terenie! Dostarcz mi biżuterię i odzież! I lepiej się pośpiesz, albo twoja osada zostanie zrównana z ziemią…";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Niesamowite, co potrafi zdziałać drobna groźba. Nie sądziłem, że naprawdę mi wyślesz te towary.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Zapłać daninę bandytom.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Moi chłopcy strasznie się nudzą. Wyślę ich na małą wycieczkę…\n\nDO CIEBIE!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Jak widzisz, biorę to, co zechcę!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Dzień dobry, wasza miłość.\n\nPrzybywam na rozkaz króla, by nauczyć cię sztuki walki.\n\nTwój problem z bandytami wkrótce zostanie wyeliminowany, wasza miłość.";
"T_GAME_QUEST_MIL_TUT_10_START" = "Koszary są podstawą twoich działań militarnych w okolicy i umożliwiają budowanie wież strażniczych oraz ich zaopatrywanie. Żołnierze walczą dobrze tylko wtedy, gdy są dobrze zaopatrzeni.\nMusisz umieścić wieże w taki sposób, aby pokryć jak największą część osady.\n\nZbuduj koszary i wieżę strażniczą, mój panie.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Faktycznie z pomocą przybył ci jakiś rycerz…\nJuż się trzęsę ze strachu.\nSprawdźmy, jak twoje wojsko poradzi sobie z moimi chłopcami…";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Bandyci podpalają nasze zabudowania. Gdzie się podziewa ten strażak, gdy go potrzeba?!\n\nJeśli chcesz poznać miejsce przebywania jakiegoś mieszczanina, możesz użyć opcji „Znajdź mieszczanina” w menu kontekstowym danego budynku.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Możesz tutaj podejrzeć, czym się obecnie zajmują pracownicy.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Wyprodukuj podpiwek i kiełbasę.";
"T_GAME_QUEST_MIL_TUT_14_START" = "Nasi żołnierze potrzebują podpiwka, aby dodawać sobie płynnej odwagi, wasza miłość.\n\nAby go wyprodukować, musisz zlecić budowę przyklasztornego browaru oraz suszarni chmielu.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Nasi żołnierze potrzebują podpiwka, wasza miłość.\nAby go wyprodukować, musisz zlecić budowę klasztoru oraz plantacji chmielu, mój panie.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "Przyklasztorne browary potrzebują surowców z innych budynków.\nSuszarnia chmielu zaopatruje browar w chmiel. Gospodarstwo i studnia dostarczają pszenicę i wodę.\n\nDopiero wtedy mnisi mogą rozpocząć produkcję podpiwka, wasza miłość.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "Mnisi w klasztorze mogą się zajmować pozyskiwaniem chmielu z plantacji lub procesem warzenia podpiwka.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Zbuduj klasztor i suszarnię chmielu.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Zbuduj klasztor i plantacje chmielu.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Aby produkować kiełbasę, potrzebna będzie ferma trzody chlewnej oraz rzeźnia, wasza miłość.\n\nNasi żołnierze uwielbiają, gdy kiełbasa jest pikantna. Niezbędne przyprawy mogą być pozyskane przez rolnika z ogrodu ziołowego.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Rzeźnia może produkować nie tylko kiełbasę uwielbianą przez naszych żołnierzy, ale i zwykłe mięso.\nTo dobra opcja, aby uniezależnić się od polowań na zwierzynę w lasach.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Zbuduj fermę trzody chlewnej i rzeźnię.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Lepiej poćwicz jeszcze obronę!\nDo następnego… I dzięki za surowce.";
"T_GAME_QUEST_MIL_TUT_16_START" = "Podpiwek i kiełbasa!\n\nMoi chłopcy uwielbiają te przysmaki. Myślę, że już pora podzielić się ze mną tymi znakomitymi towarami.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Tym razem ci się poszczęściło, gubernatorze. Następnym razem moi chłopcy przybędą w większej liczbie.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Obroń swoją osadę.";
"T_GAME_QUEST_MIL_TUT_17_START" = "Nasza osada potrzebuje dalszych usprawnień. Większość jej terenów nie jest odpowiednio chroniona. Musimy pokryć większy obszar wieżami strażniczymi.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Większość obszaru naszej osady jest już chroniona przez żołnierzy. Bandyci nie będą już nas okradać z taką łatwością, mój panie.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Zabezpiecz co najmniej 50% terenu osady wieżami strażniczymi.";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Jeśli chcesz uzyskać więcej informacji o wojsku, możesz w każdej chwili przejść do ekranu statystyk na karcie wojska.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Nasi żołnierze potrzebują uzbrojenia i pancerzy!\nBroń zwiększa siłę ataku, a pancerz możliwości obronne twoich żołnierzy.\n\nW związku tym musimy zbudować zbrojownię. Produkcja pancerzy będzie wymagała również garbarni, by zyskać dostęp do skór użytkowych.\nSkóry zwierzęce dostarcza myśliwy lub rzeźnik.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Zbuduj garbarnię i zbrojownię.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Mój panie,\nnajwyższa pora powiększyć twoją armię. Następnie będzie ją można wysłać, aby zniszczyła obóz bandytów.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Powiększ swoją armię";
"T_GAME_QUEST_MIL_TUT_21_START" = "Już pora, gubernatorze!\n\nMożemy zaatakować tego nikczemnego dowódcę bandytów. Jego obóz jest ukryty w lesie.\nWystarczy, że zaznaczysz obóz i wyślesz odpowiednią liczbę żołnierzy do ataku.\n\n\nUdanych łowów!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Zniszcz obóz bandytów.";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Jak dobrze, że jesteś, wasza miłość.\nWłaśnie okradli mnie bandyci, już trzeci raz w tym tygodniu. Powinniśmy podjąć jakieś kroki przeciwko tym potworom!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Wspaniałe zwycięstwo, wasza miłość.\nPokazaliśmy tym bandytom, kto tu rządzi! Okolica znowu jest bezpieczna, a król będzie bardzo zadowolony. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Ukończ podstawowe szkolenie i pokonaj bandytów.";
"T_GAME_QUEST_NEW" = "Nowe zadanie!";
"T_GAME_QUEST_NEW2" = "Nowe zadanie:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Nie mamy czasu na coś takiego.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Masz rację.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "W porządku, waszmości, więc nic nie zrobimy w kwestii okropnego chleba. Już słyszę te skargi na paskudne jedzenie. W każdym razie… twoje życzenie jest dla mnie rozkazem, waszmości.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Och, waszmości, teraz chleb jest pyszny! Wzrastają także ceny sprzedaży.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = "„Twoim zmartwieniem jest pszenica, a problemem należy zająć się u podstaw. Powiedz młynarzowi, aby używał czystej wody. Niech wykorzystuje drożdże najlepszej jakości”.\n\nTwój doradca przekazuje twą mądrość piekarzowi i obiecuje, że od teraz chleb będzie lepszy.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Waszmości, musimy coś zrobić. Chleb nie jest taki jak wcześniej. Wiele osób skarży się na jego słabą jakość. Powinniśmy zmienić przepis.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Nowy przepis";
"T_GAME_QUEST_NOQUEST" = "Brak zadań.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Pośpieszmy się i wyprodukujmy tarcze i broń. Jeśli ci ludzie są niebezpieczni, to lepiej być przygotowanym.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Gubernatorze, ukończyliśmy przygotowania do obrony miasta.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Twoi żołnierze donoszą o ruchach wojsk na północy. To właśnie tam położone jest największe pustynne królestwo.\n\nWiesz jednak, że żaden szaleniec nie próbowałby atakować twoich granic z tej strony. Decydujesz się zignorować to zagrożenie. Co będzie, to będzie!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Kilka dni później żołnierze donoszą o grupie osób nadchodzących prosto z pustyni na północy. Dotrą do miasta za kilka godzin.\n\nMogą być zwykłymi podróżnikami, ale kto wie, może to niebezpieczni bandyci, którzy chcą najechać na twoją osadę!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Przygotuj obronę.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Przygotujcie serdeczne powitanie.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Północna pustynia";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Grupa dziesięciu osób zbliża się do miasta. Twoi żołnierze pozostają czujni i czekają na twe rozkazy.\n\nPozwalasz im podejść bliżej. Przywódca grupy w pojedynkę podchodzi do bram miasta. „Dzień dobry, łaskawy panie, właśnie przekroczyliśmy północną pustynię. Czy możecie zaoferować nam gościnę na jedną noc?”";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Zapraszamy do naszego pięknego miasta, zatrzymajcie się w zajeździe, miejsca wystarczy dla wszystkich.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Gdy twój doradca odprowadza cię do domu, nadal masz się na baczności. Dlaczego ryzykowali przeprawę przez pustynię, gdy mogli po prostu pożeglować wzdłuż rzeki? Z pewnością wybrali niebezpieczną drogę, żeby się ukryć.\n\nMoże twoi szpiedzy będą w stanie dowiedzieć się na ich temat czegoś więcej. Możesz też po prostu pójść spać.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Idź spać.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Wyślij szpiega.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Twój szpieg spędził w zajeździe całą noc i udało mu się podsłuchać kilka rozmów: wędrowcy są zbiegami. Podobno popełnili jakieś przestępstwa w swoim kraju po drugiej stronie pustyni. Wysłano za nimi armię, więc już przygotowują dalszą drogę ucieczki.\n\nCo będzie najlepszym rozwiązaniem?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Zamknij wędrowców.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Właśnie dostaliśmy wiadomość od króla. Niebezpieczni kryminaliści uciekli z więzienia w sąsiednim kraju. Jest ich około dziesięciu i ukradli jakiś drogocenny przedmiot. Czy myślisz, że to ci wędrowcy, którzy zjawili się tu kilka dni temu?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Wyślij wiadomość do króla.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Zatrzymajmy to dla siebie.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Wyślę wiadomość do króla, by dać mu znać, że przeszli przez naszą osadę. Być może uda im się ich odnaleźć.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Waszmości! Królewskiej armii udało się dopaść tych niebezpiecznych osobników. Odzyskali skradziony skarb.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Dziękuję ci za twą pomoc, gubernatorze. Ci ludzie skradli jeden z moich drogocennych klejnotów i planowali sprzedać go na czarnym rynku. Słusznie postąpiłeś, informując mnie o ich obecności w twoim mieście.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "W porządku, waszmości. Gdy ktoś nas o to spyta, to nic nie wiemy.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Minęło trochę czasu, od kiedy w mieście wydarzyło się coś widowiskowego. Dziś masz jednak wrażenie, że coś się zmieni.\n\nI miałeś rację! Twój doradca przynosi ci list od wędrowców poszukiwanych przez królewską armię.\n\n„Dziękujemy ci, że na nas nie doniosłeś, gubernatorze. Widzisz, jesteśmy ofiarami spisku i cała nasza rodzina znajdowała się w wielkim niebezpieczeństwie. Dzięki temu, że zachowałeś w sekrecie naszą wizytę w twojej osadzie, mieliśmy wystarczająco dużo czasu, aby udowodnić naszą niewinność. Bez ciebie to nie byłoby możliwe, dlatego zaakceptuj ten dowód naszej wdzięczności. Jesteś dobrym gubernatorem”.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Uwolniłem wędrowców, waszmości, tak jak rozkazałeś. Mam nadzieję, że to nie obróci się przeciwko nam.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Wędrowcy dziękują ci za okazaną łaskę i obiecują, że gdy udowodnią swoją niewinność, w ramach wdzięczności przyślą ci prezent.\n\nMasz nadzieję, że podjąłeś słuszną decyzję i że wędrowcy cię nie oszukali.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Minęło kilka miesięcy, od kiedy ostatnim razem słyszałeś o tamtych wędrowcach. Czasami ich wspominasz. Nie miałeś żadnych kłopotów u króla, ale nie otrzymałeś także obiecanej nagrody.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Pewnego słonecznego poranka twój doradca przynosi ci paczkę oraz list. Jest w nim wiadomość od tajemniczych wędrowców, w której wyrażają swoją wdzięczność. W paczce znajduje się obiecana nagroda – prestiż oraz złoto.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Cieszysz się, że podjąłeś dobrą decyzję i cię nie oszukano.\n\nTwój doradca informuje, że wędrowcy cię wychwalają – stałeś się dla nich bohaterem. Cóż za wspaniałe czasy dla gubernatorów.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Waszmości, wędrowcy opuścili zajazd wczesnym porankiem. Wyglądało na to, że im się śpieszy.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Wędrowcy czekają na twoją odpowiedź. Niektórzy z nich wyglądają agresywnie, inni się boją.\n\n„Nie mogę was ugościć, wędrowcy. Nie mamy dziś wystarczająco miejsca”.\n\n„Kłamca!”, krzyczy nagle jeden z wędrowców, ruszając na ciebie z mieczem.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Bronić gubernatora!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Pośpiesz się, waszmości! Prędko! Musimy się przed nimi ukryć!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Udało ci się skryć w kryjówce razem ze swoim doradcą, który najwyraźniej kompletnie spanikował: „Waszmości, co my teraz zrobimy? Ci nikczemni podróżnicy równają naszą osadę z ziemią, a my nic nie możemy na to poradzić! Powinniśmy byli przygotować obronę, a nie bochenki chleba!”\n\nNiestety możecie tylko czekać.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Wczesnym rankiem opuszczasz swoją kryjówkę. Osada nie ucierpiała. Wygląda na to, że wędrowcy po prostu powalili strażników na ziemię i zabrali trochę zapasów na dalszą drogę.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Na szczęście zaplanowaliśmy kolejny ruch, waszmości. Z naszą bronią i tarczami będziemy w stanie ich odeprzeć. To pewne.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Waszmości, udało nam się pochwycić wszystkich wędrowców. Zamknęliśmy ich w więzieniu, abyś mógł podjąć decyzję.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Ci wędrowcy zachowują się coraz dziwniej. Odkąd są zamknięci, czujesz się nieco bezpieczniej. Coś jednak nie daje ci spokoju.\n\nCo zrobisz?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Przesłuchaj ich.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Powiadom króla.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "W porządku, panie, zadam im kilka pytań, aby wyjaśnić sprawę.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Twój doradca powrócił z informacjami na temat wędrowców.\n\nUciekli ze swego kraju, ponieważ zostali niesłusznie oskarżeni. Dowód na ich niewinność leży dalej na południe, w jednym z pobliskich miast.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Pozwól im odejść.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Doradzę więc królowi, że królewska armia może ruszyć, by złapać tych niebezpiecznych kryminalistów!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Królewska armia w końcu nadciąga. Przekazujesz wędrowców w ich ręce. Król przesyła ci nagrodę za dostarczenie informacji potrzebnych do złapania tych niebezpiecznych osobników.\n\nTwoja osada powoli dochodzi do siebie, a ty w spokoju powracasz do swoich obowiązków gubernatora.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Twój szpieg popełnił błąd i został zauważony przez wędrowców. Przetrzymują go jako zakładnika i żądają okupu, jeśli chcesz jeszcze zobaczyć go żywego.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Stracimy sporo pieniędzy, ale przynajmniej nasz szpieg będzie bezpieczny.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Dziękuję ci, waszmości, za zapłacenie okupu, by mnie uwolnili! Bałem się o własne życie. Szpiegostwo jest bardzo niebezpieczne.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "To świetny pomysł. Powinniśmy przygotować jedzenie dla tych ludzi, gdy dotrą do naszych bram. Chleb i ryby będą idealne.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Wspaniale, teraz pozostało tylko na nich poczekać.";
"T_GAME_QUEST_PLACE_STARTED" = "Teraz nadszedł czas na zbudowanie miejsca odpowiedniego na wydarzenie na taką skalę!";
"T_GAME_QUEST_PLACE_SUCCESS" = "O la la, to wprost niesamowite! I pomyśleć, że nic z tego nie miałoby miejsca, gdyby strażnicy nie byli nadgorliwi. Miałeś wspaniały pomysł, aby wykorzystać tą okazję! Wygląda na to, że festyn okaże się sukcesem.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Zasadźmy więcej kwiatów.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "To nikomu niepotrzebne.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Pięknie! Te kwiaty są wspaniałe, ich zapach sprawia, że jestem w siódmym niebie!";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Jesteś okropną osobą. Nasze miasto przyozdobione kwiatami byłoby o wiele ładniejsze!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Znów mamy wiosnę, mój panie. Osada mogłaby skorzystać na dodatkowych kwiatach.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Piękne płatki";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "Spłonął tartak, wasza miłość. Czy zarządzisz odbudowę? Potrzebujemy go do produkcji desek!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Odbuduj tartak.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Nic nikomu nie dawaj.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Rozdziel zyski wśród mieszkańców.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Zainwestuj pieniądze w kopalnie.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Waszmości, w skrzyniach mamy sporo pieniędzy. Redystrybucja części z nich byłaby korzystna dla miasta.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Mieszkańcy usłyszeli o twojej decyzji i nie są zadowoleni. Spróbuj okazać więcej troski o swój lud, waszmości.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "Twoja decyzja o redystrybucji środków przestała wpływać na produktywność mieszkańców. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Sprawiłeś mieszkańcom wielką radość! Są wręcz zachwyceni!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Wspaniała inicjatywa, waszmości. Zacznijmy budowę kopalni i wydobywajmy surowce.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Zainwestowanie posiadanych pieniędzy w budowę nowych kopalni to była prawdopodobnie najlepsza decyzja, jaką kiedykolwiek podjęliśmy. Dzięki tym surowcom będziemy mogli łatwiej się rozwijać.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Jesteś bardzo hojny, waszmości. Te pieniądze pozwolą im poprawić jakość życia.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Redystrybucja dochodów";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Mieliśmy szczęście, waszmości. Plony nie zostały uszkodzone, a dziki odeszły i już nie musimy się nimi martwić.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Waszmości, dziki zniszczyły nasze plony, a teraz ruszyły na gospodarstwo. To prawdziwa masakra.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "Populacja jest zrozpaczona tą stratą, która wpłynęła na szczęście i produktywność mieszkańców.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Waszmości, nasze plony zaczynają wyrównywać straty wyrządzone jakiś czas temu przez dziki. Uprawy odrastają, a ludzie powoli zapominają o tym, co się wydarzyło.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Wskutek twojej decyzji populacja jest zaniedbywana! Miejmy nadzieję, że te dziki nie zniszczą pól.";
"T_GAME_QUEST_REWARD" = "Nagroda:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Witamy, mości zarządco!\n\nSpójrz tylko na linię wybrzeża! Liczę, że twoja osada okaże się godna równie wspaniałych widoków!\nDbaj dobrze o swoich mieszczan i nie zapomnij płacić królowi daniny, coby twoja służba nie skończyła się raptownie!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Pożyczka z królewskiego skarbca.";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Gubernatorze,\njeśli brakuje ci funduszy, król może ci udzielić niewielkiej pożyczki, by pomóc ci wrócić na właściwe tory.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Witamy w naszej skromnej osadzie, gubernatorze.\nKrainę dzieli górska grań. Jej południowo-zachodnia część skrywa złoża rudy.\n\nJuż nie mogę się doczekać naszej współpracy.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Witamy, gubernatorze!\n\nJestem królowa Frygith i władam tą krainą. Pomóż mi doprowadzić tę osadę do świetności. Okolica obfituje w surowce, więc ich poszukiwanie nie będzie stanowić problemu. Nie zawiedź mnie.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Mój panie, spójrz tylko na nieskończony przestwór tej krainy. Płasko jak okiem sięgnąć! W bliskiej przyszłości zdołamy wznieść tutaj ogromne miasto, nie sądzisz?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Bądź pozdrowiony, gubernatorze.\nTereny leżące nad tą potężną rzeką zapewniają wiele okazji do rozwoju. Łowiska są rozległe, a kopalnie pełne rud. Powinniśmy tu założyć kwitnącą osadę w imieniu króla.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Doskonale, gubernatorze.\nW tym kanionie znajduje się jedna z najważniejszych dróg przez góry. Osada jest w idealnej lokalizacji, by stanowiła przyjemny przystanek dla przejeżdżających kupców. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Mój panie, u stóp tych wodospadów roi się od łowisk, a bogate złoża rud sprawiają, że region ten jest idealny do założenia naszej osady.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Witaj na Lodowym Wzgórzu, mój panie.\nMieszczanom nie jest łatwo wspiąć się do zamku, ale warto to zrobić dla widoku na równiny. Tu z góry twoje ziemie wydają się nie mieć końca.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Dzień dobry, wasza miłość.\n\nPopatrz na wzgórza rozpościerające się na twoich ziemiach. Czyż to nie wspaniały widok? To piękne miejsce na założenie miasta, wasza miłość.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Dzień dobry, mój panie.\n\nWitamy w naszej małej osadzie. Mówi się, że wądół powstał od uderzenia spadającej gwiazdy. Miejmy nadzieję, że przyniosła nam szczęście. Król pisał już, że wkrótce wyznaczy nam kilka zadań.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Danina dla króla.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festyn dla mieszczan.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Pomoc dla biednych.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Festyn podpiwka w osadzie.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Sprzedaj świnie na rynku.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Dokonaj wymiany na rynku zwierząt.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Wymieniaj zwierzęta na rynku.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Racje dla armii.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Wyposażenie dla żołnierzy króla.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Odeprzyj ataki bandytów.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Zniszcz obozy bandytów.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Witamy, mości zarządco! Spójrz tylko na to wybrzeże! Liczę, że twoja osada okaże się godna tych wspaniałych widoków!\nDbaj o swoich mieszczan i nie zapomnij płacić królowi daniny, coby twoja służba nie skończyła się raptownie!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Cóż za wspaniałe miejsce, by zająć się połowem ryb. Czyż nie, wasza miłość? Tutaj z pewnością nie zabraknie nam żywności!\nBardzo byśmy chcieli, aby co jakiś czas odbył się tu festyn, oczywiście jeśli zostaną na to środki po zapłacie daniny dla króla!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Och, kochanie, dziękuje za wybór tego miejsca! To jezioro jest przepiękne!\nMieszczanie z pewnością będą tutaj szczęśliwi, jeśli o nich zadbasz!\nNie zapominaj tylko o łapówce dla króla, żebyśmy mogli zostać tu na zawsze!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Mój panie, przenosiny do tej doliny rzeki były mądrą decyzją!\nMieszczanie z pewnością zaznają szczęścia, gdy pomożesz biednym i potrzebującym!\nPrzy całej twojej hojności sugeruję jednak, aby nie zaniedbywać obowiązków wobec króla!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Bądź pozdrowiony! Moi ludzie z dumą wesprą cię w budowaniu twojej siedziby w tym kluczowym punkcie naszej ziemi!\nTo będzie rok świętowania!\nNiech żyje król i wasza miłość też!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Mój drogi gubernatorze, wiele już o tobie słyszałem! I właśnie dlatego mam dla ciebie zadanie: załóż kwitnące miasto u stóp mojego zamku!\nLepiej zacznij od razu! Bywaj zdrów!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Wasza miłość, otrzymaliśmy zadanie założenia miasta w pobliżu wyschniętego koryta rzeki. Król sowicie nas wynagrodzi, jeśli dobrze wypełnimy swój obowiązek.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Mój panie, płaskowyż, na którym stoi twój zamek, to idealna lokalizacja dla uroczego miasteczka. Król przysłał ci również szereg zadań, które musisz wykonać.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Tuż przy wybrzeżu odkryto archipelag. Rozkazuję ci skolonizować te wyspy w moim imieniu!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Mój panie, spójrz na ten piękny leśny region. Budowa miasta w tym miejscu będzie ciężką pracą, ale przynajmniej jeleni i drewna jest pod dostatkiem.\n\nPowinno to ułatwić wypełnienie zadań, które zlecił nam król.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Wasza miłość, spełnienie wymagań króla dotyczących daniny będzie trudne ze względu na srogą zimę. Zabierzmy się od razu do pracy…";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Cóż za cudowna dolina. Jest tutaj wystarczająco dużo surowców, aby zapłacić daninę królowi. Ale uważaj, mało miejsca na budynki sprawia, że konieczne jest odpowiednie planowanie.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "To naprawdę piękna wyspa! Tak się cieszę, że tu przybyliśmy. Powinniśmy natychmiast zacząć planować naszą osadę!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Możemy stąd obserwować całą okolicę. Niestety na tej wysokości pora zimowa jest znacznie dłuższa, co ma poważny wpływ na uprawy.\n\nRozsądnie będzie zgromadzić zapasy latem.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Bądź pozdrowiony! Czekaliśmy na ciebie! Moi ludzie już zbadali ten region i znaleźli wiele obiecujących żył rudy.\n\nLepiej zacznijmy od razu je eksploatować, zanim zrobi to ktoś inny!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Mój panie, dobrze, że jesteś.\n\nPoprzedni gubernatoruciekł. Wrzeszczał przy tym, że ta okolica jest przeklęta.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Twój poprzednik miał nieco racji. Trudno uprawiać tutaj ziemię, jako że niewiele na niej rośnie. Zapasy wody również się kurczą. Na pewno znajdziesz jednak jakieś rozwiązanie.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Twoi mieszczanie są odrobinę niezadowoleni ze swojego życia duchowego, mój panie. Czy mógłbyś zbudować w osadzie kościół?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Osiągnij wysoki poziom szczęścia z religii.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Naprawdę oczekujesz, że ktoś tak ważny jak ja będzie się poruszał po drogach gruntowych? Zbuduj drogi, które będą godne prawdziwego miasta!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Zbuduj brukowane drogi w swojej osadzie.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Zbuduj drogi gruntowe w swojej osadzie.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Ktoś to wszystko nieźle spartaczył, mój panie. Wszystkie budynki wymagają poważnych napraw.\n\nMusimy zatrudnić cieślę, by naprawił zabudowania, nim się rozpadną.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Zbuduj stolarnię i osiągnij wysokie zadowolenie ze stanu budynków.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Gubernatorze! Dlaczego twoja osada jest taka mała? Jesteśmy w tyle za arcyksięciem!\n\nPrzegramy zakład, o ile wkrótce nie zwiększysz zaludnienia swojej osady!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Zwiększ zaludnienie swojej osady.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Nowe rodziny, które wprowadziły się do osady, mają za sobą długą, wyczerpującą podróż i są głodne. Zorganizujmy dla nich bankiet i świętujmy oficjalne rozpoczęcie zakładu, mój panie!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Wyprodukuj wystarczającą ilość żywności, aby wykarmić całą osadę.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Powinniśmy rozpocząć handel z wędrownymi kupcami. Ich obecność w mieście przyciągnie podróżnych i polepszy reputację osady, mój panie!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Zarób mnóstwo pieniędzy, handlując z kupcem.";
"T_GAME_QUEST_SCEN10_16_DESC" = "Uzyskiwany przez nas dochód z podatków jest pożałowania godny! Może należy wybudować skarbiec, aby go zwiększyć?";
"T_GAME_QUEST_SCEN10_16_NAME" = "Zbuduj skarbiec i zbieraj więcej podatków.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Biżuteria, potrzebuję biżuterii! Zastanawiam się jednak, jak zamierzasz ją dostarczyć, skoro nie masz nawet pracowni złotniczej.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Zbuduj pracownię złotniczą i rozpocznij produkcję biżuterii.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Doskonale, mój panie. Teraz możesz mi już wysłać cały wóz pełen biżuterii.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Dostarcz biżuterię kupcowi.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Mój panie, naszym priorytetem jest produkcja żywności. Potrzebujemy rybaków i myśliwych.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Buduj nowe chaty rybackie i chaty myśliwskie.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Mój drogi gubernatorze, nie będę cię mógł wesprzeć, dopóki nie zbudujesz targowiska.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Potrzebujesz targowiska, aby powiększyć swoją osadę.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Mój panie! Czy zbudowałeś już warsztat ślusarski? Arcyksiążę rozpoczął już produkcję narzędzi!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Zbuduj warsztat ślusarski i rozpocznij produkcję narzędzi.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Przy tej całej ciężkiej pracy chcielibyśmy mieć miejsce na relaks, spotkanie z przyjaciółmi i kubek soku winogronowego. Wspaniale byłoby mieć gospodę.\n\nOczywiście decyzja należy do ciebie, mój panie.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Osiągnij wysoki poziom zadowolenia z gospód.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Czy posiadamy wystarczającą przestrzeń mieszkalną, mój panie? Wszyscy nowi pracownicy, którzy przenoszą się do miasta, potrzebują dachu nad głową, nieprawdaż?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Zbuduj 2 duże i 4 zwykłe domy.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Zbuduj więcej dużych domów.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Zbuduj więcej małych domów.";
"T_GAME_QUEST_SCEN10_7_DESC" = "Osada potrzebuje ekstrawaganckich rozrywek, na przykład placów turniejowych. Zadbaj o dostęp do takich miejsc, nim przybędą ważni goście.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Osiągnij wysoki poziom zadowolenia z rozrywek.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Osiągnij wysoki poziom zadowolenia z placów turniejowych.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Mój panie, może moglibyśmy upiększyć tę ponurą osadę, tworząc jakieś posągi i dekoracje? Zróbmy to, zanim król ponownie nas odwiedzi.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Upiększ swoją osadę dekoracjami.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Dzień dobry, gubernatorze. Czy byłbyś zainteresowany handlem?\n\nPilnie potrzebuję dużej ilości odzienia, aby zawrzeć lukratywną umowę z arcyksięciem. Zapłacę bardzo dobrze, jeśli dostarczysz mi to, czego potrzebuję.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Dostarcz dużą ilość odzieży kupcowi.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "To absolutna katastrofa, gubernatorze! Arcyksiążę Canterborough nas uprzedził i ukończył budowę swojej osady, zanim my zdążyliśmy ukończyć naszą!\n\nLiczyłem na twoje wsparcie i teraz jestem naprawdę bardzo rozczarowany. Może wygranie tego zakładu było tylko szalonym snem. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Świetnie, mój drogi gubernatorze! Pokonaliśmy arcyksięcia w budowie i rozbudowie naszej osady. Zakład jest wygrany!\n\nJestem pod wrażeniem twojej skuteczności i osobiście dopilnuję, abyś został po królewsku wynagrodzony. Nadaję ci również tytuł księcia z wszelkimi prawami i przywilejami z nim związanymi.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Mój lojalny sługo, chyba porwałem się z motyką na słońce.\n\nZałożyłem się z arcyksięciem Canterborough, że zmienię najbardziej zacofaną osadę mojego królestwa w kwitnącą metropolię, zanim on zrobi to samo ze swoją najbardziej zacofaną osadą.";
"T_GAME_QUEST_SCEN12_01_START" = "Jak miło, że złożyłeś nam wizytę. Witam cię w imieniu wszystkich obecnych w klasztorze mnichów.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Witaj w naszym klasztorze, wasza miłość.\nOczywiście, że możemy ci pomóc z idealnym prezentem dla króla. Ale w tej chwili mamy pewne problemy z bandytami. Może ty też mógłbyś nam pomóc.";
"T_GAME_QUEST_SCEN12_02_START" = "Cóż za podstęp!\n\nKtoś ukradł nasze drewno! Nie możemy przechowywać podpiwka, jeśli nie mamy drewna na beczki.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Dziękuję, mój panie! Możemy już skonstruować nowe beczki.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Zbuduj kilka leśniczówek.";
"T_GAME_QUEST_SCEN12_04_START" = "Wasza miłość, osada została powiększona, abyśmy mogli ukończyć nasze zadania. Na początek musimy zadbać o stabilną gospodarkę. Będziemy do tego potrzebować narzędzi.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Doskonale, mój panie. Teraz możemy jeszcze bardziej rozwinąć naszą osadę.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Stwórz łańcuch produkcji narzędzi.";
"T_GAME_QUEST_SCEN12_05_START" = "Nasza osada potrzebuje więcej żywności, mój panie. Mamy gospodarstwo, ale nie posiadamy młyna ani piekarni.";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Wspaniale! Nasza osada zmienia się w prawdziwe miasteczko.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Stwórz stabilny łańcuch produkcji żywności.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "O nie! Ci przebiegli bandyci! Zniszczyli klasztor!";
"T_GAME_QUEST_SCEN12_06_START" = "Mój panie, klasztor stoi na tym wzgórzu od czterech stuleci. Byłoby straszne, gdyby zniszczyli go ci paskudni bandyci. Od tygodni grożą, że to zrobią…";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Świetnie, wasza miłość.\nKlasztor przetrwał wszystkie ataki bandytów, a do tego wyprodukował doskonały podpiwek!\n\nJakiż to jest wspaniały napitek! Absolutnie cudowny.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Obroń klasztor.";
"T_GAME_QUEST_SCEN12_07_START" = "Musimy odbudować klasztor, albo nie zdążymy z wypełnieniem naszego zadania!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Doskonale, mój panie! Klasztor został odbudowany! Możemy kontynuować prace nad naszym obecnym zadaniem: uwarzeniem doskonałego podpiwka!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Odbuduj klasztor.";
"T_GAME_QUEST_SCEN12_08_START" = "Musimy zadbać o prawidłową obronę klasztoru, wasza miłość! Postawienie obok niego wieży strażniczej powinno znacznie poprawić jego ochronę.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Zbuduj wieżę strażniczą obok klasztoru.";
"T_GAME_QUEST_SCEN12_09_START" = "Wiesz, że żołnierze uwielbiają kiełbasę?\nMożesz zbudować fermę trzody chlewnej i rzeźnię, aby rozpocząć jej produkcję.";
"T_GAME_QUEST_SCEN12_09_START2" = "Mój panie,\nzalecam rozpoczęcie budowy fermy trzody chlewnej oraz rzeźni.\nDzięki temu będziemy mogli produkować mięso dla mieszczan i kiełbasę uwielbianą przez żołnierzy.";
"T_GAME_QUEST_SCEN12_10_START" = "Hmm, chyba powinniśmy zapewnić tym biednym żołnierzom jakieś pancerze i uzbrojenie. Znacznie poprawiłoby to ich wytrzymałość w boju. Będziemy do tego potrzebować zbrojowni i garbarni.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Udało się, wasza miłość! Możemy już wytwarzać pancerze dla naszych żołnierzy.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Zbuduj zbrojownie i garbarnię.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Zbuduj zbrojownię.";
"T_GAME_QUEST_SCEN12_11_START" = "Skoro mamy już zbrojownię i garbarnię, wspaniale byłoby rozpocząć produkcję wyposażenia.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Doskonale, wasza miłość! Od teraz żołnierze będą sobie o wiele lepiej radzić w bitwach.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Wytwórz wyposażenie dla żołnierzy.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Bardzo dobrze, mój panie. Klasztor powinien już być odpowiednio chroniony przed kolejnymi atakami bandytów!";
"T_GAME_QUEST_SCEN12_15_START" = "Nie udało nam się odbudować zniszczonych plantacji chmielu.\n\nCzy mógłbyś nam w tym pomóc?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Zbuduj kilka plantacji chmielu.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Zbuduj plantację chmielu i kilka pól.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Ha, ha, ha. Po twoim skromnym klasztorze nic nie zostało. Od teraz to ja tu rządzę!";
"T_GAME_QUEST_SCEN12_16_START" = "Myślisz, że zdołasz obronić tych nędznych mnichów? Nie wydaje mi się. Zaraz obrócę ten twój klasztorek w pył.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Wrrrr! Następnym razem mi za to zapłacisz! To jeszcze nie koniec…";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Odeprzyj wszystkie ataki na klasztor!";
"T_GAME_QUEST_SCEN12_17_START" = "Mój panie, moi bracia i ja natychmiast zaczniemy produkcję najlepszego podpiwka w kraju.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Zakończyliśmy proces warzenia, wasza miłość. Powstało wiele różnych rodzajów podpiwka. Musimy teraz wybrać najlepsze z nich i jeszcze je dopracować.";
"T_GAME_QUEST_SCEN12_18_START" = "Nasz mistrz piwowarstwa powiedział, że musimy ulepszyć sprzęt do warzenia, aby udoskonalić nasz podpiwek. Chcemy zadowolić króla, prawda? Musimy stworzyć najlepszy podpiwek w kraju…";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Doskonale, mój panie! Teraz potrzebujemy już tylko dostawy najlepszych składników.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Ulepsz klasztor do 2. poziomu.";
"T_GAME_QUEST_SCEN12_19_START" = "Mój panie, podpiwek jest już prawie gotowy, ale wciąż brakuje nam kilku składników. Zioła i złoty pył byłyby idealne, aby dokończyć nasz produkt.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Dostarcz zioła i samorodki złota. ";
"T_GAME_QUEST_SCEN12_20_START" = "Podpiwek musi chwilę dojrzeć.\n\nProces ten nie powinien być zakłócany przez czynniki zewnętrzne.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Gotowe, wasza miłość. Czy mogę zaprezentować doskonały podpiwek?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Broń klasztoru, dopóki proces warzenia nie dobiegnie końca.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Chciałem ci osobiście podziękować, zarządco.\nTo faktycznie był dla mnie idealny prezent urodzinowy. Nie wiedziałem, że jest ci znane moje zafascynowanie piwowarstwem.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Obroń klasztor i stwórz doskonały podpiwek dla króla.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Przygotuj osadę na przybycie króla. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Myślałeś, że mnie oszukasz? Jestem rozczarowany, że nie umiesz zarządzać tak małą osadą.\n\nSam zarządzam całym królestwem, ale nie muszę przy tym nikogo oszukiwać!";
"T_GAME_QUEST_SCEN13_01_START" = "W przyszłym roku zamierzam przeprowadzić inspekcję moich włości.\nTwoja słynna osada będzie punktem kulminacyjnym mojej podróży!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Jestem z ciebie dumny!\nDoskonale znasz się na roztropnym zarządzaniu osadą i zasługujesz na mój najwyższy szacunek.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Przejdź królewską inspekcję.";
"T_GAME_QUEST_SCEN13_02_START" = "Witaj, mości zarządco! Zdecydowałem się przybyć do ciebie trochę wcześniej, aby obejrzeć twoją wspaniałą osadę!\n\nZ pewnością oczekiwałeś już mojego przybycia.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Nie wzbudź podejrzeń króla.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Musisz zacząć od wznowienia produkcji towarów!\n\nZatrudnij ponownie drwala i napraw tartak, aby wznowić produkcję.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Bardzo dobrze, mój panie.\nNie mamy jednak czasu na odpoczynek!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Zatrudnij drwala i napraw tartak.";
"T_GAME_QUEST_SCEN13_05_START" = "O nie! Bandyci w lasach zupełnie zniszczyli osadę.\n\nMusimy niezwłocznie rozpocząć odbudowę!";
"T_GAME_QUEST_SCEN13_06_START" = "Targowisko spłonęło i trzeba je odbudować!\n\nPilnie potrzebujemy towarów, aby przygotować osadę na przybycie króla.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Potrzebujemy również stolarza, mój panie. Wiele budynków wymaga pilnych napraw!";
"T_GAME_QUEST_SCEN13_07_START" = "Musimy naprawić skarbiec, aby poborca podatków mógł wznowić swoją pracę.\nMonety są pilnie potrzebne do dalszych napraw!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Powinniśmy wykorzystać zebrane podatki, aby sfinansować niezbędne naprawy.";
"T_GAME_QUEST_SCEN13_08_START" = "Powinieneś naprawić domy i zbudować nowe, aby przyciągnąć do miasta więcej pracowników.\nMusimy czym prędzej wznowić produkcję!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Mamy już wystarczająco miejsca dla pracowników, ale to jeszcze nie koniec.";
"T_GAME_QUEST_SCEN13_09_START" = "To katastrofa!\nMożemy jedynie podreperować miejsca, które odwiedzi król, i mieć nadzieję, że nie nabierze podejrzeń.\n\nDobrze wykorzystaj czas odpoczynku króla!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Poczekaj, aż król ogłosi miejsce swojej pierwszej wizyty.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Król zauważył bandytów i zrobił się podejrzliwy! Musimy być bardziej ostrożni!";
"T_GAME_QUEST_SCEN13_10_START" = "Król chce odwiedzić las.\nMusimy zniszczyć obozy bandytów, nim tam dotrze!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Było blisko, ale to jeszcze nie koniec…";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Zniszcz wszystkie obozy bandytów. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "O nie! Nie udało nam się przechytrzyć króla.\nNabrał podejrzeń, więc nie możemy już popełnić żadnych błędów!";
"T_GAME_QUEST_SCEN13_11_START" = "Król chce się przejść po osadzie.\nJeśli zauważy niezadowolonych mieszczan, z pewnością zorientuje się, że coś tu nie gra.\n\nMusimy również zbudować posąg króla!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Doskonale! Wszyscy mieszczanie mieli znakomity humor podczas przechadzki króla.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Popraw zadowolenie mieszczan i wznieś pomnik króla.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Król nie był pod wrażeniem!\nNie możemy popełnić więcej błędów!";
"T_GAME_QUEST_SCEN13_12_START" = "Król zamierza sprawdzić naszą armię.\nUpewnij się, że na jego przybycie będzie czekała imponująca straż miejska!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Taka straż miejska z pewnością zaimponuje królowi!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Utrzymaj zatrudnienie odpowiedniej liczby żołnierzy.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Zawiedliśmy, mój panie. Uroczystości nie spełniły królewskich standardów i teraz jest niezadowolony!\n\nMoże uczciwość byłaby lepszym wyborem…";
"T_GAME_QUEST_SCEN13_13_START" = "Król oczekuje zorganizowania wielkiej uroczystości. Zadbaj o zapas biżuterii i wystawnych strojów.\nWszystko się posypie, jeśli nam się nie uda!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "Uroczystości były bardzo udane! Wygląda na to, że udało się oszukać króla.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Zrób zapasy odzieży i biżuterii.";
"T_GAME_QUEST_SCEN13_14_START" = "Przemierzanie ulic twego miasta z moim cennym towarem jest zbyt niebezpieczne.\n\nRadź sobie sam!";
"T_GAME_QUEST_SCEN13_15_START" = "Skoro pokonałeś już bandytów, z przyjemnością odwiedzę twoją osadę i wznowię handel.";
"T_GAME_QUEST_SCEN13_16_START" = "Kupiec jest tchórzem, ale mówił prawdę!\nLasy wokół osady są niebezpiecznym miejscem. Powinniśmy wyszkolić strażników, którzy będą wypatrywać bandytów.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Zbudowałeś fundament pod obronę osady, mój panie. Musimy go jednak rozbudować.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Zbuduj koszary i wieżę strażniczą.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "O nie! Bandyci przedarli się przez naszą obronę?! Król nie będzie zadowolony z tych wieści. ";
"T_GAME_QUEST_SCEN13_19_START" = "Obecność bandytów źle świadczy o bezpieczeństwie miasta.\nNie pozwól, aby w czasie inspekcji doszło do zbyt wielu ataków, bo inaczej wszystko wyjdzie na jaw!";
"T_GAME_QUEST_SCEN14_01A_START" = "Wasza miłość, nie uważasz, że ten człowiek zachowuje się jakoś dziwnie?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Przekaż tkaniny.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Mój panie, zawiedliśmy!\nDoradca medyczny okazał się szarlatanem i uciekł z całym naszym złotem.\n\nAle mieliśmy też trochę szczęścia i znaleźliśmy lekarstwo w jego laboratorium…";
"T_GAME_QUEST_SCEN14_01_START" = "Dzień dobry, wasza miłość. Królestwo pustoszy zaraza.\nNawet król poważnie zachorował! Będziemy musieli pomóc królewskiemu doradcy medycznemu, aby wynaleźć lekarstwo. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Udało nam się wynaleźć lekarstwo, mój panie!\n\nWłaśnie podają je królowi! To wspaniała wiadomość dla całego królestwa!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Znajdź lekarstwo dla króla.";
"T_GAME_QUEST_SCEN14_02A_START" = "Coś tu nie gra, mój panie! Doradca medyczny prosi o dziwne rzeczy. Mam złe przeczucie…\n\nPowinniśmy uważać na tego człowieka.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Zabiorę podpiwek do lekarza, gdy tylko dasz rozkaz.\nMam nadzieję, że wkrótce dostarczy nam lekarstwo. Królowi nie zostało zbyt wiele czasu!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Dostarcz podpiwek.";
"T_GAME_QUEST_SCEN14_02_START" = "Myślę, że przyklasztorny browar byłby najlepszym sposobem na zdobycie podpiwka dla króla.\n\nMiejmy nadzieję, że napar złagodzi cierpienie króla.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Myślę, że przyklasztorny browar i plantacja chmielu byłyby najlepszym sposobem na zdobycie podpiwka dla króla.\n\nMiejmy nadzieję, że napar złagodzi cierpienie naszego władcy.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Świetnie, mój panie! Mnisi z pewnością wyprodukują dla nas podpiwek! Król będzie zadowolony.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Zbuduj klasztor.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Zbuduj klasztor i suszarnię chmielu.";
"T_GAME_QUEST_SCEN14_03_START" = "Potrzebujemy fermy trzody chlewnej, aby dostarczyć świnie doradcy medycznemu!\nCzym prędzej zleć ją zbudować, wasza miłość.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Doskonale, mój panie. Możemy już zacząć hodować świnie.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Zbuduj fermę trzody chlewnej.";
"T_GAME_QUEST_SCEN14_05_START" = "Mój panie, nasza osada potrzebuje koszar. Musimy zadbać o prawo i porządek w tych niepewnych czasach.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Mój panie! Wiedziałem!\n\nDoradca medyczny to szarlatan. Od samego początku miał lekarstwo dla króla.\nWygląda na to, że sam roznosił tę chorobę po całym kraju.\n\nPozwoliłem sobie kazać strażnikom go aresztować.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "To skandal!\n\nJak śmiesz mnie aresztować! Jestem specjalnym doradcą króla.\nNie masz prawa…";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Zawiodłem się na tobie, gubernatorze!\n\nOstatniej nocy miałem wizję! Ujrzałem w niej, że twój brak kompetencji przyniesie wielkie nieszczęście tej osadzie.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Gubernatorze! Nazywam się Rasiksin i jestem jasnowidzem oraz doradcą medycznym króla.\nBędę potrzebował wszelkiego wsparcia, jakiego zdołasz mi udzielić!\nNa początek: dostarcz mi czym prędzej wystarczającą ilość ziół leczniczych!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Widzę, że udało ci się wyprodukować wszystkie zioła, których potrzebowałem.\n\nOstatniej nocy miałem wizję… Ujrzałem w niej, że nie zawiedziesz króla.\n\nA teraz rozkaż swojemu doradcy, by dostarczył mi zioła i zejdź mi z oczu. Mam pracę do wykonania.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Przekaż zioła.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Nie powinienem był na ciebie liczyć, gubernatorze! W moich wizjach ujrzałem, że twój brak kompetencji przyniesie nieszczęście tej osadzie! Zawiodłeś mnie i króla, gubernatorze!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Potrzebuję tkanin, aby przefiltrować lekarstwo. Musisz je dla mnie wyprodukować. I lepiej się pośpiesz, żebym mógł się wkrótce zabrać za filtrację.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Miło mi widzieć, że nie marnujesz czasu, gubernatorze!\n\nA teraz zamów dostawę tych surowców! Jestem bardzo zajętym człowiekiem!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Wyprodukuj tkaniny.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "Lekarstwo należy rozcieńczyć do celów masowej produkcji. Podpiwek będzie doskonałym wyborem!\n\nDo roboty!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "W końcu! To teraz dostarcz je do mojego laboratorium.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Wyprodukuj podpiwek.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Nie… jest już za późno! Na miasto spadnie teraz kolejne nieszczęście.\n\nTo twoja wina!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Musimy użyć bardziej drastycznych środków, aby uratować króla!\n\nPotrzebuję świń, aby złożyć z nich ofiarę tradycyjnym bogom.\nMoże to pomoże…";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Nie śpieszyłeś się, gubernatorze. Jak miło, że w ogóle tutaj jesteś…";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Dostarcz świnie.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Potrzebuję… eee… to znaczy król potrzebuje specjalnego fajkowego ziela, by uśmierzyć ból.\n\nDostarcz mi skrzynię pełną monet, aby mógł zakupić lekarstwo!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nDaj mi to! Będę… eee… to znaczy król będzie zadowolony, że wkrótce otrzyma lekarstwo. Bardzo go boli.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Dostarcz pieniądze.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Odkryłem, że źródłem choroby króla mogą być jego ubrania. Potrzebuje nowej odzieży wykonanej ze specjalnego materiału.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "W końcu przynosisz potrzebne odzienie. Król zaczął się już niecierpliwić.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Dostarcz odzież.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Nie zniosę już dłużej pracy w tym starym laboratorium!\n\nZbuduj mi wieżę strażniczą, którą będę mógł przekształcić we wspaniałe laboratorium. Tylko koniecznie wieżę. Lubię wieże.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nPrzejmę tę wieżę w imieniu króla. Urządzę w niej swoje nowe laboratorium. A teraz zejdź mi z oczu!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Zbuduj wieżę strażniczą.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Brakuje już tylko jednego składnika, gubernatorze.\n\nPotrzebuję sztabek złota, aby dokończyć lekarstwo. Dostarcz mi je.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "W końcu! Teraz pozostało już tylko poczekać, aż lekarstwo dojrzeje.\n\nBędę się musiał przygotować do wyjaz… to znaczy do podania lekarstwa.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Dostarcz sztabki złota.";
"T_GAME_QUEST_SCEN15_01_FAIL" = "Wszystko stracone! Będziesz musiał żyć ze świadomością, że przyczyniłeś się do śmierci wielu odważnych ludzi…";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "Wszystko stracone! Bez niezbędnych zasobów nie udało się osiągnąć zwycięstwa.\n\nBędziesz musiał żyć ze świadomością, że przyczyniłeś się do straty wielu odważnych ludzi!\n\nKról aż kipi z oburzenia…";
"T_GAME_QUEST_SCEN15_01_START" = "Witaj, mości zarządco.\nPrzybywam na rozkaz króla, aby zebrać zapasy na trwającą wojnę.\n\nWiem, że twoi mieszczanie cierpią z powodu wojny, ale żołnierze na froncie pilnie potrzebują twojego wsparcia!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Czołem, mości zarządco.\nPrzybywam na rozkaz króla, aby zebrać zapasy na trwającą wojnę. Wiem, że twoi mieszczanie cierpią z powodu wojny, ale żołnierze na froncie pilnie potrzebują twojego wsparcia!\n\nZwycięstwo odniesiemy tylko wtedy, gdy wszystkie zapasy dotrą do nas na czas.\n\nKról liczy na twoje wsparcie.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Zwyciężyliśmy!\nW szczególności przyczyniło się do tego twoje hojne wsparcie, czym zaskarbiłeś sobie wdzięczność moich ludzi.\n\nNiech wrócą pokojowe czasy!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Wesprzyj armię króla.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Dostarcz wszystkie zasoby królewskiej armii na czas.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "Życie wielu ludzi zależy od twojego wsparcia!";
"T_GAME_QUEST_SCEN15_02_START" = "Podbiliśmy wiele terytoriów i musimy zabezpieczyć linię frontu.\nPrześlij nam szybko deski i tkaniny, abyśmy mogli zbudować obozy!";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Doskonale. A teraz wyślij te surowce moim żołnierzom!";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Przekaż deski i tkaniny.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "Jak mamy wygrać jakieś bitwy bez odpowiedniego wyposażenia?";
"T_GAME_QUEST_SCEN15_03_START" = "Ostatnia z bitew kosztowała nas mnóstwo wyposażenia!\n\nProszę o dostawę uzbrojenia, abym mógł dozbroić moich ludzi.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Dzięki temu nowemu uzbrojeniu moi żołnierze z pewnością zwyciężą w kolejnej bitwie.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Dostarcz uzbrojenie.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Bez twojej dostawy nie będziemy mieć szans w ostatecznej bitwie!";
"T_GAME_QUEST_SCEN15_04_START" = "Kończy nam się zaopatrzenie!\nPrześlij nam chleb i mięso, abyśmy szybko odzyskali siły przed ostateczną bitwą.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "Żołnierze czekają na żywność, prześlij ją teraz!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Przekaż chleb i mięso.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "Dostarcz podpiwek i kiełbasę.";
"T_GAME_QUEST_SCEN15_08_START" = "Nie możemy zostawić naszych żołnierzy na lodzie, ale mieszczanie również cierpią z powodu niedostatku, mój panie.\nDecyzja należy do ciebie!\nZacznij od budowy tartaku i chaty myśliwskiej.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Teraz powinniśmy być przygotowani.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Zbuduj tartak i chatę myśliwską.";
"T_GAME_QUEST_SCEN15_09_START" = "Aby dostarczyć te surowce, potrzebujemy pastwiska dla owiec i tkalni.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Doskonała robota, mój panie. W każdej chwili możesz przyśpieszyć produkcję, ulepszając istniejące lub budując nowe budynki.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Zbuduj pastwisko dla owiec i tkalnię.";
"T_GAME_QUEST_SCEN15_10_START" = "Potrzebujemy zaawansowanego przemysłu żelaznego, aby wspierać naszych żołnierzy!";
"T_GAME_QUEST_SCEN15_10_SUCCESS" = "Kowal już pracuje, więc zadbaj, by miał pod dostatkiem rudy, aby nie musiał przerywać pracy.";
"T_GAME_QUEST_SCEN15_10_TITLE" = "Zbuduj warsztat ślusarski i zbrojownię.";
"T_GAME_QUEST_SCEN15_11_START" = "Aby wesprzeć żołnierzy żywnością, będziemy potrzebować piekarni i więcej chat myśliwskich!";
"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Doskonale, wasza miłość. Niezbędne surowce powinny się wkrótce pojawić w naszych magazynach.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Zbuduj piekarnię i więcej chat myśliwskich.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "Gdy skupiałeś się na spełnianiu potrzeb wojskowych, zaniedbałeś naszych mieszczan!";
"T_GAME_QUEST_SCEN15_13_START" = "Przeżywamy ciężki czas niedostatku, mój panie. Pokornie błagam, aby część zaopatrzenia przeznaczonego dla żołnierzy trafiła do biednych!";
"T_GAME_QUEST_SCEN15_13_SUCCESS" = "Jesteś honorowym władcą, mój panie! Mimo żądań żołnierzy nie zaniedbałeś swoich mieszczan.";
"T_GAME_QUEST_SCEN15_13_TITLE" = "Opcjonalnie: wspomóż mieszczan.";
"T_GAME_QUEST_SCEN15_13_TITLE_OLD" = "Wspomóż mieszczan.";
"T_GAME_QUEST_SCEN15_14_FAIL" = "Przyglądanie się, jak ta wojna pochłania cenne surowce, jest dla wielu bardzo frustrujące, wasza miłość!";
"T_GAME_QUEST_SCEN15_14_START" = "Na dworze robi się coraz zimniej, a nasi pracownicy nie mają odpowiedniej odzieży. Bądź tak życzliwy i wyprodukuj trochę ubrań.\nNie mamy ci jak zapłacić, ale będziemy pracować jeszcze ciężej niż zwykle, mój panie!";
"T_GAME_QUEST_SCEN15_14_START_2" = "Na dworze robi się coraz zimniej, a nasi pracownicy nie mają odpowiedniej odzieży. Bądź tak życzliwy i wyprodukuj trochę ubrań.\nNie mamy ci jak zapłacić, ale będziemy pracować jeszcze ciężej niż zwykle, mój panie!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "Jesteś niezwykle łaskawy, wasza miłość! Nie będziemy już dłużej drżeć z zimna.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Wyprodukuj ubrania dla mieszczan.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Bez nowych narzędzi ludzie nie będą mogli pracować tak wydajnie, jak przedtem.";
"T_GAME_QUEST_SCEN15_15_START" = "Gdybyś wysłał trochę żelaza do ślusarza, mógłby on wykuć dla nas nowe narzędzia.\nUmożliwiłoby to nam wydajniejszą pracę w tych trudnych czasach.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "Twoja dobroć nie zna granic, mój panie!";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Podaruj narzędzia pracownikom.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Twoi poddani wciąż głodują, mój panie. Jeśli nie otrzymają żywności, nastroje społeczne z pewnością szybko się pogorszą.";
"T_GAME_QUEST_SCEN15_16_START" = "Mieszczanie głodują, mój panie.\nZamiast tego zostaw nam te zapasy, a już nigdy nie usłyszysz żadnej skargi!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "Niech bogowie cię błogosławią!";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Zapewnij mieszczanom żywność.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "Szerzy się niezadowolenie, mój panie. Musisz temu czym prędzej zaradzić!";
"T_GAME_QUEST_SCEN15_17_FAIL" = "Niedobrze, mój panie. Morale jest bardzo niskie. Obawiam się, że jacyś wściekli mieszczanie mogą zrobić coś pochopnego.";
"T_GAME_QUEST_SCEN15_17_START" = "Mój panie, cała okolica cierpi z powodu wojny!\nJeśli morale mieszczan jeszcze spadnie, może dojść do zamieszek.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Doskonale, mój panie. Udało ci się zapobiec niepokojom w mieście!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Nie pozwól, aby zadowolenie spadło zbyt nisko.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Utrzymaj szczęście na poziomie powyżej 75%.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Nie dopuść, aby niskie zadowolenie utrzymywało się zbyt długo.";
"T_GAME_QUEST_SCEN15_19_START" = "Krążą pogłoski, że tamten pożar nie był przypadkiem, mój panie.\nZ pewnością dowiem się czegoś więcej, słuchając plotek w gospodzie. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Mieszczanie z pewnością będą chętni do rozmów w gospodzie. Spróbuję dowiedzieć się czegoś więcej na temat tych pożarów w mieście.";
"T_GAME_QUEST_SCEN15_20_START" = "Plotka głosi, że w mieście grasuje podpalacz, który podpala budynki, aby podżegać mieszczan do konfliktu.\nMusimy wyszkolić strażników.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Zostaje nam tylko czekać…";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Możemy odetchnąć z ulgą, mój panie! Strażnicy złapali podpalacza i go aresztowali.\nMiasto znowu będzie bezpieczne!";
"T_GAME_QUEST_SCEN16_01_START" = "Pozdrawiam, wasza czcigodna miłość. Król zażąda wkrótce daniny.\nMusimy wspierać lokalne rolnictwo.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Doskonale!\n\nDzięki twoim talentom gospodarczym byliśmy w stanie spełnić żądania króla, mój panie.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Spełnij żądania króla.";
"T_GAME_QUEST_SCEN16_02_2_START" = "O nie! Król zażądał kolejnej dostawy pszenicy.\nMoże uda nam się zdobyć resztę zboża od kupca!";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "Udało nam się! Wyślij pszenicę królowi.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Wyślij więcej pszenicy królowi.";
"T_GAME_QUEST_SCEN16_02_START" = "Król zażądał właśnie od swoich osad pszenicy.\nAby zrealizować tak ogromną dostawę, będziemy potrzebować więcej gospodarstw!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Posiadamy wystarczające zapasy pszenicy, aby zrealizować dostawę, mój panie.";
"T_GAME_QUEST_SCEN16_03_START" = "Król potrzebuje surowców, aby zbudować więcej magazynów.\nWyślij mu niezbędne materiały.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Wyślij teraz żądane materiały, aby kontynuować inne dostawy.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Dostarcz materiały do budowy magazynu.";
"T_GAME_QUEST_SCEN16_04_1_START" = "Pierwsza dostawa była zgniła. Wyślij kolejną, gdy już pokonamy chorobę w mieście.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Doskonała robota, mój panie! Zapas nowego mięsa czeka na dostawę.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Wyślij mięso.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Wyślij mięso po zwalczeniu choroby.";
"T_GAME_QUEST_SCEN16_04_START" = "Król zażyczył sobie teraz mięsa.\nNie powinno to stanowić problemu przy odpowiedniej liczbie myśliwych.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Bardzo dobrze, wasza miłość. Wymagana ilość surowców jest już w magazynie.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Zbuduj więcej chat myśliwych i dostarcz mięso.";
"T_GAME_QUEST_SCEN16_05_START" = "Król planuje zorganizować uroczystość, w związku z czym prosi o dostawę napitków.\nWyślij podpiwek i sok winogronowy na dwór królewski.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Bardzo dobrze, wasza miłość. Mamy już wystarczającą ilość soku winogronowego i podpiwka.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Wyślij podpiwek i sok winogronowy.";
"T_GAME_QUEST_SCEN16_06_START" = "Król był niezwykle zadowolony z naszych dostaw.\nTeraz zażądał jeszcze dostawy żywności.\n\nPrzekaż mu kiełbasę i chleb na królewską uroczystość. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Wspaniale, mój panie. To była ostatnia danina.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Wyślij kiełbasę i chleb.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Wyślij sok i chleb.";
"T_GAME_QUEST_SCEN16_08_START" = "To katastrofa, mój panie! Nasza pszenica została dotknięta jaką tajemniczą chorobą i uległa zepsuciu!";
"T_GAME_QUEST_SCEN16_09_START" = "Mieszczanie cierpią z powodu okrutnej zarazy.\nJeśli szybko jej nie pokonamy, wkrótce nie zostaną nam już żadni pracownicy!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "Źródłem zarazy wydają się być chore zwierzęta. Dostawa dla króla również uległa skażeniu.\nMusimy wysłać kolejną!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Pokonaj zarazę w mieście z pomocą lekarza.";
"T_GAME_QUEST_SCEN16_10_START" = "Bogowie spiskują przeciwko nam. Zaraza doprowadziła do śmierci wszystkich dzikich zwierząt. Jak teraz wykarmimy mieszkańców i spełnimy żądania króla?";
"T_GAME_QUEST_SCEN16_11_START" = "Musimy hodować zwierzęta, aby wykarmić mieszczan.\nW związku z tym będzie nam potrzebna ferma trzody chlewnej i rzeźnia.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Świnie żywią się pszenicą. Zdobądź ją od kupca, abyśmy mogli ponownie zająć się dostawą dla króla.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Zbuduj fermę trzody chlewnej i rzeźnię.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Z pewnością rozumiesz, że moje zapasy są obecnie niezwykle pożądane.\nOd teraz będę wymieniać pszenicę na rudę żelaza.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Dostarcz rudę, a wkrótce wrócę z kolejną dostawą.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Wymień rudę żelaza na pszenicę.";
"T_GAME_QUEST_SCEN16_12_2_START" = "Mogę ci dostarczyć ostatnie zapasy pszenicy w całym kraju za śmiesznie niską cenę!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Interesy z tobą to czysta przyjemność, mój panie. Wyślij mi złoto, a zobaczę, czy uda mi się jeszcze coś znaleźć.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Wymień złoto na pszenicę.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Słyszałem o twoim nieszczęściu i chciałbym zaproponować wymianę. Wciąż mam trochę pszenicy i mogę ją wymienić na inne towary.";
"T_GAME_QUEST_SCEN16_12_START" = "Z chęcią wymienię pszenicę na kamień.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Wygląda na to, że masz już wystarczającą ilość towarów, aby dokonać wymiany. Nie mogę się doczekać kolejnych interesów.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Wymień kamienie na pszenicę.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Czy kiedykolwiek próbowałeś chleba, który piecze mój siostrzeniec? Spróbuj koniecznie! I powiedz mu, żeby upiekł go tyle, aby starczyło na całą zimę!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Upiecz 50 bochenków chleba.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Zbuduj tkalnię.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Zbuduj warsztat krawiecki.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Czy tobie też jest tak zimno jak nam? Moja żona złapała nawet grypę, tak dziurawą ma suknię. Może pomożesz nam zdobyć jakieś ciepłe ubrania?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Zbuduj pastwisko dla owiec.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Wydaje mi się, że nasze miasto jest niemal idealnie przygotowane na nadchodzącą zimę! Ale tak między nami, czyż nie jest cudownie napić się soku w przytulnej gospodzie, gdy na zewnątrz trzaska mróz?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Zbuduj wytwórnię soku i wyprodukuj 50 dzbanów soku.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Mój panie, nie chcę uchodzić za nieuprzejmego, ale niestety brakuje nam gospodarstw! Jak zdołamy zebrać całą pszenicę, nim nadejdzie zima?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Zbuduj 2 gospodarstwa.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrrr, już marznę, mój panie! Nadchodząca zima z pewnością będzie niezwykle mroźna! Wraz z żoną mamy nadzieję, że nie zapomnisz zgromadzić wystarczających zapasów drewna!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Zbuduj 3 leśniczówki.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Dziękuję! Pozdrów moich braci, jeśli ich spotkasz. Muszą zebrać jak najwięcej drewna opałowego!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Zbierz 35 szt. drewna.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Wreszcie możemy rozpocząć żniwa! Mam nadzieję, że to wystarczy, aby zaspokoić nasze potrzeby!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Zbierz 35 worków pszenicy.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Cóż za obfite żniwa! Nawet nie wiemy, gdzie przechowywać tę całą pszenicę! Dobrze byłoby wypiec z niej trochę chleba!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Zbuduj młyn i produkuj mąkę.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Drogi panie, bardzo lubimy tu mieszkać, ale obawiamy się, że nasze domy nie przetrwają nadchodzącej zimy…";
"T_GAME_QUEST_SCEN2_6_NAME" = "Utrzymaj wszystkie domy w dobrym stanie.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Wciąż mnie coś martwi…\nNiestety nie mamy w magazynie żadnych narzędzi. Z pewnością wiesz, jak ważną rolę odgrywają przy naprawie budynków! Zdobędziesz je dla nas?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Zapłać daninę w postaci 50 szt. narzędzi.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Obawiam się, że moi bracia nie będą w stanie sami wykonać całej tej pracy… może zdołasz sprowadzić do naszej osady jakichś nowych ludzi?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Zwiększ zaludnienie do 50 osób.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Pod nosem już tworzą mi się sople lodu… ale niektórzy z podróżników szukających miejsca do osiedlenia się cierpią jeszcze bardziej. Myślę, że powinniśmy im pozwolić zamieszkać w naszej osadzie!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Zbuduj 6 domów.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Tylko nie zapomnij, że bierzemy jutro ślub, kochanie! Bardzo przydałaby mi się jakaś nowa biżuteria! Gdybyś tylko znał jakiegoś złotnika…";
"T_GAME_QUEST_SCEN3_10_NAME" = "Zbuduj pracownię złotniczą.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Król i mieszczanie z pewnością ucieszyliby się z nowych narzędzi! Stare są już zardzewiałe i bezużyteczne!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Zbuduj warsztat ślusarski.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Zbuduj warsztat krawiecki i produkuj odzież.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Och, popatrz tylko na te urocze owieczki! Widziałeś je, kochanie? A zobacz, ile wełny już z nich zebrano! Potrzebujemy już tylko tkalni i zakładu krawieckiego!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Zbuduj tkalnię i wyprodukuj odpowiednią ilość tkaniny.";
"T_GAME_QUEST_SCEN3_13_DESC" = "Dzieci są rozradowane, nie mogą się doczekać tego świeżego chleba, który wkrótce będą zajadać! Zbudowałeś już piekarnie, prawda? Kochanie?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Zgadnij, co się stało! Moja siostra w końcu zdecydowała się wyjść za mąż! W naszej osadzie potrzebny jest jednak jeszcze kościół. Nie tylko na potrzeby ceremonii, ale również dla naszych religijnych mieszczan!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Osiągnij wysoki poziom zadowolenia z religii.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Popatrz tylko, kochanie! Nasze miasteczko ma się dobrze i wszystko jest w porządku! Masz więc moje pozwolenie na chwilę relaksu z kolegami i zbudowanie gospody, jeśli chcesz! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "Osiągnij wysoki poziom zadowolenia z gospód.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Popatrz na tę zaniedbaną osadę, kochanie… żal mi tych biednych mieszczan! Chyba powinniśmy poprosić o wsparcie króla. Może nakłonisz go do pomocy, wysyłając mu jakieś prezenty!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Zapłać daninę dla króla i wypełnij wszystkie zadania.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Powinieneś wziąć sprawy w swoje ręce do czasu, aż król przyśle pomoc! Mieszczanie pilnie potrzebują wody!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Zbuduj studnię w swojej osadzie.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Twój poprzednik nie zdołał nawet dostarczać wystarczającej ilości żywności! Niewiarygodne! Musisz się tym natychmiast zająć, kochanie! Może zbudujesz kilka chat rybackich?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Zbuduj 2 chaty rybackie.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Biedne dzieci… nie możemy ich karmić wyłącznie rybami, kochanie! Powinieneś założyć gospodarstwa, abyśmy zdobyli pszenicę na mąkę i chleb!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Zbuduj 2 gospodarstwa i produkuj pszenicę.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Zbuduj hutę.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Nie zapomniałeś o czymś, kochanie? Nie planowałeś czasem przesłać królowi jakichś prezentów, aby przekonać go do pomocy? Co ty byś beze mnie zrobił… koniecznie potrzebujemy kopalni i huty, nim wyprodukujemy cokolwiek wartościowego!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Zbuduj kopalnię.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Nasi mieszczanie są przepracowani! Może zbudujesz kilka nowych domów, aby przyciągnąć więcej pracowników?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Zbuduj 3 domy.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Och, ależ jestem szczęśliwa! Żyje nam się coraz lepiej! Możemy już nawet zacząć pobierać więcej podatków od mieszczan!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Zbierz 1500 talarów w podatkach.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Zbierz wystarczającą kwotę talarów w podatkach.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Wiesz, co jeszcze by się nam przydało? Jakieś nowe ubrania! To znaczy oczywiście głównie dla króla… ale najpierw potrzeba nam kilku pastwisk dla owiec, by zacząć pozyskiwać wełnę!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Zbuduj 2 pastwiska dla owiec.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Rolnicy pracują już ciężko przy zbiorach pszenicy! Możemy więc zbudować młyn, aby rozpocząć produkcję mąki na chleb!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Zbuduj młyn i produkuj mąkę.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Mój zamek nie jest już wystarczający dla kogoś o moim statusie, dlatego planuję znacząco powiększyć moją letnią posiadłość.\n\nJako twój król rozkazuję ci dostarczyć dużą ilość kamienia. Liczę na twoją rzetelność, mój zarządco.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Dostarcz królowi wóz kamieni.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Piekielny upał odcisnął swoje piętno na naszych budynkach. Domy zostały uszkodzone, a wiele rodzin domaga się poprawy warunków mieszkalnych.\n\nWspaniale byłoby, gdybyś wziął pod uwagę poprawę warunków mieszkalnych w całym mieście.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Osiągnij wysoki poziom szczęścia ze stanu budynków.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Mój zarządco, wciąż czekam na dostawę soku winogronowego. Wkrótce rozpocznie się organizowany przeze mnie bankiet.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Dostarcz sok winogronowy królowi.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Waszmości, mąka stała się niezwykle poszukiwanym towarem w całym królestwie. Gospodarstwa nie są w stanie wyprodukować tyle pszenicy, by młyny działały z pełną wydajnością.\n\nGdybyś dostarczył mi dostatecznie dużo mąki, mógłbym opanować rynek i zbudować monopol w tym regionie. Oczywiście sowicie bym cię za to wynagrodził.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Dostarcz mąkę kupcowi.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Mieszczanie chcą zbudować osłony przeciwsłoneczne, aby ochronić się przed palącym słońcem w ciągu dnia. Powinniśmy im zapewnić deski, aby mogli się brać do roboty!";
"T_GAME_QUEST_SCEN4_14_NAME" = "Wyprodukuj 35 desek.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Dobrze sobie radzisz, mój panie. Nasze miasteczko urosło do pokaźnych rozmiarów.\n\nMieszczanie są jednak bardzo nieszczęśliwi z powodu suszy. Powinieneś spróbować temu zaradzić, spełniając więcej ich pragnień. To oczywiście tylko skromna propozycja…";
"T_GAME_QUEST_SCEN4_15_NAME" = "Osiągnij wysoki poziom szczęścia w swojej osadzie.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Wspaniała robota, mój zarządco!\nPomimo suszy udało ci się zbudować spore miasto. Mieszczanom bardzo podobają się wprowadzone przez ciebie zmiany.\n\nJako król jestem bardzo zadowolony z twojej pracy. Wyświadczyłeś wielką przysługę królestwu i zostaniesz za to odpowiednio wynagrodzony.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Mój panie, mieszczanie żyją w ubóstwie i nędzy. Królestwo cierpi z powodu suszy. Popatrz tylko na tę niegdyś wspaniałą rzekę, która płynęła tuż obok twojego zamku. Zostały z niej tylko płytkie kałuże…\n\nKról zlecił nam rozbudowę naszej osady. Zacznijmy od wzniesienia kilku nowych domów.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Zbuduj jeszcze 8 domów.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Wasza miłość, król jest zachwycony udaną rozbudową osady, ale nakazuje nam zbudować jeszcze większą.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Osiągnij populację 100 mieszkańców.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Mój panie, jestem kupcem i mógłbym ulżyć ci w twojej obecnej sytuacji.\n\nKrólestwo cierpi z powodu suszy, ale ja mogę dostarczyć twojej osadzie niezbędne materiały, gdy tylko zbudujesz targowisko.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Osiągnij wysoki poziom szczęścia z targowiska.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Mój panie, błagam cię o zlecenie budowy dodatkowych studni, by dostarczać mieszkańcom dostateczną ilość wody przy tych upałach.";
"T_GAME_QUEST_SCEN4_3_NAME" = "Zbuduj 2 studnie.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Przynoszę dobre wieści, wasza miłość. Jeden z mieszczan odkrył, że te jeziorka wody pozostałe w korycie wyschniętej rzeki wciąż skrywają trochę ryb.\n\nPowinniśmy zlecić budowę kilku chatek rybackich.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Zbuduj 2 chaty rybackie.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Mój panie, chciałbym zaproponować umowę.\n\nGdybyśmy rozszerzyli nasze stosunki handlowe, mógłbym zadbać o regularne dostawy żywności do twojej osady.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Zarób 1000 talarów na sprzedaży na targowisku.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Kolejny raz przybywam do ciebie z propozycją. Pilnie potrzebuję węgla. Dostarcz mi go, a zapłacę za niego wielkim workiem talarów.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Dostarcz węgiel kupcowi.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Zarządco, mój dwór pilnie potrzebuje soku winogronowego. Susza wciąż nęka moje królestwo i zniszczyła nasze winogrona.\n\nRozkazuję ci zbudować wytwórnię soku. Planuję urządzić wkrótce w moim zamku bankiet, więc lepiej mnie nie zawiedź!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Zbuduj wytwórnię soku i produkuj sok.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Waszmości, moja rodzina ledwo jest w stanie uprawiać tę wysuszoną glebę. Zbiory będą słabe, więc jedno gospodarstwo nie wystarczy.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Zbuduj dodatkowe gospodarstwo i wyprodukuj odpowiednią ilość pszenicy.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Nasze zapasy chleba są na wyczerpaniu, wasza miłość. Powinniśmy zmniejszyć jego konsumpcję, dostarczając osadzie więcej mięsa.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Wyprodukuj wystarczającą ilość mięsa.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Wypełnij wszystkie zadania, pokonaj suszę i powiększ swoją osadę do rozmiarów miasta!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Brakuje nam już tylko jednej rzeczy, mój panie, a jest nią sok winogronowy, aby uczcić nasze zwycięstwo!\n\nProszę, dostarcz jego sporą ilość do obozu wojskowego!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Dostarcz 45 dzbanków soku rycerzowi.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Doskonale, wasza miłość!\nLord Blankenstein wygrał swoją kampanię i w samych superlatywach wyraża się o tobie i twojej pomocy.\n\nCzy zechcesz dokonać ostatniej wymiany, nim opuszczę ten region?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Zarób 2500 talarów na handlu.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Cóż za piękny poranek, wasza miłość. Mam wspaniałe wieści. Skontaktował się z nami pewien niezrzeszony kupiec.\n\nOdwiedzi nasze miasto i będzie potrzebował desek do zbudowania stoiska targowego.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Wyprodukuj 30 desek.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Mój panie, stworzyłeś tutaj prawdziwą placówkę handlową. Brakuje nam jednak pewnej kluczowej budowli, a mianowicie gospody. Jeśli ją zbudujesz, nasza osada przyciągnie kolejnych kupców i podróżników.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Osiągnij wysoki poziom zadowolenia z gospód.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Doskonale, waszmości. Dzięki tej gospodzie zyskamy w przyszłości dostęp do wielu różnych ofert handlowych.\nA teraz przejdźmy do interesującej części naszej umowy. Wymieńmy trochę towarów… ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Zarób 1500 talarów na handlu.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Czy mógłbyś zrobić zapasy tkanin, wasza miłość? Posiadam partnera handlowego, który jest nimi niezwykle zainteresowany.\n\nW czasie moich podróży spotkałem również pewnego rycerza. Wkrótce tutaj przybędzie i być może będzie miał dla ciebie jakieś ciekawe zadania.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Uzbieraj 35 szt. tkanin w swoim magazynie.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Mój panie! Nazywam się Kunibert von Blankenstein i jestem rycerzem króla.\n\nTwoja placówka handlowa jest idealnie usytuowana, aby wspomóc mnie w misji wypędzenia bandytów z tych ziem. Czy mógłbyś zaopatrzyć mnie w kamień, abym zbudował wieże strażnicze do ochrony tego regionu?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Dostarcz 50 szt. kamienia rycerzowi.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Zarządco, moi kowale pilnie potrzebują żelaza, aby zaopatrzyć moją armię w miecze.\n\nW pobliżu twojej placówki handlowej znajduje się kilka złóż rudy. Czy mógłbyś dostarczyć żelazo mojemu słudze?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Dostarcz 65 sztabek żelaza rycerzowi.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Mam problem, waszmości. Niektórzy z moich pobratymców powgniatali sobie pancerze podczas ostatniej bitwy z bandytami.\n\nPrzygotuj narzędzia, aby moi żołnierze mogli naprawić pancerze podczas wizyty w twojej placówce handlowej.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Wyprodukuj 25 szt. narzędzi.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Przynoszę dobre wieści, zarządco! Moja kampania okazała się wielkim sukcesem i bandyci zostali wypędzeni z tego regionu.\n\nPodczas tej długiej wyprawy zużyliśmy jednak nasze całe zapasy. Musisz dostarczyć trochę żywności mojej armii.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Dostarcz 25 ryb i 25 chlebów rycerzowi.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Moi żołnierze chcieliby uczcić zwycięstwo nad bandytami, ale odkąd ich pokonali, nie mogą sobie znaleźć zajęcia i zaczynają być niespokojni.\n\nCzy zbudowałbyś w osadzie jakieś budynki rozrywkowe, mój panie?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Moi żołnierze chcieliby uczcić zwycięstwo nad bandytami, ale odkąd ich pokonali, nie mogą sobie znaleźć zajęcia i zaczynają być niespokojni.\n\nCzy zbudowałbyś place turniejowe, aby moi żołnierze mogli się wyszaleć, mój panie?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Osiągnij wysoki poziom zadowolenia z placów turniejowych.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Zbuduj prężną placówkę handlową, wypełniając wszystkie zadania!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Wspaniale, wasza miłość.\nUdało ci się założyć placówkę handlową w tej strategicznie ważnej lokalizacji.\nKról i lord Blankenstein są bardzo zadowoleni z twojej pracy i wsparcia kampanii przeciwko bandytom w tym regionie.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Król wysłał rozkaz! Wymaga ogromnej ilości materiałów, aby wznieść katedrę! Konstrukcja tej monumentalnej budowli już się rozpoczęła, więc powinniśmy dostarczyć surowce jak najszybciej.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Dostarcz surowce na budowę katedry.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Wymień wełnę na ryby.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Wymień rudę żelaza na ryby.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Wymień sok winogronowy na ryby.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Wymień rudę złota na ryby.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Wymień deski na ryby.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Widzę, że w pobliżu nie ma jezior ani rzek, więc nie można pozyskiwać ryb. Zbuduj targowisko, a będę mógł ci dostarczać ryby w zamian za inne towary!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Zbuduj jeszcze 2 kopalnie.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Zbuduj jeszcze 3 kopalnie.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Powinieneś czym prędzej zabrać się za wydobycie! Zadbaj o odpowiednią ilość sprawnych kopalni, abyśmy dotrzymali harmonogramu dostaw.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Zbuduj kopalnię.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Twoi mieszkańcy robią co w ich mocy, aby wydobyć całą rudę! Zapewnij im wystarczającą ilość pożywienia, aby byli stale gotowi do pracy!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Zbuduj piekarnię i wyprodukuj trochę chleba.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Dobrze nam idzie, ale wciąż musimy przetopić tę rudę!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Zbuduj 2 huty.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Praca w ciemnych i wilgotnych kopalniach bez odpowiedniego odzienia może być naprawdę nieprzyjemna! Powinieneś zaopatrzyć swoich mieszkańców w ciepłą odzież. Z pewnością by to docenili!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Dostarcz 25 szt. odzieży.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Mój panie, produkujemy surowce w zawrotnym tempie! Musimy zbudować więcej magazynów, aby je wszystkie przechować!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Zbuduj 2 magazyny.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Praca w kopalniach to prawdziwa harówka! Twoi mieszkańcy chcieliby mieć miejsce na relaks po ciężkim dniu pracy. Idealna do tego byłaby gospoda! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "Zbuduj gospodę.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Bardzo dobrze! Wspaniale, że udało ci się dostarczyć wszystkie surowce niezbędne do budowy katedry! Jej wzniesienie zajmie jednak trochę czasu.\n\nKatedra upamiętni naszego wielkiego króla, którego czyny doprowadziły do ery pokoju i harmonii!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Pamiętaj, że możesz usuwać blokujące drzewa! Użyj łopaty, aby zaznaczyć drzewa, które chcesz usunąć.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Wasza miłość, nie możemy upiec tortu weselnego bez odpowiednich składników! Czy byłbyś tak miły i wybudował gospodarstwo, abyśmy mogli produkować własną mąkę?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Zbuduj gospodarstwo.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Zbuduj młyn.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Wypiecz 25 chlebów.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "To będzie cudowne wesele! Najpierw musimy zadbać o to, aby tort weselny był doskonały. Czy mógłbyś zbudować piekarnię, podczas gdy ja zajmę się wyborem sukni ślubnej?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Zbuduj piekarnię.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Potrzebuję targowiska, żebym mogła pozbyć się wszystkich prezentów ślubnych, które mi się nie spodobają!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Osiągnij wysoki poziom szczęścia z targowiska.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Mój panie, przygotowania do ślubu przebiegają pomyślnie! Ale potrzebujemy więcej narzędzi do budowy namiotu weselnego!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Zbuduj warsztat ślusarski.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Wyprodukuj 20 szt. narzędzi.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Chcę, żeby nasza ceremonia ślubna odbyła się w pięknym kościele. Czy już go zbudowałeś?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Osiągnij wysoki poziom szczęścia z religii.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Zbuduj pastwisko dla owiec.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Zbuduj tkalnię.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Wyprodukuj 20 szt. ubrań.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Nie do wiary! Nigdzie nie mogłam znaleźć porządnej sukni ślubnej, a potrzebuję jej na teraz! Przyprowadź swojego najlepszego krawca, aby ją uszył.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Zbuduj zakład krawiecki.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Stwórz dekoracje.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Zwiększ szczęście swoich mieszczan!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "To miejsce jest ponure… czy mógłbyś upiększyć tę osadę? Chcę, aby wszyscy czuli się tak szczęśliwi jak ja!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Nie obchodzi mnie tort i kwiaty. Chcę wielkiej uroczystości z mnóstwem soku, na którą zaproszę całą osadę! Ale mamy za mało miejsca, aby pomieścić wszystkich gości weselnych!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Zbuduj więcej małych domów.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Potrzebuję miłego miejsca na spotkanie z przyjaciółmi po zakończeniu wesela. Tej osadzie naprawdę przyda się gospoda!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Osiągnij wysoki poziom zadowolenia z gospód.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Wyprodukuj 25 dzbanków soku winogronowego.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Moi przyjaciele będą bardzo spragnieni! Pamiętałeś o soku?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Zbuduj wytwórnię soku.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Będzie więcej gości, niż się spodziewaliśmy. Zbuduj duży dom.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Zbuduj duży dom.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Wyprodukuj 15 szt. biżuterii.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "O nie! Mam poważne kłopoty! Zgubiłem obrączkę! Proszę, tylko jej nie mów! Czy w mieście jest złotnik, który może zrobić nową?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Zbuduj pracownię złotniczą.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Zanim wezmę ślub, chcę zaimponować mojej narzeczonej na placu turniejowym!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Zbuduj plac turniejowy.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Mój panie, nasze magazyny zamkowe są już dosyć ciasno wypełnione towarami. Czy mogę zasugerować zlecenie budowy dodatkowego magazynu?";
"T_GAME_QUEST_SCEN8_10_NAME" = "Zbuduj nowy magazyn.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Mężczyźni w mieście byliby szczęśliwsi, gdyby mogli się gdzieś spotkać i napić soku winogronowego po ciężkim dniu pracy. Czy prośba o gospodę byłaby przesadą, mój panie?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Osiągnij wysoki poziom zadowolenia z gospód.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Mój panie, kowal zbudował proste piece grzewcze dla naszych mieszczan, ale nie mamy węgla, żeby w nich palić.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Wyprodukuj 50 jedn. węgla.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Mój panie, w mieście brakuje drewna na opał do ogrzania domów. Koniecznie musimy zrobić zapas!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Wyprodukuj 75 szt. drewna na opał.";
"T_GAME_QUEST_SCEN8_2_DESC" = "Osada jest w złym stanie. Spójrz na te wszystkie zaniedbane domy. Prawdopodobnie wystarczy jedna zamieć śnieżna, by wiele z nich się zawaliło. Sprowadźmy do miasta cieślę, który pomoże w naprawie budynków.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Zbuduj stolarnię.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Mój panie, ta sroga zima jest wyraźnym znakiem z nieba! Musimy odpokutować za nasze grzechy! Zbudujmy dom boży, aby przebłagać wszechmogącego!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Osiągnij wysoki poziom zadowolenia z religii.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Mieszkańcy są podenerwowani, mój panie. W ich domach jest bardzo zimno. Myślę, że powinniśmy zaopatrzyć się w wełnę. Mieszczanie mogliby jej użyć do izolacji domów przed zimnem.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Wyprodukuj 55 jedn. wełny.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Gubernator sąsiedniej prowincji przysłał nam gołębia pocztowego z prośbą o pomoc! Pilnie potrzebuje ciepłych ubrań dla swoich ludzi.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Dostarcz wóz ubrań do sąsiedniej prowincji.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Gospodarstwa nie mogą uprawiać pszenicy zimą, mój panie. Wyślijmy kilku mieszczan do lasu, by zapolowali na jelenie.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Zbuduj kilka chat myśliwskich.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Mój wierny sługo, królestwo mocno ucierpiało przez tę niezwykle srogą zimę. Wpływy z podatków drastycznie spadły.\n\nRozkazuję ci zbudować skarbiec, aby zwiększyć dochód z podatków, i przysłać mi wóz pełen talarów jako daninę.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Zbuduj skarbiec i przekaż królowi daninę w postaci monet.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Skoro już mamy w mieście cieślę, naprawa tych wszystkich zniszczonych domów nie będzie stanowić większego problemu. Mieszkańcy będą bardzo zadowoleni.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Upewnij się, że wszystkie domy zostaną odpowiednio naprawione.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Dziczyzna jest zawsze dostępna, nawet zimą, i może służyć jako substytut chleba. Upewnijmy się, że wystarczy nam mięsa na zimę.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Wyprodukuj 50 szt. mięsa.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Mój panie, zima jest o wiele ostrzejsza niż się spodziewaliśmy, a mieszkańcy miast są niezadowoleni z tej sytuacji.\n\nMusimy działać szybko albo jej nie przetrwamy!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Przetrwaj zimę…";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Mój panie, mieszczanie są bardzo zadowoleni z postępów, jakie poczyniliśmy!\n\nJesteśmy teraz wystarczająco dobrze zaopatrzeni, aby przetrwać zimowe miesiące, udało nam się nawet pomóc sąsiedniej prowincji. Jesteśmy przygotowani i ta zima nam nie zaszkodzi!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Mój panie, słyszałem, że masz problemy z rebeliantami w twojej okolicy. Chętnie poprowadzę grupę poszukiwawczą do lasu, ale moi najemnicy żądają zapłaty z góry.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Zapłać najemnikom.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Mam jeszcze jedną prośbę, mój wierny sługo. Potrzebuję okrętu flagowego godnego króla, czyli hojnie pokrytego złotymi ozdobami!\n\nRozkazuję ci dostarczyć mi złoto, którego do tego potrzebuję. Nie zawiedź mnie.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Dostarcz królowi rudę złota w wyznaczonym czasie.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Mój wierny sługo, budowa mojej nowej floty idzie dobrze, ale wciąż potrzebujemy dużych ilości płótna żaglowego. Rozkazuję ci dostarczyć mi wystarczającą ilość materiału, abym mógł wyposażyć wszystkie moje statki w żagle.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Dostarcz tkaninę do produkcji płótna żaglowego.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Moi ludzie coś odkryli. Znaleźliśmy w lesie ślady bandytów. Potrzebujemy jednak więcej zaopatrzenia, zanim będziemy mogli to dalej zbadać.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Dostarcz zaopatrzenie najemnikom.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Gubernatorze! Bandyci z twojej prowincji ukradli mi cały ładunek desek. Trzeba to zakończyć. Dostarcz jak najszybciej więcej desek.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Dostarcz drewniane deski, aby wesprzeć budowę floty króla.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Mój panie, poborca podatkowy znalazł dowód na związek między bandytami w lesie a sabotażystą w mieście. Nie chce nam powiedzieć więcej, bo boi się o swoje życie.\n\nDomaga się zwolnienia z obowiązków poborcy podatkowego. Chce też otrzymać nowe ubrania, aby mógł opuścić miasto i się ukryć. Dopiero wtedy powie nam, czego się dowiedział.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Zwolnij poborcę podatkowego ze skarbca i zaopatrz go w nowe ubrania, aby mógł niepostrzeżenie wymknąć się z miasta.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Mój panie, zgodnie z obietnicą poborca podatków wyjawił tożsamość sabotażysty, zanim opuścił miasto.\n\nTo najemnik i jego ludzie! Oszuści! Jeżdżą od miasta do miasta i za pieniądze oferują „ochronę” przed bandytami i sabotażem, który potajemnie sami popełniają!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Złe wieści, mój panie! Ktoś włamał się do magazynu i ukradł całe nasze mięso!\n\nRozstawmy pochodnie w mieście. Może to pomóc w łapaniu złodziei w nocy.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Rozmieść 7 pochodni w mieście, aby odstraszać złodziei.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Wasza miłość, ponieważ w najbliższym czasie nie odwiedzą nas wędrowni kupcy, potrzebujemy dodatkowego pomieszczenia do przechowywania wszystkich naszych towarów.\n\nPoza tym powinniśmy wstrzymać niepotrzebną produkcję, aby zbytnio nie obciążyć naszych magazynów.\n\nRozsądnie byłoby wybudować jeszcze jeden magazyn.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Zbuduj kolejny magazyn w osadzie.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Mieszczanie kulą się ze strachu na myśl o sabotażyście i są zbyt przerażeni, by wyjść i naprawić swoje domostwa.\n\nChyba musimy zbudować stolarnię, jeśli chcemy dokonać napraw.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Zbuduj stolarnię.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Dzień dobry, mój panie. Mamy piękny zimowy dzień. Zaplanowaliśmy już pracę na nadchodzące miesiące.\n\nZacznijmy od zbudowania kilku leśniczówek, dobrze?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Zbuduj kilka leśniczówek.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Przychodzę do ciebie z prośbą, mój panie. Narzędzia są bardzo potrzebne w całym królestwie.\n\nSowicie bym ci zapłacił, gdybyś dostarczył mi ładunek narzędzi. Dodatkowo odwiedzę twoje miasto ponownie, aby pohandlować.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Dostarcz ładunek narzędzi kupcowi.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Mam ważne wieści, mój panie! Przybyła grupa najemników, którzy już narzekają, że w naszej osadzie brakuje gospody.\n\nNie chcemy gościć w osadzie niezadowolonych i znudzonych najemników, więc lepiej zbudujmy gospodę. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Osiągnij wysoki poziom szczęścia z gospód.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Gubernatorze, cieszę się, że twoje wysiłki na rzecz zwiększenia produkcji drewna idą dobrze.\n\nA teraz czy byłbyś tak miły i przysłał pierwszą dostawę…";
"T_GAME_QUEST_SCEN9_3_NAME" = "Przekaż królowi daninę w postaci drewna.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Mój panie, krążą plotki o niepokojach w osadzie. Czy to możliwe, że niektórzy mieszczanie spiskują przeciwko koronie?\n\nJeśli szybko nie podejmiemy działań, może dojść do rebelii. Powinniśmy upewnić się, że nasi mieszczanie są szczęśliwi i zadowoleni. Lepiej się pośpieszmy.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Utrzymaj szczęście na poziomie powyżej 100% przez następnych kilka minut.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Mój panie, to skandal! Gospoda została zniszczona! W osadzie krążą plotki o sabotażyście.\n\nMusimy opanować sytuację, zanim wszystko całkowicie wymknie się spod kontroli. Szubienica i pręgierz powinny załatwić sprawę.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Zbuduj szubienicę i 2 pręgierze w osadzie.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Mój panie, mądrze byłoby jeszcze podnieść morale w mieście.\n\nOkazanie mieszczanom życzliwości zwiększy ich szczęście. Może zbudujemy im kościół lub upiększymy miasto ogrodami kwiatowymi?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Zbuduj kilka ogrodów kwiatowych i kościół.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Gubernatorze, z przykrością informuję, że na razie nie mogę odwiedzić twojej osady.\nSłyszałem pogłoski o bandytach w lasach otaczających miasto. W tej chwili stwarzają oni zbyt duże zagrożenie dla kupców.\n\nMam jednak wiadomość od króla. Rozkazuje zbudować dwa tartaki.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Zbuduj 2 tartaki.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Mój panie, mam pewien pomysł. Powinniśmy zbudować skarbiec. Poborca podatkowy odwiedza każdy dom w mieście… i może uda mu się zdobyć jakieś informacje na temat tego sabotażysty.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Zbuduj skarbiec i poczekaj, aż poborca podatkowy odwiedzi domy.";
"T_GAME_QUEST_SCEN9_9_DESC" = "W tartaku dokonano sabotażu, mój panie! A poborcy podatkowemu nie udało się jeszcze odkryć tożsamości sabotażysty.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Nie udało ci się na czas zapobiec rozruchom!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Poniosłeś porażkę! Z powodu twojej niekompetencji musiałem zamówić złoto z innego miasta!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Gubernatorze, wkrótce zlecę budowę nowej wielkiej floty okrętów wojennych.\n\nTwoja osada ma potencjał, by stać się moim największym dostawcą drewna do tego ogromnego przedsięwzięcia. Dopilnuj, by tak rzeczywiście się stało.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Najemnik i jego gang uciekli z tego regionu, gubernatorze. Moi ludzie będą ich zaciekle ścigać.\n\nChciałbym ci również podziękować za wsparcie w budowie mojej nowej floty i zaprosić na dziewiczy rejs nowego okrętu flagowego. A póki co życzę miłego dnia…";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Pomóż królowi w tym przedsięwzięciu.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Bardzo dobrze! Udało ci się zapobiec rozruchom w osadzie!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Bardzo dobrze! Dostawa dotarła w ostatniej chwili!";
"T_GAME_QUEST_SCEN_10_DESC" = "Po zakończeniu turnieju nasi rycerze znajdą rozrywkę w lokalnych gospodach! Martwię się jednak, że mamy za mało gospód i soku winogronowego! Natychmiast zajmij się tym problemem!";
"T_GAME_QUEST_SCEN_10_NAME" = "Osiągnij wysoką satysfakcję z gospód.";
"T_GAME_QUEST_SCEN_11_DESC" = "Świetnie, zarządco! Osada jest prawie gotowa, ale moje córki i ja nie! Potrzebuję najwspanialszych ubrań, jakie mogą uszyć twoi krawcy!";
"T_GAME_QUEST_SCEN_11_NAME" = "Zapłać daninę w postaci 35 sztuk odzieży.";
"T_GAME_QUEST_SCEN_12_DESC" = "Jesteśmy coraz bliżej rozpoczęcia turnieju, ale nie chcę widzieć w mieście żadnych smutnych twarzy! Lepiej zadbaj o to, aby mieszczanie byli szczęśliwi!";
"T_GAME_QUEST_SCEN_12_NAME" = "Osiągnij wysoki poziom szczęścia.";
"T_GAME_QUEST_SCEN_1_DESC" = "Witaj, zarządco! Jak zapewne wiesz, planuję zorganizować największy w regionie turniej! Oczekuję, że na potrzeby tego wydarzenia zbudujesz co najmniej 3 place turniejowe! Nie zawiedź mnie!";
"T_GAME_QUEST_SCEN_1_NAME" = "Zbuduj 3 place turniejowe.";
"T_GAME_QUEST_SCEN_2_DESC" = "Goście naszego turnieju z pewnością będą głodni! Chcę, żebyś natychmiast zaczął produkować chleb i dostarczał go w ramach daniny swojemu królowi!";
"T_GAME_QUEST_SCEN_2_NAME" = "Zapłać daninę w postaci 25 bochenków chleba.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Zbuduj młyn i produkuj mąkę.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Zbuduj 2 piekarnie i produkuj chleb.";
"T_GAME_QUEST_SCEN_3_DESC" = "Mój panie, nie powinniśmy kazać królowi czekać! Do produkcji chleba potrzebujemy pszenicy i mąki!";
"T_GAME_QUEST_SCEN_3_NAME" = "Zbuduj gospodarstwo i produkuj pszenicę.";
"T_GAME_QUEST_SCEN_4_DESC" = "Wspaniale, zarządco! Ale sam chleb nie wystarczy, aby zadowolić naszych gości! Żądam świeżych ryb jako daniny dla twojego króla!";
"T_GAME_QUEST_SCEN_4_NAME" = "Zapłać daninę w postaci 25 ryb.";
"T_GAME_QUEST_SCEN_5_DESC" = "Chcę, żeby turniej był niezapomniany! Nasi rycerze będą dzierżyć złote włócznie, a nasze place turniejowe będą lśnić i błyszczeć! Wyświadcz mi przysługę i zbierz podatki dla swojego króla!";
"T_GAME_QUEST_SCEN_5_NAME" = "Zapłać daninę w postaci 1000 talarów.";
"T_GAME_QUEST_SCEN_6_DESC" = "Jestem pewien, że naszych gości ucieszy wspaniały smak świeżo wyciskanego soku winogronowego! Ruszaj zbudować wytwórnie soku! Możesz nawet serwować słabej jakości odpady w lokalnych gospodach!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Jestem pewien, że naszych gości ucieszy wspaniały smak świeżo wyciskanego soku winogronowego!";
"T_GAME_QUEST_SCEN_6_NAME" = "Zbuduj wytwórnię soku i produkuj sok.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Zbuduj tkalnię i produkuj tkaniny.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Zbuduj warsztat krawiecki i produkuj odzież.";
"T_GAME_QUEST_SCEN_7_DESC" = "Tabardy naszych rycerzy są stare i wyblakłe. Nie podoba mi się to, zarządco! Zdobądź nowe! Zbuduj pastwiska dla owiec, zatrudnij sukiennika i zbuduj zakład krawiecki, jeśli chcesz zachować pracę!";
"T_GAME_QUEST_SCEN_7_NAME" = "Zbuduj 2 pastwiska dla owiec.";
"T_GAME_QUEST_SCEN_8_DESC" = "Powinniśmy sprzedać więcej towarów za pieniądze, mój panie. Zawsze dobrze jest mieć trochę talarów na pokrycie ewentualnych przyszłych wydatków.";
"T_GAME_QUEST_SCEN_8_NAME" = "Zarób na handlu 500 talarów.";
"T_GAME_QUEST_SCEN_9_DESC" = "Widzę, że sprawy idą dobrze, ale twoja osada wciąż jest paskudna! Chcę fontann, białych kamiennych ścian, zimozielonych drzew i wspaniałych posągów! Musisz upiększyć miasto, zwiększając liczbę dekoracji!";
"T_GAME_QUEST_SCEN_9_NAME" = "Zwiększ szczęście z dekoracji.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Na początek radzę przydzielić robotnika do jednej z leśniczówek w okolicy.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Przydziel pracownika do leśniczówki.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Jednym z głównych zadań jest zbudowanie targowiska.\nAby wykonać to zadanie, musisz stworzyć kilka łańcuchów produkcji surowców i zebrać potrzebne surowce, mój panie.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Zbuduj targowisko.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Mój panie, polecam przydzielić jednego mieszczanina do tartaku, abyśmy mogli jak najszybciej wyprodukować deski.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Przydziel pracownika do tartaku.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Mój panie, sugerowałbym przestawić się na wydobywanie kamieni zamiast rudy.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Jak tylko zbierzesz trochę desek i drewna, musisz przydzielić jednego z robotników do kopalni i rozpocząć wydobywanie kamieni.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Bardzo dobrze, mój panie. Teraz pozostaje nam tylko poczekać, aż targowisko zostanie zbudowane.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Przydziel pracownika do kopalni.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Twoim drugim głównym zadaniem jest zbudowanie gospody.\n\nPowinniśmy natychmiast rozpocząć budowę budynku.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Zbuduj gospodę.";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Dobra wiadomość, mój panie. Przybyło kilku mieszczan, aby wesprzeć nas w naszym zadaniu. Zbuduj dla nich dom.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Zbuduj dom.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Potrzebujemy warsztatu ślusarskiego, żeby zbudować gospodę. Na początek polecam skonstruowanie zakładu węglarza.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Zbuduj zakład węglarza.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Następny potrzebny nam budynek to huta. Dzięki niej będziemy mogli rozpocząć produkcję sztabek żelaza.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Zbuduj hutę.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Mój panie! Aby rozpocząć produkcję narzędzi, musimy najpierw zbudować w osadzie warsztat ślusarski.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Zbuduj warsztat ślusarski.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Wyczerpują się zapasy żywności, wasza miłość. Naprawdę powinieneś nakazać jednemu z mieszczan złowić trochę ryb lub upolować zwierzynę. Jeśli mieszczanie nie dostaną szybko jedzenia, ich wydajność spadnie.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Wyprodukuj trochę żywności.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Mój panie, jako pokorny kupiec jestem do twoich usług. Widzę, że potrzebujesz monet do swoich projektów budowlanych.\nKupiłbym od ciebie trochę rudy żelaza, jeśli chcesz.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Sprzedaj jakieś towary kupcowi.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Skończyły ci się pieniądze, wasza miłość? Żaden problem. Z chęcią kupię od ciebie jakieś skóry zwierzęce.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Gubernatorze, potrzebuję kilku samorodków złota. Czy zechcesz mi jakieś sprzedać?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Mój panie, nie czuję się zbyt dobrze. Chyba potrzebuję lekarza.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Wylecz chorych mieszczan.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Pożar! Jakiś mieszczanin powinien go czym prędzej zgasić.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Zgaś pożar.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Bandyci zakłócają nasz spokój nawet tutaj. Mój panie, powinniśmy przydzielić kilku mieszczan do wież strażniczych aż do czasu odparcia tego szturmu.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Obroń osadę przed bandytami.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Mój panie, czy możemy chwilę odpocząć i coś przekąsić?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Wyprodukuj trochę chleba.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Mój panie, w tym wyzwaniu mamy do dyspozycji tylko kilku mieszczan. Powinniśmy ich przydzielać do różnych budynków wedle własnego uznania.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Gratulacje. Udało ci się opanować to wyzwanie.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Wykorzystaj mądrze mieszczan, aby wykonać wszystkie zadania.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Świetne wieści, mój panie. Na półwyspie obok zamku rosną już drzewa.\n\nProponuję zbudować tam leśniczówki, żeby łatwiej było zdobyć drewno.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Mój panie, wszystkie leśniczówki zostały porzucone i uległy zniszczeniu!\n\nDrzewa w regionie zostały całkowicie wycięte, więc nie mamy już żadnego pożytku z leśniczówek.\nZalecam zniszczenie wszystkich niepotrzebnych budynków, aby zdobyć trochę drewna.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Zniszcz leśniczówki.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Mój panie, chyba powinieneś poprosić o pomoc mieszkańców wioski. Może mają jakieś niepotrzebne drewno.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Król oczekuje pierwszej dostawy desek.\n\nMożemy przydzielić mieszczanina do tartaku i rozpocząć ich produkcję. Zalecam przy tym pilnować zapasu drewna. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Przydziel jednego z mieszczan do tartaku.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Jak ci idzie, gubernatorze? Oczekuję łącznie trzech dostaw.\n\nCzym prędzej przygotuj pierwszą z nich. I nie zawiedź mnie!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Dostarcz towary królowi.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Mój panie, król był zadowolony z pierwszej dostawy desek.\nPowinniśmy czym prędzej przygotować kolejną.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Król oczekuje ostatniej dostawy. Po jej otrzymaniu będzie mógł znacząco powiększyć flotę królewską.\n\nLepiej się za to zabierzmy.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Zastanawiasz się, dlaczego twój król nie otrzymał jeszcze dostawy? Cóż, chyba znam odpowiedź.\n\nKrótko mówiąc: zapłać okup, a twoja dostawa dotrze do króla bez dalszych opóźnień.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Zapłać okup.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Potrzebuję mnóstwa desek na potrzeby budowy królewskiej floty.\nNiestety od dawna nie było żadnych dostaw.\n\nGubernatorze, mam dla ciebie zadanie! Dowiedz się, dlaczego nie docierają do mnie dostawy i rozwiąż ten problem!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Dobra robota, gubernatorze. Wiedziałem, że mogę na ciebie liczyć.\n\nDzięki twoim działaniom flota będzie gotowa w mgnieniu oka.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Rozwiąż problem z brakiem drewna i dostarcz królowi wystarczającą liczbę desek.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Mój panie, sugeruję, abyśmy mądrze wykorzystywali drewno!\n\nMożemy zbudować targowisko, aby zdobywać drewno od kupców.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Potrzebujesz drewna? Myślę, że możemy wynegocjować umowę korzystną dla obu stron. Niewielki zapas drewna mam dostępny od ręki, jeśli go potrzebujesz.\n\nZapraszam do zakupu dowolnej ilości!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Kup drewno od kupca.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Mój panie, będziesz potrzebować stałych dostaw drewna.\n\nJeśli zbudujesz gildię kupiecką, zyskasz dostęp do zleceń handlowych.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Zbuduj gildię kupiecką.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Gildia kupiecka umożliwia korzystanie ze zleceń handlowych na kupno i sprzedaż.\n\nPrzygotuj zlecenie handlowe na zakup drewna, mój panie.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Doskonale! Dopóki będziesz mieć na to środki, będę wypełniać twoje zlecenia.\n\nZlecenia handlowe będą aktywne do czasu, aż je anulujesz.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Przygotuj zlecenie handlowe na zakup drewna.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "W mieście wybuchł pożar! Musimy zbudować odpowiednią liczbę wież strażackich, aby zgasić pożar i zmniejszyć ryzyko wybuchu kolejnych.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Osiągnij pokrycie wieżami strażackimi na poziomie 80%.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Bandyci! Próbują zniszczyć nasze budynki. Potrzebujemy więcej żołnierzy w osadzie, aby wygnać bandytów, powinniśmy też zbudować więcej wież strażniczych.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Zbuduj wystarczającą liczbę wież strażniczych i zabezpiecz miasto odpowiednią liczbą żołnierzy.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Kolejna choroba! Takie wielkie miasto potrzebuje kolejnej lecznicy.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Kolejna choroba! Takie wielkie miasto potrzebuje kolejnej lecznicy.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Zbuduj lecznicę i wylecz chorobę.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Mój panie, nie wszyscy mieszczanie mają dostęp do kościoła, bo jest zawsze pełny.\n\nPotrzebujemy więcej kościołów, aby zadowolić wszystkich mieszczan.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Mój panie, mieszczanie muszą zbyt długo czekać na napoje. Potrzebujemy więcej gospód, musimy też zwiększyć produkcję soku oraz podpiwka.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "W mieście brakuje rozrywek. Powinniśmy zbudować plac turniejowy.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Mieszczanie są zadowoleni, ale teraz proszą o towary luksusowe.\n\nMożemy im zapewnić odzież i biżuterię.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Niektórzy mieszczanie narzekają, że targowisko jest zbyt zatłoczone.\n\nPowinniśmy zbudować nowe targowisko lub ulepszyć już istniejące. W przeciwnym wypadku niezadowoleni mieszczanie opuszczą miasto.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Zawiodłem się na tobie, gubernatorze. Szkoda, że nie udało ci się wypełnić wszystkich zadań.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Doskonała robota, gubernatorze. Udało ci się wypełnić wszystkie zadania i żaden mieszczanin nie opuścił twego miasta.\n\nPodwoję twą nagrodę.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Gubernatorze, niektórzy z mieszczan opuścili twoje miasto. Oczekiwałem od ciebie czegoś więcej.\n\nAle przynajmniej udało ci się wypełnić moje zadania, więc czeka cię nagroda.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Mój panie, musimy sprowadzić do miasta więcej mieszczan, albo król będzie bardzo zły.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "O nie, mój panie. Wielu mieszczan opuściło nasze miasto. Nie możemy pozwolić, by opuścili nas kolejni.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Zwiększ zaludnienie.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Mój panie, kilku mieszczan opuściło już nasze miasto. Musimy o nich lepiej dbać, by nie chcieli się wyprowadzać.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Gubernatorze, do twojego miasteczka przybyło wielu mieszczan.\n\nZaspokój ich wszystkie potrzeby, aby zachęcić ich do pozostania w mieście. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Zwiększ zaludnienie w wyznaczonym czasie.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Wypełnij wszystkie zadania przed przybyciem króla i utrzymaj zaludnienie na poziomie powyżej 150 mieszczan.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Tragarze w mieście są przepracowani, mój panie. Powinniśmy zbudować nowy magazyn i przydzielić więcej tragarzy.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Zbuduj nowy magazyn i przydziel więcej tragarzy do zamku.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Kończy nam się żywność. Zbudujmy nową chatę rybacką – to powinno pomóc.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Mój panie, nasza piekarnia produkuje za mało chleba. Możemy ją ulepszyć i przydzielić dodatkowego piekarza.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Ulepsz piekarnię do 2. poziomu i przydziel kolejnego piekarza.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Zapotrzebowanie na wodę stale rośnie. Możemy ją zapewnić wszystkim mieszczanom, budując wystarczającą ilość studni.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Zbuduj kilka studni w całym mieście.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Mój panie, powinniśmy powiększyć zapasy żywności. Potrzebujemy do tego nowej chaty myśliwskiej lub rzeźni.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Zbuduj chatę myśliwską lub rzeźnię.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Doskonale, mój panie. Udało nam się zapewnić stały dopływ żywności. Musimy jednak zwracać uwagę na inne potrzeby mieszczan.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Mój panie, powinniśmy zacząć od pozyskania materiałów budowlanych i przydzielić mieszczanina do leśniczówki po drugiej stronie rzeki.\n\nZbuduj brukowany most nad rzeką, aby drwal mógł zacząć pracę.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Zbuduj brukowany most nad rzeką i przydziel mieszczanina do leśniczówki.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Zbuduj drogę prowadzącą przez rzekę oraz przydziel mieszkańca do leśniczówki.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Przeprowadzka w to miejsce była moim największym błędem. Wybywam stąd!\n\nPowinieneś spełniać nasze potrzeby, w przeciwnym razie coraz więcej mieszczan się wyprowadzi.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Nie, dzięki.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "To świetny pomysł.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Wydawało mi się, że myślisz postępowo… Cóż, w takim razie pozostań przeciętniakiem.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ach, teraz wszystko nabiera kształtu. Musimy kontynuować nasze wysiłki i ustawić resztę produkcji.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Rządzimy rynkiem tekstyliów domowych i haute couture! Zarobimy fortunę!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Skoro surowiec jest już dostępny, potrzeba nam odpowiednich budynków. Przydaliby się tkacz i krawiec!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Zgodnie z twoją decyzją w osadzie zajdą wielkie zmiany. Ale nie będzie to możliwe bez owiec i gospodarstw w dobrym stanie.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Waszmości, właśnie powracam z pobliskiego miasta. Tamtejsi ludzie posiadają piękne materiały i tworzą niezwykłe hafty. Powinniśmy się nimi zainspirować i także zacząć produkować wyjątkowe ubrania.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Jedwabne kwiaty";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Znów zaczyna się sezon pylenia, nasi mieszkańcy ciągle kichają. Może zorganizujemy konkurs kichania?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Finaliści koncentrują się i próbują kichnąć jak najmocniej. Wybierz zwycięzcę lub zwyciężczynię!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "KICH!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "APSIK!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "KICHUKICHAPSIK!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "Już wiemy, kto wygrywa! Oto najlepsze kichnięcie! Gratulujemy, było niesamowite!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Wybrana osoba jest dumna z wygranej. Konkurs nie przyniósł zbyt wielkich dochodów, ale może twoje miasto zasłynie z pierwszego konkursu kichania w dziejach!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Nic z tego.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Nawet w zamku słychać tłumy zbierające się na rynku. Słyszysz też kichanie. Konkurs zapowiada się na świetną zabawę!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Wielu mieszczan ustawiło się w kolejkach. Powstrzymują kichnięcia, by uwolnić je z pełną mocą przed jurorami, czyli przed tobą i doradcą.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Oceniacie kolejnych mieszczan, a ty zapisałeś trzy nazwiska. Podajesz listę doradcy, a on zabiera wybrańców na rynek, gdzie odbędzie się finał konkursu kichania!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Ogłaszasz w całym mieście, że na rynku miasteczka zorganizowano zawody. Najlepszy mieszczanin otrzyma nagrodę!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Waszmości, zanim mieszczanie zgromadzą się na rynku, rozpocznijmy przygotowania! Zaczniemy od dekoracji.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Przystrój miasto.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Nasze miasto stało się ładniejsze.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Powinniśmy też sprawdzić zapasy.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Świetnie, mamy wszystko, czego nam trzeba na czas zawodów.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "Konkurs kichania";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Zróbmy to!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Masz rację, wybudujmy posągi.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "Nie… Nie chcę żadnych posągów w moim mieście.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Brawo, waszmości! Te rzeźby nadają szczególnego uroku naszemu miastu.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ach, waszmości, może pewnego dnia przestaniesz martwić się takimi szczegółami.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Waszmości, w naszym mieście brakuje posągów. Może postawimy kilka? W dodatku ludzie wierzą, że ochronią one mieszkańców.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Anioły twarde niczym skała";
"T_GAME_QUEST_SUCCESS" = "Zadanie zakończone!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "To szczytny cel, pozwól mu.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Co za dziwny typ.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Panie, nie możemy pozwalać mu na takie zachowanie. Zbudujmy obóz żonglera i niech ten szaleniec zajmie się rozrywką.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Wspaniale! Ludzie wydają się być zadowoleni z takiego obrotu spraw.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Obserwujesz osadę z oddali.\n\nŁowca łez nadal ściga mieszkańców. Coraz więcej osób odmawia wyjścia z domu.\n\nPowoli odchodzisz od okna, aby nie musieć oglądać szkód wyrządzonych przez twoją decyzję.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Może trzeba było coś zrobić… Ten dziwny osobnik terroryzuje mieszkańców, których morale spada. Miejmy nadzieję, że to nie potrwa długo!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Gubernatorze, tego ranka powiedziano mi, że jeden z mieszkańców postanowił wszystkich uszczęśliwić. Zaczął ganiać osadników i zmuszać ich do śmiechu.";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "Łowca łez";
"T_GAME_QUEST_THE_BATH_B_001" = "Ledwo uniknęliśmy tragedii. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Ogłośmy, że kąpiel jest teraz obowiązkowa. Tak zwalczymy chorobę!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Nieobowiązkowe kąpiele.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "Nigdy nie uczysz się na własnych błędach!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Waszmości, doszły nas słuchy o kolejnej epidemii. Jest znacznie poważniejsza od poprzedniej.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Tym razem, czy tego waszmość chcesz, czy nie, zarządzam obowiązkowe kąpiele!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Twój doradca ocalił wielu ludzi przed chorobą. Nawet wspomniano o nim w podręcznikach historii. Ale to ty nie chciałeś zmuszać ludzi do kąpieli. I nawet po latach kochają cię setki dzieci, ponieważ, tu cytat: „Kąpiel to coś okropnego”. ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Obowiązkowe kąpiele!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Mądrze, waszmości. Liczba zachorowań zaczęła spadać.";
"T_GAME_QUEST_THE_BATH_DESC" = "Kilka dni temu w mieście powstały publiczne łaźnie. To świetny pomysł, ale mieszczanie boją się wody i nie chcą się myć. \n\nCo powinniśmy zrobić?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Podgrzej wodę.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Zbierzmy dość drewna, by podgrzać wodę w łaźniach.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Idealnie. Woda ma odpowiednią temperaturę i udało nam się przekonać część mieszkańców do kąpieli.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Niestety, wysiłek poszedł na marne i w mieście zaczęła szerzyć się zaraza.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Daj im spokój.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Jak sobie życzysz. Ale jeśli w osadzie dojdzie do epidemii, nie przychodź do mnie z płaczem!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Przez ostatnie miesiące niewielu mieszkańców regularnie się myło. A gdy jeden z nich zachorował, zaraził trzech kolejnych! Niektórzy są przekonani, że źródłem zarazy są łaźnie.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Ulecz mieszczan.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Pora kąpieli";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Łapówki.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Przywódcy religijni za drobną opłatą zgodzili się wygłosić kazanie, w którym wspomnieli, że kąpiele upiększają.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Przekaż odpowiednie fundusze.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Pozostaje tylko zapłacić przywódcom religijnym, waszmości.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Dziękuję, gubernatorze, rozpowszechnię tę wieść.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Wysiłek się opłacił. Zaraza przez jakiś czas będzie roznosić się wolniej!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Zmusić ich!";
"T_GAME_QUEST_THE_BATH_YES_002" = "Załatwione! Nasi miejscy krzykacze ogłaszają dobre wieści!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Nie wszystkim mieszkańcom spodobały się regularne kąpiele. Niektórzy twierdzą, że po obmywaniu czują się słabo.\n\nInni uważają, że woda jest za zimna i nie chcą się myć.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Przesłuchaj magika.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Gdy rozpoczynasz przesłuchanie, wszędzie wokół snuje się gęsty dym, całkowicie przesłaniający widoczność.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Stoisz przed dylematem: możesz dostarczyć wymagane surowce lub pozwolić sytuacji się rozwijać, co ma być, to będzie. Pospiesz się i zacznij działać. Kto wie, do czego są zdolni pozostali dwaj magicy.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Waszmości! Nie udało nam się, magicy zabrali surowce i uciekli.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Przekaż surowce.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Spróbujmy dostarczyć surowce temu przeklętemu magikowi!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Wyprodukowaliśmy potrzebne surowce. Teraz powinniśmy je dostarczyć we wskazane miejsce.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Zastawiasz pułapkę na magików za radą swojego doradcy. Gdy zjawią się po towar, zostaną złapani w sieć. Oby ten pomysł się sprawdził.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Waszmości! Schwytaliśmy drugiego magika!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Surowców pilnuje dwóch strażników. Pozostali dwaj magicy zbliżają się powoli, by odebrać towary. Gdy są w połowie drogi, straże uruchamiają pułapkę.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Nie daj się namówić.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Zatem chcesz sprowokować gniew moich braci. Nie chciałbym być na twoim miejscu, gubernatorze.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "Zapłacisz za to człowiekowi, dla którego pracujemy!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Ha! W końcu przyznajesz, że wykonujesz czyjeś rozkazy! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "Magik przygryza wargę, żałując, że się wygadał. Okazuje się, że przysłał go ktoś, kto ma z tobą na pieńku.\n\nZastanawiasz się, kto to może być, ale nikt nie przychodzi ci do głowy.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Doradca przybiega z paniką w oczach: „Waszmości, magicy u bram! Proszą o gościnę na kilka dni. Przyjmiemy ich?”";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Gubernatorze… To nieporozumienie. Moi bracia i ja nie chcieliśmy narobić tylu problemów.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Zatem to twoi bracia. Dlaczego wywołaliście pożar?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Nie zamierzaliśmy, o waszmości. Po prostu byliśmy trochę nieostrożni…";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Dla kogo pracujecie? Dla bandytów?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "Skądże! Ale jeśli chcesz się pozbyć gęstego dymu powoli pochłaniającego twoje ziemie, lepiej spełnij moją prośbę.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "Jaką prośbę? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Chcę otrzymać surowce i pieniądze!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "A co potem? Powiedz, gdzie znajdę twoich braci!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Jeśli odmówisz, spodziewaj się kolejnych katastrof.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Waszmości, czy człowiekiem, który wynajął magików, mógłby być książę Cannes? Przypomniałem sobie, że słał do ciebie groźby, gdy ty i królowa Frygith zaczęliście wymieniać listy.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Doradca może mieć rację. Przypominasz sobie, że książę Cannes oświadczył się królowej Frygith, ale po waszym spotkaniu i słynnym tańcu odrzuciła jego zaloty.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Tani kuglarzu! Wynajął cię książę Cannes? Wszystko już wiemy!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "Owszem… Rozwiązałeś zagadkę. Dogadajmy się. Wręcz mi odpowiednią sumę, a ja i moi bracia damy ci spokój. Nie będziemy cię więcej nachodzić.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Waszmości, nie mamy dobrej pozycji negocjacyjnej. Dajmy mu tyle, ile chce i zakończmy już tę sprawę. Nie możemy walczyć z nadprzyrodzonymi katastrofami.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Nie lubisz szantażu, ale przyznajesz, że doradca ma rację. Dobro mieszczan jest ważniejsze od twojego ego.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Teraz wystarczy puścić magika wolno i mu zapłacić.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Interesy z gubernatorem to przyjemność!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "Magicy zniknęli z górą pieniędzy. Ale nie musisz się już nimi martwić.\n\nCo do księcia Cannes, królowa otrzymała twój list i obiecała, że zajmie się tą sprawą osobiście. Wszystko dobre, co się dobrze kończy.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Gdy już uratowałeś miasto przed pożarem i doszedłeś do siebie, prosisz strażnika, by przyprowadził magików. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Żołnierze mówią, że znaleźli tylko jednego z trzech magików.\n\nPozostali dwaj gdzieś zniknęli.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Waszmości! Wszystko w porządku? Magicy wysadzili budynki w powietrze! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Musimy jak najszybciej ugasić ogień!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "Ostatni pożar jest już pod kontrolą, waszmości.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "Magików jest trzech, cieszą się, że ich prośba została wysłuchana. Zapewniasz im pokój w zajeździe. Ponieważ nie potrzebują nic więcej, powracasz do swoich gubernatorskich obowiązków.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Tuż po wyjściu z zajazdu słyszysz głośny wybuch. BUUUUUUUUM! Kilka budynków płonie!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Zamknij bramy.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "O nie! Panuje epidemia, a niektóre budynki stanęły w płomieniach! To pewnie sztuczka magików!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Hahahahahahahaha!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Spieszmy się, uleczmy mieszczan i ugaśmy pożary!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Po raz kolejny udało nam się uniknąć większej katastrofy…";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Kontynuuj poszukiwania.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Będziemy szukać dalej, waszmości!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "Tam jest jeden! Brać go!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Strażnicy gonią drugiego magika, gdy nagle osadę okrywa gęsty dym. Straże wstrzymują pościg, gdyż nie widzą, dokąd mają biec.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Waszmości, nowy problem! Nie możemy się szybko poruszać! Jakbyśmy brnęli przez galaretę!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Wycofajmy się do zamku i przesłuchajmy schwytanego magika.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Korzystasz z tej rady i barykadujesz się w swojej twierdzy, by przepytać pierwszego magika. Poza tym prosisz dowódcę straży o zabezpieczenie zamku, by nikt nie mógł wejść ani wyjść.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Postanawiasz rozdzielić dwóch magików i przesłuchać tego, którego udało się złapać przed chwilą w twoją wspaniałą pułapkę.\n\nNiestety, nie udało ci się odzyskać surowców, trzeci magik zdążył z nimi uciec.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "Drugi magik jest bardziej pewny siebie. Bez wahania mówi: „Gratuluję, gubernatorze, przyłapałeś mnie na gorącym uczynku. Ale jeśli natychmiast mnie nie uwolnisz, twojej osadzie przytrafi się coś strasznego”.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Uwolnij go.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Boisz się tego, co może spotkać twoją osadę i postanawiasz go uwolnić.\n\n„Ale z ciebie urwis, gubernatorze” – powiada magik, nim znika w chmurze dymu tuż po tym, jak strażnicy zdejmują mu łańcuchy.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Waszmości! Pierwszy magik też uciekł! Jego brat teleportował się obok niego i obaj zniknęli!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "No to wracamy do punktu wyjścia.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "Poszukamy tych łobuzów, o waszmości! Możesz nam zaufać.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Teraz musimy czekać na powrót patrolu, waszmości.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Twoi strażnicy od dawna szukają magików. Bezskutecznie. Tymczasem z dnia na dzień spowalniająca wszystkich chmura gęstego dymu powoli się rozwiewa.\n\nZagadka magików pozostaje nierozwiązana.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Niech pozostanie więźniem.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Magicy";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Niech wejdą.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Niebieski.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Zielony.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Muszę przyznać, że niebieski to odważny wybór. Tak piękny kolor każdemu przypadnie do gustu. To barwa snów, mądrości i lojalności. To wiele o tobie mówi, gubernatorze.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Waszmości, mamy gościa w naszym wyremontowanym pokoju.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Niestety kolor ścian nie pozwolił mu zasnąć przez całą noc i winą za to obarcza ciebie.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Och, waszmości, nasz gość jest zachwycony tym pokojem. Szczególnie spodobał mu się kolor! Postanowił podarować nam trochę punktów prestiżu.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "To prawda, że zieleń znana jest z przyciągania niepowodzenia. Ale to także symbol nadziei, szczęścia i stabilności. Trwa w harmonii ze wszystkimi innymi kolorami natury. Muszę powiedzieć, że to dobry wybór.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Gubernatorze, właśnie odremontowaliśmy jeden z zamkowych pokoi. Jaki kolor będzie bardziej odpowiedni?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "Pokój";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Nie ma mowy.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Wyślij szpiegów.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "Nie ma czegoś takiego jak magia.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Przyzwij czarownicę.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Waszmości, to okropne. Jak to możliwe? Czy to magik biegły w czarnej magii?! Nikt nie powinien mieć takich mocy!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "To mądra decyzja. Wyślijmy naszych najlepszych szpiegów, aby śledzili tego szalonego mieszkańca, oraz poczekajmy na ich doniesienia.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Twoi szpiedzy powrócili z raportem.\n\n„Śledziliśmy tego osobnika zwanego złodziejem radości. Wygląda na to, że jego słowa wywołują w mieszkańcach wielki smutek. Nie pamiętają już o żadnych radosnych momentach ze swojego życia”.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Waszmości! Wygląda na to, że jeden z naszych mieszkańców kradnie radość swoim pobratymcom. \n\nKilku osadników złożyło na złodzieja skargę. Oto zeznania jednej z ofiar: „Pewnego ranka podszedł do mnie, aby ze mną porozmawiać. Wysłuchałem go uważnie i nagle poczułem się bardzo smutny. Tak jakby jego słowa odebrały mi całą radość”.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Waszmości, czy powinniśmy coś zrobić, aby rozwiązać ten problem?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Gubernatorze, co powinniśmy zrobić?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Pomóż czarownicy.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "Duchy nie istnieją!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Wygląda na to, że podjęte przez nas działania przynoszą efekty, waszmości.\n\nZłodziej radości nadal popełnia złe czyny, ale teraz będziemy z nim walczyć. \n\nCzy powinniśmy wysłać strażników, aby postawili go przed sądem za jego niecne uczynki? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Niech sprawiedliwości stanie się zadość.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Nic nie rób.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Jesteś rozsądną osobą. Tylko nauka może wytłumaczyć i rozwiązać kwestię złodzieja radości.\n\nMożesz wezwać swego najlepszego naukowca, aby opracował formułę, która pozwoli mieszkańcom ponownie odczuwać radość.\n\nTo, oczywiście, będzie kosztować. Naukowcy będą żądać mnóstwa pieniędzy. Ale albo to, albo możemy całkowicie pożegnać się ze szczęściem.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Problem dotyczący złodzieja radości nie zaniepokoił cię w wystarczającym stopniu, jednakże liczba przygnębionych mieszkańców zaczęła drastycznie wzrastać.\n\nZdezorientowany schroniłeś się w swoim zamku, nie wiedząc, co zrobić z tą katastrofą. Powiadają, że czas leczy rany. \n\nMiejmy nadzieję, że twoja cierpliwość jeszcze się nie wyczerpała.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "Czarownica zniknęła. Niektórzy nawet twierdzą, że opuściła osadę, ponieważ nie chciała cierpieć przez ciebie, tak jak cała reszta.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Krótko po jej odejściu sytuacja stała się nie do zniesienia. Wszyscy mieszkańcy zostali owładnięci głębokim smutkiem.\n\nKto wie, jak długo to potrwa?";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Wyślijmy strażników, aby go dorwali!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Strażnicy szukali złodzieja godzinami i nic nie znaleźli. Wszyscy powrócili smutni i przygnębieni. Twierdzą, że go słyszeli, ale nigdy go nie zobaczyli.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Krótko po powrocie strażników przyleciała sowa z wiadomością od czarownicy.\n\nInformuje w niej, że złodziej radości to tylko duch, który żywi się szczęściem innych osób, pozostawiając je smutne i zrozpaczone. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Pomimo starań naukowców, którzy próbowali opóźnić ten proces, cała wioska pogrążyła się w nieszczęściu. Bez czarownicy nie pozostał ci żaden sposób na obronę przed duchem. \n\nMiejmy nadzieję, że czas uleczy naszych mieszkańców.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "Minęło sporo czasu i do osady powraca dobry nastrój. Złodziej radości to teraz jedynie odległe wspomnienie.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Poproś o radę czarownicę.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Negocjuj.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Waszmości, spróbuję negocjować z tymi naukowcami. Pozwól mi to zrobić, wszystkim się zajmę!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Twój doradca, który jest wspaniałym negocjatorem, z powodzeniem obniżył stawkę naukowców! Dobra robota. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Auć. Twój doradca nie zdołał przeprowadzić odpowiednich negocjacji. Naukowcy podnieśli swoje stawki i już nie chcą z tobą dyskutować.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Zapłać naukowcom.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Jeśli musimy zapłacić, to zapłaćmy, bo jeśli poczekamy jeszcze dłużej, to będziemy zgubieni.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Twoi mieszkańcy cierpią na depresję, gubernatorze. W niczym nie widzą pozytywów.\n\nProblem ten rozwiąże pokazanie im jasnej strony życia i udowodnienie, że nie jest ono tak przygnębiające, jak im się wydaje. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Zacznijmy od kilku dekoracji oraz budowy placu na festyn piwowarski. Muzyka podnosi morale. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "Całe miasto zaczyna czuć się lepiej. Część mieszkańców, których radość zniknęła, zaczynają odzyskiwać świadomość, że życie niesie ze sobą szczęście.\n\nJednakże złodziej radości nadal napełnia serca ludzi przerażeniem.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Złodziej radości";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Gubernatorze, minęły lata, od kiedy ostatni raz musieliśmy zwrócić się o pomoc do czarownicy… Mam nadzieję, że to nie sprowadzi na osadę jeszcze większego nieszczęścia niż obecne.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Dzień dobry, gubernatorze. Dobrze cię znowu widzieć. Masz kłopoty?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Gdy wyjaśniasz czarownicy sytuację, ta się tylko uśmiecha. Wymyśliła rozwiązanie tego problemu, czy to może jakiś podły podstęp?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Cóż, mów więc! Dlaczego się tak uśmiechasz? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Waszmości, twój złodziej radości nie istnieje.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Ależ to musi być prawda, skoro jeden z naszych szpiegów odczuł skutki rozmowy z nim!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "On po prostu zobaczył ducha smutku. Czasem ta istota pojawia się po wybudowaniu obiektu religijnego. Są to duchy, które karmią się radością innych osób. \n\nDuch rośnie w siłę oraz zwiększa swoją moc poprzez wchłanianie szczęścia. Niestety nie powraca ono do osób, które zostały z niego okradzione.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "Jak się go pozbędziemy?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Znam sposób, ale będę potrzebować twej pomocy.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Pomożemy ci. Czego potrzebujesz?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Potrzebujemy mauzoleum oraz nagrobków.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "Możesz uznać sprawę za załatwioną!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Ukończyliśmy twoje zadanie, czarownico. Czas, abyś pokazała nam, na co cię stać.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "Czarownica kieruje się do mauzoleum i znika w środku. Słyszysz dobiegające z budynku inkantacje. Nagle zrywa się wiatr i wygląda na to, że szykuje się okropna burza.\n\nCzarownica nadal nie wychodzi z mauzoleum. \n\nNiespodziewanie odczuwasz przeogromny smutek. Czujesz, jak otacza cię przejmujące zimno i ciemność.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Wtedy w oddali dostrzegasz promień słońca. Bardzo maleńki promyk. Skupiasz się na nim, a wtedy zaczyna nabierać intensywności. \n\nPromień słońca zdaje się przybierać formę wspomnienia. Twego najszczęśliwszego wspomnienia.\n\nZnów czujesz się dobrze.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Gubernatorze… O co tu chodziło? Też to wyczułeś?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Waszmości, od teraz duch smutku przestanie cię gnębić. Po twojej twarzy widzę, że go spotkałeś. Teraz to koniec. Został uwięziony.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "To było okropne! Bardzo ci dziękuję!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "Wioska pozbyła się tego dziwnego ducha. Mieszkańcy odzyskali radość i są ci wdzięczni.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Waszmości, jeśli nie pomożesz mi w tej misji dotyczącej ducha, to zapewniam cię, że stanie się on twoją zgubą.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "Niech tak będzie! Precz mi z oczu z tymi diabelskimi czarami!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Niech grają.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Też chcę zagrać!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Festyn gier planszowych?! Cóż to za dziwny pomysł, waszmości. Jak to zrobimy? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Waszmości, nasi żołnierze w wieżach strażniczych spędzają tyle czasu na grach, że mieszkańcy w ogóle nie czują się chronieni. Co powinniśmy zrobić?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Gry w wieży";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Potrzebujemy trochę drewna i kamieni.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Potrzebujemy projektantów i kilku pomysłów na gry.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Dzięki niewielkiej darowiźnie moglibyśmy polepszyć naszą reputację u króla, wasza miłość.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Zbuduj wieżę strażniczą w zasięgu koszar.";
"T_GAME_QUEST_WATER" = "Woda";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Czy możesz się uciszyć?";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Zacznijmy budowę studni, aby zapobiegać takim wypadkom.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Och, waszmości, proszę, nasze plony są w niebezpieczeństwie. Jeśli nic nie zrobisz, nie będziemy mieli szansy na spokojną zimę.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "Gubernator już się wypowiedział w tej sprawie. Jeśli nadal będziesz przychodzić do zamku i jęczeć, będziemy musieli cię zamknąć. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "Niedługo się zawiedziecie!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "Waszmości! Pola! To okropne! Nic już na nich nie rośnie, upał jest tak straszny, że nasze plony zostały zniszczone. Trzeba było zaufać rolnikowi… Teraz jest już za późno.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Pośpieszmy się i zbudujmy studnie, waszmości.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "Konstrukcja studni została ukończona. Lepiej zapobiegać niż leczyć! Czas pokaże, czy dobrze zrobiliśmy, słuchając rolnika.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Och, waszmości! Rolnicy powiedzieli mi, że na ich pola nadeszła fala upałów, ale dzięki wybudowanym studniom uniknęliśmy sporych kłopotów.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Waszmości! Przyśnił mi się kolejny proroczy sen! Pola stanęły w ogniu. Nic już na nich nie rosło, nie było też nigdzie wody.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Przeczucie";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Zaparzcie jej herbatkę ziołową na uspokojenie. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "A skoro już mowa o ziołowej herbatce – spopularyzujmy ten pomysł. Dajmy znać pobliskim miastom, że gorąca woda i zioła oraz chwytliwe hasełko są świetne.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Ulepszyć obronę!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Gubernatorze, ulepszmy naszą obronę wojskową!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Odwaliliśmy kawał dobrej roboty i mamy nowatorskie hasło: „Herbata ziołowa, dzięki której zapomnisz o owcach”.";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "A teraz poczekajmy. Z tego, co wiemy, zrobiliśmy zamieszanie o nic. Powinniśmy byli dać jej tę herbatkę…";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Pomimo usprawnienia obrony oczekiwane ataki bandytów nigdy nie nastąpiły. Od teraz możesz za to podziwiać cudne budynki wojskowe.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "O nie, panie. Ta staruszka znowu to robi! Krzyczy z dachu, że czarownica z lasu przejdzie przez naszą osadę i zniszczy wszystko na swojej drodze.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "Sposób na czarownicę";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Ach, waszmości! \n\nTam na dole było niesamowicie! Jezioro bezmiaru i piękna! \n\nTa kobieta też tam była! Goniłem ją tunelami kopalni przez jakiś kilometr, zanim straciłem ją z oczu.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "I wtedy… gdy już myślałem, że wrócę z pustymi rękoma, ujrzałem tysiące świateł. Och, waszmości, powinieneś to zobaczyć, jeszcze nigdy nie widziałem niczego podobnego! \n\nOpowiedziała mi o planach ucieczki z całym łupem i rozpoczęcia nowego życia gdzieś indziej. Od śmierci męża ciężko jest jej tu mieszkać, zbyt wiele wspomnień…";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Waszmości, jesteśmy gotowi, aby wkroczyć do kopalni i zdobyć łup. Na mapie zaznaczonych jest kilka miejsc.\n\nGdzie zaczniemy? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Północna kryjówka";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Południowa kryjówka";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "Och, waszmości! Mieliśmy szczęście! Nasz zespół uciekł bez szwanku. Tunele się zawaliły!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "Wynik pierwszej ekspedycji jest bardzo satysfakcjonujący! Twoi ludzie zdołali powrócić cali i zdrowi z częścią pirackiego skarbu.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Waszmości, jesteśmy gotowi do drugiego zejścia do kopalni.\n\nKtórą kryjówkę sprawdzimy tym razem?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Wschodnia kryjówka";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Zachodnia kryjówka";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "Szykuje się niesamowita okazja, waszmości! Dwa razy zwycięsko powróciliśmy z poszukiwania skarbu!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Uważnie przyglądasz się planom kopalni. Widzisz umiejscowienie podziemnego jeziora, do którego spływa rzeka prowadząca prosto do morza. Bardzo korzystne wejście dla piratów!\n\nJednak te tunele nie są bezpieczne i w każdej chwili grożą zawaleniem.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "Dobre wieści! Gdy pomagałeś kowalowi, twój doradca zdołał zdobyć plany kopalni.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Zabezpiecz kopalnię.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Wyślij zwiadowców do kopalni.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Zainwestujmy w zabezpieczenie kopalni, waszmości. To zadanie będzie wymagało od nas wielu surowców, ale zapewniam cię, że tego nie pożałujesz.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "Waszmości, to niesamowite! Udało się nam zabezpieczyć kopalnię! Nasi pierwsi zwiadowcy wyruszyli na patrol i odnaleźli żonę pirata!\nUdało się jej uciec, ale pozostawiła mapę kopalni z zaznaczonymi obszarami. Myślę, że w tych miejscach ukryty jest skarb!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Jedne, co musimy zrobić, to zapłacić daninę, waszmości.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Zwiadowcy, zwiadowcy… Nie mamy ich aż tylu! Ja to zrobię. Ale potrzebuję do tego konkretnego wyposażenia.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "W porządku, mogę ruszać!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Twój doradca wyruszył do kopalni, aby dowiedzieć się czegoś więcej na temat kobiety.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Dostarczcie mi wyposażenie potrzebne, aby ta misja zakończyła się sukcesem.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Nagle tracisz cierpliwość dla kowala. Rozkazujesz mu natychmiast przynieść potrzebne narzędzia oraz oświadczasz, że jego pilna prośba to nie twoja sprawa. Nie obchodzi cię, jeśli zbankrutuje.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Ja… Przyniosę ci je jak najszybciej, panie.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Odmówienie pomocy kowalowi było niegrzeczne. Musisz zrozumieć, że on musi pracować, aby móc się utrzymać, a ta przesyłka wydawała się być bardzo ważna dla gospodarki naszego miasta. Mam nadzieję, że nie będzie miał nam tego za złe.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Auć, waszmości… Powinieneś był bardziej uważać. Kowal rozpowiedział wszystkim o tym, jak go potraktowałeś. Teraz kilku mieszkańców protestuje, a mężczyzna odmówił powrotu do zamku.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Waszmości, nie mamy innej możliwości, jak tylko wybudować plac turniejowy. To odwróci uwagę ludzi i pomoże im rozładować napięcie.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Wydaje się, że mieszkańcy się uspokoili, jednak nie skończyliśmy jeszcze z piracką historią!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Waszmości, potrzebujemy placu turniejowego. W innym przypadku mieszkańcy nie będą ani zadowoleni, ani produktywni. Ten strajk to marnowanie cennego czasu, który moglibyśmy poświęcić na sprawę z piratami i kopalnią.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Waszmości, gdy my zajmowaliśmy się powstaniem, żona pirata skorzystała z okazji i wydobyła skarb z kopalni. To właśnie tam był przez cały ten czas!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Nasi szpiedzy znaleźli wiadomość od kobiety. Napisała, że nie mogła już dłużej znieść nieobecności swojego męża, więc jakiś czas odizoluje się na boskiej wyspie, na której posiada niewielki zamek.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Wygląda na to, że ominęła nas niezła sumka, waszmości. Widzisz, dokąd zawiodła nas twoja pochopna decyzja? W każdym razie możemy już zamknąć ten rozdział.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Zbudujmy plac turniejowy.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Mylisz się, tak łatwo podejmując taką decyzję, waszmości. Kto wie, co moglibyśmy tam odkryć?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Kilka dni po odmowie zajęcia się tą skargą kopalnia zawaliła się. Ludzie uważają, że ponosisz odpowiedzialność za to tragiczne wydarzenie.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "Twoi ludzie zaczynają zapominać o zawaleniu się kopalni. Upłynęło trochę czasu, a ich morale jest znowu wysokie.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Nie udało się nam dostać do miejsca oznaczonego na mapie, waszmości. Nie zdołaliśmy odzyskać żadnego łupu. Ale co najważniejsze – jesteśmy żywi.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Pomimo porażki ta przygoda zapewniła ci trochę prestiżu. Kto by pomyślał, że piraci ukrywają takie skarby w twoich kopalniach?\n\nPóki co jednak twoja kariera poszukiwacza skarbów się zakończyła.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Och, waszmości, powiedziano mi, że tunele kopalni się zawaliły! Mieliśmy szczęście, że dwa razy udało nam się powrócić ze skarbami.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Postanawiasz zorganizować wystawny posiłek dla żołnierzy, aby podziękować im za przyniesienie ci tych skarbów.\n\nTa piracka historia jest już za tobą. Kto wie? Może pewnego dnia znajdziesz mapę, która poprowadzi cię do innych tajemnic.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "Te skarby wkrótce będą twoje! \n\nWydajesz żołnierzom rozkaz, aby odnaleźli skarb i przynieśli go do ciebie.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "To niesamowite! Zobacz, co udało nam się odnaleźć w kopalniach! Miałeś rację, zabezpieczając je, zanim wysłałeś tam swoich ludzi. To niewiarygodne bogactwo! Plotki o tym piracie były całkowicie prawdziwe. Jesteśmy bogaci!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Niewiele możemy zrobić z informacjami, które posiadamy. Może warto byłoby poprosić o poradę eksperta.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Przywołaj górnika.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "To dobry pomysł, waszmości. Może mogliby przekazać nam mapę kopalni, żebyśmy lepiej zrozumieli sytuację.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Waszmości, cieszę się, że poprosiłeś mnie o pomoc. Przyniosłem ze sobą plany kopalni, mam nadzieję, że ci pomogą.\n\nTe tunele są stare i obawiam się, że się zawalą.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Przyzwij kowala.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Kowal na pewno będzie wiedział, jakie kamienie próbuje rozłupać ta kobieta i dlaczego.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Waszmości, otrzymaliśmy kilka skarg na temat kopalni.\nJakaś kobieta wchodzi do nich każdego dnia, przesuwa kamienie, czasem je rozłupuje. Ale wiemy na pewno, że każdego dnia zapuszcza się w tunele coraz głębiej.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Dowiedz się więcej o tej kobiecie.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "To nie moja sprawa.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Mieszkańcy się martwią, tunele nie są bezpieczne, a kopalnia w każdej chwili może się zawalić.\n\nNaszym obowiązkiem jest sprawdzenie, o co chodzi w tej historii.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Mam nadzieję, że to cię czegoś nauczyło!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "W czasie, gdy twój doradca poszukuje wskazówek, dobrze byłoby przez jakiś czas zająć się miastem. Spróbuj ulepszyć życie swojego ludu.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "Jestem z powrotem, waszmości! Śledziłem tę kobietę, ale nie było łatwo.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Wygląda na to, że szuka jakiegoś przedmiotu. Widziałem, jak rozłupuje kilka kamieni i uważnie przygląda się odłamkom.\n\nNiestety nie mogłem zbyt długo za nią iść. Zdaje się, że zna kopalnie jak własną kieszeń!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Twój doradca powraca z wieściami ze swojej misji.\nW swoim raporcie informuje, że ta kobieta niedawno została wdową. \n\nJej mąż był bardzo sławnym piratem. Mówi się, że posiadał przeogromny skarb, który ukrył niedaleko stąd.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Mam teorię, waszmości. Myślę, że inni piraci grożą tej kobiecie, aby wyjawiła im dokładne miejsce, w którym schowany jest skarb!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Kontynuuj śledztwo.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Zostawmy to.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "Kobieta i kopalnia";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "Kowal przybywa w pośpiechu, strażnicy wyciągnęli go z kuźni. Wydaje się zatroskany.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Waszmości, co mogę dla ciebie zrobić?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Mamy ważną misję i potrzebujemy twojej wiedzy.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Słucham.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Twój doradca wyjaśnia sprawę kowalowi.\n\nPokazuje mu także odłamki kamieni, które zebrał. Kątem oka zauważasz, że kowal chyba rozpoznaje ten rodzaj kamienia.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Kurka wodna! Ale mnóstwo geod!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Geod, powiadasz? ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "To specjalne kryształy, które w środku mogą zawierać skarby. Dość często okazują się drogocenne.\n\nNiektórzy piraci używali kodów opartych na geodach, aby zapamiętać, gdzie ukryli skarb.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Mam kilka z nich w moim warsztacie, mogę pokazać, jak je rozłupać przy pomocy odpowiedniego narzędzia.\n\nAle… mam także nagłą i ważną przesyłkę do wysłania i doceniłbym twą pomoc. W ramach wdzięczności za dostarczone przeze mnie informacje.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Odmów.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Zaakceptuj.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Muszę wyprodukować narzędzia dla górników, to spore zamówienie.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Oto geody. Spójrzcie, pokażę wam. Dzięki temu urządzeniu można otworzyć je z łatwością. Bardzo często w środku nie ma nic specjalnego, ale czasami można natknąć się na prawdziwe cuda!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "KRR KRR… BRZĘK!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "Och, waszmości, spójrz na tę geodę! Cóż za wspaniałość!";
