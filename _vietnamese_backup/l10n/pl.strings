"T_TUTORIAL_02_MAINQUEST_SUCCESS" = "Dobra robota, mój panie. Osada jest gotowa na zimę. Mieszkańcy ucieszą się, gdy o tym usłyszą.\n\nProszę za mną, wasza miłość. Pani Fitz-Givens przygotowała ucztę na twoją cześć.";
"T_TUTORIAL_02_MAINQUEST_TITLE" = "Zgromadź zapasy żywności na nadchodzącą zimę.";
"T_TUTORIAL_02_NOBLEMAN_01_STARTED" = "Dzień dobry, gubernatorze! Pamiętasz mnie? Spotkaliśmy się kiedyś na królewskim dworze…";
"T_TUTORIAL_02_NOBLEMAN_01_SUCCESS" = "Czy tutejsi mieszkańcy słyszeli o tym, że wygnano cię z dworu? Chyba byliby bardzo rozczarowani, gdyby wieści do nich dotarły, prawda?";
"T_TUTORIAL_02_NOBLEMAN_02_STARTED" = "Tak właśnie myślałem!";
"T_TUTORIAL_02_NOBLEMAN_02_SUCCESS" = "No dobrze… Twój wybryk na dworze pozostanie naszą słodką tajemnicą. Na razie. Miłego dnia, gubernatorze.";
"T_TUTORIAL_02_NOBLEMAN_03_SUCCESS" = "Mój panie! Jeśli mieszkańcy dowiedzą się, o co cię oskarżono, na pewno wtrącą nas do lochu…";
"T_TUTORIAL_02_NOBLEMAN_04_STARTED" = "Wiem, mój panie… Nie wzięliśmy tych pieniędzy. Oskarżono cię bezpodstawnie, ale oprócz nas i tego szlachcica nikt o tym nie wie.";
"T_TUTORIAL_02_NOBLEMAN_04_SUCCESS" = "Ten człowiek może nas szantażować. Trzeba postępować z nim rozważnie…";
"T_TUTORIAL_02_QUESTS_HINT_STARTED" = "Podgląd wszystkich bieżących zadań znajduje się w zakładce „Zadania” w menu. Tam można również odbierać nagrody za ukończone zadania.";
"T_TUTORIAL_02_STOCK_HINT_STARTED" = "Szczegółowy podgląd zapasów surowców w osadzie dostępny jest w sekcji „Magazyn” w menu.";
"T_TUTORIAL_02_WELCOME_01_SUCCESS" = "W sali audiencyjnej czeka więcej mieszkańców, którzy mają do ciebie prośbę, mój panie. Chyba chcą porozmawiać o zapasach żywności w osadzie.";
"T_TUTORIAL_02_WINDMILL_01_REWARD" = "Rolnik bardzo się cieszy, że udało ci się odbudować młyn. Przesyła serdecznie pozdrowienia. Zostawił ci też trochę towarów.";
"T_TUTORIAL_02_WINDMILL_01_STARTED" = "Mój panie, zarządzam gospodarstwem u podnóża wzniesienia. Kilka miesięcy temu spłonął młyn i od tamtej pory nie mam gdzie mielić pszenicy. Byłbym ogromnie wdzięczny, gdyby młyn został odbudowany.";
"T_TUTORIAL_02_WINDMILL_02_SUCCESS" = "Świetna robota, wasza miłość. Teraz możemy przetworzyć pszenicę na coś bardziej jadalnego. W piekarni z mąki wypieka się chleb.";
"T_TUTORIAL_02_WINDMILL_03_SUCCESS" = "Młyn mieli pszenicę na mąkę. Warto, by jeden młyn zaopatrywało kilku rolników.";
"T_TUTORIAL_02_WORKERS_ASSIGN_STARTED" = "Mój panie, do konstrukcji niektórych złożonych budynków potrzebujemy kamienia.\n\nPrzydziel robotnika do kopalni. Dzięki temu sami będziemy mogli produkować niezbędne surowce.";
"T_TUTORIAL_03_CLIENT_MARKETBUILT_STARTED" = "Fantastycznie, wasza miłość. Im więcej próśb spełnisz, tym chętniej mieszczanie zapłacą wyższe podatki, bez ryzyka buntu.";
"T_TUTORIAL_03_CLOTHING_QUEST_DESC" = "Mieszkańcy osady pragną nowego odzienia, wasza miłość.\n\nNakaż budowę szwalni, w której krawiec będzie wytwarzał ubrania z tkanin.";
"T_TUTORIAL_03_CLOTHING_QUEST_SUCCESS" = "Bardzo dobrze, wasza miłość. W ten sposób spełnimy pragnienia mieszkańców, którzy zakupią odzienie na targowisku.";
"T_TUTORIAL_03_CLOTHING_QUEST_TITLE" = "Osiągnij wysokie zadowolenie dzięki ubraniom.";
"T_TUTORIAL_03_INTRO_SUCCESS" = "Mój panie, w skarbcu niemal hula wiatr. Zrób coś, w przeciwnym razie przestaniemy być wypłacalni!\n\nBez pieniędzy nie zdołamy wykonywać naszych zadań, a miasto nie będzie się rozwijać.";
"T_TUTORIAL_03_MAINQUEST_CONV_01" = "Mieszkańcy osady mają też inne potrzeby poza zaspokojeniem głodu i pragnienia, mój panie. ";
"T_TUTORIAL_03_MAINQUEST_CONV_02" = "Pragną między innymi nosić nowe ubrania, podziwiać dekoracje w osadzie czy kupować towary na targowisku.";
"T_TUTORIAL_03_MAINQUEST_DESC" = "Mieszkańcy osady mają kilka próśb. Przede wszystkim chodzi o nowe odzienie i targowisko.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_01" = "Ukończ zadanie od niewiasty.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_02" = "Ukończ zadanie od kupca.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_03" = "Zajmij się sprawą szlachcica.";
"T_TUTORIAL_03_MAINQUEST_SUCCESS" = "Mój panie, twoje wysiłki przyniosły efekty. Osada stale się rozwija, a my mamy odzież na zimę. Teraz wiem, że nasz gubernator jest nie tylko zdolny, lecz także troskliwy.\n\nWyprawiliśmy ucztę na twoją cześć, wasza miłość. Proszę za mną.";
"T_TUTORIAL_03_MAINQUEST_TITLE" = "Spełnij prośbę mieszkańca.";
"T_TUTORIAL_03_MAKE_PROFIT" = "Osiągnij zyski z handlu.";
"T_TUTORIAL_03_MARKETPLACE_CONST_TOOLTIP" = "Wybierz zastępczy plac budowy i wznieś na nim targowisko.";
"T_TUTORIAL_03_MARKET_TOOLTIP" = "Budynki publiczne, takie jak targowisko czy nawet studnia, zaopatrują ograniczoną liczbę mieszkańców. ";
"T_TUTORIAL_03_MARKET_TOOLTIP_02" = "W menu budowy lub menu kontekstowym budynku sprawdzisz, ile rodzin pomieści dany budynek publiczny.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT" = "Jeśli chcesz handlować, przejdź do menu w grze, a następnie wybierz zakładkę zapasów. Tam znajdziesz podkategorię o nazwie „Handel”. Handel możliwy jest tylko wtedy, gdy do osady przybędzie kupiec. Wózek kupca jest widoczny przed zamkiem.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT_SHORT" = "Jeśli chcesz handlować, przejdź do menu w grze, a następnie wybierz zakładkę zapasów. Tam znajdziesz podkategorię o nazwie „Handel”.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_TOOLTIP" = "Handlować możesz także przy użyciu menu kontekstowego budynku handlowego, gdy kupiec jest w osadzie.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_STARTED" = "Mój panie, jestem miejscowym kupcem. Ja również mam prośbę, tak jak ta piękna niewiasta przede mną.\n\nW naszej osadzie brakuje targowiska. Dzięki niemu wy… i ja także… moglibyśmy handlować towarami.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_SUCCESS" = "Zdaje się, że nasi mieszkańcy marzą o nowych ubraniach. Mogliby je zakupić na targowisku, a wtedy nie trzeba by szyć ich w osadzie, mój panie.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_TITLE" = "Przyjmij surowce.";
"T_TUTORIAL_03_MERCHANT_MARKET_STARTED" = "Mój panie, pozwoliłem sobie zakupić skrawek ziemi i położyć tam fundamenty pod nowe targowisko.\n\nCzy zechcesz przysłać robotnika, by ukończył budowę?";
"T_TUTORIAL_03_MERCHANT_MARKET_SUCCESS" = "Na targowisku możemy sprzedawać towary luksusowe z naszych magazynów. W ten sposób zaspokoimy pragnienia bogatszych mieszkańców osady, mój panie.";
"T_TUTORIAL_03_MERCHANT_OFFER_STARTED" = "To żadna tajemnica, że skarbiec niemal świeci pustkami. Ja chcę jednak, by nasza osada rozkwitała, dlatego wyłożę pieniądze na budowę targowiska z własnej kieszeni.\n\nUznaj to proszę za inwestycję w przyszłość naszej ukochanej osady.";
"T_TUTORIAL_03_MERCHANT_TIMER_TOOLTIP" = "Tu sprawdzisz, jak długo kupiec będzie przebywał w osadzie, by z tobą handlować.";
"T_TUTORIAL_03_SHEPHERD_QUEST_DESC" = "Mój panie, jeśli chcesz pozyskiwać wełnę, musisz przydzielić gospodarstwu dodatkowego robotnika, który zostanie pasterzem. Ja jestem zajęty żniwami i potrzebuję kogoś, kto pomoże mi z owcami.";
"T_TUTORIAL_03_SHEPHERD_QUEST_SUCCESS" = "Wspaniale, wasza miłość. Teraz możemy pozyskiwać nie tylko pszenicę, ale i wełnę.";
"T_TUTORIAL_03_SHEPHERD_QUEST_TITLE" = "Przydziel pasterza do gospodarstwa.";
"T_TUTORIAL_03_TAILOR_QUEST_DESC" = "Skoro w osadzie jest już tkalnia, do produkcji odzieży potrzebujemy jeszcze tylko szwalni, mój panie.";
"T_TUTORIAL_03_TAILOR_QUEST_SUCCESS" = "Świetna robota, mój panie. Teraz możemy rozpocząć produkcję odzieży. Mieszkańcy będą zachwyceni! Stworzyliśmy własny przemysł tekstylny.";
"T_TUTORIAL_03_TRIBUTE_DESC" = "Gubernatorze! Często ostatnio rozmyślałem o twojej marnej osadzie i nędznym życiu. Uznałem, że jeśli nie chcesz, bym rozważał odebranie ci szlacheckiego tytułu, musisz mi to jakoś wynagrodzić.\n\nCeną mojego milczenia będą regularne wypłaty; pierwszą poproszę już teraz!";
"T_TUTORIAL_03_TRIBUTE_SUCCESS" = "Zbyt długo czekałem! Czas minął. Zapłacisz mi, czy mam wezwać straż?";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_1" = "Nareszcie zniknął.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_2" = "Panie, musimy pomyśleć, jak uporamy się z tym wrogiem w przyszłości. Na pewno jeszcze wróci, by ponownie nas szantażować.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_3" = "Może powinniśmy spróbować się zrehabilitować i dowieść, że nie mieliśmy nic wspólnego z obrabowaniem królewskiego skarbca.";
"T_TUTORIAL_03_TRIBUTE_TITLE" = "Zapłata daniny";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_DESC" = "Mój panie, jeśli wolisz produkować ubrania w osadzie, będziemy potrzebować tkalni, która przerobi wełnę na tkaniny.";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_SUCCESS" = "Znakomicie, wasza miłość. Jak widzę, budowa tkalni została ukończona. Teraz możemy rozpocząć produkcję tkanin.\n";
"T_TUTORIAL_03_WOMAN_INQUIRY_STARTED" = "Dzień dobry, mój panie!\n\nMam szczególną prośbę od mieszkańców osady. Niektórzy bogatsi obywatele marzą o lepszym odzieniu, które pozwoli im odróżnić się od plebsu.\n\nCzy zadbasz o to, by na targowisku pojawiła się odzież lepszej jakości?   ";
"T_TUTORIAL_04_AVALANCHE_STARTED" = "Wasza miłość, rozbij butelkę o ścianę na szczęście.";
"T_TUTORIAL_04_AVALANCHE_STARTED_2" = "Czy tylko ja to słyszę? Co tu się może…";
"T_TUTORIAL_04_AVALANCHE_SUCCESS" = "Wszystko w porządku, mój panie?! Zeszła lawina! Przynajmniej nasza gospoda nadal…";
"T_TUTORIAL_04_COALBURNER_STARTED" = "Wasza miłość, zwykłe paleniska w zamku nie wystarczają, by ogrzać tak wielki budynek. Dzięki węglowi moglibyśmy nie tylko zapewnić sobie ciepło, lecz także wytwarzać sztaby żelaza.\n\nCzy zechcesz wznieść zakład węglarza?";
"T_TUTORIAL_04_COALBURNER_STARTED_02" = "Węgiel potrzebny jest głównie do produkcji sztabek żelaza i złota. Czy możesz zbudować zakład węglarza, dzięki któremu pozyskamy węgiel drzewny?";
"T_TUTORIAL_04_COALBURNER_SUCCESS" = "Mądrze byłoby zwiększyć produkcję drewna, bowiem potrzeba będzie go dużo, by wytworzyć węgiel drzewny.";
"T_TUTORIAL_04_COUNTDOWN_STARTED" = "Mój panie, musimy przetrwać zimę i zaczekać na wiosnę.";
"T_TUTORIAL_04_COUNTDOWN_SUCCESS" = "Co za szczęście! Ta okropna zima wreszcie się skończyła. Wkrótce będzie można zasiać zboże, wasza miłość!";
"T_TUTORIAL_04_COUNTDOWN_TITLE" = "Przetrwaj do wiosny.";
"T_TUTORIAL_04_EXTINGUISH_FAIL" = "Budynek strawiły płomienie, wasza miłość.";
"T_TUTORIAL_04_EXTINGUISH_STARTED" = "Pożar! Mój panie! Wybuchł pożar!\n\nTrzeba działać! Dlaczego w osadzie nie ma wieży strażackiej?";
"T_TUTORIAL_04_EXTINGUISH_SUCCESS" = "Bardzo ci dziękujemy, wasza miłość. Jesteś dla nas zbawieniem.";
"T_TUTORIAL_04_FOOD_HINT_WINTER" = "Mój panie, skończyła nam się żywność. Mieszkańców osady szczególnie trudno jest wykarmić zimą.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_01" = "Odbuduj gospodę.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_02" = "Przetrwaj do wiosny.";
"T_TUTORIAL_04_MAINQUEST_SUCCESS" = "Mój panie, udało ci się pomóc osadzie przebrnąć przez srogą zimę. Mieszczanie przygotowują wiosenny festyn na twoją cześć.";
"T_TUTORIAL_04_MAINQUEST_TITLE" = "Przetrwaj zimę.";
"T_TUTORIAL_04_MINE_STARTED" = "Nasza kopalnia kamienia została zniszczona w wyniku lawiny, ale na wschodzie osady jest jeszcze jedno złoże. To chyba dobre miejsce, by założyć nową kopalnię.";
"T_TUTORIAL_04_MINE_SUCCESS" = "Świetna robota, wasza miłość. W tej kopalni będziemy wydobywać nie tylko żelazo, lecz także kamień. Po ukończeniu budowy robotnik natychmiast zacznie wydobywać żelazo, możesz mu jednak nakazać, by pozyskiwał kamień.\n";
"T_TUTORIAL_04_MINE_TITLE" = "Wznieś kopalnię na złożach rudy na wschodzie osady.";
"T_TUTORIAL_04_START_NEXT_STARTED" = "…do licha. Nasza nowa gospoda… Nie tak miało być!";
"T_TUTORIAL_04_START_NEXT_SUCCESS" = "Do odbudowy gospody będą potrzebne narzędzia. Niestety cały zapas zużył się podczas budowy poprzedniej gospody.";
"T_TUTORIAL_04_TAVERN_STARTED" = "Wasza miłość, nareszcie możemy odbudować gospodę. To znacznie zwiększy ogólne szczęście mieszkańców.";
"T_TUTORIAL_04_TAVERN_SUCCESS" = "Znakomicie, wasza miłość. W osadzie nareszcie znów jest gospoda, w której mieszkańcy mogą rozerwać się po pracy.\n\nOczywiście gospoda działałaby znacznie sprawniej, gdyby zawsze można było tam kupić takie trunki jak podpiwek czy sok. Zimą nie zdołamy wyprodukować ich samodzielnie, możemy je jednak zakupić na rynku.";
"T_TUTORIAL_04_TAVERN_SUCCESS_02" = "Oczywiście gospoda działałaby znacznie skuteczniej, gdyby dostępne w niej były takie trunki jak podpiwek czy sok. Zimą jednak nie rosną winogrona ani chmiel, dlatego musimy kupić surowce na targowisku.";
"T_TUTORIAL_04_TOOLMAKER_STARTED" = "Skoro umiemy wytwarzać węgiel drzewny, wypadałoby wznieść jeszcze warsztat narzędziowy, wasza miłość. Dzięki produkcji narzędzi staniemy się bardziej niezależni.";
"T_TUTORIAL_04_TOOLMAKER_SUCCESS" = "Cudownie! Udało nam się zamknąć łańcuch produkcyjny narzędzi.";
"T_TUTORIAL_04_TOWNHOUSE_STARTED" = "Wasza miłość! Lawina zniszczyła dom. Trzeba go szybko odbudować, zanim jego mieszkańcy wyniosą się z osady.";
"T_TUTORIAL_04_TOWNHOUSE_SUCCESS" = "Świetna robota, wasza miłość. Teraz możemy poświęcić czas na odbudowę gospody.";
"T_TUTORIAL_04_TOWNHOUSE_TITLE" = "Zbuduj mały lub duży dom.";
"T_TUTORIAL_04_TRADE_CLOTHES_STARTED" = "Mój panie, moja rodzina marznie. Potrzeba nam lepszych ubrań. Czy zechcesz z dobroci serca podarować nam cieplejsze odzienie?";
"T_TUTORIAL_04_TRADE_CLOTHES_SUCCESS" = "Widzę, że masz dla nas odpowiedni zapas ubrań. Oto trochę narzędzi i pieniędzy, które oszczędzaliśmy właśnie na takie okazje. Dziękuję.";
"T_TUTORIAL_04_WELCOME_SUCCESS" = "Ładny dziś dzień, wasza miłość. Chłodny, ale ładny. Budowa nowej gospody nareszcie dobiegła końca. Udajmy się na ceremonię otwarcia.";
"T_TUTORIAL_05_ADVISOR_TALKS_01" = "Mój panie, powinniśmy kogoś wysłać, by śledził tego mężczyznę! Zachowuje się podejrzanie.";
"T_TUTORIAL_05_ADVISOR_TALKS_02" = "Dlaczego tak dziwnie mi się przyglądasz, mój panie? ";
"T_TUTORIAL_05_ADVISOR_TALKS_03" = "Proszę, tylko nie znowu ja, mój panie! Czy mógłbym się tym razem chociaż przebrać?";
"T_TUTORIAL_05_ADVISOR_TALKS_04" = "Co to jest? Kostium zwierzęcia? Nie założę tego… obrzydlistwo…";
"T_TUTORIAL_05_ARMORY_CONV_01" = "Mój panie! Bez zbrojowni nie wytworzymy uzbrojenia ani pancerzy. Musisz jak najszybciej zarządzić budowę.";
"T_TUTORIAL_05_BANDITS_SIGHTED" = "Mój panie, zwiadowcy donoszą, że w okolicy grasują bandyci. Musimy uważać. Mogą zaatakować osadę…";
"T_TUTORIAL_05_BANDIT_ATTACK_01" = "Myślałeś, że nie poznam twojego głupiego szpiega w tym szpetnym kostiumie, gubernatorze?";
"T_TUTORIAL_05_BANDIT_ATTACK_02" = "Od teraz będę od czasu do czasu odwiedzał twoją osadę. Ciekawe, czy podzielisz się nadmiarem towarów…";
"T_TUTORIAL_05_CARPENTER_SUCCESS_CONV_01" = "Świetna robota, wasza miłość. Teraz cieśla zajmie się wszystkimi uszkodzonymi budynkami, dopóki wystarczy mu surowców.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_DESC" = "Król przysłał do twojej osady specjalnego posła, który zbada sprawę rabunku w stołecznym skarbcu. Jesteś teraz głównym podejrzanym.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_TITLE" = "Wkrótce przybędą przedstawiciele króla.";
"T_TUTORIAL_05_GEOLOGIST_ASSIGN" = "Jeśli chcesz przydzielić geologa do kopalni, wybierz lupę.";
"T_TUTORIAL_05_HERB_GARDEN_CONV" = "Mój panie, mógłbym zrobić przebranie z gałęzi i chwastów, ale w tym celu muszę mieć przy gospodarstwie ogród ziołowy.";
"T_TUTORIAL_05_HERB_GARDEN_DESC" = "Zioła pozyskuje się z ogrodu ziołowego. Jest to zadanie dla rolnika, dlatego ogród ziołowy zaleca się zbudować zaraz przy gospodarstwie.";
"T_TUTORIAL_05_HERB_GARDEN_TITLE" = "Zbuduj ogród ziołowy.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_DESC" = "Jeśli chcesz stworzyć dla doradcy sensowne przebranie, musisz zdobyć wyprawioną skórę i trochę gałęzi, za pomocą których stworzysz kamuflaż. Przydałoby mu się też zwykłe odzienie pod spód.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_TITLE" = "Wytwórz przebranie.";
"T_TUTORIAL_05_KNIGHT_02_CONV_01" = "Gubernatorze! Chcę mieć lepszy widok na osadę i otaczające ją lasy na wypadek kolejnego ataku bandytów. Pospiesz się. To rozkaz!";
"T_TUTORIAL_05_KNIGHT_02_CONV_02" = "Wspaniale, gubernatorze. Teraz mogę przypatrywać się osadzie i okolicy. ";
"T_TUTORIAL_05_KNIGHT_02_CONV_03" = "Przypilnuj, by w wieżach nigdy nie brakowało strażników i zaopatrzenia z koszar. To zapewni skuteczną ochronę osady.";
"T_TUTORIAL_05_KNIGHT_02_CONV_04" = "Mój panie! W pobliżu osady zauważono kilku podejrzanych osobników. To mogą być bandyci!";
"T_TUTORIAL_05_KNIGHT_02_DESC" = "Rycerz chce mieć dobry widok na okolicę. Należy zbudować wieżę strażniczą. Dzięki temu osadę będzie chronić chociaż kilku strażników.";
"T_TUTORIAL_05_KNIGHT_03_CONV_01" = "Zostaliśmy zaatakowani, wasza miłość!";
"T_TUTORIAL_05_KNIGHT_03_CONV_02" = "Bandyci obrabowują nasze budynki, mój panie! Jesteśmy bezradni…";
"T_TUTORIAL_05_KNIGHT_03_DESC" = "Na osadę napadli bandyci. Musisz odeprzeć ich atak. Zbuduj więcej wież strażniczych i przydziel do nich więcej żołnierzy, by zwiększyć szansę na zwycięstwo. ";
"T_TUTORIAL_05_KNIGHT_03_TITLE" = "Odeprzyj atak napastników.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_01" = "Dzień dobry, gubernatorze. Król nakazał mi cię pojmać. Oskarżono cię o kradzież majątku jego królewskiej mości. Co masz na swoją obronę?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_02" = "Gubernator wcale nie był w to zamieszany, przysięgam. Wrobiono nas. To sprawka kogoś innego.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_03" = "Naprawdę sądzisz, że uwierzę w te bzdury? Pewien czcigodny szlachcic i brat królewskiej szwagierki ponoć widzieli, jak ty i twój doradca dopuszczacie się tego występku.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_04" = "Dowiedziemy swojej niewinności! Prawda, wasza miłość?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_05" = "Cisza! Nie chcę tego dłużej słuchać. Tymczasem założę w twojej osadzie obozowisko. Czy dysponujesz koszarami, w których mógłbym zorganizować centrum dowodzenia?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_01" = "Znakomicie, gubernatorze. Dzięki siedzibie w twojej osadzie moi ludzie będą mogli wyszkolić waszych strażników.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_02" = "Teraz skupmy się na sprawach niecierpiących zwłoki – zaginionym złocie z królewskiego skarbca i obronie osady.";
"T_TUTORIAL_05_MAINQUEST_DESC" = "Szlachcic powrócił i znowu żąda pieniędzy i towarów. Musisz rozwiązać tę kwestię, nim wymknie się spod kontroli!";
"T_TUTORIAL_05_MAINQUEST_OBJECTIVE_01" = "Dowiedz się, co robi szlachcic.";
"T_TUTORIAL_05_MAINQUEST_STARTED" = "To trwa już zbyt długo, wasza miłość. Jeśli nie zajmiemy się tym szlachcicem, sytuacja szybko się pogorszy!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_DESC" = "Rycerz wezwał posiłki, ale strażnicy miejscy muszą powstrzymać napastników aż do przybycia królewskich wojsk.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_STARTED" = "Gubernatorze, poprosiłem króla o wsparcie. Nie uzyskamy go jednak od razu. Tymczasem musimy za wszelką cenę bronić osady.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_01" = "Udało się, gubernatorze! Atak bandytów został zażegnany. Wróg się wycofuje…";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_02" = "Wasza miłość, strażnicy osady znaleźli szlachcica, który ukrywał się w pobliżu zamku. Chyba chce ci coś powiedzieć.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_03" = "Gubernatorze, dziękuję, że pokonałeś napastników. Nic nam już nie grozi, prawda?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_04" = "Gadaj, po co spotykałeś się z bandytami. I to już!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_05" = "W porządku… Kilka miesięcy temu popełniłem błąd.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_06" = "Podczas hazardowych gier w stolicy poznałem herszta bandytów. Nie wiedziałem, co to za jeden, dopóki nie przegrałem w kości małej fortuny.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_07" = "Krótko mówiąc… popadłem w ogromne długi. Zaczął mnie szantażować, bym wykradł złoto z królewskiego skarbca.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_08" = "Wtedy zaś oskarżyłeś o rabunek gubernatora?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_09" = "To było łatwe, lord szambelan to mój stary znajomy. W ten sposób gubernator trafił do tego zaścianka.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_10" = "Ani się waż mówić tak o naszej osadzie. Czyli to ty wrobiłeś naszego gubernatora. Wstyd!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_11" = "Z dnia na dzień bandyci domagali się coraz więcej. Koniec końców zażyczyli sobie uzbrojenia i pancerzy… które dostarczyłem im z pomocą waszego umiłowanego gubernatora.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_12" = "Trzeba położyć kres temu szaleństwu! Przede wszystkim musimy znaleźć główny obóz tych bandytów.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE" = "Obroń osadę.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE_02" = "Trzymajcie się";
"T_TUTORIAL_05_MAINQUEST_TITLE" = "Załatw problem ze szlachcicem.";
"T_TUTORIAL_05_MILITARY_EXPLANATIONS" = "Tylko straż miejska może położyć kres tym atakom!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01" = "Gubernatorze, mam propozycję nie do odrzucenia! Przyślij mi uzbrojenie i pancerze! Szybko!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01B" = "Ręka rękę myje, prawda? Szepnę o tobie dobre słowo królewskim żołnierzom. Co ty na to?";
"T_TUTORIAL_05_NEW_DEAL_CONV_02" = "Doskonale! A teraz przekaż mi towary. Muszę szybko dostarczyć je na miejsce!";
"T_TUTORIAL_05_NEW_DEAL_DESC" = "Szlachcic zaproponował nowy układ. Wstawi cię za tobą u przedstawiciela króla, jeśli dostarczysz mu uzbrojenie i pancerze.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_01" = "Dzień dobry, gubernatorze. Piękny dzień, nieprawdaż? Chcę ci przypomnieć o kolejnej płatności, dzięki której będę oczywiście milczał jak grób.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_02" = "Lepiej się pospiesz! Oddział żołnierzy już tu zmierza. Szukają złota, które zaginęło z królewskiego skarbca, gubernatorze! Życzę ci, żeby cię nie zastali.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_03" = "Przekaż mi pieniądze, gubernatorze. Wydam je bardzo mądrze! Nie ociągaj się – nie mam czasu. Przede mną ważne spotkanie…";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_04" = "Jak śmiesz mi odmawiać, gubernatorze?! Możesz spodziewać się konsekwencji… A teraz zejdź mi z oczu. Czeka mnie ważne spotkanie!";
"T_TUTORIAL_05_NOBLEMAN_MONEY_DESC" = "Szlachcic znowu żąda haraczu. Groził wezwaniem królewskich inspektorów, którzy szukają zaginionego złota. ";
"T_TUTORIAL_05_NOBLEMAN_MONEY_TITLE" = "Zapłać szlachcicowi.";
"T_TUTORIAL_05_REPAIR_TOWN_CONV_01" = "Teraz cieśla naprawi uszkodzone budynki, o ile wystarczy mu do tego surowców, wasza miłość.";
"T_TUTORIAL_05_REPAIR_TOWN_DESC" = "Powinniśmy czym prędzej naprawić chociaż najważniejsze budynki w mieście, mój panie.";
"T_TUTORIAL_05_REPAIR_TOWN_SUCCESS" = "Świetna robota, wasza miłość. Cieśla zameldował, że wszystkie ważne budynki zostały naprawione. ";
"T_TUTORIAL_05_REPAIR_TOWN_TITLE" = "Napraw najważniejsze budynki w osadzie.";
"T_TUTORIAL_05_START_2_CONV_01" = "Dzięki temu skupimy się na nadchodzących zadaniach.";
"T_TUTORIAL_05_START_2_CONV_02" = "Mój panie, zima się skończyła, ale z powodu trudnych warunków niektóre budynki w osadzie uległy zniszczeniu.";
"T_TUTORIAL_05_START_2_DESC" = "Wiele budynków uległo uszkodzeniu podczas srogiej zimy, wasza miłość. Cieśla mógłby systematycznie naprawiać zniszczone obiekty. ";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR" = "No dobrze, mój panie. Mam „strój” i pójdę za szlachcicem na to jego spotkanie. To chwilę potrwa. Proszę o cierpliwość.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_DESC" = "Dopóki przebrany doradca śledzi szlachcica, musisz czekać. W końcu wróci i poinformuje cię o swoich odkryciach.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_TITLE" = "Doradca zakradł się, by szpiegować szlachcica.";
"T_TUTORIAL_05_START_INVESTIGATION_FAILED" = "Nareszcie jestem z powrotem. Zauważono mnie i ledwie udało mi się uciec. To byli bandyci, mój panie. Ten szlachcic wszedł w konszachty z bandytami!";
"T_TUTORIAL_05_STOCKFULL_01" = "Magazyny są przepełnione, wasza miłość. Lepiej sprzedaj lub nawet zniszcz niektóre towary, by zrobić miejsce w magazynach.";
"T_TUTORIAL_05_STOCKFULL_02" = "Świetnie, gubernatorze. Teraz w magazynach znów zrobiło się miejsce. Wolna przestrzeń niezbędna jest do tego, by produkcja przebiegała gładko.";
"T_TUTORIAL_05_STOCKFULL_TITLE" = "Zrób miejsce w magazynach.";
"T_TUTORIAL_05_STOCKFULL_TOOLTIP" = "Brak miejsca w magazynach!";
"T_TUTORIAL_05_TANNERY_CONV_02" = "Wspaniale, wasza miłość. Garbarz będzie wyprawiał skórę, którą otrzyma od myśliwego.";
"T_TUTORIAL_05_TANNERY_DESC" = "Jeśli chcemy wytwarzać pancerze, będziemy potrzebować wyprawionej skóry z garbarni, mój panie.";
"T_TUTORIAL_05_TANNERY_TITLE" = "Zbuduj garbarnię i wytwarzaj wyprawioną skórę.";
"T_TUTORIAL_05_TOWN_UNDER_ATTACK" = "Mój panie, na osadę napadli bandyci! Musimy zabezpieczyć się przed tymi łotrami! Potrzebujemy straży.";
"T_TUTORIAL_05_TRIBUTE_TIMER_DESC" = "Zapłać daninę przed upływem czasu.";
"T_TUTORIAL_05_UPGRADE_HINT_01" = "Wolne miejsce w budynkach publicznych można zwiększać dzięki ulepszeniom.";
"T_TUTORIAL_05_UPGRADE_HINT_02" = "Ulepszenia budynków są bardzo potężne – na przykład umożliwiają przydzielenie większej liczby pracowników do budynku.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_01" = "Mój panie, moglibyśmy poszukać obozu bandytów w lasach na północy.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_02" = "Jeśli dostarczysz straży osady niezbędne surowce, wyruszymy w mgnieniu oka.";
"T_TUTORIAL_06_EXPEDITION_01_STARTED" = "Wrócimy dopiero za jakiś czas, mój panie. Życz nam powodzenia!";
"T_TUTORIAL_06_EXPEDITION_02_CONV_01" = "Czy chcesz posłać oddział zwiadowców do lasów na południu, mój panie? Może bandyci ukryli się właśnie w tamtej okolicy?";
"T_TUTORIAL_06_EXPEDITION_03_CONV_01" = "Może obóz bandytów leży gdzieś w lasach na zachodzie? Czy straż miejska ma zorganizować poszukiwania?";
"T_TUTORIAL_06_EXPEDITION_04_CONV_01" = "Nie szukaliśmy jeszcze obozu bandytów w lasach na wschodzie, mój panie. Wydaj rozkaz, a straż miejska natychmiast rozpocznie przygotowania.";
"T_TUTORIAL_06_EXPEDITION_DESC_01" = "Straż miejska może zacząć poszukiwania obozu bandytów w lesie. W tym celu będzie jednak potrzebować zapasów i sprzętu.";
"T_TUTORIAL_06_EXPEDITION_RDYTOSTRT" = "Wydaj nam rozkaz, a wyruszymy natychmiast, mój panie.";
"T_TUTORIAL_06_EXPEDITION_RUNNING_DESC" = "Dopóki wyprawa jest w toku, możemy jedynie czekać.";
"T_TUTORIAL_06_EXPEDITION_RUNNING_TITLE" = "Wyprawa jest obecnie w toku…";
"T_TUTORIAL_06_EXPEDITION_TITLE_01" = "Sfinansuj wyprawę do lasu.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_01" = "Ha! Dorwaliście mnie… Powinienem był zniszczyć waszą osadę i złupić wasz skarbiec do cna! Do kroćset… Mój podstęp wydał się tylko przez tego zdradliwego szlachcica!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_02" = "Ty łotrze! Wykorzystałeś moje uzależnienie od hazardu, by okraść króla. Ten koszmar nareszcie się skończył, a Jego Królewska Mość odzyska złoto.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_03" = "Twoja klęska to zasługa tego szlachetnego gubernatora. To piękny dzień dla nas, osady i całego królestwa.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_04" = "Patrzcie! Nareszcie przybyła królewska armia!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_05" = "Przejście! Przejście dla króla! Z drogi, król będzie tędy przechodził…";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_06" = "Dzień dobry, panowie. Jak widzę, zjawiliśmy się w samą porę, aby zobaczyć wasze zwycięstwo nad bandytami. ";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_07" = "Jesteś Grimlock Rudobrody, zgadza się? Najgroźniejszy bandyta w królestwie nareszcie został schwytany.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_08" = "Tak, to ja, wasza wysokość. Dopadł mnie ten gubernator.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_09" = "Istny z ciebie bohater, gubernatorze. Ponoć oskarżono cię o rabunek złota z mojego skarbca i pozbawiono cię tytułu lorda. Czy to prawda?";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_10" = "Ten człowiek niczym nie zawinił, wasza wysokość. To ja dopuściłem się grabieży. Rudobrody mnie szantażował. Tak bardzo mi przykro!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_11" = "Rozumiem. Wsadzić ich do lochu. Gubernator i ja musimy omówić przyszłość królestwa…";
"T_TUTORIAL_06_MAINQUEST_EXPEDITION_FAILED" = "Mój panie, wrócili nasi ludzie. Niestety nie udało im się znaleźć obozu bandytów.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_01" = "Panie, osadę trapi kilka poważnych problemów. Trzeba natychmiast się nimi zająć!";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_02" = "Po pierwsze, poziom szczęścia w osadzie jest bardzo niski. Dobrze byłoby zaspokoić pragnienia mieszkańców.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_03" = "Po drugie, mój panie, nasi żołnierze ze straży miejskiej nie dysponują niemal żadnym zaopatrzeniem ani sprzętem. Jeśli mają nas obronić, należałoby im je zapewnić.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_04" = "W pierwszej kolejności powinniśmy odszukać obóz bandytów, a następnie go zniszczyć, mój panie.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_01" = "Znajdź obóz bandytów.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_02" = "Zaopatrz oddziały.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_03" = "Na nowo uszczęśliw mieszkańców.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_DESC" = "Broń osady, aż odnajdziesz obóz bandytów. Dbaj o szczęście mieszkańców i zapewnij strażnikom zaopatrzenie.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_01" = "Mój panie, ataki powtarzają się już od kilku dni. Długo już chyba nie wytrzymamy.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_02" = "Jest dla nas tylko jedna nadzieja, gubernatorze. Musimy jak najszybciej odnaleźć kryjówkę bandytów. Gdy ją zniszczymy, ten koszmar wreszcie się skończy.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_03" = "Ty! Szlachcicu! Mów, gdzie dokładnie spotkałeś się z bandytami! Podaj nam położenie ich obozu – i to już!";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_STARTED_CONV_04" = "Nie wiem, uwierzcie mi. Zasłonili mi oczy i poprowadzili przez las. To na pewno gdzieś blisko.";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_SUCCESS" = "Mój panie! Nasi zwiadowcy namierzyli obóz bandytów!";
"T_TUTORIAL_06_MAINQUEST_SURVIVE_TITLE" = "Ukończ wszystkie zadania i pokonaj bandytów.";
"T_TUTORIAL_06_NEXT_QUEST_CONV_01" = "Moi ludzie są wyczerpani. Wielodniowa, nieustanna walka daje im się we znaki.";
"T_TUTORIAL_06_NEXT_QUEST_CONV_02" = "Brakuje nam podstawowego zaopatrzenia, mój panie. Tylko odpowiednie zasoby pozwolą nam skutecznie walczyć.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_01" = "Dobrze byłoby zgromadzić zapas zaopatrzenia dla dzielnych strażników, mój panie.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_02" = "Chodzi o uzbrojenie, pancerze, a także kiełbasę oraz podpiwek.";
"T_TUTORIAL_06_PROVISIONS_01_CONV_03" = "Dzięki podpiwkowi nasze oddziały są mężniejsze, a kiełbasa zaspokaja ich głód przed walką.";
"T_TUTORIAL_06_PROVISIONS_01_DESC" = "Żołnierze ze straży miejskiej walczą skuteczniej, gdy dysponują zaopatrzeniem. Uzbrojenie i pancerze zapewniają znaczną premię do ataku i obrony, natomiast podpiwek i kiełbasa wyraźnie zwiększają inicjatywę oraz nieco podnoszą umiejętności ataku i obrony.";
"T_TUTORIAL_06_PROVISIONS_01_TITLE" = "Zapewnij strażnikom miejskim zaopatrzenie";
"T_TUTORIAL_06_PROVISIONS_MONASTERY_CONV_01" = "Mój panie, dzięki przyklasztornemu browarowi będziemy mogli warzyć podpiwek, co przyczyni się między innymi do poprawy skuteczności naszych żołnierzy w boju.";
"T_TUTORIAL_06_PROVISIONS_MONASTERY_CONV_02" = "Na dodatek moglibyśmy też zaopatrzyć w podpiwek naszą gospodę. Dostępność trunków wpłynie korzystnie na zadowolenie mieszkańców, którzy tam zajrzą.";
"T_TUTORIAL_HINT_CHANGE_TAXES" = "Sprawdź sekcję podatków w menu gry, by zmienić stawkę podatku!";
"T_TUTORIAL_HINT_CHANGE_TAXES_BUTTON_HINT" = "Otwórz menu gry, a następnie zakładkę „Szczęście”. Tam znajduje się podkategoria o nazwie „Podatki”.";
"T_TUTORIAL_HINT_ERASE" = "Za pomocą trybu usuwania możesz zlikwidować niewielkie obiekty, które blokują twoje plany zabudowy.";
"T_TUTORIAL_HINT_ERASE_KEYBOARD" = "Naciśnij skrót klawiszowy {KEYBOARD_ERASE_MODE}, by włączyć lub wyłączyć tryb usuwania. Możesz także kliknąć symbol kuli wyburzeniowej na pasku narzędzi.";
"T_TUTORIAL_HINT_ERASE_TOUCH" = "Wybierz tryb usuwania i najedź kursorem na obiekty, które chcesz zlikwidować.";
"T_TUTORIAL_HINT_FASTFOWARD" = "Kiedy na coś czekasz, skorzystaj z szybkiego przewijania, by przyspieszyć upływ czasu w grze.";
"T_TUTORIAL_HINT_PRESTIGEBUILDING_01" = "Nie ma czasu do stracenia, mój panie. Wydaj pkt. prestiżu, aby natychmiast ukończyć budowę wieży strażackiej.";
"T_TUTORIAL_HINT_TAXES_01" = "Podatki w osadzie są generowane z domów. W określonych odstępach czasu domy przynoszą wpływy z podatków, które automatycznie trafiają do skarbca.";
"T_TUTORIAL_HINT_TOWNHOUSES_FAMILIES" = "Każdy dom zapewnia osadzie nowe rodziny i, w zależności od stawki podatku, regularnie przynosi dochód.";
"T_TUTORIAL_HINT_VISIT_STOCK_MENU" = "Sprawdź sekcję magazynu w menu gry.";
"T_TUTORIAL_NOMERCHANT" = "Gubernatorze, niestety osadę wkrótce nawiedzi śnieżyca. Dopóki się nie skończy, handlarze nie zdołają do nas dotrzeć, przybędą jednak, gdy tylko pogoda się poprawi.";
"T_TUTORIAL_NOMERCHANT_OLD" = "Mój panie, bardzo mi przykro, ale podróż drogami jest obecnie niebezpieczna. Dopóki pogoda się nie poprawi, do osady nie dotrze żaden kupiec.";
