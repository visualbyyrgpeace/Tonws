"T_GOOGLE_QUESTS_BLACKDEATH_DESC" = "Całe królestwo pustoszy zaraza. Najjaśniejszy król prosi cię o przejęcie inicjatywy w walce z tą nową falą strasznej choroby. Ulecz swoją populację!";
"T_GOOGLE_QUESTS_BLACKDEATH_NAME" = "Czarna śmierć";
"T_GOOGLE_QUESTS_BORDERCONFLICT_DESC" = "Niechaj dowie się o tym całe królestwo: najjaśniejszy król wypowiedział wojnę sąsiedniemu krajowi. Wszyscy zarządcy powinni ufortyfikować swoje miasta i zbudować wieże strażnicze.";
"T_GOOGLE_QUESTS_BORDERCONFLICT_NAME" = "Konflikt graniczny";
"T_GOOGLE_QUESTS_BREEDING_DESC" = "Jego Królewska Mość podpisał nowy edykt. Należy uzupełnić straty w pogłowiu zwierząt hodowlanych. Wiele sztuk padło z powodu nieznanej choroby nawiedzającej gospodarstwa w całym królestwie. Hoduj świnie, mój panie.";
"T_GOOGLE_QUESTS_BREEDING_NAME" = "Hodowla na dużą skalę";
"T_GOOGLE_QUESTS_CARPENTER_DESC" = "Król był rozczarowany ostatnią wizytą w osadach. Większość miejscowości była w niezadowalającym stanie. Nakazał więc wszystkim gubernatorom wprowadzić w życie nowy edykt rzemieślniczy. W każdej osadzie powinno powstać odpowiednio dużo stolarni, by budynki były w jak najlepszym stanie przed kolejną królewską wizytacją.";
"T_GOOGLE_QUESTS_CARPENTER_TITLE" = "Edykt rzemieślniczy";
"T_GOOGLE_QUESTS_CHURCH_DESC" = "Z rozkazu przywódcy diecezji! Nie możemy dłużej tolerować zaniedbywania wiary. Zarządcy tego kraju powinni wybudować więcej kościołów w swoich osadach!";
"T_GOOGLE_QUESTS_CHURCH_TITLE" = "Kościelna konwencja";
"T_GOOGLE_QUESTS_CLOTHES_DESC" = "Na zewnątrz robi się coraz zimniej, a nasi mieszkańcy nie mają odpowiedniej odzieży. Bądź tak miły i zarządź uszycie ubrań.";
"T_GOOGLE_QUESTS_CLOTHES_TITLE" = "Odzież dla ludu";
"T_GOOGLE_QUESTS_CONFLAGRATION_DESC" = "Od czterech miesięcy królestwo cierpi z powodu długiej suszy. Zadbaj o to, by pożary w osadzie zostały natychmiast ugaszone.Inaczej płomienie strawią wszystko.";
"T_GOOGLE_QUESTS_CONFLAGRATION_NAME" = "Pożoga";
"T_GOOGLE_QUESTS_CONSTRCUTION_DESC" = "Król nakazał powiększyć miasto. Zadeklaruj posłuszeństwo i natychmiast postaw nowe budynki!";
"T_GOOGLE_QUESTS_CONSTRCUTION_NAME" = "Projekt budowlany";
"T_GOOGLE_QUESTS_DEDICATION_DESC" = "Wybrano cię do wykonania kilku specjalnych misji dla najjaśniejszego króla. Ukończ kilka scenariuszy!";
"T_GOOGLE_QUESTS_DEDICATION_NAME" = "Oddanie królestwu";
"T_GOOGLE_QUESTS_FAIRGROUND_DESC" = "Król planuje ogólnokrajowe wydarzenie, by świętować sukces swojej kampanii przeciw bandytom. Zarządził budowę nowych jarmarków we wszystkich osadach w kraju. Należycie się przygotuj!";
"T_GOOGLE_QUESTS_FAIRGROUND_TITLE" = "Uroczystości";
"T_GOOGLE_QUESTS_FESTIVITY_DESC" = "Nasz władca zaplanował wielką uroczystość. Nakazał on zgromadzić wystarczającą ilość podpiwka dla gości.";
"T_GOOGLE_QUESTS_FESTIVITY_NAME" = "Zaopatrzenie uroczystości";
"T_GOOGLE_QUESTS_FIRETOWER_DESC" = "Lud martwi się o zagrożenia pożarowe w osadach. Wiele budynków już strawiły płomienie. Warto zarządzić budowę większej liczby wież strażackich.";
"T_GOOGLE_QUESTS_FIRETOWER_TITLE" = "Bezpieczeństwo przede wszystkim";
"T_GOOGLE_QUESTS_FLEET_DESC" = "Od początku epoki odkryć król desperacko próbuje zbudować flotę szybkich okrętów, by rozpocząć wielką ekspedycję. Musisz wyprodukować dużo drewnianych desek, by władca mógł zrealizować to zadanie.";
"T_GOOGLE_QUESTS_FLEET_NAME" = "Nowa flota";
"T_GOOGLE_QUESTS_GLORIFICATION_DESC" = "Konny posłaniec przywiózł nowy dekret. Nakazano ci przystroić miasto, by oddać cześć Jego Królewskiej Mości. Stwórz dekoracje!";
"T_GOOGLE_QUESTS_GLORIFICATION_NAME" = "Gloryfikacja króla";
"T_GOOGLE_QUESTS_GOLD_DESC" = "Odkąd sąsiednie królestwo mierzy się z inflacją i spadkiem wartości waluty, najjaśniejszy król nakazał wszystkim zarządcom zwiększyć produkcję sztabek złota. W ten sposób zwalczymy inflację i uniezależnimy się finansowo od sąsiadów. Wyprodukuj sztabki złota, zarządco!";
"T_GOOGLE_QUESTS_GOLD_TITLE" = "Rezerwy złota";
"T_GOOGLE_QUESTS_INFIRMARY_DESC" = "Lordowie i damy, królestwo jest w niebezpieczeństwie. Szerzy się zaraza, bez lecznic większość osad poniesie ogromne straty. Każda osada w królestwie powinna zbudować więcej lecznic, inaczej królestwo czeka zagłada!";
"T_GOOGLE_QUESTS_INFIRMARY_TITLE" = "Nagły medyczny przypadek";
"T_GOOGLE_QUESTS_IRON_DESC" = "Wieści z frontu! Nasi dzielni żołnierze wygrywają wojnę! Potrzebują jednak wsparcia od wszystkich osad w kraju. Najwspanialsze miecze powstają ze sztabek żelaza najlepszej jakości. Nasze huty muszą wyprodukować sztabki żelaza.";
"T_GOOGLE_QUESTS_IRON_TITLE" = "Prawdziwe żelazo";
"T_GOOGLE_QUESTS_JEWELS_DESC" = "Mój panie, szlachta skarży się na brak dóbr luksusowych. Czy możesz wyprodukować więcej biżuterii?";
"T_GOOGLE_QUESTS_JEWELS_TITLE" = "Lśnij jak diament";
"T_GOOGLE_QUESTS_JOUSTING_DESC" = "Król wydał następujący dekret: chce sprawdzić, kto jest najlepszym rycerzem w kraju. Wszyscy zarządcy mają rozpocząć budowę placów turniejowych w każdej osadzie w królestwie. Wkrótce rozpocznie się największy turniej w dziejach.";
"T_GOOGLE_QUESTS_JOUSTING_TITLE" = "Wielkie mistrzostwa";
"T_GOOGLE_QUESTS_JUICE_DESC" = "Jego Królewska Mość zaplanował bankiet dla gości z sąsiednich krajów. Wszystko prawie gotowe, brakuje tylko dużego zapasu soku winogronowego.";
"T_GOOGLE_QUESTS_JUICE_TITLE" = "Sok na bankiet";
"T_GOOGLE_QUESTS_LEATHER_DESC" = "Konny posłaniec właśnie przywiózł wieści o najnowszych modowych trendach w stolicy. Nowy królewski doradca modowy zamówił najlepsze skóry z całego kraju. Do stworzenia kolekcji skórzanych kurtek, które właśnie wynalazł, potrzebuje ogromnych ilości wyprawionych skór. ";
"T_GOOGLE_QUESTS_LEATHER_TITLE" = "Najnowszy trend";
"T_GOOGLE_QUESTS_MAINTENANCE_DESC" = "Podczas ostatniej wizyty w osadzie król naocznie przekonał się o jej okropnym stanie. Zarządził natychmiastową naprawę budynków na twoich ziemiach.";
"T_GOOGLE_QUESTS_MAINTENANCE_NAME" = "Obowiązek konserwacji";
"T_GOOGLE_QUESTS_MARKET_DESC" = "Odkąd król nakazał zwiększenie wymiany handlowej z sąsiednimi krajami, rzeczywista ilość wymienianych towarów jest bardzo mała. Należy to zmienić. Potrzebujemy większej liczby targowisk, by spełnić ten rozkaz!";
"T_GOOGLE_QUESTS_MARKET_TITLE" = "Misja handlowa";
"T_GOOGLE_QUESTS_MEAT_DESC" = "Obywatele głodują, mój panie. Musimy szybko wyprodukować żywność dla osady! Mięso powinno wystarczyć, by zapewnić mieszkańcom odpowiednią dietę. Wyślij myśliwych do lasu, panie. Potrzebujemy mięsa.";
"T_GOOGLE_QUESTS_MEAT_TITLE" = "Zapasy żywności";
"T_GOOGLE_QUESTS_NOTIFICATION" = "Odbierz nagrodę za zadanie!";
"T_GOOGLE_QUESTS_REINVOLVEMENT_DESC" = "Konny posłaniec przywiózł dworski dekret. Nadano ci nowe gubernatorskie stanowisko na kilka lat. Nie zawiedź króla.";
"T_GOOGLE_QUESTS_REINVOLVEMENT_NAME" = "Przedłużona umowa";
"T_GOOGLE_QUESTS_REPOPULATION_DESC" = "Po wielu miesiącach zarazy pustoszącej kraj pora na nowo zaludnić miasto. Król nakazał budowę dużych domów, ponieważ stare, przeżarte chorobą, nie nadają się do zamieszkania.";
"T_GOOGLE_QUESTS_REPOPULATION_NAME" = "Nowe budynki w mieście";
"T_GOOGLE_QUESTS_SAUSAGES_DESC" = "Kiełbasy!\n\nKrólewscy żołnierze kochają te wędliny. Dowództwo prosi o zwiększenie produkcji tych wyjątkowych wyrobów.\n";
"T_GOOGLE_QUESTS_SAUSAGES_TITLE" = "Zapasy dla oddziałów";
"T_GOOGLE_QUESTS_SUPPLIES_DESC" = "Król nakazał wszystkim hrabstwom zgromadzenie zapasów chleba przed srogimi mrozami, nim będzie za późno. Nadchodzi zima, mój panie…";
"T_GOOGLE_QUESTS_SUPPLIES_NAME" = "Wyprodukuj zapasy na zimę";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_DESC" = "Susza zniszczyła zapasy żywności sąsiednich krajów. Król obiecał wesprzeć je dostawami żywności. Twoją osadę wybrano do produkcji pszenicy dla naszego sąsiada.";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_NAME" = "Wesprzyj sąsiada";
"T_GOOGLE_QUESTS_TAXESLEVIED_DESC" = "By zwyciężyć w wojnie ze zorganizowanymi hordami bandytów, król nakazał zebrać wysokie podatki wśród obywateli.";
"T_GOOGLE_QUESTS_TAXESLEVIED_NAME" = "Pobór podatków";
"T_GOOGLE_QUESTS_TERRITORIAL_DESC" = "Z rozkazu króla, ze skutkiem natychmiastowym, wszyscy zarządcy mają oczyścić okoliczne lasy z obozów bandytów!";
"T_GOOGLE_QUESTS_TERRITORIAL_NAME" = "Kampania przeciw bandytom";
"T_GOOGLE_QUESTS_TOOLS_DESC" = "Wasza miłość, osada została powiększona, abyśmy mogli ukończyć nasze zadania. Na początek musimy zadbać o stabilną gospodarkę. Będziemy do tego potrzebować narzędzi.";
"T_GOOGLE_QUESTS_TOOLS_TITLE" = "Nowe narzędzia pracy";
"T_GOOGLE_QUESTS_TOWNGUARD_DESC" = "Król zarządził, że osady w jego królestwie nie powinny żyć w strachu przed bandytami. Poinstruował wszystkich zarządców, by odpowiednio zabezpieczyli swoje osady i tłumili najazdy bandytów w zarodku.";
"T_GOOGLE_QUESTS_TOWNGUARD_NAME" = "Straż miejska";
"T_GOOGLE_QUESTS_TRADEAGREEMENT_DESC" = "W życie weszła umowa handlowa między naszym królestwem i sąsiednimi państwami. Musisz zwiększyć dochody na targu, wymieniając nadmiar surowców.";
"T_GOOGLE_QUESTS_TRADEAGREEMENT_NAME" = "Ogólna umowa handlowa";
"T_GOOGLE_QUESTS_UNDERSIZEDARMY_DESC" = "Z rozkazu króla naszą osadę wyznaczono do roli gospodarza dla królewskich sił obronnych. Jako zarządca musisz zbudować odpowiednią liczbę koszar, by powołać armię na czas.";
"T_GOOGLE_QUESTS_UNDERSIZEDARMY_NAME" = "Niewielkie wojsko";
"T_GOOGLE_QUESTS_WAREFFORT_DESC" = "Z rozkazu króla wszyscy zarządcy mają wyprodukować pancerze potrzebne na wojnie. Wszyscy muszą mieć wkład w nasze wspólne zwycięstwo nad wrogami.";
"T_GOOGLE_QUESTS_WAREFFORT_NAME" = "Wysiłek wojenny";
"T_GOOGLE_QUESTS_WAREHOUSE_DESC" = "Nadworny wróżbita przepowiedział kilka nadchodzących wydarzeń: apokalipsę, inwazję demonów, zwyczajną wojnę i kilka pomniejszych, mniej istotnych katastrof. By każda osada mogła się przygotować, królewski doradca zalecił budowę większej liczby magazynów. Dzięki temu zmartwieni mieszkańcy będą mieli więcej miejsca na przechowywanie najważniejszych zapasów.";
"T_GOOGLE_QUESTS_WAREHOUSE_TITLE" = "Paniczne zakupy";
