"T_GAME_BUILDING_INFO_ARCHERYCONTEST" = "Strzelnica to miejsce, w którym najlepsi łucznicy z całego królestwa rywalizują w różnych turniejach. Mieszczanie uwielbiają się im przyglądać.";
"T_GAME_BUILDING_INFO_ARMORY" = "Zbrojownia jest miejscem, w którym powstaje wyposażenie dla wojska. Płatnerz wytwarza z żelaza i skóry znakomite pancerze, a także wykuwa miecze dla wojska.";
"T_GAME_BUILDING_INFO_BAKERY" = "Piekarnia wykorzystuje mąkę i drewno opałowe, aby wypiekać chleb, zapewniając osadzie żywność.";
"T_GAME_BUILDING_INFO_BANDITCAMP" = "Podejrzani rabusie pomieszkują w obozie bandytów. Jest on dobrze chroniony i może stanowić zagrożenie dla twojej osady.";
"T_GAME_BUILDING_INFO_BARRACKS" = "Koszary są miejscem szkolenia żołnierzy. Tragarze będą transportować wyposażenie wojskowe do wież strażniczych w zasięgu. Ekwipunek ten zwiększa zdolności bojowe żołnierzy.";
"T_GAME_BUILDING_INFO_BATHHOUSE" = "W publicznej łaźni mieszkańcy mogą zaspokajać potrzeby społeczne. Choć jest tam niewiele miejsca do mycia, stanowi popularne miejsce spotkań. ";
"T_GAME_BUILDING_INFO_BEERFEST" = "Podczas festynu piwowarskiego mieszkańcy osady mogą zaspokoić swoje potrzeby społeczne, napić się i świętować. Festyny odbywają się tutaj także zimą.";
"T_GAME_BUILDING_INFO_BUTCHER" = "Rzeźnia przerabia świnie na mięso i skórę, a w połączeniu z ziołami również na najlepsze kiełbasy.";
"T_GAME_BUILDING_INFO_CARPENTER" = "Cieśla może naprawiać uszkodzone budynki, wykorzystując do tego surowce.";
"T_GAME_BUILDING_INFO_CARPENTER_OLD" = "Cieśla może naprawiać uszkodzone budynki, wykorzystując do tego surowce.\n\nTen budynek umożliwia też naprawę wszystkich budynków naraz za niewielką ilość prestiżu.";
"T_GAME_BUILDING_INFO_CASTLE" = "Zamek jest główną budowlą twojej osady. Przechowuje się w nim towary, a do tego pozwala przydzielać tragarzy.";
"T_GAME_BUILDING_INFO_CASTLE_MILITARY" = "Zamek wojskowy ma małą pojemność magazynową, ale może zaopatrywać budynki obronne. Pozwala także na przydzielanie tragarzy, żołnierzy oraz kwatermistrzów.";
"T_GAME_BUILDING_INFO_CASTLE_UPGRADE" = "To ulepszenie zwiększa pojemność magazynu zamkowego.";
"T_GAME_BUILDING_INFO_CATHEDRAL" = "Katedra to bardzo duże miejsce kultu, które może pomieścić wielu mieszczan szukających oparcia w wierze. W środku jest więcej przestrzeni niż w kościele, za to koszt budowy i utrzymania jest wyższy.";
"T_GAME_BUILDING_INFO_CHURCH" = "W kościele mieszczanie mogą zaspokoić swoją potrzebę modlitwy i kontemplacji.";
"T_GAME_BUILDING_INFO_COALER" = "Zakład węglarza przetwarza drewno na węgiel drzewny.";
"T_GAME_BUILDING_INFO_CORNFIELD" = "Pole, na którym rolnicy mogą uprawiać pszenicę.";
"T_GAME_BUILDING_INFO_COUNTRYHOME" = "Duży dom zamieszkiwać może następująca liczba rodzin: {FAMILIES}. Jest bardzo droga, ale mieści więcej rodzin na ograniczonej przestrzeni.";
"T_GAME_BUILDING_INFO_COUNTRYHOME_OLD" = "W dużym domu może zamieszkiwać {FAMILIES} rodzin. Jest bardzo drogi, ale generuje większe wpływy z podatków niż 2 małe domy.";
"T_GAME_BUILDING_INFO_DECO" = "Obiekty dekoracyjne upiększają twoją osadę. Im wyższy będzie jej wskaźnik dekoracyjny, tym bardziej zadowoleni będą mieszczanie!";
"T_GAME_BUILDING_INFO_FAIRGROUND" = "Jarmark oferuje mieszkańcom wiele rozrywek. O każdej porze roku odbywają się tam różne uroczystości.";
"T_GAME_BUILDING_INFO_FARM" = "Gospodarstwo może produkować pszenicę, wełnę lub zioła dla twojej osady. Wymaga do tego pola pszenicy, pastwiska dla owiec lub ogrodu ziołowego. Zimą rolnik nie może uprawiać roli.";
"T_GAME_BUILDING_INFO_FARM_DEPRECATED" = "Gospodarstwo produkuje pszenicę i wełnę dla twojej osady. Wymaga pola pszenicy lub pastwiska dla owiec.";
"T_GAME_BUILDING_INFO_FIRESTATION" = "Z wieży strażackiej twoi mieszczanie wypatrują płonących budynków i próbują gasić pożary w osadzie. Strażak może czerpać wodę ze stawu przy swojej wieży.";
"T_GAME_BUILDING_INFO_FISHERHUT" = "Chata rybacka zaopatruje twoją wioskę w świeże ryby. ";
"T_GAME_BUILDING_INFO_GOLDSMITH" = "Pracownia złotnicza wykorzystuje złoto i narzędzia do wytwarzania doskonałej biżuterii.";
"T_GAME_BUILDING_INFO_GUARDPOST" = "Posterunek to mniejsza wersja wieży strażniczej i służy do obrony centrum osady przed bandytami. Budynek może jednak pomieścić niewielu żołnierzy i ma mały zasięg.";
"T_GAME_BUILDING_INFO_GUARDTOWER" = "Wieża strażnicza zapewnia doskonały widok żołnierzom. Budynek ten musi być zaopatrywany przez koszary, aby utrzymywać sprawność bojową żołnierzy.";
"T_GAME_BUILDING_INFO_HARBOR" = "Położony nad oceanem port pozwala osadzie na handel większą liczbą towarów i zapewnia jej możliwość wymiany towarów ze statkami, które dobijają do brzegu.";
"T_GAME_BUILDING_INFO_HERBSGARDEN" = "W ogrodzie ziołowym rolnik może uprawiać zioła. Mają one zastosowanie przy produkcji kiełbasy oraz w medycynie. Zioła nie rosną zimą.";
"T_GAME_BUILDING_INFO_HERBSGARDEN_DEPRECTAED" = "Ogród ziołowy to miejsce, w którym lekarz sadzi swoje zioła lecznicze. Zioła nie rosną zimą.";
"T_GAME_BUILDING_INFO_HERBSGARDEN_OLD" = "Lekarz lub rolnik mogą uprawiać zioła w ogrodzie ziołowym. Zioła nie rosną zimą.";
"T_GAME_BUILDING_INFO_HOPSFARM" = "Suszarnia chmielu pozwala uprawiać i suszyć chmiel, który jest następnie transportowany do browarów w osadzie.";
"T_GAME_BUILDING_INFO_HOPSFIELD" = "Na plantacjach chmielu pracownicy suszarni uprawiają chmiel dla przyklasztornych browarów, gdzie jest on wykorzystywany do produkcji podpiwka. Plantacje nie odrastają zimą.";
"T_GAME_BUILDING_INFO_HOPSFIELD_OLD" = "Plantacja chmielu zaopatruje klasztory w chmiel, z którego jest produkowany podpiwek. Plantacje nie odrastają zimą.";
"T_GAME_BUILDING_INFO_HOUSE_UPGRADE1" = "Ulepszenie 2. poziomu dla domów zwiększa wpływy z podatków i zmniejsza o połowę tempo niszczenia tych budynków. Zwiększona zostaje również premia poborcy podatków. Naprawa ulepszonego budynku wymaga jednak znacznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_HOUSE_UPGRADE2" = "Ulepszenie 3. poziomu dla domów zwiększa wpływy z podatków i zmniejsza o połowę tempo niszczenia tych budynków. Jeszcze bardziej zwiększona zostaje premia poborcy podatków. Naprawa ulepszonego budynku wymaga jednak drastycznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_HUNTER" = "Myśliwy chodzi do lasu, aby polować na zwierzęta. Do swojej chaty przynosi mięso, a skóry zabiera do garbarni.";
"T_GAME_BUILDING_INFO_HUNTER_DEPRECATED" = "Chata myśliwska jest miejscem, z którego wyrusza on na wyprawy do lasu. Myśliwy poluje na jelenie i dostarcza osadzie mięso.";
"T_GAME_BUILDING_INFO_INN" = "Zajazd to miejsce spotkań mieszkańców osady i podróżnych. Stanowi dodatkowe źródło dochodu, niezależne od domów i obywateli. Im piękniej przyozdobiona jest osada, tym wyższy dochód zapewnia zajazd.";
"T_GAME_BUILDING_INFO_JOUSTINGSITE" = "Mieszczanie odwiedzają plac turniejowy, aby nacieszyć się widokiem bohaterskich rycerzy walczących o honor.";
"T_GAME_BUILDING_INFO_JUICER" = "Wytwórnia soku produkuje najlepszy sok winogronowy w całym królestwie.";
"T_GAME_BUILDING_INFO_LUMBERJACK" = "W leśniczówce pracuje drwal, który ścina pobliskie drzewa i dostarcza drewno do twojej osady.";
"T_GAME_BUILDING_INFO_MARKETSQUARE" = "Targowisko zapewnia mieszczankom dostęp do biżuterii i ubrań z twoich sklepów. Umożliwia także handel z kupcem, gdy ten odwiedzi twoją osadę.";
"T_GAME_BUILDING_INFO_MEDICALCENTER" = "Mieszkańcy odwiedzają lecznicę, gdy źle się czują. Lekarz pomaga im, używając ziół.";
"T_GAME_BUILDING_INFO_MEDIUMHOME" = "Kamienica zapewni komfortowe warunki następującej liczbie rodzin: {FAMILIES}.";
"T_GAME_BUILDING_INFO_MINE" = "W zależności od lokalizacji kopalni może ona wydobywać kamienie, rudę żelaza lub nawet rudę złota.\nPo zbadaniu niezbędnej technologii geolog może odnawiać wyczerpane złoża.";
"T_GAME_BUILDING_INFO_MINE_DEPRECTAED" = "W zależności od lokalizacji kopalni może ona wydobywać kamienie, rudę żelaza lub nawet rudę złota.";
"T_GAME_BUILDING_INFO_MINT" = "Huta zaopatruje producentów w sztabki żelaza i złota. Sztabki są wytwarzane z odpowiednich rud i węgla drzewnego.";
"T_GAME_BUILDING_INFO_MONASTERY" = "Mnisi w klasztorze warzą pyszny podpiwek. Dokładna procedura nie jest znana, ale powszechnie wiadomo, że wśród składników znajdują się chmiel, pszenica i krystalicznie czysta woda źródlana.";
"T_GAME_BUILDING_INFO_MONASTERY_OLD" = "Mnisi w klasztorze zbierają chmiel i warzą pyszny podpiwek. Do zbiorów potrzebna jest plantacja chmielu. Dokładna procedura nie jest znana, ale powszechnie wiadomo, że wśród składników znajdują się chmiel, pszenica i krystalicznie czysta woda źródlana.";
"T_GAME_BUILDING_INFO_PIGFARM" = "Na fermie trzody chlewnej świniopas hoduje świnie domowe. Świnie są źródłem pożywienia i skóry.";
"T_GAME_BUILDING_INFO_PRODUCTION_UPGRADE1_DEPRECATED" = "Ulepszenie 2. poziomu zwiększa produktywność i przestrzeń magazynową budynku. Dodaje również kolejne miejsce pracy i zmniejsza o połowę tempo niszczenia budynku. Naprawa ulepszonego budynku wymaga jednak znacznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_PRODUCTION_UPGRADE2_DEPRECATED" = "Ulepszenie 3. poziomu jeszcze bardziej zwiększa produktywność i przestrzeń magazynową budynku. Dodaje również kolejne miejsce pracy i zmniejsza o połowę tempo niszczenia budynku. Naprawa ulepszonego budynku wymaga jednak drastycznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_PUBLIC_UPGRADE1_DEPRECATED" = "Ulepszenie 2. poziomu zwiększa przestrzeń magazynową budynku i zmniejsza o połowę tempo niszczenia budynku. Naprawa ulepszonego budynku wymaga jednak znacznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_PUBLIC_UPGRADE2_DEPRECATED" = "Ulepszenie 3. poziomu ponownie zwiększa przestrzeń magazynową budynku i zmniejsza o połowę tempo niszczenia budynku. Naprawa ulepszonego budynku wymaga jednak znacznie więcej surowców i złota.";
"T_GAME_BUILDING_INFO_ROAD" = "Droga gruntowa";
"T_GAME_BUILDING_INFO_ROAD_DIRT" = "Prosta droga gruntowa, która pozwala mieszczanom szybciej się poruszać. Możesz także zbudować drewniany most, umieszczając punkty nawigacyjne po przeciwnych stronach rzeki.";
"T_GAME_BUILDING_INFO_ROAD_STONE" = "Mieszczanie mogą poruszać się jeszcze szybciej po brukowanych drogach niż po drogach gruntowych. Możesz także zbudować kamienny most, umieszczając punkty nawigacyjne po przeciwnych stronach rzeki.";
"T_GAME_BUILDING_INFO_SAWMILL" = "W tartaku drewno przerabia się na deski. Tartak wymaga dużych zapasów drewna, więc lepiej zatrudnij kilku drwali, którzy je dostarczą.";
"T_GAME_BUILDING_INFO_SAWMILL_DUPLICATE_MORE_LANGUAGES" = "W tartaku drewno przerabia się na deski. Tartak wymaga dużych zapasów drewna, więc lepiej zatrudnij kilku drwali, którzy je dostarczą.";
"T_GAME_BUILDING_INFO_SAWMILL_OLD" = "Zasilany wodą tartak tnie kłody na deski.";
"T_GAME_BUILDING_INFO_SHEEPWALK" = "Owce z pastwiska generują wełnę. Musisz przydzielić rolnika do produkcji wełny w pobliskim gospodarstwie.";
"T_GAME_BUILDING_INFO_SMALLHOME_02" = "Średni dom zamieszkiwać może następująca liczba rodzin: {FAMILIES}. Średni dom jest nieco bardziej luksusowy niż mały dom i przynosi większe podatki.";
"T_GAME_BUILDING_INFO_SMALL_FIRESTATION" = "Stanowisko strażackie to mniejsza wersja wieży strażackiej. Jego zasięg i liczba miejsc dla robotników są bardzo małe.";
"T_GAME_BUILDING_INFO_SPECIAL_UPGRADE1_DEPRECATED" = "Ulepszenie specjalnego budynku do 2. poziomu odblokowuje nową funkcję w jego menu:\n\n– Skarbiec: „Zbierz wszystkie podatki”\n– Stolarnia: „Napraw wszystkie budynki”\n– Wieża strażacka: „Ugaś wszystkie pożary”\n– Lecznica: „Ulecz wszystkich mieszczan”\n– Kopalnia: „Natychmiast odnów wszystkie złoża”\n\nDo tego zmniejszone zostaje tempo niszczenia budynku. Naprawa ulepszonego budynku jest jednak o wiele droższa.";
"T_GAME_BUILDING_INFO_SPECIAL_UPGRADE2_DEPRECATED" = "Ulepszenie specjalnego budynku do 3. poziomu odblokowuje nową funkcję w jego menu:\n\n– Skarbiec: „Zbierz wszystkie podatki”\n– Stolarnia: „Napraw wszystkie budynki”\n– Wieża strażacka: „Ugaś wszystkie pożary”\n– Lecznica: „Ulecz wszystkich mieszczan”\n– Kopalnia: „Natychmiast odnów wszystkie złoża”\n\nDo tego zmniejszone zostaje tempo niszczenia budynku. Naprawa ulepszonego budynku jest jednak o wiele droższa.";
"T_GAME_BUILDING_INFO_STONEWALL" = "Kamienny mur";
