"T_MAINMENU_NEW_CONTENT" = "Nowa zawartość!";
"T_MAINQUEST_OBJECTIVE_COMPLETE_TASKS_KING" = "Ukończ zadanie od króla.";
"T_MAINQUEST_OBJECTIVE_WOODSHORTAGE" = "Rozwiąż problemy z drewnem.";
"T_MAIN_MENU_INFO" = "Informacje";
"T_MAIN_MENU_LOADGAME" = "Wczytaj grę";
