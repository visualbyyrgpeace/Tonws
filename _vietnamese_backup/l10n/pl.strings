"T_LEGACY_BEER_DESC" = "Mój panie, a nuż należałoby iść za ciosem i wprowadzić w osadzie kolejne ulepszenia? Można na przykład rozwinąć rolnictwo. Co powiesz na suszarnię chmielu? To nam pozwoli uprawiać i przetwarzać chmiel.";
"T_LEGACY_BEER_SUCCESS" = "Brawo, waszmości. Od teraz nasza osada na pewno będzie znana z pierwszorzędnego chmielu.";
"T_LEGACY_COUNTRY_NEED_DESC" = "Waszmości, otrzymaliśmy właśnie wiadomość z sąsiedniego kraju. Tamtejszych mieszkańców dotknęła klęska głodu i proszą nas, byśmy podzielili się żywnością. Czy prześlemy im niezbędne surowce?";
"T_LEGACY_COUNTRY_NEED_FAILED" = "Mój panie, to straszne. Otrzymaliśmy właśnie wieści z sąsiedniego kraju. Wycieńczeni głodem mieszkańcy wyszli na ulice. Nastąpił przewrót, zginęło wiele osób. Zamordowano tamtejszego króla… Państwo pogrążyło się w chaosie, a do nas zmierzają fale uchodźców. Powinniśmy byli im pomóc…";
"T_LEGACY_COUNTRY_NEED_ONLY_TIMER_TITLE" = "Czas na pomoc sąsiadom:";
"T_LEGACY_COUNTRY_NEED_SUCCESS_001" = "Mamy zapas niezbędnych produktów, wasza miłość. Wystarczy tylko dostarczyć je sąsiadom i udzielić im pomocy. Nie ma czasu do stracenia!";
"T_LEGACY_COUNTRY_NEED_SUCCESS_002" = "Sąsiedni kraj serdecznie nam podziękował, waszmości! Chyba uchroniliśmy jego mieszkańców przed widmem głodu. Kto wie, co by się zdarzyło, gdybyśmy nie zdobyli się na ten gest?";
"T_LEGACY_COUNTRY_NEED_TITLE" = "Pomóż sąsiedniemu krajowi.";
"T_LEGACY_DECO_DESC" = "A niech to, gubernatorze! Rozejrzyj się tylko! Widzisz to?\n\nTak, właśnie! A co z dekoracjami? Wszystko wygląda okropnie ponuro! Pospiesz się i ozdób osadę, zanim król dotrze na miejsce.";
"T_LEGACY_DECO_SUCCESS" = "To wygląda o wiele lepiej! Dobrze, że jestem na miejscu i mogę ci przypomnieć o takich oczywistościach.";
"T_LEGACY_FISHER_HUNTER_HUT_DESC" = "Waszmości! Tu jesteś! Mieszkańcom przydałoby się pożywienie inne niż chleb. Może zbudujemy chatę rybacką i myśliwską? Dzięki temu zapewnimy im bardziej zbilansowaną dietę.";
"T_LEGACY_FISHER_HUNTER_HUT_SUCCESS" = "Dzięki ci, mój panie, za twą dobroć. Możemy teraz jeść różne produkty i urozmaicić naszą dietę. Co za tym idzie, mieszkańcy staną się znacznie zdrowsi.";
"T_LEGACY_FISHER_HUNTER_HUT_TITLE" = "Zbuduj chatę rybacką i myśliwską.";
"T_LEGACY_HOUSE_DESC" = "Ze względu na zadanie, które nam zlecono, mądrze będzie zbudować dodatkowy dom.";
"T_LEGACY_HOUSE_SUCCESS" = "Znacznie lepiej! Nowy dom stanie się również dodatkowym źródłem dochodów.";
"T_LEGACY_INTRODUCTION_001_DESC" = "Gubernatorze, witamy w naszej osadzie. Teraz to tylko niewielka mieścina, lecz dzięki tobie na pewno będzie rozkwitać.";
"T_LEGACY_INTRODUCTION_002_DESC" = "A co do rozkwitu, mam dla ciebie bardzo ważne zadanie. Jak widzisz, nie jestem już młody i choć może przeżyję jeszcze niejeden rok, pora pogodzić się z tym, że moje dni są policzone.";
"T_LEGACY_INTRODUCTION_003_DESC" = "Chciałbym, by po moich rządach pozostał ślad, który zainspiruje przyszłe pokolenia. Chodzi mi po głowie kilka pomysłów, ale tylko ty możesz pomóc mi je urzeczywistnić.";
"T_LEGACY_INTRODUCTION_004_DESC" = "Przekażę ci listy, w którym zawarłem wszystkie moje najważniejsze wspomnienia. Każdy z nich będzie zawierał jakieś zadanie dla ciebie. Nie zawiedź mnie. Jakiś czas po tym, gdy otrzymasz ostatni list, odwiedzę twoją osadę.";
"T_LEGACY_LETTER_001_DESC" = "Gdy król bliżej poznał swój lud, mógł lepiej mu pomóc. Chce, by w osadzie wzniesiono gospodę, w której przekazywano by historie i legendy z innych krain.";
"T_LEGACY_LETTER_001_DESCRIPTION_001_DESC" = "Nadszedł pierwszy list, jakże ciekawy, waszmości! Gdy nasz kochany król był jeszcze młodzikiem, ojciec zmusił go, by żył jak prości ludzie. Dzięki temu miał pojąć obowiązki i trudy każdego mieszczanina.";
"T_LEGACY_LETTER_001_DESCRIPTION_002_DESC" = "Tak więc co tydzień uczył się o różnych zajęciach swych poddanych. Jednego tygodnia pracował jako drwal, by następnego zostać rybakiem lub szynkarzem. Po wszystkim potrafił znacznie lepiej oceniać potrzeby swego ludu. Imponujące, mój panie!";
"T_LEGACY_LETTER_001_DESCRIPTION_003_DESC" = "Zawód szynkarza był dla niego szczególnym wyzwaniem. Z początku sądził, że polega tylko na wydawaniu przyjęć i rozlewaniu trunków, toteż był zadziwiony, gdy odkrył inną stronę tej profesji.";
"T_LEGACY_LETTER_001_DESCRIPTION_004_DESC" = "W gospodzie odbywały się nieformalne spotkania. Dyskutowano o filozofii, a podróżni z obcych krain opowiadali historie, wzbudzając podziw i skłaniając do refleksji.";
"T_LEGACY_LETTER_001_SUCCESS" = "Cudownie, waszmości! Mieszkańcy są zachwyceni, a nowy przybytek tętni życiem i zachęca do odwiedzin. Długie zimowe wieczory staną się znacznie przyjemniejsze.";
"T_LEGACY_LETTER_002_DESC" = "Mówi się, że wytrwała praca potrafi przynieść wielkie bogactwo. Chcąc uhonorować swoich przodków, król nakazał nam budowę winnicy na naszym terenie. Masz już pomysł, gdzie mogłaby powstać?";
"T_LEGACY_LETTER_002_DESCRIPTION_001_DESC" = "Otrzymaliśmy właśnie drugi list. Król opisuje w nim swoje dzieciństwo w winnicach na południu. Latem często tam wyjeżdżał, by spędzać czas ze swą babką. ";
"T_LEGACY_LETTER_002_DESCRIPTION_002_DESC" = "Babka opowiadała mu różne baśnie, a największe wrażenie wywarła na nim ta o rolniku i jego synach. Dzięki niej poznał znaczenie ciężkiej pracy. ";
"T_LEGACY_LETTER_002_SUCCESS" = "Król jest bardzo dumny z tego, że w okolicy powstały winnice. Nasi rolnicy dobrze się nimi zajmą.";
"T_LEGACY_LETTER_003_DESC" = "By nauczyć lud tej umiejętności, król nakazał nam budowę magazynu. W ten sposób zdołamy podzielić się z przyjaciółmi w biedzie tym, czego będziemy mieć pod dostatkiem.";
"T_LEGACY_LETTER_003_DESCRIPTION_001_DESC" = "Przyszedł właśnie kolejny list. Król opisuje w nim głód, który dotknął królestwo, gdy miał ledwie dziesięć lat. Klęska nie oszczędziła nikogo. ";
"T_LEGACY_LETTER_003_DESCRIPTION_002_DESC" = "Królewski ród postanowił wziąć sprawy we własne ręce i posłał do sąsiednich krajów dyplomatów, którzy mieli prosić o wsparcie. ";
"T_LEGACY_LETTER_003_DESCRIPTION_003_DESC" = "Nikt nie chciał poratować króla, większości sąsiednich krajów zależało tylko na własnym przetrwaniu. Król jednak nie popadł w rozpacz. Koniec końców znalazł sojusznika skorego do pomocy. Owe królestwo zgromadziło duże zapasy żywności i hojnie obdarowało nią pozostałe państwa.";
"T_LEGACY_LETTER_003_DESCRIPTION_004_DESC" = "Morał tej historii jest taki, że pomóc może nawet ktoś, kto znaczy mniej. To ważne dla króla, by jego poddani byli chętni do ratowania bliźnich w potrzebie. W związku z tym należy gromadzić towary w czasach dobrobytu, by w chudych latach mieć się czym dzielić.";
"T_LEGACY_LETTER_003_SUCCESS" = "Nowy magazyn wygląda doskonale! Teraz możemy gromadzić duże zapasy wszystkich niezbędnych towarów na wypadek nieoczekiwanych okoliczności.";
"T_LEGACY_LETTER_004_DESC" = "Naszym zadaniem jest wznieść w naszej osadzie pomnik króla, by uhonorować jego życzenie.";
"T_LEGACY_LETTER_004_DESCRIPTION_001_DESC" = "Waszmości, otrzymaliśmy list. Nadawcą jest nasz król. Podczas jego koronacji odbyła się wielka feta. W pałacu zebrali się gubernatorzy miast z całego królestwa.";
"T_LEGACY_LETTER_004_DESCRIPTION_002_DESC" = "Jednak on marzył, by być jednocześnie w każdym mieście i osadzie, żeby wszyscy poczuli się traktowani równo. Rzecz jasna, jest to niemożliwe. Gdyby jednak wszędzie wzniesiono jego pomnik, jego życzeniu stałoby się zadość.";
"T_LEGACY_LETTER_004_SUCCESS" = "Coś wspaniałego! Król będzie zachwycony. To zaiste przepiękna statua na jego cześć!";
"T_LEGACY_LETTER_004_TITLE" = "Wznieś pomnik króla.";
"T_LEGACY_LETTER_005_BOOK_HERE" = "Mój panie, księga została ukończona. Nasz umiłowany król będzie wniebowzięty.";
"T_LEGACY_LETTER_005_DESC" = "W tym celu musimy pozyskać zwierzęce skóry i przerobić je na pergamin, po którym będą mogli pisać mnisi. Zacznijmy czym prędzej!";
"T_LEGACY_LETTER_005_DESCRIPTION_001_DESC" = "Nadszedł właśnie ostatni list, waszmości. Król pisze o najwspanialszych osobistościach tego świata, którzy spisali swe wspomnienia w księgach znanych we wszystkich krajach. ";
"T_LEGACY_LETTER_005_DESCRIPTION_002_DESC" = "Król życzy sobie, by i jego wspomnienia zostały spisane. Produkcja ksiąg to rzecz bardzo trudna, ale moim zdaniem uszczęśliwi to Jego Królewską Mość.";
"T_LEGACY_LETTER_005_SUCCESS" = "Można zacząć spisywać księgę! Mnisi zadbają o to, by była gotowa na wizytę króla. To wspaniała perspektywa! Ten wolumin prawdopodobnie zapewni nam sławę na całym świecie!";
"T_LEGACY_LETTER_005_TITLE" = "Sporządź księgę ze wspomnieniami króla.";
"T_LEGACY_LETTER_006_DESCRIPTION_001_DESC" = "Waszmości! Król zaraz tu będzie! Mam nadzieję, że niczego nie skopaliśmy i Jego Królewska Mość doceni nasze wysiłki.";
"T_LEGACY_LETTER_006_DESCRIPTION_002_DESC" = "Racz przyjąć pozdrowienia, gubernatorze. Widzę, że w trakcie mojej nieobecności twoja osada rozkwitła. Och! Jakiż piękny pomnik! I winnice! Przypominają te u mojej babki!";
"T_LEGACY_LETTER_006_SUCCESS" = "Udało ci się uszanować moje życzenia ze wszystkich listów, zwłaszcza to dotyczące upragnionej przeze mnie księgi. Wygląda idealnie! Teraz nareszcie mogę cieszyć się jesienią życia, wiedząc, że moja mądrość nie przepadnie.";
"T_LEGACY_MAINQUEST_DESC" = "Liczę, że dzięki tobie moja spuścizna zapisze się w pamięci wielu osób, a każde wspomnienie stanie się lekcją dla moich naśladowców.";
"T_LEGACY_MAINQUEST_SUCCESS" = "Dziękuję, gubernatorze, za ogromny trud. Udało ci się dokładnie wypełnić każdą moją prośbę. Jestem z ciebie dumny. Całe królestwo ma u ciebie dług wdzięczności.";
"T_LEGACY_MAINQUEST_TITLE" = "Pomóż królowi w tym zadaniu.";
"T_LEGACY_MINE_DESC" = "Mój panie, wkrótce skończą nam się surowce. Większość z nich wykorzystaliśmy, by wznieść nowe budynki. Czy nie należałoby postawić kopalni?";
"T_LEGACY_MINE_SUCCESS" = "Gratulacje, gubernatorze. Mamy teraz odpowiedni zapas surowców, aby z powodzeniem ukończyć pozostałe budowy w osadzie.";
"T_LEGACY_SECURITY_DESC" = "Dzień dobry, waszmości. Jestem posłańcem króla. Nakazano mi zadbać o to, by osada była gotowa na jego wizytę.\n\nA co to ma być? Wasza osada nie została odpowiednio zabezpieczona! Natychmiast zbuduj wieżę strażacką! Wyobrażasz sobie, co by się stało w przypadku pożaru?!";
"T_LEGACY_SECURITY_SUCCESS" = "Znacznie lepiej! Należy zawsze dmuchać na zimne. Słusznie zrobiliście, że mnie posłuchaliście.";
"T_LEVELENDSCENE_BUTTON_NEXT" = "Następny scenariusz";
"T_LEVELENDSCENE_COMPLETE_DESC" = "Gratulacje! Udało ci się wykonać wszystkie zadania i ukończyć scenariusz!";
"T_LEVELENDSCENE_COMPLETE_TITLE" = "Ukończono scenariusz!";
"T_LEVELENDSCENE_FAILED_DESC" = "Nie udało się ci się wykonać głównego zadania i w efekcie ukończyć scenariusza…";
"T_LEVELENDSCENE_FAILED_TITLE" = "Nie udało się ukończyć scenariusza!";
"T_LEVELSELECTION_ENABLE_BANDITS_QUESTION" = "Umożliwić ataki bandytów na tej mapie?";
"T_LEVELSELECTION_PROPERTIES_BANDITS_ENABLED" = "Aktywni bandyci";
"T_LEVELSELECTION_PROPERTIES_DIFFICULTY" = "Poziom trudności";
"T_LEVELSELECTION_PROPERTIES_MAPSIZE" = "Rozmiar mapy";
"T_LEVELSELECTION_PROPERTIES_MILITARY_ENABLED" = "Mapa bitewna";
"T_LEVELSELECTION_SETTINGS" = "Ustawienia";
"T_LEVELSELECTION_START_GAME" = "Rozpocznij grę";
"T_LOADINGTIP_001" = "Rolnicy nie mogą pracować, póki uprawy nie odrosną. Jeśli wydzielisz kilka mniejszych pól, rolnicy będą mogli korzystać z nich na zmianę i unikniesz przestojów.";
"T_LOADINGTIP_002" = "Przydziel odpowiednią liczbę mieszczan do pracy tragarzy w magazynach, by uniknąć opóźnień w transporcie.";
"T_LOADINGTIP_003" = "Gospoda działa sprawniej, jeśli jest w niej zapas soku winogronowego z fabryki soku bądź podpiwka z klasztoru.";
"T_LOADINGTIP_004" = "Budynki publiczne, takie jak kościół, mogą obsłużyć ograniczoną liczbę mieszczan.";
"T_LOADINGTIP_005" = "Niektóre dekoracje bardziej niż inne zwiększają poziom szczęścia. Większa populacja wymaga większej liczby dekoracji, by zachować ten sam poziom szczęścia.";
"T_LOADINGTIP_006" = "Pilnuj poziomu szczęścia mieszczan. Skorzystaj z menu statystyk, by poznać obecne potrzeby i pragnienia mieszkańców. ";
"T_LOADINGTIP_007" = "Im lepiej spełniasz potrzeby i pragnienia mieszczan, tym wyższe podatki możesz na nich nałożyć, zanim zaczną strajkować.";
"T_LOADINGTIP_008" = "Kiedy w osadzie zjawia się kupiec, możesz kupić niezbędne surowce lub wymienić ich nadmiar na pieniądze.";
"T_LOADINGTIP_009" = "Gospodarstwo może produkować pszenicę, wełnę lub zioła. Do uprawy pszenicy potrzebujesz pola. Owce potrzebują pastwiska, a zioła – ogrodu ziołowego. Umieść je jak najbliżej gospodarstwa.";
"T_LOADINGTIP_010" = "Buduj domy jak najwcześniej i najszybciej, by mieć do dyspozycji więcej mieszczan mogących pracować w budynkach produkcyjnych.";
"T_LOADINGTIP_011" = "Mała osada bez problemu utrzyma się dzięki rybakom lub myśliwym, ale w większych osadach lepiej sprawdzą się piekarnia lub rzeźnia.";
"T_LOADINGTIP_012" = "Zawsze pilnuj produkcji drewna. Wiele budynków wymaga drewna jako surowca do produkcji.";
"T_LOADINGTIP_013" = "Niektóre budynki, na przykład kopalnia czy gospodarstwo, produkują więcej niż jeden surowiec.";
"T_LOADINGTIP_014" = "Spróbuj rozgryźć stosunek nakładów do wyników w swoim łańcuchu produkcyjnym. Dzięki temu twoje budynki produkcyjne będą pracować z pełną wydajnością. ";
"T_LOADINGTIP_015" = "W trybie gry w otwartym świecie możesz zdobywać punkty prestiżu, wykonując opcjonalne zadania z daninami.";
"T_LOADINGTIP_016" = "Scenariusze zawierają zestaw zadań, które należy wykonać, by ukończyć dany scenariusz.";
"T_LOADINGTIP_017" = "Po ukończeniu scenariusza możesz kontynuować rozgrywkę.";
"T_LOADINGTIP_018" = "Zbuduj skarbiec! Poborca krąży po osadzie i zwiększa dochód z podatków w każdym domu, który odwiedzi.";
"T_LOADINGTIP_019" = "Stolarnia to bardzo użyteczny budynek. Cieśla krąży po osadzie i naprawia niszczejące budynki, używając do tego surowców i monet.";
"T_LOADINGTIP_020" = "Stan budynku jest bardzo ważny. Zrujnowane domy zmniejszają poziom szczęścia mieszczan, a budynki produkcyjne w kiepskim stanie są mniej wydajne. W niszczejących budynkach występuje też większe ryzyko pożaru.";
"T_LOADINGTIP_021" = "Mieszczanie mają własny harmonogram dnia. Gdy mają przerwę w pracy, wykorzystują czas wolny na posiłek w domu lub spełnianie swoich pragnień.";
"T_LOADINGTIP_022" = "Po zburzeniu budynku odzyskasz połowę poniesionych kosztów budowy, ale mieszczanie muszą odzyskać surowce z ruin. Jeśli zbudujesz nowy budynek w tym samym miejscu przed odzyskaniem surowców, utracisz je.";
"T_LOADINGTIP_023" = "Kopalnie można budować jedynie na kamienistych zboczach. Kopalnie umieszczone na złożach rudy wydobywają nie tylko kamienie, ale i żelazo lub złoto.";
"T_LOADINGTIP_024" = "Drogi przyspieszają transport towarów i surowców. Mieszczanie zwykle wolą korzystać z dróg. Transport po drogach brukowanych odbywa się szybciej niż po drogach gruntowych.";
"T_LOADINGTIP_025" = "Jeśli podatki są zbyt wysokie, mieszczanie będą niezadowoleni i mogą nawet zacząć strajkować. Jednak jeśli spełnisz niektóre z ich pragnień, będą skłonni zapłacić wyższe podatki.";
"T_LOADINGTIP_026" = "Mieszczanki zaopatrują domy w pożywienie i wodę. Ponadto odwiedzają targowisko, by kupić biżuterię i odzież, jeśli są tam dostępne. Natomiast mieszczanie pracują w budynkach produkcyjnych.";
"T_LOADINGTIP_027" = "Jeśli składy w twoich budynkach często się zapełniają, musisz zbudować więcej magazynów i przydzielić dodatkowych tragarzy.";
"T_LOADINGTIP_028" = "Ciężko pracujący mieszczanie w końcu się męczą i potrzebują przerwy. Kiedy odpoczną, wrócą do pracy.";
"T_LOADINGTIP_029" = "Pełen cykl roczny trwa 60 minut. Nie na wszystkich mapach pory roku się zmieniają, a na niektórych bywają dłuższe.";
"T_LOADINGTIP_030" = "W zimie pola leżą odłogiem! Przygotuj się na nadejście chłodów, gromadząc jak najwięcej pszenicy, ziół, chmielu i soku winogronowego. ";
"T_LOADINGTIP_031" = "Polowania są dobrą metodą pozyskiwania pożywienia zimą. Myśliwy dostarczy osadzie mięsa i skór, o ile w okolicy jest dość jeleni lub królików. ";
"T_LOADINGTIP_032" = "Niektóre zadania zakończą się niepowodzeniem, jeśli nie ukończysz ich w określonym czasie.\nNiepowodzenie zwykle oznacza utratę nagrody za zadanie, ale czasami może doprowadzić do porażki danego scenariusza.";
"T_LOADINGTIP_033" = "Po ukończeniu scenariusza możesz kontynuować rozgrywkę. Gra przejdzie wtedy w tryb otwartego świata.";
"T_LOADINGTIP_034" = "Zbyt wielu myśliwych może spowodować przetrzebienie zwierzęcej populacji.\nTempo pojawiania się nowych jeleni i królików w okolicy zależy od wielkości terenów leśnych na mapie.";
"T_LOADINGTIP_035" = "Wykonanie niektórych zadań jest ograniczone czasowo. Czas pozostały do wykonania zadania wyświetla się jako wiadomość ostrzegawcza w lewym górnym rogu ekranu.";
"T_LOADINGTIP_036" = "Wyłącz nadproduktywne budynki, by zapobiec przepełnieniu magazynów lub zniszcz nadmiar surowców w menu magazynu.";
"T_LOADINGTIP_037" = "Możesz podnieść swój poziom, wykonując zadania i ulepszając osadę. Wyższe poziomy odblokowują lepsze nagrody!";
"T_LOADINGTIP_038" = "Lekarz może uleczyć chorych mieszczan przy pomocy ziół z ogrodu ziołowego.";
"T_LOADINGTIP_039" = "PD są przyznawane za wznoszenie budynków, handel na rynku, wysoki poziom szczęścia w osadzie, wykonywanie zadań i osiąganie większej populacji.";
"T_LOADINGTIP_040" = "Ulepszenia budynków są bardzo potężne. Mogą na przykład umożliwić ci przydzielenie większej liczby pracowników do budynku lub zwiększenie jego przestrzeni magazynowej!";
"T_LOADINGTIP_041" = "Jeśli złoże surowca w kopalni się wyczerpie, masz kilka możliwości. Możesz poszukać nowego złoża i zbudować na nim kopalnię lub przydzielić geologa do kopalni, w której złoże się wyczerpało, by znalazł nowe złoża.";
"T_LOADINGTIP_042" = "Podnosząc poziom osady, odblokowujesz potężne badania, na przykład nad ulepszeniami budynków, podniesieniem podatków lub lepszymi nagrodami za zadania!";
"T_LOADINGTIP_043" = "Ulepszenia budynków mają też kilka wad:\nDodatkowi pracownicy zwiększają zużycie surowców, a koszty naprawy budynku wzrastają wraz z każdym ulepszeniem!";
"T_LOADINGTIP_044" = "Ulepszenia budynków zostaną odblokowane po osiągnięciu konkretnych poziomów osady. Budynki możesz ulepszać w menu budowy za koszt punktów prestiżu.";
"T_LOADINGTIP_045" = "Zbadanie geologa jest bardzo przydatne! Gdy przydzielisz geologa do kopalni, powoli odnowi złoża rudy.";
"T_LOADINGTIP_046" = "Dodatkowe opcje badawcze zostaną odblokowane po osiągnięciu nowego poziomu osady. Po zakończeniu badań ich premie są dostępne na stałe we wszystkich twoich osadach! ";
"T_LOADINGTIP_047" = "Gdy osada osiągnie odpowiedni rozmiar, może w niej wybuchnąć zaraza! Potrzebujesz lecznicy i ogrodu ziołowego, by wyleczyć mieszczan.";
"T_LOADINGTIP_048" = "Kiedy w osadzie dojdzie do pożaru lub wybuchu zarazy, natychmiast zbuduj lecznicę lub wieżę strażacką. Lekarz wyleczy chorych mieszczan, a strażak ugasi płonące budynki.";
"T_LOADINGTIP_049" = "Ulepsz budynek, by zwiększyć jego wydajność. Menu ulepszeń znajdziesz w menu kontekstowym budynku.";
"T_LOADINGTIP_050" = "Dbaj o budynki! Jeśli nie będą regularnie naprawiane, zaczną się tlić i w końcu spłoną.";
"T_LOADINGTIP_051" = "Mieszczanie mogą opuścić osadę, jeśli pustoszy ją zaraza lub pożar. Wrócą, gdy niebezpieczeństwo minie, o ile posiadasz dostatecznie dużo pustych domów.";
"T_LOADINGTIP_052" = "Koszary zaopatrują wyłącznie te wieże strażnicze, które znajdują się w ich strefie wpływów.";
"T_LOADINGTIP_053" = "Kiedy twoi żołnierze przegrają walkę, wrócą do osady, by wylizać się z ran.";
"T_LOADINGTIP_054" = "Menu kontekstowe budynku zawiera wiele przydatnych informacji. Wystarczy wybrać budynek na mapie.";
"T_LOADINGTIP_055" = "Jeśli budynek zaatakują bandyci, mogą ukraść surowce, podłożyć ogień lub zniszczyć budynek.";
"T_LOADINGTIP_056" = "Najazd bandytów na budynek może zostać przerwany przez twoich żołnierzy, ale mają na to ograniczony czas.";
"T_LOADINGTIP_057" = "Zwierzęce skóry potrzebne w garbarni są produkowane w chacie myśliwskiej lub w rzeźni.";
"T_LOADINGTIP_058" = "Badania wojskowe przynoszą duże korzyści w walce i ułatwiają ochronę osady.";
"T_LOADINGTIP_059" = "Pokryj jak największą część osady wieżami strażniczymi i strażackimi.";
"T_LOADINGTIP_060" = "Tragarze pracujący w koszarach roznoszą żołnierskie zapasy z magazynu między wieżami strażniczymi w swoim zasięgu.";
"T_LOADINGTIP_061" = "W menu sprawdzisz wpływy oddziałujące obecnie na miasto. Mogą być tymczasowe lub stale aktywne na mapie. Są to na przykład: aktywni bandyci, długa zima lub mniejsze wpływy z podatków.";
"T_LOADINGTIP_062" = "Dostarczone żołnierzom wyposażenie i pożywienie ma wpływ na ich ofensywne i defensywne statystyki. Żołnierze wyposażeni w miecze mają lepsze statystyki ataku.";
"T_LOADINGTIP_063" = "Dostarczaj żołnierzom żywność i napoje, by podnieść ich ofensywne i defensywne statystyki.\nDobrze zaopatrzeni żołnierze to lepiej walczący żołnierze!";
"T_LOADINGTIP_064" = "Bitwa składa się z kilku faz: losowanie decyduje, która ze stron rozpoczyna w fazie inicjatywy. Potem obie strony atakują i bronią się na zmianę. ";
"T_LOADINGTIP_065" = "Użyj trybu „idź za mieszczaninem” w menu kontekstowym budynku, by zobaczyć, co robią jego mieszkańcy i pracownicy w danej chwili.";
"T_LOADINGTIP_066" = "Ataki bandytów mogą nadejść spoza mapy lub z obozu bandytów ulokowanego na mapie. Obóz bandytów może zostać ulepszony – będzie wtedy lepiej broniony.";
"T_LOADINGTIP_067" = "Koszary, wieże strażnicze i wieże strażackie posiadają strefę wpływów, czyli zasięg działania. Na przykład strażak nie będzie gasić budynków poza swoją strefą.";
"T_LOADINGTIP_068" = "Możesz zobaczyć strefę wpływów danego budynku podczas jego rozmieszczania oraz w trybie pokrycia lub w menu kontekstowym budynku. Ten widok jest dostępny dla koszar, wież strażniczych i wież strażackich.";
"T_LOADINGTIP_069" = "Jeśli chcesz dowiedzieć się więcej o budynku i jego produkcji, wejdź do jego menu kontekstowego i wybierz „Budynek – informacje”.";
"T_LOADINGTIP_070" = "Wiele łańcuchów produkcyjnych oraz cała gospodarka są zależne od pszenicy. Lepiej zgromadzić jej jak najwięcej przed nadejściem zimy.";
"T_LOADINGTIP_071" = "Większa ilość płomieni na płonącym budynku oznacza, że ogień się rozprzestrzenia, a budynek może się zawalić!";
"T_LOADINGTIP_072" = "Potrzebę rozrywki w twojej osadzie może zaspokoić kilka budynków rozrywkowych. Każdy z nich może zadowolić określoną liczbę mieszczan.";
"T_LOADINGTIP_073" = "Każda pora roku w określony sposób wpływa na osadę. Na przykład zimą rośnie zapotrzebowanie na odzież.";
"T_LOADINGTIP_074" = "Zimą twojej osadzie grożą burze śnieżne i lawiny.";
"T_LOADINGTIP_075" = "Latem osadę może nawiedzić susza. Uprawy będą więdnąć aż do ustania tego efektu.";
"T_LOADINGTIP_076" = "Klasztor potrzebuje suszarni chmielu, by zapewnić sobie jego stałe dostawy.";
"T_LOADINGTIP_077" = "Wytwórnia soku potrzebuje winnicy zaopatrującej ją w winogrona.";
"T_LOADINGTIP_078" = "Lekarz z lecznicy nie zbiera ziół, odpowiada za to gospodarstwo. Lekarz otrzymuje zioła z magazynu.";
"T_LOADINGTIP_079" = "Warunki pogodowe wpływają na miasto w różny sposób. Po deszczu gospodarstwa są przez jakiś czas wydajniejsze. ";
"T_LOADINGTIP_080" = "Jeśli nad osadą przechodzi burza, piorun uderzający w budynki może je podpalić.";
"T_LOADINGTIP_081" = "O każdej porze roku na jarmarku odbywa się festyn. Na czas jego trwania ogólne szczęście tymczasowo się zwiększa.";
"T_LOADINGTIP_082" = "Zwróć uwagę na zakładkę wpływów w menu. Możesz sprawdzić, jakie czynniki wpływają na miasto.";
"T_LOADINGTIP_083" = "Jeśli jakiś budynek ulegnie zniszczeniu, wybierz drogowskaz stojący w ruinach, by go odbudować.";
"T_LOADINGTIP_084" = "Jeśli osadę nawiedza zamieć, mieszczanie poruszają się wolniej, a budynki szybciej niszczeją.";
"T_LOADINGTIP_085" = "Jeśli jakiś budynek jest zablokowany lub niedostępny, prawdopodobnie nie spełniasz dodatkowych wymagań.";
"T_LOADINGTIP_086" = "W trakcie burzy w twoje budynki może uderzyć piorun!";
"T_LOADINGTIP_087" = "Budynki niszczeją szybciej po obfitych opadach śniegu!";
"T_LOADINGTIP_088" = "Dzięki menu podręcznemu możesz naprawiać budynki, przydzielać/zwalniać pracowników i szybko podążać za mieszkańcami.";
"T_LOADINGTIP_089" = "W menu budynków, w zakładce „statystyki” znajdziesz przegląd wszystkich budynków. Wybierz jeden, by przełączać się między wszystkimi budynkami danego typu.";
"T_LOADINGTIP_090" = "W podglądzie pokrycia możesz przełączać między różnymi rodzajami warstw.";
"T_LOADINGTIP_091" = "Menu wydarzeń pozwoli ci przeskoczyć bezpośrednio do wydarzeń takich jak ukończone zadanie lub badania.";
"T_LOADINGTIP_092" = "W zakładce „informacje o osadzie” możesz zmienić nazwę swojej osady.";
"T_LOADINGTIP_093" = "Aktualną liczbę rodzin znajdziesz w zakładce „informacje o osadzie”.";
"T_LOADINGTIP_094" = "W menu wydarzeń możesz sortować ostrzeżenia według ich wagi lub ukryć je na ekranie.";
"T_LOADINGTIP_095" = "Młyn musi być zaopatrywany w pszenicę z gospodarstw, by pracował wydajnie.";
"T_LOADINGTIP_096" = "Deszcz może ugasić pożar.";
"T_LOADINGTIP_097" = "Chorzy mieszkańcy mają niewielką szansę na samoistne ozdrowienie.";
"T_LOADINGTIP_098" = "Język mieszczan to mieszanka holenderskiego, fińskiego i volapük.";
"T_LOADINGTIP_099" = "Wszystkie aktywne efekty działające na budynek zobaczysz w jego menu kontekstowym.";
"T_LOADINGTIP_100" = "Gildia kupiecka może prowadzić automatyczny handel. Zlecenia kupna i sprzedaży zostaną rozpoczęte za każdym razem, gdy w osadzie pojawi się kupiec.";
"T_LOADINGTIP_101" = "Podatki są zbierane automatycznie w regularnych odstępach czasu. Wysokość podatków możesz zmienić w menu „szczęście”, w kategorii „podatki”.";
"T_LOADINGTIP_102" = "Populacja mieszkańców składa się z rodzin tworzonych przez mieszczan i mieszczanki. Pojemność budynków zawsze dotyczy całych rodzin.";
"T_LOADINGTIP_103" = "Lawiny zdarzają się tylko zimą na niektórych górskich stokach. Gdy zejdzie lawina, budynki na jej trasie zostaną uszkodzone lub nawet zniszczone, zależnie od ich stanu.";
"T_LOADINGTIP_104" = "Czasami bandyci będą atakować twoją osadę wielkimi chmarami. Zadbaj o odpowiednią liczebność straży miejskiej, aby nikt i nic nie ucierpiało w wyniku najazdu.";
"T_LOADINGTIP_105" = "Naprawa budynków pochłania surowce. Bardziej zaawansowane obiekty wymagają ich więcej.";
"T_LOADINGTIP_106" = "Jeśli chcesz sprawdzić wszystkie akcje dostępne w menu kontekstowym danego budynku, skorzystaj z przycisku akcji.";
"T_LOADINGTIP_107" = "Zimą chaty rybackie i myśliwskie jako jedyne niezawodnie dostarczają żywności.";
"T_LOADINGTIP_108" = "Część zawartości, na przykład przystań, jest dostępna jedynie w „Nadmorskim imperium”.";
"T_LOADINGTIP_109" = "Krótkie historie w trybie ciągłym to małe wydarzenia oparte na podejmowaniu decyzji w trakcie dialogów. Niektóre z nich będą miały trwałe skutki!";
"T_LOADINGTIP_110" = "Czasem opcje w krótkich historiach lub wydarzeniach są niedostępne lub nawet ukryte, jeśli nie zostały spełnione konkretne warunki.";
"T_LOADINGTIP_111" = "Wiele wydarzeń może mieć miejsce w danym mieście tylko raz. Większość krótkich historii jest wyjątkowa.";
"T_LOADINGTIP_112" = "W większości przypadków krótkie historie oraz wydarzenia mogą zostać anulowane. Jednakże po ich rozpoczęciu zakończyć je można tylko za pomocą decyzji.";
"T_LOADINGTIP_113" = "Krótkie historie i wydarzenia oraz zamki wojskowe są dostępne tylko po rozpoczęciu nowej gry w trybie ciągłym. Znajdziesz tu również kilka opcji, które pozwolą ci na spersonalizowanie gry ciągłej.";
"T_LOADINGTIP_114" = "Bandyci, katastrofy, losowe zadania oraz krótkie historie mogą zostać włączone lub wyłączone w trybie ciągłym. Te ustawienia można zmienić tylko podczas rozpoczynania takiej mapy.";
"T_LOADINGTIP_115" = "Krótkie historie można aktywować po spełnieniu konkretnych warunków, na przykład jeśli został wzniesiony odpowiedni budynek lub osiągnięto konkretną liczbę mieszkańców.";
"T_LOADINGTIP_116" = "Czasami niektóre wybory w sytuacji decyzyjnej podczas krótkiej historii są niedostępne. Wynika to z tego, że nie zostały spełnione pewne wymogi.";
"T_LOADINGTIP_117" = "Zamek wojskowy ma małą pojemność magazynową, ale może zaopatrywać budynki obronne. Pozwala także na przydzielanie tragarzy, żołnierzy oraz kwatermistrzów.";
"T_LOADINGTIP_118" = "Nadmorskie imperium. Doświadcz niezliczonych godzin materiałów, nowych budynków, dekoracji, map, scenariuszy i wielkich wydarzeń, które oferują wybory i konsekwencje w zupełnie nowej scenerii z przepięknymi plażami!";
"T_LOADINGTIP_119" = "Średni dom oraz kamienica domyślnie oferują odpowiednio 4 lub 3 miejsca dla rodzin.";
"T_LOADINGTIP_120" = "W „Nadmorskim imperium” niemal wszystkie budynki otrzymały nowy wygląd.";
"T_LOADINGTIP_121" = "Od teraz w trybie ciągłym możliwe jest wybranie rodzaju zamku. W „Nadmorskim imperium” wygląd normalnego zamku został zmieniony, dodatkowo dostępny jest też zamek wojskowy, który oferuje zdecydowaną przewagę w kwestii ataków bandytów.";
"T_LOADINGTIP_122" = "Jeśli chcesz dowiedzieć się więcej o „Nadmorskim imperium”, zajrzyj do informacji na stronie pomocy. Jest tam dodatkowy wpis opisujący zawartość do pobrania.";
"T_LOADINGTIP_123" = "Niektóre wydarzenia wpływają na produktywność budynków. Może być to zwiększona produktywność gospodarstw po deszczu, ale również efekt podjętej przez ciebie decyzji, taki jak zmniejszona produktywność po nieudanym zadaniu.";
"T_LOADINGTIP_CLOUDSAVE_01" = "Regularnie przesyłaj swoje zapisy gry do chmury, by uniknąć utraty danych!";
"T_LOADINGTIP_CLOUDSAVE_02" = "Zapisy nie są automatycznie synchronizowane z chmurą! By zapisać grę w chmurze, użyj przycisku chmury w menu gry lub skorzystaj z Google Game Services.";
"T_LOADINGTIP_CLOUDSAVE_03" = "Zapisy nie są automatycznie synchronizowane z chmurą!";
"T_LOADINGTIP_CLOUDSAVE_04" = "„Townsmen” przypomni ci o zapisaniu gry w chmurze. Możesz włączyć lub wyłączyć przypomnienia o zapisie w menu opcji.";
"T_LOADINGTIP_CLOUDSAVE_05" = "By zapisać grę w chmurze, użyj przycisku chmury w menu gry lub skorzystaj z Google Game Services.";
"T_LOADINGTIP_COLLECTALL" = "Budynek skarbca pozwala jednym kliknięciem zebrać wszystkie należne podatki.\n\nJest to szczególnie przydatne w dużych osadach, ale kosztuje kilka punktów prestiżu.";
"T_LOADINGTIP_DAILY_REWARD" = "Pamiętaj, żeby często zaglądać do swoich mieszczan! Powrót do gry owocuje nagrodą w postaci pkt. prestiżu.";
"T_LOADINGTIP_EXTINGUISHALL" = "Budynki specjalne, takie jak lecznica czy wieża strażacka, odblokowują funkcje „Ugaś wszystko!” i „Wylecz wszystkich” w menu budynku.";
"T_LOADINGTIP_KEYBINDINGS_01" = "Możesz przesuwać kamerę, używając klawiszy {KEY_BINDING_CAMERA_UP}, {KEY_BINDING_CAMERA_DOWN}, {KEY_BINDING_CAMERA_LEFT} i{KEY_BINDING_CAMERA_RIGHT}.";
"T_LOADINGTIP_KEYBINDINGS_02" = "Większość funkcji gry posiada skróty klawiszowe: \n\nSzybkie przewijanie – {KEY_BINDING_FF}\nMenu budowy – {KEY_BINDING_BUILDMENU}\nDziennik zadań – {KEY_BINDING_QUESTS} \nStatystyki – {KEY_BINDING_STATISTICS}\nUsuń obiekt – {KEY_BINDING_SHOVEL}\nBadania – {KEY_BINDING_RESEARCH}\nZrzut ekranu – {KEY_BINDING_SCREENSHOT}\nMenu – {KEY_BINDING_INGAMEMENU}\nOstrzeżenia – {KEY_BINDING_ALERTS}\nSklep osady – {KEY_BINDING_TOWNSHOP}";
"T_LOADINGTIP_KEYBINDINGS_03" = "Jeśli w osadzie dojdzie do incydentu, możesz od razu przejść do ostrzeżeń, wciskając {KEY_BINDING_ALERTS}.";
"T_LOADINGTIP_KEYBINDINGS_04" = "Do podstron statystyk możesz przejść bezpośrednio przy użyciu skrótów klawiszowych:\n\nHandel – {KEY_BINDING_TRADE}\nMagazyny – {KEY_BINDING_STOCK}\nSzczęście – {KEY_BINDING_HAPPINESS} \nMenu wojskowe – {KEY_BINDING_MILITARY}\nZniszcz surowce – {KEY_BINDING_DELETE} ";
"T_LOADINGTIP_KEYBINDINGS_05" = "Grę możesz zapisać w każdej chwili w menu lub używając skrótu {KEY_BINDING_QUICKSAVE}.";
"T_LOADINGTIP_KEYBINDINGS_06" = "W grze jest wiele skrótów klawiszowych. Ich listę znajdziesz w menu.";
"T_LOADINGTIP_PRESTIGE" = "Punkty prestiżu mają wiele zastosowań. Możesz je wydać na ulepszenie budynków, tworzenie dekoracji lub przyspieszenie budowy.";
"T_LOADINGTIP_PRESTIGEFEATURES" = "W menu kontekstowym niektórych budynków kryją się rozbudowane funkcje.\n\nTe budynki to: stolarnia, skarbiec, lecznica, wieża strażacka i kopalnia.";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP" = "Chcesz zawsze otrzymywać podwójne PD?\n\nSzybciej osiągaj nowe poziomy osady i odblokuj nowe, potężne badania!\n\nNa co czekasz? Odwiedź sklep osady!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_02" = "Użyj „podwójnych PD”, by zdobyć dwukrotnie więcej PD podczas gry!\nDzięki temu szybciej osiągniesz nowe poziomy osady i odblokujesz nowe, potężne badania!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_03" = "Zdobywaj więcej PD i szybciej osiągaj nowe poziomy osady dzięki podwojeniu PD!";
"T_LOADINGTIP_PURCHASE_FASTFORWARD" = "Zdobądź na stałe nieograniczone szybkie przewijanie!\n\nGraj z prędkością x5, jak długo zechcesz!\nJuż nie musisz wydawać punktów prestiżu, by przyspieszyć upływ czasu!\n\nNa co czekasz? Odwiedź sklep osady!";
"T_LOADINGTIP_PURCHASE_NOADS" = "Nie lubisz bannerów reklamowych i przerw na reklamy? Może wypróbujesz wersję bez reklam?\n\nGraj w „Townsmen” bez reklam - na zawsze!\n\nNa co czekasz? Odwiedź sklep osady!";
"T_LOADINGTIP_PUSH_NOTIFICATIONS" = "Twoje urządzenie mobilne poinformuje cię, gdy mieszczanie za tobą zatęsknią i gdy pojawią się punkty prestiżu do odebrania.\nMożesz wyłączyć powiadomienia w opcjach aplikacji „Townsmen”. ";
"T_LOADINGTIP_REFILLDEPOSIT" = "Jeśli złoże surowców w kopalni się wyczerpie, masz kilka możliwości:\n– Odnów złoża za pomocą pkt. prestiżu\n– Poszukaj nowego złoża i zbuduj na nim kopalnię\n– Przydziel geologa do kopalni, w której wyczerpały się złoża (można go odblokować, prowadząc badania)";
"T_LOADINGTIP_REPAIRALL" = "Stolarnia umożliwia naprawę wszystkich budynków jednym kliknięciem. Koszt w punktach prestiżu zależy od całkowitej liczby uszkodzeń do naprawienia.";
"T_LOADINGTIP_YOUTUBE_GENERIC" = "Samouczki i gameplaye zobaczysz na naszym kanale YouTube Townsmen, wystarczy wybrać przycisk YouTube w menu głównym.";
"T_LOADINGTIP_YOUTUBE_MOUSE" = "W menu głównym znajdziesz samouczki i gameplaye z naszego kanału YouTube Townsmen. Wystarczy kliknąć przycisk YouTube.";
"T_LOADINGTIP_YOUTUBE_TOUCH" = "W menu głównym znajdziesz samouczki i gameplaye z naszego kanału YouTube Townsmen. Wystarczy dotknąć przycisku YouTube.";
"T_LOADING_DONE_PRESS_ANY_KEY" = "Wciśnij dowolny klawisz!";
"T_MAINMENU_DLC_ENTRY" = "Zawartość do pobrania";
"T_MAINMENU_DLC_ENTRY_02" = "Zawartość do pobrania";
