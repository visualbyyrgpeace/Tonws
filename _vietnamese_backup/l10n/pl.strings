"T_GAME_TUTORIAL_BUILDMENU" = "Budynki można stawiać za surowce lub punkty prestiżu.\n\nSurowce muszą zostać przetransportowane na plac budowy, aby rozpocząć budowę. To wymaga czasu. Natomiast korzystanie z punktów prestiżu przynosi efekty natychmiast.";
"T_GAME_TUTORIAL_FIRERISK" = "Twoi mieszczanie opuszczą płonące budynki i poczekają na ugaszenie pożaru. Jeśli po jakimś czasie to się nie stanie, budynek się zawali!";
"T_GAME_TUTORIAL_FIRETOWER" = "Wraz z rozwojem osady rośnie ryzyko wybuchu pożaru. Należy budować wieże strażackie, aby się na to przygotować.";
"T_GAME_TUTORIAL_FIRETOWER2" = "Wieża strażacka ma ograniczony zasięg. Strażacy mogą gasić tylko pożary, które znajdują się w ich zasięgu.\n\nUmieść ją w miejscu, w którym obejmuje jak najwięcej budynków.";
"T_GAME_TUTORIAL_HAPPINESS" = "Potrzeby twoich mieszczan to jedzenie i woda.\nOprócz tego twoi mieszczanie posiadają także pragnienia.\nSzczęście jest sumą wszystkich potrzeb i pragnień. Zawsze miej oko na poziom szczęścia swoich mieszkańców!";
"T_GAME_TUTORIAL_NOTIFICATION_1" = "Witaj w samouczku. Nauczysz się teraz podstaw gry Townsmen.";
"T_GAME_TUTORIAL_NOTIFICATION_2_MOUSE" = "Możesz przesunąć widok na ekranie, przesuwając mapę LPM. Jeśli chcesz przybliżyć lub oddalić widok, użyj środkowego przycisku myszy.";
"T_GAME_TUTORIAL_NOTIFICATION_2_NOMULTITOUCH" = "Możesz poruszać kamerą, przesuwając palcem po ekranie. Możesz przybliżać i oddalać widok za pomocą przycisków + i -. ";
"T_GAME_TUTORIAL_NOTIFICATION_2_TOUCH" = "Poruszaj kamerą, przesuwając palcem po ekranie. Powiększaj i pomniejszaj za pomocą kciuka i palca waskazującego.";
"T_GAME_TUTORIAL_NOTIFICATION_3" = "Zamek jest twoją najważniejszą budowlą. Pełni on rolę twojego pierwszego magazynu i możesz tutaj przydzielić mieszczan jako tragarzy.";
"T_GAME_TUTORIAL_NOTIFICATION_4" = "W prawym górnym rogu ekranu możesz zobaczyć, ile masz prestiżu i talarów, a także liczbę nieprzydzielonych nigdzie mieszczan i wielkość swojej osady.\n\nWażne komunikaty są wyświetlane w lewym górnym rogu.";
"T_GAME_TUTORIAL_NOTIFICATION_5" = "Prestiż to specjalna waluta, która zapewnia różne korzyści. Zawsze wypatruj ikony korony!";
"T_GAME_TUTORIAL_NOTIFICATION_6" = "Każdy dom zwiększa liczbę dostępnych robotników.";
"T_GAME_TUTORIAL_NOTIFICATION_7" = "Teraz musisz zadbać o potrzeby i pragnienia swoich mieszczan. Wszystkie ważne informacje znajdziesz w menu statystyk.";
"T_GAME_TUTORIAL_NOTIFICATION_8" = "Ikony wyświetlane nad budynkami oraz komunikaty ostrzegawcze informują o braku przestrzeni magazynowej i innych problemach.";
"T_GAME_TUTORIAL_NOTIFICATION_FF" = "Użyj funkcji szybkiego przewijania, aby przyspieszyć czas w grze. Możesz ją doładować, wydając punkty prestiżu.";
"T_GAME_TUTORIAL_NOTIFICATION_SCREENSHOT_MOUSE" = "Twoja osada wygląda bardzo malowniczo!\n\nMożesz zapisać zrzut ekranu, klikając ikonę aparatu. Gdy dokonujesz zrzutu ekranu, ikony stają się automatycznie niedostępne.";
"T_GAME_TUTORIAL_NOTIFICATION_SCREENSHOT_TOUCH" = "Twoja osada wygląda bardzo ładnie!\n\nMożesz zapisać zrzut ekranu na swoim urządzeniu, dotykając ikony aparatu.";
"T_GAME_TUTORIAL_NOTIFICATION_SHOP" = "Sklep osady posiada świetne oferty na zdobycie dodatkowych punktów prestiżu lub usunięcie banerów reklamowych, jeśli grasz w darmową wersję! W każdej chwili możesz do niego zajrzeć.";
"T_GAME_TUTORIAL_NOTIFICATION_SHOP_GAMEROOM" = "W sklepie osady znajdziesz świetne oferty, dzięki którym zdobędziesz dodatkowe punkty prestiżu, odblokujesz stałe szybkie przewijanie lub zakupisz bez limitu podwójne PD. Możesz tam zajrzeć w każdej chwili.";
"T_GAME_TUTORIAL_NOTIFICATION_STOCK" = "Surowce i towary są tymczasowo składowane w budynkach produkcyjnych do czasu ich wykorzystania do produkcji lub przetransportowania do magazynu.";
"T_GAME_TUTORIAL_QUEST_4_WELL" = "Zbuduj studnię.";
"T_GAME_TUTORIAL_QUEST_DESC_1" = "Otrzymujesz swoje pierwsze zadanie! Twoja osada potrzebuje drewna! Wejdź do menu budowy i poszukaj leśniczówki!";
"T_GAME_TUTORIAL_QUEST_DESC_10" = "Drogi przyspieszają transport towarów i surowców, ale musisz mądrze zaplanować ich budowę.\n\nWybuduj teraz kilka dróg w swojej osadzie.";
"T_GAME_TUTORIAL_QUEST_DESC_11_MOUSE" = "Budynki, które nie są regularnie konserwowane, niszczeją, a nawet mogą się zapalić. Zniszczone budynki można rozpoznać po ich niechlujnym wyglądzie.\n\nKliknij budynek, aby uzyskać dostęp do jego menu, a następnie użyj przycisku naprawy, aby go naprawić.";
"T_GAME_TUTORIAL_QUEST_DESC_11_TOUCH" = "Budynki, które nie są regularnie konserwowane, niszczeją, a nawet mogą się zapalić. Zniszczone budynki można rozpoznać po ich niechlujnym wyglądzie.\n\nDotknij budynku, aby uzyskać dostęp do jego menu, a następnie użyj ikony naprawy, aby go naprawić.";
"T_GAME_TUTORIAL_QUEST_DESC_12" = "Nie zapomnij zaglądać do menu statystyk, aby być na bieżąco z potrzebami i pragnieniami twoich mieszczan!";
"T_GAME_TUTORIAL_QUEST_DESC_13" = "Oprócz budynków publicznych, takich jak targowisko, szczęście twoich mieszczan zwiększają również dekoracje osady!";
"T_GAME_TUTORIAL_QUEST_DESC_2" = "Dzięki uwolnionemu pracownikowi możesz teraz zbudować kolejny dom.";
"T_GAME_TUTORIAL_QUEST_DESC_3" = "Budynki bez przydzielonych pracowników pozostają bezczynne. Zdobądź więcej pracowników, aby kontynuować produkcję.\n\nPrzydziel nowego pracownika do leśniczówki.";
"T_GAME_TUTORIAL_QUEST_DESC_4" = "Chaty rybackie zaopatrują twoją osadę w ryby jako źródło pożywienia. Zbuduj chatę rybacką, aby zaspokoić zapotrzebowanie mieszkańców osady na żywność.";
"T_GAME_TUTORIAL_QUEST_DESC_4_WELL" = "Studnia zaopatruje twoją osadę w wodę. Zbuduj studnię, aby zaspokoić zapotrzebowanie mieszczan na wodę.";
"T_GAME_TUTORIAL_QUEST_DESC_5_MOUSE" = "Twoje domy regularnie płacą podatki. Liczba wygenerowanych talarów zależy od poziomu szczęścia i wysokości podatku.\n\nKlikaj monety nad domami, aby zbierać podatki!";
"T_GAME_TUTORIAL_QUEST_DESC_5_TOUCH" = "Twoje domy regularnie płacą podatki. Liczba zebranych talarów zależy od szczęścia i wysokości podatku.\n\nDotknij monet nad domami, aby zbierać podatki!";
"T_GAME_TUTORIAL_QUEST_DESC_6_MOUSE" = "Niektóre budynki wykorzystują surowce do produkcji towarów.\nJeśli chcesz przyspieszyć budowę tartaku, użyj funkcji „natychmiastowej budowy”.\n\nMożesz również użyć punktów prestiżu, aby natychmiast ukończyć budowę, klikając odpowiedni przycisk w menu kontekstowym placu budowy.";
"T_GAME_TUTORIAL_QUEST_DESC_6_TOUCH" = "Niektóre budynki wykorzystują surowce do produkcji towarów.\nAby przyspieszyć budowę tartaku, użyj funkcji „natychmiastowej budowy”.\n\nMożesz również użyć punktów prestiżu, aby natychmiast ukończyć budowę, dotykając odpowiedniej ikony w menu kontekstowym placu budowy.";
"T_GAME_TUTORIAL_QUEST_DESC_7" = "Wybuduj dwa dodatkowe domy, aby zwiększyć siłę roboczą.";
"T_GAME_TUTORIAL_QUEST_DESC_8" = "Twoi mieszczanie będą szczęśliwsi, gdy zbudujesz dla nich targowisko.";
"T_GAME_TUTORIAL_QUEST_DESC_9" = "Sprzedaj trochę towarów na targowisku.\nWypatruj ikony kupca. Informuje ona, że w osadzie pojawił się kupiec.";
"T_GAME_TUTORIAL_QUEST_DESC_CARRIER_MOUSE" = "Przydziel kolejnego tragarza do zamku. Im więcej masz tragarzy, tym szybciej towary są transportowane między budynkami.\nKliknij zamek i przydziel robotnika do jednego z pustych miejsc!";
"T_GAME_TUTORIAL_QUEST_DESC_CARRIER_TOUCH" = "Przydziel kolejnego tragarza do zamku. Im więcej masz tragarzy, tym szybciej towary są transportowane między budynkami.\nDotknij zamku i przydziel pracownika do jednego z pustych miejsc!";
"T_GAME_TUTORIAL_QUEST_DESC_CHURCH" = "Już pora zwrócić uwagę na pragnienia mieszczan. Co powiesz na zbudowanie kościoła, który zaspokoi ich potrzeby religijne?";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_MOUSE" = "Pora wybudować kolejny dom, aby zwiększyć populację. Niestety brakuje ci robotników do tego zadania, dlatego musisz przenieść tam pracownika z leśniczówki.\n\nKliknij leśniczówkę, aby otworzyć menu budynku, a następnie wybierz ikonę robotnika.";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_OLD" = "Pora wybudować kolejny dom, aby zwiększyć populację. Brakuje ci jednak do tego pracowników, dlatego musisz przenieść tam pracownika z leśniczówki.\n\nDotknij leśniczówki, aby otworzyć menu budynku, a następnie dotknij ikony pracownika.";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_TOUCH" = "Pora wybudować kolejny dom, aby zwiększyć populację. Brakuje ci jednak do tego pracowników, dlatego musisz przenieść tam pracownika z leśniczówki.\n\nDotknij leśniczówki, aby otworzyć menu budynku, a następnie dotknij ikony pracownika.";
"T_GAME_TUTORIAL_QUEST_DESC_FARM" = "Pora zbudować gospodarstwo, aby produkcja żywności na pewno wystarczała do utrzymania większej populacji. Gospodarstwo zaopatruje twoją osadę w pszenicę, którą można przerobić na mąkę, z której wyrabia się chleb.";
"T_GAME_TUTORIAL_QUEST_DESC_MINE" = "Oprócz drewna jednym z najważniejszych surowców jest kamień. Zbuduj kopalnię na skalistym zboczu wzgórza i zacznij wydobywać kamień.";
"T_GAME_TUTORIAL_QUEST_NAME_1" = "Zbuduj leśniczówkę.";
"T_GAME_TUTORIAL_QUEST_NAME_10" = "Zbuduj w osadzie 2 drogi";
"T_GAME_TUTORIAL_QUEST_NAME_11" = "Napraw domy.";
