"T_GAME_QUEST_AWAKENING_THE_TOWN_BAKERY_002" = "Wyśmienicie! Piekarz właśnie upiekł pierwszą partię i przyznam, że pieczywo jest przepyszne!";
"T_GAME_QUEST_AWAKENING_THE_TOWN_BAKERY_003" = "Idzie ci znakomicie, dlatego teraz możesz budować, co tylko chcesz.";
