"T_GAME_TUTORIAL_QUEST_NAME_2" = "Zbuduj nowy dom.";
"T_GAME_TUTORIAL_QUEST_NAME_3" = "Przydziel pracownika do bezczynnego budynku.";
"T_GAME_TUTORIAL_QUEST_NAME_4" = "Zbuduj chatę rybacką.";
"T_GAME_TUTORIAL_QUEST_NAME_5" = "Zbierz 40 talarów w podatkach.";
"T_GAME_TUTORIAL_QUEST_NAME_6" = "Zbuduj tartak, ale tym razem skorzystaj z funkcji „Natychmiastowej budowy”!";
"T_GAME_TUTORIAL_QUEST_NAME_7" = "Zbuduj jeszcze 2 domy.";
"T_GAME_TUTORIAL_QUEST_NAME_8" = "Zbuduj targowisko.";
"T_GAME_TUTORIAL_QUEST_NAME_9" = "Zarób 50 talarów, handlując na targowisku.";
"T_GAME_TUTORIAL_QUEST_NAME_CARRIER" = "Przydziel kolejnego tragarza do zamku.";
"T_GAME_TUTORIAL_QUEST_NAME_CHURCH" = "Zbuduj kościół.";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_2" = "Zwolnij robotnika z budynku!";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_3" = "Wstrzymaj produkcję tartaku, zwalniając jego pracownika.";
"T_GAME_TUTORIAL_QUEST_NAME_MINE" = "Zbuduj kopalnię.";
"T_GAME_TUTORIAL_QUEST_SUCESS_1" = "Większość zadań nagrodzi cię punktami prestiżu. Otwórz dziennik zadań, aby odebrać swoje nagrody.";
"T_GAME_TUTORIAL_QUEST_SUCESS_10_MOUSE" = "Po zakończeniu samouczka zyskasz dostęp do funkcji burzenia budynków poprzez zaznaczenia ikony wyburzenia w menu budynku. Wyburzenie budynku powoduje odzyskanie części surowców, które zostały użyte do jego budowy.\n\nDekoracje, lasy i drogi można usunąć przy użyciu narzędzia „łopata”. W tym celu w trybie „łopaty” zaznacz kursorem grupę obiektów, które chcesz usunąć, lub wybierz je pojedynczo.";
"T_GAME_TUTORIAL_QUEST_SUCESS_10_TOUCH" = "Po ukończeniu samouczka zyskasz dostęp do funkcji burzenia budynków w ich menu. Wyburzenie budynku powoduje odzyskanie części surowców, które zostały użyte do jego budowy.\n\nDekoracje, lasy i drogi można usunąć, aktywując tryb „łopaty” i przesuwając palcem po obiekcie, który chcesz usunąć.";
"T_GAME_TUTORIAL_QUEST_SUCESS_11" = "Warunki mieszkaniowe wpływają na szczęście i produktywność twoich mieszczan.\nNieszczęśliwi osadnicy są mniej wydajni, a czasem nawet strajkują i odmawiają pracy!";
"T_GAME_TUTORIAL_QUEST_SUCESS_12" = "Świetnie! Wiele już wiesz o świecie gry „Townsmen”. To koniec samouczka.\n\nTeraz możesz rozpocząć jeden ze scenariuszy lub grę w otwartym świecie!";
"T_GAME_TUTORIAL_QUEST_SUCESS_13" = "Im więcej masz mieszczan, tym więcej przedmiotów dekoracyjnych potrzebujesz, aby utrzymać ich szczęście!";
"T_GAME_TUTORIAL_QUEST_SUCESS_2" = "Dopóki masz nieprzydzielonych mieszczan, twoje place budowy będą natychmiast obsadzane. A teraz odbierz nagrodę z dziennika zadań!";
"T_GAME_TUTORIAL_QUEST_SUCESS_3" = "W grze „Townsmen” mieszczanie pracują jako tragarze, produkują surowce lub są rzemieślnikami, podczas gdy mieszczanki dbają o to, by w domach nie brakowało pożywienia, wody i towarów luksusowych.";
"T_GAME_TUTORIAL_QUEST_SUCESS_5" = "Im lepiej spełniasz potrzeby i pragnienia swoich mieszczan, tym będą oni szczęśliwsi i bardziej produktywni! Szczęśliwych mieszczan można również obłożyć wyższymi podatkami bez większych protestów z ich strony.";
"T_GAME_TUTORIAL_QUEST_SUCESS_6" = "Tartak jest częścią łańcucha produkcyjnego, w którym kłody drewna są przetwarzane na deski. Później napotkasz bardziej złożone łańcuchy produkcyjne.";
"T_GAME_TUTORIAL_QUEST_SUCESS_8" = "Możesz handlować towarami na targowisku, gdy w osadzie jest kupiec. Jego oferta będzie jednak ograniczona.\nTargowisko jest również miejscem, do którego mieszczanki udają się po biżuterię i ubrania, jeśli są tam dostępne.";
"T_GAME_TUTORIAL_QUEST_SUCESS_9" = "Kiedy masz mało pieniędzy i nadwyżkę towarów, możesz sprzedać część z nich, aby szybko zarobić trochę talarów.";
"T_GAME_TUTORIAL_QUEST_SUCESS_CARRIER" = "Możesz przydzielić więcej tragarzy, ale potrzebujesz do tego więcej magazynów.";
"T_GAME_TUTORIAL_QUEST_SUCESS_CHURCH" = "Każdy rodzaj budynku publicznego zaspokaja inne pragnienie twoich mieszczan. Dostępnych jest kilka budynków publicznych, na przykład kościół, gospoda czy plac turniejowy.";
"T_GAME_TUTORIAL_QUEST_SUCESS_FARM" = "Oprócz pszenicy gospodarstwa mogą też produkować wełnę. W tym celu musisz wybudować pastwisko dla owiec obok gospodarstwa i przydzielić pracownika do produkcji wełny.";
"T_GAME_TUTORIAL_QUEST_SUCESS_MINE" = "Lśniące żyłki na skalistych zboczach gór wskazują na złoża rudy żelaza lub złota. Jeśli postawisz kopalnię na złożu rudy, po przydzieleniu do niej pracownika będzie możliwe wydobywanie rudy żelaza lub złota zamiast kamienia.";
"T_GAME_TUTORIAL_STOCKTAB" = "Tutaj możesz zobaczyć wszystkie zgromadzone surowce.\n\nDostępne towary z głównego magazynu znajdują się po lewej stronie, a towary przechowywane w budynkach – po prawej.\n\nTylko towary, które zostały przetransportowane do głównego magazynu, można później sprzedać na targowisku.";
"T_GAME_TUTORIAL_TAXES" = "Możesz zwiększyć dochód z podatków, podnosząc wysokość podatku. Obserwuj jednak wpływ wysokości podatku na szczęście i produktywność!";
"T_GAME_TUTORIAL_TOWNNAME" = "Osada szkoleniowa";
"T_GAME_TUTORIAL_WISHES" = "Mieszczanie posiadają zarówno potrzeby, jak i pragnienia, takie jak dostęp do budynków publicznych, dobre warunki mieszkaniowe, dekoracje, ubrania i biżuteria!";
"T_GAME_UPDATEINFO" = "– Mieszczanie mogą zachorować => wylecz ich w lecznicy\n– Mieszczanie opuszczą miasto, jeśli nie zostaną wyleczeni\n– W mieście może wybuchnąć pożar => ugaś go z pomocą wieży strażackiej\n– Budynki w złym stanie stwarzają ryzyko wybuchu pożaru\n– Budynki mogą teraz spłonąć!\n– Mieszczanie opuszczą miasto, gdy ich domy zostaną zniszczone";
"T_GAME_UPDATEINFO_BANDITS" = "Dziennik aktualizacji: Townsmen v1.6 – „Bandyci kontra żołnierze”\n\nAtakujący bandyci mogą teraz rabować surowce, podpalać lub niszczyć budynki w twoim mieście!\nWybierz grę towarzyską lub z bandytami na dowolnej mapie do gry w otwartym świecie.\nBuduj wieże strażnicze i koszary chroniące twoje miasto.\nStare zapisy gry wciąż nie obsługują wojska.\nCałkowicie przerobione menu kontekstowe budynków (z dużą ilością informacji).\n7 nowych scenariuszy: samouczek wojskowy, 3 scenariusze wojskowe i 3 scenariusze bez wojsk.\nZnajduj swoich mieszczan dzięki trybowi „Idź za mieszczaninem”!\n7 nowych budynków.\n8 nowych surowców.\n18 nowych dekoracji.\n15 nowych osiągnięć.\n25 nowych możliwości badań dla wojska.\nMnóstwo nowych zadań.\nBrody umożliwiają teraz przekraczanie rzek bez mostów.\nNowa opcja „zniszcz surowce” w menu statystyk.";
