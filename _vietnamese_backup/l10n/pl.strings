"T_SAVEGAMES_WARNING_SIZE" = "Pliki zapisu łącznie: ";
"T_SAVEGAMES_WARNING_SIZE_NEW" = "Pliki zapisu łącznie: {mb} MB!\nUsuń niektóre pliki zapisu!";
"T_SCENARIO_2016_06_BANDIT_01_DESC" = "Więc zamierzasz ukraść moje samorodki? Zobaczysz, co cię za to spotka. LAAAWIIIINAAAA!";
"T_SCENARIO_2016_06_BANDIT_025_DESC" = "Chcesz wiedzieć, co dzieje się z ludźmi, którzy nie słuchają?! LAAAWIIIINAAAA!";
"T_SCENARIO_2016_06_BANDIT_02_DESC" = "Skąd masz ten chleb? Nieważne, też chcę trochę! A może wolisz kolejną lawinę?";
"T_SCENARIO_2016_06_BANDIT_02_NAME" = "Spełnij żądania bandyty.";
"T_SCENARIO_2016_06_BANDIT_03_DESC" = "Och, ale masz dużo żelaza. Na pewno chcesz zrobić z tego kilka narzędzi dla mnie.";
"T_SCENARIO_2016_06_BANDIT_04_DESC" = "Jak miło, że już przetopiłeś samorodki na sztabki. Tak jak mówiłem, to „moje” złoto i chcę je z powrotem, natychmiast! I oczyść je jeszcze trochę, dobra?";
"T_SCENARIO_2016_06_BANDIT_05_DESC" = "Przydałyby mi się nowe ubrania. Masz jakieś w moim rozmiarze?";
"T_SCENARIO_2016_06_INTRO_01_DESC" = "Na szczęście wszystkim mieszczanom udało się uciec przed lawiną, ale pochłonięte przez nią budynki zostały zniszczone.";
"T_SCENARIO_2016_06_MAIN_00_DESC" = "Regularne dostawy z tej osady ustały. Gubernatorze, oczekuję, że poradzisz sobie z tym problemem.";
"T_SCENARIO_2016_06_MAIN_00_END" = "Zagrożenie lawinami nie stanowiło dla ciebie problemu. Wiedziałem, że mogę na tobie polegać, mój gubernatorze.";
"T_SCENARIO_2016_06_MAIN_00_NAME" = "Wykonaj podstawowe zadania i zajmij się kopalniami.";
"T_SCENARIO_2016_06_QUEST_00_DESC" = "Powinniśmy naprawić magazyn, inaczej też się zawali.";
"T_SCENARIO_2016_06_QUEST_00_NAME" = "Napraw magazyn.";
"T_SCENARIO_2016_06_QUEST_01_DESC" = "Na początek potrzebujemy tartaku, aby odbudować wszystkie budynki w osadzie.";
"T_SCENARIO_2016_06_QUEST_01_NAME" = "Zbuduj tartak.";
"T_SCENARIO_2016_06_QUEST_02_DESC" = "Mój panie, mimo zagrożenia lawinowego musimy ponownie rozpocząć produkcję żelaza i złota. Król czeka na dużą dostawę z tej osady.";
"T_SCENARIO_2016_06_QUEST_02_NAME" = "Nakaż swoim górnikom poszukiwanie żelaza i złota.";
"T_SCENARIO_2016_06_QUEST_03_DESC" = "Huta jest bardziej wydajna, gdy znajduje się w pobliżu kopalni, ale ulegnie uszkodzeniu, jeśli zejdzie lawina. Zdecyduj mądrze, mój panie.";
"T_SCENARIO_2016_06_QUEST_04_DESC" = "Wspaniale, mój panie. Król oczekuje rekompensaty za pominięte dostawy. Powinniśmy my wysłać wysoką daninę.";
"T_SCENARIO_2016_06_QUEST_04_NAME" = "Zapłać królowi daninę.";
"T_SCENARIO_2016_06_QUEST_05_DESC" = "Produkcja idzie bardzo powoli, mój panie. Przy większej liczbie kopalni moglibyśmy zwiększyć tempo pozyskiwania rudy.";
"T_SCENARIO_2016_06_QUEST_06_DESC" = "Kończy się węgiel. Powinieneś wydać rozkaz wybudowania zakładu węglarza.";
"T_SCENARIO_2016_06_QUEST_10_DESC" = "Mój panie, powinniśmy produkować sztabki złota, aby zapłacić dodatkowe daniny. Król będzie bardzo zadowolony.";
"T_SCENARIO_2016_06_QUEST_AVALANCHE_00_DESC" = "Uważaj, mój panie! Kolejna lawina, cóż za okropieństwo!";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_DESC" = "Mój panie, wiele kopalni już się zawaliło. Król wydał rozkaz ich odbudowy.";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_NAME" = "Zbuduj więcej kopalni.";
"T_SCENARIO_2016_06_QUEST_SIDE_025_DESC" = "Moja żona chce się za nas pomodlić, żeby lawiny nie wyrządziły nam krzywdy. Czy byłbyś tak miły i zbudował nam kościół?";
"T_SCENARIO_2016_06_QUEST_SIDE_02_DESC" = "Mój panie, wiem, że potrzebujemy dużo drewna na odbudowę, ale moja rodzina nie ma już drewna na opał i robi się bardzo zimno. Może zdołasz nam pomóc?";
"T_SCENARIO_2016_06_QUEST_SIDE_03_DESC" = "Poruszanie się w śniegu jest bardzo trudne. Pomóc może kilka brukowanych dróg.";
"T_SCENARIO_2016_06_QUEST_SIDE_045_DESC" = "Gubernatorze, nie możemy uprawiać pszenicy w tym regionie, ale możemy kupić chleb na targowisku. Możemy też po prostu kupić pszenicę i upiec własny chleb.";
"T_SCENARIO_2016_06_QUEST_SIDE_04_DESC" = "Ciągle tylko ryby i mięso. Mój panie, czy dla odmiany nie możemy zjeść chleba?";
"T_SCENARIO_2016_06_QUEST_SIDE_04_NAME" = "Spełnij pragnienia swoich mieszczan.";
"T_SCENARIO_2016_06_QUEST_SIDE_05_DESC" = "Przy tej nieprzyjaznej pogodzie niszczą nam się ubrania. Bardzo potrzebujemy nowych.";
"T_SCENARIO_2016_06_QUEST_SIDE_06_DESC" = "Te zardzewiałe narzędzia prawie rozpadają się nam w rękach. Rozumiem, że potrzebujesz żelaza, ale wykorzystanie jego części do produkcji nowych narzędzi naprawdę nam pomoże.";
"T_SCENARIO_2016_06_QUEST_SIDE_07_DESC" = "W tym zaśnieżonym regionie cieszymy się z każdego drobiazgu. Mój panie, jeśli masz trochę czasu, czy mógłbyś upiększyć nasze miasto?";
"T_SCENARIO_2016_10_BANDIT_01_DESC" = "Do ataku, ludzie!";
"T_SCENARIO_2016_10_BANDIT_04_DESC" = "Szukasz kupca? Cóż, zgubił się i jakoś znalazł się związany w moim obozie. Ale nie martw się, nic mu nie jest. Przekaż nam niewielką darowiznę, a znów będzie wolny.";
"T_SCENARIO_2016_10_BANDIT_04_END" = "Dobrze, wypuścimy kupca. Handluj z nim, żeby znowu było go z czego okraść.";
"T_SCENARIO_2016_10_BANDIT_04_NAME" = "Zapłać okup, aby ponownie uwolnić kupca.";
"T_SCENARIO_2016_10_BANDIT_END_DESC" = "Bandyci! Wynośmy się stąd! Nazywamy to taktycznym odwrotem. I tak ukradliśmy wystarczająco dużo.";
"T_SCENARIO_2016_10_BANDIT_TIMER_10_DESC" = "Czy ty właśnie zniszczyłeś jeden z naszych obozów? W ten sposób tylko rzucasz nam wyzwanie. Zaatakujcie osadę, chłopaki!";
"T_SCENARIO_2016_10_HAPPYNESS_DESC" = "O nie, mój panie. Mieszczanie są niezadowoleni i nie chcą płacić podatków. Powinniśmy spełnić ich pragnienia, aby ponownie zarabiać na podatkach.";
"T_SCENARIO_2016_10_HAPPYNESS_NAME" = "Zwiększ poziom szczęścia, aby ponownie zarabiać na podatkach.";
"T_SCENARIO_2016_10_MAIN_00_DESC" = "Gubernatorze, potrzebuję mnóstwo monet. Stwórz kwitnącą gospodarkę i złóż daninę. Ale uważaj, w okolicy jest wielu bandytów. Całe królestwo na ciebie liczy.";
"T_SCENARIO_2016_10_MAIN_00_END" = "Bardzo dobrze, mój gubernatorze. Wiedziałem, że mogę na ciebie liczyć. Zostaniesz nagrodzony i zdobędziesz lepszą reputację.";
"T_SCENARIO_2016_10_NEED_BREAD_DESC" = "Mój panie, zapasy w magazynie są na wyczerpaniu. To sprawia, że ludzie są nieszczęśliwi.";
"T_SCENARIO_2016_10_NEED_BREAD_NAME" = "Zgromadź wystarczająco dużo chleba, aby zwiększyć poziom szczęścia.";
"T_SCENARIO_2016_10_NEED_BREW_DESC" = "Szerzy się niezadowolenie, mój panie. Ludzie pragną podpiwka.";
"T_SCENARIO_2016_10_NEED_BREW_NAME" = "Zgromadź wystarczającą ilość podpiwka, aby zapobiec nadchodzącemu strajkowi mieszczan.";
"T_SCENARIO_2016_10_NEED_CARPENTER_DESC" = "Cieślę czeka mnóstwo pracy. Wiele budynków wymaga naprawy, wasza miłość. Radzę zbudować więcej stolarni.";
"T_SCENARIO_2016_10_NEED_CARPENTER_NAME" = "Zbuduj stolarnię, aby zwiększyć szczęście.";
"T_SCENARIO_2016_10_NEED_CLOTHS_DESC" = "Nie mam się w co ubrać. Potrzebujemy więcej ubrań i sukni.";
"T_SCENARIO_2016_10_NEED_CLOTHS_NAME" = "Zgromadź wystarczającą ilość ubrań, aby zwiększyć szczęście.";
"T_SCENARIO_2016_10_NEED_FIREWATCH_DESC" = "Panie, wieże strażackie nie zabezpieczają wszystkich budynków, musimy zbudować ich więcej.";
"T_SCENARIO_2016_10_NEED_FISH_DESC" = "Nie mamy nawet w osadzie wystarczającej ilości ryb. Nie zamierzam płacić żadnych podatków!";
"T_SCENARIO_2016_10_NEED_FISH_NAME" = "Zgromadź w magazynach wystarczającą ilość ryb, aby zmniejszyć prawdopodobieństwo strajku.";
"T_SCENARIO_2016_10_NEED_JEWELRY_DESC" = "Chcę zaskoczyć swoją żonę nową biżuterią. Szkoda, że w tej osadzie żadnej nie mają.";
"T_SCENARIO_2016_10_NEED_JEWELRY_NAME" = "Zgromadź odpowiednią ilość biżuterii, aby zapobiec strajkowi mieszczan.";
"T_SCENARIO_2016_10_NEED_JOUSTING_DESC" = "W osadzie nie ma wiele do roboty. Za mało tu rozrywek. Myślę, że nadszedł czas na zwiększenie liczby budynków rozrywkowych.";
"T_SCENARIO_2016_10_NEED_JUICE_DESC" = "Mam ochotę na sok. Panie, czy możesz znowu zapewnić sok?";
"T_SCENARIO_2016_10_NEED_JUICE_NAME" = "Zgromadź zapasy soku, aby zwiększyć szczęście i zapobiec strajkowi.";
"T_SCENARIO_2016_10_NEED_MEAT_DESC" = "W osadzie znowu zabrakło mięsa. Kiedy pojawi się dostawa?";
"T_SCENARIO_2016_10_NEED_MEAT_NAME" = "Zgromadź wystarczającą ilość mięsa, aby zwiększyć szczęście i zapobiec strajkowi.";
"T_SCENARIO_2016_10_NEED_MEDICUS_DESC" = "Gubernatorze, przy tak wielu mieszkańcach nie mogę się wszystkim zająć. Potrzebuję wsparcia, jeśli mam im wszystkim pomóc.";
"T_SCENARIO_2016_10_NEED_MEDICUS_NAME" = "Zbuduj lecznicę, aby zapobiec strajkowi w osadzie.";
"T_SCENARIO_2016_10_NEED_TAVERN_DESC" = "W naszej gospodzie nie ma już miejsca. Jest zbyt tłoczno. Nowy gubernator marnuje nasze pieniądze zamiast wydawać je na nasze potrzeby.";
"T_SCENARIO_2016_10_QUEST_00_DESC" = "Mój panie, najpierw powinniśmy zbudować podstawowe budynki dla naszej gospodarki. Zalecam postawić dodatkową chatę rybacką i tartak.";
"T_SCENARIO_2016_10_QUEST_00_NAME" = "Zbuduj tartak i chatę rybacką";
"T_SCENARIO_2016_10_QUEST_01_DESC" = "Możemy zbudować w pobliżu kopalnię, aby szybciej pozyskiwać surowce.";
"T_SCENARIO_2016_10_QUEST_01_NAME" = "Zbuduj kopalnię.";
"T_SCENARIO_2016_10_QUEST_02_DESC" = "Ludzie proszą teraz o chleb. Możemy go wyprodukować we własnym zakresie lub kupić na targowisku. Powinniśmy jednak zadbać o to, by zawsze mieć go pod dostatkiem.";
"T_SCENARIO_2016_10_QUEST_02_NAME" = "Zdobądź wystarczającą ilość chleba.";
"T_SCENARIO_2016_10_QUEST_03_DESC" = "Nie dostajemy nawet podpiwka. Na co idą moje podatki, jeśli nie możemy dostać tak prostego napoju jak podpiwek?";
"T_SCENARIO_2016_10_QUEST_03_NAME" = "Zgromadź wystarczającą ilość podpiwka w magazynie.";
"T_SCENARIO_2016_10_QUEST_04_DESC" = "Mój panie, ludzie lubią jeść różne potrawy. Ryby i chleb to za mało, chcą też mięsa.";
"T_SCENARIO_2016_10_QUEST_04_NAME" = "Zgromadź wystarczającą ilość mięsa w magazynie.";
"T_SCENARIO_2016_10_QUEST_05_DESC" = "Byłoby wspaniale mieć więcej niż jedną sukienkę. Czy byłby pan tak miły, panie gubernatorze?";
"T_SCENARIO_2016_10_QUEST_05_NAME" = "Zgromadź zapas odzieży.";
"T_SCENARIO_2016_10_QUEST_06_DESC" = "Wraz z rozwojem osady przybywa do niej coraz więcej arystokratów. Chcą się napić soku.";
"T_SCENARIO_2016_10_QUEST_06_NAME" = "Zgromadź odpowiednią ilość soku w magazynie.";
"T_SCENARIO_2016_10_QUEST_07_DESC" = "Cudowne miasto, ale brakuje w nim niektórych towarów luksusowych. Czy byłbyś tak uprzejmy i wprowadził do sprzedaży biżuterię?";
"T_SCENARIO_2016_10_QUEST_07_NAME" = "Zgromadź biżuterię w magazynie.";
"T_SCENARIO_2016_10_QUEST_10_DESC" = "Mieszczanie domagają się budowy kościoła.";
"T_SCENARIO_2016_10_QUEST_11_DESC" = "Potrzebujemy gospody, aby nasz lud był szczęśliwszy, mój panie.";
"T_SCENARIO_2016_10_QUEST_12_DESC" = "Mój panie, powinniśmy zbudować jarmark dla naszych ludzi.";
"T_SCENARIO_2016_10_QUEST_13_DESC" = "Nasi ludzie martwią się o bezpieczeństwo pożarowe. Powinniśmy zbudować wieżę strażacką.";
"T_SCENARIO_2016_10_QUEST_14_DESC" = "Gubernatorze, czy w osadzie jest już kompetentny lekarz?";
"T_SCENARIO_2016_10_QUEST_14_NAME" = "Zbuduj lecznicę.";
"T_SCENARIO_2016_10_QUEST_15_DESC" = "Powinniśmy zbudować plac turniejowy, aby zwiększyć szczęście naszych ludzi.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "Mój panie, miasto bardzo dobrze się rozwija. Aby wszystkie budynki były w dobrym stanie, powinniśmy zbudować stolarnię.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "Jeśli nie zabezpieczymy się jakoś przeciwko bandytom, odbiorą nam domy i dobytek.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "Mamy już trochę żołnierzy. Mam nadzieję, że zdołamy obronić miasto przed atakami bandytów.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "Mój panie, czas rozwiązać problem z bandytami i wypędzić ich z tego regionu.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "Najwyraźniej potrzebne są bardziej stanowcze działania. Mieszczanie strajkują!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "Twoi mieszczanie strajkują. Poczekaj, aż się uspokoją.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "Wasza miłość, co za wspaniały dzień, nie sądzisz?\n\nPrzybywam spytać, czy byłoby możliwe odpowiednie udekorowanie osady z okazji nadchodzących uroczystości?";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "Zwiększ zadowolenie z dekoracji w osadzie.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "Wykonałeś świetną robotę z tymi nowymi dekoracjami, mój panie. Osada wygląda wspaniale!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "Mój panie, robotnicy przygotowujący ucztę są bardzo zirytowani brakiem rozrywek między uroczystościami. Słyszałem, jak kilku z nich mówiło, że życzą sobie obozu żonglera.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "Zbuduj obóz żonglera.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "Doskonale, mój panie! Robotnicy wracają do przygotowywania uroczystości. Przepełnia ich radość, bo mamy teraz w mieście obóz żonglera.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "Te burze bardzo niszczą miasto. Powinniśmy zadbać o odpowiednie naprawy wszystkich budynków, panie. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "Zwiększ zadowolenie ze stanu budynków.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "Wspaniale, mój panie! Budynki znów są w świetnym stanie.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "Mój panie! Nad miastem formuje się straszliwa burza z piorunami. Powinieneś udać się do bezpiecznego zamku. Pioruny uderzyły już w kilka budynków…";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "Czy mogę zabrać ci chwilę, mój panie?\n\nPrzy tych wszystkich przygotowaniach warto pamiętać, o co chodzi w tym święcie… Będzie się mogło odbyć tylko wtedy, gdy zbiory zostaną zakończone, mój panie!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "Zakończ zbiory winogron.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "Cóż za wspaniały widok, wasza miłość! Zbiory dobiegły końca, a przygotowania do święta również są niemal gotowe. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "Mój panie, skończył nam się czas. Na festyn jest już za późno. Król nie będzie zachwycony, gdy się o tym dowie…";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "Świetnie, wasza miłość!\n\nPrzygotowania do uroczystości dobiegły końca. Czekamy tylko na twoje polecenie, by rozpocząć świętowanie.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = "Dekretem królewskim nakazuję ci rozpocząć rok uroczystości. Chcę, abyś o każdej porze roku zorganizował festyn na cześć mojej nowej żony!\n\nA teraz ruszaj zacząć przygotowania! Nie zawiedź mnie…";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "Co za rozczarowanie, gubernatorze!\n\nNietrudno przecież zorganizować kilka uroczystości, a jednak ci się to nie udało! Czy to było dla ciebie zbyt wiele? Zejdź mi z oczu!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "Zorganizuj wszystkie uroczystości na czas!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "Gubernatorze! To był wspaniały rok uroczystości.\n\nUdowodniłeś, że mogę na tobie polegać nawet w przypadku trudnych zadań.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "Cóż to był za wspaniały festyn, wasza miłość!\n\nAle teraz musimy zadbać, aby jesienny festyn odbył się zgodnie z planem i przed rozpoczęciem zimy! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "Zorganizuj jesienny festyn przed początkiem zimy.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "Musimy się spieszyć z przygotowaniem wiosennego festynu, wasza miłość.\n\nMusi się zakończyć przed rozpoczęciem lata, więc nie mamy dużo czasu.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "Zorganizuj wiosenny festyn przed rozpoczęciem lata.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "Jakiż to był wspaniały festyn, wasza miłość!\nTeraz jednak musimy dopilnować, aby letni festyn odbył się zgodnie z planem i przed rozpoczęciem zimy!\n\nNajważniejszy jest czas, wasza miłość!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "Zorganizuj letni festyn przed początkiem jesieni.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "Cóż to był za wspaniały festyn, wasza miłość!\n\nMusimy zadbać o to, aby zorganizować zimowy festyn zgodnie z planem i zakończyć go przed początkiem wiosny! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "Zorganizuj zimowy festyn przed początkiem wiosny.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "Mój panie, polecam jak najszybciej zbudować jarmark. Odbędą się tam wszystkie festyny.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "Zbuduj jarmark.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "Świetnie, wasza miłość! Teren uroczystości jest gotowy. Budynek ten jest bardzo ważny dla obecnego zadania, dlatego powinniśmy mieć go na oku.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "Mój panie, potrzebujemy jarmarku na potrzeby uroczystości! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "Pierwszą rzeczą, jakiej potrzebujemy, jest porządny słup majowy, wasza miłość. Drwal może wybrać drzewo, które dobrze się do tego nada. Będzie jednak musiał ściąć ich wiele, aby znaleźć najlepsze.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "Zgromadź drewno na słup majowy.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "Nasz słup majowy musi być odpowiednio udekorowany. Będziemy do tego potrzebowali zapasu tkanin, mój panie.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "Wyprodukuj tkaniny na słup majowy.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "Cóż za piękny słup majowy. Wiesz, że tradycją moich braci jest coroczna kradzież słupów majowych z okolicy?";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "He, he, he! Twój słup majowy należy teraz do nas! Będzie piękną dekoracją przy wejściu do naszego obozu. Możesz spróbować go odzyskać…";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "Ochroń słup majowy przed atakami bandytów!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "A niech to! Prawie udało mi się zdobyć ten przeklęty słup majowy. Dobrze go broniłeś, gubernatorze!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "Mój panie! W pobliżu miasta znajduje się obóz bandytów. Potrzebujemy więcej ludzi i kolejnej wieży strażniczej, żeby zabezpieczyć wioskę.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "Zbuduj kolejną wieżę strażniczą i przydziel do niech więcej żołnierzy.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "Bardzo dobrze! Teraz nasi żołnierze będą mogli o wiele łatwiej bronić jarmarku, gdy zaatakują nas bandyci!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "Z naszych magazynów skradziono słup majowy. Musimy zaatakować obóz bandytów i odzyskać go, aby festyn mógł się rozpocząć na czas.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "Zaatakuj obóz bandytów i odzyskaj słup majowy!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "Zwycięstwo! Słup majowy wraca właśnie do naszego magazynu, mój panie.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "Mój panie! Nasze gospodarstwo płonie! Błagam, musisz coś z tym zrobić!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "Co za katastrofa, gubernatorze! Gospodarstwo spłonęło, a zbiory przepadły…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "Uratuj gospodarstwo!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "Pozostanę ci na zawsze wdzięczny, wasza miłość!\n\nAle ogień zniszczył zbiory! Być może trzeba będzie odwołać uroczystości, jeśli nie przeprowadzimy żniw na czas.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "Gospodarstwo mojej rodziny spłonęło, mój panie! Nie zdołam wypiec pierwszego chleba w roku na festyn. Czy byłbyś tak miły i kazał odbudować gospodarstwo?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "Zbuduj nowe gospodarstwo.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "Dziękuję ci, mój panie.\n\nBez ciebie byłbym zrujnowany, a letnie święto trzeba by odwołać!\n\nMusimy się jednak spieszyć, żeby zebrać pszenicę na czas!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "Mój panie, musimy teraz zatroszczyć się o żniwa. Do rozpoczęcia festynu zostało jeszcze trochę czasu. Musimy zadbać o zgromadzenie wystarczającej ilość pszenicy.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "Zakończ zbiory pszenicy.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "Ostatnio jest bardzo gorąco, wasza miłość. Mam nadzieję, że nie będzie kolejnego pożaru ani suszy, które zagroziłyby uroczystościom. Niemniej mamy teraz dość pszenicy, by zorganizować święto. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "Mój panie, moje pola są strasznie suche – wygląda na to, że tego lata nawiedziła nas kolejna susza. Czy byłbyś tak miły i zbudował kilka studni do podlewania pól?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "Zbuduj kilka studni niezbędnych do podlewania pól.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "Świetna robota, wasza miłość! Pola zostały nawodnione. Teraz musimy tylko poczekać, aż pszenica znów wyrośnie.\n\nMam nadzieję, że nie potrwa to zbyt długo…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "Uczta będzie się mogła rozpocząć, gdy upieczemy pierwszy chleb ze żniw, wasza miłość. Czy byłbyś tak miły i zadbał, by wypiek był gotowy na czas?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "Wypiecz wystarczającą ilość chleba na letni festyn.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "Wspaniale, wasza miłość. Chleb na ucztę został wypieczony!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "Mój panie! Czegoś jeszcze brakuje do festynu… potrzebujemy podpiwka! Powinieneś zlecić budowę przyklasztornego browaru, aby zdobyć trochę podpiwka produkowanego przez mnichów!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "Wyprodukuj podpiwek na letni festyn.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "Bardzo dobrze, wasza miłość. Ten podpiwek jest naprawdę smaczny i orzeźwiający w takie upalne lato jak to.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "Mam wspaniały pomysł na zimowe uroczystości, wasza miłość. Podczas moich podróży zetknąłem się ze specjalnym rodzajem zimowego wina zwanym grzanym winem. Byłby to idealny napój na zimową ucztę.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "Dostarcz składniki na grzane wino.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "Idealnie, wasza miłość. Teraz mamy już wszystkie składniki na grzane wino. Zacznę natychmiast i przygotuję napój.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "Panie, przybywam zapytać o ozdoby choinkowe. Naprawdę miło byłoby mieć jakieś złote dekoracje.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "Zdobądź złote samorodki na świąteczne dekoracje.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "Doskonale, mój panie. Te bombki są naprawdę ładne. Dziękuję za poświęcenie swojego cennego czasu na zdobycie tych ozdób choinkowych. Myślę, że to będzie wspaniały festyn.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "Chcemy z chłopakami zorganizować jasełka na festyn. Niestety brakuje nam do tego pewnych kluczowych surowców. Czy byłbyś tak miły i zapewnił nam niezbędny sprzęt?";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "Przygotuj surowce na jasełka.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "Dziękuję, wasza miłość. Teraz możemy zacząć tworzyć nasze kostiumy do jasełek.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "Mój panie, myślałem o pierniku na ucztę. Niezbędne surowce mogą być jednak trudne do zdobycia.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "Dostarcz składniki na piernik.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "Świetnie, wasza miłość. Od razu zacznę pieczenie piernika.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "W tych czasach nie powinniśmy zapominać o potrzebujących. Dlatego zbieram pieniądze dla biednych. Byłoby bardzo miło z twojej strony, gdybyś mógł przekazać część podatków miejskich na naszą sprawę.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "Zbierz wystarczającą ilość podatków dla biednych.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "Dziękuję za hojną darowiznę, wasza miłość!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "Gubernatorze,\nZ przykrością informuję, że na razie nie mogę odwiedzić twojej osady.\nW lasach otaczających twoje miasto są bandyci. W tej chwili stwarzają oni zbyt duże zagrożenie dla wędrownych kupców.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "Ogromnie dziękuję, wasza miłość. Teraz, gdy bandyci zostali wygnani z okolicy, będę regularnie odwiedzać twoją osadę.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "Nasz kościół się zawalił, wasza miłość. W dzisiejszych czasach potrzebujemy wszelkiego wsparcia, jakie możemy uzyskać. Potrzebujemy nowego kościoła w osadzie.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "Gubernatorze, w tej osadzie dzieje się coś dziwnego. W ciągu zaledwie jednej pory roku przeżyliśmy siedem katastrof! Musimy odkryć, co się tutaj dzieje. Jestem gotów uwierzyć, że nas przeklęto.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "Powinniśmy natychmiast opuścić tę osadę, mój panie. Wszystko stracone… Jesteśmy skazani na zagładę! Klątwa nigdy nie zostanie zdjęta.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "Znajdź sposób na zdjęcie klątwy.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "Uratowałeś miasto! To wspaniała wiadomość. Klątwa w końcu została zdjęta, a tobie udało się nawet przeżyć rytuał.\n\nOsada będzie jednak potrzebowała trochę czasu, aby dojść do siebie…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "Osada pilne potrzebuje stałych dostaw ziół leczniczych, mój panie. Inaczej zaraza będzie nam stale zagrażać.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "Wyprodukuj zioła lecznicze.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "Nigdy nie pokonamy zarazy bez zbudowania przynajmniej jednej lecznicy, mój panie. Zalecam postawić ich nawet więcej.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "Lekarze w osadzie potrzebują więcej materiału na bandaże, aby skutecznie leczyć ofiary zarazy. Powinieneś dostarczyć im trochę tkanin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "Mój panie, w osadzie doszło do wybuchu zarazy! Niestety nie odwiedzi nas żaden kupiec, dopóki będzie dochodzić do takich katastrof…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "Potrzebujemy młyna, żeby zmielić pszenicę na mąkę, mój panie. W tych trudnych czasach musimy dostosować naszą produkcję żywności, wasza miłość!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "Aby produkować chleb, musimy zlecić budowę piekarni, mój panie.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "Pora zaopatrzyć się w chleb. Musimy nakarmić mieszkańców osady. Ostatnią rzeczą, jakiej potrzebujemy, jest głodująca populacja.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "Mój panie… bydło, wszystkie zwierzęta i ryby w rzece umierają! Co tu się dzieje?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "Kościół płonie, gubernatorze. Pan nas opuścił! Musisz nam pomóc…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "Prowadziłem badania w kościele i znalazłem dokumenty, które mogą nam pomóc, wasza miłość.\n\nAle teraz wejście do kościoła jest niebezpieczne i nie mogę zdobyć tych dokumentów.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "Dziękuję, wasza miłość. Spójrz na te dokumenty. Tu, gdzie mieści się nasza osada, znajdował się kiedyś stary cmentarz.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "Kiedyś na dworze pracował specjalny doradca. Był wieszczem, ale znał się na pogańskiej magii i tym podobnych. Pewnego dnia oszalał i próbował otruć króla, więc został uwięziony.\n\nSkontaktuję się z królem. Może pozwoli nam porozmawiać z tym człowiekiem.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "Napraw kościół.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "Król nam nie pomoże, musimy wziąć sprawy w swoje ręce i uwolnić wieszcza.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "Mój panie! Mieszczanie panikują! Musimy skorzystać z pomocy wojska, żeby ich uspokoić.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "Gubernatorze, nie wypuszczę tego podłego i zdradzieckiego człowieka z więzienia. Nie obchodzi mnie twoja klątwa, ten mężczyzna próbował mnie zabić. Zgnije w więzieniu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "Przeklęty gubernatorze, dlaczego nas atakujesz? Wiem, że okradliśmy cię niezliczoną ilość razy, ale to…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "Na własnej skórze doświadczyliśmy działania klątwy, gubernatorze. Jako bandyci nie możemy rabować bogatych kupców, kiedy w sąsiedztwie dzieją się takie rzeczy.\n\nPomożemy ci wyciągnąć tego faceta z więzienia…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "W pobliżu naszej osady znajduje się obóz bandytów, mój panie. Może uda nam się ich „przekonać”, by pomogli nam uwolnić wieszcza z więzienia.\n\nTen człowiek na pewno będzie miał dla nas jakieś odpowiedzi! Zaatakuj ich obóz, żeby zainicjować małe, hm… „negocjacje”.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "Cóż za wspaniałe zwycięstwo nad bandytami, wasza miłość. A teraz z nimi porozmawiajmy…\n\nMoże pomogą nam przełamać klątwę.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "Wydaje się, że to gniew niebios, mój panie. Rolnicy donoszą, że zaczęła się susza!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "Przygotowania do napadu na więzienie mogą wymagać sprzętu wojskowego, odpowiednich poligonów i zaopatrzenia. Zacznijmy od zbrojowni, dobrze?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "Moi ludzie muszą się przygotować do napadu na więzienie, gubernatorze. Jeśli naprawdę chcesz zrealizować ten plan, będziemy potrzebować miejsca do treningu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "Zbuduj strzelnicę.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "Gubernatorze, myślę, że przydałoby się coś do jedzenia i picia, przynajmniej dla herszta napadu, czyli mnie!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "Dostarcz zaopatrzenie.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "Pora zająć się wyposażeniem, gubernatorze. Te drewniane miecze i topory, których zwykle używamy, będą bezużyteczne wobec strażników więziennych.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "Dostarcz sprzęt wojskowy.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "Mój panie, słońce! Zaczyna się zaćmienie! Musimy się pośpieszyć albo wszyscy będziemy zgubieni!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "Świetnie! Jesteśmy już prawie gotowi, by wyciągnąć tego człowieka z więzienia! Następnym razem, kiedy się spotkamy, porozmawiasz z nim osobiście.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "Może uda ci się mnie przekonać, jeśli to będzie warte mojego czasu. Dawno nie jadłem żadnych kiełbasek.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "W porządku, pomogę ci. To naprawdę paskudna klątwa, ale można ją zdjąć prostym rytuałem.\n\nA swoją drogą, to dlaczego w ogóle założyłeś miasto na terenie starożytnego cmentarza?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "Dobra wiadomość jest taka, że klątwę można cofnąć. Ale potrzebujemy pewnych surowców, które nie są łatwe do zdobycia.\n\nPotrzebujemy naładowanego kryształu kwarcu, eliksiru ponadczasowości i piorunochronu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "Gubernatorze, przez przypadek „znalazłem” jeden z tych kwarców podczas jakiegoś napadu. Niestety mój kumpel Karczycho zabrał go, kiedy podzieliliśmy naszą bandę.\n\nKarczycho ma swój własny obóz bandytów w okolicy.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "Odzyskaj naładowany kwarc z obozu bandytów.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "Gubernatorze, piorunochron można zbudować z normalnych sztabek żelaza i przy użyciu niektórych narzędzi.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "Zbuduj piorunochron.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "Mój panie, mogę przygotować eliksir, jeśli zdobędziesz niezbędne składniki.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "Zdobądź składniki eliksiru.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "Teraz musisz wypić eliksir, trzymając w lewej ręce piorunochron, a w prawej naładowany kwarc. Następnie musisz stanąć na otwartym terenie, aż uderzy w ciebie piorun.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "Przeprowadź rytuał.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "Jesteś ostatnią osobą, po której bym się spodziewał, że uwolni mnie z więzienia. To przez ciebie tam trafiłem.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "Wygląda na to, że masz problem z klątwą. I teraz chcesz mojej pomocy?";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "Panie! Nad naszą osadą zbierają się chmury burzowe. Upewnijmy się, że nasze wieże strażackie pozostaną w gotowości!";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "Gubernatorze, przyjazd do twojej osady jest dla mnie zbyt niebezpieczny. Ale mogę poczynić dla ciebie przygotowania, jeśli będziesz gotów za nie zapłacić…";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "Nie sądzisz, że żołnierze w mieście marnują zbyt wiele cennych surowców? Moglibyśmy je łatwo sprzedać i zarobić trochę na boku. Musisz tylko w jakiś sposób odwrócić uwagę kwatermistrza.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "Zwolnij kwatermistrza z koszar.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "Zwolnij tragarzy z zamku.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "Gubernatorze, moi chłopcy potrzebują spokoju, gdy przebywają pod murami miasta. Rozumiesz, lubią być sami, kiedy „magazynują” towary poza osadą. Najważniejsze, aby strażnicy byli wtedy gdzieś indziej.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "Zwolnij wszystkich żołnierzy.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "Mam mały problem z ludnością w mieście. Bo widzisz, pomagamy im na miejscu, a oni nie chcą płacić za nasze dobre uczynki.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "Zbierz pieniądze za ochronę.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "Gubernatorze, niestety nie zebrałeś wystarczająco dużo pieniędzy, aby pokryć moje „wydatki” w osadzie. Potrzebuję jeszcze reszty pieniędzy. A może sam trochę „zainwestujesz”?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "Moja frakcja chciałaby zorganizować dziś wieczorem w gospodzie mały, „półlegalny” turniej hazardowy. Może zadbasz o dobrą rozrywkę w gospodzie i przyślesz trochę podpiwka i soku?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = "Moi „partnerzy biznesowi” życzą sobie odpowiedniego poczęstunku podczas turnieju hazardowego. Przyślij trochę kiełbasy i chleba, żeby nikt nie głodował, dobrze?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "Dostarcz kiełbasę i chleb.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "Gubernatorze, zwracam się do ciebie z kolejną prośbą. Moje zbiry… to znaczy moi partnerzy biznesowi potrzebują więcej środków wywierania nacisku, aby lepiej wykonywać swoją pracę. Może wyślesz nam trochę uzbrojenia i pancerzy?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "Dostarcz uzbrojenie i pancerze.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "Moi „partnerzy biznesowi” domagają się rozrywek, gubernatorze. Potrzebujemy gospody, żeby trochę odpocząć. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "Witaj, gubernatorze. Dziękuję za poświęcenie czasu na to spotkanie. Jestem przedstawicielem… ekhm… „szemranej” frakcji. Możemy wesprzeć cię w staraniach o reelekcję, ale najpierw musisz wykonać dla nas kilka zadań.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "Gubernatorze, wspierałeś nas, wypełniając nasze zadania, więc teraz nasza kolej, by okazać uznanie.\n\nWyciągnąłeś do mnie pomocną dłoń, a teraz ci się odwdzięczę i zmienię wynik wyborów na twoją korzyść. ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "Ukończ wszystkie zadania dla szemranej frakcji.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = "Wybierz „szemraną” frakcję.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "Współpracuj z klubem przyjaciół kwiatów.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "Współpracuj z gildią kupców.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "Wybierz frakcję wojskową.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "Wybierz frakcję arystokratów.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "Mój panie, powinieneś zdecydować, którą frakcję chcesz wspierać. Po dokonaniu wyboru skoncentruj się na spełnieniu jej wymagań. Gdy przekonasz ich do głosowania na twoją korzyść, będziesz mógł wybrać inną frakcję.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "Złóż wizytę frakcji religijnej.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "Wybierz frakcję pracowniczą.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "Odwiedź zwykłych ludzi.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "Ta osada jest bardzo nijaka. Łatwo zauważyć, że nie zwracasz uwagi na szczegóły i estetykę. Dlaczego nie opracowałeś planu, jak to zmienić, gubernatorze?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "Postaw więcej klombów.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "Gubernatorze, znowu się rozleniwiłeś? Czy nie widzisz, że kwiaty prawie zwiędły? Może powinieneś bardziej dbać o otaczającą cię wspaniałą przyrodę.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "W osadzie śmierdzi, gubernatorze! Tym razem to naprawdę tylko twoja wina. Kanały są zatkane i przepełnione.\n\nZajmij się tym!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "Zbuduj więcej kanałów burzowych.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "Udało się! Nasza osada wreszcie jakoś wygląda, wszędzie kwitną kwiaty, a teraz to?! Spójrz na te domy! To ruiny.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "Gubernatorze, to hańba!\nDzikie zwierzęta zjadły mnóstwo moich najpiękniejszych kwiatów. Jak mogłeś do tego dopuścić?\n\nŻądam natychmiastowego zbudowania nowych chat myśliwskich, aby pozbyć się tych stworzeń z moich klombów.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "Musisz zapewnić wystarczającą liczbę miejsc siedzących z okazji państwowej wystawy ogrodniczej. Kilka starannie rozmieszczonych ławek w osadzie powinno załatwić sprawę.\n\nDopilnuj tego!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "Zbuduj ławki w osadzie.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "Biedne te zwierzęta, gubernatorze.\n\nŚwinie żyją w osadzie w nieludzkich warunkach i nie mogą chodzić tak swobodnie jak powinny.\n\nKlub przyjaciół kwiatów domaga się zniszczenia fermy trzody chlewnej i rzeźni!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "Zburz fermę trzody chlewnej i rzeźnię.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "Gubernatorze, jestem przewodniczącą klubu przyjaciół kwiatów. Domagasz się naszego poparcia w nadchodzących wyborach. A dlaczego tak kompetentna kobieta jak ja nie ma zostać wybrana na gubernatorkę tej osady?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "Pomimo moich początkowych wątpliwości co do twoich kompetencji jako gubernatora, rzeczywiście okazałeś się prawdziwym przyjacielem klubu przyjaciół kwiatów.\nBędziemy na ciebie głosować w wyborach.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "Spełnij wszystkie żądania klubu przyjaciół kwiatów.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "Mój panie, wkrótce w osadzie wybrany zostanie nowy gubernator.\n\nPolecam zacząć przekonywać tutejsze frakcje do głosowania na ciebie. Myślę, że nie mamy wystarczająco dużo czasu, aby zdobyć poparcie ich wszystkich, więc należy rozważnie wybrać, kogo wspierać.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "Właśnie poznaliśmy wynik wyborów, mój panie.\n\nNiestety nie udało nam się zdobyć wystarczającej liczby głosów od frakcji w osadzie.\n\nMamy tydzień na opuszczenie zamku, po czym nowy gubernator przejmie naszą siedzibę…";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "Mój panie, udało nam się przekonać wystarczającą liczbę frakcji w mieście do głosowania na nas. Nasz mandat w tym mieście jest zabezpieczony.\n\nWznieśmy toast za kilka kolejnych lat na tym stanowisku.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "Gubernatorze, wkrótce rozpoczną się wybory. Musimy się spieszyć i przekonać wystarczającą liczbę frakcji do głosowania na ciebie.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "Pozostało: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "Aby wygrać wybory, przekonaj do siebie co najmniej 3 frakcje.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "Mój panie, gildia kupiecka jest oburzona. Nasze targowisko zostało zburzone i już dawno powinno zostać odbudowane.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "Skandal! Tragarze znosili zbyt wiele towarów do budynku gildii kupieckiej. Zawalił się! Jak możemy zarządzać handlem, kiedy cały czas zdarzają się takie rzeczy?\n\nOdbuduj gildię kupiecką.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "Odbuduj gildię kupiecką.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "Cudownie, wasza miłość. Teraz możemy wreszcie wznowić handel. Czy mógłbyś ustawić zlecenie handlowe w gildii kupieckiej? To powinno pomoc naszej osadzie odzyskać należną jej pozycję w regionie.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "Przygotuj aktywne zlecenie handlowe w gildii kupieckiej.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "Pieniądze! Wszystko zawsze sprowadza się do pieniędzy, gubernatorze. Naszym najwyższym priorytetem jest zapewnienie wystarczających zysków z handlu.\n\nZaróbmy trochę pieniędzy, gubernatorze!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "Wolne stragany na naszym targowisku szybko się zapełniają, gubernatorze. Powinieneś rozważyć jego ulepszenie, aby uzyskać więcej miejsca i usprawnić handel.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "Ulepsz targowisko.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "Wielu mieszczan prosi o małe stragany rozsiane po całej osadzie, gubernatorze. W ten sposób moglibyśmy zwiększyć zyski z handlu wewnątrz miasta. Całkiem dobry pomysł, prawda?";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "Ustaw stoiska targowe w osadzie.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "Udostępniłem ci bardzo dochodowy kontrakt handlowy, gubernatorze. Ceny ubrań i podpiwka znacznie wzrosły!\n\nJuż czuję zapach pieniędzy! Mnóstwa pieniędzy!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "Sprzedaj odzież i podpiwek na targowisku.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "Gubernatorze, jestem przedstawicielem gildii kupieckiej. Aby zdobyć głos gildii w nadchodzących wyborach, musisz znacznie poprawić sytuację handlową w mieście.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "Doskonały dzień na handel, mój panie.\n\nUdało ci się sprawić, by ta osada stała się największym ośrodkiem handlowym w regionie. Za to kupcy gildii będą ci na zawsze wdzięczni.\n\nW ramach podziękowania zagłosujemy na ciebie w nadchodzących wyborach.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "Ukończ wszystkie zadania dla gildii kupieckiej.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "To nie do przyjęcia! Absolutnie nie do przyjęcia!\n\nJak mamy zaopatrywać nasze wieże strażnicze, skoro nie mamy w osadzie nawet koszar?\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "Zbuduj koszary.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "Wreszcie mamy gubernatora, który umie sobie radzić. Dobrze byłoby, gdybyś przydzielił kilku żołnierzy do wież strażniczych.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "Jako dowódca uważam, że nie da się dobrze zorganizować naszych sił i znaleźć czasu na odpoczynek po walce. Moje umęczone wojną ciało domaga się kilku wygodnych namiotów oficerskich.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "Postaw kilka namiotów oficerskich.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "Gubernatorze, nasze siły wciąż nie są wystarczająco duże. Każdy podrzędny bandyta będzie się tak śmiać, że narobi w portki, gdy stanie twarzą w twarz z naszą żałosną armią.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "Potrzebujemy zaopatrzenia dla armii, gubernatorze. Najlepszym prowiantem jest kiełbasa. Charakteryzuje się dużą trwałością i można ją łatwo spożywać w terenie.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "Jak nasi dzielni żołnierze mają trenować do nadchodzących bitew, kiedy nie ma na to miejsca, gubernatorze? Jako dowódca sił zbrojnych żądam, abyś zbudował strzelnicę.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "Witaj, gubernatorze. Szukasz poparcia frakcji wojskowej w nadchodzących wyborach.\n\nCóż, masz wiele do zrobienia, zanim przekonasz nas do głosowania na ciebie.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "Ogromnie dziękuję, gubernatorze. Sprawiasz, że my, zwykli żołnierze, jesteśmy dumni z twoich czynów. Wojsko w tej osadzie nie było zbyt ważne, dopóki nie zostałeś naszym gubernatorem. Zasłużyłeś na nasz głos w wyborach.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "Ukończ wszystkie zadania dla frakcji wojskowej.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "Żadna większa osada nie powinna oferować swoim mieszkańcom tak ograniczonej selekcji napitków, mój panie. Szczególnie my, szlachcice, pragniemy czegoś ekstrawaganckiego, takiego jak sok winogronowy.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "Szlachta świętuje ukończenie twojego najnowszego łańcucha produkcyjnego, mój panie.\n\nBędziemy do tego potrzebować dużej ilości soku winogronowego. Tylko proszę, nie tych tanich pomyj…";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "Mój panie, chyba nie sugerujesz, żebyśmy chodzili do gospody jak zwykli plebejusze. Plac turniejowy poza murami miasta od lat stoi w ruinie.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "Zmarł wielki bohater dla szlachty, mój panie. Gdybyś zbudował mu monument i godne miejsce spoczynku, uszczęśliwiłbyś wielu szlachciców w tej osadzie.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "Zbuduj mauzoleum i pomnik dla bohatera.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "Mój panie, w tej osadzie brakuje cennych towarów dla szlachty. Nie można odpowiednio obnosić się ze swoim wysokim statusem bez cennej biżuterii, wasza miłość.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "Cudownie, wasza miłość. Popyt na biżuterię jest w tej chwili bardzo wysoki. Każdy pragnie mieć takie klejnoty jak ludzie na dworze.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "Jak wspaniale jest cię wreszcie poznać, wasza miłość. Reprezentuję frakcję szlachty w twojej osadzie. Jeśli chcesz uzyskać nasze poparcie w nadchodzących wyborach, musisz spełnić nasze ekstrawaganckie żądania.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "Udało ci się spełnić wszystkie żądania szlachty, wasza miłość. W twojej osadzie szlachta posiada takie same przywileje, jak na dworze królewskim. Wiele zrobiłeś dla tej osady!\nUzyskasz nasz głos w nadchodzących wyborach.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "Spełnij wszystkie żądania szlachty.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "Nasza wspólnota religijna stale się kurczy. Ludność spędza czas na piciu lub imprezowaniu. To musi się skończyć.\n\nWinna jest ta grzeszna gospoda. Musisz ją zburzyć! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "Bardzo dobrze! To bluźniercze miejsce powinno było zostać zburzone już dawno temu. W końcu ktoś zebrał się na odwagę.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "Zburz gospodę.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "Nasz kościół nie radzi sobie z takim przypływem nowych wiernych. Odkąd gospoda została zburzona, kościół jest nadmiernie przepełniony.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "Chwała Panu, jaki wspaniały nowy kościół. Zostałeś nam zesłany przez Boga, zarządco.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "Ulepsz kościół lub zbuduj nowy.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "Nasza wspólnota religijna jest nadal niezadowolona z dostępu do religii w osadzie. Ludność powinna być bardziej zadowolona z religii!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "Udało ci się, zarządco. Nie popełniłem błędu, pokładając w tobie wiarę. Na nowo uszczęśliwiłeś wspólnotę religijną.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "Moi współbracia skarżą się na braki w produkcji chmielu w mieście. My, mnisi, nie jesteśmy w stanie wyprodukować podpiwka bez niezbędnej ilości chmielu.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "Zbuduj suszarnię chmielu.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "Teraz, gdy produkcja chmielu znów rośnie, powinieneś rozważyć zwiększenie produkcji podpiwka.\n\nUlepsz klasztor. Możesz też zbudować nowy.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "Nowy klasztor promienieje blaskiem naszego Pana. Dobra robota, gubernatorze.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "Ulepsz klasztor lub zbuduj nowy.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "Na uroczystość inauguracji nowego klasztoru powinniśmy wyprodukować sporą ilość podpiwka. Nasi goście będą spragnieni.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "Proces warzenia dobiegł końca, gubernatorze. Czy zechcesz wziąć pierwszy, zaszczytny łyk?";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "Cmentarz miejski jest zdecydowanie za mały i nie ma na nim miejsca na groby. Musisz zlecić budowę kilku nowych mauzoleów i grobowców.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "Powiększ cmentarz: zbuduj mauzolea i grobowce.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "Powiększenie cmentarza powinno obejmować budowę nowego płotu cmentarnego. Zleć budowę nowego płotu, aby wyraźnie zaznaczyć teren cmentarza.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "Zbuduj nowy płot cmentarny.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "Witaj, gubernatorze. My, mnisi z frakcji religijnej, moglibyśmy wesprzeć cię w nadchodzących wyborach, jeśli spełnisz nasze żądania.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "Chwalmy Pana, gubernatorze. Spełniłeś wszystkie nasze wymagania. Z pewnością zasłużyłeś na miejsce w niebie, a i głos frakcji religijnej będzie twój.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "Ukończ wszystkie zadania dla frakcji religijnej.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "Mój panie, strażacy mają ograniczone możliwości walki z pożarami wybuchającymi w mieście. Bardzo by pomogło, gdybyśmy mieli do dyspozycji więcej wież strażackich.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "Niektórzy członkowie frakcji pracowniczej chcieliby zobaczyć w mieście obóz żonglera. Dzięki temu nawet my będziemy mieli się z czego pośmiać.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "Szanowny gubernatorze, tragarze są naprawdę przepracowani z powodu natłoku zleceń transportowych w osadzie. Bardzo by nam pomogło, gdybyś zlecił budowę większej liczby magazynów.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "Mój panie, cieśle narzekają na swoje ubrania. Ilość napraw w mieście powoduje duże zużycie ich odzieży. Naprawdę potrzebują nowych ubrań.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "Dostarcz odzież.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "Mój panie, nasi tragarze potrzebują nowych butów. Nie musisz zlecać ich produkcji, możemy to zrobić sami.\n\nPotrzebujemy tylko wyprawionej skóry i tkanin.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "Przekaż tkaniny i wyprawioną skórę.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "Mój panie, niewielka darowizna na rzecz naszej frakcji pracowniczej pomogłaby nas przekonać, że jesteś najbardziej życzliwym gubernatorem wszech czasów.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "Przekaż pracownikom monety.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "Gubernatorze, poborcy podatkowemu naprawdę przydałby się dzień wolny. Nie jest już najmłodszy, a poza tym bolą go kości.\n\nChyba zdołasz przez jakiś czas osobiście zbierać podatki, prawda?";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "Zwolnij poborcę podatkowego i osobiście zbieraj podatki.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "Mój panie, reprezentuję frakcję pracowniczą w twojej osadzie.\n\nJesteśmy tragarzami, strażakami, stolarzami i poborcami podatkowymi. Mamy prawo głosu i możesz zdobyć nasze poparcie, ułatwiając nam odrobinę życie.";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "Zrobiłeś dla nas wiele dobrego, panie. To początek złotych czasów dla pracowników. Nigdy nie sądziliśmy, że faktycznie poprawisz naszą jakość życia w osadzie.\n\nMożesz na nas liczyć podczas wyborów!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "Ukończ wszystkie zadania dla frakcji pracowniczej.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "Mój panie! W osadzie rozprzestrzenia się zaraza. Proszę, musisz nam pomóc! Moje dzieci przebywają w dotkniętej chorobą dzielnicy, a w osadzie nie ma lecznicy.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "Gubernatorze, zaopatrzenie w żywność w mieście jest niewystarczające. Rolnicy zgłaszają, że brakuje nam podstawowych budynków. Powinieneś zlecić budowę nowego gospodarstwa i piekarni.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "Zbuduj gospodarstwo i piekarnię.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "Mój panie, my, zwykli ludzie, nie mamy się z czego pośmiać, a nasza codzienna rutyna jest wyczerpująca. Byłoby naprawdę miło mieć miejsce, w którym moglibyśmy zapomnieć o naszych smutkach. Idealny byłby jarmark.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "Mój panie, większość ludności żyje w ubóstwie. Możesz podnieść swoją renomę, oddając część podatków ludziom.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "Zwróć część podatków ludziom.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "Teraz, gdy posiadamy już niezbędną infrastrukturę, powinniśmy zapewnić społeczeństwu większą różnorodność żywności. Większość mieszczan żyjących w biedzie nie spożywa mięsa na kolację. Możesz to zmienić.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_TITLE" = "Dostarcz mięso.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_DESC" = "Mój panie, zbieramy pszenicę, mielimy ją i pieczemy chleb. Rzadko jednak mamy okazję zobaczyć ten chleb na własnych talerzach.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_TITLE" = "Dostarcz chleb.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_07_DESC" = "Mój panie, już prawie udało ci się zdobyć nasze całkowite poparcie. Pozostało ci tylko zadbać o zwiększenie szczęścia wszystkich mieszczan. Odwdzięczymy się za to wyższą produktywnością.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_START" = "Witaj, gubernatorze. Jako młynarz jestem głosem zwykłych rolników. Jeśli zdołasz ułatwić nam życie w osadzie, zagłosujemy na ciebie w wyborach.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_SUCCESS" = "Zaprawdę jesteś człowiekiem ludu, mój panie. Bardzo pomogłeś zwykłym ludziom, wykonując nasze zadania. Teraz życie w osadzie stało się o wiele łatwiejsze. Dziękuję ci, mój panie.\n\nMożesz liczyć na to, że zagłosujemy na ciebie w wyborach.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_TITLE" = "Ukończ wszystkie zadania dla rolników.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_DESC" = "Mój panie, w naszej gospodarce nie ma miejsca dla cieśli. Nie posiadamy niezbędnych surowców. Na razie powinieneś zwolnić cieślę z jego budynku.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_TITLE" = "Zwolnij cieślę.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_02_DESC" = "Nie produkujemy wystarczającej ilości żywności, mój panie. Wskazane byłoby wybudowanie jeszcze kilku chat rybackich.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_03_DESC" = "Zanim wybierzemy jedną z miejskich frakcji, warto zlecić budowę tartaku. Jest to niezbędne dla rozwoju gospodarki miasta, mój panie.";
"T_SCENARIO_7_QUEST_INTRO_DESC" = "Mój dobry zarządco, moja córka ma wyjść za mąż za księcia Williama Clemensa III z Giebelstadt. Chcę, żebyś zajął się wszystkimi przygotowaniami do tej ważnej ceremonii. Nie masz na to zbyt wiele czasu, więc lepiej się pośpiesz. Pokładam w tobie pełne zaufanie!";
"T_SCENARIO_7_QUEST_INTRO_NAME" = "Przygotuj wielkie wesele, wykonując wszystkie zadania!";
"T_SCENARIO_7_QUEST_OUTRO_DESC" = "Dziękuję za twoje pełne zaangażowanie! Wykonałeś fantastyczną robotę, a wesele może się teraz rozpocząć! I oczywiście jesteś zaproszony!";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_DESC" = "Bandyci rozpoczną wkrótce atak, powinniśmy być przygotowani. Obsadź wieże strażnicze.";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_NAME" = "Atak bandytów jest nieunikniony!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_DESC" = "Mój panie, gospodarka miasta jest w ruinie z powodu ciągłych ataków bandytów. Mam nadzieję, że zdołamy wytrzymać oblężenie.";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_END" = "Świetna robota, mój panie! Całkiem dobrze poradziłeś sobie z oblężeniem, a dodatkowo udało ci się zbudować prężnie działającą gospodarkę. Najwyraźniej zaimponowałeś nawet rycerzowi. ";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_NAME" = "Stwórz infrastrukturę, broniąc równocześnie osady.";
"T_SCENARIO_BESIEGEMENT_QUEST_01_DESC" = "Tylko gubernator i jego doradca? Nie na taką pomoc liczyłem. Nie sądzę, że będziesz szczególnie przydatny w obronie przed bandytami. Wszyscy inni do broni!";
"T_SCENARIO_BESIEGEMENT_QUEST_01_END" = "Fala bandytów została odparta. Teraz możemy trochę odpocząć, aż nasi zwiadowcy wykryją kolejny atak.";
"T_SCENARIO_BESIEGEMENT_QUEST_02_2_DESC" = "Potrzebujemy więcej wież strażniczych do obrony osady. Zbuduj je natychmiast!";
"T_SCENARIO_BESIEGEMENT_QUEST_02_DESC" = "Gubernatorze, może w końcu się do czegoś przydasz i wydasz rozkaz budowy większej liczby wież strażniczych?";
"T_SCENARIO_BESIEGEMENT_QUEST_03_DESC" = "Zawaliły się nasze koszary, powinniśmy zbudować nowe. Myślę, że poradzisz sobie z tym zadaniem, gubernatorze.";
"T_SCENARIO_BESIEGEMENT_QUEST_04_DESC" = "Proponuję wysłać posłańca do króla, mój panie. Ale będziemy potrzebować przebrania. Zacznijmy od tkanin.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_DESC" = "Teraz potrzebujemy trochę wyprawionych skór na przebranie, aby bardziej przypominało ubiór bandyty.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_NAME" = "Dostarcz wyprawioną skórę.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_DESC" = "Brodę stworzymy z wełny. Mam nadzieję, że zwiększy to szanse posłańca na dotarcie do króla.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_NAME" = "Dostarcz wełnę.";
"T_SCENARIO_BESIEGEMENT_QUEST_07_DESC" = "Nie możemy tak po prostu siedzieć i czekać na wsparcie króla. Pancerze straży miejskiej są w złym stanie, musimy wyprodukować nowe, aby osada była odpowiednio broniona. ";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_DESC" = "O nie, mój panie. Zniszczyli nasze koszary. Powinniśmy je odbudować, aby zapewnić naszym żołnierzom zaopatrzenie.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_NAME" = "Odbuduj koszary.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_DESC" = "Bandyci przygotowują się do masowego szturmu na nasze koszary. To niezwykle ważny budynek i nie może zostać zniszczony!";
"T_SCENARIO_BESIEGEMENT_QUEST_08_NAME" = "Obroń koszary.";
"T_SCENARIO_BESIEGEMENT_QUEST_09_DESC" = "Armia króla jeszcze nie przybyła. Nie możemy dłużej czekać. Potrzebujemy najostrzejszych mieczy, jakie jesteśmy w stanie wyprodukować, inaczej osada upadnie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_DESC" = "Gubernatorze, obóz bandytów na południowym wschodzie blokuje drogę do innych osad. Jeśli chcemy, żeby więcej mieszczan nam pomagało, musimy zniszczyć obóz na południowym wschodzie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_END" = "Obóz bandytów został zniszczony! Więcej mieszczan będzie mogło nas wspomóc.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "Zniszcz obóz bandytów na południowym wschodzie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "Udało nam się zlokalizować kupca, mój panie. Jest uwięziony w obozie w pobliżu rzeki na północnym zachodzie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "Mój panie, kupiec jest już bezpieczny. Odtąd będzie nas ponownie regularnie odwiedzał.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_NAME" = "Zniszcz obóz bandytów na północnym zachodzie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_DESC" = "Mój panie, bandyci zaopatrują się w hubki w obozie w górach na północnym wschodzie. Jeśli go zniszczymy, nie będą już w stanie podpalać naszych budynków.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_NAME" = "Zniszcz obóz bandytów na północnym wschodzie.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_DESC" = "Główny obóz bandytów znajduje się na południowym zachodzie. Zniszczmy go w końcu, a zmusimy bandytów do kapitulacji. Do ataku!";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_NAME" = "Zniszcz obóz bandytów na południowym zachodzie.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_DESC" = "Co za grubiański rycerz. Mój panie, gospodarka w tej osadzie jest w zasadzie zrujnowana. Kiedy nasi żołnierze odeprą pierwsze fale bandytów, powinniśmy nakazać ludności produkcję podstawowych surowców.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_NAME" = "Wyprodukuj deski.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_02_DESC" = "Bardzo dobrze, mój panie. Powinniśmy zacząć odbudowę gospodarstwa, bo brakuje nam żywności.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_DESC" = "Możemy znowu produkować chleb. Powinniśmy jednak pilnować atakujących bandytów i zaciągać ludność do wojska, gdy będzie to konieczne.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_NAME" = "Wypiecz chleb.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_11_DESC" = "Mój gubernatorze, moglibyśmy zwiększyć skuteczność żołnierzy, dostarczając im podpiwek.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_12_DESC" = "Możemy jeszcze bardziej zwiększyć siłę bojową żołnierzy, mój panie. Potrzebujemy tylko paru kiełbas.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_DESC" = "Praca i walka przez cały dzień są dla nas bardzo męczące. Czy możemy sobie zrobić małą przerwę, mój panie? Byłoby wspaniale, gdyby cała osada dostała dzień wolny.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_NAME" = "Zadbaj o to, aby żaden mieszczanin nie miał przydzielonych zadań.";
