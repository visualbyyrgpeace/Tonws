"T_MAIN_MENU_TOUCH_TO_CONTINUE" = "Stuknij, aby kontynuować";
"T_MAP_CANALGRANDE_DESC" = "Laguna z mnóstwem małych wysepek to idealne miejsce do zbudowania osady z wieloma mostami i licznymi kanałami.";
"T_MAP_COASTALISLAND_DESC" = "W tej zatoce leży sielska wyspa. Czy w tak odległym miejscu uda się założyć osadę o realnym znaczeniu?";
"T_MAP_COASTSANDCLIFFS_DESC" = "Z zamku, który stoi na szczycie klifu, rozpościera się widok na ocean. Na pobliskich płaskowyżach można wznieść urokliwą przybrzeżną osadę.";
"T_MAP_COASTSANDCLIFFS_NAME" = "Klify i wybrzeże";
"T_MAP_DESC_10" = "Ta bujna dolina doskonale nadaje się do budowy kwitnącej osady.";
"T_MAP_DESC_11" = "Ta mapa została stworzona w celu testowania wydajności na różnych urządzeniach. Na całej jej powierzchni rozciąga się bardzo duże miasto.";
"T_MAP_DESC_12" = "Falujące, krystalicznie czyste wody rzek w tym regionie zachęcają mieszczan do wędkowania lub kąpieli.";
"T_MAP_DESC_13" = "Mała wioska pod zacienionym płaskowyżem może przerodzić się w ogromne miasto.";
"T_MAP_DESC_14" = "Królestwo cierpi z powodu suszy. Rzeka wyschła. To sprawia, że uprawa ziemi i żywienie twoich mieszczan jest trudnym zadaniem.";
"T_MAP_DESC_15" = "Zbuduj prężną placówkę handlową na płaskowyżu. Czekają na ciebie lukratywne interesy z kupcami i rycerzami.";
"T_MAP_DESC_16" = "Załóż kolonię górniczą i dostarcz surowce na budowę monumentalnej katedry.";
"T_MAP_DESC_17" = "Przygotuj się na wielkie królewskie wesele.";
"T_MAP_DESC_18" = "Zbuduj duże miasto w pobliżu wyschniętego koryta rzeki, ale pamiętaj, że woda jest na tym terenie towarem deficytowym.";
"T_MAP_DESC_19" = "Na skraju bagien znajduje się niewielki płaskowyż. To idealne miejsce na osadę.";
"T_MAP_DESC_2" = "To spokojne miejsce na wybrzeżu jest idealnym miejscem na założenie osady.";
"T_MAP_DESC_20" = "Odosobniony region górski pośrodku niczego. Brak wody, ale za to niezliczone żyły rudy. Idealne miejsce, by się wzbogacić!";
"T_MAP_DESC_2016_01" = "Król potrzebuje mnóstwa desek, aby zbudować wielką flotę. Dowiedz się, dlaczego ich dostawa została wstrzymana i załóż gildię kupiecką.";
"T_MAP_DESC_2016_02" = "Ten piękny region to idealne miejsce na budowę dużego miasta. Rozległe wzgórza zapewniają dużo miejsca dla niezliczonych budynków.";
"T_MAP_DESC_2016_03" = "Mała osada stała się wielką metropolią. Spełnij pragnienia i potrzeby mieszczan w wyznaczonym czasie.";
"T_MAP_DESC_2016_04" = "Rozważnie przydzielaj mieszczan do różnych prac, aby zbudować targowisko i gospodę.";
"T_MAP_DESC_2016_05" = "Dobrze zaplanuj swoje miasto, bo między wodospadami nie ma zbyt dużo miejsca na budynki, a poruszanie się po okolicy może być trudne.";
"T_MAP_DESC_2016_06" = "W okolicy zdarzają się potężne lawiny. Ale tak poza tym to warto założyć tutaj małą osadę i wykorzystać bogate złoża rudy.";
"T_MAP_DESC_2016_08" = "Zbuduj swoją osadę w kanionie. Możesz tu znaleźć wszystko, czego potrzebujesz, choć niektóre obszary są trudno dostępne.";
"T_MAP_DESC_2016_09" = "Przekrocz rzekę, aby dotrzeć do surowców potrzebnych twojemu miastu.";
"T_MAP_DESC_2016_10" = "Zaoszczędź trochę monet. Ale uważaj, bo bandyci mają w okolicy swoją kryjówkę. Stanowią oni zagrożenie, a w dodatku nieszczęśliwi mieszczanie nie będą płacić podatków.";
"T_MAP_DESC_21" = "Załóż osadę na pięknej ukrytej wyspie i ciesz się świeżym morskim powietrzem!";
"T_MAP_DESC_21_NOBANDITS" = "Załóż osadę na pięknej ukrytej wyspie i ciesz się świeżym morskim powietrzem!";
"T_MAP_DESC_22" = "Pomóż swojej osadzie przetrwać bezlitosną zimę.";
"T_MAP_DESC_23" = "Musisz bardzo szybko zbudować funkcjonującą osadę na tej zamarzniętej równinie, aby nie głodować w zimie.";
"T_MAP_DESC_24" = "Wspieraj króla w jego przedsięwzięciu budowy wielkiej floty okrętów, jednocześnie utrzymując pod kontrolą rosnące wzburzenie mieszkańców osady.";
"T_MAP_DESC_25" = "Podczas zakładania osady wykorzystaj okoliczne lasy w tym regionie na swoją korzyść. Brakuje tu wody, więc nie można polegać na rybołówstwie.";
"T_MAP_DESC_26" = "Król podjął wyzwanie i teraz twoim zadaniem jest zbudowanie wielkiego miasta, zanim zrobi to arcyksiążę. Nie masz zbyt dużo czasu na wykonanie wszystkich zadań. Nie zawiedź go!";
"T_MAP_DESC_27" = "Okoliczne bagna utrudniają znalezienie odpowiednich terenów pod budowę. Pamiętaj o skutecznym wykorzystaniu dostępnego miejsca!";
"T_MAP_DESC_28" = "Skalista dolina z mnóstwem surowców, ale z bardzo ograniczonym miejscem na budynki.";
"T_MAP_DESC_29" = "Ten mały archipelag niełatwo będzie skolonizować.";
"T_MAP_DESC_29_NOBANDITS" = "Ten mały archipelag niełatwo będzie skolonizować.";
"T_MAP_DESC_3" = "To jest mapa do nauki. Poznasz tutaj tajniki świata „Townsmen”.";
"T_MAP_DESC_30" = "Zbuduj osadę wokół swojej górskiej twierdzy. Byle ostrożnie, bo nadchodzi długa zima.";
"T_MAP_DESC_31" = "Król odwiedzi swoje włości. Przygotuj się na jego przybycie.";
"T_MAP_DESC_32" = "Zbliżają się urodziny króla. Musisz poszukać receptury idealnego podpiwka na prezent. Może mnisi w klasztorze ci w tym pomogą…";
"T_MAP_DESC_33" = "Król cierpi na tajemniczą chorobę. Musisz go wyleczyć i dowiedzieć się, jakie było jej źródło.";
"T_MAP_DESC_34" = "Tutejsze tereny są ogarnięte wojną. Musisz założyć dobrze prosperującą osadę z dala od frontu i wesprzeć armię króla.";
"T_MAP_DESC_35" = "Król chce być przygotowany na ciężkie czasy, a twoja osada została wybrana, by dostarczyć mu żądane towary.";
"T_MAP_DESC_36" = "Poznaj tajniki działań wojennych od weterana.";
"T_MAP_DESC_37" = "Spełnij życzenia swojej żony, rozprawiając się przy tym z szantażującym cię bandytą.";
"T_MAP_DESC_4" = "Twój zamek znajduje się na małej wyspie rzecznej. Mądrze wykorzystaj okoliczne brzegi rzeki i stwórz kwitnącą gospodarkę.";
"T_MAP_DESC_6" = "Zbuduj niewielką osadę nad brzegiem pięknego jeziora.";
"T_MAP_DESC_7" = "Twoja osada została wybrana przez króla jako gospodarz największego turnieju w regionie!";
"T_MAP_DESC_8" = "Nadchodzi zima! Pomóż swoim mieszczanom przygotować się do tej mroźnej pory roku!";
"T_MAP_DESC_9" = "Wesprzyj swoją żonę i spraw, aby gospodarka podupadłej osady znów rozkwitła!";
"T_MAP_DESC_APOCALYPSE" = "Miasto cierpi z powodu klątwy. Dziwne choroby i katastrofy prześladują mieszkańców. To do ciebie należy znalezienie sposobu na jak najszybsze jej przełamanie. Bez względu na koszty…";
"T_MAP_DESC_FESTIVITIES" = "Król ponownie się ożenił. Aby uczcić jego nową żonę, musisz przygotować kilka sezonowych festynów. Ich zaplanowanie i zorganizowanie może się jednak okazać trudne. To będzie wyścig z czasem…";
"T_MAP_DESC_ICYHOLD" = "Wysoko na klifie stoi lodowa forteca. Jest trudno dostępna, ale po zdobyciu pozwala zajrzeć w głąb mroźnej tundry. Zima na tym terenie jest bardzo długa!";
"T_MAP_DIPLOMATICVISIT_DESC" = "Królowa sojuszniczego kraju odwiedza miasto. Ma dojść do podpisania lukratywnych umów handlowych, ale istnieje pewna bariera językowa, którą trzeba najpierw pokonać.";
"T_MAP_DIPLOMATICVISIT_NAME" = "Wizyta dyplomatyczna";
"T_MAP_DIVIDEDSHORELINE_DESC" = "Twoje terytoria dzieli na pół majestatyczna góra. Dodatkowo możesz wyruszyć na podbój wyspy nieopodal zamku.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "Podzielona linia brzegowa";
"T_MAP_FRIGYTHKINGDOM_DESC" = "Królowa Frygith szuka gubernatora, który pokieruje częścią jej królestwa. Zbuduj w nowej krainie wspaniałe miasteczko.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "Królestwo Frygith";
"T_MAP_FROZENFRONT_DESC" = "Po ostatniej wojnie większość miasta nadal leży w ruinie. Pokryte śniegiem pozostałości miasta wyznaczają teraz miejsce, w którym doszło do wielkiej bitwy. Nadszedł czas na odbudowę osady.\n\nNa tej mapie panuje wieczna zima!";
"T_MAP_HIGHLANDS_DESC" = "W tej krainie leżą liczne góry i wzniesienia. Ze szczytów rozpościera się cudowny widok.";
"T_MAP_HIGHLANDS_INTRO" = "Witamy na wyżynach, gubernatorze. To kraina pełna tajemnic, ale jestem pewna, że jeśli otoczysz jej mieszkańców opieką i poświęcisz im uwagę, z chęcią odkryje przed tobą wszystkie swoje sekrety.";
"T_MAP_HIGHLANDS_NAME" = "Wyżyny";
"T_MAP_INSANECHOICES_DESC" = "Zostajesz wezwany do osady, której książę wydaje się szalony. Mieszczanie odmawiają płacenia podatków!\nKażdy dokonany wybór doprowadzi cię do innego zakończenia.";
"T_MAP_INSANECHOICES_NAME" = "Szalone decyzje";
"T_MAP_LEGACY_DESC" = "Król ma dla ciebie nowe zadanie. Starzeje się i obawia, że odejdzie z tego świata, nie pozostawiając po sobie żadnej spuścizny. Zależy mu, żeby przekazać przyszłym pokoleniom, czego nauczył się jako władca.";
"T_MAP_LEGACY_NAME" = "Dziedzictwo";
"T_MAP_LOWLANDS_DESC" = "Rozległe równiny i mnóstwo miejsca na rozbudowę, aż po horyzont. Tu można wznieść prawdziwą metropolię.";
"T_MAP_LOWLANDS_NAME" = "Niziny";
"T_MAP_MARSH_DESC" = "W tym regionie podmokłe stepy stanowią podstawę biologicznej różnorodności. ";
"T_MAP_MARSH_INTRO" = "Mój panie, spójrz tylko na idealną równowagę między lądem a wodą. Z radością witam cię w tym spokojnym miejscu.\n\nNasi mieszkańcy będą świadkami twoich starań, by nasza kraina stała się wspaniałym miejscem!";
