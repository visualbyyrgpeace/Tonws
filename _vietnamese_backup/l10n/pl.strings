"T_MAP_NAME_2016_02" = "Rozległe wzgórza";
"T_MAP_NAME_2016_03" = "Szlaki wodne";
"T_MAP_NAME_2016_04" = "Wyzwanie dla rzemieślników";
"T_MAP_NAME_2016_05" = "Wodospady";
"T_MAP_NAME_2016_06" = "Zagrożenie lawinowe";
"T_MAP_NAME_2016_08" = "Kanion";
