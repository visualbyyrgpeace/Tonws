"BUILDING_UPGRADE_TAXBONUS" = "Premia za podatki";
"EVENT_WITCHHUNT_08_SUCCESS" = "Nareszcie mamy w osadzie lekarza. Z pewnością pomoże nam z chorobą.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Poczekaj, aż lekarz powróci ze stolicy.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Mieszkańcy miasta byliby szczęśliwsi, gdyby mieli wspólne miejsce, w którym mogliby się spotkać i napić soku winogronowego lub popijać sobie podpiwek po ciężkim dniu pracy. Czy taka prośba to przesada, mój panie?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Podnieś poziom zadowolenia społeczności.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Dobra, gubernatorze. Skoro nie chcesz ze mną handlować, to moi ludzie po prostu wezmą sobie to, czego potrzebują.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Tym razem ci się poszczęściło, ale następnym nie będzie tak łatwo.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ha, ha, ha. Niech to będzie dla ciebie nauczką. Następnym razem z pewnością wybierzesz handel.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Potrzebuję wielu kamieni, waszmości. Jeśli mi je zapewnisz, wspomogę cię drewnem.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Udało mi się zebrać trochę drewna, aby wesprzeć budowę osady, mój panie. Wymienię je na trochę pszenicy.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Moja córka strasznie zmarzła ostatniej nocy. Czy możesz wesprzeć nas odrobiną wełny? W zamian podaruję ci cenne drewno.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Mam pytanie, waszmości… Mój syn chce się nauczyć fachu garbarza i potrzebuje skór, na których mógłby poćwiczyć. W zamian mogę podarować drewno.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Czy posiadasz może jakieś przyprawy, mój panie? Ja niestety nie, a chcę przyprawić swoje mięso.\nW zamian przekażę ci moje najlepsze drewno.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Chcę wyremontować swój dom, mój panie. Czy zechcesz wymienić trochę narzędzi na mój ostatni stos drewna opałowego?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Chcę przygotować ucztę, mój panie. Wspomożesz mnie? W zamian podaruję ci trochę drewna.";
"SCENARIO_CW_QUEST_B_NAME" = "Wymiana z rolnikiem.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Moja rodzina odczuwa głód, mój panie. Czy zdołasz dostarczyć nam kilka ryb? W zamian podaruję ci trochę drewna z moich skromnych zapasów drewna opałowego.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Posiadam niewielki zapas drewna remontowego. Wymienię je za trochę kamienia, mój panie.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Moi ludzie potrzebują ryb. Dostarcz je, a w zamian otrzymasz drewno! Przy okazji oszczędzę twoją osadę.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Hej, gubernatorze! Wyświadczę ci przysługę i zabiorę trochę ciężkich kamieni z twojego magazynu. Jeśli mi na to pozwolisz, w zamian otrzymasz trochę drewna.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Nie marnuj pszenicy, rozdając ją swoim rolnikom. Zamiast tego daj ją mnie, a otrzymasz moje najlepsze drewno.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Chcemy owinąć rękojeści naszych mieczy wełną, by były miększe. Bez obaw, nie użyjemy ich przeciwko tobie, jeśli będziesz współpracować.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Moi ludzie się nudzą. Jeśli zapewnisz nam jakieś skóry, ulepszymy nasze kukły treningowe, aby bardziej przypominały ludzi. A jeśli nie zechcesz ze mną handlować, to poćwiczymy na twoich poddanych.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Jeden z moich ludzi zachorował. Podobno pomogą mu jakieś zioła. Jeśli nie masz nic przeciwko, poszukam ich w twoim magazynie. Z pewnością coś znajdę.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Nasze narzędzia nie nadają się już do użytku, a ty masz ich pełno, gubernatorze. Wykaż się uprzejmością i mi je przekaż, a ja wykażę się uprzejmością i nie wezmę ich siłą.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Moi ludzie mają ochotę na mięso. Oddaj je nam, a ja uprzejmie podaruję ci w zamian drewno.\n\nOdmów, a być może moi ludzie odwiedzą twoją osadę i sami je sobie wezmą…";
"SCENARIO_CW_QUEST_C_NAME" = "Wymiana z bandytą.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ach, nowy gubernator…\nSkoro dopiero się aklimatyzujesz, to wyjaśnię ci zasady. Będziesz spełniać moje żądania, a zostawię cię w spokoju.\n\nBrzmi uczciwie, nie? No dobrze, zacznijmy od czegoś prostego: dostarcz mi trochę ryb!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Problemy z drewnem? Żaden problem!\nUkra… to znaczy ukryłem ogromny zapas drewna. Podaruj mi trochę kamieni, a chętnie ci je przekażę.";
"SCENARIO_THIEF_FAIL" = "Naprawdę nie chcesz ze mną handlować, co?\n\nNo to sprawdzimy, jak na tym wyjdziesz.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Mój panie, zobacz, co tu mamy… To chyba ząb. I to nie ludzki. I jeszcze tu! Więcej trufli. Brakuje mi paru informacji, by wysnuć sensowną teorię, ale znam kogoś, kto może nam pomóc. Spotkajmy się ze starcem!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "Kto, jak nie kupiec, żywiłby do miejscowych tyle żalu? To on jest wspólnikiem!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "Kupiec!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "To pewnie ta młoda kobieta! Jest siostrą wygnanej mieszczanki. Jej motywacja wydaje się jasna!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "Młoda kobieta!";
"THEBEAST_CHOICE_A_REASON_DESC" = "Ataków dokonywała młoda kobieta, która została niesłusznie wygnana przez królową. Była żądna zemsty za swoją banicję.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "V jak vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "Próba pogodzenia starych mieszkańców osady z nowymi spaliła na panewce…\nPewnie nie widział w tym nic złego. Chciał tylko pomóc sąsiadom.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "Hector, artysta!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "Na pewno on! Nienawidzi przybyszów i zaatakował siostrę wygnanej kobiety, by nikt więcej nie szkodził jego winnicy.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Rolnik Basil.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Sprawca chciał przerazić mieszczan, nakłonić ich do wyprowadzki i zapobiec napływowi kolejnych osadników.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "Chodziło o zniechęcenie przybyszów do osiedlenia się w osadzie!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Musiała pomóc sprawcy finansowo.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "Królowa Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "To był piekarz! Udawał, że go zaatakowano, by uniknąć podejrzeń! Co za geniusz!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "Piekarz.";
"THEBEAST_CHOICE_C_REASON_DESC" = "Królowa Frygith żałuje decyzji o otwarciu granic, więc spiskowała z mieszkańcami, aby przerazić przybyszów i ponownie zamknąć granice!";
"THEBEAST_CHOICE_C_REASON_TITLE" = "Ogólnopaństwowy spisek.";
