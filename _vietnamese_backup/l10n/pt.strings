"T_MAP_THE_WATERFALLS_INTRO" = "Governador, este é um dos locais mais bonitos de todo o meu reino. Que você possa governar estas terras em meu nome. Cuide bem delas. Tenho certeza que logo você ajudará esta pequena aldeia a chegar ao seu potencial.";
"T_MAP_THE_WATERFALLS_NAME" = "As Cachoeiras";
"T_MAP_TWELVE_DESC" = "A sua popularidade na cidade caiu. As pessoas o detestam!\n\nFaça os habitantes voltarem a amar seu governador! Conclua as doze tarefas lendárias sem fracassar!";
"T_MAP_TWELVE_NAME" = "As Tarefas Lendárias";
"T_MAP_WASTELAND_DESC" = "Não cresce praticamente nada nesta desolação. A inexistência de rios ou lagos torna o desenvolvimento ainda mais difícil. Será possível construir uma cidade que floresça aqui? \nNeste mapa, é sempre outono.\n";
"T_MAP_WASTELAND_NAME" = "Desolação";
