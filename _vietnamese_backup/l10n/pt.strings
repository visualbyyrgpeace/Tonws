"T_GAME_BUILDING_INFO_PUBLIC_UPGRADE2_DEPRECATED" = "O upgrade de nível 3 aumenta a capacidade dum prédio e diminui pela metade a taxa de degradação. No entanto, você gasta muito mais ouro e recursos para restaurar um prédio com upgrade.";
"T_GAME_BUILDING_INFO_ROAD" = "Estrada de terra";
