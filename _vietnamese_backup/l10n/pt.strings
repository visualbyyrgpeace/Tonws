"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Muito bom, meu senhor. Os recursos necessários logo devem estar no estoque.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Construa uma padaria e mais cabanas do caçador.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "Ao se concentrar em servir as tropas, você negligenciou seus habitantes!";
