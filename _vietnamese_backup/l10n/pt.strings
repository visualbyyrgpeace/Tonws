"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Fomos vitoriosos!\nSeu apoio sólido contribuiu muito e você tem a sincera gratidão dos meus homens. Que os tempos de paz comecem logo!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Apoie os soldados.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Entregue os suprimentos para o exército do Rei a tempo.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "As vidas de muitos homens dependem do seu apoio!";
"T_GAME_QUEST_SCEN15_02_START" = "Conquistamos novos territórios e precisamos proteger a linha de frente agora.\nEnvie tábuas e tecido rapidamente, para podermos construir acampamentos!";
