"T_MAP_CANALGRANDE_DESC" = "Uma lagoa com várias ilhas pequenas é o melhor lugar para construir uma cidade com várias pontes e cortada por diversos canais.";
"T_MAP_COASTALISLAND_DESC" = "Nesta baía, há uma ilha idílica. Será que você consegue criar uma cidade importante neste lugar remoto?";
"T_MAP_COASTSANDCLIFFS_DESC" = "A vista do castelo dá para o oceano, acima de um penhasco. Nos platôs circundantes, você pode construir uma bela cidade costeira.";
"T_MAP_COASTSANDCLIFFS_NAME" = "Penhascos e costas";
"T_MAP_DESC_10" = "Este exuberante vale é perfeito para construir uma cidade próspera.";
"T_MAP_DESC_11" = "Este mapa foi criado para testar o desempenho em todos os dispositivos. Uma cidade realmente grande está se espalhando por todo o mapa.";
"T_MAP_DESC_12" = "As águas ondulantes dos rios nesta região convidam os moradores para pescarem ou nadarem na água cristalina.";
"T_MAP_DESC_13" = "Sob um planalto com sombra uma pequena aldeia pode se transformar em uma enorme cidade.";
"T_MAP_DESC_14" = "O reino sofre com a seca. O rio secou. Isso faz com que o cultivo da terra para alimentar os Habitantes seja um desafio.";
"T_MAP_DESC_15" = "Estabeleça um próspero posto comercial na planície. Negociações lucrativas com mercadores e cavaleiros estão à sua espera.";
"T_MAP_DESC_16" = "Funde uma colônia de mineração e forneça recursos para a construção de uma catedral monumental.";
"T_MAP_DESC_17" = "Faça os preparativos para um imponente casamento real.";
"T_MAP_DESC_18" = "Construa uma grande cidade perto do leito seco do rio, mas lembre-se que a água é um recurso escasso nesta área.";
"T_MAP_DESC_19" = "Há uma pequena planície perto do pântano. Um lugar ideal para uma cidade.";
"T_MAP_DESC_2" = "Este local tranquilo na costa é ideal para posicionar sua aldeia.";
"T_MAP_DESC_20" = "Uma região montanhosa isolada no meio do nada. Sem água, mas há muito minério. O lugar perfeito para enriquecer!";
"T_MAP_DESC_2016_01" = "O Rei precisa de muitas tábuas para construir uma frota. Descubra por que a entrega de tábuas parou e crie uma guilda comercial.";
"T_MAP_DESC_2016_02" = "Esta bela região é perfeita para construir uma grande cidade. As Colinas Amplas têm espaço de sobra para inúmeros prédios.";
"T_MAP_DESC_2016_03" = "Uma pequena cidade virou uma grande metrópole. Satisfaça os desejos e necessidades dos habitantes no tempo dado.";
"T_MAP_DESC_2016_04" = "Mude certos habitantes de trabalho para construir um mercado e uma taverna.";
"T_MAP_DESC_2016_05" = "Planeje bem a cidade. Espaços para prédios ficam entre cachoeiras e o terreno é difícil de atravessar.";
"T_MAP_DESC_2016_06" = "Há pesadas avalanches nessa região. Além disso, você pode estabelecer uma pequena cidade e usar os ricos depósitos de minério.";
"T_MAP_DESC_2016_08" = "Construa sua cidade no cânion. Você encontrará tudo que precisa, mas algumas áreas são de difícil acesso.";
"T_MAP_DESC_2016_09" = "Cruze o rio para chegar aos recursos necessários à sua cidade.";
"T_MAP_DESC_2016_10" = "Junte muitas moedas. Mas cuidado, pois os bandidos fizeram um covil na área. Essa ameaça também faz com que os habitantes insatisfeitos não paguem impostos.";
"T_MAP_DESC_21" = "Funde um vilarejo numa ilha oculta e maravilhosa. Desfrute da brisa fresca do mar!";
"T_MAP_DESC_21_NOBANDITS" = "Funde uma aldeia em uma ilha secreta maravilhosa. Desfrute do frescor do ar marinho!";
"T_MAP_DESC_22" = "Faça com que sua cidade sobreviva ao inverno implacável.";
"T_MAP_DESC_23" = "Nesta planície gélida, você precisa construir bem rápido uma cidade funcional, do contrário passará fome no inverno.";
"T_MAP_DESC_24" = "Apoie o rei em sua iniciativa de construir uma grande frota de navios ao mesmo tempo em que aplaca os ânimos acirrados dos habitantes. ";
"T_MAP_DESC_25" = "Aproveite as florestas ao redor nesta região ao tentar fundar a sua cidade. A água é escassa aqui, então a pesca não é uma boa fonte de alimento.";
"T_MAP_DESC_26" = "O seu rei entrou numa aposta e agora é seu dever construir uma grande cidade antes do arquiduque. Você tem um ano para completar todas as tarefas. Não decepcione o rei!";
"T_MAP_DESC_27" = "Áreas pantanosas dificultam a descoberta de terreno adequado para construir. Faça de tudo para usar de maneira eficiente o terreno disponível!";
"T_MAP_DESC_28" = "Um vale rochoso contendo muitos recursos, mas sem muito espaço para construir.";
"T_MAP_DESC_29" = "Um pequeno grupo de ilhas. Colonizá-las é um desafio.";
"T_MAP_DESC_29_NOBANDITS" = "Um pequeno grupo de ilhas. Colonizá-las será um desafio.";
"T_MAP_DESC_3" = "Este é o mapa do tutorial. Aqui você será apresentado ao mundo de Townsmen.";
"T_MAP_DESC_30" = "Construa uma cidade cercando sua montanha. Mas tome cuidado, logo chegará um inverno rigoroso.";
"T_MAP_DESC_31" = "O Rei vai visitar suas propriedades. Prepare-se para a chegada dele.";
"T_MAP_DESC_32" = "O aniversário do Rei está chegando. Você deve encontrar a cerveja perfeita para dar de presente. Talvez os monges do mosteiro saibam de alguma coisa...";
"T_MAP_DESC_33" = "O rei sofre de uma doença misteriosa. Você deve curá-lo e descobrir como surgiu essa doença.";
"T_MAP_DESC_34" = "A guerra cobra um alto preço da terra. Longe da linha de frente, devemos manter uma cidade produtiva e apoiar o exercito do Rei.";
"T_MAP_DESC_35" = "O Rei quer estar preparado para os tempos difíceis e sua cidade foi escolhida para fornecer os produtos necessários.";
"T_MAP_DESC_36" = "Aprenda os detalhes da guerra com um veterano.";
"T_MAP_DESC_37" = "Atenda aos desejos da sua esposa enquanto negocia com um bandido ganancioso.";
"T_MAP_DESC_4" = "Seu castelo está localizado em uma pequena ilha fluvial. Use as margens do rio de forma sábia e construa uma economia próspera.";
"T_MAP_DESC_6" = "Construa uma pequena aldeia nas margens de um bonito lago.";
"T_MAP_DESC_7" = "Sua cidade foi escolhida pelo rei para receber o maior torneio de justa da região!";
"T_MAP_DESC_8" = "O inverno está chegando! Ajude seus moradores a se prepararem para a estação gelada!";
"T_MAP_DESC_9" = "Ajude sua esposa e faça a economia de uma aldeia degradada prosperar novamente!";
"T_MAP_DESC_APOCALYPSE" = "A cidade está sofrendo com uma  maldição. Doenças estranhas e desastres acometem a população. Você deve encontrar uma maneira de acabar com a maldição o mais rápido possível. Não importa o que tiver de ser feito...";
"T_MAP_DESC_FESTIVITIES" = "O Rei se casou de novo. Para homenagear a nova rainha, você recebeu ordens de organizar vários festivais. Mas o planejamento e a execução podem se tornar um desafio. Vai ser uma corrida contra o tempo…";
"T_MAP_DESC_ICYHOLD" = "No alto de um penhasco fica a Fortaleza Gélida. É difícil chegar lá, mas uma vez vencida a escalada, é possível ver toda a tundra em redor. O inverno é muito longo nessa área!";
"T_MAP_DIPLOMATICVISIT_DESC" = "A Rainha de um reino aliado está vindo visitar a cidade. Serão fechados acordos comerciais muito lucrativos, mas há uma barreira linguística que precisa ser superada antes de tudo.";
"T_MAP_DIPLOMATICVISIT_NAME" = "Visita diplomática";
"T_MAP_DIVIDEDSHORELINE_DESC" = "Uma montanha gigantesca divide suas terras. Você também pode conquistar uma ilha relativamente próxima do seu castelo.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "Litoral repartido";
"T_MAP_FRIGYTHKINGDOM_DESC" = "A Rainha Frigyth precisa de um novo governador para administrar esta parte do reino dela. Construa uma cidade magnífica nesta terra.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "Reino de Frigyth";
"T_MAP_FROZENFRONT_DESC" = "A guerra deixou a maior parte da cidade em ruínas. O que sobrou dela, agora coberto de neve, marca o local que foi palco do confronto entre exércitos. É hora de reconstruir a cidade.\n\nEste mapa se passa apenas no inverno!";
"T_MAP_HIGHLANDS_DESC" = "Esta região é atravessada por montanhas e morros. A vista é linda no topo dos picos.";
"T_MAP_HIGHLANDS_INTRO" = "Bem vindo à região montanhosa, governador. Esta região é cheia de mistérios. Tenho certeza que, se formos atenciosos e cuidarmos dos habitantes, a terra logo revelará seus segredos.";
"T_MAP_HIGHLANDS_NAME" = "Região Montanhosa";
"T_MAP_INSANECHOICES_DESC" = "Você foi convocado a uma cidade cujo Duque parece ter enlouquecido. Os habitantes se recusam a pagar impostos!\nCada escolha que você fizer leva a um final diferente.";
"T_MAP_INSANECHOICES_NAME" = "Escolhas insanas";
"T_MAP_LEGACY_DESC" = "O Rei tem uma nova tarefa para você. Ele está ficando muito velho e teme abandonar o mundo sem deixar um legado. Um que transmita às futuras gerações as lições que aprendeu ao ser Rei.";
"T_MAP_LEGACY_NAME" = "O Legado";
"T_MAP_LOWLANDS_DESC" = "Vastas planícies e área de construção até perder de vista. Aqui é possível de fato construir uma cidade grande.";
"T_MAP_LOWLANDS_NAME" = "Terras baixas";
"T_MAP_MARSH_DESC" = "Essa região de áreas alagadas contribui para a diversidade ecológica do território. ";
"T_MAP_MARSH_INTRO" = "Senhor, veja este equilíbrio perfeito entre terra e água. Fico feliz em recebê-lo neste lugar tranquilo.\n\nOs residentes logo serão testemunha de nossos esforços para fazer a região alcançar todo seu potencial!";
