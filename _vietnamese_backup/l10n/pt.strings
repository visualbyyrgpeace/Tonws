"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Com essas novas armas os soldados certamente serão vitoriosos na próxima batalha.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Entregue armas.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Sem sua entrega não tenho esperança para a batalha final!";
"T_GAME_QUEST_SCEN15_04_START" = "Nossas provisões estão acabando!\nEnvie pão e carne, para recuperarmos nossas forças para a batalha final.";
