"T_GAME_TUTORIAL_QUEST_DESC_4" = "As cabanas de pescador fornecem peixe e são fonte de alimentação do vilarejo. Construa uma cabana de pescador para satisfazer a necessidade de comida.";
"T_GAME_TUTORIAL_QUEST_DESC_4_WELL" = "O poço abastece sua aldeia com água. Construa um poço para satisfazer a necessidade de água de seus moradores.";
