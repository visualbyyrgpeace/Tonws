"T_GAME_TUTORIAL_QUEST_4_WELL" = "Construa um poço.";
"T_GAME_TUTORIAL_QUEST_DESC_1" = "Você acabou de receber sua primeira tarefa! Sua cidade precisa de madeira! Entre no menu de construção e procure pelo campo dos lenhadores!";
