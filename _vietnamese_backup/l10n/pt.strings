"T_GAME_BUILDING_INFO_COALER" = "No carvoeiro a madeira é transformada em carvão.";
"T_GAME_BUILDING_INFO_CORNFIELD" = "Um campo para os fazendeiros cultivarem trigo.";
"T_GAME_BUILDING_INFO_COUNTRYHOME" = "A casa urbana grande abriga {FAMILIES} famílias. É muito cara, mas permite alta ocupação de famílias em um espaço restrito.";
