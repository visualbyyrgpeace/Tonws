"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Espero que agora estejamos preparados.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Construa uma serraria e uma cabana do caçador.";
"T_GAME_QUEST_SCEN15_09_START" = "Para entregar esses recursos, precisamos de um pasto para ovelhas e uma tecelagem.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Bom trabalho, meu senhor. Você sempre pode acelerar a fabricação fazendo upgrade ou construindo prédios adicionais.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Construa um pasto para ovelhas e uma tecelagem.";
