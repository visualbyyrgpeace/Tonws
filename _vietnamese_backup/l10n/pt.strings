"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Eu dou autorização.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Tá, chega, levem esse homem até um médico.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Como assim? O meu irmão é um pássaro? O senhor está maluco.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "O que o governador está tentando dizer é que você precisa confiar no seu irmão, ele sabe o que faz. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Se você diz... Mas se algo acontecer com ele, vocês serão os responsáveis!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Governador, aplicamos um sedativo nele e ele está dormindo. Estava murmurando coisas estranhas, sobre uma técnica que poderia fazê-lo pairar sobre as montanhas. O senhor fez a coisa certa trazendo-o até mim. Senão, ele poderia até dizer que a terra é redonda!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Senhor! Encontramos um mensageiro do palácio, ele diz que nosso inventor tem toda razão e quer que ele fique mais na capital para continuar trabalhando em suas invenções. A influência cultural da cidade deu um salto adiante! O rei decidiu nos enviar prestígio.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Meu senhor, vim até o senhor porque meu irmão enlouqueceu. Ele diz que é um pássaro e pode voar! Tenho medo de que ele faça uma loucura e decida subir alto demais para provar que pode voar.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Ah, senhor! Obrigado por não ter me levado ao calabouço! Minha irmã se preocupa demais comigo. Eu queria surpreender vocês com minha descoberta! Inventei uma máquina capaz de voar! COMO OS PÁSSAROS! Gostaria de apresentá-la na capital, na grande feira anual.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "O irmão-pássaro";
"T_GAME_QUEST_COVERAGE_DESC" = "Milorde, a cidade não está preparada para ataques de bandidos!\nVocê ainda não colocou torres de guarda suficientes. É preciso colocar as torres para proteger o máximo possível de prédios.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Meu Senhor, a cidade não está preparada para ataques de bandidos! Partes da cidade não estão cobertas por prédios de defesa. ";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Aumentar a cobertura da vila com edifícios de defesa";
"T_GAME_QUEST_COVERAGE_TITLE" = "Cubra a vila com torres de guarda.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Bandidos estão nos atacando, governador!\nTemos que rechaçar o maior número possível de saqueadores para minimizar prejuízos à economia e aos prédios!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Milorde,\nos habitantes estão com medo de ataques de bandidos. Devemos mostrar a eles e, especialmente, aos bandidos, que podemos nos defender!";
"T_GAME_QUEST_DESIRES_01_START" = "Que região provinciana. Não tem nenhuma das vantagens de uma grande cidade.\n\nMuita coisa precisa mudar nesta cidade para ser uma metrópole moderna.";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Agora que os bandidos foram derrotados e a vila prosperou, este lugar ficou muito bonito.\nFoi uma boa ideia mudarmos para cá, querido.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Garanta que sua esposa esteja confortável.";
"T_GAME_QUEST_DESIRES_02_START" = "Esta vila também precisa de uma alfaiataria, para que eu tenha novas roupas sob medida.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Obrigada, querido!\nMinhas roupas antigas já estavam bem gastas.";
"T_GAME_QUEST_DESIRES_03_START" = "Sinto falta da atividade da cidade.\nTraga mais pessoas para revigorar esta cidade, por favor!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Aumente a população.";
"T_GAME_QUEST_DESIRES_04_START" = "Oh, que bela e animada vila!\n\nVocê certamente não tem nada contra eu vir morar aqui.";
"T_GAME_QUEST_DESIRES_05_START" = "Bandidos na floresta!?\nMonte uma guarda na cidade para afastar esses criminosos!";
"T_GAME_QUEST_DESIRES_06_START" = "Opa, uma torre de guarda...\n\nVocê deve saber que esse tipo de comportamento só provoca meus homens!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Aqueles bandidos criam confusão na cidade.\n\nQuero que você reforce a guarda da cidade imediatamente!";
"T_GAME_QUEST_DESIRES_07_START" = "Verifique se a guarda da cidade mantém todos os bandidos longe da cidade!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Maravilhoso! Eu me sinto muito mais segura agora.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Afaste todos os ataques dos bandidos.";
"T_GAME_QUEST_DESIRES_08_START" = "Para garantir a lealdade dos guardas, você deve servir cerveja e salsichas a eles!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Produza cerveja e salsichas.";
"T_GAME_QUEST_DESIRES_09_START" = "Os guardas precisam de armas e armaduras para conseguir derrotar os bandidos!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Agora os guardas devem conseguir derrotar os bandidos!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Produza armas e armaduras.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Eu deveria ter mencionado que meu povo vai pegar sua parte de qualquer maneira!";
"T_GAME_QUEST_DESIRES_10_START" = "A forma com que você atende aos desejos da sua esposa me faz pensar que você tem moedas em demasia.\n\nDeixe-me aliviá-lo desse fardo pesado!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Será uma decisão sábia me entregar essas moedas agora, senhor administrador!";
"T_GAME_QUEST_DESIRES_10_TITLE" = "Tributo de moedas.";
"T_GAME_QUEST_DESIRES_11_START" = "Você não está pensando em ceder a essa chantagem, não?\nGastar as moedas em novas roupas seria um investimento muito melhor!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Compre uma roupa no mercador.";
"T_GAME_QUEST_DESIRES_12_START" = "Esta cidade está um tédio, falta entretenimento!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "Esta vila é um tédio, está faltando um campo de justa!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "Muito melhor! Isto está começando a parecer legal.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Construa um campo de justa.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Você não aprendeu nada da última vez. Meus capangas virão fazer um pequeno inventário!";
"T_GAME_QUEST_DESIRES_13_START" = "Parece que você ainda tem moedas sobrando. Dê-me o seu ouro!\nE não ouse dá-lo à sua esposa!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Parece que você aprendeu alguma coisa. Talvez meus homens não precisem mais buscar a parte deles.";
"T_GAME_QUEST_DESIRES_15_START" = "É melhor você transformar o ouro em joias para mim, meu querido!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Muito obrigada, querido!";
"T_GAME_QUEST_DESIRES_16_START" = "Quero fazer uma pequena festividade.\nPor isso, preciso de suco e pão.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Muito bom. Espero que não haja nenhum incidente com os bandidos.";
"T_GAME_QUEST_DESIRES_17_START" = "Opa, que festa bonita, você esqueceu de nos convidar? ";
"T_GAME_QUEST_DESIRES_18_START" = "Já chega. Livre-se desses bandidos de uma vez por todas!\nDestrua o acampamento deles!";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "Finalmente nos livramos desses criminosos.";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Destrua todos os acampamentos dos bandidos.";
"T_GAME_QUEST_DESIRES_19_START" = "Esta vila não tem um mercado!? \nConstrua um, meu querido, assim poderei comprar produtos da cidade.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Assim fica um pouco mais suportável morar aqui.";
"T_GAME_QUEST_DESIRES_20_START" = "Ninguém tem nada para vender além de peixe?\nConstrua uma padaria e produza pão.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Muito obrigada! Já estava ficando enjoada do cheiro de peixe.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Milorde, nossos batedores dizem que os bandidos da área estão se agrupando nos limites da cidade. Temo que façam um ataque em larga escala em breve.\nPrepare as defesas!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "Os bandidos começaram o ataque!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "A próxima horda de bandidos saqueadores chegou à cidade, milorde!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Senhor Governador, os bandidos começaram um novo ataque!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Outra horda de bandidos está a caminho da cidade, meu senhor!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Uma enorme horda de bandidos está vindo, meu senhor. Parece que é a última horda de bandidos. Temos que resistir!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Milorde, a guarda da cidade avisa que o ataque acabou. Os bandidos que restaram foram expulsos da cidade e estão recuando.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "A população animal está recuperada. Finalmente podemos caçar de novo!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Os campos se recuperam lentamente, meu senhor. A doença das plantações parece ter terminado.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "A plantação aos poucos está se recuperando, meu senhor. A seca parece ter terminado.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "A cidade está em chamas, meu senhor administrador.\n\nPrecisamos apagar o incêndio logo, antes que se espalhe por toda a cidade.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Excelente, meu senhor.\n\nTodos os incêndios foram apagados e a cidade está segura novamente.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Não há mais incêndios na cidade, meu senhor.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Certifique-se de que não há mais prédios em chamas.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Meu senhor, a peste negra está devastando a terra.\n\nPrecisamos cuidar dos doentes, antes que toda a cidade fique infestada pela peste.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Conseguimos, meu senhor!\n\nA epidemia da peste foi contida. A cidade está protegida.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Medicina moderna.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Remédios de avó.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "O médico, muito indignado, decidiu destruir a enfermaria! Ele disse: “Se vocês usam remédios de avó, não precisam mais do meu laboratório!”";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Boa decisão, senhor.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Graças à sua escolha, o atendimento médico ficará muito mais eficaz!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Senhor, muitos habitantes não sabem mais ao que recorrer quando têm problemas de saúde. Eles devem usar a medicina moderna ou remédios de avó?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Médicos e avós";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Volte a dormir.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Eu acredito em você.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Ah, não! Não! Não devíamos ter ignorado aquele sonho! Algumas pessoas começaram a ter sintomas estranhos.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Felizmente, conseguimos impedir a doença. É melhor prestar atenção nas premonições da próxima vez...";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Este habitante nos salvou do desastre mais de uma vez. Vamos construir uma enfermaria, senhor, só para garantir.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Senhor! Acabamos de construir a enfermaria e alguns de nossos habitantes estão doentes. Que bom que você decidiu ouvir este habitante! O dano foi limitado! Muito bem, meu senhor.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Ainda é preciso curá-los, senhor. Do contrário, a doença poderá se espalhar.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Esplêndido! Toda a aldeia está de novo em perfeita saúde. Podemos voltar aos negócios de sempre.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Meu senhor, ontem à noite sonhei que a nossa aldeia ia ser infectada por uma doença estranha. Todos os habitantes ficaram com nariz entupido. \n\nAcha que o meu sonho é premonitório?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Hora de sonhar";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Estou ansioso pela inauguração!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Ah, eu preferia a anterior.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "Não tenho tempo para isso.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Eu já disse que não.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Pode mandá-la entrar.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Concedido.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Está fora de questão atrair mais viajantes.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "Numa demonstração de generosidade jamais vista, você começa a trabalhar. A pousada vai ficar inundada de flores!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Está bem.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = "“Ouçam, ouçam, todos! A pousada tem uma nova dona! Venha à pousada para a nova inauguração!”\n\nO divulgador da cidade está de bom humor hoje. Dizem que toda vez que um novo hóspede chega à pousada, ele recebe gorjeta.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Senhor, a nova dona da pousada chegou. Gostaria de lhe dar as boas-vindas?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Senhor, por favor. A pousada é um dos lugares preferidos dos viajantes. Poderíamos melhorar a reputação da cidade ao aprimorar o local.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Bom dia, senhor. Obrigada por me receber no seu castelo.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "O que nos dá a honra da sua visita?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Bom, a pousada está em mau estado. O proprietário anterior era muito descuidado. Não só com os fornecedores como também com os clientes!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Ah, sim, se você diz. Não passo muito tempo na pousada.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Então, vim pedir sua ajuda. Gostaria de começar adicionando flores ao redor do meu estabelecimento, para dar um visual mais charmoso. Quero atrair mais viajantes e quero que eles voltem.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Agora, vamos passar para o segundo passo! As bebidas.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! Um segundo passo... Bem, já que estamos aqui, vamos continuar. Então qual é o próximo passo no seu programa?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Precisamos de metal e também de madeira de alta qualidade.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Você não tinha falado em bebida? Por que madeira?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Ora, para fazer barris decentes! O antigo proprietário nem sequer tinha barris adequados para armazenar as bebidas. Os fornecedores devem estar usando madeira ruim. Então precisamos obter madeira e barras de ferro suficientes para nós mesmos fazermos.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Ótimo! Elas são lindas!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Se é assim... eu resolvo sozinha!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "A partir de agora, o divulgador da cidade vai favorecer a pousada em seus anúncios.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "A partir de agora, o divulgador da cidade vai favorecer a taverna em seus anúncios.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Obrigado, governador! Tudo está bem agora.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Obrigada, senhor! A pousada está muito mais acolhedora com as flores.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Por favor, senhor, pense a respeito. A pousada é uma importante fonte de renda para a aldeia. Ela pode ajudá-lo a realizar alguns dos seus projetos.\n\nTem certeza de que não quer ajudar?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "O que está dizendo, senhor?! O senhor ajuda esta jovem com sua pousada, mas e quanto a mim? O senhor não me ajuda com a taverna!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Ora, tenha bons modos ao se dirigir ao governador.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Exijo ter os mesmos privilégios que esta senhora!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Você também quer flores para o seu estabelecimento?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Flores? Não! Quero um divulgador que também apoie o meu estabelecimento!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Senhor, o que devemos fazer?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Promover a taverna.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Promover a pousada.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Sobre flores e inimigos";
"T_GAME_QUEST_FEAST_TITLE" = "Organize um festival na cidade.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Proteja a aldeia com torres contra incêndio.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Milorde, a cidade não está preparada para incêndios! Partes da cidade não estão protegidas pelas torres contra incêndio. É preciso colocar as torres para proteger o máximo possível de prédios.";
"T_GAME_QUEST_FOOD_STARTED" = "Não podemos nos esquecer da comida, senhor! Não há festival sem uma despensa completa. Melhor encher a despensa rápido. Quanto mais cedo tivermos os recursos, mais rápido o seu projeto terá sucesso.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Os participantes do nosso festival não vão morrer de fome! Estamos perto da nossa meta, senhor! Mal posso esperar!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Um governador que não é capaz de oferecer uma bebida a uma rainha!? Me falaram para não confiar no senhor, mas eu não quis prestar atenção!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Ora, rainha Frygith, não fique zangada com algo tão pequeno. É só uma bebida. Não seja dramática.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Vejo que até o seu conselheiro começou a me desrespeitar...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "A situação fica totalmente fora de controle, você não sabe mais o que fazer e está ficando cada vez mais nervoso. \n\nComo você reage?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Tentar acalmar a rainha.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Escute, o governador está apaixonado e não sabe como se comportar. Entenda, vossa majestade é o primeiro amor da vida dele.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "A rainha também se sente emocionada. Parece que ela também nutre sentimentos por você. Seria o início de uma legítima história de amor? Será que a vidente estava certa?\n\nSó o tempo dirá. Enquanto isso, a rainha decidiu dançar mais uma vez.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Vários meses se passaram desde o famoso baile. Você e a rainha Frygith mantêm uma relação por cartas. Às vezes, ela vem visitá-lo quando o tempo permite.\n\nTalvez um dia ela venha a escolher você como rei de seu reino. Mas, por enquanto, ela tem afazeres demais em seu papel como rainha.\n\nE você também! Você precisa continuar a fazer tudo o que for possível para manter a cidade funcionando sem problemas.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Os habitantes também ficam felizes por você e pela rainha. Eles observam que o número de viajantes aumentou, e que eles vêm principalmente para provar o suco de uva e a bebida recusada à rainha durante a festa. Dizem que a qualidade era tão boa que em menos de uma hora todo o estoque acabou.\n\nA produtividade desses dois edifícios aumentou!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Cartas.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Vou tirar as cartas com uma visão geral, senhor. Elas vão nos dizer que tipo de pessoa é o senhor e o destino que o aguarda. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Depois de tirar as cartas pela primeira vez, ela começa a tirar a segunda.\n\nEla pede a você que tire três cartas. Uma para o passado, uma para o presente e uma para o futuro. \n\nAssim que todas as cartas são escolhidas, ela as vira uma a uma.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Ah, senhor, essas três cartas me dizem que o senhor passará por um momento muito difícil. Desconfie das pessoas na igreja. As cartas dizem que no passado elas já tentaram se aproximar de você, mas sem muito sucesso.\n\nO senhor foi avisado.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Excelentes cartas, senhor! Todas positivas. O senhor encontrará uma mulher, uma grande mulher que vai virar o seu mundo de cabeça para baixo. O amor está no ar! Esteja atento para quando ela bater à sua porta.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Você vê a jovem embaralhar as cartas e sussurrar o seu nome nelas para transmitir sua energia.\n\nE, então, ela pede que você escolha o monte da direita ou da esquerda.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Espero que essa previsão não se torne realidade e que as pessoas religiosas sejam felizes em nossa cidade.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Na manhã seguinte, um monge se aproxima. Ele lhe informa que a igreja precisa de mais recursos e que agradeceria se houvesse um local a mais para adoração.\n\nVocê se lembra da previsão da vidente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Senhor, uma nova igreja pode ajudar a despertar a espiritualidade da população. Agradeço de coração.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Construir um novo local de adoração.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Ah, perfeito! O senhor pode ter certeza que faremos bom uso deste novo local de culto.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Monta da esquerda.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Esta carta indica que o senhor tem um lado muito sombrio que pode levá-lo à destruição. Infelizmente, acho que isso poderá afetar a produtividade do seu povo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Sinto que o senhor está confuso e que seu conselheiro está tentando convencê-lo a ir embora. Mas fique um pouco mais, ainda não acabou. Tirar as cartas uma segunda vez pode fornecer respostas mais específicas.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Senhor, a vidente está falando a verdade, temos uma visita marcada para o próximo fim de semana. Teremos tempo suficiente para planejar uma festa e preparar as vestimentas!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Organizar uma festa";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Não existe boa festa sem comida e bebida. Vamos começar por aí, senhor.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Perfeito! Agora temos comida e bebida suficientes para satisfazer os nossos convidados.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "O senhor deve fazer tudo que for possível para esta festa. Imagine se sua alma gêmea aparecer?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Seu conselheiro pode ter razão. Você então decide trajar sua roupa mais bonita. A cidade inteira brilha, você não hesita em exibir sua riqueza.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Essa festa vai ficar para a história! Sem dúvida vai impressionar a sua possível amada.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Monte da direita.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Você é uma pessoa caridosa e as cartas dizem que isso afetará a produtividade de seus habitantes!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "Bola de cristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Excelente escolha, governador. Por favor, aproxime-se e olhe dentro da bola de cristal.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "A vidente aproxima as mãos da da bola de cristal e, de repente, aparece uma fumaça azul.\n\n“Ah, um grande infortúnio poderá cair sobre o senhor. Vejo monges. Talvez isso seja a causa do infortúnio”, diz ela, com um tom melancólico.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "A vidente aproxima as mãos da bola de cristal e, de repente, surge uma fumaça rosa:\n\n“Ah, o senhor encontrará o amor! Amor verdadeiro! A sua história será incrível, garanto!", ela diz, com expressão confiante.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Sai e vai chorar em seus aposentos.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Em pânico, você escapa do salão e corre para seu quarto e cai chorando na cama.\n\nTudo sugere que você está sofrendo por um amor não correspondido. Só o tempo poderá curá-lo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Você fica vários meses se recuperando de sua decepção amorosa. \n\nA rainha Frygith nunca tentou saber notícias suas, ela não liga para você.\n\nPor outro lado, você entrou para a história e agora aparecerá nos livros como o governador apaixonado. Assim, você ganhou a simpatia do povo e agora eles trabalham de modo mais eficaz.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Traga-lhe uma bebida alcóolica.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "Na companhia de seu conselheiro, você decide ir à casa da cartomante. Talvez ela possa ajudá-lo a evitar infortúnios ou, quem sabe, dar alguma boa notícia.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "A vidente não está distante do castelo. Você entra numa pequena tenda e se vê cercado de vários objetos místicos. De certa maneira, o ambiente o acalma.\n\n“Ah, meu senhor, sente-se. Que bom que aceitou meu convite. Que método prefere?”";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Traga-lhe suco de uva.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Você consegue admirar os desfiles do alto do seu castelo. E, de repente, à distância, você vê uma procissão chegando. Sua atenção cai sobre uma bela mulher. Você sente seu coração saltar. \n\nSeria isso amor à primeira vista?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Louco de amor, você decide ir conhecer aquela bela desconhecida. Quase caindo da escada do castelo, você desce a escada de quatro. Seu conselheiro, de pé ao seu lado, não entende o que se passa com você.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Senhor, esta é a Rainha Frygith. Não sei o que o motivou a chegar até ela tão rápido.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Governador, é um prazer conhecê-lo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "A rainha Frygith deixou você encantado e você não sabe como agir. Felizmente, o seu conselheiro de confiança o ajuda, o que permite que você volte a recuperar o bom senso.\n\nVocê decide convidar a Rainha Frygith para o baile hoje à noite. Tomara que ela aceite este primeiro encontro romântico.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Rainha Frygith, o governador a está convidando para ser seu par no baile de hoje à noite. Vossa majestade nos daria a honra?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "Isso é totalmente inadmissível! Minha mão está prometida em casamento ao Duque de Cannes, não posso ser vista nos braços do governador.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Ficarei muito feliz em comparecer.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "O momento do baile finalmente chegou. Você pediu aos músicos de maior prestígio para tocar esta noite. Você quer que tudo seja absolutamente perfeito para sua amada.\n\nA Rainha Frygith finalmente chega, trajando um vestido elegante. Cada segundo que você passa em sua presença faz seu amor por ela ficar mais forte.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "A música está funcionando, a rainha Frygith também parece estar enfeitiçada. É hora de dar uma pausa e ela pede a você algo para beber.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Você não tem nada a oferecer a ela.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Recusar o convite.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Fez a coisa certa, governador. Sabe-se lá em que tipo de problemas nos teríamos metido!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Desolado, você decide não ir ao baile. Fica triste durante um bom tempo, e isso acaba se refletindo na sua cidade. A produtividade e a felicidade dos habitantes estão diminuindo. Tomara que esse efeito não dure.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Você novamente passa a ver a luz no fim do túnel e supera sua tristeza. Aos poucos, passa a sair de seus aposentos.\n\nAs pessoas ficam satisfeitas com a sua recuperação e isso gera um efeito positivo na produtividade e no ânimo.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Obrigada, governador, o senhor é um homem encantador. Gostaria de aproveitar esta noite para estabelecer acordos comerciais? Assim, poderemos nos encontrar novamente...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Eu o deixarei na companhia da rainha, governador.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Você e a rainha ficam a sós no jardim real, como nos contos de fadas. É como se o tempo tivesse parado para você e para a rainha Frygith. Você toma coragem e revela seus sentimentos. Pelo jeito, a rainha corresponde!\n\nInfelizmente, o sol está nascendo e a rainha precisa regressar. Ela tem muito a fazer em seu país. E você sabe que não é fácil administrar um país sozinho.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Os habitantes também ficam felizes por você. Ficam menos propensos a greves, o que é uma ótima notícia.\n\nVocê finalmente fez a coisa certa ao consultar a vidente.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Eu adoraria ir!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Senhor, que coisa terrível. As pessoas forçadas a ir à igreja estão completamente desmoralizadas. Estão totalmente desanimadas. Vamos rezar para que superem! Foi uma má decisão tornar a presença na igreja obrigatória!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Todo o assunto da igreja e da vidente ficou para trás. As pessoas começam a recuperar a felicidade.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "A decisão nos foi benéfica, senhor! O senhor fez a coisa certa ao tornar obrigatória a presença na igreja. Os habitantes ficaram mais felizes e mais produtivos.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "O líder religioso da aldeia retorna para vê-lo.\n\n“Senhor, gostaria de fazer uma pergunta. Poderia tornar a presença na igreja obrigatória? Com essas videntes por perto, temo que nosso povo seja facilmente influenciado. Gostaria de salvá-los antes que seja tarde demais.”";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Aceitar o pedido.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Prometo que o senhor não se arrependerá!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Recusar o pedido.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Entendo, senhor. Foi a vidente que fez a sua cabeça. O senhor deveria ter ficado longe dela!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Já que a religião importa tão pouco para o senhor, destruiremos os locais de culto! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Senhor, que coisa terrível! Monges furiosos estão destruindo edifícios na cidade! E foi impossível capturá-los, eles fugiram! Que isso nos sirva de lição antes de consultar videntes. Veja onde fomos parar.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Como seu conselheiro, nunca mais deixarei o senhor consultar uma vidente! Agora vamos voltar ao trabalho, senhor. A população está de péssimo humor.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Senhor, alguns viajantes chegaram à cidade esta tarde. Entre eles, uma vidente. Ela lhe envia um convite para que possa fazer previsões para o senhor.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "A Vidente";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Então por que não param de comer? ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Investigue o caso.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Destrua as cabanas dos pescadores.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "Que horrível! Os habitantes continuaram a comer os peixes por falta de algo melhor e muitos ficaram doentes!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "A doença está sob controle, senhor. Tivemos sorte.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "Estes controles de qualidade custam caro, mas é sempre melhor do que lidar com uma epidemia!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Todas as cabanas dos pescadores foram investigadas e o peixe voltou a ser comestível! Você acertou com esta decisão. Evitamos problemas graves.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "A destruição das cabanas desses pescadores permitiu eliminar a possível contaminação dos peixes. Mas é uma pena que essas belas construções tenham sido destruídas.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Governador, não quero parecer exigente, mas preciso admitir que o seu peixe... não é mais o mesmo. Não sei se é por causa do rio ou por causa de outra coisa, mas os peixes estão nojentos! Alguém vai acabar ficando doente se não resolvermos a situação.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Peixe fresco!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Obtenha um alto nível de satisfação com a comunidade.";
"T_GAME_QUEST_GETREWARD" = "Recompensa!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Senhor, não sei como dizer... Respire fundo. Está preparado? Bom... Vários habitantes dizem que viram um coelho gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Sim, e daí?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "UM COELHO GIGANTE?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "E DAÍ?! Mas senhor! É simplesmente assustador! Imagine se ele ficasse pulando pelo castelo e destruísse nossas casas!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "Pelas poucas casas que temos...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Precisamos agir, e RÁPIDO!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Ah, eis uma reação mais lógica do senhor.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Vamos construir uma cabana de caçador.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Envie uma carta ao palácio e peça um emissário.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Apesar da nossa organização para caçar coelhos, não conseguimos capturar o coelho gigante. Porém, agora temos bastante carne...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Alguma pista?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Fiz minha parte, agora vou dormir um pouco.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "O emissário chegou, senhor.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Exijo que o Exército Real me ajude.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Acompanhe o emissário para mostrar as provas.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Mas o que estou ouvindo? Um coelho gigante à solta em suas terras? Será que o senhor não bateu a cabeça?...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Hm, entendo. Sinais de coelhos gigantes... É uma boa história para contar às crianças marotas. “O coelho gigante vai aparecer de noite e puxar suas orelhas.” ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "E o que mais? Tenho mais o que fazer.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Vamos até a feiticeira.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Podemos ir até a feiticeira e pedir seu conselho. Talvez ela saiba algo sobre o famoso coelho gigante.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Estava à sua espera. Os corvos previram a sua chegada. Fizeram muito barulho. Mas menos do que os saltos do coelho.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Rezar.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Usar magia.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Não vamos fazer nada.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Então é verdade?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Pode apostar! Vocês demoraram para vir. Felizmente, ainda há tempo. Agora, há vários caminhos possíveis.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Percebo que o senhor não se importa nem um pouco com os habitantes, senhor... Isso vai acabar tendo consequências.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Certo, vamos construir duas cabanas de caçador e conseguir carne. Quem sabe, com sorte, acharemos a toca do coelho gigante.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Esta é a minha especialidade. Farei uma poção, mas você precisa me trazer ingredientes. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "E então? Vai ou não me dar esses ingredientes?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Muito obrigada, senhor! Droga! Esqueci a outra metade dos ingredientes.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Ah, não temos o dia inteiro, senhor. Tenho uma poção a fazer. Que tal me dar os ingredientes?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Muito obrigada, senhor. Aqui está a poção. Ponha um pouco no poço da aldeia e aguarde. O coelho gigante irá embora sozinho ao sentir o cheiro.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Senhor... Precisamos construir banhos públicos e adicionar muitos óleos essenciais para nos livrar do cheiro impregnado nos habitantes... O cheiro é pavoroso.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Ótimo! A cidade pode respirar aliviada novamente!\nO coelho foi embora sem deixar rastro, como se fosse obra da nossa imaginação. Por enquanto, senhor, podemos retornar aos afazeres.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "No fim das contas, o coelho foi embora sozinho. Em um de seus últimos saltos, ele desenterrou um baú escondido por bandidos há tempos. Nele havia 2000 moedas de ouro e o rei decidiu nos dar prestígio pelo achado!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Bom... Foi preciso um coelho gigante chegar para o senhor finalmente considerar a ideia de construir uma igreja!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Vamos construir rápido essa igreja e reunir os habitantes para rezar.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Tudo o que nos resta é esperar que as forças divinas façam sua parte.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "O coelho foi embora sem deixar rastro, como se fosse produto da nossa imaginação. Por enquanto, senhor, podemos retornar aos afazeres.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Hm... Eu teria escolhido a poção, mas o senhor é quem manda! Boa sorte, senhor, com seus infortúnios.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "O coelho gigante";
"T_GAME_QUEST_INN_STARTED" = "Senhor, serão necessárias acomodações adicionais. Que tal construir uma pousada? Assim, poderemos atender às necessidades dos visitantes do festival.";
"T_GAME_QUEST_INN_SUCCESS" = "Pronto, mais uma boa coisa foi feita. Agora vamos pensar nos outros preparativos.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "É arriscado demais.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Sim, por que não?";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "O piadista.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "A corte do rei adorou! Era exatamente o que eles precisavam! O prestígio é nosso! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "A habitante que diz charadas.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Infelizmente, as charadas... eram complicadas demais para eles. A corte do rei preferiria algo menos intelectual. Dessa vez, não ganhamos prestígio.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "O habitante acrobata.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "A corte do rei ficou impressionada com esse acrobata talentoso! O rei vai nos mandar prestígio como recompensa.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "O senhor tem razão, sabe-se lá o que pode acontecer conosco se o rei não ficar satisfeito com nossos candidatos.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Senhor, recebemos uma mensagem da capital. O rei está decepcionado que nenhum membro da nossa cidade ofereceu seus serviços. Felizmente, ele não vai nos punir por essa trivialidade. O rei é misericordioso!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Achei três possíveis candidatos. Qual deles enviaremos?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Meu senhor, o rei deseja um bobo da corte para entretê-lo. Vamos mandar alguns possíveis candidatos a novo bobo da corte?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "O Bobo da Corte";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Consertar o telhado.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Precisamos consertá-lo o mais rápido possível!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Agora não.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Temos outras prioridades no momento; o festival da lavanda está para começar e ainda não fizemos os preparativos.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "Por falar nisso, precisamos terminar os preparativos.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Bem melhor! Pelo jeito, vai ser um evento lucrativo!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Senhor, ouvi dizer que os vendedores de lavanda gostavam muito da nossa catedral. Não estão querendo comparecer ao nosso festival!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "O festival da lavanda aconteceu sem problemas.... no entanto, não tivemos tantos visitantes como antes! O evento não nos trouxe nenhum prestígio.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Fechado!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Então vamos rápido começar a produzir os itens para a rainha.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Agora só precisamos fazer a troca.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "É um prazer negociar com o senhor.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Senhor! Tenho más notícias! O símbolo mundial da nossa cultura pegou fogo à noite! A grande catedral não tem mais telhado!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Os especialistas dizem que já não temos madeira nobre suficiente em nossa terra para consertar o telhado. Mas a rainha Frygith tem os recursos necessários, será que devemos pedir ajuda?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Pedir ajuda.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Você se apressa em mandar um mensageiro à rainha: \n\n“Peço sua ajuda, Rainha Frygith! Poderia me emprestar madeira nobre das suas terras? A minha catedral está desmoronando.”";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Olá, meu caro, você chegou a tempo já que preciso estocar suco, tem interesse em uma troca amigável? Jarras de suco em troca da madeira que você precisa.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Senhor, esta oferta não nos beneficia...";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Você pesa os prós e contras deste acordo. Talvez a rainha seja a solução para todas os seus problemas... Mas será que não há outra maneira?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Pensar a respeito.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Este pedido pode prejudicar a nossa reputação. Vamos proceder de forma diferente. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "O conselheiro talvez tenha razão. Pedir ajuda à Rainha Frygith forçaria você a ficar dependente da boa vontade dela. Se houver algum problema, você corre o risco de perder muito.\n\nPor que não usar pedra? Você tem muita pedra nas minas.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Foi uma boa decisão, senhor! Somos livres e independentes.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "O festival da lavanda é um sucesso. Os relatos recentes sobre a restauração da catedral deixaram as pessoas bastante entusiasmadas e nós nos beneficiamos com isso!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Nunca gostei de lavanda mesmo...";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Tudo bem! Vamos consertá-la.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Isso é um ultraje.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Senhor, isso parece chantagem! Vamos usar pedras em vez de madeira, para não precisarmos lidar com essa rainha!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Certo, não vou me esquecer, querido.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Rei da madeira";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Pode deixar comigo.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Se eles não estão felizes, acabarão não vindo mais.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "É verdade que os comerciantes se beneficiariam com um lugar dedicado a eles além do mercado. Uma guilda comercial parece ser o edifício ideal, senhor.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Maravilhoso, senhor! Obrigado por concordar. Ficaremos eternamente gratos!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Um governador moderno como o senhor deveria ter aceitado o pedido dos comerciantes...";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Senhor, venho como representante dos comerciantes. Para mostrar o quanto estamos decepcionados, ficaremos um tempo sem vir à sua cidade! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Senhor, a federação de comerciantes exige a construção de edifícios que correspondam às suas funções.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Falta de espaço";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Quando você acaba de acordar, seu conselheiro traz uma notícia terrível! A cidade está sendo invadida por camundongos! São menos perigosos que ratos, sem dúvida, mas mesmo assim... precisamos fazer alguma coisa!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Senhor, fundamos a Academia de Gatos Caçadores de Camundongos, porém... precisamos cuidar deles e alimentá-los. Precisamos fornecer peixes em quantidade suficiente para a academia.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Agora já temos peixes suficientes para garantir o treinamento. Alguns recrutas já apanharam vários camundongos, senhor.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Senhor, devemos recompensar os melhores gatos com erva-do-gato, para reduzir o estresse.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "A eficácia desses devoradores de camundongo aumentou perceptivelmente, senhor. Os professores estão fazendo um bom trabalho de treinamento com os gatos. Restam poucos camundongos.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Os camundongos já não são um incômodo, senhor. Parabéns pelas escolhas que levaram a este resultado.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Traçar um plano.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Mesmo assim, você decide tomar café da manhã. Enquanto come a torrada, vê um camundongo no canto do quarto! Eles estão até no castelo! E, de repente, você vê Chouquette, seu gato fiel, saltando. Ele come o camundongo rapidamente. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Isso faz você ter uma ideia. Você diz ao seu conselheiro para pegar o máximo de gatos que conseguir e treiná-los a caçar camundongos. Até os gatos domesticados. Você quer treiná-los para se livrar dos camundongos.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Voltar a dormir.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Quando você acorda, há tantos camundongos em todos os lugares que as pessoas nem conseguem andar direito. Todos os habitantes ficam mais devagar!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Depois de um bom tempo, os camundongos finalmente vão embora. Fugir das próprias responsabilidades indo dormir nem sempre é uma solução.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Gato e rato";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "No lado direito você pode ver as influências ativas no momento.\nAlgumas influências estão ativas temporariamente e podem mudar durante um cenário.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Meu senhor,\ncom todo o respeito, você não deve ter notado como os habitantes estão infelizes. Isso não pode continuar.\nAlém disso, nosso produtos não estão sendo processados direito.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Agora você sabe quais as influências que estão afetando a cidade. Você deve ter notado que os bandidos estão na área e a felicidade geral da cidade está reduzida por causa deles.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Visite o menu pausar para ver as influências atuais neste mapa.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Você poderia fazer o favor de visitar a serraria? \nTemos de parar a produção! Temos pouca madeira e muitas tábuas prontas.";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Para obter mais informações sobre um prédio, você deve visitá-lo!\n\nO menu de contexto mostra informações muito úteis sobre o prédio, seus trabalhadores e as cadeias de produção relacionadas. Enquanto você estiver neste menu, o jogo é pausado.";
"T_GAME_QUEST_MIL_TUT_03_START" = "A serraria precisa de mais lenhadores para produzir tábuas com mais eficiência. Devemos pausar a serraria até termos construído mais cabanas do silvicultor e acumularmos mais prédios de recursos.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Você deve evitar que os recursos bloqueiem o depósito, meu senhor.\nSempre que precisar de espaço no depósito, você pode usar o recurso destruir recursos no menu de estatísticas.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Vá para o menu do depósito.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Você deve evitar que os recursos bloqueiem o depósito, meu senhor. \nSempre que precisar de espaço no depósito, você pode usar a habilidade destruir recursos na aba do depósito no menu do jogo.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Destrua tábuas até o estoque ficar abaixo de 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Destrua algumas tábuas para abrir espaço no depósito.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Você não acreditou nas minhas ameaças, governador. \n\nDaqui em diante, a coisa ficou séria!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Você construiu uma bela cidade aqui. Que pena que ela está no meu território!\nTragam-me joias e roupas! E andem logo, ou sua cidade já era...";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Impressionante como uma pequena ameaça pode funcionar. Nunca pensei que você fosse mesmo enviar esses produtos para mim.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Pague um tributo aos bandidos.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Meus rapazes estão entediados no momento. Vou enviá-los em uma pequena excursão... \n\n...ATÉ VOCÊ!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Como você pode ver, eu tomarei o que quiser!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Bom dia, meu senhor.\n\nEstou aqui por ordem do Rei. Ele me enviou para lhe ensinar a arte da guerra.\n\nSeu pequeno problema com os bandidos deve estar resolvido em breve, senhor.";
"T_GAME_QUEST_MIL_TUT_10_START" = "\nO quartel é a base de suas operações militares na área, e com ele podemos construir torres de guarda e abastecê-las. Os soldados só lutam bem quando estão bem abastecidos.\nVocê deve colocar as torres de forma a cobrir o máximo possível da cidade.\n\nConstrua um quartel e uma torre de guarda, meu senhor.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Você realmente recebeu ajuda de um cavaleiro...\nEstou começando a tremer de medo.\n\nVamos ver o que seus militares podem fazer contra meus rapazes...\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Os bandidos estão incendiando nossos prédios. Onde estão os bombeiros quando precisamos deles?!\n\nQuando você quiser saber onde está um habitante no momento, selecione a opção "encontre meu habitante" no menu de contexto do prédio.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Aqui você pode ver o que os trabalhadores estão fazendo no momento.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Produza cerveja e salsichas.";
"T_GAME_QUEST_MIL_TUT_14_START" = "Nossos soldados precisam de cerveja para criar coragem, meu senhor.\n\nPara produzir cerveja você deve ordenar a construção de um mosteiro e uma casa de lúpulo, senhor.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Nossos soldados precisam de cerveja, meu senhor.\nPara obter cerveja você deve ordenar a construção de um mosteiro e de alguns campos de lúpulo, senhor.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "A cervejaria do mosteiro precisa de vários recursos de outros prédios.\nA casa de lúpulo fornece lúpulo seco. A fazenda e o poço fornecem trigo e água.\n\nEntão os monges do mosteiro podem começar a produzir cerveja, meu senhor.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "No mosteiro você pode ordenar os monges a colher lúpulo dos campos ou começar o processo de produção de cerveja.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Construa um mosteiro e uma casa de lúpulo.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Construa um mosteiro e alguns campos de lúpulo.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Para a produção de salsichas, você precisará de uma fazenda de porcos e de uma oficina de açougueiro, meu senhor.\n\nNossos soldados adoram o sabor apimentado das salsichas. Os temperos que precisamos para as salsichas podem ser colhidos pelo fazendeiro no jardim de ervas.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "A oficina do açougueiro pode produzir carne normal, além das salsichas adoradas pelos soldados.\nIsso pode ser uma boa opção, para não depender da caça nas florestas.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Construa uma fazenda de porcos e uma oficina de açougueiro.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Acho que você deve praticar mais sua defesa!\nAté a próxima vez... e obrigado pelos recursos.\n";
"T_GAME_QUEST_MIL_TUT_16_START" = "Cerveja e salsichas!\n\nMeus rapazes adoram essas iguarias. Acho que você deve dividir comigo sua produção dessas delícias.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Você teve sorte desta vez, governador. Da próxima vez meus rapazes virão em maior número.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Defenda sua cidade";
"T_GAME_QUEST_MIL_TUT_17_START" = "A cidade precisa de mais melhorias. A maior parte da vila não está bem protegida. Devemos cobrir uma área maior da vila com torres de guarda.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Agora a maior parte da vila está sob a proteção dos nossos soldados. Aqueles bandidos não poderão roubar tão facilmente agora, meu senhor.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Cubra pelo menos 50% da vila com torres de guarda";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Se você quiser mais informações sobre os militares, sempre pode visitar a guia militar da tela de estatísticas.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Nossos soldados precisam de armas e armaduras!\nAs armas aumentam o poder de ataque e as armaduras aumentam a capacidade defensiva dos nossos soldados.\n\nPortanto, devemos construir um armeiro na cidade. Para fabricar armaduras, você também precisará de um curtume para obter o couro.\nAs peles dos animais serão fornecidas por um caçador ou açougueiro.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Construa um curtume e um armeiro.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Senhor,\né hora de aumentar o tamanho do seu exército. Assim você poderá enviar uma força-tarefa para destruir o acampamento dos bandidos.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Aumente seu exército";
"T_GAME_QUEST_MIL_TUT_21_START" = "Chegou a hora, governador!\n\nAgora vamos atacar aquele cruel chefe dos bandidos. O acampamento deles está escondido na floresta.\nVocê só precisa selecionar o acampamento dos bandidos e ordenar que um grupo razoável de soldados ataque.\n\n\nDesejo-lhe uma boa caça!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Destrua o acampamento dos bandidos";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Que bom encontrá-lo, meu senhor.\nAcabei de ser assaltado por bandidos pela terceira vez esta semana. Temos de fazer algo com esses demônios!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Uma grande vitória, meu senhor.\nMostramos a esses bandidos quem é que manda! A região está segura novamente, e o Rei ficará satisfeito. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Complete o treinamento básico e derrote os bandidos.";
"T_GAME_QUEST_NEW" = "Nova missão!";
"T_GAME_QUEST_NEW2" = "Nova missão:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Não temos tempo para isso.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Você está certo.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Muito bem, senhor, então não faremos nada a respeito deste pão horrível. Já posso ouvir as queixas sobre a qualidade da comida. Mas, de qualquer forma... Estou às suas ordens, senhor.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Senhor, o pão agora está uma delícia! O preço de venda também começa a subir.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = "“Se o trigo é o que o preocupa, é preciso começar pela raiz. Diga ao moendeiro para usar água mais limpa. E que os grãos sejam de boa qualidade.”\n\nO seu conselheiro repassa sua sabedoria para o padeiro e promete que o pão será de melhor qualidade.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Senhor, precisamos fazer alguma coisa. O pão não é mais o mesmo. Muitas pessoas vieram reclamar da qualidade. Precisamos mudar a receita.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Uma nova receita";
"T_GAME_QUEST_NOQUEST" = "Nenhuma missão disponível.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Rápido, vamos produzir escudos e armas. Se essas pessoas são perigosas, melhor estarmos preparados.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Governador, terminamos as preparações para a defesa da cidade.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Seus soldados relatam movimentos de tropas ao norte. É onde está localizado o maior deserto do reino.\n\nPorém, você sabe que ninguém é louco o suficiente para tentar atacar as suas fronteiras. Você decide ignorar esta ameaça. Seja o que o acaso quiser!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Alguns dias depois, os seus soldados relatam que um grupo de pessoas está vindo do deserto do norte. Estarão na cidade dentro de algumas horas.\n\nPodem ser só viajantes mas nunca se sabe, talvez sejam bandidos perigosos que vieram invadir o vilarejo!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Prepare as defesas.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Preparem as boas vindas.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "O Deserto do Norte";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "Um grupo de dez pessoas aproxima-se da cidade. Os soldados ficam de guarda, à espera de ordens.\n\nVocê deixa que se aproximem. O líder do grupo anda sozinho até às portas da cidade. "Bom dia, meu bom senhor, acabamos de atravessar o deserto do norte. Será que pode nos oferecer estadia por uma noite?"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Então venham para a nossa bela cidade. Vocês ficarão na pousada, temos espaço suficiente.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Embora o conselheiro o acompanhe até sua casa, você ainda está preocupado. Por que eles arriscaram atravessar o deserto, sendo que poderiam ter navegado pelo rio? Por que escolher uma estrada perigosa se não precisavam se esconder?\n\nTalvez seus espiões possam descobrir mais sobre eles. Ou talvez seja melhor esquecer e ir dormir.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Ir dormir.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Enviar um espião.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "O espião ficou acordado a noite toda e conseguiu escutar algumas conversas na pousada: os viajantes estão em fuga. Dizem que eles cometeram crimes em seu país, que fica do outro lado do deserto. O exército está atrás deles e eles já estão bolando um caminho para continuar fugindo.\n\nQual é a melhor solução?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Prender os viajantes.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Acabemos de receber uma mensagem do rei. Criminosos perigosos escaparam da prisão em um país vizinho. São cerca de dez criminosos e eles roubaram um objeto precioso. Você acha que eram os viajantes que estiveram aqui alguns dias atrás?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Enviar uma mensagem ao rei.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Manter segredo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Mandarei uma mensagem ao rei para avisar que eles passaram por nossa aldeia. Talvez consigam achá-los.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Senhor! O Exército Real conseguiu capturar esses perigosos indivíduos. Eles recuperaram o tesouro roubado.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Obrigado pela sua ajuda, governador. Essas pessoas roubaram uma das minhas preciosas joias. Planejavam vendê-la no mercado negro. O senhor fez a coisa certa me informando da presença deles na sua cidade.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Muito bem, senhor. Caso alguém pergunte, diremos que não sabemos.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Faz tempo que algo fora do comum não acontece na cidade. Mas hoje você tem o pressentimento de que algo vai mudar.\n\nE você tinha razão! O seu conselheiro trouxe uma carta dos viajantes procurados pelo Exército Real. A mensagem diz: \n\n"Agradecemos por não nos denunciar, governador. Fomos vítimas de um golpe e toda a nossa família corria perigo. Ao manter segredo sobre nossa chegada ao seu vilarejo, tivemos tempo para achar a prova da nossa inocência. Sem o senhor, isso não teria sido possível. Portanto, aceite este presente de agradecimento. O senhor é um bom governador."";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Libertei os viajantes como o senhor ordenou. Espero que não seja uma má decisão.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Os viajantes lhe agradecem por sua gentileza e prometem que, uma vez provada sua inocência, eles lhe darão uma recompensa como prova de sua gratidão.\n\nVocê espera que tenha tomado a decisão certa e que os viajantes não estejam mentindo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Já se passaram vários meses desde as últimas notícias sobre os viajantes. Às vezes, você pensa no assunto. Você não teve problemas com o rei, mas também não recebeu a prometida recompensa.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "De repente, numa manhã ensolarada, o seu conselheiro chega e entrega um pacote com uma carta. A carta contém uma mensagem dos misteriosos viajantes, na qual expressam sua gratidão. No pacote está a recompensa prometida. Prestígio e ouro.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Você fica feliz por ter feito a decisão correta e por não ter sido enganado.\n\nO seu conselheiro relata que você se tornou um herói para os viajantes e que eles o aplaudem. Que bela época para ser um Governador.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Senhor, os viajantes saíram da pousada de manhã cedo e pareciam estar com pressa.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Os viajantes estão à espera da sua resposta. Alguns parecem agressivos, outros estão com medo.\n\n"Não posso oferecer estadia, viajantes. Não temos espaço suficiente para todos esta noite."\n\n“MENTIROSO!”, grita um dos viajantes de repente enquanto corre levantando a espada.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Protejam o Governador!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Depressa, senhor! Rápido! Vamos sair daqui!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Você conseguiu se refugiar num esconderijo junto com o conselheiro, que parece estar em pânico: "Senhor, o que faremos?! Esses viajantes malditos estão destruindo nossa aldeia e não há nada que possamos fazer! Deveríamos ter preparado as nossas defesas em vez de fazer pão!"\n\nInfelizmente, a única coisa a fazer é esperar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "De manhã cedo, vocês arriscam sair do esconderijo. A aldeia não foi destruída. Aparentemente, os viajantes apenas nocautearam os guardas e roubaram provisões para seguir viagem.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Felizmente, foi uma decisão planejada, senhor. Com as armas e escudos que produzimos, poderemos nos defender. Sem dúvida.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Senhor, conseguimos capturar todos os viajantes. Nós os prendemos na cadeia para que o senhor possa tomar uma decisão.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Os viajantes estão ficando estranhos. Agora que estão presos, você se sente um pouco mais seguro. Porém, algo o incomoda.\n\nO que você precisa fazer?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Interrogá-los.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Notificar o rei.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Muito bem, senhor, vou fazer algumas perguntas a eles para esclarecer tudo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "O seu conselheiro está de volta e passa informações sobre os viajantes. \n\nEles fugiram de seu país de origem porque foram acusados injustamente. A prova de sua inocência está mais ao sul, em uma das cidades vizinhas.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Solte-os.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Aconselharei o rei para que o exército real venha e capture esses bandidos perigosos!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "O exército real está finalmente chegando. Você entrega a eles os viajantes. O rei envia a você uma recompensa por dar as informações necessárias para capturar esses indivíduos perigosos.\n\nA sua aldeia se recupera lentamente e você retorna calmamente às atividades de governador.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "O seu espião cometeu um erro e foi visto pelos viajantes. Ele agora é refém dos viajantes, que exigem um resgate para devolvê-lo com vida.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Vamos perder muito dinheiro, mas pelo menos nosso espião estará a salvo.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Obrigado, senhor, por pagar meu resgate! Estava com medo de morrer. É muito perigoso ser espião.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Excelente ideia. Devemos preparar comida para estas pessoas quando chegarem à nossa porta. Pão e peixe servirão.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Perfeito, agora tudo o que resta a fazer é esperar por eles.";
"T_GAME_QUEST_PLACE_STARTED" = "Agora é hora de construir o local apropriado para um evento desta magnitude!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Uh lá lá! Simplesmente incrível! E pensar que nada disso teria acontecido se os guardas tivessem sido zelosos. Você teve uma ideia maravilhosa quando aproveitou essa oportunidade! O festival promete ser um sucesso.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Plantar mais flores.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Isso não é necessário.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Lindo! As flores são mesmo incríveis. O cheiro delas me faz flutuar.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "O senhor é uma pessoa horrível. A nossa cidade teria ficado muito mais bonita com flores!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "A primavera chegou, meu senhor. Acho que a aldeia merece algumas flores.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Lindas pétalas";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "A serraria foi destruída pelo incêndio, meu senhor. Que tal dar a ordem para a reconstrução? Precisamos do prédio para produzir tábuas!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Reconstrua a serraria.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Não dê nada a ninguém.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Redistribua a renda entre os habitantes.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Invista o dinheiro nas minas.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Senhor, temos muito dinheiro nos cofres e uma redistribuição de parte dessa renda seria benéfica para a cidade.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Os habitantes souberam da sua decisão. Não estão contentes. Tente demonstrar mais compaixão pelo povo, senhor.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "A produtividade dos habitantes não é mais influenciada pela decisão que você toma sobre a redistribuição da renda. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "O senhor deixou os habitantes muito felizes! Eles estão radiantes!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Excelente iniciativa, senhor. Vamos começar a construir minas e extrair recursos.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Investir o dinheiro na construção de novas minas é provavelmente a melhor decisão que já tomamos. Poderemos nos desenvolver melhor com estes recursos.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "O senhor é muito generoso. Este dinheiro fará com que a vida deles melhore.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Redistribuição de renda";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Tivemos sorte, senhor. A plantação não foi afetada. Os javalis foram embora e não precisamos nos preocupar mais.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Os javalis selvagens destruíram a nossa plantação, senhor! Foram para a fazenda. Um verdadeiro massacre.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "A população está desolada com esta perda e sua felicidade e produtividade foram afetadas.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Senhor, as nossas plantações estão começando a se recuperar do dano causado pelos javalis algum tempo atrás. Estão voltando a crescer e as pessoas começam a se esquecer do que aconteceu.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "A população está sendo negligenciada por consequência da sua decisão! Espero que a plantação não seja danificada por estes javalis.";
"T_GAME_QUEST_REWARD" = "Recompensa:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Receba as boas-vindas, intendente!\n\nVeja só este litoral! Espero que sua cidade seja digna desta vista maravilhosa!\nCuide bem dos seus habitantes e não esqueça de pagar os tributos ao seu rei, para que você continue a me servir!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Empréstimo do tesouro do rei";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Governador, \nSe você não tiver condições financeiras, a coroa pode lhe fazer um empréstimo.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Eu lhe dou as boas-vindas à nossa humilde aldeia, Governador!\nA região é dividida por uma cordilheira rochosa. Há depósitos de minério no sudoeste da cordilheira, milorde.\n\nNão vejo a hora de trabalharmos juntos.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Bem-vindo, Governador!\n\nEu sou a Rainha Frigyth, regente deste reino. Eu pedi sua ajuda para que faça esta cidade alcançar a verdadeira grandeza. A terra é rica em recursos, então não deve ser difícil. Não me decepcione.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Milorde, veja só a infinita vastidão desta região. A terra é plana em todas as direções! Poderemos construir uma cidade grande aqui num futuro próximo, não acha?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Saudações, governador.\nNas margens desse rio poderoso, temos muitas chances de prosperar. A área de pesca é muito vasta, e as minas estão cheias de ouro. Aqui podemos estabelecer uma cidade esplêndida em nome do Rei.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Maravilhoso, governador.\nEsse cânion guarda uma das mais importantes rotas entre as montanhas. A cidade fica numa posição ideal para oferecer um pouso agradável para mercadores de passagem por aqui. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Milorde, abaixo dessas cachoeiras há áreas de pesca em abundância. Além disso, os amplos depósitos de minérios tornam essa região ideal para o estabelecimento de nossa cidade.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Bem-vindo à Fortaleza Gélida, milorde.\nNão é fácil para os habitantes chegar até o castelo, mas a vista das planícies vale a pena. Suas terras parecem infinitas daqui.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Bom-dia, meu senhor.\n\nOlhe as sucessivas colinas das suas terras. Não é uma vista magnífica? Este é um belo lugar para começar uma cidade, meu senhor.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "Eu lhe desejo um bom dia, milorde.\n\nBem-vindo à nossa pequena cidade. Dizem que o fosso foi criado por uma estrela cadente. Espero que isso nos traga sorte. O rei já escreveu dizendo que terá tarefas para nós em breve.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Homenagem ao rei.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festival para os moradores da cidade.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Doação para os pobres.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Festival da cerveja na cidade.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Venda porcos no mercado.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Comércio no mercado de animais.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Venda os animais no mercado.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Rações para o exército.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Equipamento para os soldados do Rei.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Defenda-se dos ataques dos bandidos.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Destrua os acampamentos dos bandidos.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Queira aceitar nossas boas vindas, administrador! Dê uma olhada neste litoral! Espero que sua cidade seja merecedora desta bonita vista! Cuide bem de seus moradores e não se esqueça de prestar homenagem ao rei, para que você possa continuar a me servir!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Que lugar ótimo para pescar. Não concorda, meu Senhor administrador? Certamente não faltará comida aqui! Gostaríamos muito que você organizasse um festival de vez em quando - se puder pagar por ele, após prestar sua homenagem ao rei!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Oh, querido, obrigado por se estabelecer aqui! Este lago é realmente bonito! Os moradores certamente ficarão felizes aqui, se cuidar bem deles! Ah, e não esqueça de subornar o rei para que possamos ficar aqui para sempre!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Meu senhor, foi uma decisão sábia mudar para este vale do rio! Os moradores certamente ficarão satisfeitos quando você ajudar os pobres e necessitados! Contudo, com toda sua generosidade, sugiro que você não negligencie seu encargo para com o rei!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Seja bem-vindo! Meus homens têm prazer em servi-lo na construção de sua sede de poder aqui neste ponto fundamental de nossa terra! Este será um ano de celebração! Vida longa ao rei e a você também!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Meu prezado senhor administrador, eu já ouvi muito sobre você! É por isso que escolhi você para fazer esta cidade prosperar na encosta de meu castelo! É melhor você começar imediatamente! Adeusinho!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Meu senhor, temos a missão de construir uma cidade perto deste leito seco de rio. O rei nos dará uma bela recompensa se cumprirmos nossa missão.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Meu senhor, a planície onde fica o seu castelo é também um lugar perfeito para uma pequena cidade. O rei enviou várias missões que precisam ser cumpridas.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Um arquipélago foi descoberto perto da costa. Ordeno que colonize essas ilhas em meu nome!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Meu senhor, olhe só essa bela região da floresta. Construir uma cidade aqui vai ser difícil, mas pelo menos há veados e madeira em abundância. Isso deve tornar mais fácil cumprir as tarefas ordenadas pelo rei.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Meu senhor, pagar nossas obrigações de tributo ao rei será difícil por causa do inverno rigoroso. Vamos começar a trabalhar imediatamente…";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Que vale maravilhoso! Há recursos suficientes para pagar tributos ao rei. Mas tome cuidado, é preciso planejar devido ao pouco espaço para construir.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Esta é uma ilha muito bonita! Estou muito feliz por termos vindo para cá. Devemos começar a planejar nossa vila imediatamente!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Dá para ver sem problema toda a área daqui. Infelizmente, o inverno dura bem mais tempo a essa altitude, o que influencia muito o crescimento da plantação.\n\nUma sábia decisão seria fazer um estoque no verão.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Saudações! Estávamos à sua espera! Meus homens já exploraram a região e descobriram muitos filões de minério.\n\nÉ melhor começar a minerar imediatamente antes que alguém o faça!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Que bom tê-lo aqui, milorde.\n\nO antigo governador fugiu. Enquanto fugia, ele gritava que esta região é amaldiçoada.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Seu predecessor não estava totalmente enganado. A agricultura é muito difícil, não cresce praticamente nada aqui. Até a água é escassa. Mas tenho certeza que o senhor encontrará uma solução.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Os seus habitantes estão um pouco insatisfeitos com suas vidas religiosas, meu senhor. Seria possível construir uma igreja na cidade?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Obtenha um alto nível de felicidade religiosa.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Espera mesmo que um homem de minha estatura caminhe nessas estradas de terra, governador? Construa estradas dignas de uma cidade de verdade!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Construa estradas de pedra na cidade.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Construa estradas de terra na cidade.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Fizeram um trabalho bem precário aqui, meu senhor. Todas as construções precisam de reparos urgentes.\nPrecisamos contratar um carpinteiro para consertar todas as construções antes que elas desabem de uma vez.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Construa uma oficina de carpintaria. Obtenha um alto nível de satisfação com a condição dos construções.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Governador! Por que a sua cidade ainda está tão pequena? Estamos ficando atrás do arquiduque! \n\nPerderemos a aposta se você não conseguir aumentar a população da cidade logo!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Aumente a população da vila.";
"T_GAME_QUEST_SCEN10_14_DESC" = "As novas famílias na cidade fizeram uma viagem longa e cansativa e estão famintas. Vamos fazer um banquete para elas e celebrar oficialmente o início da aposta, meu senhor!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Produza alimentos em quantidade suficiente para alimentar a vila.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Devemos começar a negociar com os mercadores ambulantes. Ter mercadores na cidade atrairá visitantes e aumentará a reputação da cidade, meu senhor!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Ganhe muito dinheiro negociando com o mercador.";
"T_GAME_QUEST_SCEN10_16_DESC" = "A quantidade de impostos coletada é risível! Talvez você deva construir um Tesouro para aumentar a arrecadação fiscal.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Construa um Tesouro e colete impostos em número suficiente.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Joias, preciso de joias! Mas não sei como você poderá entregar joias se nem mesmo construiu uma oficina de ourives.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Construa uma oficina de ourives e comece a produção de joias.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Excelente, senhor. Agora pode me enviar uma carruagem cheia de joias.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Entregue joias para o mercador.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Meu senhor, nossa prioridade é o estoque de comida. Precisamos de pescadores e caçadores.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Construa algumas cabanas de pescador e de caçador.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Meu bom governador, não posso apoiar suas iniciativas se o senhor não construir um mercado.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Você precisa de um mercado para expandir a vila.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Meu senhor! Já construiu a oficina de ferramentas? O arquiduque já começou a produção de ferramentas!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Construa uma oficina de ferramentas e comece a produzi-las.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Com todo esse trabalho, gostaríamos de ter um lugar para relaxar, encontrar os amigos e tomar uma taça de suco de uva. Uma taverna seria ótimo.\n\nQuando o senhor puder, é claro, meu senhor.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Obtenha alta satisfação com tavernas.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Temos casas o suficiente, meu senhor? Todos os novos trabalhadores que estão vindo para a cidade precisam de um teto, não acha?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Construa 2 casas grandes e 4 normais.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Construa mais casas grandes.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Construa mais casas pequenas.";
"T_GAME_QUEST_SCEN10_7_DESC" = "A cidade precisa de entretenimento extravagante. Um campo de justa, por exemplo. Disponibilize esse tipo de entretenimento antes que visitantes cheguem.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Alcançar alta satisfação com o entretenimento.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Obtenha alta satisfação com um campo de justa.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Meu senhor, talvez possamos embelezar essa cidade horrível com estátuas e decorações. Vamos fazer isso antes que o rei volte a nos visitar.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Embeleze a cidade com decorações.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Bom dia, governador. Tem interesse em negociar?\n\nTenho necessidade urgente de uma grande quantia de roupas para fazer uma lucrativa transação com o arquiduque. Pagarei muito bem se você pude entregar o que preciso.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Entregue um carregamento de roupas para o mercador.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Isso é um desastre completo, governador! O Arquiduque de Canterborough nos ultrapassou e terminou sua cidade antes que pudéssemos terminar a nossa!\n\nContei com o senhor e agora estou extremamente decepcionado. Talvez ganhar essa aposta fosse mesmo um sonho impossível. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Excelente, meu bom governador! Derrotamos o arquiduque na aposta de construir e expandir nossa cidade! Ganhamos a aposta!\nEstou impressionado com o seu desempenho e pessoalmente me certificarei de que você receberá uma recompensa digna do rei. Também dou a você o título de Duque, com todos os direitos e privilégios pertinentes.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Meu leal servo, acho que cobicei mais do que me foi possível.\n\nFiz uma aposta com o Arquiduque de Canterborough de que conseguiria transformar a cidade mais precária do reino numa próspera metrópole antes que ele fizesse o mesmo com sua cidade mais precária.";
"T_GAME_QUEST_SCEN12_01_START" = "Quanta gentileza da sua parte em nos visitar. Venho lhe dar as boas vindas em nome de todos os monges presentes. Este é o mosteiro de Tardishingen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Bem-vindo a Tardishingen, meu senhor.\nCertamente poderemos lhe ajudar a encontrar o presente perfeito para o Rei. Contudo, estamos enfrentando problemas com os bandidos. Talvez você possa nos ajudar também.";
"T_GAME_QUEST_SCEN12_02_START" = "Quer coisa cruel para se fazer!\n\nAlguém roubou nossa madeira! Não podemos armazenar nossa cerveja sem madeira para os barris.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Muito obrigado, meu Senhor! Agora poderemos construir barris de cerveja de novo.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Construa cabanas de silvicultor.";
"T_GAME_QUEST_SCEN12_04_START" = "Meu senhor, a cidade precisa crescer para podermos completar nossas tarefas. Primeiro devemos garantir uma economia estável. Para isso, precisamos produzir ferramentas.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Esplêndido, meu senhor. Agora podemos fazer a cidade crescer ainda mais.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Organize uma cadeia de produção de ferramentas.";
"T_GAME_QUEST_SCEN12_05_START" = "A cidade precisa ser abastecida com comida, meu senhor. Temos uma fazenda, mas não temos um moinho de vento nem padarias.";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Muito bem! A vila está crescendo para ser uma verdadeira cidade.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Organize uma produção estável de comida.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "Nãão! Aqueles bandidos traiçoeiros! Eles destruíram o mosteiro!";
"T_GAME_QUEST_SCEN12_06_START" = "Meu senhor, o mosteiro está nesta colina há quatro séculos. Seria terrível se o prédio fosse destruído por aqueles bandidos cruéis. Há semanas eles estão ameaçando destruí-lo...";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Muito bem, meu senhor.\nO mosteiro sobreviveu a todos os ataques dos bandidos e conseguimos produzir a cerveja perfeita! \n\nE que bebida refinada! Absolutamente maravilhosa.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Proteja o mosteiro.";
"T_GAME_QUEST_SCEN12_07_START" = "Você deve reconstruir o mosteiro ou nunca poderemos terminar nossa tarefa a tempo.";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Muito bem, meu senhor! O mosteiro foi reconstruído! Podemos continuar nossa tarefa atual: fazer a cerveja perfeita!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Reconstrua o mosteiro.";
"T_GAME_QUEST_SCEN12_08_START" = "Temos que garantir que o mosteiro está bem defendido, meu senhor! Se colocarmos uma torre de guarda junto a ele, isso aumentará muito a proteção.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Construa uma torre de guarda ao lado do mosteiro.";
"T_GAME_QUEST_SCEN12_09_START" = "Você sabia que os soldados adoram salsichas?\nVocê poderia construir uma fazenda de porcos e uma oficina de açougueiro para produzir algumas.";
"T_GAME_QUEST_SCEN12_09_START2" = "Meu senhor,\n\nrecomendo que você ordene a construção de uma fazenda de porcos e uma oficina de açougueiro. Assim poderemos produzir carne para os habitantes e as salsichas adoradas pelos soldados.";
"T_GAME_QUEST_SCEN12_10_START" = "Humm, acho que devemos dar algumas espadas e armaduras a esses pobres soldados. Isso melhoraria muito a sobrevivência deles em combate. Para isso, precisamos de um armeiro e um curtume.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Conseguimos, meu senhor! Agora podemos fabricar armaduras para nossos soldados.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Construa um armeiro e um curtume.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Construa um armeiro.";
"T_GAME_QUEST_SCEN12_11_START" = "Agora que temos um armeiro e um curtume, seria bom começar a produzir equipamentos.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Ótimo, meu senhor! Os soldados agora desempenharão melhor em combate.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Fabrique equipamentos para os soldados.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Muito bem, meu senhor. Agora o mosteiro deve estar protegido de futuros ataques dos bandidos.";
"T_GAME_QUEST_SCEN12_15_START" = "Não conseguimos reconstruir os campos de lúpulo destruídos.\n\nVocê poderia ser bonzinho e colocar alguns?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Construa alguns campos de lúpulo.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Construa uma fazenda e campos de lúpulo.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Hahaha. Seu humilde mosteiro já era. Agora eu governo esta região!";
"T_GAME_QUEST_SCEN12_16_START" = "Você acha que consegue proteger aqueles monges? Acho que não. Vou te mostrar como vou esmagar esse seu mosteirinho.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Arghhh! Da próxima vez você pagará por isso! Ainda não terminamos...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Afaste todos os ataques.";
"T_GAME_QUEST_SCEN12_17_START" = "Meu senhor, meus colegas monges e eu começaremos imediatamente a produção da melhor cerveja do país.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Terminamos o processo de produção, meu senhor. Muitos tipos diferentes de cerveja foram criados. Agora devemos escolher as melhores e refiná-las ainda mais.";
"T_GAME_QUEST_SCEN12_18_START" = "Nosso mestre cervejeiro disse que precisamos melhorar nosso equipamento de produção para refinar a cerveja ainda mais. Queremos agradar ao rei, não? Ela deve ser a melhor cerveja do país...";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Excelente, meu senhor! Agora precisamos de mais dos melhores ingredientes.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Melhore o mosteiro para o Nvl 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Senhor, a cerveja está quase pronta, mas ainda estão faltando alguns ingredientes. Ervas e um pouco de ouro em pó seriam perfeitos para finalizar o produto.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Entregar ervas e pepitas de ouro ";
"T_GAME_QUEST_SCEN12_20_START" = "A cerveja deve fermentar um pouco.\n\nEla não deve ser perturbada por influências externas, o processo de fermentação da cerveja precisa de descanso.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Está pronto, meu senhor. Posso lhe apresentar a cerveja perfeita?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Defender o mosteiro até que o processo de fabricação esteja terminado.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Quero lhe agradecer pessoalmente, administrador.\nEste foi mesmo o presente perfeito para mim. Eu não sabia que você conhecia minha fascinação por cerveja.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Crie a cerveja perfeita para o Rei.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Prepare a cidade para a chegada do Rei. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Você acha que conseguiria me enganar? Estou decepcionado que você não tenha conseguido administrar uma pequena cidade.\n\nEu administro um reino inteiro, mas não tenho de enganar ninguém!";
"T_GAME_QUEST_SCEN13_01_START" = "Vou inspecionar minhas propriedades no ano que vem.\nSua famosa cidade deve ser o ponto alto da minha viagem!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Estou muito satisfeito com você!\nVocê sabe mesmo como administrar bem uma cidade, e pode contar com minha mais alta consideração.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Passe pela inspeção do Rei.";
"T_GAME_QUEST_SCEN13_02_START" = "Saudações, meu senhor administrador! Decidi vir à sua cidade mais cedo, para conhecer sua magnífica cidade!\n\nCertamente vocês estavam esperando pela minha chegada.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Não deixe que o Rei desconfie de nada.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Em primeiro lugar você deve recomeçar a produção de recursos!\n\nContrate novamente o silvicultor e restaure a serraria para recomeçar a produção.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Muito bem, meu senhor.\nMas não temos tempo para descansar.";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Contrate um silvicultor e restaure a serraria.";
"T_GAME_QUEST_SCEN13_05_START" = "Ah não! Por causa dos bandidos na floresta, a cidade está totalmente destruída.\n\nDevemos começar a reconstrução imediatamente!";
"T_GAME_QUEST_SCEN13_06_START" = "O mercado foi incendiado e precisa ser reconstruído!\n\nTemos necessidade urgente de produtos para nos prepararmos para a chegada do Rei.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Também precisamos de um carpinteiro, meu senhor. Muitos prédios precisam de reparos urgentes!";
"T_GAME_QUEST_SCEN13_07_START" = "Precisamos restaurar o tesouro, para que o cobrador de impostos continue seu trabalho. Precisamos de moedas urgentemente para os reparos!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Devemos usar os impostos para pagar pelos consertos necessários.";
"T_GAME_QUEST_SCEN13_08_START" = "Você deve restaurar as casas da cidade e construir novas casas para trazer mais trabalhadores à cidade.\nPrecisamos recomeçar a produção!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Agora temos espaço suficiente para mais trabalhadores, mas ainda não terminamos.";
"T_GAME_QUEST_SCEN13_09_START" = "Isso é um desastre!\nSomente podemos remendar os lugares que o Rei vai visitar e esperar que ele não desconfie de nada.\n\nAproveite bem o tempo enquanto o Rei descansa!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Espere até que o Rei anuncie qual o primeiro lugar que vai visitar.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "O Rei avistou bandidos e ficou desconfiado! Temos que tomar mais cuidado...";
"T_GAME_QUEST_SCEN13_10_START" = "O Rei quer explorar as florestas.\nPrecisamos destruir os acampamentos dos bandidos antes que ele chegue lá!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Foi por pouco! Mas ainda não acabou...";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Destrua todos os acampamentos dos bandidos. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Ah não! Não conseguimos enganar o Rei.\nAgora ele está desconfiado, não podemos cometer outro erro!";
"T_GAME_QUEST_SCEN13_11_START" = "O Rei quer passear pela cidade.\nSe ele vir habitantes insatisfeitos, certamente vai perceber que há alguma coisa errada.\n\nPrecisamos construir uma estátua do Rei!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Excelente! Todos os habitantes estão de bom humor durante o passeio do Rei.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Aumente a satisfação dos habitantes e construa uma estátua do Rei.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "O Rei não ficou impressionado!\nNão podemos cometer mais nenhum erro!";
"T_GAME_QUEST_SCEN13_12_START" = "O Rei vai inspecionar nossas tropas.\nCuide para que tenhamos uma impressionante guarda da cidade esperando pela chegada do Rei!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Essa guarda da cidade certamente vai impressionar o Rei!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Mantenha soldados suficientes empregados.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Falhamos, meu senhor. A festividade não atendeu aos padrões do rei e agora ele está insatisfeito. \n\nTalvez a honestidade fosse mesmo o melhor caminho...";
"T_GAME_QUEST_SCEN13_13_START" = "O Rei quer fazer uma grande festividade. Verifique se temos roupas e joias suficientes em estoque.\nSe falharmos, tudo estará perdido!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "A festividade foi um grande sucesso! Parece que conseguimos enganar o Rei.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Estoque roupas e joias.";
"T_GAME_QUEST_SCEN13_14_START" = "Percorrer as suas ruas com todos os meus produtos preciosos é muito perigoso para mim!\n\nVocê vai sozinho!";
"T_GAME_QUEST_SCEN13_15_START" = "Agora que você derrotou os bandidos, será um prazer visitar sua cidade e fazer negócios novamente.";
"T_GAME_QUEST_SCEN13_16_START" = "O mercador é um covarde, mas ele falou a verdade!\nA floresta ao redor da cidade é um lugar perigoso. Devemos treinar guardas para ficar de olho nos bandidos.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Você construiu a base para a defesa da cidade, meu senhor. Mas devemos ir além dela.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Construa um quartel e uma torre de guarda.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Ah não! Os bandidos ultrapassaram a defesa? O Rei não vai gostar de saber disso. ";
"T_GAME_QUEST_SCEN13_19_START" = "Os bandidos não ajudam a passar a imagem de uma cidade segura.\nNão deixe que muitos ataques aconteçam durante a inspeção ou tudo estará mesmo perdido!";
"T_GAME_QUEST_SCEN14_01A_START" = "Meu senhor, você não acha que esse homem está agindo de forma estranha?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Envie tecidos.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Meu senhor, falhamos em nossa missão!\nO conselheiro médico era um charlatão e levou todo o ouro que tínhamos no tesouro.\n\nMas tivemos sorte, e descobrimos a cura no laboratório dele...";
"T_GAME_QUEST_SCEN14_01_START" = "Bom dia, meu senhor. O reino está sendo devastado pela peste.\nAté mesmo o Rei está doente! Teremos de apoiar o conselheiro médico da corte para produzir logo uma cura. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Encontramos a cura a tempo, meu senhor!\n\nEla será administrada ao Rei imediatamente. São boas notícias para o reino!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Encontre uma cura para o Rei.";
"T_GAME_QUEST_SCEN14_02A_START" = "Há algo errado, meu senhor. Esse conselheiro médico está pedindo coisas estranhas. Tenho um mau pressentimento...\n\nDevemos ter cuidado com esse homem.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Eu levarei a cerveja ao médico, quando você ordenar.\nEspero que ele nos forneça uma cura logo. O rei não tem muito tempo restante!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Entregue a cerveja.";
"T_GAME_QUEST_SCEN14_02_START" = "Creio que uma cervejaria no mosteiro seria a melhor forma de obter cerveja para o Rei.\n\nTomara que a cerveja alivie o sofrimento do Rei.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Creio que uma cervejaria no mosteiro e uma fazenda de lúpulo seria a melhor forma de obter cerveja para o Rei.\n\nTomara que a cerveja alivie o sofrimento do Rei.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Muito bem, meu senhor! Os monges vão nos ajudar com a cerveja. O Rei ficará satisfeito.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Construa um mosteiro.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Construa um mosteiro e uma casa de lúpulo.";
"T_GAME_QUEST_SCEN14_03_START" = "Precisamos de uma fazenda de porcos para entregar os porcos ao conselheiro médico!\nVocê deve ordenar a construção imediatamente, meu senhor.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Esplêndido, meu senhor. Agora podemos começar a criar porcos.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Construa uma fazenda de porcos.";
"T_GAME_QUEST_SCEN14_05_START" = "Meu senhor, precisamos de um quartel na cidade. Temos que manter a lei e a ordem nestes tempos difíceis.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Meu senhor! Eu sabia!\n\nO conselheiro médico é um charlatão. Ele tinha a cura para o rei todo esse tempo.\nParece que ele estava infectando o país com essa doença. \n\nTomei a liberdade de ordenar que os guardas o prendessem.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "Isso é um absurdo!\n\nComo ousam me prender? Sou o conselheiro especial do Rei. \nVocês não podem fazer isso...";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Estou decepcionado com você, governador!\n\nNa noite passada tive uma visão! Ela mostrou que sua incompetência trará grande desgraça a esta cidade.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Governador! Meu nome é Rasiksin, clarividente e conselheiro médico para o Rei.\nPrecisarei de todo o apoio que puderem me dar!\nPara começar: entreguem-me o máximo de ervas medicinais assim que possível!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Vejo que vocês produziram todas as ervas de que preciso.\n\nTive uma visão na noite passada, ...que mostrava que vocês não desapontariam o Rei.\n\nAgora ordenem a seu conselheiro que me envie as ervas e saia da minha vista. Tenho trabalho a fazer.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Envie as ervas.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Não deveria ter contado com você, governador! Minhas visões me mostraram que sua incompetência trará desastre a esta cidade! Você desapontou ao Rei e a mim, governador!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Preciso de tecidos para filtrar a cura. Vocês devem produzir tecidos para mim. E façam rápido, para eu começar a filtrar logo.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "É bom ver que não está desperdiçando o meu tempo, governador!\n\nAgora ordene a entrega dos recursos! Sou uma pessoa muito ocupada.";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Produza tecidos.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "A cura deve ser refinada para produção em massa. O melhor líquido deve ser a cerveja. \n\nAo trabalho!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Já não era sem tempo! Entregue no meu laboratório.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Produza cerveja.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Não... é tarde demais! Agora a próxima desgraça atingirá a cidade.\n\nA culpa é sua!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Temos de tomar medidas mais drásticas para salvar o Rei!\n\nPreciso de porcos para sacrificar aos deuses tradicionais.\nTalvez isso ajude...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Há quanto tempo, governador. Que bom que se importou em aparecer...";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Entregue os porcos.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Eu preciso... hã... digo, o Rei precisa de fumo especial de cachimbo para aliviar a sua dor.\n\nEntregue-me um baú cheio de moedas, para comprar remédios!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nDê-me isso! Eu... hã, digo, o Rei gostará de receber seu remédio logo. Ele sente muita dor.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Entregue o dinheiro.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Descobri que as roupas do Rei o estão deixando doente. Ele precisa de novas roupas feitas com um material especial.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Finalmente você chegou com as roupas. O Rei já estava ficando impaciente.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Entregue as roupas.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Não consigo mais trabalhar neste laboratório velho!\n\nConstrua uma torre de guarda para mim, que eu possa converter em um maravilhoso laboratório. Ele deve ficar em uma torre, gosto de torres.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nTomarei esta torre em nome do Rei. Este deve ser o meu novo laboratório. Agora saia da minha vista!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Construa uma torre de guarda.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Está faltando mais uma coisa, governador.\n\nPreciso de barras de ouro para finalizar a cura. Traga-me algumas barras de ouro.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "Enfim! Agora só preciso de algum tempo para refinar a cura.\n\nTerei de fazer alguns preparativos para minha parti.. digo, para a administração da cura.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Entregue as barras de ouro";
"T_GAME_QUEST_SCEN15_01_FAIL" = "Tudo está perdido! Você deverá viver com a consciência de ter contribuído com a morte de tantos homens bravos...";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "Tudo está perdido! Sem os suprimentos cruciais, não há como chegar à vitória.\n\nVocê terá de viver com o peso de ter contribuído para a perda de muitos homens bravos!\n\nO Rei está fervendo de indignação…";
