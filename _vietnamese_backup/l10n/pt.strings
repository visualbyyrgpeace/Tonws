"T_GAME_QUEST_SCEN15_14_START_2" = "Está frio lá fora e os trabalhadores não têm roupas apropriadas. Seja benevolente e produza algumas roupas.\nNão podemos lhe pagar, mas trabalharemos com mais afinco que antes, meu senhor!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "Você é tão bondoso, meu senhor! Agora não teremos de tremer de frio.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Produza roupas para o povo.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Sem novas ferramentas o povo não poderá trabalhar com tanta eficiência quanto antes.";
"T_GAME_QUEST_SCEN15_15_START" = "Se você enviar algum ferro para o ferreiro, ele pode nos fazer novas ferramentas de trabalho. \nAssim poderemos trabalhar com mais eficiência nestes tempos difíceis.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "Sua bondade não tem limites, meu senhor!";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Tributo de ferramentas para os trabalhadores.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Seus habitantes ainda estão famintos, meu senhor. Se eles não receberem comida, o ambiente ficará pesado em breve.";
"T_GAME_QUEST_SCEN15_16_START" = "Os habitantes estão famintos, meu senhor.\nDeixe os suprimentos para nós e você nunca mais nos ouvirá reclamar!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "Que os deuses o abençoem!";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Entregue a comida aos habitantes.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "A insatisfação se espalha, meu senhor. Você deve fazer alguma coisa, e rápido!";
"T_GAME_QUEST_SCEN15_17_FAIL" = "Isso é mau, meu senhor. O moral está muito baixo. Temo que alguns habitantes possam fazer algo impensado.";
"T_GAME_QUEST_SCEN15_17_START" = "Meu senhor, toda a terra está sofrendo com a guerra!\nSe o moral dos habitantes diminuir, uma revolta pode acontecer.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Excelente, meu senhor. Você conseguiu satisfazer os habitantes e apoiar as tropas!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Não deixe a satisfação diminuir demais.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Mantenha um nível de felicidade maior do que 75% nos próximos dois minutos.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Não deixe a satisfação ficar baixa por tempo demais.";
"T_GAME_QUEST_SCEN15_19_START" = "Há rumores que esse incêndio não foi acidental, meu senhor.\nPosso descobrir mais ouvindo os rumores na taverna. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Os habitantes conversam muito na taverna. Tentarei descobrir mais sobre os incêndios na cidade.";
"T_GAME_QUEST_SCEN15_20_START" = "Dizem que há um incendiário que causa incêndios para incitar os moradores.\nPrecisamos treinar os guardas.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Agora só precisamos esperar...";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Podemos relaxar, meu senhor! Os guardas pegaram o incendiário e o prenderam.\nA cidade deve estar segura novamente!";
"T_GAME_QUEST_SCEN16_01_START" = "Saudações, meu honrado senhor. O Rei exigirá os tributos em breve.\nPrecisamos apoiar a agricultura local.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Excelente!\n\nDevido às suas habilidades econômicas, conseguimos atender às demandas do Rei, meu senhor.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Atenda às exigências do Rei.";
"T_GAME_QUEST_SCEN16_02_2_START" = "Ah não! O Rei exigiu outro lote de trigo.\nTalvez consigamos comprar o restante dos grãos necessários com o mercador!";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "Agora conseguimos! Envie o trigo agora parao Rei.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Envie mais trigo ao Rei.";
"T_GAME_QUEST_SCEN16_02_START" = "O Rei acabou de exigir trigo das vilas.\nPara atender a essa demanda enorme precisamos de mais fazendas!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Há trigo suficiente no estoque para fazer a entrega, meu senhor.";
"T_GAME_QUEST_SCEN16_03_START" = "O Rei precisa de recursos para construir mais depósitos.\nEnvie ao Rei os materiais exigidos.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Entregue os materiais exigidos agora para continuar com as outras entregas.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Entregue material de construção para um depósito.";
"T_GAME_QUEST_SCEN16_04_1_START" = "A primeira entrega estava estragada. Envie outro lote, assim que derrotarmos a doença na cidade.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Excelente trabalho, meu senhor! Há nova carne no estoque esperando para ser entregue.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Envie carne.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Envie carne quando a doença desaparecer.";
"T_GAME_QUEST_SCEN16_04_START" = "Agora o Rei está pedindo carne.\nIsso não deve ser difícil, com tantos caçadores.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Muito bom, meu senhor. Temos a quantidade exigida de recursos no estoque.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Construa mais cabanas de caçador e entregue carne.";
"T_GAME_QUEST_SCEN16_05_START" = "O Rei está planejando uma festividade. Por isso, devemos enviar as bebidas.\nEnvie cerveja e suco de uva para a corte real.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Muito bom, meu senhor. Temos roupas e joias suficientes no estoque.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Envie cerveja e suco de uva.";
"T_GAME_QUEST_SCEN16_06_START" = "O rei ficou muito satisfeito com nossas entregas.\nEle também quer que mandemos a comida.\n\nEnvie suco de uva e pão agora como tributo para as festividades reais. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Magnífico, meu senhor. Este foi o último tributo.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Envie salsichas e pão.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Enviar suco e pão.";
"T_GAME_QUEST_SCEN16_08_START" = "É um desastre, meu senhor! Nosso trigo foi afetado por um mal misterioso e agora está estragado!";
"T_GAME_QUEST_SCEN16_09_START" = "Os habitantes estão sofrendo com uma peste terrível.\nSe não a derrotarmos logo, não restarão trabalhadores!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "A peste parece ser causada por animais doentes. A entrega para o Rei também estava contaminada.\nPrecisamos enviar um novo lote!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Derrote a peste na cidade com a ajuda de um médico.";
"T_GAME_QUEST_SCEN16_10_START" = "Os deuses conspiraram contra nós. A peste fez todos os animais selvagens morrerem. Como vamos alimentar a cidade agora e atender às demandas do Rei?";
"T_GAME_QUEST_SCEN16_11_START" = "Precisamos criar animais para alimentar os habitantes.\nPor isso, precisamos de uma fazenda de porcos e um açougueiro.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Os porcos comem trigo. Compre-o do mercador, para podermos atender a entrega do rei novamente.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Construa uma fazenda de porcos e uma oficina de açougueiro.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Você deve compreender que minhas reservas são muito cobiçadas.\nDe agora em diante, trocarei trigo por minério de ferro.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Entregue o minério e voltarei em breve com outra entrega.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Troque minério de ferro por trigo.";
"T_GAME_QUEST_SCEN16_12_2_START" = "Por um preço absurdamente baixo posso lhe entregar o último trigo do país!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "O prazer é meu, meu senhor. Envie-me o ouro e tentarei conseguir um pouco mais.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Troque ouro por trigo.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Ouvi falar da sua desgraça e quero propor uma troca. Ainda tenho algumas reservas de trigo, que posso trocar por produtos.";
"T_GAME_QUEST_SCEN16_12_START" = "Trocarei de bom grado algumas pedras por trigo.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Parece que você agora tem produtos suficientes para uma troca. Estou aguardando para fazer novas trocas.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Troque pedras por trigo.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Você já experimentou o pão que meu sobrinho faz? Você deveria! E diga a ele para assar bastante, para durar o inverno todo!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Asse 50 filões de pão.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Construir um tecelão.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Construir um alfaiate.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Diga, você está com tanto frio como nós estamos? Minha esposa até pegou uma gripe por causa de todos esses furos em seu vestido. Talvez o senhor pudesse nos ajudar a fazer roupas mais quentes.";
"T_GAME_QUEST_SCEN2_11_NAME" = "Construa uma pastagem de ovelhas.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Eu acho que nossa cidade está quase perfeitamente preparada para a chegada do inverno! Mas, cá entre nós, não é ótimo tomar um delicioso copo de suco na aconchegante taverna quando está um frio de congelar lá fora?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Construa uma produtora de suco e produza 50 jarros de suco.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Meu senhor administrador, eu não quero parecer mal-educado, mas infelizmente estão faltando fazendas! Como você conseguirá fazer a colheita de todo o trigo a tempo antes da chegada do inverno?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Construa 2 fazendas.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrr, já estou congelando, prezado senhor administrador! Tenho certeza de que este inverno que está chegando será muito frio! Minha esposa e eu esperamos que o senhor não se esqueça de verificar se temos lenha suficiente!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Construa três cabanas para silvicultores.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Obrigado! Mande lembranças aos meus irmãos, caso os encontre! Fale para eles pegarem o máximo de madeira possível!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Colete 35 pedaços de madeira.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Finalmente, podemos começar a colheita! Espero que seja o suficiente para satisfazer suas necessidades!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Colha 35 peças de trigo.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Que colheita abundante! Nós nem sabemos onde armazenar tanto trigo! Seria uma boa ideia fazer um pouco de pão com isso!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Construa um moinho e produza farinha de trigo.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Prezado senhor administrador, nós realmente gostamos de viver aqui, mas nos preocupamos, pois nossas casas podem não ser capazes de suportar o inverno por muito tempo...";
"T_GAME_QUEST_SCEN2_6_NAME" = "Mantenha todas as casas em boas condições.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Ainda estou preocupado com algo... infelizmente, não temos ferramentas no estoque. Tenho certeza de que o senhor sabe como as ferramentas são importantes para reparar as construções! O senhor faria a gentileza de comprar algumas para nós?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Pague um tributo de 50 ferramentas.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Eu temo que meus irmãos não sejam capazes de terminar todo o trabalho sozinhos... talvez o senhor possa conseguir alguns trabalhadores a mais para nossa aldeia.";
"T_GAME_QUEST_SCEN2_8_NAME" = "Aumente a população para 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Já há pingentes de gelo se formando no meu nariz... mas alguns dos viajantes que estão procurando um lugar para se estabelecer estão em situação ainda pior. Acho que devemos permitir que eles morem em nossa aldeia!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Construa 6 moradias.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Querido, é melhor você não esquecer que amanhã é o dia de nosso casamento! Eu gostaria muito de ganhar joias novas! Se você conhecesse um ourives...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Construa uma loja para o ourives.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Tenho certeza que o rei e seus moradores ficariam encantados com novas ferramentas! As antigas ficaram enferrujadas e inúteis!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Construa uma oficina de ferramenteiro.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Construa uma alfaiataria e produza roupas.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Oh, olhe aquelas ovelhas fofas! Querido, você as viu? E olhe toda aquela lã que já foi tirada delas! Agora só precisamos de uma tecelagem e de uma loja de alfaiataria!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Construa uma tecelagem e produza tecido.";
"T_GAME_QUEST_SCEN3_13_DESC" = "As crianças estão muito empolgadas e aguardam os pães frescos que comerão em breve! Você já construiu algumas padarias, não é? Querido?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Adivinha! Minha irmã finalmente quer casar! Mas ainda precisamos de uma igreja em nossa cidade! Não apenas para a cerimônia de casamento, mas também para nossos moradores religiosos!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Obtenha alta satisfação de religião.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Agora veja isso, querido! A cidade se recuperou e tudo está indo bem! Então você tem minha permissão para relaxar com seus amigos e construir uma taverna, se quiser! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "Obtenha alta satisfação com tavernas.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Querido, olhe para esta aldeia reduzida... pobres moradores, me sinto mal por eles! Acho que você poderia pedir a ajuda do rei! Talvez você possa convencê-lo, enviando alguns presentes!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Entregue um tributo ao rei e complete todas as tarefas.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Você deveria cuidar dos problemas até o rei enviar ajuda! Os moradores precisam urgentemente de mais água!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Construa um poço em sua aldeia.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Seu predecessor não cuidou nem mesmo de fornecer comida suficiente! É realmente inacreditável! Querido, você deveria mudar isto imediatamente! Por que você não constrói algumas cabanas para os pescadores?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Construa 2 cabanas para os pescadores.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Pobres crianças... querido, não podemos nem alimentá-los com peixe! Você deveria construir fazendas, para produzirmos trigo para farinha e pão!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Construa 2 fazendas e produza trigo.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Construa uma fundição.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Ei, querido, não está esquecendo de algo? Você não planejou enviar alguns presentes ao rei para convencê-lo a nos ajudar? Você tem sorte de me ter... nós precisamos de uma mina e de uma fundição antes que possamos produzir algo de valor!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Construa uma mina.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Todos os seus moradores estão sobrecarregados de trabalho! Você não pode construir algumas moradias novas, para atrair mais trabalhadores?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Construa 3 moradias.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Oh, estou tão feliz! As coisas estão melhorando cada vez mais! Agora podemos até começar a cobrar mais impostos dos moradores!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Cobre 1500 Tálers em impostos.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Colete Táleres dos impostos.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Você sabe o que mais seria legal de ter? Algumas roupas novas! Quer dizer, primeiramente para o rei, claro... mas primeiro precisamos de algumas pastagens de ovelhas, para conseguirmos lã!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Construa 2 pastagens de ovelhas.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Os fazendeiros já estão trabalhando arduamente para colher o trigo! Agora você pode construir um moinho de vento, para produzirmos farinha para o pão!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Construa um moinho e produza farinha de trigo.";
"T_GAME_QUEST_SCEN4_10_DESC" = "O meu castelo não é adequado para o meu status real, então planejo fazer uma grande expansão da minha propriedade rural. \n\nComo seu rei, ordeno que entregue uma grande quantidade de pedras. Confio em vós, meu bom guardião.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Entregue uma carroça com pedras ao rei.";
"T_GAME_QUEST_SCEN4_11_DESC" = "O calor intenso afetou nossas casas. Elas deterioraram e muitas famílias exigem que o senhor melhore as condições de moradia.\nSeria ótimo se o senhor cogitasse melhorar as condições de moradia na cidade.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Obtenha um nível alto de felicidade com a moradia.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Meu bom guardião, ainda aguardo a entrega do suco de uva. Meu banquete terá início em breve.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Entregue sucos de uva para o rei.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Alteza, há uma grande demanda por farinha de trigo no reino. As fazendas não conseguem produzir trigo suficiente para os moinhos trabalharem em plena capacidade.\n\nSe o senhor me entregar farinha em boa quantidade, posso dominar o mercado e criar um monopólio nesta região. Obviamente, você ganhará uma boa recompensa.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Entregue sacos de farinha para o mercador.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Os Habitantes querem construir abrigos para fugir do sol escaldante durante o dia. Precisamos fornecer a eles boas tábuas de madeira, para que eles possam começar imediatamente!";
"T_GAME_QUEST_SCEN4_14_NAME" = "Produza 35 tábuas de madeira.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Meu senhor, o senhor fez bem. A cidade alcançou um tamanho admirável.\n\nAinda assim, os Habitantes estão muito infelizes por causa da seca. O se+I37nhor precisa aumentar a felicidade cedendo aos desejos dos Habitantes. É apenas uma modesta proposta, é claro...";
"T_GAME_QUEST_SCEN4_15_NAME" = "Obtenha uma nível alto de felicidade na cidade.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Simplesmente maravilhoso, meu bom guardião!\nApesar da seca, conseguistes construir uma grande cidade. Os seus Habitantes estão muito felizes com as mudanças.\n\nComo seu rei, digo que estou muito satisfeito com vosso trabalho. Prestastes excelente serviço para o reino e sereis recompensado de acordo.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Senhor, os Habitantes vivem uma vida pobre e miserável. O reino está sofrendo com a seca. Basta olhar para este rio que corria perto do seu castelo, antes tão magnífico. Agora só há algumas poças...\n\nO rei nos encumbiu com a expansão da cidade. Vamos começar construindo mais algumas casas.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Construa mais 8 casas.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Meu senhor, o rei ficou muito feliz ao saber do sucesso da expansão da cidade, mas ele ordena a construção de uma cidade ainda maior.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Chegue a uma população total de 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Senhor guardião, como mercador, posso ser de grande ajuda na sua atual situação. \n\nO reino pode estar sofrendo com a seca, mas posso entregar provisões na cidade assim que o senhor construir um mercado.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Obtenha um nível alto de felicidade no mercado.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Senhor, requisito encarecidamente a construção de mais poços para que os habitantes tenham água para enfrentar o calor. ";
"T_GAME_QUEST_SCEN4_3_NAME" = "Construa dois poços.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Trago boas notícias, senhor. Um Habitante descobriu que ainda há peixes nas poças d'água no leito seco do rio. \n\nDevemos encomendar a construção de algumas cabanas para os pescadores.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Construa duas cabanas de pescador.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Senhor guardião, gostaria de propor um acordo.\n\nSe pudermos expandir nossa relação comercial, posso entregar comida com regularidade na cidade.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Obtenha um lucro de 1000 moedas com vendas no mercado.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Mais uma vez faço uma proposta. Preciso urgentemente de carvão. Dê-me carvão e eu lhe darei em troca uma bolsa cheia de Táleres.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Entregue carvões para o mercador.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Guardião, a corte necessita urgentemente de suco de uva. A seca ainda castiga o reino e fez definhar o nosso vinhedo.\n\nOrdeno que construa instalações para fabricar suco. Planejo fazer um banquete no meu castelo em breve. Portanto, não me decepcione!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Construa uma fábrica de suco e produza suco.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Alteza, minha família mal consegue plantar neste solo castigado pela seca. A colheita será pouca, então uma fazenda só não basta.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Construa mais uma fazenda.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Nosso estoque de pão corre o perigo de acabar, senhor. Devemos reduzir o consumo de pão fornecendo mais peixe aos cidadãos.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Produza carne em quantidade suficiente.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Complete todas as missões, supere a seca e transforme a cidadezinha em uma cidade grande!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Agora só falta uma coisa, meu senhor: suco de uva para celebrar nossa vitória!\n\nPor favor, entregue uma quantidade generosa de suco de uva no acampamento do exército!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Entregue 45 sucos de uva para o cavaleiro.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Simplesmente maravilhoso, meu senhor!\nO Lorde Blankenstein terminou sua campanha com sucesso e só tem elogios para vossa alteza.\n\nVossa alteza gostaria de fazer alguma negociação antes de sair da região?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Obtenha um lucro de 2500 Táleres com comércio.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Que bela manhã, meu senhor. Trago boas notícias. Um mercador livre entrou em contato.\n\nEm breve ele visitará nossa cidade e disse ter necessidade de tábuas de madeira para construir uma tenda no mercado.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Produza 30 tábuas de madeira.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Meu senhor, estabelecestes um ótimo posto comercial aqui. Mas falta algo crucial: uma taverna. Se construíssemos uma taverna, nossa cidadezinha atrairia mais mercadores e viajantes.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Obtenha alta satisfação com tavernas.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Muito bem, meu senhor. A taverna trará muitas oportunidades de comércio no futuro. Agora, vamos para a parte interessante do acordo. Vamos negociar... ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Obtenha um lucro de 1500 Táleres com o comércio.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Poderia vossa alteza fazer a gentileza de estocar tecidos? Tenho um parceiro comercial que se interessa muito por tecidos.\n\nTambém conheci um cavaleiro nas minhas viagens. Ele está a caminho e pode trazer missões interessantes para vossa alteza.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Estoque 35 unidades de tecido no depósito.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Meu senhor! Sou Kunibert von Blankenstein, cavaleiro sagrado pelo rei.\n\nO seu posto comercial é perfeito para me auxiliar em minha busca por expulsar os bandidos dessas terras. Poderia vossa alteza fornecer pedras para que eu possa construir torres para vigiar essa região?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Entregue 50 pedras para o cavaleiro.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Meu senhor, meus ferreiros necessitam urgentemente de ferro para fazer espadas para o meu exército.\nHá vários depósitos de minério perto do vosso posto comercial. Seria possível fazer uma entrega de ferro para meu servo?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Entregue 65 unidades de ferro para o cavaleiro.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Estou com um problema, alteza. Alguns dos meus lacaios danificaram suas armaduras na última batalha contra os bandidos. \nPor favor, obtenha mais ferramentas para que meus soldados possam consertar suas armaduras quando visitarem o posto comercial.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Produza 25 ferramentas.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Trago boas notícias, meu senhor! Minha campanha teve grande sucesso e expulsamos os bandidos desta região.\n\nDurante esta longa campanha, consumimos todos os mantimentos. Preciso de comida para meu exército.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Entregue 25 peixes e 25 pães para o cavaleiro.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Minhas tropas querem celebrar nossa vitória contra os bandidos. Agora que os ladrões foram derrotados, meus soldados estão inquietos.\n\nPoderia construir locais de entretenimento na cidade, milorde?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Minhas tropas desejam celebrar a vitória contra os bandidos mas, agora que eles foram derrotados, meus homens estão inquietos. \n\nPoderia vossa alteza construir campo de justa para que meus soldados possam relaxar?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Obtenha alta satisfação com um campo de justa.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Construa um posto comercial de sucesso completando todas as missões!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Simplesmente incrível, meu senhor. \nO senhor estabeleceu com sucesso um posto comercial neste local de importância estratégica.\nO rei e Lorde Blankenstein estão muito satisfeitos com vosso trabalho e apoio para a campanha contra os bandidos nesta região.";
"T_GAME_QUEST_SCEN6_1_DESC" = "O rei fez uma encomenda! Ele exige uma quantidade imensa de materiais para construir uma catedral! A construção monumental já começou, então precisamos entregar os materiais o mais rápido possível.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Entregue os materiais para a construção da catedral.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Troque lã por peixe.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Troque minério de ferro por peixe.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Troque suco de uva por peixe.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Troque ouro por peixe.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Troque tábuas de madeira por peixe.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Percebo que não há lagos e nem rios ao redor, então vossa alteza não pode produzir peixes. Construa um mercado e eu lhe venderei peixe em troca de várias mercadorias!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Construa mais 2 minas.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Construa mais 3 minas.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Precisamos começar a minerar imediatamente! Certifique-se de que há minas em número suficiente em funcionamento para conseguir fazer a entrega no prazo.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Construa uma mina.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Os seus Habitantes estão trabalhando o máximo que conseguem para minerar tudo o que podem! Certifique-se de que eles têm comida suficente para conseguirem trabalhar!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Construa uma padaria.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Estamos indo rápido, mas ainda precisamos fundir o minério!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Construa 2 fornalhas.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Trabalhar nas minas escuras e úmidas sem vestimentas adequadas pode ser muito desagradável! É preciso dar aos Habitantes roupas quentes. Tenho certeza de que eles agradecerão!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Entregue 25 peças de roupa.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Meu senhor, estamos produzindo recursos em alta velocidade! Precisamos construir mais depósitos para todos esses recursos!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Construa 2 depósitos.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Trabalhar nas minas é difícil! Os seus Habitantes adorariam ter um lugar para relaxar depois de um longo dia de trabalho. Uma taverna seria perfeita!";
"T_GAME_QUEST_SCEN6_8_NAME" = "Construa uma taverna.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Muito bem! Você fez um excelente trabalho entregando todos os recursos necessários para a catedral! No entanto, a construção levará algum tempo. A catedral celebrará nosso grande rei, cujos atos inauguraram uma era de paz e harmonia que durará séculos!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Lembre-se, você pode remover as árvores do caminho! Use a pá para marcar as árvores que deseja remover.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Senhor guardião, não podemos fazer um bolo de casamento sem os ingredientes certos! O senhor poderia construir uma fazenda para que posssamos produzir nossa própria farinha de trigo?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Construa uma fazenda.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Construa um moinho";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Produza 25 pães.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "O casamento será maravilhoso! Primeiro, precisamos providenciar um bolo excelente. Você poderia construir uma padaria enquanto escolho meu vestido de casamento?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Construa uma padaria.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Preciso de um mercado para vender todos os presentes de casamento de que não gostei!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Obtenha um nível alto de felicidade no mercado.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Meu senhor, estamos progredindo com as preparações para o casamento! Mas precisamos de mais ferramentas para construir a marquise do casamento!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Construa uma oficina de ferramentas.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Produza 20 ferramentas.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Quero que nosso casamento aconteça numa bela igreja. Você já construiu uma?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Obtenha um alto nível de felicidade religiosa.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Construa um pasto de ovelhas.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Construa uma fábrica de tecelagem.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Produza 20 tecidos.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Dá para acreditar? Não consigo achar um vestido de casamento decente em lugar algum! Preciso de um vestido imediatamente! Peça ao seu melhor alfaiate para fazer um.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Construa uma alfaiataria.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Construa decorações.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Aumente a felicidade dos habitantes!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Este lugar é horrível… Será que não é possível tornar a cidade mais bonita? Quero que todos fiquem tão felizes quanto eu!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Não ligo para bolo e flores; quero uma festa grande, com muito suco! E quero convidar toda a cidade! Mas não temos espaço suficiente para alojar todos os convidados!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Construa mais casas pequenas.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Quero um lugar bonito para encontrar meus amigos depois do casamento. Essa cidade precisa muito de uma taverna!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Obtenha alta satisfação com tavernas.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Produza 25 sucos de uva.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Meus amigos ficarão com sede! Você já se encarregou do suco?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Construa uma fábrica de suco.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Receberemos mais convidados do que eu imaginava. Construa uma casa grande.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Construa uma casa grande.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Produza 15 joias.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Ah, não! Estou em apuros! Perdi meu anel de casamento! Por favor, não conte para ela! Será que existe um ourives na cidade para me fazer outro?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Construa uma ourivesaria.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Antes de me casar, quero impressionar minha noiva no campo de justa!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Construa campo de justa.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Meu senhor, os depósitos de nosso castelo estão repletos até o teto de mantimentos. Sugiro construir um novo depósito.";
"T_GAME_QUEST_SCEN8_10_NAME" = "Construa um novo armazém.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Os homens da cidade ficarão mais felizes se houver um lugar para se encontrarem e tomarem uma taça de suco de uva depois do dia de trabalho. Seria demais pedir a construção de uma taverna, meu senhor?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Obtenha alta satisfação com tavernas.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Meu senhor, o ferreiro construiu fornos de aquecimento simples para os habitantes, mas ainda precisamos de carvão como combustível.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Produza 50 carvões.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Meu senhor, a cidade não tem lenha para aquecer as casas. É de extrema importância termos um estoque de lenha!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Produza 75 lenhas";
"T_GAME_QUEST_SCEN8_2_DESC" = "A cidade anda mal. Veja só estas casas decadentes. Basta uma nevasca e muitas delas desmoronarão. Vamos chamar um carpinteiro para ajudar a consertar.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Construa uma oficina de carpintaria";
"T_GAME_QUEST_SCEN8_3_DESC" = "Meu senhor, este inverno rigoroso é claramente um sinal dos céus! Precisamos expiar nossos pecados! Vamos construir uma igreja para aplacar a fúria divina!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Obtenha alta satisfação de religião.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Os habitantes estão inquietos, senhor. Está frio demais na casa deles. Acho que devemos estocar lã. Os habitantes podem usá-la como insulação contra o frio em suas casas.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Produza 55 lãs.";
"T_GAME_QUEST_SCEN8_5_DESC" = "O governador da província vizinha enviou-nos um pombo com um pedido de ajuda! Precisam urgentemente de roupas para aquecer sua população.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Entregue uma carroça de roupas à província vizinha.";
"T_GAME_QUEST_SCEN8_6_DESC" = "As fazendas não podem produzir trigo no inverno, meu senhor. Vamos mandar habitantes às florestas para caçar veados.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Construa cabanas de caçador.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Meu leal servo, este inverno extremamente rigoroso está castigando o reino. A renda dos impostos caiu drasticamente. Ordeno que construa um Tesouro para aumentar nossa renda fiscal e me envie uma carruagem cheia de Táleres.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Construa um Tesouro e faça um tributo de moedas ao rei.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Agora que temos um carpinteiro, consertar essas casas dilapidadas não será um problema. Os habitantes ficarão satisfeitos.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Certifique-se de que todas as casas tenham sido consertadas.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Sempre há carne de caça disponível, até no inverno, e ela pode substituir o pão. Precisamos garantir que há carne o suficiente para todo o inverno.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Produza 50 carnes.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Meu senhor, o inverno está bem mais rigoroso do que esperávamos. Os habitantes não estão felizes com isso. Precisamos agir rápido ou não sobreviveremos a este inverno!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Faça a cidade resistir ao inverno…";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Meu senhor, os habitantes estão muito felizes com o progresso que fizemos! Já temos suprimentos para passar os meses de inverno e até conseguimos ajudar a provínica vizinha. Agora estamos preparados e este inverno não nos causará mal algum!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Meu senhor, ouvi dizer que o senhor tem problemas com insurgentes na sua área. Estou disposto a liderar uma equipe de busca nas florestas, mas meus mercenários exigem pagamento adiantado.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Pague os mercenários.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Tenho mais um pedido, meu leal servo. Preciso de uma nau capitânia digna de um rei, e isso significa que ela precisa ter luxuosos ornamentos em ouro!\n\nOrdeno que me entregue o ouro necessário para esse propósito. Não me decepcione.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Entregue pepitas de ouro para o rei dentro do prazo.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Meu leal servo, a construção de minha nova frota está indo bem, mas ainda precisamos de grandes quantidades de lona para as velas. Ordeno que me entregue tecido suficiente para fazer velas para todas as minhas embarcações.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Entregue tecido para a produção de lonas para para navegação.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Meus homens descobriram algo. Achamos pegadas dos bandidos na floresta. Mas precisamos de mais mantimentos antes de continuar a investigação.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Entregue mantimentos para os mercenários.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Governador! Perdi um carregamento inteiro de tábuas de madeira para os bandidos na sua província. Isso precisa parar. Entregue mais tábuas de madeira o mais rápido possível.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Entregue tábuas de madeira para atender à construção da frota do rei.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Meu senhor, o cobrador de impostos descobriu uma conexão entre os badidos na floresta e o sabotador na cidade. Ele se recusa a dizer mais do que isso, já que teme por sua vida.\n\nEle pede para ser desligado de seu cargo como cobrador de impostos. Também deseja roupas novas para poder sair da cidade e ficar oculto. Só assim ele nos dirá o que descobriu.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Desligue o cobrador de impostos de seu cargo no Tesouro e dê a ele roupas novas para que possa sair da cidade sem ser detectado.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Meu senhor, assim como prometido, o cobrador de impostos divulgou a identidade do sabotador antes de sair da cidade.\n\nSão o mercenário e seus homens! Eles são uma fraude! Eles vão de cidade em cidade oferecendo "proteção" contra os bandidos e os sabotadores em troca de dinheiro, sendo que eles mesmos cometem os crimes!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Más notícias, meu senhor! Alguém arrombou o depósito e roubou toda nossa carne!\n\nVamos distribuir tochas pela cidade. Isso pode ajudar a pegar os bandidos à noite.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Construa 7 tochas pela cidade para impedir os ladrões.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Meu senhor, já que demorará até sermos visitados por mercadores ambulantes, precisamos de mais espaço em depósito para todos os nossos produtos. \n\nAlém disso, devemos fazer uma pausa na produção desnecessária para que todos os nossos depósitos não fiquem cheios demais.\n\nSeria bom construir outro depósito.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Construa outro depósito na cidade.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Os habitantes estão com muito medo do sabotador e de sair e consertar as moradias. Acho que precisamos construir uma oficina de carpintaria se quisermos que as construções sejam consertadas.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Construa uma oficina de carpintaria.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Bom dia, meu senhor. Que belo dia de inverno. Já temos o trabalho dos próximos meses organizado. \n\nQue tal começarmos agora mesmo construindo algumas cabanas de silvicultor?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Construa cabanas de silvicultor.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Venho fazer um pedido, meu senhor. Todo o reino apresenta grande demanda de ferramentas. Eu pagarei muito bem se puder me entregar uma carruagem cheia de ferramentas. Também visitarei a sua cidade para fazer comércio.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Faça uma entrega de ferramentas para o mercador.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Trago notícias importantes, meu senhor! Um bando de mercenários chegou, e eles já começaram a reclamar que nossa cidade não tem uma taverna. \n\nÉ melhor evitar ter um bando de mercenários infelizes e entediados na nossa cidade, então vamos construir uma. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Aumente a felicidade das tavernas.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Governador, fico feliz ao ver que suas tentativas para aumentar a produção de madeira estão indo bem.\n\nEntão, será que a primeira entrega já pode acontecer…?";
"T_GAME_QUEST_SCEN9_3_NAME" = "Envie um tributo de madeira ao rei.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Meu senhor, há boatos de que os ânimos estão acirrados na cidade. Será que há habitantes tramando contra a coroa?\n\nSe não agirmos agora, podemos ter uma completa rebelião em mãos. Precisamos garantir que nossos habitantes fiquem felizes e contentes e devemos fazer isso rápido.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Mantenha um nível de felicidade maior do que 100% nos próximos dois minutos.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Meu senhor, esta situação é um absurdo! A taverna foi destruída! Há boatos de que há um sabotador à solta na nossa cidade. \n\nPrecisamos acalmar a situação antes que tudo saia completamente de controle. Construir uma forca e pelourinhos deve bastar.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Construa uma forca e 2 pelourinhos na cidade.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Meu senhor, seria bom tentar aumentar um pouco mais o moral dos habitantes.\n\nDemonstrar gentileza para com os seus habitantes pode aumentar a felicidade. Que tal construir uma igreja e embelezar a cidade com jardins floridos?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Construa jardins floridos e uma igreja.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Governador, sinto informá-lo de não é possível visitar a cidade por enquanto. Ouvi boatos de que há bandidos nas florestas cercando nossa cidade. É perigoso demais para os mercadores no momento.\n\nTenho uma mensagem do rei, no entanto. Ele ordena a construção de duas serrarias.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Construa 2 serrarias.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Meu senhor, tenho uma ideia. Devemos construir um Tesouro. O cobrador de impostos visitará cada casa da cidade… e talvez ele possa descobrir algo sobre esse sabotador.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Construa um tesouro e espere o cobrador de impostos investigar as casas.";
"T_GAME_QUEST_SCEN9_9_DESC" = "O sabotador destruiu a serraria! O cobrador de impostos ainda não conseguiu descobrir a identidade dele, meu senhor.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Você não aplacou os ânimos da população a tempo!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Você fracassou! Devido à sua incompetência, precisei pedir ouro em outra cidade!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Governador, em breve pedirei a construção de uma grande frota de navios de guerra. \n\nA sua cidade tem o potencial de se tornar a minha maior fornecedora de madeira para essa iniciativa. Faça de tudo para que isso aconteça.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "O mercenário e sua gangue fugiram da região, meu senhor. Meus homens procuram-nos sem descanso.\n\nTambém gostaria de agradecer pelo seu apoio na construção de minha nova frota e convido-o para a primeira viagem da minha nova nau capitânia. Até lá, passar bem...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Apoie o Rei em seus projetos.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Muito bem! Você conseguiu aplacar os ânimos dos habitantes da cidade!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Muito bem! Você fez a entrega a tempo!";
"T_GAME_QUEST_SCEN_10_DESC" = "Nossos cavaleiros devem achar diversão nas tavernas locais quando o torneio acabar! Estou preocupado, pois não temos tavernas nem suco de uva suficientes! Cuide deste problema imediatamente!";
"T_GAME_QUEST_SCEN_10_NAME" = "Construa uma taverna e produza suco suficiente.";
"T_GAME_QUEST_SCEN_11_DESC" = "Excelente, administrador! A cidade está pronta, mas minhas filhas e eu não estamos! Eu preciso das roupas mais magníficas que seus alfaiates possam fazer!";
"T_GAME_QUEST_SCEN_11_NAME" = "Pague um tributo de 35 roupas.";
"T_GAME_QUEST_SCEN_12_DESC" = "A abertura do torneio está chegando, mas não quero ver nenhuma cara triste na cidade! É melhor você verificar se os moradores estão felizes!";
"T_GAME_QUEST_SCEN_12_NAME" = "Aumente a felicidade.";
"T_GAME_QUEST_SCEN_1_DESC" = "Bem-vindo, meu bom administrador! Como você deve saber, estou planejando sediar o maior jogo de justa da região! Espero que o senhor construa ao menos 3 campos de justa para este evento! Não me desaponte!";
"T_GAME_QUEST_SCEN_1_NAME" = "Construa 3 campos de justa.";
"T_GAME_QUEST_SCEN_2_DESC" = "Os convidados para nosso torneio certamente sentirão fome! Quero que você comece imediatamente a produzir pão e entregar como tributo ao seu rei!";
"T_GAME_QUEST_SCEN_2_NAME" = "Pague um tributo de 25 filões de pão.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Construa um moinho e produza farinha de trigo.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Construa 2 padarias e produza pão.";
"T_GAME_QUEST_SCEN_3_DESC" = "Meu senhor, não deveríamos deixar o rei esperando! Precisamos de trigo e farinha para começar a produção de pão!";
"T_GAME_QUEST_SCEN_3_NAME" = "Construa uma fazenda e produza trigo.";
"T_GAME_QUEST_SCEN_4_DESC" = "Muito bem, meu bom administrador! Mas só o pão não será suficiente para satisfazer nossos convidados! Eu exijo peixe fresco como tributo para seu rei!";
"T_GAME_QUEST_SCEN_4_NAME" = "Pague um tributo de 25 peixes.";
"T_GAME_QUEST_SCEN_5_DESC" = "Eu quero que o torneio seja inesquecível! Nossos cavaleiros devem empunhar lanças douradas e nossos campos de justa devem brilhar! Faça-me o favor de cobrar impostos para seu rei!";
"T_GAME_QUEST_SCEN_5_NAME" = "Pague um tributo de 1000 Tálers.";
"T_GAME_QUEST_SCEN_6_DESC" = "Tenho certeza que nossos convidados apreciarão o delicioso sabor de nossos sucos de uva recém espremidas! Vá construir produtoras de suco! Você pode até servir aqueles restos de baixa qualidade nas tavernas locais!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Tenho certeza de que nossos convidados gostariam de um maravilhoso suco de uva fresco!";
"T_GAME_QUEST_SCEN_6_NAME" = "Construa uma fábrica de suco e produza suco.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Construa uma tecelagem e produza tecido.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Construa uma loja de alfaiataria e produza roupas.";
"T_GAME_QUEST_SCEN_7_DESC" = "Os mantos de nossos cavaleiros estão velhos e desbotados e desagradam meus olhos, administrador! Consiga uns mantos novos! Se quiser manter seu trabalho, construa pastagens de ovelhas, contrate um tecelão e construa uma loja de alfaiataria!";
"T_GAME_QUEST_SCEN_7_NAME" = "Construa 2 pastagens de ovelhas.";
"T_GAME_QUEST_SCEN_8_DESC" = "Nós deveríamos vender mais mercadorias por dinheiro, meu senhor. É sempre uma boa ideia ter Táler à disposição para cobrir possíveis gastos futuros.";
"T_GAME_QUEST_SCEN_8_NAME" = "Ganhe 500 Tálers através da comercialização.";
"T_GAME_QUEST_SCEN_9_DESC" = "Eu vejo que as coisas estão progredindo bem, mas sua cidade ainda é feia! Eu quero fontes, paredes de pedras brancas, árvores verdinhas e estátuas esplendorosas! Você deveria embelezar a cidade com mais decorações!";
"T_GAME_QUEST_SCEN_9_NAME" = "Aumente a alegria da decoração.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Primeiro, é melhor colocar um trabalhador numa das cabanas de silvicultor da área.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Coloque um trabalhador na cabana de silvicultor.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Uma das principais missões é construir um mercado.\nPara cumprir esse objetivo, você tem que estabelecer várias cadeias de produção para juntar os recursos necessários, meu senhor.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Construa um mercado.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Meu senhor, recomendo colocar um habitante na serraria para produzirmos tábuas o mais rápido possível.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Coloque um trabalhador na serraria.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Milorde, recomendo que você mude a mineração de minério para pedra.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Assim que você tiver juntado tábuas e madeira, você tem que colocar um dos trabalhadores na mina e começar a extrair pedras.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Muito bem. Agora só temos que esperar até que o mercado fique pronto, meu senhor.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Coloque um trabalhador na mina.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Sua segunda missão é construir uma taverna.\n\nÉ melhor começar a construir o prédio imediatamente.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Construa uma taverna.";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Boas notícias, meu senhor. Chegaram alguns habitantes para nos ajudar na missão. Deveríamos construir uma casa para eles.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Construa uma casa.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Precisamos de uma oficina de ferramenteiro para construir a taverna. Recomendo construir uma carvoaria para começar.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Construa uma carvoaria.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "O próximo prédio que precisamos é uma fundição. Assim podemos começar a produzir barras de ferro.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Construa uma fundição.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Milorde! Para começar a produção de ferramentas precisamos construir a oficina de ferramenteiro na cidade.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Construa uma oficina de ferramenteiro.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "O estoque de comida está acabando, milorde. Seria melhor você ordenar que um habitante vá pescar ou caçar. Se os habitantes não conseguirem comida rápido, ficarão menos produtivos.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Produza comida.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Sendo apenas um humilde mercador, estou a seu serviço. Vejo que precisa de dinheiro para seus projetos de construção.\nSe tiver interesse, eu compro seu minério de ferro.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Troque produtos com o mercador.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Está sem recursos financeiros, milorde? Sem problema. Posso comprar suas peles de animais.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Governador, preciso de pepitas de ouro. Está disposto a vender algumas?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Não me sinto bem, meu senhor. Talvez fosse bom ir ao médico.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Cure os habitantes doentes.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Fogo! Algum habitante tem que apagar imediatamente.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Apague o fogo.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Até aqui os bandidos nos perturbam. Seria bom colocar uns habitantes nas torres de guarda até que o ataque tenha sido rechaçado.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Defenda a cidade dos bandidos.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Meu senhor, podemos descansar um pouco e fazer um lanche?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Produza pão.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Temos apenas alguns habitantes para este desafio. Devemos colocá-los e tirá-los dos prédios conforme for necessário.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Parabéns. Você completou este desafio com maestria.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Use os habitantes para cumprir todas as missões.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Boas novas! As árvores estão crescendo novamente na península próxima ao castelo.\n\nSugiro construir cabanas de silvicultor lá para facilitar a extração.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "As cabanas de silvicultor estão degradadas e abandonadas!\n\nAs árvores desta área foram completamente dizimadas. As cabanas de silvicultor não têm mais serventia.\nSugiro destruir todos os prédios não utilizados para conseguir madeira.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Destrua todas as cabanas de silvicultor.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Talvez você deva pedi ao povo desta aldeia. Pode ser que as pessoas tenham madeira sobrando.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "O Rei está esperando a primeira entrega de tábuas.\n\nPodemos colocar um habitante na serraria para começar a produzir tábuas. Fique de olho no estoque de madeira. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Coloque um habitante na serraria.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Como está se saindo, governador? Estou esperando um total de três entregas\n\nPrepare a primeira entrega o mais depressa possível. Não vá me desapontar.";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Entregue a mercadoria ao Rei.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "O Rei ficou muito satisfeito com a primeira entrega de tábuas.\nÉ melhor prepararmos a segunda leva o mais breve possível.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "O Rei está esperando a última entrega. Quando ele tiver tábuas suficientes, a Frota Real poderá ser expandida de modo significativo.\n\nVamos trabalhar.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Está se perguntando por que o Rei ainda não recebeu a entrega? Bom, eu acho que sei a resposta.\n\nResumindo: me pague um valor simbólico de resgate e eu libero sua entrega para o Rei sem maiores interrupções.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Pague o resgate.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Para construir a frota real, eu preciso de muitas tábuas.\nInfelizmente, há tempo que não recebo esse tipo de mercadoria.\n\nGovernador, tenho uma missão para você! Descubra porque pararam de fazer entregas e resolva o problema!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Muito bem, governador. Sabia que podia contar com você.\n\nGraças aos seus feitos, a frota estará pronta em breve.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Resolva o problema da escassez de madeira e forneça tábuas para o rei.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Sugiro que use a madeira com sabedoria!\n\nPodemos construir um mercado para comprar madeira dos mercadores.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Você está precisando de madeira? Tenho uma proposta que pode ser boa para nós dois. Já tenho disponível uma pequena quantidade de madeira, se quiser.\n\nCompre quanto precisar!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Compre madeira do mercador.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Você precisará de um suprimento regular de madeira.\n\nSe construir uma guilda comercial, poderá fazer acordos comerciais.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Construa uma guilda comercial.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Na guilda comercial, você pode fazer acordos de compra e venda.\n\nFaça um acordo comercial de madeira, governador.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Excelente! Enquanto tiver dinheiro, eu cumprirei todos os acordos.\n\nSeus acordos comerciais serão cumpridos até serem cancelados.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Faça um acordo comercial para comprar madeira.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "Um incêndio está se espalhando pela cidade! Precisamos construir torres contra incêndio para apagar o fogo e reduzir os riscos.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Chegue a uma cobertura de 80% com torres de incêndio.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Bandidos! Eles tentaram destruir nossos prédios. Precisamos de mais soldados para bani-los. É melhor construirmos mais torres de guarda.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Construa torres de guarda suficientes e proteja a cidade com soldados.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Outra doença! Uma cidade grande precisa de mais de uma enfermaria.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Outra doença! Uma cidade grande precisa de mais de uma enfermaria.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Construa uma enfermaria e cure a doença.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Nem todos os habitantes podem frequentar a igreja porque está sempre cheia.\n\nPrecisamos de mais igrejas para caberem todos.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Os habitantes estão esperando tempo demais pela bebida. Temos que construir mais tavernas e aumentar a produção de suco e cerveja.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Não há diversão nesta cidade. Seria bom construir um campo de justa.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Os habitantes estão satisfeitos. Mas agora querem artigos de luxo.\n\nPodem ser roupas ou joias.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Alguns habitantes reclamam que o mercado está lotado demais.\n\nÉ melhor construirmos um novo mercado ou melhorar o atual. Caso contrário, os habitantes insatisfeitos vão abandonar a cidade.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Você me decepcionou, governador. É uma lástima que não tenha cumprido seu dever.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Excelente, meu governador. Você cumpriu todas as missões sem nenhum habitante sair da cidade.\n\nVou dobrar sua recompensa.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Governador, alguns habitantes deixaram a cidade. Eu esperava mais de você.\n\nPelo menos cumpriu todas as minhas missões. Você será recompensado.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Meu senhor, temos que ter mais habitantes na cidade, senão o Rei ficará furioso.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Ah, não, meu senhor! Muitos habitantes deixaram a cidade. Não podemos deixar mais nenhum sair.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Aumente a população.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Alguns habitantes deixaram a cidade. Temos que dar mais atenção aos nossos habitantes para que não vão embora.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Governador, muitos habitantes saíram desta cidadezinha.\n\nSatisfaça todas as necessidades deles para evitar que outros deixem a cidade. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Aumente sua população antes que o tempo acabe.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Complete todas as missões antes da chegada do Rei e mantenha a população acima de 150.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Os carregadores desta cidade estão sobrecarregados. É melhor construir um novo armazém e colocar mais habitantes para carregar.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Construa um novo armazém e coloque mais transportadores no castelo.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Estamos ficando sem comida. Vamos construir uma nova cabana de pescador. Isso deve resolver.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Meu senhor, a padaria não está produzindo pão suficiente. Podemos melhorá-la para colocar mais um padeiro.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Faça o upgrade da padaria nível 2 e coloque mais um padeiro.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "A escassez de água aumentou bastante. Podemos resolver isso construindo poços para os habitantes.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Construa vários poços na cidade.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Deveríamos aumentar nossos estoques de comida. Uma cabana de caçador ou oficina de açougueiro deve resolver.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Construa uma cabana de caçador ou oficina de açougueiro.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Excelente, meu senhor, estamos com um bom estoque. Agora temos que ficar de olho nos desejos dos habitantes.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Meu senhor, devemos obter material de construção e colocar um habitante na cabana de silvicultor do outro lado do rio.\n\nConstrua uma estrada de pedra atravessando o rio para ele começar a trabalhar.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Construa uma estrada de pedra atravessando o rio e coloque um habitante na cabana de silvicultor.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Construa uma estrada atravessando o rio e coloque um habitante na cabana de silvicultor.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Mudar para cá foi meu pior erro. Estou indo embora!\n\nÉ melhor você cuidar dos nossos desejos, senão mais e mais habitantes irão embora.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Não, obrigado.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Excelente ideia.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Achei que o senhor tivesse uma mentalidade mais moderna... Bem, continue na sua mediocridade, então.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, está começando a melhorar. Precisamos dar continuidade a nossos esforços e montar o restante da produção.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Estamos dominando o mercado de têxteis domésticos e alta costura! Vamos ganhar uma fortuna!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Agora que a matéria-prima está disponível, precisamos dos respectivos prédios. Um tecelão e um alfaiate bastam!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Depois da sua decisão, grandes mudanças ocorrerão na aldeia. Mas nada será possível sem... ovelhas e uma fazenda em boas condições.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Senhor, acabo de regressar da cidade vizinha. Lá, eles têm belos tecidos e bordados esplêndidos. Precisamos nos inspirar neles e produzir também roupas excepcionais.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Flores de seda";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Chegou a época do pólen e os habitantes estão espirrando o tempo todo. E se fizéssemos uma competição de espirro?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Cada um deles se concentra e solta seu espirro mais poderoso quando é sua vez. Você precisa selecionar o seu favorito, para que ele ou ela possa ser escolhido o vencedor!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "ATCHIM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "ATCHUM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "BRACHUUM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "E aí vem o nosso vencedor! O melhor espirro! Parabéns! Foi incrível!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "O habitante fica orgulhoso com sua recompensa. A competição não trouxe muitos benefícios, mas talvez sua cidade se torne famosa por começar o primeiro concurso de espirros da história!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Nem pensar.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Do castelo, você já pode ouvir a multidão se reunindo na praça da aldeia. E também ouve espirros. Parece que a competição vai ser bem divertida!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Inúmeros habitantes aguardam em filas segurando os espirros para soltá-los com toda a força quando passarem na frente do júri, que consiste em você e seu conselheiro.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Vocês julgam pessoa após pessoa. Selecionou três nomes. Você passa a lista para o seu conselheiro, que leva as pessoas até o meio da praça para a final da competição de espirro!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Você decide espalhar a notícia pela cidade de que haverá uma competição na praça da aldeia. O habitante considerado o melhor espirrador receberá uma recompensa!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Senhor, enquanto esperamos que os habitantes se reunirem na praça, devemos preparar as festividades! Vamos começar com a decoração.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Decorar a cidade.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Isso deixa a nossa cidade bem mais bonita.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Também precisamos verificar nossos estoques.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Perfeito, teremos tudo o que precisamos durante as festividades.";
"T_GAME_QUEST_SNEEZE_CONTEST_TITLE" = "A competição de espirro";
"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Vamos lá!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Tem razão, vamos construir algumas estátuas.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "Não... Não quero ter estátuas na minha cidade.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Bravo, senhor! Estas esculturas dão bastante charme à nossa cidade.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ah, talvez um dia o senhor venha a se preocupar com esses detalhes.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Senhor, a nossa cidade está precisando de estátuas. Que tal acrescentar mais algumas? Afinal, muitos acreditam que as estátuas protegem os habitantes.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "Anjos de rocha";
"T_GAME_QUEST_SUCCESS" = "Missão concluída!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "É uma excelente ideia, deixe-o fazer isso.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Que pessoa estranha.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Senhor, não podemos deixar o aldeão fazer isto. Vamos construir um acampamento de malabaristas e encarregar este lunático de entreter as pessoas.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Excelente! A população parece ter adorado o resultado.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Você observa a aldeia à distância.\n\nO caçador de lágrimas ainda está perseguindo os habitantes. Mais e mais pessoas se recusam a sair de casa.\n\nVocê se afasta lentamente da janela para não ter mais que encarar os problemas causados pela sua escolha.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Talvez você devesse ter feito alguma coisa... O aldeão esquisito está aterrorizando os habitantes e o ânimo diminuiu. Tomara que isso não dure!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Governador, hoje eu soube que um dos aldeões está decidido a deixar todos felizes. Ele começou a ir atrás dos habitantes e os força a rir...";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "O Caçador de Lágrimas";
"T_GAME_QUEST_THE_BATH_B_001" = "Essa foi por pouco. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Agora vamos proclamar que o banho é obrigatório. Isso reduzirá as doenças!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Banhos não obrigatórios.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "O senhor nunca aprende com seus erros!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Senhor, houve outro surto de doença. Desta vez muito mais grave que o anterior.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Desta vez, senhor, quer queira ou não, declararei que os banhos são obrigatórios!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "O seu conselheiro salvou muitas pessoas da doença. Ele até conseguiu entrar para os livros de história. Porém, você foi quem recusou os banhos. Centenas de crianças, mesmo anos depois, o idolatram por isso, porque, nas palavras delas, “tomar banho é a pior coisa". ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Banhos obrigatórios!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Sábia decisão, senhor. Agora as doenças diminuíram.";
"T_GAME_QUEST_THE_BATH_DESC" = "Há alguns dias, você instalou banhos públicos na cidade. Embora seja uma excelente ideia, os habitantes têm medo da água e não querem se lavar. \n\nO que fazer?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Aquecer a água.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Vamos estocar lenha suficiente para aquecer a água para os banhos.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Perfeito. A água está com temperatura agradável e conseguimos convencer alguns habitantes a tomar banho.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Infelizmente, seus esforços foram em vão e a doença mesmo assim começou a se espalhar pela cidade.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Deixá-los em paz.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Como quiser. Caso ocorram epidemias na aldeia, não reclame!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Durante vários meses, poucos habitantes tomaram banho. E quando um dos habitantes adoeceu, ele infectou outros três! Alguns até se convenceram de que a doença era causada pelos banhos.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Curar os habitantes.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Hora do banho";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Subornar.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Você foi ver os religiosos e pediu, em troca de algumas moedas, que anunciassem em seu sermão que o banho deixava as pessoas bonitas.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Dar o dinheiro necessário.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Tudo o que resta é pagar a quantia ao religioso, senhor.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Obrigado, governador. Darei sua mensagem.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Parece que os seus esforços valeram a pena. A doença está menos contagiosa e assim ficará por algum tempo!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Forçá-los!";
"T_GAME_QUEST_THE_BATH_YES_002" = "E lá vamos nós! Que os divulgadores anunciem esta boa notícia!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Nem todos os habitantes estão satisfeitos com a ideia de tomar banho regularmente. Alguns até dizem que se sentem mais fracos depois de mergulhar na água.\n\nOutros, que a água está fria demais, e se recusam a tomar banho.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Interrogar o mágico.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Assim que você estava prestes a interrogá-lo, uma fumaça espessa começa a engolir todo o reino, não dava nem para ver um palmo à frente do nariz.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Agora você está diante de um dilema: entregar os recursos necessários ou deixar que a situação se deteriore, aconteça o que acontecer. Você deve agir depressa, pois não se sabe do que os dois mágicos em fuga são capazes.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Senhor! Nós fracassamos, os mágicos conseguiram pegar os recursos e fugir.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Dar os recursos.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Vamos tentar dar todos os recursos que pede este mágico charlatão!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Conseguimos produzir todos os recursos solicitados. Agora o que temos a fazer é entregar a mercadoria no local especificado.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Você ocultou uma armadilha para os mágicos nas costas do seu conselheiro. Assim que eles aparecerem para recolher os bens, serão imediatamente capturados por uma rede! Tomara que a sua ideia engenhosa funcione.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Senhor! Conseguimos capturar o segundo mágico!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Você colocou dois guardas perto dos recursos. Os outros dois mágicos aparecem e lentamente se aproximam para pegar os bens. Quando estão na metade do caminho, os guardas disparam a armadilha.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Não desistir.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Então o senhor quer provocar a ira dos meus irmãos. Não gostaria de estar no seu lugar, governador.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "O nosso chefe vai fazer o senhor pagar por isso!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Ah! Finalmente você admite que estão seguindo as ordens de alguém! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "O mágico mordeu o lábio, um gesto de arrependimento por ter falado demais. Então ele foi enviado por alguém que tem algum problema pessoal com você.\n\nVocê tenta ao máximo pensar em quem possa ser, mas nenhum nome lhe vem à mente.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "O seu conselheiro vem correndo, em pânico: “Senhor! Mágicos na nossa porta! Estão pedindo hospedagem durante alguns dias. Devemos aceitar?”";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Governador... Tudo isso é um infeliz mal-entendido. Os meus irmãos e eu não queríamos causar tantos problemas ao senhor.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Então eles são seus irmãos. Por que iniciaram o incêndio?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Foi sem querer, senhor. Somos um pouco desajeitados, só isso...";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Para quem vocês trabalham? Para os bandidos?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "De jeito nenhum! Porém, se o senhor quer se livrar da espessa fumaça que aos poucos engole todo o seu território, é melhor atender ao meu pedido.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "E qual é o seu pedido? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Quero que me dê recursos e dinheiro!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "E o que mais? Diga onde estão os seus irmãos!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Se o senhor se recusar, novos desastres ocorrerão.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Senhor, a pessoa que contratou os mágicos não poderia ser o Duque de Cannes? Acabo de me lembrar que ele fez ameaças contra o senhor quando o senhor começou a escrever cartas para a Rainha Frygith.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Pode ser que seu conselheiro tenha razão: você agora se lembra mesmo que o Duque de Cannes pediu a Rainha Frygith em casamento mas, depois do encontro entre você e ela e do famoso baile, ela recusou.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Você é um feiticeiro barato! Então você trabalha para o Duque de Cannes!? Agora sabemos de tudo!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "De fato... O senhor descobriu. Vamos fazer um trato. O senhor me dá uma bela quantia de dinheiro e meus irmãos o deixarão em paz. Não o perturbaremos mais.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Senhor, não estamos em posição de negociar. Vamos dar a ele a quantia exigida e acabar com essa coisa de magia. Não podemos combater desastres sobrenaturais.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Embora você não goste de se sentir pressionado, precisa admitir que o conselheiro tem razão. O bem-estar dos habitantes é mais importante do que o seu ego.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Agora só precisamos libertar o mágico e pagar a quantia.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Fico feliz por ter negociado com o senhor, governador!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "O mágico desapareceu, levando o grande maço de dinheiro. Mas você nunca mais precisou lidar com eles.\n\nQuanto ao Duque de Cannes, você enviou uma carta para a rainha, que prometeu intervir pessoalmente no seu caso. Tudo ficou bem.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Depois de recuperar os sentidos e salvar a cidade das chamas, você pede ao guarda para convocar os três mágicos. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Os soldados dizem que conseguiram encontrar apenas um dos três mágicos. \n\nOs outros dois estão desaparecidos.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Senhor! O senhor está bem? Os mágicos explodiram os prédios! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Precisamos apagar o fogo o mais rápido possível!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "O últimos incêndios foram controlados, senhor.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "São três mágicos. Parecem aliviados por você ter acatado o pedido deles. Você disponibiliza hospedagem na pousada. Como eles não precisam de mais nada, você retorna aos seus afazeres de governador.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Assim que você sai da pousada, ouve um grande estrondo. BUUUUUUM! E agora vários prédios estão em chamas!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Não os deixe entrar.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "Oh, não! Temos uma epidemia de peste e vários prédios pegaram fogo! Talvez seja um truque dos mágicos!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Hahahahahahahaha!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Rápido, vamos curar os habitantes e apagar os incêndios!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Mais uma vez, escapamos de um verdadeiro desastre...";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Continuar a busca.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Continuaremos a busca, senhor!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "Ali está um! Peguem-no!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Os guardas começam a perseguir o segundo mágico quando, de repente, uma fumaça espessa cobre o vilarejo. Seus guardas deixam de persegui-lo, pois não conseguem enxergar nada.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Senhor, temos um novo problema! Não conseguimos mais andar rápido! É como se estivéssemos atravessando um mar de gelatina!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Precisamos retirar-nos para o castelo e interrogar o mágico que conseguimos capturar.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Você segue o conselho e decide se fechar no castelo a fim de começar a interrogar o primeiro mágico. Além disso, você pede ao chefe da guarda para proteger o castelo, para que ninguém saia ou entre.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "Você decide manter os dois mágicos longe um do outro e interrogar o mágico que você conseguiu capturar graças à sua incrível armadilha.\n\nInfelizmente, não conseguiu recuperar os recursos, que foram levados pelo terceiro mágico quando fugiu.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "O segundo mágico parece bem mais confiante que o primeiro. Sem hesitação, ele lhe diz o seguinte: “Parabéns, governador, você me pegou em flagrante. Mas saiba que se o senhor não me libertar imediatamente, coisas terríveis vão acontecer na sua aldeia."";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Liberte-o.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Você está com muito medo de que a aldeia sofra e decide libertá-lo.\n\n"Você sabe jogar, governador", disse o mágico, antes de desaparecer em uma nuvem de fumaça assim que os guardas removeram suas correntes.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Senhor! O primeiro mágico também escapou! O irmão apareceu ao seu lado dele e então ambos sumiram!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "... Voltamos à estaca zero.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "Vamos sair em busca destes meliantes, senhor! Pode confiar em nós.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Tudo o que precisamos fazer agora é aguardar o retorno das patrulhas, senhor.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Os seus guardas ficam um bom tempo tentando achar esses mágicos, mas sem sucesso até o momento. Porém, dia após dia, os habitantes veem que a estranha nuvem de fumaça que deixava todos mais lentos começa a se dissipar.\n\nO mistério em torno desses mágicos permanece sem solução.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Mantê-lo prisioneiro.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Os mágicos";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Pode mandá-los entrar.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Azul.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Verde.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Uma escolha ousada, devo dizer. Azul. Quem poderia odiar uma cor tão bonita? A cor dos sonhos, da sabedoria, da lealdade. Isso diz muito sobre o senhor, governador.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Recebemos um convidado no aposento reformado do castelo, senhor.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Infelizmente, as cores do ambiente não o deixaram dormir e ele diz que o senhor é o único responsável.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Ah, senhor, nosso convidado ficou encantado com o quarto! Ele gostou especialmente da cor! Decidiu nos dar prestígio.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "É verdade que o verde tem a reputação de significar infortúnio. Mas também é símbolo de esperança, sorte e estabilidade. Está em harmonia com todas as outras cores da natureza. É uma boa escolha.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Governador, acabamos de reformar um dos aposentos do castelo. Qual cor seria melhor?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "O Aposento";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "De jeito nenhum.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Envie espiões.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "Não existe magia.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Chame a feiticeira.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Senhor, isso é terrível. Como isso é possível? Seria ele um mágico adepto da magia negra?! Ninguém deveria ter tais poderes!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "Uma sábia decisão. Vamos mandar os nossos melhores espiões atrás deste habitante maluco e aguardar o relatório.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Os seus espiões retornam com o relatório.\n\n“Seguimos o habitante, o ladrão de alegria. Parece que o que ele diz deixa os habitantes triste. Eles não se lembram mais dos momentos alegres de suas vidas.”";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Senhor, um dos nossos habitantes parece estar tirando a alegria aos seus conterrâneos. \n\nVários habitantes apresentaram queixas contra este ladrão. Eis o testemunho de uma das vítimas: “Certa manhã, ele veio falar comigo. Escutei com atenção o que ele dizia e, de repente, fiquei muito triste. Como se suas palavras consumissem a minha alegria.”";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Senhor, devemos fazer algo quanto a este problema?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Governador, o que devemos fazer?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Ajudar a feiticeira.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "Fantasmas não existem!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "As medidas que tomamos parecem estar funcionando, senhor. \n\nO ladrão de alegria continua a fazer das suas, mas agora vamos combatê-lo. \n\nSerá que devemos enviar guardas para que ele pague por seus erros? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Que a justiça seja feita.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Não vamos fazer nada.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Você é uma pessoa sensata, só a ciência é capaz de explicar e solucionar o problema do ladrão de alegria.\n\nVocê chama seus melhores cientistas para trabalhar em uma fórmula que permitirá aos habitantes ficarem felizes novamente.\n\nÉ claro que a ciência não é de graça. Os cientistas estão pedindo em troca muito dinheiro. Do contrário, diga adeus à felicidade.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "O problema do ladrão de alegria não o deixou muito preocupado. No entanto, os casos de depressão entre os habitantes continuaram a aumentar drasticamente.\n\nDesorientado, você se refugiou em seu castelo, sem saber o que fazer para sanar o desastre. Dizem que o tempo cura todas as feridas. \n\nEspero que a sua paciência não esteja se esgotando.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "A feiticeira se foi. Alguns dizem que ela até deixou a aldeia, não querendo sofrer como os outros por sua causa.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "Logo depois de ela partir, a situação ficou insuportável. Todos os aldeões foram tomados por uma profunda tristeza.\n\nNão se sabe até quando isso vai durar!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Vamos mandar guardas para capturá-lo!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Os seus guardas ficam horas procurando e nada. Todos voltam tristes e deprimidos. Dizem que ouviram o ladrão de alegria, mas não o viram.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Pouco depois que os guardas voltaram, uma coruja veio e deixou uma mensagem da feiticeira.\n\nEla revelou que o ladrão de alegria era nada menos que um fantasma que se alimentava da alegria das pessoas, deixando-os com nada além de tristeza e desespero. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Apesar dos esforços de seus cientistas para atrasar o processo, toda a aldeia ficou infeliz. Com a feiticeira ausente, você não tem mais como se defender contra este fantasma. \n\nTomara que o tempo cure os habitantes.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "O tempo passou e a aldeia está novamente de bom humor. O ladrão de alegria agora é uma memória distante.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Pedir conselhos à feiticeira.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Negociar.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Senhor, tentarei negociar com os cientistas. Pode deixar comigo, eu cuido de tudo!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "O seu conselheiro, um ótimo negociador, conseguiu baixar o preço pedido pelos cientistas! Muito bem. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Ai. O seu conselheiro não foi capaz de negociar adequadamente. Os cientistas aumentaram seu preço e não querem mais discutir.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Pagar os cientistas.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Se precisamos pagar, vamos pagar, pois será nosso fim se continuarmos esperando.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Os habitantes estão apenas deprimidos, governador. Não conseguem ver o lado bom de nenhuma situação. \n\nA solução é mostrar-lhes o lado positivo da vida e provar que ela não é tão ruim assim. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Vamos começar adicionando algumas decorações e construir locais para feiras da cerveja. A música melhora o ânimo. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "Os habitantes começam a se sentir melhor. Alguns deles, cuja alegria tinha desaparecido, parecem recuperar as pequenas alegrias da vida.\n\nPorém, o ladrão de alegria continua a aterrorizar as pessoas.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Ladrão de alegria";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Há anos que não recorremos a esta feiticeira, governador... Espero que isto não traga mais tragédia à nossa aldeia do que já temos.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Bom dia, governador. Que bom vê-lo novamente. Está em apuros?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Depois de explicar a situação à feiticeira, ela apenas sorri. Será que ela encontrou a solução para o seu problema? Ou vai lhe pregar uma peça?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Fale logo! Porque está sorrindo desse jeito? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "O seu ladrão de alegria não existe, senhor.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Mas só pode ser verdade, porque um dos nossos espiões sofreu as consequências ao falar com ele!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "O que aconteceu foi que ele viu um fantasma da tristeza. Esse fantasma aparece de vez em quando depois da construção de um estabelecimento religioso. \n\nAo absorver a alegria, o fantasma ganha forças e seus poderes aumentam. Infelizmente, a alegria não retorna às pessoas roubadas.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "E como nos livramos dele?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Sei de uma solução, mas preciso da sua ajuda.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Nós vamos ajudar. Do que você precisa?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Precisamos de um mausoléu e lápides.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "Pronto, resolvido.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Nós concluímos a sua missão, feiticeira. Agora é a hora de você mostrar o que consegue fazer.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "A bruxa dirige-se ao mausoléu e desaparece lá dentro. Você ouve encantamentos. De repente, um vento se levanta, uma tempestade terrível parece estar se formando.\n\nA bruxa não sai do mausoléu. \n\nVocê de repente sente uma grande tristeza, um frio intenso e que está cercado de trevas.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Então, à distância, surge um raio de sol. Um raio de sol muito tímido. Você se concentra nele. Está ficando cada vez mais intenso. \n\nO raio de sol parece adotar a forma de uma memória. Uma memória sua. A sua memória mais feliz.\n\nVocê se sente bem novamente.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Governador... O que foi aquilo? O senhor também sentiu?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "O senhor agora está livre do fantasma da tristeza. Pela expressão no seu rosto, imagino que também o tenha encontrado. Tudo terminou. Eu o aprisionei.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "Foi horrível! Muito obrigado!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "A aldeia livrou-se do estranho fantasma. Os habitantes recuperaram sua alegria e sentem-se gratos a você.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Senhor, se não me ajudar neste projeto do fantasma, garanto que será a sua ruína.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "Que seja! Saia daqui com sua feitiçaria maldita!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Deixe-os jogar.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Eu também quero jogar!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Um festival de jogos de tabuleiro?! Que ideia estranha, senhor. Como vamos fazer isso? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Senhor, os nossos soldados estão jogando tanto nas torres de vigia que os habitantes não se sentem protegidos. O que podemos fazer?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Os Jogos da Torre";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Precisamos de madeira e pedra.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Precisamos de ideias e inventores de jogos.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Com uma pequena doação, podemos aumentar nossa reputação com o Rei, meu senhor.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Construa uma torre de guarda no alcance do quartel.";
"T_GAME_QUEST_WATER" = "Água";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Cale a boca, por favor.";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Vamos começar a construir um poço para evitar esse tipo de coisa.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Ah, senhor, por favor, nossas plantações correm perigo! Se o senhor nada fizer, não teremos a chance de ter um inverno tranquilo.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "O governador já disse o que queria sobre este assunto. Se você continuar vindo até o castelo para choramingar, precisaremos prendê-lo. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "... Vocês vão se decepcionar!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "SENHOR! AS PLANTAÇÕES! Que horrível! Nada mais cresce, o calor foi tão forte que as plantas morreram. O senhor deveria ter confiado mais naquele fazendeiro... Agora é tarde demais.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Vamos nos apressar e construir os poços, senhor.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "A construção dos poços foi concluída. É melhor prevenir do que remediar! O futuro dirá se foi a escolha certa ouvir o fazendeiro.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Senhor! Os fazendeiros disseram que uma onda de calor se abateu sobre as plantações MAS graças aos poços, evitamos muitos problemas.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Senhor! Tive outro sonho premonitório! As plantações estavam em chamas. Nada mais crescia. Não havia mais água.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Premonição";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Sirva-lhe um chá de ervas para acalmá-la. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Bom, por falar em chá de ervas – vamos espalhar essa ideia. Que as cidades vizinhas saibam que água quente com ervas e um bom slogan fazem muito bem.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Melhorar as defesas!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Vamos melhorar as defesas militares, Governador!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Fizemos um excelente trabalho, "o chá de ervas que faz esquecer as ovelhas" é um slogan inovador...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Agora vamos esperar... Pode ser que tenhamos feito muito barulho por nada. Devíamos ter dado a ela um chazinho...";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Apesar das suas expectativas e das melhorias nas defesas para ataques surpresa dos bandidos, eles não apareceram. Porém, agora você tem ótimos prédios militares para admirar.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Oh, não, senhor. A velha está surtando de novo! Está gritando que a feiticeira da floresta passará pela nossa aldeia e destruirá tudo o que estiver no caminho.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "O Caminho da Feiticeira";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Ah, senhor! \n\nQue lugar incrível! Um lago imenso, de grande beleza! \n\nA mulher estava lá! Corri atrás dela durante quase um quilômetro pelos túneis da mina, mas a perdi de vista.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "E então... Quando achei que voltaria para casa de mãos abanando, vi milhares de luzes. Ah, o senhor deveria ter visto, nunca vi nada igual! \n\nEla me contou seu plano de escapar com todo o tesouro e começar uma nova vida em outro lugar. Desde a morte de seu marido, ela acha difícil ficar aqui, há memórias demais...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Senhor, agora estamos prontos para entrar na mina e achar o tesouro. Há vários X no mapa.\n\nPor onde começamos? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Esconderijo Norte";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Esconderijo Sul";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "SENHOR! Tivemos sorte! Nossa equipe conseguiu escapar sem nenhum arranhão. Os túneis desabaram!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "O resultado dessa primeira expedição foi bem satisfatório! As pessoas conseguiram retornar a salvo da expedição e com parte do tesouro pirata de bônus.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Senhor, estamos prontos para entrar na mina uma segunda vez.\n\nQual esconderijo devemos investigar?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Esconderijo Leste";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Esconderijo Oeste";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "Uma oportunidade incrível está diante de nós, senhor! Duas vezes saímos vitoriosos dessa caça ao tesouro!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Você estuda atentamente o mapa da mina e vê a localização de um lago subterrâneo, alimentado por um rio que vai dar direto no mar. Um ótimo acesso para piratas!\n\nPorém, os túneis não são seguros e podem desabar a qualquer momento.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "Boa notícia! Enquanto você ajudava o ferreiro, o seu conselheiro obteve o mapa da mina.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Deixar a mina mais segura.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Enviar investigadores para a mina!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Vamos investir na mina para que ela fique segura, senhor. Essa tarefa exigirá muitos recursos, mas pode ter certeza que o senhor não se arrependerá.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "Inacreditável, senhor! Conseguimos deixar a mina segura! Nossos primeiros enviados foram lá e acharam a esposa do pirata!\nEla conseguiu escapar, mas deixou um mapa da mina com áreas marcadas com um X. Acho que são os lugares onde o tesouro está escondido!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Tudo o que temos a fazer é pagar o tributo, senhor.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Investigadores, investigadores... Não temos 50 investigadores! Vou ter de fazer isso sozinho. Mas preciso pelo menos de certo equipamento.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Pronto, estou preparado!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "O seu conselheiro foi até as minas para descobrir mais a respeito da mulher.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Traga-me o equipamento necessário para que a missão seja bem sucedida.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Você de repente fica sem paciência com o ferreiro. Ordena que ele traga seu equipamento o mais rápido possível e diz que sua encomenda urgente não é problema seu. Que você não liga se ele for à falência.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Eu... eu trarei assim que possível, senhor...";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Você foi rude ao se recusar a ajudar o ferreiro. Entenda que ele trabalha para sobreviver e a entrega dele parecia muito importante para a economia da sua cidade. Espero que não fique com raiva de nós.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Ah, senhor... O senhor deveria ter tomado mais cuidado. O ferreiro contou a todos como foi tratado. Vários habitantes agora estão protestando. E o ferreiro se recusa a voltar ao castelo.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Senhor, não vejo alternativa senão construir campo de justa. Isso servirá para distrair a população e deixá-los mais calmos.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Os habitantes parecem estar mais calmos. Porém ainda não terminamos essa história do pirata!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Senhor, o campo de justa é necessário. Do contrário, os habitantes não ficarão nem felizes e nem produtivos. Essa greve pode atrapalhar o assunto das minas e dos piratas.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Senhor, enquanto estávamos ocupados lidando com a revolta, a esposa do pirata se aproveitou para pegar o tesouro nas minas. Era lá que ele estava!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Nossos espiões acharam uma nota desta mulher dizendo que ela não suportava mais a ausência do marido e que ela ia se isolar numa ilha paradisíaca onde ela tem um pequeno castelo.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Pelo jeito, perdemos uma bela quantia de dinheiro, senhor. Viu o que suas decisões apressadas causam? Enfim, agora podemos esquecer esse acontecimento.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Vamos construir o campo de justa.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "O senhor comete um erro em não levar a sério essa questão, senhor. Quem sabe o que poderíamos ter descoberto?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Alguns dias depois de você se recusar a lidar com este problema, a mina desabou. A sua população considera você responsável por esse trágico evento.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "A sua população está começando a esquecer o assunto da mina que desabou. O tempo passou e todos estão mais animados.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Não conseguimos acessar os locais indicados no mapa, senhor. Não pudemos trazer nenhum tesouro. Mas estamos vivos, e isso é o que importa.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Apesar do fracasso, essa aventura gerou certo prestígio. Quem diria que piratas poderiam esconder tesouros assim em nossas minas?\n\nMas, por enquanto, sua carreira como caçador de tesouros está encerrada.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Ah, senhor. Fui informado de que os túneis da mina desmoronaram! Tivemos sorte por conseguir voltar duas vezes trazendo tesouros.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Uma única vez, você decide organizar uma grande refeição para seus soldados, para agradecê-los por trazer esses tesouros.\n\nAgora essa história do pirata está no passado. Quem sabe? Talvez um dia você encontre um mapa que possa levar a outros mistérios.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "O tesouro em breve será seu! \n\nVocê dá a ordem aos seus soldados para encontrar o tesouro e trazê-lo até você.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "Inacreditável! Olha só tudo o que achamos naquelas minas! Você estava certo ao deixá-las seguras antes de mandar seus ajudantes para lá. Que riqueza formidável! Então os boatos sobre o pirata eram verdadeiros. Agora estamos ricos!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Com os dados que temos, não há muito a fazer. Seria bom consultar um especialista.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Chame um mineiro.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "Boa ideia, senhor. Talvez ele possa nos dar um mapa das minas e nos ajudar a entender a situação.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Senhor, que bom que o senhor pediu minha ajuda. Eu trouxe o mapa da mina. Espero que possa ajudá-lo.\n\nOs túneis são antigos e temo que possam desabar.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Chame o ferreiro.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "O ferreiro sem dúvida poderá nos dar informações sobre as pedras que essa mulher está quebrando.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Senhor, recebemos muitas reclamações sobre as minas.\nUma mulher vai até lá todos os dias, tira pedras de lugar, às vezes as quebra. Mas o que se sabe ao certo é que cada vez mais ela avança pelos túneis.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Vá descobrir mais sobre essa mulher.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "Não é problema meu.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Os habitantes estão preocupados. Os túneis não são seguros e a mina pode desabar a qualquer momento.\n\nÉ nosso dever verificar o que está por trás dessa história.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Espero que você tenha aprendido a lição!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Enquanto a conselheira está em busca de pistas, seria uma boa ideia cuidar um pouco da cidade. Tente melhorar a vida das pessoas.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "Cá estou eu novamente, senhor! Segui esta mulher numa missão de espionagem. Não foi fácil.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Parece que ela está procurando um objeto. Eu a vi quebrando várias pedras e observando atentamente os destroços.\n\nPorém, não consegui segui-la por muito tempo. Ela parece conhecer as minas como a palma da própria mão!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "A sua conselheira retornou da missão trazendo notícias.\nEm seu relatório, ela diz que essa mulher ficou viúva recentemente. \n\nSeu marido era um pirata famoso. Dizem que ele possuía o maior tesouro de todos os tempos e que o escondeu não muito longe daqui.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Tenho uma teoria, senhor. Acho que essa mulher foi ameaçada por outros piratas para revelar exatamente onde está o tesouro!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Continuar a investigação.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Deixar pra lá.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "A mulher e a mina";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "O ferreiro chega rapidamente. Os seus guardas o tiraram da forja. Ele parece preocupado.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Senhor, como posso ajudá-lo?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Estamos numa missão e precisamos dos seus conhecimentos.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Pode falar.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "O conselheiro explica o caso ao ferreiro.\n\nTambém mostra-lhe as pedras quebradas que conseguiu pegar. Podemos perceber que o ferreiro parece reconhecer o tipo da pedra.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Minha nossa! São muitos geodos!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Ah, geodos? ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "São cristais especiais que contêm tesouros. Muitas vezes, são os cristais em si que são preciosos.\n\nAlguns piratas usam códigos com base em geodos para se lembrar onde ocultaram os tesouros.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Tenho alguns na minha oficina, posso mostrar como abri-los com a ferramenta correta.\n\nMas... tenho uma entrega importante e urgente a fazer e gostaria da ajuda do senhor, como símbolo de gratidão pela ajuda que forneci.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Recusar.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Aceitar.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Preciso produzir ferramentas para os mineiros. É uma encomenda grande.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Esses são os geodos. Vou mostrar ao senhor. Com este aparelho, é possível abri-los facilmente. Muitas vezes, não há nada demais neles, mas às vezes achamos verdadeiros tesouros!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "CRR CRR… CLING!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "Ah, senhor, olhe dentro deste geodo! Que coisa magnífica!";
