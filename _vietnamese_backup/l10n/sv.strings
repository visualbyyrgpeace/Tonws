"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Vi styr marknaden för hushållstyger och det högsta modet! Vi kommer att tjäna en förmögenhet!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Nu när råvaran är tillgänglig krävs fler byggnader. Ett väveri och ett skrädderi blir perfekt!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Efter ditt beslut kommer stora förändringar att ske i byn. Men ingenting är möjligt utan får, och en gård i gott skick.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Ers nåd, jag har precis kommit hem från grannstaden. De har vackra tyger och underbara broderier. Vi borde hämta inspiration från dem och producera exceptionella kläder, vi också.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Sidenblommor";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Det är pollentider igen och invånarna nyser hela tiden. Vad sägs om att hålla en nystävling?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "De koncentrerar sig och utför sina kraftfullaste nysningar i tur och ordning. Du måste välja din favorit, så att den personen kan utses till vinnare!";
