"T_GAME_QUEST_THE_BATH_TITLE" = "Dags för bad";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Mutor.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Du gick till de religiösa och gav dem lite mynt i utbyte mot att de skulle säga i sin predikan att bad gör folk vackra.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Ge dem pengarna.";
