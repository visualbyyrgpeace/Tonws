"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "ATCHOO!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "BOURACHOUM!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "Och här kommer vår vinnare! Den mest lyckade nysningen! Grattis! Det var enastående!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Stadsbon är stolt över sin belöning. Tävlingen gav inte dig så mycket, men din stad kanske blir känd för att ha haft historiens första nystävling!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Aldrig.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Från slottet hör du redan folkmassan samlas på byns torg. Du hör också nysningar. Tävlingen verkar bli väldigt rolig!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Många stadsbor står i kö och håller in sina nysningar för att släppa ut all deras kraft inför juryn, som består av dig och din rådgivare.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Du bedömer den ena stadsbon efter den andra. Du har skrivit ner namnen på tre stadsbor. Du ger listan till din rådgivare som tar med stadsborna till mitten av torget för finalen i nystävlingen!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Du bestämmer dig för att sprida ordet om att det ordnas en tävling på byns torg. Den stadsbo som vinner får en belöning!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Ers nåd, medan vi väntar på att stadsborna samlas på torget så borde vi förbereda festligheterna! Vi börjar med lite dekorationer.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Dekorera staden.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Det här gör vår stad mycket mer attraktiv.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Vi borde också ta en titt på våra lager.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Perfekt. Vi kommer att ha allt vi behöver under festligheterna.";
