"BUILDING_UPGRADE_TAXBONUS" = "Skattebonus";
"EVENT_WITCHHUNT_08_SUCCESS" = "Äntligen har vi en doktor i byn. Han kan säkert hjälpa oss med sjukdomen.";
"EVENT_WITCHHUNT_13_TIMERQUEST_STARTED" = "Vänta tills doktorn kommer tillbaka från huvudstaden.";
"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Byborna i staden skulle bli gladare om det fanns en gemensam lokal där de kunde träffas och ta ett krus druvsaft eller dricka lite brygd efter en hård dags arbete. Skulle det vara för mycket begärt, herre?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Öka nöjdheten med gemenskap.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Okej, guvernören. Om du inte tänker handla med mig så kommer mina mannar och jag bara att ta det vi behöver.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Den här gången hade du tur. Men nästa gång blir det inte lika lätt.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Haha! Låt det här bli en läxa för dig. Jag är säker på att du kommer att handla med mig nästa gång.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Herre, jag behöver massor med stenar. Jag stöttar dig med trä om du hjälper mig att skaffa lite stenar.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Herre, jag har samlat lite trä för att stötta byggandet av byn. Jag byter det mot lite vete.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Min dotter frös igår. Skulle du kunna hjälpa mig med lite ull? Jag kan ge dig värdefullt trä i utbyte.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Herre, jag har en fråga... Min son vill lära sig att bli garvare. Han behöver djurhudar för att öva. Jag kan byta dem mot lite trä.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Herre, har du lite örter? Tyvärr har jag inga att krydda mitt kött med.\nJag ger dig mitt bästa trä i utbyte.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Herre, jag vill reparera mitt hem. Skulle du vilja byta lite verktyg mot min sista hög med ved?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Herre, jag vill förbereda en fest. Kan du hjälpa mig? I gengäld ger jag dig lite trä.";
"SCENARIO_CW_QUEST_B_NAME" = "Handla med bonden.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Herre, min familj är hungrig. Skulle du kunna tänka dig att leverera lite fisk till oss? Jag kan ge dig lite trä från mitt lilla lager ved i gengäld.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Jag har ett litet lager med trä för reparationer. Jag byter det mot lite sten, herre.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Mina män behöver mer fisk. Ta med lite till mig så ger jag dig trä! Dessutom skonar jag din lilla by.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Hej, guvernör! Jag vill göra dig en tjänst och ta lite tunga stenar från ditt förråd. Om du låter mig göra det så ger jag dig dessutom lite ved.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Slösa inte vete genom att ge det till dina bönder. Ge det hellre till mig, så ska du få mitt finaste trä.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Vi vill mjuka upp våra svärds handtag med ull. Oroa dig inte – om du samarbetar så kommer vi inte att använda dem mot dig.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Mina män är uttråkade. Om du förser oss med djurhudar så kan vi förbättra våra träningsdockor så att de ser mer verkliga ut. Om du inte vill handla med mig så tränar vi bara på dina stadsbor.";
"SCENARIO_CW_QUEST_C_60_DESC" = "En av mina män har blivit sjuk. Jag hörde att örter kunde hjälpa honom. Om du inte har något emot det så letar jag efter dem i ditt förråd. Jag hittar dem säkert.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Våra verktyg är inte användbara längre. Du har gott om verktyg, guvernör. Var så snäll och ge mig några, så ska jag vara så snäll nog att inte stjäla dem.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Mina män vill äta kött. Ge oss det så ska jag vara så artig och ge dig lite ved för det.\n\nAnnars kanske mina män besöker din lilla stad och tar det...";
"SCENARIO_CW_QUEST_C_NAME" = "Handla med banditen.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "En ny guvernör...\nEftersom du är ny här så ska jag förklara reglerna. Du ger mig vad jag ber om och jag låter dig göra det du håller på med. \n\nDet låter väl som en rättvis överenskommelse? Vi börjar med en enkel uppgift: ge mig lite fisk!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Problem med trä? Inga problem! Jag har stulit... öh... förvarat en stor hög med ved. Jag byter gärna lite trä mot lite sten.\n";
"SCENARIO_THIEF_FAIL" = "Så du vill verkligen inte handla med mig?\n\nOkej, då får du se hur det går.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Herre, se vad vi har här... Det ser ut som en tand. Den är inte mänsklig. Och där! Mer tryffel. Jag vet inte tillräckligt för att lägga fram någon teori, men jag vet en person som kan hjälpa oss. Låt oss besöka den gamle mannen!";
"THEBEAST_CHOICE_A_ACOLYTE_DESC" = "Vem förutom köpmannen skulle skylla så mycket på lokalbefolkningen? Det är han som är medbrottslingen!";
"THEBEAST_CHOICE_A_ACOLYTE_TITLE" = "Köpmannen!";
"THEBEAST_CHOICE_A_COUPABLE_DESC" = "Det är förmodligen den unga kvinnan! Hon är syster till den förvisade stadskvinnan. Det är ett motiv!";
"THEBEAST_CHOICE_A_COUPABLE_TITLE" = "Den unga jungfrun!";
"THEBEAST_CHOICE_A_REASON_DESC" = "Den unga kvinnan som felaktigt förvisades av drottningen låg bakom attackerna. Hon ville hämnas för att hon drevs i exil.";
"THEBEAST_CHOICE_A_REASON_TITLE" = "V för Vendetta!";
"THEBEAST_CHOICE_B_ACOLYTE_DESC" = "Byns strävan efter välstånd förvandlades till en mardröm... Han ville nog inget illa, han ville bara hjälpa sin granne.";
"THEBEAST_CHOICE_B_ACOLYTE_TITLE" = "Hector, konstnären!";
"THEBEAST_CHOICE_B_COUPABLE_DESC" = "Det är definitivt han! Han hatar nykomlingarna och attackerade den landsförvisade flickans syster för att se till att hon inte skadar hans vingård.";
"THEBEAST_CHOICE_B_COUPABLE_TITLE" = "Bonden Basil.";
"THEBEAST_CHOICE_B_REASON_DESC" = "Genom att skrämma stadsborna ville gärningsmannen driva bort dem från staden och förhindra att fler flyttade hit.";
"THEBEAST_CHOICE_B_REASON_TITLE" = "För att avskräcka fler nykomlingar från att flytta till byn!";
"THEBEAST_CHOICE_C_ACOLYTE_DESC" = "Hon hjälpte säkert den skyldige med pengar.";
"THEBEAST_CHOICE_C_ACOLYTE_TITLE" = "Drottning Frygith!";
"THEBEAST_CHOICE_C_COUPABLE_DESC" = "Det var bagaren! Han låtsades ha blivit attackerad för att undvika misstankar! Vilket geni!";
"THEBEAST_CHOICE_C_COUPABLE_TITLE" = "Bagaren.";
"THEBEAST_CHOICE_C_REASON_DESC" = "Drottning Frygith, som ångrade beslutet att öppna gränserna, samarbetade med några lokalbor för att skrämma nykomlingarna och stänga gränserna igen!";
"THEBEAST_CHOICE_C_REASON_TITLE" = "En statlig konspiration.";
