"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_005" = "Den blå riddaren blev duellens vinnare. Segern går därför till soldaterna.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_006" = "Stadsborna måste kompensera soldaterna för att de kastade tomater på dem. Men soldaterna måste göra samhällstjänst. Om de börjar organisera spelkvällar igen så förvisas de från staden.";
"T_GAME_QUEST_BOARDGAME_TOUNROI_QUEST_007" = "Ers nåd, kungen har hört talas om att tornerspelsplatsen har använts för att skapa rättvisa. Han vill berätta att han uppskattar det och därför vill ge dig lite prestige. Slutet gott, allting gott.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_001" = "Skicka jägare.";
"T_GAME_QUEST_BOAR_REGULATION_ANSWER_002" = "Det är inte mitt problem.";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_A" = "Men, sir... För att jaga borde vi ha minst en jägare... Vi har ingen tid att förlora. Vi borde bygga en jaktstuga!";
"T_GAME_QUEST_BOAR_REGULATION_CONSEQUENCE_001_B" = "Uppdraget är slutfört! Det blev ingen dålig jakt. Området är säkrat.";
"T_GAME_QUEST_BOAR_REGULATION_TITLE" = "Vildsvinsreglering";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_001" = "Din bror är en fågel.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_002" = "Hoppsan! Vakter! Gå och hämta honom.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_003" = "Jag ger dig min tillåtelse att göra det.";
"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Okej, det räcker, ta den här mannen till en helare.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Vad menar du? Skulle min bror vara en fågel? Du har tappat förståndet.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Vad guvernören försöker säga är att du måste lita på honom. Din bror vet vad han gör. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Om du säger det, så... Om det händer honom något så håller jag dig ansvarig!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Guvernör, vi gav honom lite lugnande medel, och nu sover han. Han mumlade konstiga saker om en teknik som skulle gjort så att han kunde kliva över berg. Du gjord rätt som tog honom till mig. Hade det gått längre så hade han sagt att jorden är rund!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Herre! Vi tog emot en budbärare från palatset. Kungen meddelar att vår uppfinnare är helt otrolig, och han skulle vilja att uppfinnaren stannar kvar i huvudstaden för att fortsätta med sitt arbete. Stadens kulturella inflytande har tagit ett kliv framåt! Kungen har beslutat att skicka oss lite prestige.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Herre, jag kommer till dig för att min bror har blivit galen. Han hävdar att han är en fågel och kan flyga! Jag är rädd att han ska göra något dumt och klättrar lite för högt för att bevisa att han kan flyga som en fågel.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Åh, herre! Tack för att du inte satte mig i fängelsehålan! Min syster oroar sig för mycket över mig. Jag ville överraska dig med min upptäckt! Jag har uppfunnit en maskin som kan flyga! Som fåglar! Jag skulle vilja presentera den i huvudstaden på den stora årliga mässan.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Fågelbrodern";
"T_GAME_QUEST_COVERAGE_DESC" = "Herre, staden är inte förberedd för banditattacker!\nStörre delen av byn täcks inte av vakttorn. Du måste placera ut vakttorn så att de täcker så många byggnader som möjligt.";
"T_GAME_QUEST_COVERAGE_GENERIC_DESC" = "Herre, staden är inte förberedd på banditattacker! Delar av staden täcks inte av försvarsbyggnader. ";
"T_GAME_QUEST_COVERAGE_GENERIC_TITLE" = "Öka hur mycket av staden som täcks av försvarsbyggnader";
"T_GAME_QUEST_COVERAGE_TITLE" = "Täck byn med vakttorn.";
"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Banditer attackerar byn, guvernör!\nVi måste slå tillbaka så många anfallare som möjligt för att minimera skadorna på vår ekonomi och byggnaderna!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Herre,\nStadsborna är rädda för banditattacker. Vi borde visa stadsborna, och framför allt banditerna, att vi kan försvara oss själva!";
"T_GAME_QUEST_DESIRES_01_START" = "Vilken lantlig region. Den saknar alla fördelarna med en storstad.\n\nDet är mycket som måste förändras för att den här staden ska bli en blomstrande metropol!";
"T_GAME_QUEST_DESIRES_01_SUCCESS" = "Nu när banditerna har besegrats och byn har växt har det blivit riktigt vackert här.\nDet var en bra idé att flytta hit, älskling.";
"T_GAME_QUEST_DESIRES_01_TITLE" = "Se till att din fru känner sig bekväm.";
"T_GAME_QUEST_DESIRES_02_START" = "Den här byn behöver också ett skrädderi så att jag kan låta sy upp nya kläder.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Tack älskling!\nMina gamla kläder har redan blivit väldigt slitna.";
"T_GAME_QUEST_DESIRES_03_START" = "Jag saknar stadens liv och rörelse.\nSnälla, se till att fler människor kommer och gör staden mer livfull!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Öka befolkningen.";
"T_GAME_QUEST_DESIRES_04_START" = "Vilken trevlig och livfull by!\n\nDu har säkert inget emot att jag bosätter mig här.";
"T_GAME_QUEST_DESIRES_05_START" = "Banditer i skogen?\nSkapa en stadsvakt för att slå tillbaka de där skurkarna!";
"T_GAME_QUEST_DESIRES_06_START" = "Åh, ett vakttorn...\n\nDu ska veta att sånt där beteende bara sporrar mina män!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "De där banditerna ställer till problem i stan.\n\nJag vill att du förstärker stadsvakten omedelbart!";
"T_GAME_QUEST_DESIRES_07_START" = "Se till att våra vakter håller banditerna utanför staden!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Fantastiskt! Jag känner mig mycket säkrare nu.";
"T_GAME_QUEST_DESIRES_07_TITLE" = "Slå tillbaka alla banditattacker.";
"T_GAME_QUEST_DESIRES_08_START" = "För att se till att vakterna uppfyller sina plikter bör du servera dem brygd och korv!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "Tillverka brygd och korv.";
"T_GAME_QUEST_DESIRES_09_START" = "Vakterna behöver vapen och rustningar för att kunna slå tillbaka banditerna!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Nu borde vakterna kunna slå tillbaka alla banditer!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Tillverka vapen och rustningar.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Jag borde ha nämnt att mitt folk kommer att ta sin del ändå!";
"T_GAME_QUEST_DESIRES_10_START" = "Ditt sätt att uppfylla alla din frus önskemål får mig att tro att du har problem med alltför mycket pengar.\n\nLåt mig befria dig från den tunga bördan!";
"T_GAME_QUEST_DESIRES_10_SUCCESS" = "Det vore ett klokt beslut att skicka de där mynten till mig nu, härskare!";
"T_GAME_QUEST_DESIRES_10_TITLE" = "En kostnad.";
"T_GAME_QUEST_DESIRES_11_START" = "Du tänker väl inte ge efter för den där utpressningen?\nAtt spendera mynten på nya kläder vore en mycket bättre investering!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Köp tyg hos köpmannen.";
"T_GAME_QUEST_DESIRES_12_START" = "Den här byn är tråkig. Den saknar underhållning!";
"T_GAME_QUEST_DESIRES_12_START_DEPRECATED" = "Den här byn är tråkig. Den har ingen tornerspelsplats!";
"T_GAME_QUEST_DESIRES_12_SUCCESS" = "Mycket bättre! Det börjar se trevligt ut här.";
"T_GAME_QUEST_DESIRES_12_TITLE" = "Bygg en tornerspelsplats.";
"T_GAME_QUEST_DESIRES_13_FAIL" = "Du lärde dig inget från förra gången. Mina grabbar kommer över och gör en liten inventering!";
"T_GAME_QUEST_DESIRES_13_START" = "Det verkar som att du fortfarande lider av överflöd. Ge mig ditt guld!\nOch våga inte ge det till din fru!";
"T_GAME_QUEST_DESIRES_13_SUCCESS" = "Du verkar ha lärt dig nåt. Mina män kanske inte behöver hämta sin del längre.";
"T_GAME_QUEST_DESIRES_15_START" = "Du borde bearbeta guldet till smycken åt mig, min älskling!";
"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Tack så mycket, älskling!";
"T_GAME_QUEST_DESIRES_16_START" = "Jag vill ha en liten tillställning.\nSå jag behöver saft och bröd.";
"T_GAME_QUEST_DESIRES_16_SUCCESS" = "Utmärkt. Jag hoppas att det inte blir några otrevligheter med banditer.";
"T_GAME_QUEST_DESIRES_17_START" = "Åh, vilken trevlig fest. Har du glömt att bjuda in oss? ";
"T_GAME_QUEST_DESIRES_18_START" = "Nu får det vara nog. Gör dig av med de där banditerna en gång för alla!\nFörstör deras läger.";
"T_GAME_QUEST_DESIRES_18_SUCCESS" = "Äntligen blev vi av med de där skurkarna!";
"T_GAME_QUEST_DESIRES_18_TITLE" = "Förstör alla banditläger.";
"T_GAME_QUEST_DESIRES_19_START" = "Har den här byn inte ens en marknadsplats!?\nBygg en, min kära, så att jag kan köpa varor från staden.";
"T_GAME_QUEST_DESIRES_19_SUCCESS" = "Det här gör det en smula mer uthärdligt att bo här.";
"T_GAME_QUEST_DESIRES_20_START" = "Har de inga andra matvaror än fisk?\nBygg ett bageri och se till att det finns bröd.";
"T_GAME_QUEST_DESIRES_20_SUCCESS" = "Tack så mycket! Jag börjar redan bli trött på fisk.";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_01" = "Herre, våra spanare rapporterar att regionens banditer samlas vid stadens gränser. Jag fruktar att en storskalig banditattack är på väg.\nVi borde förbereda vårt försvar!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_02" = "Banditerna attackerar!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_03" = "Nästa våg av plundrande banditer har nått staden, herre!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Guvernör, banditerna har inlett nästa attack!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "En till våg av banditer är på väg till staden, furste!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "En enorm våg av banditer är på väg, furste. Det verkar som att det är den sista vågen av banditer. Vi måste se till att vårt försvar håller!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Herre, stadsvakten rapporterar att attacken är över. De återstående banditerna har drivits ut ur staden och flyr.";
"T_GAME_QUEST_DISASTER_ANIMAL_SUCCESS" = "Djurpopulationen håller på att återhämta sig. Äntligen kan vi ge oss ut på jakt igen!";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Fälten håller sakta på att återhämta sig, furste. Grödornas sjukdom verkar ha passerat.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Fälten håller sakta på att återhämta sig, furste. Torkan verkar ha passerat.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "Staden brinner, härskare!\n\nVi måste släcka elden snabbt innan den sprider sig över hela staden.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Utmärkt, furste.\n\nAlla bränder har släckts och staden är räddad igen.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Det är inga fler bränder i staden, furste.";
"T_GAME_QUEST_DISASTER_FIRE_TITLE_NEW" = "Se till att ingen byggnad brinner ner.";
"T_GAME_QUEST_DISASTER_PLAGUE_START" = "Herre, böldpesten härjar i landet.\n\nVi måste ta hand om de sjuka innan hela staden blir smittad.";
"T_GAME_QUEST_DISASTER_PLAGUE_SUCCESS" = "Vi gjorde det, furste!\n\nPestsmittan har stoppats. Staden är säker igen.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Modern medicin.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Huskurer.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Läkaren blev mycket upprörd och bestämde sig för att förstöra sjukstugan! Han sade: "Om du föredrar huskurer så behöver du inte mitt labb längre!"";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_001" = "Ett klokt beslut, sir.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_A_002" = "Tack vare ditt val har doktorns vård blivit mycket effektivare!";
"T_GAME_QUEST_DOCTORS_GRANDMA_DESC" = "Sir, många bybor vet inte längre vart de ska vända sig när de har problem med hälsan. Ska vi hänvisa dem till modern medicin eller gamla huskurer?";
"T_GAME_QUEST_DOCTORS_GRANDMA_TITLE" = "Läkare och huskurer";
"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Gå och lägg dig igen.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Jag litar på dig.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Åh, nej! Vi borde ha lyssnat på den drömmande stadsbon! Vissa har drabbats av en konstig sjukdom.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Som tur är har vi lyckats stoppa sjukdomen. Vi borde lyssna på föraningarna nästa gång...";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Den här stadsbon har räddat oss från katastrofer mer än en gång. Vi borde bygga en sjukstuga för säkerhets skull, ers nåd.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Herre! Vi har precis byggt färdigt sjukstugan, och några av våra stadsbor är sjuka. Det var bra att du bestämde dig för att lyssna på stadsbon! Sjukdomens effekt begränsades. Bra gjort, sir.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Vi måste fortfarande bota dem, ers nåd. Annars kan sjukdomen spridas.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Utmärkt! Hela byn är vid god hälsa igen. Vi kan gå tillbaka till vårt arbete.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Herre, i natt drömde jag att vår by blev smittad av en konstig sjukdom. Alla invånare bliv täppta i näsan.\n\nTror du att det kan ha varit en sanndröm?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Drömtid";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Jag ser fram emot det!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Åh. Jag föredrog det förra.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_004" = "Nej, det har jag inte tid med.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Nej betyder nej.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Skicka in henne.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Beviljas.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Det är uteslutet att locka fler resenärer.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "I en makalös uppvisning av generositet sätter du igång. Värdshuset kommer att simma i blommor!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Okej då.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = ""Hör upp, hör upp, gott folk! Värdshuset har fått en ny ägare! Kom till värdshusets nyöppning!"\n\nStadsutroparen är på gott humör idag. Det sägs att han får dricks varje gång det kommer en ny gäst till värdshuset.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Ers nåd, vi besök från värdshusets nya ägare. Vill du välkomna henne?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Ers nåd, snälla. Värdshuset är en av resenärernas favoritplatser. Vi skulle kunna förbättra stadens rykte genom att rusta upp det.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "God morgon, ers nåd. Tack för att du tar emot mig i ditt slott.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "Vad förskaffar oss äran av ditt besök?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Det är så att värdshuset är i väldigt dåligt skick. Den förra ägaren var väldigt slarvig. Inte bara med leverantörerna, utan även med kunderna!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Okej, om du säger det så. Vi tillbringar inte mycket tid på värdshuset.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Jag är här för att be dig om hjälp. Jag skulle vilja börja med att lägga till blommor runt min servering. För att göra den charmigare. Jag vill locka fler resenärer och göra så att de kanske kommer tillbaka.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Nu går vi vidare till steg två! Dryckerna.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! Ett andra steg... Nåväl, eftersom vi är här så kan vi lika gärna fortsätta. Vad är nästa steg i din plan?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "Vi behöver metall och trä av högsta kvalitet.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "Sade du inte något om drinkar? Varför behöver vi trä nu?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Kom igen! För att göra anständiga tunnor, såklart. Den förra ägaren hade inte ens ordentliga tunnor för att lagra dryckerna. Leverantörerna fick använda dåligt virke. Så vi måste samla ihop tillräckligt med trä och järntackor för att tillverka dem själva.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Utmärkt! De är jättefina!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Om du tar det på det viset så klarar jag mig själv!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "Från och med nu kommer stadsutroparen att gynna värdshuset i sina tillkännagivanden.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "Från och med nu kommer stadsutroparen att gynna krogen i sina tillkännagivanden.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Tack, guvernören! Slutet gott, allting gott.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Tack, ers nåd! Värdshuset är så mycket mer välkomnande med blommorna.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Kom igen, ers nåd. Ta dig tid att tänka lite på saken. Värdshuset är en viktig inkomstkälla för byn. Det kan hjälpa dig att genomföra några av dina projekt.\n\nÄr du säker på att du vill avbryta dina ansträngningar?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Vad säger du, herre!? Du hjälper den där unga kvinnan med hennes värdshus – och jag då? Du hjälper inte mig med min krog!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Kom igen! Uppför dig när du tilltalar guvernören.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Jag kräver att få samma privilegier som den här kvinnan!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Vill du också ha blommor till din servering?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Blommor? Nej! Jag vill ha en stadsutropare som stöttar mig också!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Ers nåd, vad ska vi göra?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Marknadsför krogen.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Marknadsför värdshuset.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Blommor och fiender";
"T_GAME_QUEST_FEAST_TITLE" = "Arrangera en festival för staden.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Täck byn med brandvaktstorn.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Herre, staden är inte förberedd för stora bränder! Delar av byn täcks inte av brandvaktstorn. Placera ut torn så att de täcker så många byggnader som möjligt.";
"T_GAME_QUEST_FOOD_STARTED" = "Vi får inte glömma maten, sir! Ingen festival utan ett fullt skafferi. Vi borde skynda oss att se till att vi har resurserna i lager. Ju förr vi har dem, desto snabbare kan ditt projekt genomföras.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Våra festivaldeltagare kommer inte att svälta ihjäl! Vi närmar oss målet! Jag ser verkligen fram emot det!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "En guvernör som inte kan erbjuda en förfriskning till en drottning!? Jag fick höra att jag borde vara misstänksam mot dig, men jag lyssnade inte!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Kom igen, drottning Frygith, bli inte arg över en sådan småsak. Det är bara en förfriskning. Var inte så dramatisk.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Jag märker att till och med din rådgivare börjar bli respektlös mot mig...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "Situationen är helt överstyr. Du vet inte vad du ska göra längre och dina stressnivåer bara stiger.\n\nHur reagerar du?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Försök lugna drottningen.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_002" = "Guvernören har känslor för dig, och han vet bara inte hur han ska bete sig. Det här är första gången han är kär.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_003" = "Drottningen känner sig också känslosam. Det verkar som att hon har känslor för dig också. Kan detta vara början på en riktig kärlekshistoria? Hade den där spåkvinnan rätt hela tiden?\n\nDet kan bara tiden utvisa. Samtidigt har drottningen bestämt sig för att dansa en gång till.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_004" = "Det har gått flera månader sedan den omtalade balen. Du och drottning Frygith har ett förhållande med brevkontakt. Ibland kommer hon för att träffa dig när vädret tillåter.\n\nKanske kommer hon en dag att välja dig som kung av sitt rike. Men för tillfället har hon för mycket att sköta för att bli drottning.\n\nOch det har du också! Du måste fortsätta göra allt som står i din makt för att din stad ska fungera smidigt.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_005" = "Stadsborna är glada för dig och drottningen. De har märkt en ökning av antalet resenärer. De kommer främst för att smaka på den druvsaft och dryck som drottningen nekades under festen. Enligt ryktena var den så bra att alla reserver tog slut på reserver på mindre än en timme.\n\nProduktiviteten i de här två byggnaderna har ökat!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_001" = "Korten.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_002" = "Jag drar kort åt dig, sir. De kommer att berätta lite om vilken typ av person du är och vilket öde som väntar dig. ";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_003" = "Efter det första kortet blandar hon leken igen.\n\nHon ber dig att dra tre kort. Ett för dåtiden, ett för nutiden och ett för framtiden.\n\nNär alla kort har dragits vänder hon dem, ett i taget.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_004" = "Herre, de här tre korten säger mig att du har en mycket svår tid framför dig. Du borde vara misstänksam mot människorna i kyrkan. Korten berättar att de har försökt att närma sig dig tidigare, men utan större framgång.\n\nDu har blivit varnad.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_005" = "Underbara kort, ers nåd! Allt är positivt. Du kommer att träffa en kvinna. En fantastisk kvinna som kommer att väcka liv i ditt hjärta. Kärleken är på väg! Var beredd när hon knackar på din dörr.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_A_001" = "Du ser den här unga kvinnan blanda korten, och så viskar hon ditt namn till dem. För att överföra din energi.\n\nSedan ber hon dig välja höger eller vänster korthög.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_001" = "Jag hoppas att förutsägelsen inte går i uppfyllelse och att de religiösa personerna trivs i vår stad.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_002" = "Nästa morgon kommer en munk till dig. Han berättar att kyrkan behöver mer resurser och att ytterligare en plats för tillbedjan vore mycket uppskattad.\n\nDu kommer att tänka på spåkvinnans förutsägelse.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_003" = "Ers nåd, en ny kyrka skulle kunna hjälpa befolkningen att få ett andligt uppvaknande. Tack så mycket.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_004_TITLE" = "Bygg en ny plats för tillbedjan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_CHURCH_006" = "Det här är perfekt! Vi kommer att ta god vara på den här nya platsen för tillbedjan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_001" = "Vänster korthög.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_002" = "Det här kortet indikerar att det finns en väldigt mörk sida hos dig, och det kommer att leda dig till självdestruktivitet. Jag är rädd att det kommer att påverka ditt folks produktivitet.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_LEFT_003" = "Jag känner att du är förvirrad och att din rådgivare vill att du ska gå. Men stanna ett tag – det är inte över än. Ett andra kort kan ge mer specifika svar.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_001" = "Ers nåd, den här spåkvinnan talar sanning. Vi har ett besök planerat den kommande helgen. Det ger oss tillräckligt med tid att planera en fest och snygga kläder!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_002" = "Ordna en fest";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_003" = "Det blir aldrig en bra fest utan mat och dryck. Låt oss börja med det, ers nåd.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_004" = "Perfekt! Vi har nu tillräckligt med mat och dryck för att göra våra gäster glada.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_005" = "Ers nåd, du borde göra allt du kan för det här firandet. Tänk om du träffar din själsfrände där?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_006" = "Din rådgivare kan ha en poäng. Så du bestämmer dig för att klä dig i dina vackraste kläder. Hela staden glimmar, och du tvekar inte en sekund att visa upp din rikedom.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_PARTY_007" = "Det här kommer att gå till historien! Det kommer säkert att imponera på en potentiell kärlek.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_001" = "Höger korthög.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CARDS_RIGHT_002" = "Du är en omtänksam person, och korten säger mig att det kommer att påverka produktiviteten hos dina invånare!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_001" = "Kristallkulan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_002" = "Mycket bra val, guvernör. Kom närmare och titta i kristallkulan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_BAD_001" = "Spåkvinnan för händerna mot kristallkulan, och plötsligt dyker en blå rök upp.\n\n"Herre, en stor olycka kan drabba dig. Jag ser munkar. Kanske kommer de att bli orsaken till din olycka," säger hon med en sorgsen underton.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRISTAL_GOOD_001" = "Spåkvinnan för händerna mot kristallkulan, och plötsligt dyker en rosa rök upp.\n\n"Herre, du kommer att hitta kärleken! Den sanna kärleken! Du kommer att få en otrolig historia, det försäkrar jag dig!" säger hon med en självsäker blick.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_001" = "Gå och gråt i ditt rum.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_002" = "Panikslagen flyr du från balsalen och springer till ditt rum för att kollapsa medan du gråter i din säng.\n\nAllt tyder på att du lider av brustet hjärta. Bara tid i ensamhet kan råda bot på det här.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CRY_003" = "Under flera månader har du sakta återhämtat dig från ditt krossade hjärta.\n\nDrottning Frygith har aldrig frågat om hur du mår. Hon bryr sig inte om dig ett dugg.\n\nÅ andra sidan har du skrivit historia och omnämns nu i böckerna som den förälskade guvernören. Det har givit dig sympati hos folket, och de arbetar nu effektivare.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_DRINKS_001" = "Ge henne något att dricka.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_002" = "Du bestämmer dig för att gå till spåkvinnan tillsammans med din rådgivare. Hon kanske kan hjälpa dig att förhindra en olycka, eller ger dig goda nyheter.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_FORTUNE_003" = "Spåkvinnan är inte långt från slottet. Du går in i det lilla tältet. Det finns en hel massa mystiska föremål där. På något sätt lugnar det dig.\n\n"Herre, sätt dig. Jag är så glad att du tackade ja till min inbjudan. Vilken metod föredrar du?"";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_JUICE_001" = "Ge henne lite druvsaft.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_001" = "Du kan beundra paraderna från ditt slotts högsta del. Och plötsligt, i fjärran, ser du en kortege närma sig. Din uppmärksamhet faller på en vacker kvinna. Ditt hjärta blir överväldigat.\n\nÄr det så här kärlek vid första ögonkastet känns?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_002" = "Uppfylld av kärlek bestämmer du dig för att gå och träffa den här vackra främlingen. Du missar nästan ett trappsteg, så du går ner för trappan på alla fyra. Din rådgivare, som så bredvid dig och tittar ned på dig, förstår inte vad du håller på med.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_003" = "Ers nåd, det här är drottning Frygith. Jag vet inte varför du tog dig till henne så snabbt.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_004" = "Trevligt att träffa dig, guvernör.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_005" = "Drottning Frygith bländade dig med sin utstrålning. Du vet inte hur du ska bete dig längre. Lyckligtvis hjälper din pålitliga rådgivare dig och gör att du lyckas skärpa dig.\n\nDu bestämmer dig för att bjuda in drottning Frygith till balen ikväll. Förhoppningsvis tackar hon ja till denna första romantiska dejt.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_006" = "Drottning Frygith, guvernören bjuder in dig till kvällens bal som hans dejt. Vill hedra oss genom att tacka ja?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_007" = "Det här är helt olämpligt! Jag är bortlovad till hertigen av Cannes. Jag kan inte gå på dejt med en guvernör.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_008" = "Jag tackar gärna ja till din inbjudan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_009" = "Det är äntligen dags för balen. Du har bett de mest prestigefyllda musikerna att spela för er den här kvällen. Du vill att absolut allt ska vara perfekt för din älskling.\n\nDrottning Frygith kommer till sist och är klädd i en elegant klänning. Varje sekund du tillbringar i hennes närvaro gör att din kärlek blir starkare.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_LOVE_010" = "Musiken passar perfekt, och även drottning Frygith verkar vara förtrollad av den. Det är dags för en paus och hon ber dig om en liten förfriskning.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NADA_001" = "Du har inget att erbjuda henne.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_001" = "Tacka nej till inbjudan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_002" = "Du gjorde rätt, guvernör. Vem vet vilka typer av problem vi kunde hamnat i!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_007" = "Med krossat hjärta bestämmer du dig för att inte gå på balen alls. Du sörjer länge. Och det märks på din stad. Invånarnas produktivitet och lycka minskar. Vi får hoppas att det inte håller i sig.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_NO_LOVE_008" = "Du börjar se ljuset i slutet av tunneln och har nu övervunnit din sorg. Du börjar sakta komma ut ur ditt rum igen.\n\nFolket är nöjda med ditt tillfrisknande och det har en positiv inverkan på deras produktivitet och moral.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_001" = "Tack guvernör, du är en mycket charmig man. Vill du använda kvällen till att göra ett handelsavtal? Så vi skulle få anledning att träffas igen...";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_002" = "Jag lämnar dig med drottningen, guvernör.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_003" = "Du och drottningen tar en stund för er själva i den kungliga trädgården. Som i sagorna. Tiden står stilla för dig och drottning Frygith. Du samlar allt ditt mod och delar med dig av dina känslor. Det visar sig att drottningens känslor är ömsesidiga!\n\nTyvärr går solen upp och drottningen måste återvända. Hon har mycket att ta itu med i sitt land. Och du vet att det inte är så lätt att driva ett land ensam.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_OFFER_004" = "Stadsborna är också glada för din skull. De är mindre benägna att strejka, vilket är goda nyheter.\n\nDu det verkligen rätt som rådfrågade spåkvinnan.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_YES_001" = "Det gör jag gärna!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_001" = "Herre, det är hemskt. Alla som tvingas gå i kyrkan mår jättedåligt. De orkar inte mer. Vi borde be för att de ska komma över det! Det var ett dåligt beslut att göra gudstjänsten obligatorisk!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_BAD_002" = "Hela saken med kyrkan och spåkvinnan ligger bakom oss nu. Folk börjar få tillbaka sin lycka.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_GOOD_001" = "Ditt beslut var fördelaktigt för oss, ers nåd! Du gjorde rätt som gjorde gudstjänsten obligatorisk. Nu är stadsborna gladare och mer produktiva.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_001" = "Byns religiösa ledare by har kommit tillbaka för att träffa dig.\n\n"Ers nåd, jag vill be dig om en sak. Kan du göra gudstjänsten obligatorisk? Du förstår, med alla spåkvinnor i området är jag rädd att folk kan bli påverkade. Jag skulle vilja rädda dem innan det är för sent."";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_001" = "Godkänn önskemålet.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_ACCEPT_002" = "Jag lovar att du inte kommer att ångra det, ers nåd!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_001" = "Vägra.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_002" = "Jag förstår, ers nåd. Det är den där spåkvinnan som har påverkat dig. Du borde ha hållit dig borta från henne!";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_003" = "Eftersom religionen betyder så lite för dig ska vi förstöra alla platser för tillbedjan! ";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_004" = "Ers nåd, det är hemskt! Arga munkar förstör olika byggnader i staden! Det var omöjligt att fånga dem, så de flydde! Det här kanske lära dig att inte konsultera spådamer. Titta vad det har lett till.";
"T_GAME_QUEST_FORTUNE_TELLER_CHURCH_NEXT_REFUSE_005" = "Som din rådgivare kommer aldrig att låta dig träffa en spåkvinna igen! Nu fortsätter vi med vårt jobb. Befolkningen är på vansinnigt dåligt humör nu.";
"T_GAME_QUEST_FORTUNE_TELLER_DESC" = "Ers nåd, några resenärer kom till staden i eftermiddags. Bland dem finns en spåkvinna. Hon skickar en inbjudan till dig och säger att hon kan spå din framtid.";
"T_GAME_QUEST_FORTUNE_TELLER_TITLE" = "Spåkvinnan";
"T_GAME_QUEST_FRESH_FISH_ANSWER_001" = "Ni kan väl sluta äta den? ";
"T_GAME_QUEST_FRESH_FISH_ANSWER_002" = "Undersök saken.";
"T_GAME_QUEST_FRESH_FISH_ANSWER_003" = "Riv fiskarstugorna.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_A" = "Det är hemskt! Invånarna fortsatte äta fisk i brist på annat, och sjukdomen spred sig!";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_001_B" = "Sjukdomen är under kontroll, sir. Vi kom undan lindrigt.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_001" = "De här kvalitetskontrollerna är väldigt dyra, men det är ändå bättre än att hantera en epidemi.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_002_002" = "Alla fiskarstugor har kontrollerats och fisken är ätlig igen! Du gjorde rätt som investerade i det här beslutet. Vi undvek allvarliga problem.";
"T_GAME_QUEST_FRESH_FISH_CONSEQUENCE_003" = "Rivandet av fiskarstugorna har gjort det möjligt för oss att bli av med eventuell förorening av fisken. Men det är synd att förstöra så vackra byggnader.";
"T_GAME_QUEST_FRESH_FISH_DESC" = "Guvernör, jag vill inte vara krånglig, men jag måste erkänna att fisken... är inte vad den var. Jag vet inte om det är på grund av floden eller något annat, men den är motbjudande! Någon kommer att bli sjuk om du inte tar hand om problemet.";
"T_GAME_QUEST_FRESH_FISH_TITLE" = "Färsk fisk!";
"T_GAME_QUEST_GENERIC_COMMUNITY_NAME" = "Uppnå hög nöjdhet med gemenskap.";
"T_GAME_QUEST_GETREWARD" = "Få en belöning!";
"T_GAME_QUEST_GIANT_RABBIT_DESC" = "Sir, jag vet inte hur jag ska uttrycka det... Ta ett djupt andetag. Är du redo? Jo... Flera bybor har sagt att de såg en gigantisk kanin.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_001" = "Jaha, och?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_001_ANSWER_002" = "En jättekanin!?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002" = "Men sir! Det är förfärligt läskigt! Tänk om han hoppade runt i slottet och välte våra hus!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_001" = "De få hus vi har...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_002_ANSWER_002" = "Låt oss agera snabbt!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003" = "Det här är en mer logisk reaktion från dig, sir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_001" = "Vi bygger en jaktstuga.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_003_ANSWER_002" = "Skicka ett brev till palatset och låt dem skicka ett sändebud till oss.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004" = "Trots att vi organiserade oss för kaninjakt lyckades vi inte få tag i jättekaninen. Men nu har vi ett stort lager...";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_001" = "Några ledtrådar?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_004_ANSWER_002" = "Jag har gjort min plikt, och nu ska jag ta en tupplur.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_A" = "Sändebudet har anlänt, sir.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_001" = "Jag kräver hjälp av den kungliga armén.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_ANSWER_002" = "Följ med sändebudet för att se bevisen.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_005_B" = "Vad är det jag hör? En jättekanin som går runt i landet? Har du varit i solen lite för länge?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_A" = "Jag förstår. Spår av jättekaniner... Det är en historia man berättar för lättlurade barn. "Den stora kaninen kommer och drar ut dina öron när du sover." ";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "Och vad mer? Jag har annat att göra.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Gå till häxan.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Vi kan gå till häxan och fråga henne om råd. Hon kanske vet något om den där ökända jättekaninen.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Jag har väntat på dig. Kråkorna förutspådde din ankomst. De förde massor av väsen. Men de låter mindre än den där kaninen när den hoppar.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Be.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Använd magi.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Gör ingenting.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Så det är sant!?";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Visst är det sant! Det tog dig lång tid att komma hit. Lyckligtvis finns det fortfarande tid. Du har flera alternativ att överväga.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Jag ser att du inte bryr dig om dina invånare alls, sir... Det här kommer att få konsekvenser för dig förr eller senare.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Okej, vi bygger två jaktstugor och skaffar lite kött. Vem vet – med lite tur kanske vi hittar jättekaninens håla.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Det här är mitt område. Jag ska göra en liten trolldryck till dig, men du måste ge mig vissa ingredienser. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Allt bra? Tänker du ge mig ingredienserna?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Tack så mycket, herre. Attans! Nu har jag glömt resten av ingredienserna.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Vi har inte hela dagen, sir. Jag har en trolldryck att laga. Du kan väl ge mig ingredienserna nu?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Tack så mycket, herre. Ta trolldrycken. Häll lite i byns brunn och vänta. Jättekaninen kommer att ge sig av självmant när den känner lukten.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Sir... Vi måste bygga offentliga bad och tillsätta massor av eteriska oljor för att bli av med lukten från stadsborna... Den är helt fruktansvärd.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Utmärkt! Staden kan äntligen andas igen!\nKaninen försvann spårlöst, som om vi bara hade inbillat oss den. Låt oss fortsätta med vår vardag tills vidare, herre.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Kaninen försvann av sig själv till sist. Under ett av dess sista hopp grävde den upp en kista som hade gömts av banditer för länge sedan. Kistan innehöll 2 000 guldmynt, och kungen anser oss värdiga att få prestige!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Så... det krävdes att det dök upp en jättekanin för att du äntligen skulle överväga att bygga en kyrka?";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Vi skyndar oss att bygga kyrkan och samla ihop invånarna runt för att be.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Allt som återstår är att vänta på att det gudomliga ska göra sitt jobb.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Kaninen försvann spårlöst, som om vi bara hade inbillat oss den. Låt oss fortsätta med vår vardag tills vidare, herre.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Jösses. Jag hade valt trolldrycken, men det är du som bestämmer! Lycka till, sir, med olyckorna som kommer.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Jättekaninen";
"T_GAME_QUEST_INN_STARTED" = "Sir, det kommer att krävas fler bostäder. Varför inte bygga ett värdshus? Då kan vi tillgodose festivalbesökarnas behov.";
"T_GAME_QUEST_INN_SUCCESS" = "Det var bra gjort! Nu tar vi lite tid att tänka på resten av förberedelserna.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Det är för riskabelt.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Varför inte.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Skojaren.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "De är överförtjusta vid kungens hov! De fick precis vad de sökte! Prestigen är vår! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "Stadskvinnan med gåtorna.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Tyvärr var gåtorna för... komplicerade för dem. Kungens hov hade föredragit något mindre intellektuellt. Vi får ingen prestige den här gången.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "Den akrobatiska stadsbon.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "Kungens hov är fascinerade över den begåvade akrobaten! Kungen kommer att skicka oss lite prestige som belöning.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Du har rätt. Vem vet vad som kan hända med oss om kungen inte är nöjd med våra kandidater?";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Sir, vi har fått ett meddelande från huvudstaden. Kungen är besviken över att ingen från vår stad har kommit för att erbjuda sina tjänster. Men lyckligtvis kommer han inte att fördöma oss för en sådan småsak. Kungen är mycket barmhärtig!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Jag har hittat tre potentiella kandidater. Vilken ska vi skicka?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Herre, kungen vill ha en narr som underhållning. Ska vi skicka några potentiella kandidater som kan bli den nya hovnarren?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Hovnarren";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Laga taket.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Vi måste laga det så fort som möjligt!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Inte nu.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Vi har andra prioriteringar för tillfället. Lavendelfestivalen börjar snart och förberedelserna är inte klara än.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "På tal om det borde vi göra klart förberedelserna.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Det var bättre! Det här ser ut att bli en lukrativ tillställning!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Ers nåd, jag hörde att lavendelhandlarna verkligen gillade vår katedral. De är tveksamma till att gå på festivalen!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "Lavendelfestivalen gick helt utan problem... Men vi hade inte så många besökare som vi brukar ha. Den här händelsen gav oss ingen prestige.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Det låter bra!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "Vi skyndar oss att producera varorna till drottningen.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Det enda vi behöver göra nu är att genomföra bytet.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Det är ett nöje att göra affärer med dig.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Ers nåd! Jag har dåliga nyheter! Den välkända symbolen för vår kultur började brinna under natten! Den stora katedralen har inget tak längre!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Experterna säger att vi inte längre har tillräckligt med ädelträ på vår mark för att laga det. Men drottning Frygith råkar ha de nödvändiga resurserna. Ska vi be henne om hjälp?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Be om hjälp.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Du skyndar dig att skicka en budbärare till drottningen.\n\n"Hjälp mig, drottning Frygith! Får jag låna ädelträ som växer på din mark? Min katedral håller på att rasa."";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Hej, raring! Du är precis i tid, eftersom jag behöver fylla på med saft. Är du intresserad av ett vänskapligt utbyte? Krukor med saft mot veden du behöver.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Ers nåd, det här erbjudandet är inte till vår fördel...";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Du väger affärens fördelar och nackdelar mot varandra. Drottningen kanske blir lösningen på alla dina bekymmer... Om det inte finns något annat sätt?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Tänk på saken.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Den här förfrågan kan skada vårt rykte. Vi gör på annat sätt. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Din rådgivare kan ha en poäng. Att be drottning Frygith om hjälp skulle göra dig beroende av hennes välvilja. Om det någonsin blir problem så riskerar du att förlora mycket.\n\nVarför inte använda sten? Du har gott om det i gruvorna.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Det var ett bra beslut, ers nåd! Vi är fria och oberoende.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "Lavendelfestivalen är en succé. De senaste berättelserna om restaureringen av katedralen har väckt stor glädje och det har varit stor nytta för oss!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Jag har aldrig gillat lavendel.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Inga problem! Vi reparerar den.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Det är skandal.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Ers nåd, det där låter som utpressning! Vi kan använda sten istället, så behöver vi inte ha med den där drottningen att göra!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Okej, det ska jag inte glömma, kära du.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Kungen av trä";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Jag tar hand om det.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Om de inte är nöjda så behöver de inte komma hit längre.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "Det är sant att köpmännen skulle tjäna på att ha en plats som är tillägnad dem, utöver marknaden. Ett handelsgille vore en perfekt byggnad, ers nåd.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Underbart, ers nåd! Tack för att du går med på det här. Vi är evigt tacksamma!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "En modern guvernör som du borde ha gått med på köpmännens förfrågan...";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Herre, jag är köpmännens representant. För att visa vår besvikelse kommer vi inte att besöka din stad på ett tag! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Ers nåd, handelsförbundet kräver att du bygger byggnader som är till nytta för dem.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Ont om utrymme";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "När du just har vaknat kommer din rådgivare med hemska nyheter till dig! Staden har invaderats av möss! De är visserligen mindre farliga än råttor, men ändå. Vi måste göra något!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Ers nåd, vi har grundat Akademin för musjagande katter, men... vi måste fortfarande ta hand om dem och mata dem. Vi borde leverera tillräckligt med fisk till akademin.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Nu har vi tillräckligt med fisk för att täcka träningen. Vissa rekryter har redan fångat ordentligt med möss, ers nåd.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Ers nåd, vi borde belöna de bästa katterna med kattmynta. För att minska deras stress.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "Vi har sett en märkbar ökning av effektiviteten hos musfångarna, ers nåd. Lärarna lyckas bra med att träna katterna. Det är bara några få möss kvar.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Mössen är inte längre ett problem, ers nåd. Grattis till de goda beslut som ledde till det här resultatet!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Gör en plan.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Du bestämmer dig ändå för att äta frukost. Medan du äter din rostade smörgås ser du en mus i hörnet! De är till och med i slottet! Och plötsligt ser du din trogna katt Chouquette göra ett hopp. Han äter upp musen på ett ögonblick. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Du får en idé. Du instruerar din rådgivare att fånga in så många katter som möjligt och träna dem att jaga möss. Även huskatterna. Du vill bli av med alla möss.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Somna om.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "När du vaknar är det så mycket möss överallt att det är svårt för folk att gå. Alla dina invånare går långsammare!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Mössen försvann äntligen av sig själva efter en lång tid. Att gömma sig från sitt ansvar genom att sova är inte alltid en lösning.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Katt och mus";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "På höger sida ser du aktuella aktiva påverkningar.\nVissa påverkningar är bara aktiva tillfälligt och kan förändras under ett scenarios lopp.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Herre,\nMed all respekt måste jag säga att du inte verkar ha märkt hur olyckliga byborna är. Det här kan inte fortsätta längre.\nDe varor vi producerar är dessutom inte korrekt bearbetade.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Nu vet du vilka påverkningar som har effekt på staden. Du kanske har märkt att det finns banditer i området och att den allmänna lyckan i staden minskar på grund av banditerna.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Gå till pausmenyn för att se aktuella påverkningar på den här kartan.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Skulle du kunna vara vänlig och besöka sågverket?\nVi måste stoppa produktionen! Vi har redan för lite trä och för mycket plankor!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Om du vill ha mer information om en byggnad så behöver du bara besöka den!\n\nKontextmenyn visar användbar information om byggnaden, dess arbetare och anslutna produktionskedjor. När du är i den här menyn så är spelet pausat.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Sågverket behöver fler skogshuggare för att producera plankor effektivare.\n\nVi borde pausa sågverket tills vi har byggt fler skogshuggarstugor och samlat på oss mer byggnadsresurser.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Du borde förhindra att resurser blockerar lagret, furste.\nNär du behöver plats i lagret kan du använda funktionen "förstör resurser" i statistikmenyn.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Gå till Lager-menyn.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Du borde förhindra att resurser blockerar lagret, furste.\nNär du behöver plats i lagret kan du använda funktionen för att förstöra resurser i Lager-fliken i spelmenyn.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Förstör plankor tills antalet i lager är under 100.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Förstör lite plankor för att göra plats i lagret.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Du tar inte mina hot på allvar, guvernör.\n\nFrån och med nu tar jag i med hårdhandskarna!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Vilken trevlig stad du har byggt.\n\nSynd att den är på mitt område! Ge mig juveler och kläder! Och gör det snabbt, annars går det illa för din stad...";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Det är imponerande vad ett litet hot kan göra. Jag trodde aldrig att du faktiskt skulle skicka över de där varorna.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Betala banditerna.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Mina pojkar är ganska uttråkade för tillfället. Jag ska skicka dem på en liten utflykt...\n\n...TILL DIG!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Som du kan se så tar jag vad jag vill!";
"T_GAME_QUEST_MIL_TUT_09_START" = "God morgon, furste.\n\nJag kommer till dig på kungens befallning. Han skickade mig för att lära dig om krigandets konst.\n\nDina små banditproblem borde försvinna på nolltid, furste.";
"T_GAME_QUEST_MIL_TUT_10_START" = "Kasernen är grunden för din militära verksamhet i området och gör det möjligt att bygga vakttorn och skicka förråd till dem. Soldater kämpar bara bra när de har gott om förråd.\nDu bör placera ut torn så att de täcker så mycket av staden som möjligt.\n\nBygg en kasern och ett vakttorn, herre.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Du har verkligen fått hjälp av en riddare...\nJag börjar redan darra av skräck.\nVi får väl se vad din militär kan göra mot mina pojkar...";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Banditerna tänder eld på våra byggnader! Var är den där brandmannen när man behöver honom?\n\nNär du vill veta var en stads befinner sig för tillfället kan du välja alternativet "hitta stadsbo" i byggnadernas kontextmeny.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "Här kan du se vad arbetarna gör för tillfället.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "Tillverka brygd och korv";
"T_GAME_QUEST_MIL_TUT_14_START" = "Våra soldater behöver brygd för att ge sig själva flytande mod, furste.\n\nFör att producera brygd måste du ge order om att bygga ett klosterbryggeri och en kölna.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Våra soldater behöver brygd, furste.\nFör att skaffa brygd måste du ge order om att bygga ett klosterbryggeri anlägga humlefält, herre.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "Klosterbryggeriet behöver flera resurser från andra byggnader.\nFrån kölnan får bryggeriet torkad humle. En gård och en brunn levererar vete och vatten.\n\nDå kan munkarna på klostret börja tillverka brygd, furste.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "I klostret kan du beordra munkarna att antingen samla humle från fälten eller ägna sig åt att brygga.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Bygg ett kloster och en kölna.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Bygg ett kloster och anlägg lite humlefält.";
"T_GAME_QUEST_MIL_TUT_15_START" = "För att tillverka korv behöver du en grisfarm och en slaktarbod, herre.\n\nVåra soldater älskar korvarnas kryddiga smak. De kryddor vi behöver till korvarna kan bonden skörda från örtträdgården.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Slaktarboden kan producera vanligt kött utöver de korvar som dina soldater älskar.\nDet kan vara ett bra alternativ till att vara beroende av viltjakt i skogarna.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Bygg en grisfarm och en slaktarbod.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Jag tror att du borde träna upp ditt försvar lite mer!\nVi ses nästa gång... och tack för resurserna!";
"T_GAME_QUEST_MIL_TUT_16_START" = "Brygd och korv!\n\nMina karlar älskar de här delikatesserna. Jag tycker att du ska dela med dig av de här utsökta varorna till mig.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Den här gången hade du tur, guvernör. Nästa gång kommer fler av mina karlar.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Försvara din stad";
"T_GAME_QUEST_MIL_TUT_17_START" = "Ytterligare förbättringar måste göras i staden. Större delen av byn är inte särskilt väl försvarad. Vi måste täcka mer av byn med vakttorn.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Nu skyddas det mesta av byn av våra soldater. De där banditerna kan inte stjäla från oss så lätt nu, herre.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Täck minst 50 % av byn med vakttorn";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Om du vill ha mer information om militären så kan du alltid gå till militärfliken på statistikskärmen.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Våra soldater behöver vapen och rustningar!\nVapen ökar våra soldaters attackstyrka och rustningar ökar deras försvarsförmåga.\n\nSå vi måste bygga en vapensmedja i staden. För att tillverka rustning behöver vi också ett garveri för att få tillgång till läder.\nDjurhudarna levereras av en jägare eller en slaktare.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Bygg ett garveri och en vapensmedja.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Herre,\nDet är dags att öka storleken på din armé. Då kan du skicka ut en grupp för att förstöra banditlägret.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Utöka din armé";
"T_GAME_QUEST_MIL_TUT_21_START" = "Det är dags, guvernör!\n\nNu slår vi till mot den där otäcka bandithövdingen. Deras läger är gömt i skogen.\nDu behöver bara välja banditlägret och beordra en rimlig grupp soldater att attackera.\n\n\nGod jaktlycka!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Förstör banditlägret";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Trevligt att träffa dig, furste.\nJag blev just bestulen av banditer för tredje gången den här veckan. Vi borde verkligen göra något åt de där uslingarna!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "En stor seger, furste.\nVi visade de där banditerna var skåpet ska stå! Regionen är säker igen, och kungen kommer att bli riktigt nöjd. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Slutför grundträningen och besegra banditerna.";
"T_GAME_QUEST_NEW" = "Nytt uppdrag!";
"T_GAME_QUEST_NEW2" = "Nytt uppdrag:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Det är det ingen som har tid för.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Du har rätt.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Nåväl, herre. Då gör vi ingenting åt det hemska brödet. Jag kan redan höra klagomålen på den fruktansvärda maten. Men hur som helst... Som du befaller, ers nåd.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Sir, brödet är jättegott nu! Priset har gått upp också.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = ""Det är vetet som är problemet. Du måste ta itu med från grunden. Säg till mjölnaren att använda renare vatten. Och jästen vara av god kvalitet."\n\nDin rådgivare förmedlar din visdom till bagaren och lovar dig att brödets kvalitet kommer att förbättras.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Sir, vi måste göra något. Brödet är inte lika bra som det var. Många har klagat på kvaliteten. Vi borde ändra receptet.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Ett nytt recept";
"T_GAME_QUEST_NOQUEST" = "Det finns inga tillgängliga uppdrag.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Vi skyndar oss att producera sköldar och vapen. Om de här människorna är farliga så är det säkrast att vara förberedd.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Guvernör, vi har avslutat förberedelserna för stadens försvar.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Dina soldater rapporterar trupprörelser i norr. Där ligger den största öknen i kungariket.\n\nMen du vet att ingen är dum nog att försöka attackera gränsen från det hållet. Du bestämmer dig för att ignorera hotet. Det får gå som det går.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Några dagar senare rapporterar dina soldater att de sett en grupp människor komma direkt från öknen in norr. De är framme i staden om några timmar.\n\nDe kanske bara är resenärer, men vem vet – de kanske är farliga banditer som kommer för att invadera din by!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Förbered stadens försvar.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Förbered ett varmt välkomnande.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Den norra öknen";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "En grupp på tio personer närmar sig din stad. Dina soldater är beredda och väntar på dina order.\n\nDu låter dem komma närmare. Ledaren för gruppen går ensam mot stadens portar. "God morgon, min gode herre. Vi har just korsat den norra öknen. Kan du erbjuda oss gästfrihet för en natt?"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Så kom till vår vackra stad. Ni kan bo på värdshuset. Där har vi tillräckligt med plats.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Medan din rådgivare eskorterar dig hem är du fortfarande på din vakt. Varför riskerade de att korsa öknen när de kunde ha seglat längs floden? Varför välja en farlig väg om de inte behöver gömma sig?\n\nDina spioner kanske skulle kunna ta reda på mer om dem. Eller så kan du bara gå och lägga dig.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Gå och lägg dig.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Skicka en spion.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Din spion var uppe hela natten och lyckades avlyssna lite samtal på värdshuset – resenärerna är på flykt. De ska ha begått en del brott i sitt land på andra sidan öknen. Armén jagar dem, och de förbereder redan sin fortsatta flyktväg.\n\nVad är den bästa lösningen?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Lås in resenärerna.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Vi fick precis ett meddelande från kungen. Ett gäng farliga brottslingar har rymt från grannlandets fängelse. De är ett tiotal, och de hade stulit ett dyrbart föremål. Tror du att det kan ha varit resenärerna som var här för några dagar sedan?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Skicka ett meddelande till kungen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Vi håller det för oss själva.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Jag ska skicka ett meddelande till kungen för att meddela att de har passerat genom vår by. De kanske kommer att kunna hitta dem.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Ers nåd! Den kungliga armén har lyckats få tag på de där farliga typerna. De hittade den stulna skatten.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Tack för din hjälp, guvernör. Det där gänget stal en av mina dyrbara juveler. De tänkte sälja den på svarta marknaden. Du gjorde rätt som informerade mig om att de kom din stad.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Nåväl, ers nåd. Om någon frågar oss om saken så säger vi att vi inte vet något.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Det var ett tag sedan det hände något spektakulärt i staden. Men idag har du en känsla av att något kommer att förändras.\n\nOch du hade rätt! Din rådgivare kommer för att ge dig ett brev från resenärerna som är efterlysta av den kungliga armén. Meddelandet lyder:\n\n"Tack för att du inte anmälde oss, guvernör. Du förstår, vi blev offer för en komplott, och hela vår familj var i stor fara. Genom att du höll det hemligt att vi kom till din by hade vi tid att hitta bevis på vår oskuld. Utan dig hade det varit omöjligt. Ta därför emot den här utmärkelsen som ett tecken på vår tacksamhet. Du är en bra guvernör."";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Jag har släppt resenärerna fria, sir. Som du beordrade. Jag hoppas att det inte slutar illa för oss.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Resenärerna tackar dig för din vänlighet och lovar att de ska ge dig en belöning som ett tecken på deras tacksamhet när de har lyckats bevisa sin oskuld.\n\nDu hoppas innerligt att du har fattat rätt beslut och att resenärer inte har lurat dig.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Det har gått flera månader sedan du senast hörde från resenärerna. Ibland tänker du på dem. Du fick inga problem med kungen, men du fick inte din så kallade belöning heller.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Plötsligt, en ljus morgon, kommer din rådgivare till dig med ett paket med ett brev. Brevet innehåller ett meddelande från de mystiska resenärerna. De uttrycker sin tacksamhet. I paketet finns den utlovade belöningen. Både prestige och guld.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Du är glad över att du hade rätt och att du inte blev lurad.\n\nDin rådgivare rapporterar redan att du har blivit en hjälte för de här resenärerna och att de hyllar dig. Det är fantastiskt att vara guvernör just nu.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Herre, resenärerna lämnade värdshuset tidigt på morgonen. De verkar ha haft bråttom.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Resenärerna väntar på ditt svar. Vissa ser aggressiva ut, andra är rädda.\n\n"Jag kan inte erbjuda er gästfrihet, resenärer. Vi har inte tillräckligt med plats för er i kväll."\n\n"LÖGNER!" ropar en av resenärerna plötsligt och rusar mot dig med sitt svärd.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Skydda guvernören!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Skynda dig, herre! Fort! Vi tar oss härifrån!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Du lyckas gömma dig med din rådgivare som verkar helt panikslagen: "Ers nåd, vad ska vi göra!? De där onda resenärerna ödelägger vår by, och det finns inget vi kan göra! Vi borde ha gjort i ordning vårt försvar istället för bullar!"\n\nDet enda du kan göra att vänta.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Tidigt på morgonen vågar du dig ut ur ditt gömställe. Byn är inte skadad. Det verkar som att de där resenärerna helt enkelt slog ner vakterna och tog lite proviant till resten av resan.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Lyckligtvis hade vi räknat med det här. Med de vapen och sköldar vi producerat kan vi slå tillbaka dem. Det är jag säker på.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Ers nåd, vi har lyckats fånga in alla resenärer. Vi satte dem i fängelset. Det är dags för dig att fatta ett beslut.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "De här resenärerna blir konstigare. Nu när de är inlåsta känner du dig lite säkrare. Men det är något som bekymrar dig.\n\nVad borde du göra?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Fråga ut dem.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Meddela kungen.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Okej, ers nåd. Jag ska ställa lite frågor till dem för att få klarhet i den här historien.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Din rådgivare kommer tillbaka med information om resenärerna.\n\nDe flydde sitt land för att de hade blivit felaktigt anklagade. Beviset för deras oskuld finns längre söderut. I en av de omgivande städerna.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Släpp dem.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Jag skall meddela kungen så att den kungliga armén kan komma och hämta de här farliga brottslingarna!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Den kungliga armén kommer till slut. Du lämnar över resenärerna. Kungen skickar dig en belöning för att du kommit med den information som behövdes för att fånga de här farliga typerna.\n\nDin by återhämtar sig sakta medan du lugnt återupptar dina aktiviteter som guvernör.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Din spion gjorde ett misstag och blev upptäckt av resenärerna. De håller honom som gisslan och kräver en lösensumma om du vill få tillbaka honom levande.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Det kommer att kosta mycket pengar, men vår spion kommer åtminstone att komma tillbaka i ett stycke.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Tack för att du betalade lösensumman för mig, ers nåd! Jag var rädd att jag skulle dö. Det är farligt att vara spion.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Det är en bra idé. Vi borde laga mat åt dem när de kommer hit. Bröd och fisk blir bra.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Perfekt, nu behöver vi bara vänta på dem.";
"T_GAME_QUEST_PLACE_STARTED" = "Nu är det dags att bygga en lämplig plats för ett evenemang av den här storleken!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Ser man på! Det är helt otroligt! Och inget av det här hade lyckats om inte vakterna varit så ambitiösa. Du fick en underbar idé när du drog nytta av den här möjligheten! Festivalen ser ut att bli en succé.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Plantera fler blommor.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Det behövs inte.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Så vackert! Åh, blommor är verkligen fina, och doften gör mig så lycklig.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Du är hemsk. Vår stad hade blivit mycket vackrare med blommor!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Våren är tillbaka, herre. Byn skulle bli fin av lite extra blommor.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Vackra kronblad";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "Sågverket har brunnit ner, furste. Skulle du kunna se till att det byggs upp igen? Vi behöver byggnaden för att kunna producera plankor!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Bygg upp sågverket igen.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Ge ingenting till någon.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Omfördela intäkterna till stadsborna.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Investera pengar i gruvan.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Sir, vi har gott om pengar, och en omfördelning av en del av pengarna vore fördelaktigt för staden.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Byborna hörde om ditt beslut. De är inte glada. Försök visa folket lite mer omsorg, sir.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "Stadsbornas produktivitet påverkas inte längre av beslutet du fattade om omfördelningen av pengar. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Du gjorde stadsborna väldigt glada! De är överlyckliga!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Utmärkt initiativ, sir. Låt oss börja bygga gruvor och utvinna resurser.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Att investera pengarna vi hade i nya gruvor är förmodligen det bästa beslutet vi någonsin fattat. Vi kommer att kunna utvecklas bättre med de här resurserna.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Du är väldigt generös, ers nåd. De här pengarna kommer att ge dem möjlighet att förbättra sin vardag.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Omfördelning av intäkter";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Vi hade tur, ers nåd. Grödorna har inte påverkats. Vildsvinen har försvunnit och vi behöver inte oroa oss för dem längre.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Vildsvinen har förstört våra skördar, ers nåd! De är på väg mot gården. Det är en massaker.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "Befolkningen är förtvivlad över förlusten, och deras lycka och produktivitet påverkas.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Ers nåd, våra grödor börjar återhämta sig från skadorna som vildsvinen orsakade för ett tag sedan. Grödorna har börjat växa igen och folk har börjat glömma händelsen.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Befolkningen blir försummad till följd av ditt beslut! Vi får hoppas att grödorna inte skadas av vildsvinen.";
"T_GAME_QUEST_REWARD" = "Belöning:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Jag hälsar dig välkommen, härskare!\n\nTa bara en titt på den här kustlinjen! Jag förväntar mig att din stad blir värdig den här vackra utsikten!\nTa väl hand om dina stadsbor, och glöm inte att ge tribut till kungen så att du kan fortsätta att tjäna mig!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Lån från kungens kassavalv";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Guvernör,\nOm du har ont om pengar så kan kungen ge dig ett litet lån för att komma på rätt köl igen.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Jag hälsar dig välkommen till vår ödmjuka by, guvernör!\nRegionen delas av en stenig ås. Det finns malmfyndigheter i den sydvästra sidan av åsen, herre.\n\nJag ser fram emot att samarbeta.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Välkommen, guvernör!\n\nJag är drottning Frygith, och jag härskar över det här kungariket. Jag har bett om din hjälp för att göra den här byn stor. Marken är rik på resurser, så det borde vara lätt att åstadkomma. Gör mig inte besviken.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Herre, titta bara på den här regionens vidder. Platt mark så långt ögonen kan nå! Vi kommer nog att kunna bygga en stor stad här inom överskådlig framtid. Tror du inte det?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Var hälsad, guvernör.\nVid den här mäktiga flodens strand har vi goda förutsättningar att blomstra. Det finns vidsträckta fiskevatten, och gruvorna är fulla av malm. Här ska vi etablera en blomstrande stad i kungens namn.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Underbart, guvernör.\nDen här dalen har en av de viktigaste vägarna genom bergen. Staden är ett idealiskt läge för att erbjuda en trivsam vistelse för köpmän som är på genomresa. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Herre, nedanför de här vattenfallen finns det fiskevatten i överflöd. Dessutom gör de rikliga malmfyndigheterna att den här regionen är idealisk för att grundlägga vår stad.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Välkommen till Isfästet, herre.\nDet är inte lätt för stadsborna att klättra upp till slottet, men utsikten över slätterna är värd besväret. Dina marker ser oändliga ut härifrån.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "God morgon, herre.\n\nSe över dina egendomars böljande kullarna. Är inte utsikten fantastisk? Det här är en vacker plats att grundlägga en stad på, herre.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "God morgon, herre.\n\nVälkommen till vår lilla by. Det sägs att Gropen skapades av en fallande stjärna. Vi får hoppas att den ger oss tur. Kungen har redan skrivit att han har lite uppgifter till oss snart.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Kungens tribut.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Festival för stadsborna.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Donation till de fattiga.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Bryggarfestival i staden.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Sälj grisar på marknaden.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Handla på djurmarknaden.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Handla med djur på marknaden.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Ransoner till armén.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Utrustning till kungens soldater.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Slå tillbaka banditernas attacker.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Förstör banditläger.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Jag hälsar dig välkommen, härskare! Ta bara en titt på den här kustlinjen! Jag förväntar mig att din stad är värdig den här vackra utsikten!\nTa väl hand om dina stadsbor och glöm inte att ge tribut till kungen, så att du kan fortsätta att tjäna mig!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Vilken fantastisk plats för fiske. Håller du inte med, furste? Vi kommer definitivt inte att sakna mat här!\nVi vill väldigt gärna att du ordnar en festival då och då, om du har råd efter du har betalat tribut till kungen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Åh, älskling, tack för att du valde den här platsen! Sjön är verkligen vacker!\nStadsborna kommer säkert att trivas här om du tar väl hand om dem!\nOch glöm inte att muta kungen så att vi kan stanna här för alltid!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Herre, det var ett klokt beslut att flytta till den här floddalen!\nStadsborna kommer säkert att bli nöjda när du hjälper de fattiga och behövande!\nMen trots all din generositet föreslår jag att du inte försummar din plikt mot kungen!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Välkommen! Mina män är stolta över att stödja er i att bygga ert maktcentrum på den här viktiga punkten i vårt land!\nI år kommer vi att fira!\nLänge leve kungen, och även du!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Kära guvernör, jag har redan hört mycket om dig! Det var därför jag valde dig – grunda en blomstrande stad nedanför sluttningen till mitt slott!\nDet är bäst att du börjar direkt. Farväl!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Furste, vi har fått i uppdrag att etablera en stad nära den här uttorkade flodbädden. Kungen kommer att belöna oss rikligt om vi utför vår plikt väl.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Herre, platån som ditt slott ligger på är en utmärkt plats för en trevlig liten stad. Kungen har också skickat dig ett antal uppgifter måste slutföras.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "En skärgård har upptäckts precis utanför kusten. Jag befaller dig att kolonisera dessa öar i mitt namn!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Herre, titta på det här vackra skogsområdet. Att bygga en stad här kommer att bli ett hårt arbete, men det finns åtminstone gott om rådjur och ved.\n\nDet borde göra det lättare att slutföra de uppgifter som vi fått av kungen.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Furste, att betala vår tribut till kungen kommer att bli svårt på grund av den hårda vintern. Vi borde sätta igång med arbetet direkt...";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Vilken underbar dal. Det finns tillräckligt med resurser för att betala tribut till kungen. Men var försiktig. Brist på utrymme för byggnader gör det viktigt att planera ordentligt.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Det här är en riktigt vacker ö! Jag är så glad att vi kom hit. Vi borde börja planera vår by direkt!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Vi har perfekt utsikt över omgivningen härifrån! Tyvärr är vintersäsongen mycket längre på den här höjden, och det har allvarlig inverkan på växterna som odlas.\n\nDet vore klokt att bygga upp ett lager på sommaren.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Var hälsad! Vi har väntat på dig! Mina män har redan utforskat regionen och har hittat många lovande malmådror.\n\nDu borde börja bryta malmen direkt innan någon annan gör det!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Herre, vad bra att du är här.\n\nDen tidigare guvernören flydde. Medan han sprang härifrån skrek han att det här området har en förbannelse över sig.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Din föregångare hade inte helt fel. Jordbruket är kärvt, här växer det knappt någonting. Det är till och med ont om vatten. Men jag är säker på att du hittar en lösning.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Dina stadsbor känner sig lite missnöjda med sina andliga liv, herre. Skulle det vara möjligt att bygga en kyrka i staden?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Uppnå hög religiös lycka.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Förväntar du dig verkligen att en man i min ställning ska gå på de här grusvägarna, guvernör? Bygg vägar som anstår en riktig stad!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Bygg kullerstensvägar i din stad.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Bygg grusvägar i din stad.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Vissa har gjort ett riktigt dåligt jobb här, herre. Alla byggnader är i stort behov av reparation.\n\nVi måste anlita en snickare för att reparera alla byggnader innan de går sönder helt.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Bygg en snickarverkstad och uppnå hög tillfredsställelse med byggnadernas skick.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Guvernör! Varför är din stad fortfarande så liten? Vi hamnar efter ärkehertigen!\n\nVi förlorar vadet om du inte lyckas öka stadens befolkning snart!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Öka din bys befolkning.";
"T_GAME_QUEST_SCEN10_14_DESC" = "De nya familjerna som har flyttat till staden hade en lång och utmattande resa, och de är väldigt hungriga. Låt oss ordna en bankett för dem och fira att vadet officiellt har börjat, herre!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Producera tillräckligt med mat till din by.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Vi borde börja handla med de resande köpmännen. Att ha köpmän i staden lockar besökare och förbättrar vår stads rykte, herre!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Tjäna mycket pengar genom att handla med köpmannen.";
"T_GAME_QUEST_SCEN10_16_DESC" = "Mängden skatt du samlar in är ynklig! Du borde kanske bygga ett kassavalv för att öka dina skatteintäkter.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Bygg ett kassavalv och samla in tillräckligt med skatt.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Smycken! Jag behöver smycken! Men jag undrar hur du ska kunna ordna fram smycken om du inte ens har byggt en guldsmedja.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Bygg en guldsmedja och börja med tillverkning av smycken.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Utmärkt, herre. Nu kan du skicka mig en vagnslast med smycken.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Leverera smycken till köpmannen.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Herre, vår första prioritet är matförsörjning. Vi behöver fiskare och jägare.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Bygg lite fiskarstugor och jaktstugor.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Min gode guvernör, jag kan inte hjälpa dig i dina ansträngningar förrän du har byggt en marknadsplats.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Det behövs en marknadsplats för att utöka din by.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Herre! Har du byggt en verktygssmedja än? Ärkehertigen har redan börjat tillverka verktyg!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Bygg en verktygssmedja och börja tillverka verktyg.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Med allt hårt arbete skulle vi gärna vilja ha en plats där vi kan koppla av, träffa vänner och dricka ett krus druvsaft. Det vore väldigt trevligt med en krog.\n\nNär det passar dig, förstås, herre.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Uppnå hög nöjdhet med krogar.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Har vi tillräckligt med bostäder, herre? Alla nya arbetare som flyttar till staden behöver tak över huvudet, eller hur?";
"T_GAME_QUEST_SCEN10_6_NAME" = "Bygg två stora och fyra vanliga småstadshus.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Bygg fler stora småstadshus.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Bygg fler små småstadshus.";
"T_GAME_QUEST_SCEN10_7_DESC" = "Staden behöver lite extravagant underhållning. Till exempel tornerspel. Se till att du kan tillhandahålla den här typen av underhållning innan det kommer viktiga besökare.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Uppnå hög nöjdhet med underhållning.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Uppnå hög nöjdhet med tornerspelsområdet.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Herre, vi kanske kan försköna den här trista staden genom att bygga lite statyer och dekorationer? Vi borde göra det innan kungen kommer på besök igen.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Försköna din stad med dekorationer.";
"T_GAME_QUEST_SCEN10_9_DESC" = "Goddag, guvernör. Skulle du vara intresserad av lite byteshandel?\n\nJag har ett brådskande behov av en stor mängd kläder för att kunna göra en lukrativ affär med ärkehertigen. Jag skulle betala mycket bra om du kan leverera det jag behöver.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Leverera en last med kläder till köpmannen.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Det här är en total katastrof, guvernör! Ärkehertigen av Canterborough har hunnit före oss och slutfört sin stad innan vi lyckades slutföra vår!\n\nJag räknade med ditt stöd, och nu är jag väldigt besviken. Det kanske bara var en orealistisk dröm att vinna det här vadet. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Utmärkt, min gode guvernör! Vi hann före ärkehertigen när vi byggde och utökade vår stad! Vi vann vadet!\n\nJag är imponerad av din prestation och kommer personligen att se till att du blir kungligt belönad. Jag ger dig också titeln hertig, med alla rättigheter och privilegier som medföljer.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Min lojale tjänare, jag kan ha åtagit mig mer än jag klarar av.\n\nJag har slagit vad med ärkehertigen av Canterborough om att jag kan förvandla mitt rikes mest outvecklade stad till en blomstrande metropol innan han kan göra samma sak med sin mest outvecklade stad.";
"T_GAME_QUEST_SCEN12_01_START" = "Vad trevligt av dig att besöka oss. Jag talar för alla munkar i klostret när jag hälsar dig varmt välkommen.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Välkommen till vårt kloster, furste.\nVisst kan vi hjälpa dig med den perfekta gåvan till kungen. Men vi har lite problem med banditer för tillfället. Du kanske kan hjälpa oss också.";
"T_GAME_QUEST_SCEN12_02_START" = "Vilken lömsk sak att göra!\n\nNågon har stulit vårt trä! Vi kan inte lagra vår brygd utan trä till faten.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Stort tack, herre! Nu kan vi bygga tunnor till vår brygd igen.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Bygg lite skogshuggarstugor.";
"T_GAME_QUEST_SCEN12_04_START" = "Furste, staden måste byggas ut för att vi ska kunna slutföra våra uppgifter. Först måste vi skapa en stabil ekonomi. Och för det behöver vi tillverka verktyg.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Fantastiskt, herre. Nu kan vi utöka staden ytterligare.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Etablera en produktionskedja för verktyg.";
"T_GAME_QUEST_SCEN12_05_START" = "Staden måste förses med mer mat, herre. Vi har en gård, men varken väderkvarn eller bagerier.";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Mycket bra! Byn växer till en riktig stad.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Etablera en stabil matproduktion.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "Nej! De där usla banditerna! De förstörde klostret!";
"T_GAME_QUEST_SCEN12_06_START" = "Herre, klostret har stått på den här kullen i fyra århundraden. Det vore hemskt om byggnaden förstördes av de där otäcka banditerna. De har hotat att förstöra det i flera veckor nu...";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Mycket bra, furste.\nKlostret har överlevt alla de där banditattacker och vi har tagit fram den perfekta brygden!\n\nVilken utmärkt dryck det har blivit! Helt fantastisk.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Skydda klostret.";
"T_GAME_QUEST_SCEN12_07_START" = "Du måste bygga upp klostret igen, annars kommer vi aldrig lyckas slutföra vår uppgift i tid!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Mycket bra, herre! Klostret har byggts upp igen! Vi kan fortsätta med uppgiften – att brygga den perfekta brygden!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Bygg upp klostret igen.";
"T_GAME_QUEST_SCEN12_08_START" = "Vi måste se till att klostret är väl försvarat, furste! Att placera ut ett vakttorn bredvid klostret borde skydda det avsevärt.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Bygg ett vakttorn bredvid klostret.";
"T_GAME_QUEST_SCEN12_09_START" = "Vet du hur mycket soldater gillar korv?\nDu kan bygga en grisfarm och en slaktarbod för att producera lite korv.";
"T_GAME_QUEST_SCEN12_09_START2" = "Herre,\nJag rekommenderar dig att beordra byggandet av en grisfarm och en slaktarbod.\nDå kan vi producera kött till byborna, och de korvar som våra soldater älskar.";
"T_GAME_QUEST_SCEN12_10_START" = "Hmm. Jag tycker att vi borde ge de stackars soldaterna lite svärd och rustningar. Det skulle förbättra deras överlevnadsförmåga i strid avsevärt. För det behöver vi en vapensmedja och ett garveri.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Vi klarade det, furste! Nu kan vi tillverka rustningar till våra soldater.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Bygg en vapensmedja och ett garveri.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Bygg en vapensmedja.";
"T_GAME_QUEST_SCEN12_11_START" = "Nu när vi har en vapensmedja och ett garveri vore det bra att börja tillverka utrustning.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Utmärkt, furste! Soldaterna kommer att prestera mycket bättre i strid nu.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Tillverka utrustning åt soldaterna.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Mycket bra, herre. Nu borde klostret vara skyddat mot fler banditattacker!";
"T_GAME_QUEST_SCEN12_15_START" = "Vi har inte kunnat återskapa de förstörda humlefälten.\n\nSkulle du kunna anlägga några?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Anlägg lite humlefält.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Bygg en humlegård och anlägg lite humlefält.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Haha! Nu är ditt enkla kloster historia! Nu bestämmer jag över det här området!";
"T_GAME_QUEST_SCEN12_16_START" = "Tror du att du kan skydda de där små munkarna? Det tror inte jag. Jag ska krossa ditt lilla kloster.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Argh! Nästa gång får du betala för det där! Det här är inte över...";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Slå tillbaka alla attacker mot klostret!";
"T_GAME_QUEST_SCEN12_17_START" = "Herre, jag och de andra munkarna börjar omedelbart med tillverkningen av landets finaste brygd.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Vi har avslutat bryggandet, furste. Vi har skapat många olika sorters brygder. Nu måste vi välja den bästa av dem och förfina den ytterligare efteråt.";
"T_GAME_QUEST_SCEN12_18_START" = "Vår bryggmästare sade att vi måste uppgradera vår bryggarutrustning för att förfina bryggningen ytterligare. Vi vill ju behaga kungen, eller hur? Det här måste bli den bästa brygden i landet...";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Utmärkt, herre! Nu behöver vi bara lite mer av de finaste ingredienserna.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Uppgradera klostret till nivå 2.";
"T_GAME_QUEST_SCEN12_19_START" = "Herre, brygden är nästan klar, men vissa ingredienser saknas fortfarande. Örter och lite gulddamm vore perfekt för att göra färdigt brygden.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Leverera örter och guldklimpar. ";
"T_GAME_QUEST_SCEN12_20_START" = "Bryggan måste mogna ett tag.\n\nDen bör inte störas av yttre påverkan – mognadsprocessen gör att brygden måste vila.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Det är färdigt, furste. Får jag presentera den perfekta brygden?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "Försvara klostret tills bryggprocessen är klar.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Jag ville tacka dig själv, härskare.\nDet här var verkligen den perfekta födelsedagspresenten till mig. Jag visste inte att du kände till mitt intresse för att brygga.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Skydda klostret och skapa den perfekta brygden till kungen.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Förbered staden för kungens ankomst. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Trodde du att du kunde lura mig? Jag är besviken över att du inte har lyckats administrera en liten stad.\n\nJag administrerar ett helt kungarike, men behöver inte lura någon!";
"T_GAME_QUEST_SCEN13_01_START" = "Jag ska inspektera mina ägodelar under det kommande året.\nDin berömda stad kommer att bli kulmen på min resa!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Jag är väldigt nöjd med dig!\nDu vet verkligen hur man administrerar en stad framgångsrikt, och du kan vara säker på att jag håller dig i mycket hög aktning.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Klara kungens inspektion.";
"T_GAME_QUEST_SCEN13_02_START" = "Var hälsad, härskare! Jag bestämde mig för att besöka din magnifika stad tidigare!\n\nDu har säkert redan väntat på min ankomst.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Låt inte kungen bli misstänksam.";
"T_GAME_QUEST_SCEN13_05_1_START" = "Först och främst bör du få igång produktionen av varor igen!\n\nAnlita skogshuggaren igen och reparera sågverket för att starta produktionen igen.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Mycket bra, herre.\nMen det finns ingen tid för vila!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Anlita en skogshuggare och reparera sågverket.";
"T_GAME_QUEST_SCEN13_05_START" = "Åh, nej! På grund av banditer i skogen har staden förfallit helt.\n\nVi måste börja med återuppbyggandet direkt!";
"T_GAME_QUEST_SCEN13_06_START" = "Marknaden brann ner och måste byggas upp igen!\n\nVi är i akut behov av varor för att förbereda staden för kungens ankomst.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Vi behöver också en snickare, herre. Många byggnader är i akut behov av reparation!";
"T_GAME_QUEST_SCEN13_07_START" = "Vi måste reparera kassavalvet så att skatteindrivaren kan återuppta sitt arbete.\nPengarna behövs för reparationer så fort som möjligt!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Vi borde använda skatterna för att betala för nödvändiga reparationer.";
"T_GAME_QUEST_SCEN13_08_START" = "Du borde reparera småstadshusen och bygga nya för att få in fler arbetare till staden.\nVi måste få fart på produktionen igen!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Nu har vi tillräckligt med plats för fler arbetare, men vi är inte klara än.";
"T_GAME_QUEST_SCEN13_09_START" = "Det här är katastrof!\nVi kan bara lappa ihop de platser kungen kommer att besöka och hoppas att han inte blir misstänksam.\n\nAnvänd tiden klokt medan kungen vilar!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Vänta tills kungen utropar den första platsen han ska besöka.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Kungen såg banditer och blev misstänksam! Vi måste vara försiktigare!";
"T_GAME_QUEST_SCEN13_10_START" = "Kungen vill utforska skogarna.\nVi måste förstöra banditlägren innan han kommer dit!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Det var nära! Men det är inte över än...";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Förstör alla banditläger. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Åh, nej! Vi har inte lyckats lura kungen.\nNu när han är misstänksam får vi inte göra fler misstag!";
"T_GAME_QUEST_SCEN13_11_START" = "Kungen vill vandra genom staden.\nOm han upptäcker missnöjda stadsbor kommer han säkert inse att något inte är som det ska.\n\nVi måste också bygga en staty av kungen!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Utmärkt! Alla stadsbor var på mycket gott humör under kungens promenad.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Öka stadsbornas nöjdhet och bygg en staty av kungen.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Kungen var inte imponerad!\nVi får inte göra fler misstag!";
"T_GAME_QUEST_SCEN13_12_START" = "Kungen ska inspektera våra trupper.\nSe till att vi har en imponerande stadsvakt som väntar vid kungens ankomst!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Den här stadsvakten kommer säkert att imponera på kungen!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Ha tillräckligt många soldater anställda.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Vi misslyckades, herre. Festligheterna uppfyllde inte kungens krav, och nu är han missnöjd!\n\nDet kanske hade varit bättre med ärlighet...";
"T_GAME_QUEST_SCEN13_13_START" = "Kungen vill ha en stor fest. Se till att vi har smycken och fina kläder på lager.\nAllt kommer att falla sönder om vi misslyckas!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "Festen blev en stor succé! Det verkar som att vi lyckades lura kungen.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Skaffa ett lager av kläder och smycken.";
"T_GAME_QUEST_SCEN13_14_START" = "Det är alldeles för farligt för mig att färdas på dina gator med alla mina dyrbara varor.\n\nDu får klara dig själv!";
"T_GAME_QUEST_SCEN13_15_START" = "Nu när du har besegrat banditerna blir det ett nöje för mig att besöka din stad och bedriva handel igen.";
"T_GAME_QUEST_SCEN13_16_START" = "Köpmannen är feg, men han talade sanning!\nSkogarna runt staden är farliga. Vi borde utbilda vakter som håller utkik efter banditer.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Du har lagt grunden för byns försvar, herre. Men vi borde utöka det.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Bygg en kasern och ett vakttorn.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Åh, nej! Banditerna tog sig förbi försvaret! Kungen blir inte glad över att höra det här. ";
"T_GAME_QUEST_SCEN13_19_START" = "Banditer skulle inte förmedla bilden av en säker stad.\nLåt inte för många attacker ske under inspektionen. Då blir vi garanterat avslöjade!";
"T_GAME_QUEST_SCEN14_01A_START" = "Furste, tycker du inte att den här mannen beter sig lite konstigt?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Skicka tyger.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Herre, vi misslyckades med vårt uppdrag!\nDen där medicinska rådgivaren var en bedragare och försvann med allt guld vi hade i kassavalvet.\n\nMen vi hade tur och hittade botemedlet i hans laboratorium...";
"T_GAME_QUEST_SCEN14_01_START" = "God morgon, furste. Riket härjas av pesten.\nTill och med kungen är sjuk! Vi måste stödja hovets medicinska rådgivare för att få fram ett botemedel snabbt. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Vi hittade ett botemedel i tid, herre!\n\nKungen får det just nu! Det här är goda nyheter för kungariket!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Hitta ett botemedel åt kungen.";
"T_GAME_QUEST_SCEN14_02A_START" = "Det är något som inte stämmer, herre! Den här medicinska rådgivaren frågar efter märkliga saker. Jag får en dålig känsla...\n\nVi borde vara försiktiga med honom.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Jag tar med brygden till doktorn när du beordrar det.\nJag hoppas att han ger oss ett botemedel snart. Kungen har inte mycket tid kvar!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "Leverera brygden.";
"T_GAME_QUEST_SCEN14_02_START" = "Jag tror att ett klosterbryggeri vore det bästa sättet att skaffa brygd åt kungen.\n\nFörhoppningsvis lindrar brygden kungens lidande.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Jag tror att ett klosterbryggeri och en humlegård vore det bästa sättet att skaffa brygd åt kungen.\n\nFörhoppningsvis lindrar brygden kungens lidande.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Mycket bra, herre! Munkarna hjälper oss säkert med lite brygd! Kungen kommer att bli nöjd.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Bygg ett kloster.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Bygg ett kloster och en kölna.";
"T_GAME_QUEST_SCEN14_03_START" = "Vi behöver en grisfarm för att leverera grisarna till den medicinska rådgivaren!\nDu borde ge order om att bygga den direkt, furste.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Utmärkt, herre. Nu kan vi börja föda upp grisar.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Bygg en grisfarm.";
"T_GAME_QUEST_SCEN14_05_START" = "Herre, det behövs en kasern i stan. Vi måste upprätthålla lag och ordning i dessa tider.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Herre! Jag visste det!\n\nDen där medicinska rådgivaren är en bedragare. Han hade botemedlet till kungen hela tiden.\nDet verkar som att han smittade landet med sjukdomen.\n\nJag tog mig friheten att instruera vakterna att arrestera honom.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "Detta är en skandal!\n\nHur vågar du arrestera mig! Jag är en viktig rådgivare åt kungen.\nDu kan inte göra så här!";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Jag är besviken på dig, guvernör!\n\nIgår kväll hade jag en vision! Den visade mig att din inkompetens skulle bringa stor olycka över den här staden.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Guvernör! Jag heter Rasiksin. Jag är klärvoajant och är medicinsk rådgivare åt kungen.\nJag behöver allt stöd du kan ge mig!\nTill att börja med ska du ge mig tillräckligt med medicinalväxter så fort som möjligt!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "Jag ser att du har skaffat alla örter jag behöver.\n\nJag hade en vision i går kväll som visade mig att du inte skulle göra kungen besviken.\n\nBe nu din rådgivare att leverera örterna till mig, och försvinn sedan. Jag har jobb att göra.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Skicka örterna.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Jag borde inte ha räknat med dig, guvernör! Mina visioner visade mig att din inkompetens skulle leda till katastrof för staden! Du har gjort både kungen och mig besviken!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "Jag behöver tyg för att filtrera botemedlet. Du måste tillverka tyger åt mig. Och gör det snabbt, så att jag kan börja filtrera snart.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Bra att du inte slösar bort min tid, guvernör!\n\nGe nu order om att leverera resurserna. Jag är väldigt upptagen!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Tillverka tyger.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "Botemedlet måste späs ut för massproduktion. Brygd vore den bästa vätskan!\n\nSätt fart nu!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Det var på tiden! Leverera den till mitt laboratorium.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "Tillverka brygd.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Nej, det är för sent! Nu kommer nästa olycka drabba staden.\n\nDet här är ditt fel!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Vi måste vidta mer drastiska åtgärder för att rädda kungen!\n\nJag behöver grisar att offra till de gamla gudarna.\nDet kanske hjälper...";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Du tog god tid på dig, guvernör. Vad trevligt att du dök upp överhuvudtaget...";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Leverera grisar.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Jag behöver... öh... jag menar att kungen behöver lite speciellt pipgräs för att lindra sin smärta.\n\nGe mig en kista full med mynt för att köpa medicin!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nGe mig det där! Jag kommer... öh, jag menar att... kungen kommer att bli nöjd med att han får sin medicin snart. Han har väldigt ont.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Leverera pengarna.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Jag har fått reda på att kungens kläder gör honom sjuk. Han behöver nya kläder som är gjorda av ett speciellt material.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Äntligen kommer du med kläderna. Kungen börjar redan bli otålig.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Leverera kläderna.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Jag står inte ut med att jobba i det här gamla laboratoriet längre!\n\nBygg ett vakttorn åt mig som jag kan göra om till ett fantastiskt laboratorium. Det ska vara i ett torn. Jag gillar torn.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nJag tar det här tornet i kungens namn. Det här ska bli mitt nya laboratorium. Stick härifrån nu!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Bygg ett vakttorn.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "En sista sak saknas, guvernör.\n\nJag behöver guldtackor för att göra klart botemedlet. Ge mig lite guldtackor.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "Äntligen! Nu tar det bara lite tid att förfina botemedlet.\n\nJag måste göra lite förberedelser för att åka... Jag menar för att dela ut botemedlet.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Leverera guldtackorna";
"T_GAME_QUEST_SCEN15_01_FAIL" = "Allt är förlorat! Du måste leva med vetskapen om att du bidrog till många modiga mäns död...";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "Allt är förlorat! Utan de nödvändiga förråden kunde vi inte segra.\n\nDu måste leva med vetskapen om att du bidrog till många modiga mäns död!\n\nKungen kokar av ilska...";
"T_GAME_QUEST_SCEN15_01_START" = "Var hälsad, härskare.\nJag kommer på begäran av kungen för att hämta förnödenheter till det pågående kriget.\n\nJag vet att era stadsbor lider av kriget, men soldaterna vid fronten är i akut behov av ert stöd!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Var hälsad, härskare.\nJag kommer på begäran av kungen för att hämta förnödenheter till det pågående kriget. Jag vet att era stadsbor lider av kriget, men soldaterna vid fronten är i akut behov av ert stöd!\n\nSegern kan bara uppnås om alla dina leveranser kommer i tid.\n\nKungen räknar med ditt stöd.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Vi har vunnit!\nErt pålitliga stöd bidrog särskilt till det, och ni har mina mäns uppriktiga tacksamhet.\n\nMå lugna tider komma snart!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Stöd kungens armé.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Leverera alla förråd till kungens armé i tid.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "Ditt stöd är avgörande för många mäns liv!";
"T_GAME_QUEST_SCEN15_02_START" = "Vi erövrade nya territorier och behöver säkra frontlinjen nu.\nSkicka plankor och tyg snabbt, så att kan vi bygga upp läger!";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Mycket bra. Skicka nu resurserna till mina soldater!";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Skicka tyg och plankor.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "Hur tror du att vi ska kunna vinna några strider utan ordentlig utrustning?";
"T_GAME_QUEST_SCEN15_03_START" = "De sista striderna förbrukade mycket utrustning!\n\nJag begär en leverans av vapen för att utrusta mina män igen.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Med de där nya vapnen vinner soldaterna med säkerhet nästa strid.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Leverera vapen.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Utan din leverans har jag inget hopp om att vinna den sista striden!";
"T_GAME_QUEST_SCEN15_04_START" = "Våra förråd börjar ta slut!\nSkicka bröd och kött så att vi får tillbaka våra krafter inför den sista striden.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "Soldaterna väntar på maten – skicka den nu!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Skicka bröd och kött.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "Leverera brygd och korv.";
"T_GAME_QUEST_SCEN15_08_START" = "Vi kan inte lämna våra tappra soldater i sticket, men stadsborna lider också av nöd, herre.\nDet är upp till dig att bestämma!\nBörja med att bygga ett sågverk och en jaktstuga.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Nu är vi förhoppningsvis förberedda.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Bygg ett sågverk och en jaktstuga.";
"T_GAME_QUEST_SCEN15_09_START" = "För att leverera de där resurserna behöver vi en fårhage och ett väveri.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Fantastiskt jobbat, herre. Du kan alltid påskynda tillverkningen genom att uppgradera byggnaderna eller bygga fler.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Bygg en fårhage och ett väveri.";
"T_GAME_QUEST_SCEN15_10_START" = "Vi behöver en avancerad järnindustri för att stödja våra soldater!";
"T_GAME_QUEST_SCEN15_10_SUCCESS" = "Smeden arbetar. Se bara till att det finns tillräckligt med malm för att hålla igång produktionen.";
"T_GAME_QUEST_SCEN15_10_TITLE" = "Bygg en verktygssmedja och en vapensmedja.";
"T_GAME_QUEST_SCEN15_11_START" = "Vi behöver ett bageri och fler jaktstugor för att förse trupperna med mat!";
"T_GAME_QUEST_SCEN15_11_SUCCESS" = "Mycket bra, furste. De nödvändiga varorna borde snart finnas i lager.";
"T_GAME_QUEST_SCEN15_11_TITLE" = "Bygg ett bageri och fler jaktstugor.";
"T_GAME_QUEST_SCEN15_13_FAIL" = "Medan du fokuserade på att hjälpa trupperna så försummade du stadsborna!";
"T_GAME_QUEST_SCEN15_13_START" = "Vi lider av svår brist, herre. Jag ber dig ödmjukt att ge en del av de förråd som ska till soldaterna till de fattiga istället!";
"T_GAME_QUEST_SCEN15_13_SUCCESS" = "Du är en godhjärtad härskare! Trots soldaternas krav så försummade du inte stadsborna.";
"T_GAME_QUEST_SCEN15_13_TITLE" = "Valfritt: Hjälp stadsborna.";
"T_GAME_QUEST_SCEN15_13_TITLE_OLD" = "Hjälp stadsborna.";
"T_GAME_QUEST_SCEN15_14_FAIL" = "Att se hur värdefulla resurser förbrukas av det här kriget är frustrerande för många, furste!";
"T_GAME_QUEST_SCEN15_14_START" = "Det är kallt ute och arbetarna har inga lämpliga kläder. Skulle du kunna vara vänlig nog att tillverka lite kläder?\nVi kan inte betala dig, men vi kommer att arbeta hårdare än någonsin tidigare, herre!";
"T_GAME_QUEST_SCEN15_14_START_2" = "Det är kallt ute och arbetarna har inga lämpliga kläder. Skulle du kunna vara vänlig nog att tillverka lite kläder?\nVi kan inte betala dig, men vi kommer att arbeta hårdare än någonsin tidigare, herre!";
"T_GAME_QUEST_SCEN15_14_SUCCESS" = "Du är så god, furste! Nu behöver vi inte darra i kylan.";
"T_GAME_QUEST_SCEN15_14_TITLE" = "Tillverka kläder åt folket.";
"T_GAME_QUEST_SCEN15_15_FAIL" = "Utan nya verktyg kan inte folket arbeta lika effektivt som innan.";
"T_GAME_QUEST_SCEN15_15_START" = "Skulle du kunna skicka lite järn till verktygssmeden istället, så kan han smida nya arbetsredskap till oss?\nDu skulle vi kunna arbeta effektivare i de här svåra tiderna.";
"T_GAME_QUEST_SCEN15_15_SUCCESS" = "Din godhet känner inga gränser, herre!";
"T_GAME_QUEST_SCEN15_15_TITLE" = "Ge verktyg till arbetarna.";
"T_GAME_QUEST_SCEN15_16_FAIL" = "Stadsborna svälter fortfarande, herre. Om de inte får mat lär stämningen bli mycket sämre snart.";
"T_GAME_QUEST_SCEN15_16_START" = "Stadsborna svälter, herre.\nLämna förråden till oss istället, så kommer du aldrig höra oss klaga igen!";
"T_GAME_QUEST_SCEN15_16_SUCCESS" = "Må gudarna välsigna dig!";
"T_GAME_QUEST_SCEN15_16_TITLE" = "Ge mat till stadsborna.";
"T_GAME_QUEST_SCEN15_17_1_FAIL" = "Missnöjet sprider sig, herre. Du måste göra något snabbt!";
"T_GAME_QUEST_SCEN15_17_FAIL" = "Det är illa, herre. Moralen är ganska låg. Jag är rädd att en del av de arga stadsborna kan göra något förhastat.";
"T_GAME_QUEST_SCEN15_17_START" = "Herre, hela landet är drabbat av kriget!\nOm stadsbornas moral sjunker kan det bryta ut upplopp.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Enastående, herre. Du lyckades förhindra oroligheter i din stad!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Låt inte nöjdheten sjunka för lågt.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "Upprätthåll en lycka på över 75 %.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Låt inte nöjdheten sjunka för lågt under för lång tid.";
"T_GAME_QUEST_SCEN15_19_START" = "Det går rykten om att den här branden inte var en olycka, herre.\nJag skulle säkert kunna få reda på mer genom att lyssna på rykten på en krog. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Stadsborna pratar garanterat mycket på krogen. Jag ska försöka ta reda på mer om bränderna i staden.";
"T_GAME_QUEST_SCEN15_20_START" = "Ryktet säger att det finns en mordbrännare som tänder eld på hus för att uppvigla stadsborna.\nVi måste utbilda vakter.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Nu behöver vi bara vänta...";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Vi kan andas ut, herre! Vakterna fick tag i mordbrännaren och arresterade honom.\nStaden borde vara säker igen!";
"T_GAME_QUEST_SCEN16_01_START" = "Var hälsad, vördade furste. Kungen kräver snart sin tribut.\nVi måste stödja det lokala jordbruket.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Utmärkt!\n\nTack vare din ekonomiska skicklighet kunde vi uppfylla kungens krav, herre.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Uppfyll kungens krav.";
"T_GAME_QUEST_SCEN16_02_2_START" = "Åh, nej! Kungen krävde ytterligare ett parti vete.\nVi kanske kan byta till oss resten av de efterfrågade spannmålen från köpmannen!";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "Vi lyckades verkligen! Skicka vetet till kungen nu.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Skicka mer vete till kungen.";
"T_GAME_QUEST_SCEN16_02_START" = "Kungen krävde just vete av byarna.\nFör att kunna leverera en så enorm mängd behöver vi fler gårdar!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Det finns tillräckligt med vete i lager för att klara leveransen, herre.";
"T_GAME_QUEST_SCEN16_03_START" = "Kungen behöver resurser för att bygga fler lager.\nSkicka det nödvändiga materialet till kungen.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Leverera det efterfrågade material nu för att fortsätta med övriga leveranser.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Leverera byggmaterial för ett lager.";
"T_GAME_QUEST_SCEN16_04_1_START" = "Den första leveransen var rutten. Skicka en ny när vi har blivit av med sjukdomen i staden.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Utmärkt gjort, herre! Det finns nytt kött finns i lager som väntar på att levereras.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Skicka kött.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Skicka kött när sjukdomen har försvunnit.";
"T_GAME_QUEST_SCEN16_04_START" = "Nu ber kungen om kött.\nDet borde inte vara något problem med tillräckligt många jägare.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Mycket bra, furste. De nödvändiga resurserna finns i lager.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Bygg fler jaktstugor och leverera kött.";
"T_GAME_QUEST_SCEN16_05_START" = "Kungen planerar att anordna en fest. Därför vill han att vi skickar dryck.\nSkicka brygd och druvsaft till det kungliga hovet.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Mycket bra, furste. Det finns tillräckligt med brygd och druvsaft finns i lager.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "Skicka brygd och druvsaft.";
"T_GAME_QUEST_SCEN16_06_START" = "Kungen var mycket nöjd med våra leveranser.\nHan vill att vi ska skicka maten också.\n\nSkicka korvar och bröd till den kungliga festen nu. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Magnifikt, herre. Det här var den sista tributen.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Skicka korvar och bröd.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Skicka saft och bröd.";
"T_GAME_QUEST_SCEN16_08_START" = "Det är katastrof, herre! Vårt vete har drabbats av en mystisk sjukdom och har blivit förstört!";
"T_GAME_QUEST_SCEN16_09_START" = "Byborna lider av en fruktansvärd smitta.\nOm vi inte blir av med den snabbt så kommer det inte att finnas några arbetare kvar!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "Smittan verkar utlösas av sjuka djur. Leveransen till kungen var också infekterad.\nVi måste skicka en ny!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Bli av med smittan i staden med hjälp av en doktor.";
"T_GAME_QUEST_SCEN16_10_START" = "Gudarna har vänt sig mot oss. Alla vilda djur dog av smittan. Hur ska vi nu förse staden med mat och uppfylla kungens krav?";
"T_GAME_QUEST_SCEN16_11_START" = "Vi måste föda upp djur för att mata stadsborna nu.\nDärför behöver vi en grisfarm och en slaktarbod.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Grisarna äter på vete. Skaffa det från köpmannen så att vi kan ta hand om leveransen åt kungen igen.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Bygg en grisfarm och en slaktarbod.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Du förstår säkert att mina förråd är väldigt eftertraktade.\nFrån och med nu kommer jag att byta vete mot järnmalm.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Leverera malmen så kommer jag snart tillbaka med en till leverans.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Byt järnmalm mot vete.";
"T_GAME_QUEST_SCEN16_12_2_START" = "För ett löjligt lågt pris kan jag leverera en del av det sista vetet som finns i landet!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Det är mig ett nöje, herre. Skicka mig guldet så ska jag se om jag kan skrapa ihop lite mer.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Byt guld mot vete.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Jag hörde om din olycka och vill erbjuda dig ett byte. Jag har fortfarande en del vete i förrådet som jag skulle byta mot varor.";
"T_GAME_QUEST_SCEN16_12_START" = "Jag skulle gärna byta lite sten mot vete.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Nu verkar det som att du har tillräckligt med varor för ett byte. Jag ser fram emot att handla mer med dig.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Byt stenar mot vete.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Har du provat brödet som min brorson bakar? Det borde du verkligen göra! Och säg åt honom att baka så mycket att det räcker hela vintern!";
"T_GAME_QUEST_SCEN2_10_NAME" = "Baka 50 limpor bröd.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Bygg ett väveri.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Bygg ett skrädderi.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Säg mig, fryser du lika mycket som vi gör? Min fru blev till och med förkyld på grund av alla hål i hennes klänning. Du kanske kan hjälpa oss att sy lite varma kläder?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Bygg en fårhage.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Jag tror att vår stad är nästan perfekt förberedd för den stundande vintern! Men bara mellan oss två, är det inte underbart att ta ett gott krus saft nere på den mysiga krogen när det är iskallt ute?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Bygg en saftanläggning och tillverka 50 kannor med saft.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Herre, jag vill inte framstå som oartig, men tyvärr har vi för få gårdar! Hur ska vi kunna skörda allt vete i tid innan vintern börjar?";
"T_GAME_QUEST_SCEN2_1_NAME" = "Bygg två gårdar.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brr, jag fryser redan, herre! Jag är säker på att den stundande vintern blir väldigt kall! Min fru och jag hoppas att du inte glömmer att se till att det finns tillräckligt med ved!";
"T_GAME_QUEST_SCEN2_2_NAME" = "Bygg tre skogshuggarstugor.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Tack! Hälsa mina bröder om du träffar dem. De måste samla så mycket ved som möjligt!";
"T_GAME_QUEST_SCEN2_3_NAME" = "Samla 35 trä.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Äntligen kan vi börja skörda! Jag hoppas att det blir tillräckligt för oss!";
"T_GAME_QUEST_SCEN2_4_NAME" = "Skörda 35 vete.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Vilken riklig skörd! Vi vet inte ens var vi ska förvara allt vete! Det vore en bra idé att baka lite bröd av det!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Bygg en väderkvarn och producera mjöl.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Käre herre, vi gillar verkligen att bo här, men vi är oroliga över att våra hus kanske inte klarar den stundande vintern särskilt länge...";
"T_GAME_QUEST_SCEN2_6_NAME" = "Håll alla hus i gott skick.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Jag är fortfarande orolig över en sak...\nTyvärr har vi inga verktyg på lager. Jag är säker på att du vet hur viktigt det är med verktyg för att reparera byggnader! Skulle du kunna skaffa lite verktyg åt oss?";
"T_GAME_QUEST_SCEN2_7_NAME" = "Leverera 50 verktyg i tribut.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Jag är rädd för att mina bröder inte klarar av allt arbete på egen hand... Du kanske kan se till att vi får lite mer folk till vår by?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Öka befolkningen till 50.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Jag har redan fått istappar på näsan, men en del av de resande som letar efter en plats att bosätta sig på har det ännu värre. Jag tycker att vi ska låta dem bo i vår by!";
"T_GAME_QUEST_SCEN2_9_NAME" = "Bygg sex småstadshus.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Älskling, glöm inte att det är vår bröllopsdag imorgon! Jag skulle verkligen vilja ha nya smycken! Om du bara kände en guldsmed...";
"T_GAME_QUEST_SCEN3_10_NAME" = "Bygg en guldsmedja.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Jag är säker på att kungen och stadsborna skulle bli glada över lite nya verktyg! De gamla har blivit rostiga och oanvändbara!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Bygg en verktygssmedja.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Bygg ett skrädderi och tillverka kläder.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Åh, titta på de där söta fåren! Älskling, såg du dem? Och titta på all ull som redan har skördats från dem! Nu behöver vi bara ett väveri och en skräddare!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Bygg ett väveri och tillverka tillräckligt med tyg.";
"T_GAME_QUEST_SCEN3_13_DESC" = "Barnen är verkligen exalterade och ser fram emot allt färskt bröd de kommer att få snart! Du har redan byggt lite bagerier, eller hur? Raring?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Gissa vad! Min syster vill äntligen gifta sig! Men vi behöver fortfarande en kyrka i vår stad! Inte bara för vigseln, utan även för våra religiösa stadsbor!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Uppnå hög nöjdhet med religion.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Titta, älskling! Staden har återhämtat sig och allt går bra! Så du har min tillåtelse att koppla av med dina vänner och bygga en krog om du vill! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "Uppnå hög nöjdhet med krogar.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Älskling, titta på den här nedgångna byn... Stackars stadsbor, jag tycker verkligen synd om dem! Jag tycker att du ska be kungen om hjälp. Du kanske kan övertyga honom genom att skicka lite presenter!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Skicka en tribut till kungen och slutför alla uppgifter.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Du borde ta tag i saken tills kungen skickar hjälp! Stadsborna är i akut behov av mer vatten!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Bygg en brunn i byn.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Din föregångare lyckades inte ens leverera tillräckligt med mat! Det är otroligt! Älskling, du borde ändra på det här omedelbart! Du kan väl bygga lite fiskarstugor?";
"T_GAME_QUEST_SCEN3_3_NAME" = "Bygg två fiskarstugor.";
"T_GAME_QUEST_SCEN3_4_DESC" = "De där stackars barnen... Älskling, vi kan inte bara ge dem fisk att äta! Du borde bygga gårdar så att vi kan skörda vete till mjöl och bröd!";
"T_GAME_QUEST_SCEN3_4_NAME" = "Bygg två gårdar och producera vete.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Bygg ett smältverk.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Älskling, har du inte glömt något? Planerade inte du att skicka lite gåvor till kungen för att övertyga honom om att hjälpa oss? Det är tur att du har mig. Vi behöver definitivt en gruva och ett smältverk innan vi kan producera något av värde!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Bygg en gruva.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Alla stadsbor är överarbetade! Kan du inte bygga lite nya småstadshus för att locka fler arbetare?";
"T_GAME_QUEST_SCEN3_6_NAME" = "Bygg tre småstadshus.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Åh, jag är så glad! Saker och ting blir bättre och bättre! Nu kan vi till och med börja ta in mer skatt från stadsborna!";
"T_GAME_QUEST_SCEN3_7_NAME" = "Samla in 1 500 daler i skatt.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Samla in tillräckligt med daler i skatt.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Vet du vad som vore trevligt att ha? Lite nya kläder! Jag menar, mest till kungen, såklart... Men först behöver vi lite fårhagar så att vi kan skörda ull!";
"T_GAME_QUEST_SCEN3_8_NAME" = "Bygg två fårhagar.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Bönderna jobbar redan hårt med att skörda vete! Nu kan du bygga en väderkvarn så att vi kan göra mjöl till bröd!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Bygg en väderkvarn och producera mjöl.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Mitt slott lämpar sig inte riktigt för min kungliga status, så jag planerar att utöka mitt sommarboende avsevärt.\n\nSom din kung befaller jag dig att leverera en stor mängd sten. Jag räknar med dig, gode härskare.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Leverera en vagnslast med sten till kungen.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Den brännande hettan har gått hårt åt våra hem. Husen har förfallit och många familjer kräver att du förbättrar husens skick.\n\nDet vore fantastiskt om du kunde överväga att förbättra byggnadernas skick i staden.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Uppnå hög nöjdhet med byggnaders skick.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Min gode härskare, jag väntar fortfarande på leveransen med druvsaft. Min bankett börjar snart.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Leverera druvsaft till kungen.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Herre, det är stor efterfrågan på mjöl i hela kungariket. Gårdarna kan inte producera tillräckligt med vete för att kvarnarna ska kunna jobba med full kapacitet.\n\nOm du levererar tillräckligt med mjöl till mig så kan jag ta över marknaden och bygga upp ett monopol i den här regionen. Jag skulle såklart belöna dig ordentligt för det.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Leverera mjöl till köpmannen.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Stadsborna vill bygga solskydd för att skydda dem från den stekande solen under dagarna. Vi borde förse dem med träplankor så att de kan börja direkt!";
"T_GAME_QUEST_SCEN4_14_NAME" = "Tillverka 35 plankor.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Herre, du har gjort bra ifrån dig. Staden har vuxit till beundransvärd storlek.\n\nÄndå är stadsborna mycket olyckliga på grund av torkan. Du borde försöka öka lyckan genom att uppfylla fler av deras önskemål. Det är förstås bara ett blygsamt förslag...";
"T_GAME_QUEST_SCEN4_15_NAME" = "Uppnå hög lycka i din stad.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Helt fantastiskt, furste!\nTrots torkan har du lyckats bygga upp en stor stad. Dina stadsbor är verkligen nöjda med de ändringar du har gjort.\n\nSom din kung är jag mycket nöjd med ditt arbete. Du har gjort riket en stor tjänst och du kommer att bli belönad för det.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Herre, stadsborna lever i fattigdom och misär. Riket lider av torka. Titta bara på den här en gång så magnifika floden som flöt intill ditt slott. Det finns bara små pölar kvar...\n\nKungen har givit oss i uppdrag att utöka vår stad. Vi börjar med att bygga lite fler småstadshus.";
"T_GAME_QUEST_SCEN4_1_NAME" = "Bygg åtta småstadshus till.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Furste, kungen är glad över att höra om stadens framgångsrika expansion, men han befaller oss att bygga en ännu större stad.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Uppnå en befolkning på 100.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Herre, som köpman skulle jag kunna vara till stor hjälp i din nuvarande situation.\n\nRiket lider av en torka, men jag kan leverera viktiga förnödenheter till din stad så fort du har byggt en marknadsplats.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Uppnå hög nöjdhet med marknadsplatsen.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Herre, jag ber dig att ge order om att bygga fler brunnar för att förse byborna med tillräckligt med vatten i den här värmen.";
"T_GAME_QUEST_SCEN4_3_NAME" = "Bygg två brunnar.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Jag har goda nyheter, furste. En stadsbo har upptäckt att vattenpölarna nere i den torkade flodbädden fortfarande innehåller en del fisk.\n\nVi borde låta bygga lite fiskarstugor.";
"T_GAME_QUEST_SCEN4_4_NAME" = "Bygg två fiskarstugor.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Herre, jag skulle vilja föreslå ett avtal.\n\nOm vi kan utöka vår handelsrelation så skulle jag kunna ordna regelbundna matleveranser till din stad.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Gör en vinst på 1 000 daler genom att sälja saker på marknaden.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Än en gång kommer jag till dig med ett förslag. Jag är i brådskande behov av kol. Om du förser mig med kol så ska jag betala dig en stor påse med daler.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Leverera kol till köpmannen.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Härskare, mitt hov är i akut behov av druvsaft. Torkan plågar fortfarande mitt kungarike, och den har utplånat vår druvskörd.\n\nJag beordrar dig att bygga en saftanläggning. Jag planerar att snart att hålla i en bankett på mitt slott, så gör mig inte besviken!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Bygg en saftanläggning och tillverka saft.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Herre, min familj kan knappt odla något i den här uttorkade jorden. Skörden blir dålig, så en gård kommer inte att räcka.";
"T_GAME_QUEST_SCEN4_8_NAME" = "Bygg en till gård och producera tillräckligt med vete.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Vårt brödlager håller på att ta slut, furste. Vi borde minska brödkonsumtionen genom att förse staden med mer kött.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Producera tillräckligt med kött.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Slutför alla uppgifter, övervinn torkan och utvidga din småstad till en storstad!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Nu är det bara en sak som saknas, herre, och det är druvsaft för att fira vår seger!\n\nVar snäll och leverera en riklig mängd druvsaft till arméns läger!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Leverera 45 druvsaft till riddaren.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Helt fantastiskt, furste!\nLord Blankenstein har framgångsrikt avslutat sin kampanj och talar mycket varmt om dig och ditt stöd.\n\nVill du göra en sista affär innan jag lämnar den här regionen?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Tjäna 2 500 daler genom handel.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Det är en vacker morgon, furste. Jag har fantastiska nyheter. Vi har blivit kontaktade av en oberoende köpman.\n\nHan besöker snart vår stad och har sagt att han behöver träplankor för att bygga ett marknadsstånd.";
"T_GAME_QUEST_SCEN5_1_NAME" = "Tillverka 30 plankor.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Herre, du har etablerat en trevlig liten handelsstation här. Det saknas dock en viktig sak, och det är en krog. Om vi bygger en krog så skulle vår lilla stad locka till sig fler köpmän och resenärer.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Uppnå hög nöjdhet med krogar.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Mycket bra, herre. Den där krogen öppnar upp många handelsmöjligheter i framtiden.\nNu till den intressanta delen av vårt arrangemang. Låt oss byta lite varor... ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Tjäna 1 500 daler genom handel.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Skulle du kunna fylla på med tyger, furste? Jag har en handelspartner som är extremt intresserad av tyger.\n\nJag träffade också en riddare när jag reste. Han är på väg hit och har kanske lite intressanta uppgifter åt dig.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Ha 35 enheter tyg på lager.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Herre! Jag är Kunibert von Blankenstein, en riddare som dubbats av kungen.\n\nDin handelsstation är perfekt för att hjälpa mig att driva bort banditerna från det här området. Kan du förse mig med sten så att jag kan bygga vakttorn för att skydda den här regionen?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Leverera 50 sten till riddaren.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Härskare, mina vapensmeder är i akut behov av järn för att förse min armé med svärd.\n\nDet finns flera malmfyndigheter nära din handelsplats. Kan du skicka en leverans med järn till min tjänare?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Leverera 65 järntackor till riddaren.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Jag har ett problem, herre. Några av mina fotsoldaters rustningar blev buckliga under den senaste striden mot banditerna.\n\nVar snäll och skaffa ett lager med verktyg så att mina soldater kan reparera sina rustningar när de besöker handelsstationen.";
"T_GAME_QUEST_SCEN5_7_NAME" = "Tillverka 25 verktyg.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Jag har goda nyheter, härskare! Min kampanj har varit en stor framgång, och banditerna har fördrivits från den här regionen.\n\nVi har förbrukat all vår proviant under den här långa kampanjen. Du måste leverera lite mat till min armé.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Leverera 25 fisk och 25 bröd till riddaren.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Mina trupper vill fira vår seger mot banditerna, men nu när banditerna har besegrats är mina män rastlösa.\n\nSkulle du kunna bygga underhållningslokaler i stan, herre?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Mina trupper vill fira vår seger mot banditerna, men nu när banditerna har besegrats är mina män rastlösa.\n\nHerre, skulle du kunna bygga ett tornerspelsområde i stan så att soldaterna kan göra av med lite överskottsenergi?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Uppnå hög nöjdhet med tornerspelsområdet.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Bygg en framgångsrik handelsstation genom att slutföra alla uppgifter!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Helt enkelt fantastiskt, furste.\nDu har framgångsrikt etablerat en handelsstation på de här strategiskt viktiga platsen.\nKungen och lord Blankenstein är mycket nöjda med ditt arbete och ditt stöd till kampanjen mot banditerna i regionen.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Kungen har skickat en order! Han kräver en enorm mängd material för att bygga en katedral! Byggandet av den här monumentala byggnaden har redan börjat, så vi bör leverera resurserna så snabbt som möjligt.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Leverera resurser för byggandet av katedralen.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Byt ull mot fisk.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Byt järnmalm mot fisk.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Byt ut druvsaft mot fisk.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Byt guldmalm mot fisk.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Byt träplankor mot fisk.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Jag kan se att det inte finns några sjöar eller floder i närheten, så du kan inte skaffa fisk. Bygg en marknadsplats så kan jag ge dig fisk i utbyte mot olika varor!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "Bygg två gruvor till.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "Bygg tre gruvor till.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Vi borde börja med gruvbrytning direkt! Se till att vi har tillräckligt med gruvor igång så att vi kan hålla leveransschemat.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Bygg en gruva.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Dina stadsbor arbetar så hårt de kan för att bryta all malm! Se till att förse dem med tillräckligt med mat så att de kan arbeta ordentligt!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Bygg ett bageri och producera lite bröd.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Det går framåt, men vi måste fortfarande smälta malmen!";
"T_GAME_QUEST_SCEN6_5_NAME" = "Bygg två smältverk.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Det kan vara riktigt obehagligt att arbeta i mörka och fuktiga gruvor utan ordentliga kläder! Du borde förse dina stadsbor med varma kläder. Jag är säker på att de verkligen skulle uppskatta det!";
"T_GAME_QUEST_SCEN6_6_NAME" = "Leverera 25 klädesplagg.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Herre, vi producerar resurser i otrolig takt! Vi måste bygga fler lager för att få plats med alla resurser!";
"T_GAME_QUEST_SCEN6_7_NAME" = "Bygg två lager.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Att jobba i gruvorna är ett hårt jobb! Dina stadsbor skulle älska att ha en plats att koppla av på efter en hård dags arbete. En krog vore perfekt för det! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "Bygg en krog.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Bra gjort! Du levererade alla nödvändiga resurser till katedralen! Men byggandet kommer att ta lite tid.\n\nKatedralen ska hedra vår store kung, vars gärningar har skapat en era av fred och harmoni som kommer att vara i århundraden!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Kom ihåg att du kan ta bort träd som är i vägen! Använd spaden för att markera de träd du vill ta bort.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Furste, vi kan inte baka en bröllopstårta utan de rätta ingredienserna! Skulle du kunna bygga en gård så att vi kan producera vårt eget mjöl?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Bygg en gård.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Bygg en väderkvarn.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "Producera 25 bröd.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "Det här blir ett fantastiskt bröllop! Först måste vi se till att vi har en otrolig bröllopstårta. Kan du vara snäll och bygga ett bageri medan jag väljer brudklänning?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Bygg ett bageri.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Jag behöver en marknadsplats så att jag kan göra mig av med alla bröllopspresenter jag inte gillar!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Uppnå hög nöjdhet med marknadsplatsen.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Herre, vi göra goda framsteg med förberedelserna inför bröllopet! Men vi behöver fler verktyg för att bygga bröllopstältet!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Bygg en verktygssmedja.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "Tillverka 20 verktyg.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Jag vill att vår bröllopsceremoni ska genomföras i en vacker kyrka. Har du redan byggt en?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Uppnå hög religiös lycka.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Bygg en fårhage.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Bygg ett väveri.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "Tillverka 20 kläder.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Kan du tro det? Jag kunde inte hitta en anständig bröllopsklänning någonstans! Jag behöver en klänning med en gång! Säg åt dina bästa skräddare att sy en.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Bygg ett skrädderi.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Bygg dekorationer.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Öka stadsbornas lycka!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Det här stället är dystert... Kan du inte göra staden vackrare? Jag vill att alla ska vara lika glada som jag!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Jag bryr mig inte om tårta och blommor. Jag vill ha ett stort firande med mycket saft! Och jag vill bjuda in hela staden! Men vi har inte tillräckligt med plats för alla bröllopsgäster!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Bygg fler små småstadshus.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Jag vill ha ett trevligt ställe där jag kan träffa mina vänner när bröllopet är över. Den här staden behöver verkligen en krog!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Uppnå hög nöjdhet med krogar.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "Producera 25 druvsaft.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Mina vänner kommer att bli väldigt törstiga! Har du redan ordnat saften?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Bygg en saftanläggning.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Det kommer fler gäster än väntat. Bygg ett stort småstadshus.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Bygg ett stort småstadshus.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "Tillverka 15 smycken.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Åh, nej! Jag har allvarliga problem! Jag har tappat bort vigselringen! Snälla, berätta inte för henne! Finns det någon guldsmed i staden som kan göra en ny?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Bygg en guldsmedja.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Innan jag gifter mig vill jag imponera på min fästmö på tornerspelsområdet!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Bygg tornerspelsområden.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Herre, våra slottsförråd är redan ganska tätt packade med varor. Får jag föreslå att vi låter bygga ett till lager?";
"T_GAME_QUEST_SCEN8_10_NAME" = "Bygg ett nytt lager.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Männen i staden skulle bli gladare om det fanns en plats där de kunde träffas och ta ett krus druvsaft efter en hård dags arbete. Skulle det vara för mycket begärt att be om en krog, herre?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Uppnå hög nöjdhet med krogar.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Herre, smeden har byggt enkla kaminer till våra stadsbor, men vi behöver fortfarande kol för att elda i dem.";
"T_GAME_QUEST_SCEN8_12_NAME" = "Producera 50 kol.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Herre, staden har ont om ved för att värma husen. Det är väldigt viktigt att vi fyller på med ved!";
"T_GAME_QUEST_SCEN8_1_NAME" = "Producera 75 ved.";
"T_GAME_QUEST_SCEN8_2_DESC" = "Staden är i dåligt skick. Titta på alla nedgångna hus. Det krävs förmodligen bara en snöstorm för att många av dem ska fall ihop. Vi borde ta med en snickare till staden för att hjälpa till med reparationerna av byggnaderna.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Bygg en snickarverkstad.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Herre, den här hårda vintern är helt klart ett tecken från himlen! Vi måste ångra våra synder! Låt oss bygga en kyrka för att blidka den allsmäktige!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Uppnå hög nöjdhet med religion.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Stadsborna börjar bli rastlösa, herre. Det är väldigt kallt i deras hem. Jag tycker att vi ska skaffa mer ull. Stadsborna kan använda det för att isolera sina hus mot kylan.";
"T_GAME_QUEST_SCEN8_4_NAME" = "Producera 55 ull.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Guvernören i den angränsande provinsen har skickat oss en brevduva med en vädjan om hjälp! De är i akut behov av varma kläder till sitt folk.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Leverera en vagnslast med kläder till grannprovinsen.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Gårdar kan inte producera vete på vintern, herre. Låt oss skicka några stadsbor till skogen för att jaga rådjur.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Bygg några jaktstugor.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Min lojala tjänare, riket har drabbats hårt av den ovanligt hårda vintern. Skatteinkomsterna har sjunkit drastiskt.\n\nJag befaller dig att bygga en ett kassavalv för att öka dina skatteintäkter och sedan skicka mig en vagnslast med daler i tribut.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Bygg ett kassavalv och leverera mynt i tribut till kungen.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Nu när vi har en snickare i staden är det inga större problem att reparera alla de här slitna husen. Stadsborna kommer att bli väldigt glada.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Se till att alla småstadshus är ordentligt reparerade.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Viltkött finns alltid tillgängligt, även på vintern, och det kan ersätta bröd. Låt oss se till att det finns tillräckligt med kött för att vi ska klara oss hela vintern.";
"T_GAME_QUEST_SCEN8_9_NAME" = "Producera 50 kött.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Herre, vintern är mycket hårdare än vi hade väntat oss, och stadsborna är missnöjda med situationen.\n\nVi måste agera snabbt, annars överlever vi inte vintern!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Se till att staden klarar sig genom vintern...";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Herre, stadsborna är mycket nöjda med de framsteg vi har gjort!\n\nNu har vi tillräckligt med förråd för att klara oss genom vintermånaderna, och vi kunde till och med hjälpa grannprovinsen. Nu är vi förberedda, och den här vintern kan inte skada oss!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Herre, jag hörde att du har problem med rebeller i ditt område. Jag är villig att leda en spaningspatrull i skogen, men mina legosoldater kräver betalning i förväg.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Betala legosoldaterna.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Jag har ännu ett önskemål, min lojala tjänare. Jag behöver ett flaggskepp som anstår en kung, och det betyder överdådiga guldprydnader!\n\nJag befaller dig att leverera det guld jag behöver för detta ändamål. Gör mig inte besviken.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Leverera guldmalm till kungen i tid.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Min lojale tjänare, byggandet av min nya flotta går bra, men vi behöver fortfarande stora mängder segelduk. Jag befaller dig att leverera tillräckligt med tyg för att förse alla mina skepp med segel.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Leverera tyg för tillverkning av segelduk.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Mina män har upptäckt något. Vi hittade spår efter banditer i skogen. Vi behöver dock mer proviant innan vi kan undersöka saken vidare.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Leverera proviant till legosoldaterna.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Guvernör! Jag förlorade en hel sändning med träplankor till banditer i din provins. Det här måste få ett slut. Leverera fler träplankor så snart som möjligt.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Leverera träplankor för att stödja kungens byggande av flottan.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Herre, skatteindrivaren har hittat bevis på ett samband mellan banditerna i skogen och sabotören i stan. Han vägrar berätta mer för oss eftersom han fruktar för sitt liv.\n\nHan kräver att bli befriad från sina plikter som skatteindrivare. Han vill också ha en uppsättning nya kläder så att han kan lämna staden och gömma sig. Först då berättar han för oss vad han har fått reda på.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Ta bort skatteindrivarens tilldelning från kassavalvet och ge honom nya kläder så att han kan lämna staden utan att bli upptäckt.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Herre, skatteindrivaren avslöjade identiteten på sabotören innan han lämnade staden, precis som han lovade.\n\nDet är legosoldaten och hans män! De är bedragare! De går från stad till stad och tar betalt för att "skydda" städerna mot banditer och sabotage som de själva utför i hemlighet!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Dåliga nyheter, herre! Någon bröt sig in på lagret och stal allt vårt kött!\n\nLåt oss placera ut facklor i staden. Det kan hjälpa oss att fånga tjuvar på natten.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Bygg sju facklor runt om i staden för att avskräcka tjuvar.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Furste, eftersom vi inte kommer att få besök av resande köpmän på ett tag så behöver vi förrådsutrymme för att förvara alla våra varor.\n\nDessutom bör vi stoppa onödig produktion för att se till att våra lager inte blir överfulla.\n\nDet vore klokt att bygga ett till lager.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Bygg ett till lager i staden.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Stadsborna är livrädda för sabotören och är för rädda för att gå ut och reparera sina byggnader.\n\nJag antar att vi måste bygga en snickarverkstad om vi vill att reparationerna ska bli gjorda.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Bygg en snickarverkstad.";
"T_GAME_QUEST_SCEN9_1_DESC" = "God morgon, herre. Det är en vacker vinterdag. Vi har mycket arbete framför oss under de kommande månaderna.\n\nLåt oss börja redan nu och bygga ett par skogshuggarstugor.";
"T_GAME_QUEST_SCEN9_1_NAME" = "Bygg några skogshuggarstugor.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Jag kommer till dig med en begäran, herre. Verktyg är mycket efterfrågade i hela riket.\n\nJag skulle betala mycket bra om du kunde leverera en vagnslast med verktyg till mig. Dessutom skulle jag besöka din stad igen för att bedriva handel.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Leverera en last med verktyg till köpmannen.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Jag har viktiga nyheter, herre! Ett gäng legosoldater har anlänt och de klagar redan över att vår by saknar en krog.\n\nVi borde försöka undvika att ha ett gäng missnöjda och uttråkade legosoldater i staden, så låt oss bygga en krog. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Uppnå hög nöjdhet med krogen.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Guvernör, det gläder mig att se att dina ansträngningar för att öka träproduktionen går bra.\n\nOm du nu skulle vilja göra en första leverans...";
"T_GAME_QUEST_SCEN9_3_NAME" = "Skicka trä i tribut till kungen.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Herre, det går ihärdiga rykten om oroligheter i staden. Kan det vara så att vissa stadsbor konspirerar mot kronan?\n\nOm vi inte agerar nu så kan det bli ett fullskaligt uppror. Vi bör se till att stadsborna är glada och nöjda, och vi gör klokt i att skynda oss.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Upprätthåll en lycka på över 100 % under de kommande minuterna.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Herre, det här är skandal! Krogen har förstörts! Det talas om en sabotör som är på fri fot i vår stad.\n\nVi måste få läget under kontroll innan allt går överstyr. Galgar och skampålar borde göra susen.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Bygg galgar och två skampålar i staden.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Herre, det vore klokt att öka moralen i staden lite.\n\nAtt visa dina stadsbor lite vänlighet skulle öka deras lycka. Varför inte bygga en kyrka åt dem eller försköna staden med blomsterträdgårdar?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Bygg lite blomsterträdgårdar och en kyrka.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Guvernör, jag är ledsen att meddela att jag inte kan besöka din stad för tillfället.\nJag hörde rykten om banditer i skogen runt din stad. Den är för farlig för köpmän just nu.\n\nMen jag har ett meddelande från kungen. Han beordrar att två sågverk ska byggas.";
"T_GAME_QUEST_SCEN9_7_NAME" = "Bygg två sågverk!";
"T_GAME_QUEST_SCEN9_8_DESC" = "Herre, jag har en idé. Vi borde bygga ett kassavalv. Skatteindrivaren kommer att besöka alla hus i staden... och han kanske kan gräva fram något om den där sabotören.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Bygg ett kassavalv och vänta på att skatteindrivaren ska undersöka husen.";
"T_GAME_QUEST_SCEN9_9_DESC" = "Sågverket har blivit saboterat, herre! Skatteindrivaren lyckades inte heller avslöja sabotörens identitet.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Du lyckades inte förhindra oroligheterna i tid!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Du misslyckades! På grund av din inkompetens blev jag tvungen att beställa mitt guld från en annan stad!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Guvernör, jag låter snart bygga en ny, stor flotta med krigsfartyg.\n\nDin stad har möjlighet att bli min största leverantör av trä för det här enorma projektet. Se till att den blir det.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Legosoldaten och hans gäng har flytt från regionen, guvernör. Mina män kommer att förfölja dem aggressivt.\n\nJag vill också tacka dig för ditt stöd i byggandet av min nya flotta och bjuda in dig till mitt nya flaggskepps jungfrufärd. Adjö tills dess...";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Stöd kungen i hans projekt.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Mycket bra! Du förhindrade oroligheter i staden!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Mycket bra! Du levererade precis i tid!";
"T_GAME_QUEST_SCEN_10_DESC" = "Våra riddare kommer att roa sig på de lokala krogarna när tornerspelen är över! Jag är dock orolig för att vi varken har tillräckligt med krogar eller druvsaft. Ta hand om det problemet omedelbart!";
"T_GAME_QUEST_SCEN_10_NAME" = "Uppnå hög nöjdhet med krogen.";
"T_GAME_QUEST_SCEN_11_DESC" = "Utmärkt, härskare! Staden är nästan redo, men jag och mina döttrar är inte det! Jag behöver de mest magnifika kläderna som dina skräddare kan sy!";
"T_GAME_QUEST_SCEN_11_NAME" = "Betala 35 klädesplagg i tribut.";
"T_GAME_QUEST_SCEN_12_DESC" = "Vi närmar oss tornerspelens öppnande, men jag vill inte se några sura miner i staden! Du bör se till att stadsborna är nöjda!";
"T_GAME_QUEST_SCEN_12_NAME" = "Uppnå hög lycka.";
"T_GAME_QUEST_SCEN_1_DESC" = "Välkommen, min gode härskare! Som ni säkert vet så planerar jag att ordna regionens största tornerspel! Jag förväntar mig att du bygger minst tre tornerspelsplatser för det här evenemanget. Gör mig inte besviken!";
"T_GAME_QUEST_SCEN_1_NAME" = "Bygg tre tornerspelsplatser.";
"T_GAME_QUEST_SCEN_2_DESC" = "Tornerspelens gäster kommer garanterat att bli hungriga! Jag vill att du omedelbart börjar producera bröd och levererar det som tribut till din kung!";
"T_GAME_QUEST_SCEN_2_NAME" = "Leverera 25 limpor bröd i tribut.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Bygg en väderkvarn och producera mjöl.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "Bygg två bagerier och producera bröd.";
"T_GAME_QUEST_SCEN_3_DESC" = "Herre, vi borde inte låta kungen vänta! Vi behöver vete och mjöl för att börja producera bröd!";
"T_GAME_QUEST_SCEN_3_NAME" = "Bygg en gård och odla vete.";
"T_GAME_QUEST_SCEN_4_DESC" = "Mycket bra, min gode härskare! Men det räcker inte med bröd för att tillfredsställa våra gäster! Jag kräver färsk fisk som tribut till din kung!";
"T_GAME_QUEST_SCEN_4_NAME" = "Leverera 25 fiskar i tribut.";
"T_GAME_QUEST_SCEN_5_DESC" = "Jag vill att tornerspelen ska bli oförglömliga! Våra riddare ska bära gyllene lansar och våra tornerspelsplatser ska blänka! Gör mig en tjänst och samla in skatt åt din kung!";
"T_GAME_QUEST_SCEN_5_NAME" = "Betala 1 000 daler i tribut.";
"T_GAME_QUEST_SCEN_6_DESC" = "Jag är säker på att våra gäster skulle njuta av den härliga smaken av vår färskpressade druvsaft! Gå och bygg saftanläggningar! Du kan till och med servera de lågkvalitativa resterna på de lokala krogarna!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Jag är säker på att våra gäster skulle njuta av den härliga smaken av vår färskpressade druvsaft!";
"T_GAME_QUEST_SCEN_6_NAME" = "Bygg en saftanläggning och tillverka saft.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Bygg ett väveri och tillverka tyger.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Bygg ett skrädderi och tillverka kläder.";
"T_GAME_QUEST_SCEN_7_DESC" = "Våra riddares vapenrockar är gamla och bleka, och det misshagar mig, härskare! Gå och skaffa nya! Bygg fårhagar, anlita en vävare och bygg ett skrädderi om du vill behålla ditt jobb!";
"T_GAME_QUEST_SCEN_7_NAME" = "Bygg två fårhagar.";
"T_GAME_QUEST_SCEN_8_DESC" = "Vi borde sälja fler varor mot pengar, herre. Det är alltid en bra idé att ha daler tillgängliga för att täcka eventuella framtida utgifter.";
"T_GAME_QUEST_SCEN_8_NAME" = "Tjäna 500 daler genom handel.";
"T_GAME_QUEST_SCEN_9_DESC" = "Jag ser att saker och ting går bra, men din stad är fortfarande ganska ful! Jag vill ha fontäner och vita stenväggar och vintergröna träd och praktfulla statyer! Du borde försköna staden med fler dekorationer!";
"T_GAME_QUEST_SCEN_9_NAME" = "Öka dekorationslyckan.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "Till en början rekommenderas du att tilldela en arbetare till en av skogshuggarstugorna i området.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Tilldela en arbetare till skogshuggarstugan.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "En av huvuduppgifterna är att bygga en marknadsplats.\nFör att slutföra det här uppdraget måste du etablera flera produktionskedjor för resurser och samla in de nödvändiga resurserna, herre.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Bygg en marknadsplats.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Herre, jag rekommenderar att du tilldelar en stadsbo till sågverket så att vi kan börja producera plankor så snart som möjligt.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Tilldela en arbetare till sågverket.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Herre, jag skulle rekommendera att du byter till att bryta sten istället för malm.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Så fort du har skaffat lite plankor och trä måste du tilldela en arbetare till gruvan och börja bryta sten.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Mycket bra, herre. Nu är det bara att vänta tills marknadsplatsen har byggts.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Tilldela en arbetare till gruvan.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "Din andra huvuduppgift är att bygga en krog.\n\nVi borde börja uppföra byggnaden direkt.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Bygg en krog";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Goda nyheter, herre. Några stadsbor har anlänt för att hjälpa oss med vår uppgift. Du borde bygga ett småstadshus åt dem.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Bygg ett småstadshus.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Vi behöver en verktygssmedja för att kunna bygga krogen. Jag rekommenderar att du börjar med att bygga en kolmila.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Bygg en kolarstuga.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Nästa byggnad vi behöver är ett smältverk. Med den kan vi börja tillverka järntackor.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Bygg ett smältverk.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Herre! För att börja tillverka verktyg behöver vi en verktygssmedja i staden.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Bygg en verktygssmedja.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Mattillgången börjar bli dålig, herre. Du borde verkligen beordra en stadsbo att fånga lite fisk eller jaga vilt. Om stadsborna inte får mat snabbt blir de mindre produktiva.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Producera lite mat.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Herre, jag är en ödmjuk köpman som står till din tjänst. Jag kan se att du är i behov av mynt till dina byggprojekt.\nJag kan köpa lite järnmalm av dig om du vill.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Handla lite varor med köpmannen.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Fick du slut på pengar, furste? Inga problem. Jag är villig att köpa några djurhudar av dig.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Guvernör, jag behöver lite guldklimpar. Kan du tänka dig att sälja några till mig?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Herre, jag mår inte så bra. Jag borde träffa en läkare.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Bota de sjuka stadsborna.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Det brinner! En stadsbo borde släcka elden omedelbart.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Släck elden.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Banditerna retar oss även här. Herre, vi borde tilldela några stadsbor till vakttornen tills vi har försvarat oss mot attacken.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Försvara staden mot banditerna.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Herre, kan vi vila lite och äta ett litet mellanmål?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Baka lite bröd.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Herre, vi har bara några få stadsbor för den här utmaningen. Vi borde tilldela dem till och byggnader och andra platser efter vad som är lämpligt.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Grattis! Du har klarat den här utmaningen.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Använd stadsborna klokt för att lösa alla uppgifter.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "Goda nyheter, herre. Det växer redan upp nya träd växer på halvön intill slottet.\n\nJag föreslår att vi bygger skogshuggarstugor där borta för att få tag i trä lättare.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Herre, alla skogshuggarstugor är förfallna och övergivna!\n\nTräden i det här området har redan huggits ned. Jaktstugorna är inte till någon nytta längre. \nJag rekommenderar dig att riva alla byggnader som inte behövs längre för att få lite trä.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Riv skogshuggarstugorna.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Herre, jag antar att du borde fråga folket i den här byn. De kanske har lite ved över.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Kungen väntar på den första leveransen med plankor.\n\nVi skulle kunna tilldela en stadsbo till sågverket och börja tillverka plankor. Jag råder dig att hålla ett öga på lagret med trä. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Tilldela en stadsbo till sågverket.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Hur går det, guvernör? Jag förväntar mig totalt tre leveranser.\n\nDu bör förbereda den första leveransen så snart som möjligt. Gör mig inte besviken!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Leverera varorna till kungen.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Herre, kungen var nöjd med den första leveransen med plankor.\nVi borde göra nästa leverans klar så snart vi kan.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Kungen väntar på den sista leveransen. När han har fått plankorna kan den kungliga flottan utökas avsevärt.\n\nVi borde sätta igång.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Undrar du varför din kung inte har leveransen ännu? Jag tror att jag har svaret.\n\nFör att hålla mig kort – betala mig en liten lösensumma så kommer din leverans att nå kungen utan ytterligare avbrott.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Betala lösensumman.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Byggandet av den kungliga flottan kräver massor med plankor.\nTyvärr har det inte kommit några leveranser på länge.\n\nGuvernör, jag har en uppgift till dig! Ta reda på varför leveranserna slutade komma fram och lös problemet!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "Bra jobbat, guvernör. Jag visste att jag kunde lita på dig.\n\nTack vare dina insatser blir flottan klar på nolltid.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Sätt stopp för träbristen och leverera tillräckligt med plankor till kungen.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Herre, jag föreslår att vi använder träet klokt!\n\nVi skulle kunna bygga en marknadsplats så att vi kan köpa trä från köpmännen.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Behöver du trä? Jag tror att vi lätt kan förhandla fram ett avtal som vi båda är nöjda med. Det finns en liten hög med trä tillgänglig direkt om du vill ha den.\n\nKom och köp så mycket du behöver!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Köp trä av köpmannen.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Herre, du kommer att behöva leveranser med trä regelbundet.\n\nOm du bygger ett handelsgille så kan du skapa handelsordrar.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Bygg ett handelsgille.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "I handelsgillet kan du skapa handelsordrar för köp och försäljning.\n\nSkapa en handelsorder för trä, herre.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Utmärkt! Så länge du har mynt att betala med så genomför jag alla dina ordrar.\n\nDina handelsordrar kommer att skötas tills du avbryter dem.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Skapa en handelsorder för att köpa trä.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "En brand har brutit ut i staden! Vi måste bygga tillräckligt med brandvaktstorn för att släcka branden och minska risken för nya bränder.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "Se till att brandvaktstornen täcker 80 %.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Banditer! De försöker förstöra våra byggnader. Vi behöver fler soldater i staden för att driva bort banditerna, och vi borde bygga fler vakttorn.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Bygg tillräckligt med vakttorn och säkra staden med tillräckligt med soldater.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Ännu en smitta! En så här stor stad behöver en sjukstuga till.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Ännu en smitta! En så här stor stad behöver en sjukstuga till.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Bygg en sjukstuga och bota sjukdomen.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Herre, inte alla stadsbor kan besöka kyrkan eftersom den alltid är full.\n\nVi behöver fler kyrkor för att göra alla stadsbor nöjda.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Herre, stadsborna måste vänta för länge på sina drycker. Vi behöver fler krogar, och vi måste öka produktionen av saft och brygd.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Det finns ingen underhållning i den här staden. Vi borde bygga en tornerspelsplats.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Stadsborna är nöjda. Men nu vill de ha lyxvaror.\n\nVi kan ge dem tillgång till kläder eller smycken.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "En del av stadsborna klagar över att marknadsplatsen är för trång.\n\nVi borde bygga en ny marknadsplats eller uppgradera den som finns. Annars kommer de olyckliga stadsborna att lämna staden.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Du gör mig besviken, guvernör. Det är synd att du inte lyckades utföra alla mina uppgifter.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Utmärkt, guvernör! Du slutförde alla mina uppgifter utan att en enda stadsbo lämnade staden.\n\nJag dubblar din belöning.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Guvernör, några av stadsborna lämnade staden. Jag hade väntat mig mer av dig.\n\nMen du slutförde åtminstone alla mina uppgifter. Du ska få din belöning.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Herre, vi måste få fler invånare till vår stad, annars blir kungen väldigt arg.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Åh nej, herre. Många stadsbor har redan lämnat staden. Vi kan inte låta fler flytta ut.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Öka befolkningen.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Herre, några stadsbor har redan lämnat staden. Vi måste ta bättre hand om våra stadsbor så att de inte flyttar.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Guvernör, många stadsbor har flyttat till den här lilla staden.\n\nGör dem nöjda med allt de vill ha för att uppmuntra dem att stanna kvar. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Öka befolkningen innan tiden tar slut.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Slutför alla uppgifter innan kungens anländer, och håll befolkningen över 150.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Alla transportörer i den här staden är överarbetade, herre. Vi borde bygga ett nytt lager och utse fler transportörer.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Bygg ett nytt lager och tilldela fler transportörer till slottet.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Vi har ont om mat. Låt oss bygga en ny fiskarstuga. Det borde hjälpa.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Herre, det lilla bageriet kan inte baka tillräckligt med bröd. Vi kan uppgradera det och utse en till bagare.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Uppgradera ett bageri till nivå 2 och utse en till bagare.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Behovet av vatten har ökat avsevärt. Vi kan förse alla stadsbor med vatten genom att bygga tillräckligt med brunnar.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Bygg flera brunnar i staden.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Herre, vi borde öka våra matlager. En ny jaktstuga eller en slaktarbod är precis vad vi behöver.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Bygg en jaktstuga eller en slaktarbod.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Utmärkt, herre. Vi har etablerat en god försörjning. Men vi borde fortsätta hålla ett öga på våra stadsbors önskemål.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Herre, vi borde börja med att skaffa lite byggmaterial och tilldela en stadsbo till skogshuggarstugan på andra sidan floden.\n\nBygg en kullerstensväg över floden så att stadsbon kan börja arbeta.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Bygg en kullerstensväg över floden och tilldela en stadsbo till skogshuggarstugan.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Bygg en väg över floden och tilldela en stadsbo till skogshuggarstugan.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Att flytta hit var mitt största misstag någonsin. Jag tänker inte stanna kvar!\n\nHerre, du borde verkligen uppfylla våra önskemål, annars kommer fler och fler stadsbor att flytta härifrån.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Nej, tack.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Det är en utmärkt idé.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Jag trodde att du hade ett progressivt sätt att tänka... Okej, håll dig till din medelmåttighet, då.";
