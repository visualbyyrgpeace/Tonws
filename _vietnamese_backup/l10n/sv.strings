"T_GAME_TUTORIAL_QUEST_NAME_5" = "Samla in 40 daler i skatt.";
"T_GAME_TUTORIAL_QUEST_NAME_6" = "Bygg ett sågverk, men använd funktionen "bygg direkt" den här gången!";
