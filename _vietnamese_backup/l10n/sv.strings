"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_2" = "Ta bort en arbetare från en byggnad!";
"T_GAME_TUTORIAL_QUEST_NAME_DEASSIGN_3" = "Stoppa sågverkets produktion genom att ta bort arbetaren.";
