"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Vi försöker ge resurserna till den där usla magikern!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "Vi skaffade fram alla resurser han bad om. Det enda vi behöver göra nu är att leverera varorna till den angiven platsen.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Du bestämmer dig för att gillra en fälla åt magikerna. Så fort de kommer för att hämta varorna blir de fångade i ett nät! Det är bara att hoppas att din geniala idé är effektiv.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Sir! Vi lyckades fånga en till magiker!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Du har två vakter utplacerade nära resurserna. De andra två magikerna dyker upp och närmar sig sakta för att hämta resurserna. När de är halvvägs aktiverar dina vakter fällan.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Ge inte efter.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Så du vill väcka mina bröders vrede. Jag skulle inte vilja vara i dina kläder, guvernör.";
