"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_NAME" = "Bygg fler gruvor.";
"T_SCENARIO_2016_06_QUEST_SIDE_025_DESC" = "Min fru vill be för oss så att inga laviner orsakar skada. Skulle du kunna bygga en kyrka åt oss?";
"T_SCENARIO_2016_06_QUEST_SIDE_02_DESC" = "Herre, jag vet att vi behöver mycket trä för återuppbyggandet, men min familj har ingen ved och det börjar bli väldigt kallt. Du kanske kan hjälpa oss?";
"T_SCENARIO_2016_06_QUEST_SIDE_03_DESC" = "Det är väldigt svårt att gå genom snön. Lite kullerstensvägar vore skulle vara väldigt praktiskt.";
"T_SCENARIO_2016_06_QUEST_SIDE_045_DESC" = "Guvernör, vi kan inte odla vete i den här regionen. Men vi kan köpa bröd på marknaden. Eller så kan vi bara köpa vete och baka eget bröd.";
"T_SCENARIO_2016_06_QUEST_SIDE_04_DESC" = "Alltid bara fisk och kött. Herre, kan vi inte äta lite bröd som omväxling?";
"T_SCENARIO_2016_06_QUEST_SIDE_04_NAME" = "Uppfyll dina stadsbors önskemål.";
"T_SCENARIO_2016_06_QUEST_SIDE_05_DESC" = "Våra kläder slits hårt av de det här hårda vädret. Vi behöver verkligen nya kläder.";
"T_SCENARIO_2016_06_QUEST_SIDE_06_DESC" = "De där rostiga verktygen håller på att falla sönder. Jag antar att du behöver järnet, men om du använde en del av det till att göra nya verktyg så skulle det verkligen hjälpa oss.";
"T_SCENARIO_2016_06_QUEST_SIDE_07_DESC" = "I den här snöiga regionen är vi glada över minsta lilla sak. Herre, skulle du kunna försköna vår stad lite, om du inte är för upptagen?";
"T_SCENARIO_2016_10_BANDIT_01_DESC" = "Mannar! Till attack!";
"T_SCENARIO_2016_10_BANDIT_04_DESC" = "Letar du efter köpmannen? Han gick vilse och hamnade på något sätt bunden i mitt läger. Men oroa dig inte, han mår bra. Ge oss bara en liten donation så blir han fri igen.";
"T_SCENARIO_2016_10_BANDIT_04_END" = "Okej, vi släpper köpmannen. Handla med honom, så får jag mer att stjäla.";
"T_SCENARIO_2016_10_BANDIT_04_NAME" = "Betala lösensumman för att befria köpmannen.";
"T_SCENARIO_2016_10_BANDIT_END_DESC" = "Banditer! Vi sticker! Vi kallar det en taktisk reträtt. Vi har stulit tillräckligt ändå.";
"T_SCENARIO_2016_10_BANDIT_TIMER_10_DESC" = "Förstörde du just ett av våra läger? Det tar vi som en utmaning. Attackera staden, mannar!";
"T_SCENARIO_2016_10_HAPPYNESS_DESC" = "Åh nej, herre. Stadsborna är olyckliga och vill inte betala skatt. Vi borde uppfylla deras önskemål för att börja få in skatt igen.";
"T_SCENARIO_2016_10_HAPPYNESS_NAME" = "Öka lyckan för att börja få in skatt igen.";
"T_SCENARIO_2016_10_MAIN_00_DESC" = "Guvernör, jag behöver massor av mynt. Etablera en blomstrande ekonomi och betala tribut. Men var försiktig! Det finns mycket banditer i området. Hela riket räknar med dig.";
"T_SCENARIO_2016_10_MAIN_00_END" = "Mycket bra gjort, guvernör. Jag visste att jag kunde lita på dig. Du kommer att bli belönad och få gott rykte.";
"T_SCENARIO_2016_10_NEED_BREAD_DESC" = "Herre, vårt brödlager börjar ta slut. Det gör folk olyckliga.";
"T_SCENARIO_2016_10_NEED_BREAD_NAME" = "Ha tillräckligt med bröd för att öka lyckan.";
"T_SCENARIO_2016_10_NEED_BREW_DESC" = "Missnöjet sprider sig, herre. Folket längtar efter brygd.";
"T_SCENARIO_2016_10_NEED_BREW_NAME" = "Ha tillräckligt med brygd i lager för att förhindra att stadsborna strejkar.";
"T_SCENARIO_2016_10_NEED_CARPENTER_DESC" = "Snickaren har mycket jobb att ta tag i. Det är många byggnader som måste repareras, furste. Jag råder dig att bygga fler snickarverkstäder.";
"T_SCENARIO_2016_10_NEED_CARPENTER_NAME" = "Bygg en snickarverkstad för att öka lyckan.";
"T_SCENARIO_2016_10_NEED_CLOTHS_DESC" = "Jag har inget att ha på mig. Vi behöver mer kläder och klänningar.";
"T_SCENARIO_2016_10_NEED_CLOTHS_NAME" = "Ha tillräckligt med kläder i lager för att öka lyckan.";
"T_SCENARIO_2016_10_NEED_FIREWATCH_DESC" = "Herre, brandvaktstornen täcker inte tillräckligt med byggnader. Vi borde bygga fler brandvaktstorn.";
"T_SCENARIO_2016_10_NEED_FISH_DESC" = "Vi har inte ens tillräckligt med fisk i byn. Jag tänker inte betala nån skatt!";
"T_SCENARIO_2016_10_NEED_FISH_NAME" = "Ha tillräckligt med fisk i lager för att minska risken för en strejk.";
"T_SCENARIO_2016_10_NEED_JEWELRY_DESC" = "Jag vill överraska min fru med lite smycken. Synd att det inte finns några i den här staden.";
"T_SCENARIO_2016_10_NEED_JEWELRY_NAME" = "Ha tillräckligt med brygd i lager för att förhindra en strejk av stadsborna.";
"T_SCENARIO_2016_10_NEED_JOUSTING_DESC" = "Det finns inte mycket att göra i stan. Det finns inte tillräckligt med underhållning. Jag tycker att det är dags att bygga fler nöjesbyggnader.";
"T_SCENARIO_2016_10_NEED_JUICE_DESC" = "Jag känner törst efter saft. Kan du se till att det finns saft igen?";
"T_SCENARIO_2016_10_NEED_JUICE_NAME" = "Fyll på med saft för att öka lyckan och förhindra en strejk.";
"T_SCENARIO_2016_10_NEED_MEAT_DESC" = "Återigen finns det inget kött att få i stan. När får vi mer?";
"T_SCENARIO_2016_10_NEED_MEAT_NAME" = "Ha tillräckligt med kött för att öka lyckan och förhindra en strejk.";
"T_SCENARIO_2016_10_NEED_MEDICUS_DESC" = "Guvernör, med så många människor här i stan kan jag inte ta hand om alla. Jag behöver hjälp om jag ska klara av att ta hand om alla.";
"T_SCENARIO_2016_10_NEED_MEDICUS_NAME" = "Bygg en sjukstuga för att förhindra en strejk i staden.";
"T_SCENARIO_2016_10_NEED_TAVERN_DESC" = "Det finns ingen plats i vår krog. Det är alldeles för trångt. Den nya guvernören slösar bort våra pengar istället för att spendera dem på våra behov.";
"T_SCENARIO_2016_10_QUEST_00_DESC" = "Herre, vi borde börja med att bygga de grundläggande byggnaderna för vår ekonomi. Jag rekommenderar en till fiskarstuga och ett sågverk.";
"T_SCENARIO_2016_10_QUEST_00_NAME" = "Bygg ett sågverk och en fiskarstuga.";
"T_SCENARIO_2016_10_QUEST_01_DESC" = "Vi kan bygga en gruva i närheten för att samla in resurser snabbt.";
"T_SCENARIO_2016_10_QUEST_01_NAME" = "Bygg en gruva.";
"T_SCENARIO_2016_10_QUEST_02_DESC" = "Nu ber folk om bröd. Vi kan antingen baka det själva eller köpa det på marknaden. Vi bör dock se till att alltid ha tillräckligt med bröd.";
"T_SCENARIO_2016_10_QUEST_02_NAME" = "Ha tillräckligt med bröd.";
"T_SCENARIO_2016_10_QUEST_03_DESC" = "Vi får inte ens någon brygd. Vad betalar jag skatt för om vi inte kan något så enkelt som brygd att dricka?";
"T_SCENARIO_2016_10_QUEST_03_NAME" = "Ha tillräckligt med brygd i lager.";
"T_SCENARIO_2016_10_QUEST_04_DESC" = "Herre, folk tycker om att äta olika sorters mat. Det räcker inte med bara fisk och bröd, folk vill ha kött också.";
"T_SCENARIO_2016_10_QUEST_04_NAME" = "Se till att det finns tillräckligt med kött i lager.";
"T_SCENARIO_2016_10_QUEST_05_DESC" = "Det vore fantastiskt att ha mer än bara en klänning. Snälla, herr guvernör?";
"T_SCENARIO_2016_10_QUEST_05_NAME" = "Skaffa ett lager med kläder.";
"T_SCENARIO_2016_10_QUEST_06_DESC" = "Eftersom staden växer slår sig fler och fler aristokrater ner här. De vill dricka saft.";
"T_SCENARIO_2016_10_QUEST_06_NAME" = "Ha tillräckligt med saft i lager.";
"T_SCENARIO_2016_10_QUEST_07_DESC" = "En underbar stad. Men det saknas lyxvaror. Skulle du kunna se till att erbjuda smycken?";
"T_SCENARIO_2016_10_QUEST_07_NAME" = "Ha smycken i lager.";
"T_SCENARIO_2016_10_QUEST_10_DESC" = "Stadsborna kräver en kyrka.";
"T_SCENARIO_2016_10_QUEST_11_DESC" = "Vi behöver en krog för att göra folk lyckligare, herre.";
"T_SCENARIO_2016_10_QUEST_12_DESC" = "Herre, vi borde bygga en nöjespark till folket.";
"T_SCENARIO_2016_10_QUEST_13_DESC" = "Vårt folk oroar sig för brandsäkerheten. Vi borde bygga ett brandvaktstorn.";
"T_SCENARIO_2016_10_QUEST_14_DESC" = "Guvernör, finns det en kompetent doktor i staden?";
"T_SCENARIO_2016_10_QUEST_14_NAME" = "Bygg en sjukstuga.";
"T_SCENARIO_2016_10_QUEST_15_DESC" = "Vi borde bygga en tornerspelsplats för att öka vårt folks lycka.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "Herre, staden växer ordentligt. Vi bygga en snickarverkstad för att hålla alla byggnader i gott skick.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "Om vi inte gör något åt banditerna kommer de att ta ifrån oss alla våra hem och tillhörigheter.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "Vi har redan lite soldater. Jag hoppas att vi kan försvara staden mot banditens attacker.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "Herre, det är dags att sätta banditerna på plats och förvisa dem härifrån.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "Det behövs visst lite tydligare åtgärder. Nu strejkar staden!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "Dina stadsbor strejkar. Vänta tills de har lugnat sig.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "Herre, vilken underbar dag det är, eller hur?\n\nJag kom för att fråga om det vore möjligt att se till att staden är tillräckligt fint dekorerad för festligheterna.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "Höj tillfredsställelsen med dekorationer i staden.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "Du gjorde ett fantastiskt jobb med de nya dekorationerna, herre. Staden ser strålande ut!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "Herre, arbetarna som förbereder festen är mycket irriterade över bristen på underhållning mellan festligheterna. Jag hörde flera av dem säga att de skulle vilja ha ett jonglörläger.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "Bygg ett jonglörläger.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "Store herre! Arbetarna fortsätter med förberedelserna inför festligheterna igen. De är fulla av glädje eftersom det nu finns ett jonglörläger i stan.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "Åskvädren skadar staden enormt. Vi borde se till att alla byggnader är tillräckligt reparerade, herre. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "Öka nöjdheten med byggnadernas skick.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "Stora herre! Nu är byggnaderna i mycket gott skick igen.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "Herre! Ett fruktansvärt åskväder blåser in över staden. Du borde sätta dig i säkerhet i slottet. Blixten har redan slagit ned i flera byggnader...";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "Får jag ta upp ett ögonblick av din tid, herre?\n\nMed alla de här förberedelserna... Ni bör inte glömma vad den här festligheten handlar om... Den kan inte ske förrän skörden är klar, herre!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "Slutför druvskörden.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "Vilken underbar syn, furste! Skörden har avslutats och förberedelserna för festligheten är också nästan klara. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "Herre, tiden är ute nu. Det är för sent för festivalen. Kungen kommer inte att bli glad över det här...";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "Utmärkt, furste!\n\nFörberedelserna för festligheten är klara. Vi väntar bara på ditt beslut om att starta festen.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = "Genom kungligt dekret beordrar jag er att hålla ett år av festligheter. Varje årstid vill jag att du arrangerar en festival för att hedra min nya fru!\n\nSätt nu igång med förberedelserna! Gör mig inte besviken…";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "Jag är verkligen besviken på dig, guvernör!\n\nAtt ordna lite festligheter var en väldigt enkel uppgift, men du misslyckades ändå! Var det för mycket begärt? Försvinn ur min syn!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "Ordna alla festligheter i tid!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "Guvernör! Det här var ett fantastiskt år av festligheter.\n\nDu bevisade att jag kan lita på dig när jag har en svår uppgift.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "Vilken trevlig festival det var, furste!\n\nMen nu måste vi se till att höstfestivalen arrangeras som planerat, och innan vintern börjar! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "Arrangera höstfestivalen innan vintern börjar.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "Vi måste skynda oss för att hinna förbereda vårfesten i tid, furste.\n\nFestivalen måste bli klar innan sommaren börjar, och vi har inte mycket tid.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "Arrangera vårfestivalen innan sommaren börjar.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "Vilken trevlig festival det var, furste!\nMen nu måste vi se till att sommarfestivalen arrangeras som planerat, och innan hösten börjar!\n\nVi har inte hur mycket tid som helst!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "Arrangera sommarfestivalen innan hösten börjar.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "Vilken trevlig festival det var, furste!\n\nMen nu måste vi se till att vinterfestivalen arrangeras som planerat och avslutas innan våren börjar! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "Arrangera vinterfestivalen innan våren börjar.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "Herre, jag rekommenderar att vi bygger en nöjespark så snart som möjligt. Alla festivaler kommer att hållas där.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "Bygg en nöjespark.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "Bra, furste! Området för festligheterna är klart. Den här byggnaden är mycket viktig för det här projektet, så vi bör hålla ett öga på den.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "Herre, vi borde bygga en nöjespark för festligheterna! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "Det första vi behöver är en ordentlig majstång, furste. Skogshuggaren kan hugga ett träd som passar för det. Men han kommer att behöva hugga ner många träd för att hitta ett som är perfekt.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "Samla trä till majstången.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "Vår majstång måste dekoreras ordentligt. För det behöver vi tillräckligt med tyg, herre.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "Producera tyg till majstången.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "Vilken fin majstång! Visste du att det är tradition för mina bröder att stjäla majstängerna i området varje år?";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "Hahaha! Nu är din majstång vår! Den blir en bra dekoration framför vårt banditläger. Kom och försök ta tillbaka den om du kan...";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "Skydda majstången från banditernas attacker!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "Tusan också! Vi fick nästan den där majstången. Du försvarade den väl, guvernör!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "Herre! Det ligger ett banditläger utanför staden. Vi behöver fler män och ytterligare ett vakttorn för att säkra byn.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "Bygg ett till vakttorn och tilldela tillräckligt många soldater.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "Mycket bra! Nu kan våra soldater försvara nöjesparken mycket lättare när banditerna attackerar!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "Majstången har blivit stulen från vårt lager. Vi måste attackera banditlägret och ta tillbaka majstången för att vara säkra på att festivalen kan starta i tid.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "Attackera banditlägret och ta tillbaka majstången!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "Seger! Majstången håller på att bäras tillbaka till vårt lager i denna stund, herre.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "Herre! Gården brinner! Snälla, du måste göra något!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "Det är katastrof, guvernör! Gården har brunnit ner och skörden är förstörd...";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "Rädda gården!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "Jag är dig evigt tacksam, furste!\n\nMen elden har förstört skörden! Festligheterna kanske ändå måste ställas in om vi inte skördar åkrarna i tid.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "Min familjs gård har brunnit ner, herre! Jag kommer aldrig hinna baka årets första bröd i tid till festivalen. Skulle du kunna beordra att gården ska byggas upp igen?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "Bygg en ny gård.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "Tack, herre.\n\nUtan dig skulle jag vara ruinerad och sommarfesten hade kanske blivit inställd!\n\nMen vi måste skynda oss för att hinna skörda vetet i tid!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "Herre, vi måste ta hand om skörden nu. Det är ett tag kvar tills festivalen börjar. Vi måste se till att tillräckligt med vete hinner skördas.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "Slutför veteskörden.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "Det är väldigt varmt nu för tiden, furste. Jag hoppas att det inte blir en ny brand eller torka som hotar festligheterna. Men nu har vi tillräckligt med vete för festen. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "Herre, mina fält är så torra att jag tror att vi får torka igen i sommar. Skulle du kunna bygga ett par brunnar för att vattna fälten?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "Bygg flera brunnar för att vattna fälten.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "Bra gjort, furste! Fälten har vattnats. Nu är det bara att vänta tills vetet börjar växa igen.\n\nJag hoppas att det inte tar för lång tid...";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "Festen kan börja när vi har bakat färdigt skördens första bröd, furste. Skulle du kunna se till att brödet bli klart i tid?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "Baka tillräckligt med bröd till sommarfestivalen.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "Fantastiskt, furste. Det finns tillräckligt med bröd till festivalen!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "Herre! Det är fortfarande något som saknas till festivalen... Vi behöver brygd! Du borde låta bygga ett klosterbryggeri så att munkarna kan göra lite brygd!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "Gör brygd till sommarfestivalen.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "Mycket bra, furste. Den här brygden är riktigt god och uppfriskande en varm sommar som den här.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "Jag har en fantastisk idé till vinterns festlighet, furste. På mina resor kom jag i kontakt med ett speciellt vintervin som kallas glögg. Det vore en perfekt dryck till vinterfesten.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "Leverera ingredienserna till glögg.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "Perfekt, furste. Nu har vi alla ingredienser till glöggen. Jag börjar genast förbereda den.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "Herre, jag vill fråga om träddekorationerna. Det vore väldigt trevligt att ha lite dekorationer av guld.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "Tillverka guldklimpar som dekoration.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "Magnifikt, herre. Den här utsmyckningen är verkligen vacker. Jag tackar dig för att du använder din dyrbara till de här träddekorationerna. Jag tror att det här blir en underbar festival.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "Jag och grabbarna vill anordna en julpjäs till festivalen. Tyvärr saknar vi en del avgörande resurser till pjäsen. Skulle du kunna ge oss de saker vi behöver?";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "Förbered resurserna till julpjäsen.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "Tack, furste. Nu kan vi börja tillverka våra kostymer till julpjäsen.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "Herre, jag tänkte på pepparkakor till festen. Men resurserna som behövs kan vara svåra att få tag på.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "Leverera ingredienserna till pepparkakor.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "Utmärkt, furste. Jag ska börja baka pepparkakorna direkt.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "Den här tiden på året borde vi inte glömma de behövande. Därför samlar jag in pengar till de fattiga. Det vore riktigt snällt av dig om du kunde donera lite av stadens skatteintäkter till vårt goda ändamål.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "Samla in tillräckligt med skatter till de fattiga.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "Tack för din generösa donation, furste!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "Guvernör,\nJag beklagar, men jag inte kan besöka din stad för tillfället.\nDet finns banditer i skogen runt din stad. Det är för farlig för resande köpmän just nu.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "Stort tack, furste. Nu när banditerna har drivits bort från området kommer jag att besöka din stad regelbundet igen.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "Kyrkan har rasat, furste. I tider som de här behöver vi allt stöd vi kan få. Vi behöver en ny kyrka i staden.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "Guvernör, det pågår något konstigt i den här staden. Vi har drabbats av sju katastrofer bara den här säsongen! Vi måste ta reda på vad som händer här. Jag tror att vi har en förbannelse över oss.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "Vi borde lämna staden omedelbart, herre. Allt är förlorat... Vi är dömda! Förbannelsen kommer aldrig att hävas.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "Hitta ett sätt att ta häva förbannelsen.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "Du räddade staden! Det är underbara nyheter. Förbannelsen är äntligen hävd och du lyckades till och med överleva ritualen.\n\nStaden kommer att behöva lite tid för att återhämta sig...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "Staden behöver jämn tillgång till medicinalväxter så snart som möjligt, herre. Annars kommer pesten att vara ett ständigt hot mot vår stad.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "Producera medicinalväxter.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "Vi kommer aldrig att övervinna pesten utan att bygga minst en sjukstuga, herre. Jag skulle till och med rekommendera fler.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "Läkarna i staden behöver mer material till bandage för att kunna behandla de pestsmittade på rätt sätt. Du borde skicka lite tyg till dem.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "Herre, staden har drabbats av pesten! Tyvärr kommer inga köpmän att besöka oss så länge de här katastroferna inträffar...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "Vi behöver en väderkvarn för att bearbeta vetet till mjöl, herre. I dessa svåra tider måste vi anpassa vår matproduktion, furste!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "För att producera bröd måste vi låta bygga ett bageri, herre.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "Nu är det dags att skaffa ett lager med bröd. Vi måste se till att staden har mat. Det sista vi behöver är en svältande befolkning.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "Herre, boskapen... fiskarna i floden och alla djur... de dör! Vad är det som händer här?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "Kyrkan brinner, guvernör! Herren har övergivit oss! Du måste hjälpa oss...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "Jag gjorde lite efterforskningar i kyrkan och hittade dokument som kan hjälpa oss, furste.\n\nMen nu är kyrkan osäker att gå in i och jag kan inte få tag i mina dokument.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "Tack, furste. Ta en titt på de här dokumenten. En gång i tiden låg det en gammal kyrkogård där vår enkla stad står nu.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "En gång fanns det en speciell rådgivare vid hovet. Han var spåman, men han förstod sig på hednisk magi. Han blev galen och försökte förgifta kungen, så han sattes i fängelse.\n\nJag ska kontakta kungen. Han kanske låter oss prata med mannen.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "Reparera kyrkan.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "Kungen kommer inte att hjälpa oss. Vi måste ta saken i egna händer och befria spåmannen.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "Herre! Stadsborna har panik! Vi måste visa upp lite militär närvaro för att lugna dem.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "Guvernör! Jag tänker inte släppa ut den där avskyvärda och förrädiska mannen ur fängelset. Jag bryr mig inte om din förbannelse. Den här mannen försökte döda mig. Han kommer att ruttna i fängelset.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "Tusan också, guvernör... Varför attackerar du oss? Jag vet att vi rånade dig massor av gånger, men det här...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "Vi såg förbannelsen själva, guvernör. Vi banditer kan inte råna rika köpmän när sånt händer i vårt område.\n\nVi kan hjälpa dig att få ut den där typen ur fängelset...";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "Det ligger ett banditläger nära vår stad, herre. Vi kanske kan "övertala" banditerna att hjälpa oss att frita spåmannen.\n\nHan måste ha svar! Beordra attacken mot lägret, för att inleda en liten... hrm... "förhandling".";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "Vilken fantastisk seger över banditerna, furste. Nu ska vi prata med dem...\n\nDe kanske hjälper att bryta förbannelsen.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "Det verkar vara himlens vrede, herre. Bönderna har berättat att det är torka!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "Förberedelserna för räden mot fängelset kan kräva lite militär utrustning, ordentliga träningsplatser och utrustning. Låt oss börja med en vapensmedja.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "Mina män behöver träna inför räden mot fängelset, guvernör. Om du verkligen vill genomföra det här så behöver vi en plats att träna på.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "Bygg en tävlingsplats för bågskytte.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "Guvernör, jag tror att det vore bra med något att äta och dricka. Åtminstone för den som leder räden – jag!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "Leverera proviant.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "Det är dags att skaffa lite utrustning, guvernör. De där träsvärden och träyxorna som vi brukar använda kommer inte att vara till någon nytta mot fängelsevakterna.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "Leverera militär utrustning.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "Herre, solen! Den håller på att förmörkas! Vi måste skynda oss annars är vi dömda!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "Utmärkt! Vi är nästan redo att frita den där typen från fängelset! Nästa gång vi träffas kan du prata med honom själv.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "Du kan övertyga mig genom att göra det värt mödan. Jag har inte ätit korv på väldigt länge.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "Okej, okej. Jag ska hjälpa dig. Din lilla förbannelse verkar vara riktigt otrevlig, men den kan brytas med en enkel ritual.\n\nVarför byggde du ens din stad på en urgammal kyrkogård från första början?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "Den goda nyheten är att förbannelsen kan hävas. Men vi behöver lite resurser som inte är lätta att få tag på.\n\nVi behöver en laddad kvartskristall, en tidlös trolldryck och en åskledare.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "Guvernör, som av en händelse "hittade" jag en av de där kvartskristallerna under en av mina räder. Tyvärr tog min kompis Råskinnet den när vi delade vårt gäng.\n\nHan har ett eget banditläger i området.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "Hämta den laddade kvartskristallen i banditlägret.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "Guvernör, åskledaren kan göras av vanliga järntackor och lite verktyg.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "Bygg åskledaren.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "Herre, jag kan förbereda trolldrycken om du skaffar de nödvändiga ingredienserna åt mig.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "Skaffa ingredienserna till trolldrycken.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "Nu måste du dricka trolldrycken samtidigt som du håller åskledaren i din vänstra hand och den laddade kvartsen i din högra. Sedan måste du stå på öppen mark tills en blixt slår ner i åskledaren.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "Utför ritualen.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "Du var den sista personen jag hade trott skulle frita mig från fängelset. Det var på grund av dig som hamnade jag där från första början!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "Det verkar som att du har lite problem med en förbannelse. Och nu vill du ha min hjälp?";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "Herre! Ett fruktansvärt åskväder är på väg mot vår lilla stad. Vi borde till att våra brandvaktstorn är vaksamma!";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "Guvernör, det är alldeles för farligt för mig att komma till din stad. Men jag kan ordna saker åt dig om du betalar...";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "Tycker du inte att soldaterna i stan slösar bort för mycket värdefulla resurser? Vi skulle lätt kunna sälja resurserna istället och tjäna lite pengar. Det enda du behöver göra är att se till att kvartermästaren är distraherad på något sätt.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "Ta bort kvartermästaren från kasernen.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "Ta bort transportörerna från slottet.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "Guvernör, mina pojkar behöver lite tid ostörda vid stadsmuren. Du vet, de gillar att vara ensamma när de "lagrar" varor utanför murarna. Det är viktigt att vakterna nära muren är någon annanstans.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "Ta bort alla soldater.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "Jag har ett litet problem med befolkningen i staden. Du förstår, vi hjälper dem genom att vara här, och de vill inte betala för våra vänliga tjänster. Förstår du?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "Samla in skyddspengar.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "Guvernör, tyvärr samlade du inte in tillräckligt med pengar för att täcka mina "utgifter" här i staden. Jag behöver resten av mina pengar. Vad sägs om att du "investerar" lite pengar själv?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "Min fraktion vill ordna en liten "halvlaglig" spelturnering på krogen ikväll. Vad sägs om att fixa lite underhållning till krogen och skicka över lite brygd och saft?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = "Mina "affärskompanjoner" vill ha lite lämplig mat under spelturneringen. Skicka över lite korv och bröd så att ingen behöver svälta, okej?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "Leverera korv och bröd.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "Guvernör, jag kommer till dig med en ny förfrågan. Mina hejdukar... öh... jag menar förstås "affärskompanjoner" behöver fler sätt att utöva påtryckningar för att kunna göra sitt jobb ordentligt. Vad sägs om att du skickar över lite vapen och rustningar, okej?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "Leverera vapen och rustningar.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "Mina "affärskompanjoner" vill ha lite underhållning, guvernör. Vi behöver en krog för att kunna koppla av lite. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "Välkommen, guvernör. Tack för att du tar dig tid att träffa mig. Jag är representant för den... öh... "skumma" fraktionen. Vi kan hjälpa dig att bli omvald, men först måste du utföra några uppgifter åt oss.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "Guvernör, du stöttade oss genom att slutföra våra uppgifter, och nu är det vår tur att visa lite uppskattning. \n\nDu hjälpte oss, och nu hjälper jag dig genom att ändra valresultatet till din fördel. ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "Slutför alla uppgifter åt den skumma fraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = "Välj den "skumma" fraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "Arbeta med klubben Blommornas vänner.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "Arbeta med köpmännens gille.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "Välj den militära fraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "Välj adelsfraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "Herre, du bör bestämma vilken fraktion du vill stödja. Efter ditt val bör du koncentrera dig på att uppfylla fraktionens krav. När den har övertygats om att rösta på dig så kan du välja en annan fraktion.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "Besök den religiösa fraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "Välj tjänarfraktionen.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "Besök småfolket.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "Den här staden är väldigt intetsägande. Man kan lätt se att du inte har något öga för detaljer och skönhet. Du kan väl komma på en plan för att ändra det, guvernör?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "Plantera fler rabatter.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "Är du lat igen, guvernör? Ser du inte att alla blommor är nära att vissna? Du borde kanske ta bättre hand om den underbara naturen omkring dig.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "Det stinker i stan, guvernör! Den här gången är det egentligen bara ditt fel. Avloppen är igenproppade och rinner över.\n\nTa hand om situationen!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "Bygg fler dagvattenbrunnar.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "Jaha! Äntligen är staden presentabel och blommorna slår ut överallt, och så händer det här! Ta en titt på radhusen! De är ruiner.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "Guvernör, det här är skamligt!\nDessa strövande djur har ätit upp en massor av mina vackraste blommor. Hur kunde du låta det hända?\n\nJag kräver fler jaktstugor omedelbart för att få bort de här varelserna från mina rabatter.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "Du måste du se till att det finns tillräckligt med sittplatser till den statliga trädgårdsmässan. Några noggrant placerade bänkar runt om i staden borde räcka.\n\nSe till att det blir gjort!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "Bygg bänkar i staden.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "De där stackars djuren, guvernör.\n\nGrisarna lever under hemska förhållanden här i staden och kan inte ströva fritt som de ska.\n\nKlubben Blommornas vänner kräver att grisfarmen och slaktarboden rivs!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "Riv grisfarmen och slaktarboden.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "Guvernör, jag är ordförande för klubben Blommornas vänner. Så du vill ha vårt stöd i det kommande valet? Varför väljs inte en kompetent kvinna som jag till guvernör i en stad som den här?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "Trots mina ursprungliga tvivel på din kompetens som guvernör visade du dig faktiskt vara en sann vän till klubben Blommornas vänner.\nVi kommer att rösta på dig i valet.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "Uppfyll alla krav som klubben Blommornas vänner har.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "Herre, snart kommer det att väljas en ny guvernör i staden.\n\nJag rekommenderar att vi börjar övertyga de olika fraktionerna här i staden att rösta på dig. Jag tror inte att vi har tillräckligt med tid för att övertyga alla, så du bör noga välja vilka vi ska stödja.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "Valresultatet kom precis in, herre.\n\nJag är rädd att vi inte lyckades få tillräckligt med röster från fraktionerna i staden.\n\nVi måste lämna slottet före nästa vecka. Då tar den nya guvernören över våra ämbeten...";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "Herre, vi lyckades övertyga tillräckligt många fraktioner i staden att rösta på oss. Vår position i staden är säkrad.\n\nLåt oss skåla för flera år till på det här ämbetet.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "Guvernör, det är inte lång tid kvar tills valen börjar. Vi måste skynda oss att övertyga tillräckligt många fraktioner att rösta på dig.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "Återstående tid: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "Övertyga minst tre fraktioner för att vinna valet.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "Herre, köpmansgillet är upprörda. Vår marknadsplats revs och borde ha byggts upp igen för länge sedan.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "Det är skandal! Transportörerna lagrade för mycket varor i handelsgillets byggnad. Den har rasat! Hur ska vi kunna bedriva handel när sånt här händer hela tiden?\n\nVar snäll och bygg upp handelsgillet igen.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "Bygg upp handelsgillet igen.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "Underbart, furste. Nu kan vi äntligen bedriva handel igen. Skulle du kunna skapa en handelsorder i handelsgillet? Det borde göra att vår stad får tillbaka till sin rättmätiga plats i regionen.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "Ha en aktiv handelsorder i handelsgillet.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "Pengar! Allt handlar om pengar, guvernör. Det är vår högsta prioritet att se till att det gör tillräckligt med vinst genom handel.\n\nNu tjänar vi lite pengar, guvernör!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "Utrymmet på marknadsplatsen fylls upp ganska snabbt, guvernör. Du borde överväga att uppgradera marknadsplatsen så att vi får mer plats och kan handla effektivare.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "Uppgradera marknadsplatsen.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "Många stadsbor efterfrågar små marknadsstånd runt om i staden, guvernör. Det skulle göra att kan öka handeln i innerstaden. Det är väl en ganska bra idé?";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "Placera ut marknadsstånd i staden.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "Jag har gjort ett väldigt lönsamt handelskontrakt tillgängligt, guvernör. Priserna på kläder och brygd har ökat rejält!\n\nJag känner lukten av mynt! Massor av mynt!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "Sälj kläder och brygd på marknadsplatsen.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "Guvernör, jag är representant för köpmännens gille. För att få gillets röst i det kommande valet måste du förbättra handelssituationen i staden avsevärt.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "Det är en utmärkt dag för handel, herre.\n\nDu lyckades göra den här staden till regionens största handelscentrum.\n\nKöpmännen i gillet är dig evigt tacksamma för det. Som tack kommer vi att rösta på dig i det kommande valet.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "Slutför alla uppgifter åt köpmännens gille.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "Oacceptabel! Helt oacceptabelt!\n\nHur ska vi kunna leverera förråd till våra vakttorn när vi inte ens har en kasern i staden?\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "Bygg en kasern.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "Äntligen en guvernör som vet hur man styr upp saker. Det vore en bra idé att tilldela lite soldater till vakttornen.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "Som befäl tycker jag att det är omöjligt att organisera våra styrkor och få lite tid att vila efter strid. Min krigshärjade kropp längtar efter bekväma officerstält.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "Bygg lite officerstält.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "Guvernör, våra styrkor är fortfarande inte stora nog. Varenda simpel bandit kommer att skratta så att han gör i byxorna när han ser vår patetiska armé.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "Vi behöver proviant till armén, guvernör. Den bästa provianten är korv. Det är mat som håller länge och är lätt att äta i fält.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "Hur ska våra tappra soldater kunna träna inför de kommande striderna när det inte finns någon plats att göra det på? Som befälhavare för de väpnade styrkorna kräver jag att du bygger en tävlingsplats för bågskytte.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "Välkommen, guvernör. Du söker stöd från den militära fraktionen i det kommande valet.\n\nDet finns mycket att göra för att vi ska bli övertygade om att rösta på dig.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "Stort tack, guvernör. Du gör oss enkla soldater stolta. Militären i den här staden är mer rakryggad än någonsin sedan du blev guvernör. Du får vår röst i valet.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "Slutför alla uppgifter åt militärfraktionen.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "Ingen större stad erbjuder sina medborgare begränsat med dryck, herre. Speciellt vi adelsmän vill ha något extravagant, som druvsaft.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "Adelsmännen firar att din senaste produktionskedja är färdig, herre.\n\nFör firandet behöver vi bara en stor mängd druvsaft. Och snälla, inte det där billiga blasket...";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "Herre, du föreslår väl inte att vi ska gå till krogen som den usla pöbeln? Turneringsplatsen utanför stadsmuren har stått övergiven i flera år.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "En av adelsmännens stora hjältar har dött, herre. Om du skulle bygga ett monument åt honom och en respektabel gravplats så skulle du göra många adelsmän i den här staden lyckliga.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "Bygg ett mausoleum och en hjältestaty.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "Herre, den här staden saknar värdefulla föremål till adelsmännen. Man vill gärna visa hur hög ens status är med värdefulla smycken, furste.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "Underbart, furste. Efterfrågan på smycken är mycket stor just nu. Alla vill ha de smycken som bärs av folket vid hovet.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "Så underbart att äntligen träffa dig, furste. Jag representerar adelsmännens fraktion i din stad. Om du vill ha vår röst inför det kommande valet så måste du uppfylla våra extravaganta krav.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "Du uppfyllde faktiskt alla krav från adelsmännen, furste. I din stad har en adelsman samma privilegier som vid hovet.\nDu har gjort fantastiska saker i staden! Du får vår röst i det kommande valet";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "Uppfyll alla adelsmännens krav.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "Vårt religiösa samfund krymper hela tiden. Befolkningen ägnar sin tid åt att dricka och festa. Det här måste ta slut.\n\nDet är den där syndiga krogens fel. Du måste riva den! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "Mycket bra! Den där hädiska byggnaden borde ha rivits för flera månader sedan. Äntligen hade någon modet att göra det.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "Riv krogen.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "Vår kyrka har inte plats för alla nya troende. Ända sedan krogen revs är kyrkan överfull.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "Prisa gud, vilken vacker ny kyrka. Du har himmelsk, härskare.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "Uppgradera kyrkan eller bygg en ny.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "Vårt religiösa samfund är fortfarande missnöjt med stadens utbud när det gäller religion. Befolkningen behöver bli nöjdare med sitt religiösa liv!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "Du gjorde det, härskare! Det var inget misstag att tro på dig. Du har gjort de religiösa lyckliga igen.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "Mina klosterbröder klagar över den bristande humleproduktionen här i staden. Vi munkar kan inte producera brygd utan rätt mängd humle.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "Bygg en kölna.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "Nu när humleproduktionen ökar igen så bör du överväga att öka produktionen av brygd.\n\nUppgradera klostret. Alternativt kan du bygga ett till kloster.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "Det nya klostret strålar i guds glans. Bra gjort, guvernör.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "Uppgradera klostret eller bygg ett till.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "Vi borde producera ordentligt med brygd till invigningsfesten för det nya klostret. Våra gäster kommer att vara törstiga.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "Bryggprocessen är klar, guvernör. Vill du ha äran att prova första klunken?";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "Stadens kyrkogård är alldeles för liten och har för lite plats för gravar. Du måste låta bygga flera nya mausoleer och gravplatser.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "Utöka kyrkogården: bygg mausoleer och gravar.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "Utökandet av kyrkogården borde inkludera nya kyrkogårdsmurar. Du borde låta bygga nya murar som markerar kyrkogårdens område tydligt.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "Bygg nya kyrkogårdsmurar.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "Välkommen, guvernör. Vi munkar från den religiösa fraktionen skulle kunna stödja dig i valet om du uppfyller våra krav.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "Prisa gud, guvernör. Du uppfyllde alla våra krav. Du har förtjänat absolut en plats i himlen, och du får den religiösa fraktionens röst.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "Slutför alla uppgifter åt den religiösa fraktionen.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "Herre, brandmännen har begränsade möjligheter att bekämpa bränder som bryter ut i staden. Det vara till enorm hjälp om vi hade fler brandvaktstorn.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "Vissa medlemmar av tjänarnas fraktion skulle bli överlyckliga om det fanns ett jonglörläger i stan. Då skulle till och med vi ha något att skratta åt.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "Ärade guvernör, vi transportörer är helt överarbetade med alla transportuppdrag i staden. Det skulle verkligen hjälpa oss om du lät bygga fler lager.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "Herre, snickarna klagar över sina kläder. Reparationsarbetena i staden sliter mycket på deras kläder. De behöver verkligen nya.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "Leverera kläder.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "Herre, våra transportörer behöver nya skor. Du behöver inte tillverka nya skor, det kan göra själva.\n\nVi behöver bara läder och tyg.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "Leverera tyg och läder.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "Herre, en liten donation till vår tjänarfraktion skulle göra oss helt övertygade om att du är den mest välvilliga guvernören genom tiderna.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "Donera mynt till tjänarna.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "Guvernör, skatteindrivaren skulle verkligen behöva en ledig dag. Han är inte ung längre, och dessutom värker hans ben.\n\nDu kan väl driva in skatten själv ett tag?";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "Ta bort skatteindrivaren och samla in skatt.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "Herre, jag är representanten för tjänarfraktionen i din stad.\n\nVi jobbar som transportörer, brandmän, snickare och skatteindrivare. Eftersom vi fick en röst i valet kunde du "få" den genom att göra våra liv lite bekvämare.";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "Du gjorde mycket för oss tjänare, herre. Från och med nu väntar bättre tider för oss tjänare. Vi hade aldrig föreställt oss att du verkligen skulle förbättra våra liv i stan.\n\nDu får vår röst i valet!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "Slutför alla uppgifter åt tjänarfraktionen.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "Herre! Pesten sprider sig i staden. Snälla, du måste hjälpa oss! Mina barn är i det drabbade distriktet och vi har ingen sjukstuga i staden.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "Herre, tillgången på mat är dålig i staden. Bönderna rapporterar att vi saknar viktiga byggnader. Du borde låta bygga en ny gård och ett bageri.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "Bygg en gård och ett bageri.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "Herre, vi enkla människor har inte mycket att skratta åt, och vårt dagliga arbete är utmattande. Det vore riktigt trevligt att ha en plats där vi kan glömma våra sorger. En nöjespark vore en bra plats.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "Herre, de flesta i befolkningen lever i fattigdom. Du kan förbättra ditt rykte genom att ge tillbaka en del av skatten till folket.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "Ge tillbaka en del av skatten till folket.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "Nu när vi har den nödvändiga infrastrukturen borde vi erbjuda folket mer varierad mat. De flesta fattiga stadsbor har inget kött till middag. Du kan ändra på det.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_TITLE" = "Leverera kött.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_DESC" = "Herre, vi skördar vetet, maler det och bakar brödet. Men vi får sällan äta vårt eget bröd.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_TITLE" = "Leverera bröd.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_07_DESC" = "Herre, du har nästan vårt godkännande helt och hållet. Det sista du behöver göra är att göra alla i staden gladare. Vi kommer att tacka dig genom att vara mer produktiva.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_START" = "Välkommen, guvernör. Som mjölnare representerar jag bönderna. Om du gör våra liv i staden enklare så ger vi dig vår röst i valet.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_SUCCESS" = "Du är verkligen en man av folket, herre. Du har hjälpt oss enkla människor genom att slutföra våra uppgifter. Nu har våra liv i staden blivit mycket lättare.\n\nTack, herre. Du kan räkna med att vi röstar på dig i valet.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_TITLE" = "Slutför alla uppgifter åt bönderna.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_DESC" = "Herre, vår ekonomi kan inte ge snickaren det han behöver. Vi har inte de nödvändiga resurserna. Du borde ta bort snickaren från hans byggnad tills vidare.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_TITLE" = "Ta bort snickaren.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_02_DESC" = "Vi producerar inte tillräckligt med mat, herre. Det vore bra om du lät bygga lite fler fiskarstugor.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_03_DESC" = "Innan vi väljer någon av stadsfraktionerna så borde du låta bygga ett sågverk. Det är nödvändigt för att främja stadens ekonomi, herre.";
"T_SCENARIO_7_QUEST_INTRO_DESC" = "Gode härskare, min dotter ska gifta sig med prins William Clemens III av Giebelstadt. Jag vill att du tar hand om alla förberedelser inför den här viktiga händelsen. Du har inte mycket tid på dig, så skynda dig. Jag har fullt förtroende för dig!";
"T_SCENARIO_7_QUEST_INTRO_NAME" = "Gör förberedelserna inför det stora bröllopet genom att slutföra alla uppgifter!";
"T_SCENARIO_7_QUEST_OUTRO_DESC" = "Tack för ditt fantastiska arbete! Du gjorde ett strålande jobb. Nu kan bröllopet börja. Och du är bjuden såklart!";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_DESC" = "Banditerna kommer att attackera snart. Vi borde vara förberedda. Bemanna vakttornen.";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_NAME" = "En banditattack är på väg!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_DESC" = "Herre, stadens ekonomi är i spillror på grund av alla banditattacker. Jag hoppas att vi klarar oss igenom belägringen.";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_END" = "Utmärkt, herre! Du hanterade belägringen ganska bra och lyckades till och med bygga upp ekonomin. Även riddaren verkar väldigt imponerad. ";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_NAME" = "Skapa en infrastruktur samtidigt som du försvarar staden.";
"T_SCENARIO_BESIEGEMENT_QUEST_01_DESC" = "Bara en guvernör och hans rådgivare? Det var inte den hjälp jag hade hoppats på. Jag tror inte att du kommer vara till så stor hjälp mot banditerna. Alla andra – till vapen!";
"T_SCENARIO_BESIEGEMENT_QUEST_01_END" = "Vågen med attackerande banditer slogs tillbaka. Nu kan vi vila lite, tills våra spanare upptäcker en ny attack.";
"T_SCENARIO_BESIEGEMENT_QUEST_02_2_DESC" = "Vi behöver fler vakttorn för att försvara staden. Bygg dem omedelbart!";
"T_SCENARIO_BESIEGEMENT_QUEST_02_DESC" = "Guvernör, vad sägs om att du gör lite nytta och ger order om att bygga fler vakttorn?";
"T_SCENARIO_BESIEGEMENT_QUEST_03_DESC" = "Vår kasern har rasat. Vi borde bygga en ny. Jag tror att det är ett jobb du klarar av, guvernör.";
"T_SCENARIO_BESIEGEMENT_QUEST_04_DESC" = "Jag föreslår att vi skickar en budbärare till kungen, herre. Men vi kommer att behöva en förklädnad. Låt oss börja med lite tyg.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_DESC" = "Nu behöver vi lite läder till förklädnaden. Så det ser mer ut som banditkläder.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_NAME" = "Leverera läder.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_DESC" = "Till skägget kommer vi att använda ull. Jag hoppas att det ökar chansen att budbäraren når kungen.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_NAME" = "Leverera ull.";
"T_SCENARIO_BESIEGEMENT_QUEST_07_DESC" = "Vi kan inte bara sitta och vänta på stöd från kungen. Stadsvakternas rustningar är i dåligt skick. Vi måste tillverka nya för att se till att vi kan försvara staden. ";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_DESC" = "Åh nej, herre. De förstörde vår kasern. Vi borde bygga upp den igen så att våra soldater kan få förråd.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_NAME" = "Bygg upp kasernen igen.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_DESC" = "Banditerna förbereder sig för ett stort anfall mot vår kasern. Kasernen är viktig, den får inte förstöras!";
"T_SCENARIO_BESIEGEMENT_QUEST_08_NAME" = "Försvara kasernen.";
"T_SCENARIO_BESIEGEMENT_QUEST_09_DESC" = "Kungens armé har inte kommit än. Vi kan inte vänta längre. Vi behöver de vassaste klingor vi kan tillverka, annars faller staden.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_DESC" = "Guvernör, det sydöstra banditlägret blockerar vägen till andra städer. Om vi vill att fler städer ska hjälpa oss så måste vi förstöra lägret i sydost.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_END" = "Banditlägret har förstörts! Nu kan fler stadsbor hjälpa oss.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "Förstör det sydöstra banditlägret.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "Vi lyckades hitta köpmannen, herre. Han sitter fängslad i lägret nära floden i nordväst.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "Herre, köpmannen är i säkerhet. Nu kommer han att besöka oss regelbundet igen.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_NAME" = "Förstör det nordvästra banditlägret.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_DESC" = "Herre, banditerna får sitt fnöske från lägret i bergen i nordöst. Om vi förstör det så kan de inte tända eld på våra byggnader längre.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_NAME" = "Förstör det nordöstra banditlägret.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_DESC" = "Banditernas huvudläger ligger i sydväst. Låt oss förstöra det, så tvingar vi banditerna att kapitulera. Till attack!";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_NAME" = "Förstör det sydvästliga banditlägret.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_DESC" = "Vilken oförskämd riddare. Herre, ekonomin i staden är i princip ödelagd. När våra soldater har slagit tillbaka de första vågorna av banditer så borde vi beordra befolkningen att tillverka lite grundläggande resurser.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_NAME" = "Tillverka plankor.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_02_DESC" = "Nåväl, herre. Vi borde börja bygga upp gården igen, för vi har ont om mat.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_DESC" = "Nu kan vi baka bröd igen. Men vi bör hålla ett öga på banditerna och kalla in befolkningen som soldater när det är nödvändigt.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_03_NAME" = "Tillverka bröd.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_11_DESC" = "Guvernör, vi skulle kunna öka soldaternas effektivitet om vi förser dem med brygd.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_12_DESC" = "Vi kan öka soldaternas stridsstyrka ännu mer, herre. Det enda vi behöver nu är lite korv.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_DESC" = "Att jobba och slåss hela dagen är väldigt ansträngande. Kan vi ta en liten paus, herre? Det vore fantastiskt om hela staden fick en ledig dag.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_21_NAME" = "Har inga stadsbor tilldelade för jobb.";
"T_SCENARIO_HELPER_AVALANCHE_CHANGE_HIGH_NAME" = "Lavinfara: hög";
"T_SCENARIO_HELPER_AVALANCHE_CHANGE_MED_NAME" = "Lavinfara: medelstor";
