"T_GAME_QUEST_MIL_TUT_20_START" = "นายท่าน\nได้เวลาขยายกองทัพแล้ว ท่านสามารถส่งหน่วยปฏิบัติการออกไปทำลายค่ายโจรได้";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "ขยายกองทัพ";
"T_GAME_QUEST_MIL_TUT_21_START" = "ถึงเวลาแล้ว ท่านเจ้าเมือง!\n\nเราจะโจมตีพวกโจรน่ารังเกียจนั่น ค่ายของพวกมันซ่อนอยู่ในป่า\nท่านต้องเลือกค่ายโจรและสั่งให้กองทหารโจมตี\n\n\nข้าขอให้ท่านล่าให้สนุก!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "ทำลายค่ายโจร";
