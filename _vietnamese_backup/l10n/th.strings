"T_LEVELSELECTION_ENABLE_BANDITS_QUESTION" = "เปิดใช้งานการโจมตีของโจรบนแผนที่นี้หรือไม่";
"T_LEVELSELECTION_PROPERTIES_BANDITS_ENABLED" = "โจรที่เคลื่อนไหวอยู่";
