"T_GAME_QUEST_SCEN12_06_TITLE" = "ปกป้องวิหาร";
"T_GAME_QUEST_SCEN12_07_START" = "ท่านต้องสร้างวิหารขึ้นใหม่ มิฉะนั้นเราจะไม่มีวันทำงานเสร็จทันเวลา!";
