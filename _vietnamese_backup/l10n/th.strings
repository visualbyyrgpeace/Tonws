"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "ซื้อขายสัตว์ที่ตลาด";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "เสบียงสำหรับอาหาร";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "อุปกรณ์สำหรับทหารของพระราชา";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "ป้องกันการโจมตีของโจร";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "ทำลายค่ายโจร";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "ยินดีต้อนรับ ท่านผู้ดูแล! ลองดูแนวชายฝั่งนี่สิ! ข้าหวังว่าเมืองของท่าจะคู่ควรกับสถานที่อันสวยงามนี้!\nดูแลชาวเมืองของท่านให้ดีและอย่าลืมมอบเครื่องบรรณาการแด่พระราชาด้วย ท่านจะได้รับใช้ข้าต่อไป!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "ช่างเป็นที่ตกปลาที่ยอดเยี่ยมจริงๆ เห็นด้วยหรือเปล่า นายท่าน หากอยู่ที่นี่ เราจะไม่มีวันขาดเสบียงอาหารแน่นอน!\nเราอยากให้ท่านจัดงานเทศกาลสักครั้ง หากท่านจ่ายไหวหลังจากมอบเครื่องบรรณาการแด่พระราชา!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "โอ้ ที่รัก ขอบคุณที่ลงหลักปักฐานที่นี่! ทะเลสาบนี่สวยงามมาก!\nชาวเมืองจะต้องมีความสุขอย่างแน่นอน! หากท่านดูแลพวกเขาให้ดี!\nโอ้ และอย่าลืมติดสินบนให้พระราชาด้วย เราจะได้อยู่ที่นี่ได้ตลอด!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "นายท่าน ช่างเป็นการตัดสินใจที่ดีจริงๆ ที่ย้ายมาที่หุบเขาลำน้ำแห่งนี้!\nชาวเมืองจะต้องยินดีเมื่อท่านช่วยเหลือผู้ยากไร้!\nอย่างไรก็ตาม จากความใจกว้างของท่าน ข้าขอแนะนำว่าอย่าปฏิเสธหน้าที่ของท่านต่อพระราชา!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "ยินดีต้อนรับ! คนของข้าภูมิใจที่ได้สนับสนุนท่านในการสร้างฐานอำนาจที่นี่บนจุดสำคัญของดินแดนของเรา!\nปีนี้เป็นปีแห่งการเฉลิมฉลอง!\nขอให้พระราชาจงเจริญ และท่านด้วย!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "ท่านเจ้าเมืองที่รัก ข้าได้ยินเรื่องของท่านมาเยอะมาก! นั่นเป็นสาเหตุที่ข้าเลือกท่าน: สร้างเมืองอันรุ่งเรืองใต้เนินเขาของปราสาทของข้า!\nเจ้าสามารถเริ่มก่อตั้งได้ทันที! ขอให้โชคดี!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "นายท่าน เราได้รับมอบหมายให้ก่อตั้งเมืองใกล้กับก้นแม่น้ำอันเหือดแห้งนี้ พระราชาจะมอบรางวัลให้เราอย่างงาม หากเราทำหน้าที่ได้ดี";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "นายท่าน ที่ราบสูงที่ปราสาทของท่านตั้งอยู่เป็นสถานที่ที่เหมาะสำหรับเมืองเล็กๆ พระราชายังส่งภารกิจจำนวนหนึ่งที่ท่านต้องทำมาให้อีกด้วย";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "เราค้นพบหมู่เกาะนอกชายฝั่ง ข้าขอสั่งให้เจ้ายึดครองเกาะเหล่านี้ในนามของข้า!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "นายท่าน ดูป่าอันสวยงามนี่สิ การก่อตั้งเมืองที่นี่จะต้องยากลำบากแน่ๆ แต่อย่างน้อย เราจะมีกวางและไม้เหลือเฟือ\n\nซึ่งทำให้ภารกิจที่พระราชามอบหมายให้เราเป็นเรื่องง่ายขึ้น";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "นายท่าน การหาเครื่องบรรณาการที่ต้องส่งให้พระราชาเป็นเรื่องยากลำบาก เพราะฤดูหนาวอันโหดร้าย มาลงมือทำงานกันเถอะ...";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "ช่างเป็นหุบเขาที่น่ามหัศจรรย์จริงๆ ที่นี่มีทรัพยากรเพียงพอเพื่อมอบเครื่องบรรณาการแด่พระราชา แต่จงระวัง พื้นที่ก่อสร้างที่มีอยู่น้อยทำให้จำเป็นต้องวางแผนอย่างดี";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "นี่เป็นเกาะที่สวยงามจริงๆ! ข้าดีใจมากที่เรามาที่นี่ เราควรเริ่มต้นวางแผนก่อตั้งหมู่บ้านของเราทันที!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "เราสามารถเฝ้าระวังบริเวณรอบๆ ได้ดีจากที่นี่ แต่น่าเสียดายที่ฤดูหนาวจะยาวนานขึ้นบนที่สูงแบบนี้ เราจะต้องพบกับปัญหาเรื่องพืชผลอย่างร้ายแรง\n\nขอแนะนำให้กักตุนเสบียงไว้ในฤดูร้อน";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "สวัสดี! เรากำลังรอท่านอยู่! คนของข้าสำรวจพื้นที่นี้แล้ว และพบแหล่งแร่ที่อุดมสมบูรณ์มากมาย \n\nท่านควรเริ่มต้นทำเหมืองทันทีก่อนที่คนอื่นจะชิงตัดหน้าไป!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "นายท่าน ดีที่ท่านเสด็จมา\n\nอดีตท่านเจ้าเมืองหนีไปแล้ว ขณะที่หนีไป เขาก็ตะโกนว่าบริเวณนี้ถูกสาป";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "ท่านเจ้าเมืองคนก่อนไม่ได้พูดผิดเสียทีเดียว การเกษตรเป็นเรื่องยาก แทบไม่มีอะไรเติบโตที่นี่ แม้แต่น้ำก็ยังขาดแคลน แต่ข้ามั่นใจว่าท่านจะหาทางออกได้";
"T_GAME_QUEST_SCEN10_10_DESC" = "ชาวเมืองรู้สึกไม่พอใจกับวิถีชีวิตทางศาสนาของพวกเขา นายท่าน ท่านพอจะช่วยสร้างโบสถ์ในเมืองหน่อยได้ไหม";
"T_GAME_QUEST_SCEN10_10_NAME" = "ได้รับความสุขด้านศาสนาสูง";
"T_GAME_QUEST_SCEN10_11_DESC" = "ท่านคิดว่าผู้สูงส่งอย่างข้าจะเดินบนถนนดินแบบนี้งั้นเหรอ ท่านเจ้าเมือง สร้างถนนที่คู่ควรกับเมืองหน่อยสิ!";
"T_GAME_QUEST_SCEN10_11_NAME" = "สร้างถนนหินกรวดในเมือง";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "สร้างถนนดินในเมือง";
"T_GAME_QUEST_SCEN10_12_DESC" = "มีคนทำงานไม่ได้เรื่องทิ้งเอาไว้ นายท่าน อาคารจำเป็นต้องซ่อมแซมครั้งใหญ่\n\nเราต้องจ้างช่างไม้เพื่อซ่อมแซมอาคารทั้งหมดก่อนที่พวกมันจะพังลงมาทั้งหลัง";
"T_GAME_QUEST_SCEN10_12_NAME" = "สร้างร้านช่างไม้และได้รับความพึงพอใจในสภาพอาคารสูง";
"T_GAME_QUEST_SCEN10_13_DESC" = "ท่านเจ้าเมือง! ทำไมเมืองของท่านถึงเล็กแค่นี้ เราตามหลังท่านดยุคแล้ว! \n\nเราจะแพ้การเดิมพัน เว้นแต่ว่าท่านจะจัดการเพิ่มจำนวนประชากรของเมือง!";
"T_GAME_QUEST_SCEN10_13_NAME" = "เพิ่มจำนวนประชากรของหมู่บ้าน";
"T_GAME_QUEST_SCEN10_14_DESC" = "ครอบครัวใหม่ที่ย้ายเข้ามาในเมืองต้องผ่านการเดินทางอันยาวนาน พวกเขาเหนื่อยล้าและหิวโหยมาก มาจัดงานเลี้ยงให้พวกเขาและฉลองการเริ่มต้นใหม่กันเถอะ นายท่าน!";
"T_GAME_QUEST_SCEN10_14_NAME" = "ผลิตอาหารให้เพียงพอกับหมู่บ้าน";
"T_GAME_QUEST_SCEN10_15_DESC" = "เราควรเริ่มซื้อขายกับพ่อค้าเร่ การมีพ่อค้าในเมืองจะดึงดูดแขกและเพิ่มชื่อเสียงของเมืองของเรา นายท่าน!";
"T_GAME_QUEST_SCEN10_15_NAME" = "ได้รับเงินจำนวนมากจากการซื้อขายกับพ่อค้า";
"T_GAME_QUEST_SCEN10_16_DESC" = "จำนวนภาษีที่ท่านเก็บได้ช่างน้อยนิด! บางที ท่านควรสร้างคลังสมบัติเพื่อเพิ่มภาษีนะ";
"T_GAME_QUEST_SCEN10_16_NAME" = "สร้างคลังสมบัติและเก็บภาษีให้เพียงพอ";
"T_GAME_QUEST_SCEN10_17_DESC" = "เครื่องประดับ ข้าต้องการเครื่องประดับ! ข้าสงสัยว่าท่านจะส่งมอบเครื่องประดับได้อย่างไร หากท่านยังไม่ได้สร้างร้านช่างทอง";
"T_GAME_QUEST_SCEN10_17_NAME" = "สร้างร้านช่างทองและเริ่มผลิตเครื่องประดับ";
"T_GAME_QUEST_SCEN10_18_DESC" = "เยี่ยมมาก นายท่าน ท่านส่งรถม้าเต็มไปด้วยเครื่องประดับมาให้ข้าได้แล้ว";
"T_GAME_QUEST_SCEN10_18_NAME" = "ส่งมอบเครื่องประดับให้พ่อค้า";
"T_GAME_QUEST_SCEN10_2_DESC" = "นายท่าน สิ่งจำเป็นอันดับแรกคือเสบียงอาหาร เราต้องมีชาวประมงและนายพราน";
"T_GAME_QUEST_SCEN10_2_NAME" = "สร้างกระท่อมชาวประมงและกระท่อมนายพรานจำนวนหนึ่ง";
"T_GAME_QUEST_SCEN10_3_DESC" = "ท่านเจ้าเมืองที่แสนดี ข้าไม่สามารถช่วยท่านได้ จนกว่าท่านจะสร้างตลาด";
"T_GAME_QUEST_SCEN10_3_NAME" = "ตลาดเป็นสิ่งจำเป็นในการขยายหมู่บ้าน";
"T_GAME_QUEST_SCEN10_4_DESC" = "นายท่าน! ท่านได้สร้างร้านช่างทำเครื่องมือหรือยัง ท่านดยุคเริ่มผลิตเครื่องมือแล้วนะ!";
"T_GAME_QUEST_SCEN10_4_NAME" = "สร้างร้านช่างทำเครื่องมือและเริ่มผลิตเครื่องมือ";
"T_GAME_QUEST_SCEN10_5_DESC" = "หลังจากทำงานหนัก เราก็ต้องการสถานที่เพื่อผ่อนคลาย พบปะกับเพื่อนๆ และดื่มน้ำองุ่นสักแก้ว โรงเตี๊ยมน่าจะเป็นที่ที่เหมาะ\n\nแน่นอน ทั้งหมดขึ้นอยู่กับความสะดวกของท่าน นายท่าน";
"T_GAME_QUEST_SCEN10_5_NAME" = "ได้รับความพึงพอใจสูงด้วยโรงเตี๊ยม";
"T_GAME_QUEST_SCEN10_6_DESC" = "เรามีที่พักอาศัพพอหรือเปล่า นายท่าน คนงานใหม่ที่ย้ายเข้ามาในเมืองต้องการที่หลบแดดหลบฝน ท่านเห็นด้วยหรือเปล่า";
"T_GAME_QUEST_SCEN10_6_NAME" = "สร้างทาวน์เฮาส์หลังใหญ่ 2 หลังและปกติ 4 หลัง";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "สร้างทาวน์เฮาส์หลังใหญ่เพิ่ม";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "สร้างทาวน์เฮาส์หลังเล็กเพิ่ม";
"T_GAME_QUEST_SCEN10_7_DESC" = "เมืองต้องการความบันเทิงเพิ่มอีก อย่างเช่น สนามประลองยุทธ์บนหลังม้า ตรวจสอบว่าท่านสามารถมอบความบันเทิงแบบนี้ได้ก่อนที่แขกคนสำคัญจะมาถึง";
"T_GAME_QUEST_SCEN10_7_NAME" = "ได้รับความพึงพอใจสูงจากความบันเทิง";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "ได้รับความพึงพอใจสูงด้วยสนามประลองยุทธ์บนหลังม้า";
"T_GAME_QUEST_SCEN10_8_DESC" = "นายท่าน บางทีเราอาจเพิ่มความสวยงามให้เมืองนี้ได้ด้วยการสร้างรูปปั้นและของตกแต่ง มาจัดการให้เรียบร้อยก่อนที่พระราชาจะกลับมาเยี่ยมชมอีกครั้งกันเถอะ";
"T_GAME_QUEST_SCEN10_8_NAME" = "เพิ่มความสวยงามให้เมืองด้วยของตกแต่ง";
"T_GAME_QUEST_SCEN10_9_DESC" = "สวัสดี ท่านเจ้าเมือง ท่านสนใจจะค้าขายไหม\n\nข้ากำลังต้องการเสื้อผ้าจำนวนมากเพื่อทำข้อเสนอที่ให้กำไรอย่างงามกับท่านดยุค ข้าจะจ่ายให้อย่างงาม หากท่านมอบของที่ข้าต้องการได้";
"T_GAME_QUEST_SCEN10_9_NAME" = "ส่งมอบเสื้อผ้าให้พ่อค้า";
"T_GAME_QUEST_SCEN10_END_FAIL" = "ช่างเป็นหายนะจริงๆ ท่านเจ้าเมือง! ท่านดยุคแห่งแคนเทอร์โบโรกเอาชนะเราได้และก่อตั้งเมืองเสร็จได้ก่อนพวกเรา!\n\nข้าหวังว่าจะได้รับการสนับสนุนจากท่านและข้าก็ผิดหวังวมาก บางที การชนะการเดิมพันครั้งนี้อาจเป็นแค่การเพ้อฝันตั้งแต่แรก ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "เยี่ยมมาก ท่านเจ้าเมือง! เราเอาชนะท่าน\nดยุคในการก่อตั้งและขยายเมืองได้ เราชนะ\nเดิมพันแล้ว!\n\nข้าประทับใจกับการทำงานของท่านและข้า\nจะมอบรางวัลให้ท่านอย่างงาม นอกจากนี้\n ข้าขอแต่งตั้งให้ท่านเป็นดยุค พร้อมกับ\nสิทธิและอำนาจทุกอย่าง";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "ข้ารับใช้ผู้ซื่อสัตย์ของข้า ข้าอาจฝืนทำอะไรที่ไม่มีทางเป็นไปได้\n\nข้าได้เดิมพันกับท่านดยุคแห่งแคนเทอร์โบโรกว่าข้าสามารถเปลี่ยนเมืองที่ล้าหลังที่สุดในอาณาจักรให้เป็นมหานครอันรุ่งโรจน์ได้ก่อนที่เขาจะทำแบบเดียวกันกับเมืองที่ล้าหลังที่สุดของเขา";
"T_GAME_QUEST_SCEN12_01_START" = "ดีจริงๆ ที่ท่านมาเยี่ยมพวกเขา ข้าขอต้อนรับในนามของพระในวิหารทั้งหมด";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "ยินดีต้อนรับสู่วิหารของเรา นายท่าน\nเราสามารถช่วยท่านหาของขวัญที่คู่ควรกับพระราชาได้อย่างแน่นอน แต่เรามีปัญหากับพวกโจรอยู่ในขณะนี้ บางที ท่านอาจช่วยเราได้เช่นกัน";
"T_GAME_QUEST_SCEN12_02_START" = "ช่างเป็นการกระทำที่ชั่วร้ายจริงๆ!\n\nมีคนขโมยไม้ของเราไป! เราบรรจุเหล้าไม่ได้หากไม่มีไม้สำหรับผลิตถัง";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "ขอบคุณมาก นายท่าน! เราสามารถสร้างถังใส่เหล้าได้อีกครั้งแล้ว";
