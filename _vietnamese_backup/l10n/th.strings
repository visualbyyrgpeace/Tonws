"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "ดีมาก นายท่าน\nแต่เราไม่มีเวลาหยุดพักหรอกนะ!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "มอบหมายผู้ดูแลป่าและซ่อมแซมโรงเลื่อย";
