"T_MAP_CANALGRANDE_DESC" = "Çok sayıda küçük adaya sahip bir kıyı gölü köprülerle birbirine bağlanan ve kanalların geçtiği bir kasaba inşa etmek için mükemmel bir yerdir.";
"T_MAP_COASTALISLAND_DESC" = "Bu koyda cennet gibi bir ada var. Bu uzak konumda gerçekten önemli bir kasaba inşa edebilir misiniz?";
"T_MAP_COASTSANDCLIFFS_DESC" = "Kale yüksek bir uçurumdan okyanusa bakıyor. Çevredeki platoların üzerine güzel bir kıyı kasabası inşa edebilirsiniz.";
"T_MAP_COASTSANDCLIFFS_NAME" = "Uçurumlar ve Kıyılar";
"T_MAP_DESC_10" = "Bu verimli vadi filizlenen kasabamız için kusursuz şekilde uygun.";
"T_MAP_DESC_11" = "Bu harita tüm cihazlardaki performansı test etmek için yaratılmıştır. Gerçekten büyük bir kasaba haritanın her yerine yayılıyor.";
"T_MAP_DESC_12" = "Bu bölgedeki nehirlerin dalgalanan suları Kasabalıları balık tutmaya veya berrak suda yüzmeye çağırıyor.";
"T_MAP_DESC_13" = "Karanlık platonun altındaki küçük bir köy büyüyerek kocaman bir kasabaya dönüşebilir.";
"T_MAP_DESC_14" = "Krallık kuraklık çekiyor. Nehir kurudu. Bu toprağı işleyip Kasabalılarınızı beslemeyi zorlu bir göreve dönüştürüyor.";
"T_MAP_DESC_15" = "Platoda filizlenen bir ticaret merkezi inşa edin. Tüccarlar ve krallarla kazançlı anlaşmalar sizi bekliyor.";
"T_MAP_DESC_16" = "Bir maden kolonisi inşa edin ve devasa bir katedral inşaatı için kaynaklar tedarik edin.";
"T_MAP_DESC_17" = "Büyük bir kraliyet düğünü için hazırlıklar yapın.";
"T_MAP_DESC_18" = "Bu kurumuş nehir yatağının yakınına büyük bir kasaba inşa edin ama suyun bu bölgede nadir bulunduğunu unutmayın.";
"T_MAP_DESC_19" = "Bataklıkların sınırının yanında küçük bir plato var. Bir kasaba için ideal bir yer.";
"T_MAP_DESC_2" = "Sahildeki bu sessiz yer köyünüzü kurmak için ideal konumda.";
"T_MAP_DESC_20" = "Hiçliğin ortasında ıssız bir dağ bölgesi. Su yok ancak sayısız cevher damarı var. Zengin olmak için kusursuz yer!";
"T_MAP_DESC_2016_01" = "Kralın büyük bir filo inşa etmek için çok fazla tahtaya ihtiyacı var. Tahta teslimatının neden durduğunu öğrenin ve bir Esnaf Loncası kurun.";
"T_MAP_DESC_2016_02" = "Bu güzel bölge bir şehir inşa etmek için mükemmel yer. Geniş tepeler çok sayıda bina için geniş alan sağlıyor.";
"T_MAP_DESC_2016_03" = "Küçük bir kasaba büyük bir metropole dönüştü. Verilen süre içinde Kasabalıların isteklerini ve ihtiyaçlarını giderin.";
"T_MAP_DESC_2016_04" = "Bir pazar ve taverna inşa etmek için belirtilen Kasabalıların işlerini değiştirin.";
"T_MAP_DESC_2016_05" = "Kasabanızı iyi planlayın, şelaleler arasında binalar için olan alan seyrek ve araziyi geçmek zor olabilir.";
"T_MAP_DESC_2016_06" = "Bu bölgede ağır çığlar var. Bunun yanında küçük bir kasaba inşa edip zengin cevher yataklarını kullanmalısınız.";
"T_MAP_DESC_2016_08" = "Kanyonda kendi kasabanızı inşa edin. İhtiyacınız olan her şeyi bulabilirsiniz ancak bazı bölgelere ulaşmak zor.";
"T_MAP_DESC_2016_09" = "Şehriniz için gerekli kaynaklara ulaşmak için nehri geçin.";
"T_MAP_DESC_2016_10" = "Bir miktar para biriktirin. Yine de dikkatli olun, haydutlar bu bölgede gizli bir barınak kurmuş. Haydut tehdidinin yanında mutsuz kasabalılar vergilerini ödemez.";
"T_MAP_DESC_21" = "Muhteşem, gizli bir ada üzerine bir köy kurun. Taze deniz havasının tadını çıkarın!";
"T_MAP_DESC_21_NOBANDITS" = "Muhteşem, gizli bir ada üzerine bir köy kurun. Taze deniz havasının tadını çıkarın!";
"T_MAP_DESC_22" = "Kasabanızın merhametsiz kışı atlatmasını sağlayın.";
"T_MAP_DESC_23" = "Bu donmuş ovada hızlıca işleyen bir kasaba inşa etmelisiniz yoksa kış boyunca açlıktan kırılırsınız.";
"T_MAP_DESC_24" = "Kralı büyük bir gemi filosu inşa etme projesinde destekleyin ve bu sırada kasabadaki büyüyen huzursuzluğu kontrol altında tutun.";
"T_MAP_DESC_25" = "Bu bölge çevresindeki ormanları kasabanızı inşa ederken avantajınıza kullanın. Burada su az, bu yüzden balık tutmaya bel bağlanamaz.";
"T_MAP_DESC_26" = "Kral bir bahse katıldı ve arşidükten önce büyük bir şehir inşa etmek sizin göreviniz. Tüm görevleri tamamlamak için fazla vaktiniz yok. Onu hayal kırıklığına uğratmayın!";
"T_MAP_DESC_27" = "Bataklık bölgeler uygun bina alanı bulmayı zorlaştırıyor. Mevcut bina alanını etkili şekilde kullandığınızdan emin olun!";
"T_MAP_DESC_28" = "Kayalık bir vadi birçok kaynak içerir ancak bina için alan seyrektir.";
"T_MAP_DESC_29" = "Küçük bir grup ada. Onları kolonileştirmek zor olacak.";
"T_MAP_DESC_29_NOBANDITS" = "Küçük bir grup ada. Onları kolonileştirmek zor olacak.";
"T_MAP_DESC_3" = "Bu eğitim haritasıdır. Burada Townsmen dünyasıyla tanıştırılacaksınız.";
"T_MAP_DESC_30" = "Dağ kalenizi çevreleyen bir kasaba inşa edin. Ancak dikkatli olun, uzun bir kış geliyor.";
"T_MAP_DESC_31" = "Kral mülklerini ziyaret edecek. Gelişi için hazırlanın.";
"T_MAP_DESC_32" = "Kralın doğum günü yaklaşıyor. Şimdi hediye olarak kusursuz içkiyi araştırın. Belki de manastırdaki keşişlerin daha fazla bilgisi vardır…";
"T_MAP_DESC_33" = "Kral gizemli bir hastalığa yakalandı. Onu iyileştirip hastalığın nereden geldiğini öğrenmek size bağlı.";
"T_MAP_DESC_34" = "Savaş toprakları kontrolü altına aldı. Cepheden uzakta başarılı bir kasaba inşa edip Kralın ordusunu desteklemelisiniz.";
"T_MAP_DESC_35" = "Kral kötü zamanlar için hazırlanmak istiyor ve gerekli malları teslim etmek için kasabanız seçildi.";
"T_MAP_DESC_36" = "Bir gaziden savaşın detaylarını öğrenin.";
"T_MAP_DESC_37" = "Gaspçı haydutla uğraşırken eşinizin dileklerini yerine getirin.";
"T_MAP_DESC_4" = "Kaleniz küçük bir nehir adasında yer alıyor. Çevredeki nehir kenarlarını akıllıca kullanın ve başarılı bir ekonomi kurun.";
"T_MAP_DESC_6" = "Güzel bir gölün kenarlarında küçük bir köy inşa edin.";
"T_MAP_DESC_7" = "Kasabanız, Kral tarafından bölgenin en büyük atlı mızrağına ev sahibi yapmak için seçildi!";
"T_MAP_DESC_8" = "Kış geliyor! Kasabalılarınızın karlı mevsime hazırlanmalarına yardım edin!";
"T_MAP_DESC_9" = "Eşinizi destekleyin ve harabe bir köyün ekonomisini yeniden başarıya ulaştırın!";
"T_MAP_DESC_APOCALYPSE" = "Kasabanın üzerinde bir lanet var. Garip hastalıklar ve felaketler nüfusa acı çektiriyor. Laneti olabildiğince hızlı şekilde çözmenin bir yolunu bulmak size bağlı. Bedeli ne olursa olsun…";
"T_MAP_DESC_FESTIVITIES" = "Kral yeniden evlendi. Yeni eşini onurlandırmak için birkaç, mevsimlik festival düzenlemeniz emredildi. Ancak planlama ve idare zorlu olabilir. Zamana karşı bir yarış olacak…";
"T_MAP_DESC_ICYHOLD" = "Buzlu kale bir uçurumun tepesinde duruyor. Ulaşılması zor ancak bir kez çıkıldığında soğuk tundranın çevresi görülebilir. Bu bölgede kış çok uzun!";
"T_MAP_DIPLOMATICVISIT_DESC" = "Dost bir ülkenin kraliçesi ziyarete geldi. Kazançlı ticari anlaşmalar yapılmak üzere ancak ilk önce aşılması gereken bir dil engeli var.";
"T_MAP_DIPLOMATICVISIT_NAME" = "Diplomasi ziyareti";
"T_MAP_DIVIDEDSHORELINE_DESC" = "Görkemli dağlar topraklarınızı ikiye bölüyor. Ayrıca kalenizden fazla uzakta olmayan bir adayı fethedebilirsiniz.";
"T_MAP_DIVIDEDSHORELINE_NAME" = "Bölünmüş kıyı şeridi";
"T_MAP_FRIGYTHKINGDOM_DESC" = "Kraliçe Frigyth'in, Krallığının bu kısmını yönetmesi için bir valiye ihtiyacı var. Bu yeni toprakta muhteşem bir kasaba inşa edin.";
"T_MAP_FRIGYTHKINGDOM_NAME" = "Frigyth Krallığı";
"T_MAP_FROZENFRONT_DESC" = "Son savaş şehrin çoğunu harabeye çevirdi. Kasabanın karla kaplı kalıntıları, şimdi orduların büyük savaşının gerçekleştiği yeri işaret ediyor. Şimdi şehri yeniden inşa etme zamanı.\n\nBu sadece kışa özel bir harita!";
"T_MAP_HIGHLANDS_DESC" = "Bu ülkeden dağlar ve tepeler geçiyor. Zirveye ulaştığınızda manzara harika.";
"T_MAP_HIGHLANDS_INTRO" = "Vali, dağlık bölgelere hoş geldiniz. Bu bölge gizemlerle dolu. Eminim sakinlerle ilgilenip özen gösterirseniz topraklar yakında size tüm sırlarını gösterecektir.";
"T_MAP_HIGHLANDS_NAME" = "Dağlık Bölgeler";
"T_MAP_INSANECHOICES_DESC" = "Dükün görünüşe göre delirdiği bir köye çağırılıyorsunuz. Kasabalılar vergi ödemeyi kabul etmiyor!\nYaptığınız her bir seçim sizi farklı bir sona götürecek.";
"T_MAP_INSANECHOICES_NAME" = "Çılgın Seçimler";
"T_MAP_LEGACY_DESC" = "Kralın sizin için yeni bir görevi var. Oldukça yaşlanıyor ve bu dünyaya bir miras bırakmadan gitmekten korkuyor. Krallık yaparken öğrendiği dersleri gelecek nesillere aktaracak birisi.";
"T_MAP_LEGACY_NAME" = "Miras";
"T_MAP_LOWLANDS_DESC" = "Geniş ovalar ve çok sayıda bina alanı ufka kadar uzanır. Burada gerçekten büyük bir şehir inşa etmek mümkündür.";
"T_MAP_LOWLANDS_NAME" = "Ovalar";
"T_MAP_MARSH_DESC" = "Bu bölgede, birçok ıslak çayır toprağın biyolojik çeşitliliğine katkıda bulunur. ";
"T_MAP_MARSH_INTRO" = "Lort, toprak ve suyun mükemmel dengesine baksanıza. Sizi bu huzurlu yerde mutlulukla karşılıyorum.\n\nBuradaki sakinler yakında bu bölgenin gerçek harikalığına kavuşmasına yardım etme çabalarınıza şahitlik edecek!";
