"T_GAME_QUEST_DESIRES_08_START" = "Nöbetçilerin itaatkâr olduğundan emin olmak için onlara içki ve sosis vermelisiniz!";
"T_GAME_QUEST_DESIRES_08_TITLE" = "İçki ve sosis üretin.";
"T_GAME_QUEST_DESIRES_09_START" = "Nöbetçilerin haydutlardan korunabilmek için silahlara ve zırha ihtiyacı var!";
"T_GAME_QUEST_DESIRES_09_SUCCESS" = "Nöbetçiler şimdi tüm haydutları püskürtebilir!";
"T_GAME_QUEST_DESIRES_09_TITLE" = "Silah ve zırh üretin.";
"T_GAME_QUEST_DESIRES_10_FAIL" = "Bizimkilerin paylarını bir şekilde alacağını söylemeliydim!";
"T_GAME_QUEST_DESIRES_10_START" = "Eşinizin her bir dileğini gerçekleştirişiniz bana altın fazlalığı sorununuz olduğunu düşündürüyor.\n\nSizi bu ağır yükten kurtarayım!";
