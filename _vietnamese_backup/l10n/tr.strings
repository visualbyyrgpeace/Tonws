"T_GAME_QUEST_SNEEZE_CONTEST_YES_001" = "Hadi yapalım!";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_001" = "Haklısınız, hadi birkaç heykel inşa edelim.";
"T_GAME_QUEST_STONE_ANGEL_ANSWER_002" = "Hayır… Ben şehrimde heykel olsun istemiyorum.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_001" = "Tebrikler sör! Bu heykeller şehrimize özel bir cazibe katıyor.";
"T_GAME_QUEST_STONE_ANGEL_CONSEQUENCE_002" = "Ah Sör, belki bir gün bu tür detayları düşünürsünüz.";
"T_GAME_QUEST_STONE_ANGEL_DESC" = "Sör, şehrimizde fena halde heykel azlığı var. Birkaç tane eklemeye ne dersiniz? Ayrıca heykellerin sakinleri koruduğuna inanılıyor.";
"T_GAME_QUEST_STONE_ANGEL_TITLE" = "İnançlı melekler";
"T_GAME_QUEST_SUCCESS" = "Görev tamamlandı!";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_001" = "Bu muhteşem bir niyet, ona izin verin.";
"T_GAME_QUEST_TEAR_HUNTER_ANSWER_002" = "Ne garip bir insan.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_A" = "Sör, sakinlerin bunu yapmasına izin veremeyiz. Hadi bir hokkabaz kampı inşa edelim ve bu deliyi eğlenceden sorumlu tutalım.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_002_B" = "Muhteşem! Nüfus bu sonuçtan memnun görünüyor.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_001" = "Köyü uzaktan gözlemliyorsunuz.\n\nGözyaşı avcısı hâlâ kasabalıları kovalıyor. Gittikçe daha fazla insan evden çıkmayı reddediyor.\n\nSeçiminizin yol açtığı zarara daha fazla şahit olmamak için pencereden uzaklaşıyorsunuz.";
"T_GAME_QUEST_TEAR_HUNTER_CONSEQUENCE_A_002" = "Belki de başka bir şey yapmalıydınız… Bu garip kasabalı sakinleri korkutuyor ve moralleri yalnızca azalıyor. Umalım da bu sona ersin!";
"T_GAME_QUEST_TEAR_HUNTER_DESC" = "Vali, bu sabah bana köylülerden birisi kafasına herkesi mutlu etmeyi koyduğunu söylendi. Sakinleri kovalayıp onları kahkaha atmaya zorluyormuş…";
"T_GAME_QUEST_TEAR_HUNTER_TITLE" = "Gözyaşı Avcısı";
"T_GAME_QUEST_THE_BATH_B_001" = "Ucuz atlattık. ";
"T_GAME_QUEST_THE_BATH_B_002" = "Artık yıkanmanın zorunlu olduğunu duyuralım. Bu hastalığı azaltacaktır!";
"T_GAME_QUEST_THE_BATH_B_NO_001" = "Zorunlu olmayan hamamlar.";
"T_GAME_QUEST_THE_BATH_B_NO_002" = "Hatalarınızdan asla ders çıkarmayacaksınız!";
"T_GAME_QUEST_THE_BATH_B_NO_003" = "Sör, başka bir hastalık salgını bildirildi. Bu sefer bir öncekinden çok daha şiddetli.";
"T_GAME_QUEST_THE_BATH_B_NO_005" = "Sör, isteseniz de istemeseniz de bu sefer yıkanmayı zorunlu kılıyorum!";
"T_GAME_QUEST_THE_BATH_B_NO_006" = "Danışmanınız birçok kişiyi hastalıktan kurtardı. Tarih kitaplarına girmeyi bile başardı. Yine de hamamları reddeden sizdiniz. Yıllar sonra bile yüzlerce çocuk sizi bunun için seviyor, çünkü alıntı yapıyorum, "Yıkanmak gerçekten korkunç". ";
"T_GAME_QUEST_THE_BATH_B_YES_001" = "Zorunlu hamamlar!";
"T_GAME_QUEST_THE_BATH_B_YES_002" = "Bu akıllıca Sör. Artık hastalıkların ortaya çıkışında azalma var.";
"T_GAME_QUEST_THE_BATH_DESC" = "Birkaç gün önce şehrinize hamamlar kurdunuz. Bu muhteşem bir fikir olsa da kasabalılar sudan korkuyor ve kendilerini yıkamaya cesaret edemiyorlar. \n\nNe yapmalıyız?";
"T_GAME_QUEST_THE_BATH_HOTWATER_001" = "Suyu ısıtın.";
"T_GAME_QUEST_THE_BATH_HOTWATER_002" = "Hamamlara su ısıtabilmek için yeterince odun depolayalım.";
"T_GAME_QUEST_THE_BATH_HOTWATER_003" = "Muhteşem. Suyun ısısı güzel ve bazı sakinleri yıkanmaları için ikna etmeyi başardık.";
"T_GAME_QUEST_THE_BATH_HOTWATER_004" = "Ne yazık ki çabalarınız boşa gitti ve hastalık yine de şehrinizde yayılmaya başladı.";
"T_GAME_QUEST_THE_BATH_NO_001" = "Onları yalnız bırakın.";
"T_GAME_QUEST_THE_BATH_NO_002" = "Nasıl isterseniz. Köyünüzde salgınlar olursa ağlayarak gelmeyin!";
"T_GAME_QUEST_THE_BATH_NO_003" = "Sakinler birkaç ay boyunca kendilerini yıkadı. Kasabalılarımızdan birisi hasta olduğunda üç diğer kişiye de bulaştırdı! Bazıları hastalığın hamamlardan geldiğine bile inanıyordu.";
"T_GAME_QUEST_THE_BATH_NO_004_TITLE" = "Kasabalıları iyileştirin.";
"T_GAME_QUEST_THE_BATH_TITLE" = "Hamam zamanı";
"T_GAME_QUEST_THE_BATH_TRIBUTE_001" = "Rüşvetler.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_002" = "Dindarları görmeye gittiniz ve birkaç para karşılığında vaazlarında yıkanmanın onları güzelleştireceğini bildirmelerini istediniz.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_003" = "Gerekli parayı sağlayın.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_004" = "Sör, geriye kalan tek şey dindarlara parayı ödemek.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_005" = "Teşekkürler Vali, böylece mesajınızı yayacağım.";
"T_GAME_QUEST_THE_BATH_TRIBUTE_006" = "Görünüşe göre çabalarınız karşılığını verdi. Hastalık daha az şiddetli ve bir süre öyle olacak!";
"T_GAME_QUEST_THE_BATH_YES_001" = "Onları zorlayın!";
"T_GAME_QUEST_THE_BATH_YES_002" = "İşte oldu! Tellallarımız iyi haberi duyursun!";
"T_GAME_QUEST_THE_BATH_YES_003" = "Tüm köylüler düzenli olarak yıkanma fikrinden memnun değil. Bazıları ıslandıktan sonra daha zayıf hissettiklerini söylüyor.\n\nDiğerleri de suyun çok soğuk olduğunu söyleyip yıkanmayı reddediyor.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_001" = "Sihirbazı sorgulayın.";
"T_GAME_QUEST_THE_MAGICIANS_ASK_002" = "Onu sorgulamak üzereyken kalın bir duman tüm çevreyi içine çekmeye başladı, bir metre önünüzü bile göremeyecek hale geldiniz.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_001" = "Şimdi bir ikilemle karşı karşıyasınız: Ne pahasına olursa olsun gerekli kaynakları teslim edin veya durumun kötüleşmesine izin verin. Acele edip harekete geçmelisiniz, serbest gezen iki sihirbazın ne yapabileceğini kim bilir.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_BAD_001" = "Sör! Başarısız olduk, sihirbazlar kaynaklarımızı alıp kaçmayı başardı.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_001" = "Kaynakları verin.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_002" = "Bu rezil sihirbaza tüm kaynakları temin etmeye çalışalım!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_003" = "İstenilen tüm kaynakları üretebildik. Şimdi tek yapmamız gereken malları belirtilen konuma götürmek.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GIVE_004" = "Danışmanınızın arkasından sihirbazlar için bir tuzak kurdunuz. Malları almaya gelir gelmez bir ağ ile yakalanacaklar! Umalım da akıllıca fikriniz etkili olsun.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_GOOD_001" = "Sör! İkinci sihirbazı yakalamayı başardık!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_IDEA_001" = "Kaynakların yakınında bekleyen iki nöbetçiniz var. Diğer iki sihirbaz geliyor ve kaynakları almak için yavaşça yaklaşıyor. Onlar yarı yoldayken nöbetçileriniz tuzağı kuruyor.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_001" = "Pes etmeyin.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_002" = "Demek ki kardeşlerimi sinirlendirmek istiyorsunuz. Sizin yerinizde olmak istemezdim Vali.";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_003" = "Çalıştığımız adam size bunu ödetecek!";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_004" = "Ah! Nihayet birilerinin emrinde olduğunuzu itiraf ediyorsunuz! ";
"T_GAME_QUEST_THE_MAGICIANS_CHOICE_A_NO_005" = "Sihirbaz, çok hızlı konuştuğu için pişmanlık duyarak dudağını ısırıyor. Yani size şahsi olarak kızan birisi tarafından gönderilmiş.\n\nKim olduğunu ne kadar düşünmeye çalışsanız da aklınıza bir isim gelmiyor.";
"T_GAME_QUEST_THE_MAGICIANS_DESC" = "Danışmanınız panik içinde koşarak geliyor: "Sör! Sihirbazlar kapımızda! Birkaç günlüğüne misafirperverliğimizi rica ediyorlar. Kabul edelim mi?"";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_001" = "Vali… Bunların hepsi talihsiz bir yanlış anlama. Erkek kardeşlerim ve ben başınıza bu kadar bela açmak istemedik.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_002" = "Demek ki onlar senin kardeşlerin. Yangınları neden başlattınız?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_003" = "Bunu istemedik Sör. Biraz sakarız hepsi bu…";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_004" = "Kim için çalışıyorsunuz? Haydutlar mı?!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_005" = "Alakası yok! Yine de topraklarınızın tamamını yavaşça yutan koyu dumandan kurtulmak istiyorsanız isteğimi yerine getirseniz iyi olur.";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_006" = "Peki ya isteğiniz nedir? ";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_007" = "Bana kaynaklar ve para vermenizi diliyorum!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_008" = "Peki ya başka? Kardeşlerinizi nerede bulacağımızı söyleyin!";
"T_GAME_QUEST_THE_MAGICIANS_DIALOGUE_009" = "Reddederseniz daha fazla felaket bekleyin.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_001" = "Sör, sihirbazları tutan bu kişi Cannes Dükü olabilir mi? Bir anda Siz Kraliçe Frygith'e mektuplar yazmaya başladığınızda sizi tehdit ettiğini hatırladım.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_002" = "Danışmanınız haklı olabilir, şimdi Cannes Dükünün Kraliçe Frygith'e evlenme teklifi ettiğini ancak sizin buluşmanız ve şu meşhur danstan sonra onun teklifini reddettiğini hatırlıyorsunuz.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_003" = "Seni ucuz sihirbaz! Demek ki seni çalıştıran Cannes Dükü!? Her şeyi biliyoruz!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_004" = "Gerçekten de… Bunu çözdünüz. Hadi bir anlaşma yapalım. Bana güzel bir para verin ve erkek kardeşlerimle ben sizi rahat bırakalım. Sizi artık rahatsız etmeyeceğiz.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_005" = "Sör, pazarlık yapacak konumda değiliz. Ona istediği tutarı verelim de bu sihir olayı bitsin. Doğaüstü felaketlerle savaşamayız.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_006" = "Baskı altında kalmayı sevmeseniz de danışmanınızın haklı olduğunu itiraf etmek zorundasınız. Kasabalıların refahı sizin egonuzdan daha önemli.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_007" = "Tek yapmamız gereken sihirbazı serbest bırakıp ona parayı ödemek.";
"T_GAME_QUEST_THE_MAGICIANS_DUC_008" = "Sizinle iş yaptığıma memnun oldum Vali!";
"T_GAME_QUEST_THE_MAGICIANS_DUC_009" = "Sihirbaz, büyük bir tomar parayla ortadan kayboldu. Ama bir daha asla onlarla uğraşmak zorunda kalmadınız.\n\nCannes Dükü'ne gelince, Kraliçe'ye bir mektup gönderdiniz, o da bu olayı bizzat üstleneceğine söz verdi. İnsan sonuca bakmalı.";
"T_GAME_QUEST_THE_MAGICIANS_FIND_001" = "Kendinize gelip şehri alevlerden kurtardıktan sonra nöbetçiden üç sihirbazı getirmesini istiyorsunuz. ";
"T_GAME_QUEST_THE_MAGICIANS_FIND_002" = "Askerleriniz üç sihirbazdan yalnızca birisini bulabildiklerini söylüyor. \n\nDiğer ikisi kayıp.";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_001" = "Sör! İyi misiniz? Sihirbazlar binaları patlattı! ";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_002" = "Yangını olabildiğince hızlı şekilde söndürmemiz gerekiyor!";
"T_GAME_QUEST_THE_MAGICIANS_FIRE_003" = "Sonuncu yangın da kontrol altına alındı Sör.";
"T_GAME_QUEST_THE_MAGICIANS_IN_001" = "Üç sihirbaz bulunuyor. İsteklerine olumlu yanıt verdiğiniz için rahatlamış görünüyorlar. Onlara handa bir oda veriyorsunuz. Artık başka bir şeye ihtiyaçları olmadığını görünce Vali olarak görevlerinize geri dönüyorsunuz.";
"T_GAME_QUEST_THE_MAGICIANS_IN_002" = "Siz handan ayrılır ayrılmaz büyük bir patlama duyuyorsunuz. BUUUUUUUUUUM! Şimdi birkaç bina yanıyor!";
"T_GAME_QUEST_THE_MAGICIANS_NO_001" = "Girişi kapatın.";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_001" = "Ah hayır! Bir veba salgınımız var ve binalardan birkaçı yandı! Muhtemelen bir sihirbaz numarası!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_002" = "Hahahahahahahaha!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_003" = "Hadi acele edip kasabalıları iyileştirelim ve yangınları söndürelim!";
"T_GAME_QUEST_THE_MAGICIANS_PLAGUE_FIRE_004" = "Bir kez daha gerçek bir felaketten kurtulduk…";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_001" = "Aramaya devam edin.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_002" = "Araştırmaya devam edeceğiz Sör!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_003" = "İşte birisi! Yakalayın onu!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_004" = "Nöbetçileriniz ikinci sihirbazı kovalamaya başlarken aniden köyü koyu bir duman sarıyor. Nöbetçileriniz artık nereye gittiklerini göremediği için takibi durduruyor.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_005" = "Sör, yeni bir problemle karşı karşıyayız! Artık hızlı hareket edemiyoruz! Bir jölenin içinde yürüyoruz gibi!";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_006" = "Kaleye çekilip yakalamayı başardığımız bu sihirbazı sorgulamalıyız.";
"T_GAME_QUEST_THE_MAGICIANS_SEARCH_007" = "Tavsiyeye uyarak, ilk büyücünün sorgusunu başlatmak için kale arazisinde barikat kurmaya karar veriyorsunuz. Ayrıca kimsenin kaleye girip çıkmaması için baş nöbetçiden kaleyi korumasını istiyorsunuz.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_001" = "İki sihirbazı birbirinden uzakta tutmaya karar veriyorsunuz ve muhteşem tuzağınız sayesinde yakaladığınız sihirbazı sorguluyorsunuz.\n\nNe yazık ki kaynakları kurtaramadınız, üçüncü sihirbaz onları yanında götürdü.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_002" = "İkinci sihirbaz ilkinden çok daha özgüvenli görünüyor. Şüphe etmeden size şunu söylüyor: "Tebrikler Vali, beni suçüstü yakaladınız. Ama beni derhal serbest bırakmazsanız köyünüze korkunç şeyler olacağını bilin."";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_001" = "Onu serbest bırakın.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_002" = "Köyünüzün başına gelebileceklerden çok korkuyorsunuz ve onu serbest bırakmaya karar veriyorsunuz.\n\nSihirbaz "Bir oyuncusunuz Vali" diyerek nöbetçiler zincirlerini çıkarır çıkarmaz bir duman halesinin içinde ortadan kayboluyor.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_003" = "Sör! Birinci sihirbaz da kaçtı! Erkek kardeşi onun yanına geldi ve ardından her ikisi de ortadan kayboldu!";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_004" = "… Başladığımız yere döndük.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_005" = "O serseriler için devriye gezeceğiz Sör! Bize güvenebilirsiniz.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_006" = "Şimdi tek yapmamız gereken devriyelerin geri dönmesini beklemek Sör.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_FREE_007" = "Nöbetçileriniz uzun bir süre bu sihirbazları bulmaya çalışıyor. Şu zamana kadar başarısız oldular. Ne var ki gün geçtikçe herkesi yavaşlatan garip duman bulutu dağılmaya başlıyor.\n\nBu sihirbazların gizemi çözülemiyor.";
"T_GAME_QUEST_THE_MAGICIANS_SECONDE_JAIL_001" = "Onu tutsak tutun.";
"T_GAME_QUEST_THE_MAGICIANS_TITLE" = "Sihirbazlar";
"T_GAME_QUEST_THE_MAGICIANS_YES_001" = "Onları içeri gönderin.";
"T_GAME_QUEST_THE_ROOM_ANSWER_001" = "Mavi.";
"T_GAME_QUEST_THE_ROOM_ANSWER_002" = "Yeşil.";
"T_GAME_QUEST_THE_ROOM_ANSWER_BLUE" = "Cesur bir seçim olduğunu söylemeliyim. Mavi olan. Böylesine güzel bir rengi kim sevmez? Hayal, bilgelik ve sadakatin rengi. Bu sizin hakkınızda çok fazla şey söylüyor Vali.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_001" = "Sör, kalenin yenilenen odasına bir misafirimiz geldi.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_002" = "Ne yazık ki odanın renkleri onun uyumasına engel oldu ve tamamen sizi sorumlu tutuyor.";
"T_GAME_QUEST_THE_ROOM_ANSWER_FINAL_003" = "Ah Sör, misafirimiz bu odadan çok mutlu kaldı. Özellikle rengi beğendi! Bize biraz prestij vermeye karar verdi.";
"T_GAME_QUEST_THE_ROOM_ANSWER_GREEN" = "Yeşilin talihsizliği simgelemesiyle ünlü olduğu doğrudur. Fakat aynı zamanda umut, şans ve istikrarın bir simgesidir. Doğanın diğer tüm renkleri ile uyumludur. Bunun iyi bir seçim olduğunu söylemeliyim.";
"T_GAME_QUEST_THE_ROOM_DESC" = "Vali, kaledeki odalardan birisini henüz yeniledik. Hangi renk daha iyi olur?";
"T_GAME_QUEST_THE_ROOM_TITLE" = "Oda";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_001" = "Kesinlikle hayır.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_002" = "Casuslar gönderin.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_003" = "Sihir diye bir şey yoktur.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_004" = "Cadıyı çağırın.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_CHOICE_002" = "Sör, bu korkunç. Bu nasıl mümkün olur? Kara büyüde usta bir sihirbaz olabilir mi? Kimse böyle bir güce sahip olmamalı!";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_001" = "Bu akıllıca bir karar. Hadi en iyi casuslarımızı bu çılgın kasabalıyı takip etmesi ve raporlarını beklemesi için gönderelim.";
"T_GAME_QUEST_THIEF_OF_JOY_ANSWER_SPY_002" = "Casuslarınız bir rapor ile döndü.\n\n"Bu kasabalıyı takip ettik, neşe hırsızını. Görünüşe göre sözleri sakinlerde büyük üzüntü yaratıyor. Kasabalılar hayatlarının neşeli anlarını hatırlamıyor."";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_001" = "Sör! Görünüşe göre sakinlerimizden birisi yoldaşlarından neşe çalıyor.\n\nBirkaç kasaba bu hırsız hakkında şikâyette bulundu. İşte kurbanlardan birisinin ifadesi: "Bir sabah benimle konuşmak için geldi. Onu dikkatle dinledim ve aniden çok üzgün hissettim. Sanki söylediği kelimeler neşemi tüketmişti."";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_002" = "Sör, bu sorunu çözmek için bir şey yapalım mı?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004" = "Vali, ne yapmalıyız?";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_A" = "Cadıya yardım edin.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_004_B" = "Hayalet diye bir şey yoktur!";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005" = "Sör, görünüşe göre aldığımız önlemler gayet işe yarıyor. \n\nNeşe hırsızı kötülüklerine devam ediyor ama artık onunla savaşacağız. \n\nNöbetçileri gönderip hareketleri için onu adalete teslim edelim mi? ";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_A" = "Adalet yerini bulsun.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_005_B" = "Hiçbir şey yapmayın.";
"T_GAME_QUEST_THIEF_OF_JOY_DESC_MAGIC_001" = "Siz mantıklı birisiniz. Bu neşe hırsızı sorununu yalnızca bilim açıklayıp çözebilir.\n\nEn iyi bilim insanlarınızı kasabalıların yeniden mutlu olmasına olanak sağlayacak bir formül üzerinde çalışmaları için çağırın.\n\nElbette bilim ücretsiz değildir. Bilim insanları çok para istiyor. Yoksa hep birlikte mutluluğa veda edebilirsiniz.";
"T_GAME_QUEST_THIEF_OF_JOY_END_001" = "Bu neşe hırsızı sorunu sizi yeterince endişelendirmedi. Ne var ki depresyondaki kasabalı vakaları hızla artmaya devam etti.\n\nKafası karışmış bir halde kalenize sığındınız. Bu felaket konusunda ne yapacağınızı bilmiyorsunuz. Zamanın tüm yaraları sardığını söylerler. \n\nUmalım da sabrınız tükenmesin.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002" = "Cadı gitti. Bazıları onun köyü bile terk ettiğini söylüyor, sizin yüzünüzden diğerleri gibi çile çekmek istememiş.";
"T_GAME_QUEST_THIEF_OF_JOY_END_002_A" = "O gittikten kısa süre sonra. Durum katlanılamaz hale geldi. Tüm köylüler derin üzüntü yaşıyor.\n\nBunun ne kadar süreceğini kim bilir?";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_001" = "Onu yakalaması için nöbetçileri gönderelim!";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_002" = "Nöbetçileriniz saatlerdir araştırıyor. Hiçbir şey yok. Hepsi üzgün ve depresif bir halde geri döndü. Yine de neşe hırsızını duyduklarını ama onu hiç görmediklerini söylüyorlar.";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_003" = "Nöbetçiler döndükten kısa süre sonra bir baykuş uçarak geldi ve cadıdan bir mesaj getirdi.\n\nNeşe hırsızının insanların neşesiyle beslenen bir hayaletten başka bir şey olmadığını söyledi. Onları üzüntü ve umutsuzlukla bırakıyormuş. ";
"T_GAME_QUEST_THIEF_OF_JOY_END_003_004" = "Bilim insanlarınızın süreci erteleme çabalarına rağmen köyün tamamı mutsuz kaldı. Ama cadı gidince kendinizi bu hayalete karşı savunmak için hiçbir yaklaşımınız olmadı. \n\nUmalım da zaman kasabalıları iyileştirsin.";
"T_GAME_QUEST_THIEF_OF_JOY_END_FOR_ALL" = "Zaman geçti ve köy iyi haline geri döndü. Neşe hırsızı artık uzak bir hatıradan başka bir şey değil.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_ASK_WITCH" = "Cadıdan tavsiye isteyin.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE" = "Pazarlık yapın.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_001" = "Sör, bu bilim adamlarıyla anlaşma yapmaya çalışacağım. Benim yapmama izin verin, her şeyle ilgileneceğim!";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_DOWN" = "Danışmanınız, bu sıkı pazarlıkçı bilim insanlarının ücretini düşürmeyi başardı! İyi iş. ";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_NEGOCIATE_UP" = "Eyvah. Danışmanınız düzgünce anlaşma yapmayı başaramadı. Bilim insanları artık fiyatlarını artırdı ve artık sizinle görüşmek istemiyorlar.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY" = "Bilim insanlarına ödeme yapın.";
"T_GAME_QUEST_THIEF_OF_JOY_MAGIC_PAY_001" = "Ödeme yapmamız gerekiyorsa yapalım, beklemeye devam edersek felaketimiz olacak.";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_001" = "Vali, sakinleriniz bariz şekilde depresyon geçiriyor. Hiçbir şeye iyi yanından bakamıyorlar. \n\nÇözüm onlara hayatın aydınlık yanını göstererek hayatın o kadar da boğucu olmadığını kanıtlamak. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_002" = "Hadi birkaç dekorasyon ekleyip içki festivali alanları inşa ederek başlayalım. Müzik insanların moralini düzeltir. ";
"T_GAME_QUEST_THIEF_OF_JOY_PSY_003" = "Şehir daha iyi hissetmeye başlıyor. Neşesi yok olan bazı sakinler hayattaki küçük mutlulukları yeniden fark etmeye başlıyor gibi görünüyor.\n\nNe var ki neşe hırsızı insanların yüreklerine korku salmaya devam ediyor.";
"T_GAME_QUEST_THIEF_OF_JOY_TITLE" = "Neşe hırsızı";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_001" = "Vali, bu cadıdan yardım almayalı yıllar oldu… Umarım bu köyümüze zaten olduğundan daha fazla sefalet getirmez.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_002" = "Günaydın Vali. Sizi yeniden görmek güzel. Demek başınız belada?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_003" = "Durumu cadıya açıkladıktan sonra gülümsedi. Sorununuzun çözümünü mü buldu yoksa size kötü bir oyun mu oynuyor?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_004" = "Pekâlâ, konuşun o halde! Neden bu şekilde gülümsüyorsunuz? ";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_005" = "Sizin neşe hırsızınız aslında yok, Sör.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_006" = "Yine de doğru olmalı çünkü casuslarımızdan birisi onunla konuştuktan sonra sonuçlarına maruz kaldı!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_007" = "Yalnızca bir üzüntü hayaleti görmüş. Bazen dini bir yapının inşaatından sonra ortaya çıkar. Bunlar insanların neşesinden beslenen ruhlardır. \n\nHayalet neşeyi emerek güç kazanır ve güçlerini artırır. Ne yazık ki insanlardan çaldığı neşe geri dönmez.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_008" = "Bundan nasıl kurtuluruz?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_009" = "Bir çözüm biliyorum ancak sizin yardımınıza ihtiyacım olacak.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_001" = "Size yardım edeceğiz. Neye ihtiyacınız var?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_002" = "Bir anıt mezar ve mezar taşlarına ihtiyacımız var.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_003" = "Bitti sayılır!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_004" = "Görevinizi tamamladık cadı. Bize ne yapabileceğinizi gösterme zamanı.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_005" = "Cadı anıt mezara giriyor ve içeride kayboluyor. Büyülü sözler duyuyorsunuz. Aniden rüzgâr şiddetleniyor, korkunç bir fırtına ortaya çıkıyor gibi görünüyor.\n\nCadı hâlâ bu anıt mezardan çıkmış değil. \n\nAniden büyük bir üzüntü hissediyorsunuz. Çok soğuk ve karanlık tarafından kuşatılmış hissediyorsunuz.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_006" = "Sonra uzaktan bir ışık görünüyor. Çok ufak bir güneş ışığı. Ona odaklanıyorsunuz. Gittikçe daha fazla yoğunlaşıyor. \n\nGüneş ışığı bir anıya dönüşmeye başlıyor. Size ait. En mutlu anınız.\n\nYeniden iyi hissediyorsunuz.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_007" = "Vali… Bu da neydi? Bunu siz de hissettiniz mi?";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_008" = "Sör, artık üzüntü hayaletinden kurtuldunuz. Yüzünüzün haline bakılırsa da onunla karşılaşmışsınız sanırım. Artık bitti. O hapsoldu.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_009" = "Bu korkunçtu! Çok teşekkür ederim!";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_A_010" = "Köy artık bu garip hayaletten kurtuldu. Sakinler neşelerine kavuştu ve size minnet duyuyorlar.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_001" = "Sör, bu hayalet projesinde bana yardım etmezseniz bunun felaketiniz olacağının garantisini verebilirim.";
"T_GAME_QUEST_THIEF_OF_JOY_WITCH_B_002" = "Öyle olsun! Şeytani büyülerinizi alıp yıkılın karşımdan!";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_001" = "Oynamalarına izin verin.";
"T_GAME_QUEST_TOWER_GAMES_ANSWER_002" = "Oynamak istiyorum!";
"T_GAME_QUEST_TOWER_GAMES_CONSEQUENCE_002" = "Bir masa oyunu festivali mi?! Ne garip bir fikir sör. Bunu nasıl yapacağız? ";
"T_GAME_QUEST_TOWER_GAMES_DESC" = "Sör, askerlerimiz izleme kulelerinde o kadar çok oyun oynuyor ki sakinler korunduklarını hiç hissetmiyor. Ne yapmamız gerekiyor?";
"T_GAME_QUEST_TOWER_GAMES_TITLE" = "Kule Oyunları";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_001" = "Tahta ve taşa ihtiyacımız var.";
"T_GAME_QUEST_TOWER_GAMES_TOWER_GAMES_BOARDGAME_002" = "Oyun fikirleri ve tasarımcılar bulmalıyız.";
"T_GAME_QUEST_TRIBUTE_MONEY_DESC" = "Efendim, ufak bir bağış ile Krala karşı olan saygınlığımızı artırabiliriz.";
"T_GAME_QUEST_WATCHTOWER_INRANGE" = "Kışla menzilinde bir nöbetçi kulesi inşa edin.";
"T_GAME_QUEST_WATER" = "Su";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_001" = "Sessiz olun, olur mu?";
"T_GAME_QUEST_WATER_DREAMS_ANSWER_002" = "Bu tür olayların olmasını engellemek için kuyuyu inşa edelim.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_001" = "Ah Sör lütfen, mahsullerimiz tehlikede, bir şey yapmazsanız huzurlu bir kış geçirme şansımız asla olmayacak.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_002" = "Vali bu konuda zaten konuştu. Sürekli kaleye gelip söylenmeye devam ederseniz sizi bir yere kilitlememiz gerekecek. ";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_003" = "… Yakında hayal kırıklığına uğrayacaksınız!";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_A_004" = "SÖR! TARLALAR! Korkunç! Artık hiçbir şey büyümüyor, sıcaklık o kadar yakıcı ki mahsullerimiz mahvoldu. Çiftçiye biraz daha fazla güvenmeliydiniz… Artık çok geç.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_001" = "Acele edip kuyular inşa edelim Sör.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_002" = "Kuyuların inşaatı tamamlandı. Önlem ilaçtan daha iyidir! Gelecek bize bu çiftçiyi dinlemekte haklı olup olmadığımızı gösterecek.";
"T_GAME_QUEST_WATER_DREAMS_CONSEQUENCE_B_003" = "Ah Sör! Çiftçiler bana bir sıcaklık dalgasının tarlalarına vurduğunu ama kuyuların inşaatı sayesinde birçok dertten kurtulduğumuzu söyledi.";
"T_GAME_QUEST_WATER_DREAMS_DESC" = "Sör! Başka bir önsezili rüya gördüm! Tarlalar yanmıştı. Artık hiçbir şey yetişmiyordu. Hiç su yoktu.";
"T_GAME_QUEST_WATER_DREAMS_TITLE" = "Önsezi";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_A" = "Onu sakinleştirmek için bir bitki çayı verin. ";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_001_B" = "Pekâlâ, bitki çaylarından bahsetmişken, fikri yayacağız. Civardaki şehirlere bitkiler ve sıcak suyun akılda kalıcı bir sloganla harika olduğunu duyurun.";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002" = "Savunmaları iyileştirin!";
"T_GAME_QUEST_WITCHS_PATH_ANSWER_002_B" = "Vali, hadi askeri savunmaları iyileştirelim!";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_001" = "Harika bir iş çıkardık, "size koyunları unutturan bitki çayı" yenilikçi bir slogan…";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002" = "Şimdi bekleyelim… Tek bildiğimiz bunca kargaşayı bir hiç uğruna yaptığımız. Ona bir bitki çayı vermeliymişiz.";
"T_GAME_QUEST_WITCHS_PATH_CONSEQUENCE_002_FINAL" = "Beklentilerinize ve haydutlar tarafından sürpriz saldırılar yapılması durumunda savunmaların iyileştirilmesine rağmen hiç gelmediler. Yine de artık doya doya bakabileceğiniz birkaç güzel askeri binanız var.";
"T_GAME_QUEST_WITCHS_PATH_DESC" = "Ah hayır Sör. Yaşlı kadın yeniden iş başında! Çatılardan bağırarak orman cadısının köyümüze gelip yoluna çıkan her şeyi yıkacağını söylüyor.";
"T_GAME_QUEST_WITCHS_PATH_TITLE" = "Cadının Yolu";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_001" = "Ah Sör! \n\nAşağısı inanılmaz! Enginlik ve güzellik dolu bir göl! \n\nKadın oradaydı! Madenin tünellerinde onu gözden kaybetmeden önce peşinden bir kilometre koştum.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_ADVISOR_002" = "Ve sonra… Eve eli boş döndüğümü düşündüğümde binlerce ışık gördüm. Ah Sör, onu görmeliydiniz, daha önce hiç öyle bir şey görmedim! \n\nBana tüm ganimetle birlikte kaçıp başka bir yerde yeni bir hayata başlama planlarından bahsetti. Kocasının ölümünden beri burada kalmakta zorlanıyormuş, çok fazla anısı varmış…";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001" = "Sör, ganimeti bulmak için madene girmeye artık hazırız. Haritada birkaç çarpı işareti atılmış.\n\nNereden başlayalım? ";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_NORTH" = "Kuzey Saklanma Yeri";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_ANSWER_SOUTH" = "Güney Saklanma Yeri";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_COLLAPSE" = "Ah SÖR! Şanslıydık! Takımımız yaralanmadan kaçmayı başardı. Tüneller çöktü!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_001_TREASUR" = "Bu ilk seferin sonucu oldukça memnun ediciydi! İnsanlarınız bu seferden sağ salim ve ek olarak korsanın hazinesinin bir kısmıyla dönmeyi başardı.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002" = "Sör, madene ikinci kez girmeye artık hazırız.\n\nHangi saklanma yerini kontrol edelim?";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_EAST" = "Güney Saklanma Yeri";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_ANSWER_WEST" = "Batı Saklanma Yeri";
"T_GAME_QUEST_WOMAN_MINE_DECISION_DIRECTION_002_TREASUR" = "İnanılmaz bir fırsat ayağımıza geldi Sör! Bu hazine avından ikinci kez galip çıktık!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_002" = "Maden planlarını dikkatlice inceliyorsunuz. Bir nehir tarafından beslenen, doğrudan denize giden bir yeraltı gölünün konumunu görebilirsiniz. Korsanlar için oldukça kullanışlı bir erişim!\n\nNeyse, bu tüneller güvenli değil ve her an yıkılma tehlikesine sahipler.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_003" = "İyi haber! Siz bu demirciye yardım ederken danışmanınız madenin planlarını almayı başardı.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_001" = "Madeni güvenli hale getirin.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_PLAN_ANSWER_002" = "Bu madene öncüler gönderin!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_001" = "Sör, güvenli hale getirilebilmesi için madene yatırım yapalım. Bu bizden çok fazla kaynak gerektiren bir görev ancak buna pişman olmayacağınızın garantisini veririm.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_002" = "İnanılmaz Sör! Madeni güvenli hale getirmeyi başardık! İlk öncülerimiz devriyeye çıktı ve korsanın eşini buldu!\nKaçmayı başardı ancak çarpı işaretli bölgelerle madenin bir haritasını bırakmış. Sanırım bunlar hazinenin saklı olduğu bölgeler!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_MINE_SECURITY_TRIBUTE_VALIDATE" = "Sör, şimdi tek yapmamız gereken haraç ödemek.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_001" = "Öncüler, öncüler… 50 tane yoklar! Bunu kendim yapacağım. Ancak benim, en azından ilk önce belirli ekipmana ihtiyacım var.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_002" = "Pekâlâ, tamamen hazırım!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_003" = "Danışmanınız bu kadın hakkında daha fazlasını öğrenmek için madenlere gitti.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_SCOUTS_QUEST_DESC" = "Bu görevi başarıya ulaştırmak için bana gerekli ekipmanı getirin.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_001" = "Bir anda bu demirciye olan sabrınız tükendi. Bu ekipmanı olabildiğince kısa süre içinde almasını emrediyorsunuz ve acil siparişinin sizin probleminiz olmadığını söylüyorsunuz. İflas etse bile umursamadığınızı da.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_002" = "Ben… Olabildiğince kısa süre içinde bunu size getireceğim Sör…";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_003" = "Bu demirciye yardım etmeyi reddederek kabalık ettiniz. Anlamanız gerekiyor ki geçimini sağlaması için çalışması gerekiyor ve bu teslimat şehrimizin ekonomisi için oldukça önemli görünüyordu. Umarım bunu bizim aleyhimize kullanmaz.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_NO_004" = "Eyvah Sör… Daha dikkatli olmalıydınız. Demirci herkese ona nasıl davrandığınızı anlatmış. Şimdi birkaç kasabalı protesto yapıyor. Ayrıca demirci kaleye dönmeyi reddediyor.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_001" = "Sör, atlı mızrak alanı inşa etmekten başka bir alternatif görmüyorum. Bu insanların dikkatini dağıtır ve onların gevşemesini sağlar.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_002" = "Sakinler yatışmış görünüyor. Ancak bu korsan hikâyesiyle işimiz bitmedi!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_DESC" = "Sör, atlı mızrak alanları gerekli. Yoksa kasabalılar ne mutlu olacak ne de üretken. Bu grev korsan ve maden olayı için olan değerli vakti boşa harcayacak.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_001" = "Sör, biz bu isyanla meşgulken korsanın eşi madenlerdeki ganimeti alma fırsatını yakaladı. Hazine oradaymış!";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_002" = "Casuslarımız bu kadına ait, kocasının yokluğuna daha fazla dayanamayacağını ve küçük bir kaleye sahip olduğu cennet gibi bir adada kendini bir süre uzaklaştıracağını söyleyen bir not buldu.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_END_EVENT_003" = "Sör, görünüşe göre büyük bir miktar parayı kaçırdık. Düşünmeden karar verişiniz bizi nereye götürdü görüyor musunuz? Neyse, bu olayın üzerine bir bardak su içebiliriz.";
"T_GAME_QUEST_WOMAN_MINE_DECISION_TOOL_REVOLTE_TITLE" = "Bir atlı mızrak alanı inşa edin.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_001" = "Böyle bir kararı ciddiye almamakla hata yaptınız Sör. Ne keşfedebilirdik kim bilir?";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_002" = "Siz bu şikâyetle ilgilenmeyi reddettikten birkaç gün sonra maden çöktü. Halkınız bu trajik olaydan sizi sorumlu tutuyor.";
"T_GAME_QUEST_WOMAN_MINE_EARLY_END_A_003" = "Halkınız tüm bu madenin çökmesi olayını unutmaya başlıyor. Zaman geçti ve moralleri yüksek.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_001" = "Haritada belirtilen konumlara erişmeyi başaramadık Sör. Hiç ganimet getiremedik. Ama hayattayız, en önemlisi de bu.";
"T_GAME_QUEST_WOMAN_MINE_END_COLAPSE_A_002" = "Başarısızlığınıza rağmen maceranız size biraz prestij kazandırdı. Korsanların böyle hazineleri sizin madenlerinize saklayacağını kim düşünürdü?\n\nYine de şimdilik bir hazine avcısı olarak kariyeriniz sona erdi.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_001" = "Ah Sör. Madendeki tünellerin çöktüğü söylendi! İkinci kez hazinelerle dönebildiğimiz için şanslıyız.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_002" = "Bir defalığına size bu hazineleri getirdiği için nezaketle onlara teşekkür etmek için askerlerinize büyük bir yemek düzenlemeye karar verin.\n\nBu korsan hikâyesi artık çok geride kaldı. Kim bilir? Belki de bir gün sizi diğer gizemlere götürecek bir harita bulursunuz.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES" = "Hazine yakında sizin olacak! \n\nAskerlerinize gidip bu hazineyi bulup size getirmeleri için emir verin.";
"T_GAME_QUEST_WOMAN_MINE_END_TWO_TREASURS_SECURE_MINES_GOOD_END" = "İnanılmaz! Şu madenlerde bulduğumuz bunca şeye baksanıza! İnsanlarınızı oraya göndermeden önce onları güvenli hale getirmekte haklıydınız. İnanılmaz bir zenginlik! Bu korsan hakkındaki söylentiler bunca zamandır doğruydu. Artık zenginiz!";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001" = "Elimizdeki bilgilerle yapacağımız çok bir şey yok. Tavsiye için bir uzman aramak akıllıca olur.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001" = "Bir madenci çağırın.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_DESC" = "Bu iyi bir fikir Sör. Belki de bize madenlerin bir haritasını verip daha fazlasını anlamamıza yardımcı olabilirler.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_001_GOT_TUNNEL_PLAN" = "Sör, yardım etmemi istemenize sevindim. Yanımda madenlerin planını getirdim. Umarım bu size yardım eder.\n\nBu tüneller eski, yıkılmalarından korkuyorum.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002" = "Demirciyi çağırın.";
"T_GAME_QUEST_WOMAN_MINE_EXPERT_DECISION_001_ANSWER_002_DESC" = "Demirci bize bu kadının kırmaya çalıştığı taşlar hakkında bize nasıl bilgi sağlayacağını kesinlikle bilir.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_A" = "Sör, madenler hakkında birkaç şikâyet aldık.\nBir kadın her gün oraya gidiyor, taşları bazen hareket ettiriyor bazen de kırıyormuş. Ama kesin olan bir şey tünellerde her zaman daha da ileri gitmesiymiş.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_001" = "Gidip bu kadın hakkındakileri öğrenin.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_ANSWER_002" = "Bu benim sorunum değil.";
"T_GAME_QUEST_WOMAN_MINE_INTRO_B" = "Kasabalılar endişeleniyor, tüneller güvenli değil ve maden her an çökebilir.\n\nBu hikâyenin ardında ne olduğuna bakmak bizim görevimiz.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_001" = "Umarım dersinizi öğrenmişsinizdir!";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_002" = "Danışmanınız ipuçları ararken kasabanızla bir süre ilgilenmeniz iyi bir fikir olur. Halkınızın hayatını iyileştirmeye çalışın.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_003" = "İşte yine buradayım Sör! Biz gizli takip operasyonuyla bu kadını takip ettim. Kolay olmadı.";
"T_GAME_QUEST_WOMAN_MINE_INVESTIGATION_B_004" = "Görünüşe göre bir nesne arıyor. Birkaç taş kırıp molozlara dikkatlice baktığını gördüm.\n\nNe yazık ki onu fazla uzağa kadar takip edemedim. Madenleri avcunun içi gibi biliyor gibi görünüyordu!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_001" = "Danışmanınız görevinden haberlerle döndü.\nRaporunda bu kadının kısa süre önce dul kaldığı yazıyor. \n\nEşi ünlü bir korsanmış. Gelmiş geçmiş en büyük hazineye sahip olduğu ve onu buralara yakın bir yere sakladığı söyleniyor.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_002" = "Sör, bir teorim var. Bence bu kadın hazinenin tam olarak nerede saklı olduğunu söylemesi için diğer korsanlar tarafından tehdit edilmiş!";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_001" = "Araştırmaya devam edin.";
"T_GAME_QUEST_WOMAN_MINE_REPORT_A_ANSWER_002" = "Boş verin.";
"T_GAME_QUEST_WOMAN_MINE_TITLE" = "Kadın ve maden";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_001" = "Demirci aceleyle geldi. Nöbetçileriniz onu nalbant dükkânından çekip almış. Endişeli görünüyor.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_002" = "Sör, sizin için ne yapabilirim?";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_003" = "Şu anda bir görevdeyiz ve sizin uzmanlığınıza ihtiyacımız var.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_004" = "Dinliyorum.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_005" = "Danışmanınız durumu demirciye açıklıyor.\n\nAyrıca ona toplayabildiği kırık taşları da gösteriyor. Gözünüzün ucuyla demircinin bu türden taşı tanıyabildiğini görebiliyorsunuz.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_006" = "Amanın! Burada çok fazla jeot var!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_007" = "Jeot mu dediniz? ";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_008" = "Özel kristaller, hazineler içerebilirler. Sıklıkla çok değerli olanlar kristaller.\n\nBazı korsanlar hazinelerini nereye sakladıklarını hatırlamak için jeotlara dayalı kodlar kullanırdı.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001" = "Atölyemde birkaç tanesi var, doğru aletlerle onları nasıl açacağınızı size gösterebilirim.\n\nAma… Yapılması gereken önemli ve acil bir teslimatım var ve sizin yardımınız çok işe yarar. Size sağladığım bilgiler için bir minnet sembolü olarak.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_NO" = "Reddedin.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "Kabul edin.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "Madenciler için aletler üretmeliyim. Bu büyük bir emir.";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "Bunlar jeotlar. Bakın, size göstereyim. Bu alet ile kolaylıkla açılabilirler. Genellikle özel bir şeyleri yoktur ama bazen saf mucizelerle karşılaşabiliriz!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_003" = "TA TA… TAK!";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_004" = "Ah sör, bu jeotun içine bakın! Bu muhteşem bir şey!";
