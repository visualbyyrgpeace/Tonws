"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_001" = "Peki ya başka? Yapacak başka işlerim var.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_ANSWER_002" = "Cadıya gidin.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_006_B" = "Cadıya gidip onun tavsiyesini isteyebiliriz. Belki de ünlü dev tavşan hakkında bir şey biliyordur.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_A" = "Sizi bekliyordum. Kargalar gelişinizi önceden haber verdi. Ne kadar gürültücülerdi. Yine de tavşanların zıplayışından daha az gürültülü.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_001" = "Dua edin.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_002" = "Sihir kullanın.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_ANSWER_003" = "Hiçbir şey yapmayın.";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_B" = "Doğru mu yani?!";
"T_GAME_QUEST_GIANT_RABBIT_DESC_007_C" = "Emin olabilirsiniz! Buraya gelmeniz uzun sürdü. Neyse ki hâlâ vakit var. Artık düşünecek birkaç seçeneğiniz var.";
"T_GAME_QUEST_GIANT_RABBIT_END_001" = "Hiçbir şart altında sakinlerinizi umursamadığınızı görüyorum Sör… Bunun en sonunda bir geri dönüşü olacak.";
"T_GAME_QUEST_GIANT_RABBIT_HUNT" = "Peki, hadi iki avcı kulübesi inşa edip biraz et toplayalım. Kim bilir, biraz şansımız olursa dev tavşanın yuvasını bulabiliriz.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_001" = "Bu benim tarlam. Size ufak bir iksir yapacağım ama bana birkaç malzeme getirmelisiniz. ";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_002" = "Pekâlâ? Bana o malzemeleri verecek misiniz?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_003" = "Çok teşekkür ederim Sör. Lanet olsun! Şimdi de malzemelerin diğer yarısını unuttum.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_004" = "Ah, bütün gün vaktimiz yok Sör. Yapacak bir iksirim var. Neden malzemeleri bana şimdi vermiyorsunuz?";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_005" = "Çok teşekkürler Sör. İksiri alın. Birazını köy kuyusuna dökün ve bir süre bekleyin. Dev tavşan bunu kokladıktan sonra kendiliğinden gidecektir.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_006" = "Sör… Kasabalıların üzerindeki kokudan kurtulmak için hamamlar inşa edip birkaç esans yağı eklememiz gerekiyor… Bu gerçekten korkunç.";
"T_GAME_QUEST_GIANT_RABBIT_MAGIC_007" = "Harika! Bu kasaba artık yeniden nefes alabilir!\nTavşan sanki sadece bizim bir hayalimizmiş gibi bir iz bırakmadan gitti. Lordum, şimdilik işimize geri dönelim.";
"T_GAME_QUEST_GIANT_RABBIT_NOTHING" = "Her şeye rağmen tavşan kendiliğinden gitti. Son zıplayışlarından birinde uzun süre önce haydutlar tarafından gizlenen bir sandığı çıkarttı. Sandıkta 2000 altın para vardı ve kral bize prestij verecek kadar onurlandırdı!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_001" = "Pekâlâ… Nihayet bir kilise inşa etmeyi düşünmeniz için dev bir tavşanın gelmesi gerekti!";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_002" = "Acele edip bu kiliseyi inşa edelim ve sakinleri dua etmek için toplayalım.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_003" = "Geriye kalan tek şey kutsal olanın işini yapmasını beklemek.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_004" = "Tavşan, sanki sadece bizim bir hayalimizmiş gibi bir iz bırakmadan gitti. Lordum, şimdilik işimize geri dönelim.";
"T_GAME_QUEST_GIANT_RABBIT_PRAY_005" = "Eyvah. Ben iksiri seçerdim ama patron sizsiniz! Gelecek talihsizlikler konusunda bol şans Sör.";
"T_GAME_QUEST_GIANT_RABBIT_TITLE" = "Dev tavşan";
"T_GAME_QUEST_INN_STARTED" = "Sör, ilave konaklama gerekli olacak. Neden bir han inşa etmiyoruz? Böylece festival ziyaretçilerinin ihtiyaçlarını giderebileceğiz.";
"T_GAME_QUEST_INN_SUCCESS" = "Pekâlâ, iyi bir şey yaptık. Hadi acele etmeden hazırlıkların kalanını düşünelim.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_001" = "Bu fazla riskli.";
"T_GAME_QUEST_KINGS_MADMAN_ANSWER_002" = "Neden olmasın.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_001" = "Şakacıyı.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_A_002" = "Kralın sarayı çok mutlu! İhtiyaç duydukları şey tam da buydu! Prestij bizimdir! ";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_001" = "Bilmeceleri olan kasabalı hanım.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_B_002" = "Ne yazık ki bilmeceler… Onlar için fazla karışıktı. Kralın sarayı biraz daha az entelektüel bir şeyi tercih ederdi. Bu sefer prestij kazanmayacağız.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_001" = "Akrobat kasabalı.";
"T_GAME_QUEST_KINGS_MADMAN_CANDIDAT_C_002" = "Kralın sarayı bu yetenekli akrobata bayıldı! Kral ödül olarak bize biraz prestij gönderecek.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_A" = "Haklısınız, kral adaylarımızdan memnun kalmazsa neler olabileceğini kim bilir.";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_001_B" = "Sör, başkentten bir mesaj aldık. Kral, şehrimizden hiç kimsenin gelip hizmetlerini teklif etmediği için hayal kırıklığına uğramış. Neyse ki bizi böyle saçma bir şey için suçlamayacak. Kral çok merhametli!";
"T_GAME_QUEST_KINGS_MADMAN_CONSEQUENCE_002" = "Üç potansiyel aday buldum. Hangisini gönderelim?";
"T_GAME_QUEST_KINGS_MADMAN_DESC" = "Lordum, kral onu eğlendirmesi için bir soytarısı olsun istiyor. Sarayın yeni şaklabanı olacak potansiyel adayları gönderelim mi?";
"T_GAME_QUEST_KINGS_MADMAN_TITLE" = "Saray Soytarısı";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_001" = "Çatıyı onarın.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_A_002" = "Bunu olabildiğince hızlı şekilde onarmamız gerekiyor!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_001" = "Şimdi değil.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_002" = "Şu anda başka önceliklerimiz var, lavanta festivali yakında başlıyor ve hazırlıklar hazır değil.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_003" = "Konusu açılmışken, her şeyi hazırlamayı tamamlamalıyız.";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_004" = "Böylesi daha iyi! Bu kazançlı bir etkinlik olmayı vaat ediyor!";
"T_GAME_QUEST_KING_OF_WOOD_ANSWER_B_005" = "Sör, lavanta tüccarlarının katedralimize çok değer verdiğini duydum. Festivalimize gitmeye istekli değiller!";
"T_GAME_QUEST_KING_OF_WOOD_BAD_ENDING" = "Lavanta festivali bir aksilik olmadan başladı… Yine de eskisi kadar çok ziyaretçimiz olmadı. Bu etkinlik bize hiç prestij getirmedi.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_001" = "Anlaştık!";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_002" = "O halde acele edin ve kraliçe için malları üretin.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_003" = "Şimdi tek yapmamız gereken takası gerçekleştirmek.";
"T_GAME_QUEST_KING_OF_WOOD_DEAL_004" = "Sizinle iş yapmak bir zevk.";
"T_GAME_QUEST_KING_OF_WOOD_DESC" = "Sör! Kötü haberlerim var! Kültürümüzün dünyaca bilinen sembolü gece yandı! Büyük katedralin artık bir çatısı yok!";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_001" = "Uzmanlar artık bunu onarmak için ulu odunumuz olmadığını söylüyor. Ama Kraliçe Frygith görünüşe göre gerekli kaynaklara sahip, ondan yardım isteyelim mi?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_001" = "Yardım isteyin.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_002" = "Aceleyle kraliçeye bir haberci gönderiyorsunuz. \n\n"Kraliçe Frygith, bana yardım edin! Toprağınızdaki bu ulu odunu sizden ödünç alabilir miyim? Katedralim yıkılıyor."";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_003" = "Merhaba tatlım, zamanlamanız çok doğru, benim de meyve suyu stoku yapmam gerekiyordu, arkadaşça bir takas yapmak ister misiniz? İhtiyacınız olan odun karşılığında kavanozlarca meyve suyu.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_004" = "Sör, bu bizim lehimize olan bir teklif değil…";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_A_005" = "Bu anlaşmanın artılarını ve eksilerini ölçün. Belki de kraliçe tüm endişelerinizin çözümü olacaktır… Elbette başka bir yol yoksa?";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_001" = "Bunu düşünün.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_002" = "Bu istek ünümüze zarar verebilir, farklı ilerleyeceğiz. ";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_003" = "Danışmanınız haklı olabilir. Kraliçe Frygith'ten yardım istemek sizi onun iyi haline bağımlı kılabilir. Bir sorun olursa çok fazla şeyi kaybetmeyi riske almış olacaksınız.\n\nNeden taş kullanmıyorsunuz? Madenlerde bolca bulunuyor.";
"T_GAME_QUEST_KING_OF_WOOD_EXPERTS_B_004" = "Bu iyi bir karardı Sör! Özgür ve bağımsızız.";
"T_GAME_QUEST_KING_OF_WOOD_GOOD_ENDING" = "Lavanta festivali bir başarı oldu. Katedralin restorasyonuyla ilgili son hikâyeler çok fazla coşkuya yol açtı ve biz de bundan faydalandık!";
"T_GAME_QUEST_KING_OF_WOOD_NO_LAVANDER_001" = "Lavantayı hiç sevmem.";
"T_GAME_QUEST_KING_OF_WOOD_REPAIR_001" = "Pekâlâ, bu sorun değil! Onu onaracağız.";
"T_GAME_QUEST_KING_OF_WOOD_SING_001" = "Şok edici.";
"T_GAME_QUEST_KING_OF_WOOD_SING_002" = "Sör, bu bir şantaja benziyor. Bu kraliçeyle uğraşmamak için taş kullanmamıza izin verin!";
"T_GAME_QUEST_KING_OF_WOOD_SING_003" = "Pekâlâ, bunu unutmayacağım tatlım.";
"T_GAME_QUEST_KING_OF_WOOD_TITLE" = "Odun Kralı";
"T_GAME_QUEST_LACK_SPACE_ANSWER_001" = "Bununla ilgileneceğim.";
"T_GAME_QUEST_LACK_SPACE_ANSWER_002" = "Mutlu değillerse bundan sonra gelmesinler.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_001" = "Tüccarların pazar dışında onlara adanmış bir yere sahip olmanın faydasını göreceği doğru. Sör, bir Esnaf Loncası kusursuz bina olur.";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_A_002" = "Muhteşem, Sör! Buna katıldığınız için teşekkürler. Sonsuza kadar minnettarız!";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_001" = "Sizin gibi modern bir vali tüccarların isteğini kabul etmeliydi…";
"T_GAME_QUEST_LACK_SPACE_CONSEQUENCE_B_002" = "Sör, ben tüccarların temsilcisi olarak geldim. Hayal kırıklığımızı göstermek için bir süre şehrinize gelmeyeceğiz! ";
"T_GAME_QUEST_LACK_SPACE_DESC" = "Sör, tüccarlar federasyonu işlevlerine uyan binalar inşa etmenizi istiyor.";
"T_GAME_QUEST_LACK_SPACE_TITLE" = "Alan azlığı";
"T_GAME_QUEST_MICE_AND_SOLDIERS_DESC" = "Siz henüz uyanırken danışmanınızın size korkunç bir haberi var! Şehir fare istilasına uğruyor! Kesinlikle sıçanlardan daha az tehlikeli ama yine de. Bir şey yapmalıyız!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_001" = "Sör, Fare Avlayan Kedi Akademisi kuruldu ama… Yine de onların refahlarıyla ilgilenip onları beslemeliyiz. Akademi için yeterli balık tedariki yapmalıyız.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_FISH_003" = "Eğitim için artık yeterli miktarda balığımız var. Birkaç acemi çoktan bir sürü fare yakaladı bile Sör.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_001" = "Sör, en iyi kedileri kedi otu ile ödüllendirmeliyiz. Streslerini azaltmak için.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_003" = "Fare yakalayıcılarının etkililiğinde gözle görülür bir artış var Sör. Öğretmenler kedileri eğitmede iyi iş çıkarıyor. Yalnızca az sayıda fare kaldı.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_HERBS_004" = "Fareler artık hiç sıkıntı değil Sör. Bu sonuca ulaşmak için yaptığınız seçimleri tebrik ediyorum.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_001" = "Bir plan hazırlayın.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_002" = "Yine de kahvaltı yapmaya karar veriyorsunuz. Tostunuzu yerken odanın köşesinde bir fare görüyorsunuz. Kaleye bile gelmişler! Ve aniden sadık kediniz Chouquette'in sıçrayışını görüyorsunuz. Fareyi hemen yiyor. ";
"T_GAME_QUEST_MICE_AND_SOLDIERS_PLAN_003" = "Bu size bir fikir veriyor. Danışmanınıza olabildiğince çok kediyi toplayıp fare avlama konusunda eğitmesi için talimat veriyorsunuz. Ev kedilerini bile. Onların tüm bu farelerden kurtulmak için eğitilmelerini istiyorsunuz.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_001" = "Uykuya geri dönün.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_002" = "Uyandığınızda her yerde o kadar çok fare var ki doğru düzgün yürümek zor. Tüm sakinleriniz yavaşladı!";
"T_GAME_QUEST_MICE_AND_SOLDIERS_SLEEP_003" = "Fareler uzun bir süre sonra kendi başlarına gitti. Uyuyarak sorumluluklarınızdan saklanmak her zaman bir çözüm değil.";
"T_GAME_QUEST_MICE_AND_SOLDIERS_TITLE" = "Kedi ve Fare";
"T_GAME_QUEST_MIL_TUT_01_INFLUENCES" = "Sağ tarafta şu anda aktif etkileri görebilirsiniz.\nBazı etkiler yalnızca geçici olarak aktiftir ve senaryonun gidişatına göre değişebilir.";
"T_GAME_QUEST_MIL_TUT_01_START" = "Lordum,\nSaygısızlık etmek istemem ama köylülerin ne kadar mutsuz olduğunu fark etmemiş gibisiniz. Bu daha fazla süremez.\nAyrıca ürettiğimiz mallar doğru şekilde işlenmemiş.";
"T_GAME_QUEST_MIL_TUT_01_SUCCESS" = "Artık kasabada ne etkilerin olduğunu biliyorsunuz. Fark etmişsinizdir, haydutlar bölgede ve onlar yüzünden kasabanın genel mutluluğu azaldı.";
"T_GAME_QUEST_MIL_TUT_01_TITLE" = "Bu haritadaki mevcut etkileri görmek için durdurma menüsünü ziyaret edin.";
"T_GAME_QUEST_MIL_TUT_02_START" = "Kereste fabrikasını ziyaret eder misiniz? \nÜretimi durdurmak zorundayız! Çok az odunumuz ve zaten çok fazla tahtamız var!";
"T_GAME_QUEST_MIL_TUT_02_SUCCESS" = "Bir bina hakkında daha fazla bilgi almak için sadece ziyaret etmeniz gerekiyor!\n\nDurum menüsü bina, çalışanları ve bağlı üretim zinciri hakkında oldukça faydalı bilgiler gösterir. Siz bu menüdeyken oyun durdurulur.";
"T_GAME_QUEST_MIL_TUT_03_START" = "Kereste fabrikası daha etkili şekilde tahta üretmek için daha fazla oduncuya ihtiyaç duyacak.\n\nDaha fazla ormancı kulübesi inşa edip daha fazla bina kaynağı toplayana kadar kereste fabrikasını durdurmalıyız.";
"T_GAME_QUEST_MIL_TUT_04_START" = "Efendim, kaynakların depoyu tıkamasına engel olmalısınız.\nDepodan bir şeye ihtiyacınız olduğunda istatistikler menüsünden kaynakları yok etme özelliğini kullanabilirsiniz.";
"T_GAME_QUEST_MIL_TUT_04_START_HINT" = "Depo menüsüne gidin.";
"T_GAME_QUEST_MIL_TUT_04_START_NEW" = "Efendim, kaynakların depoyu tıkamasına engel olmalısınız.\nDepoda boşluğa ihtiyacınız olduğunda oyun içi menüsündeki depo sekmesinden kaynakları yok et özelliğini kullanabilirsiniz.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_NEW" = "Stok 100'ün altına düşene kadar tahtaları yok edin.";
"T_GAME_QUEST_MIL_TUT_04_TITLE_OLD" = "Depoda yer açmak için birkaç tahta yok edin.";
"T_GAME_QUEST_MIL_TUT_05_FAILED" = "Vali, benim tehditlerimi ciddiye almıyorsunuz.\n\nArtık iş ciddiye bindi!";
"T_GAME_QUEST_MIL_TUT_05_START" = "Orada güzel bir kasaba inşa etmişsiniz.\n\nBenim çayırlığımda olması ne kötü! Bana mücevherler ve giysiler getirin! Çabuk olun yoksa kasabanız tarihte kalır…";
"T_GAME_QUEST_MIL_TUT_05_SUCCESS" = "Ufak bir tehdidin sonucunu vermesi ne kadar etkileyici. Bu malları bana gerçekten göndereceğinizi hiç düşünmemiştim.";
"T_GAME_QUEST_MIL_TUT_05_TITLE" = "Haydutlara haraç verin.";
"T_GAME_QUEST_MIL_TUT_08_NOTIFICATION" = "Adamlarımın canı şu anda çok sıkılıyor. Onları ufak bir gezintiye yollayacağım…\n\n…SİZE!";
"T_GAME_QUEST_MIL_TUT_08_SUCESS" = "Görebildiğiniz gibi ne istersem alacağım!";
"T_GAME_QUEST_MIL_TUT_09_START" = "Günaydın Efendim.\n\nKralın emriyle sizden önce geldim. Size savaş sanatını öğretmem için beni gönderdi.\n\nKüçük haydut sorunlarınız kısa süre içinde tarih olacak Efendim.";
"T_GAME_QUEST_MIL_TUT_10_START" = "Kışla bölgedeki askeri operasyonlarınızın temelidir ve nöbetçi kuleleri inşa edip onlara tedarik sağlamaya olanak sağlar. Askerler yalnızca iyi şekilde tedarik gördüklerinde iyi savaşırlar.\nKasabanın olabildiğince büyük kısmını korumak için kuleler yerleştirmelisiniz.\n\nLordum, bir kışla ve bir nöbetçi kulesi inşa edin.\n";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION" = "Gerçekten bir şövalyeden yardım aldınız…\nŞimdiden korkudan titremeye başladım.\nBakalım askeriyeniz benim adamlarıma karşı ne yapabilecek…";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_1" = "Haydutlar binalarımızı aleve veriyor. İhtiyaç olduğunda şu itfaiyeci nerede?!\n\nO anda bir kasabalının nerede olduğunu bilmek isterseniz binanın içerik menüsündeki "kasabalımı bulun" seçeneğini seçebilirsiniz.";
"T_GAME_QUEST_MIL_TUT_12_NOTIFICATION_FIND_TOWNIE_2" = "İşçilerin şu anda ne yaptığını buradan görebilirsiniz.";
"T_GAME_QUEST_MIL_TUT_13_TITLE" = "İçki ve sosis üretin.";
"T_GAME_QUEST_MIL_TUT_14_START" = "Efendim, askerlerimizin cesaretlenmek için içkiye ihtiyacı var.\n\nİçki üretmek için manastır içki işletmesi ve bir şerbetçiotu işleme evinin inşaat emrini vermelisiniz.\n";
"T_GAME_QUEST_MIL_TUT_14_START_OLD" = "Askerlerimizin içkiye ihtiyacı var Efendim.\nİçki elde etmek için bir manastır ve birkaç şerbetçiotu tarlası inşaatı emri vermelisiniz Lordum.";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS" = "Manastır içki işletmesi diğer binalardan birkaç kaynağa ihtiyaç duyar.\nŞerbetçiotu işleme evinden kurutulmuş şerbetçiotları alır. Bir çiftlik ve bir kuyu, buğday ve su tedarik eder.\n\nDaha sonra manastırdaki keşişler içki üretimine başlar Efendim.\n";
"T_GAME_QUEST_MIL_TUT_14_SUCCESS_OLD" = "Manastırda keşişlerin ya tarlalardan şerbetçiotları toplamasını ya da içki yapım sürecini yapmalarını emredebilirsiniz.";
"T_GAME_QUEST_MIL_TUT_14_TITLE" = "Bir manastır ve şerbetçiotu işleme evi inşa edin.";
"T_GAME_QUEST_MIL_TUT_14_TITLE_OLD" = "Bir manastır ve birkaç şerbetçiotu tarlası inşa edin.";
"T_GAME_QUEST_MIL_TUT_15_START" = "Sosis üretimi için bir domuz çiftliği ve bir kasap dükkânına ihtiyacınız olacak Lordum.\n\nAskerlerimiz sosislerin baharatlı tadına bayılıyor. Sosisler için ihtiyacımız olan baharatları çiftçi bitki bahçesinden toplayabilir.";
"T_GAME_QUEST_MIL_TUT_15_SUCCESS" = "Kasap dükkânı askerler tarafından sevilen sosislerin yanında normal et de üretebilir.\nOrmanlardaki avlama oyununa bağlı kalmamak için bu iyi bir seçenek olabilir.";
"T_GAME_QUEST_MIL_TUT_15_TITLE" = "Bir domuz çiftliği ve kasap dükkânı inşa edin.";
"T_GAME_QUEST_MIL_TUT_16_FAILED" = "Bence daha fazla savunma pratiği yapmalısınız!\nBir dahaki sefere görüşürüz… Kaynaklar için de teşekkürler.";
"T_GAME_QUEST_MIL_TUT_16_START" = "İçki ve sosisler!\n\nAdamlarım nefis yiyeceklere bayılır. Bence şu muhteşem malları benimle paylaşmalısınız.\n";
"T_GAME_QUEST_MIL_TUT_16_SUCCESS" = "Bu sefer şanslıydınız Vali. Gelecek sefere adamlarım daha büyük sayılarla gelecek.";
"T_GAME_QUEST_MIL_TUT_16_TITLE" = "Kasabanızı savunun";
"T_GAME_QUEST_MIL_TUT_17_START" = "Kasabada daha fazla geliştirme yapılması gerekiyor. Köyün çoğunluğu iyi savunulmuyor. Köyün daha fazla kısmını nöbetçi kuleleriyle korumalıyız.";
"T_GAME_QUEST_MIL_TUT_17_SUCCESS" = "Artık köyün çoğunluğu askerlerimizin koruması altında. O haydutlar artık bizden kolayca çalamayacak Lordum.";
"T_GAME_QUEST_MIL_TUT_17_TITLE" = "Köyün en az %50'sini nöbetçi kuleleriyle koruyun";
"T_GAME_QUEST_MIL_TUT_18_NOTIFICATION_STATISTICS_1" = "Askeriye hakkında daha fazla bilgi istiyorsanız her zaman istatistik ekranın askeriye sekmesini ziyaret edebilirsiniz.";
"T_GAME_QUEST_MIL_TUT_19_START" = "Askerlerimizin silah ve zırha ihtiyacı var!\nSilahlar askerlerimizin saldırı gücünü artırırken zırhlar savunma becerilerini artırır.\n\nBu yüzden kasabada bir cephanelik inşa etmeliyiz. Zırh yapmak için deriye ulaşabilmek için bir tabakhaneye ihtiyacınız olacak.\nHayvan postları bir avcı veya kasap tarafından tedarik edilecektir.";
"T_GAME_QUEST_MIL_TUT_19_TITLE" = "Bir tabakhane ve cephanelik inşa edin.";
"T_GAME_QUEST_MIL_TUT_20_START" = "Lordum,\nCephaneliğinizin büyüklüğünü artırma zamanı. Sonrasında haydut kampını yok etmek için bir görev kuvveti gönderebilirsiniz.";
"T_GAME_QUEST_MIL_TUT_20_TITLE" = "Ordunuzu genişletin";
"T_GAME_QUEST_MIL_TUT_21_START" = "Vali, vakit geldi!\n\nArtık o pis haydut Lorduna karşı savaşacağız. Kampları ormanda gizli.\nYalnızca haydut kampını seçip saldırmak için makul bir asker grubu çağırmalısınız.\n\n\nSize iyi avlanmalar diliyorum!";
"T_GAME_QUEST_MIL_TUT_21_TITLE" = "Haydut kampını yok edin";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_START" = "Sizinle tanışmak güzel Efendim.\nBu hafta haydutlar tarafından üç kez soyuldum. Bu şeytanlara karşı gerçekten bir şey yapmalıyız!";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_SUCCESS" = "Harika bir zafer Efendim.\nO haydutlara gününü gösterdik! Bölge yeniden güvende, Kral gerçekten memnun olacak. ";
"T_GAME_QUEST_MIL_TUT_MAINQUEST_TITLE" = "Temel eğitimi tamamlayın ve haydutları bozguna uğratın.";
"T_GAME_QUEST_NEW" = "Yeni görev!";
"T_GAME_QUEST_NEW2" = "Yeni görev:";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_001" = "Kimsenin buna zamanı yok.";
"T_GAME_QUEST_NEW_RECIPE_ANSWER_002" = "Haklısınız.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_001" = "Çok güzel Sör, o halde bu korkunç ekmeğe karşı hiçbir şey yapmayacağız. Berbat yiyecek hakkındaki şikâyetleri şimdiden duyabiliyorum. Yine de… Emredersiniz Sör.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_B" = "Ah Sör, ekmek artık çok lezzetli! Satış fiyatları da artıyor.";
"T_GAME_QUEST_NEW_RECIPE_CONSEQUENCE_002_INTRO" = ""Sorununuz buğdayda, sorunu kökten halletmelisiniz. Değirmenciye daha temiz su kullanmasını söyleyin. Mayanın kalitesi iyi olsun."\n\nDanışmanınız bilgilerinizi fırıncıya aktarıyor ve ekmeğin daha iyi kalitede olacağının sözünü veriyor.";
"T_GAME_QUEST_NEW_RECIPE_DESC" = "Sör, bir şey yapmalıyız. Ekmek eskisi gibi değil. Birçok insan kalitesinden şikâyet ediyor. Tarifi değiştirmeliyiz.";
"T_GAME_QUEST_NEW_RECIPE_TITLE" = "Yeni bir tarif";
"T_GAME_QUEST_NOQUEST" = "Mevcut görev yok.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_001" = "Hadi acele edip zırhlar ve silahlar hazırlayalım. Bu insanlar tehlikeliyse hazırlıklı olmak güvenli olur.";
"T_GAME_QUEST_NORTHERN_DESERT_DEFENSE_002" = "Vali, şehrin savunması için hazırlıkları tamamladık.";
"T_GAME_QUEST_NORTHERN_DESERT_DESC" = "Askerleriniz kuzeyde birlik hareketleri bildiriyor. Krallıktaki en büyük çöl burada yer alıyor.\n\nNe var ki hiç kimsenin sınırların bu tarafında bir saldırıya girişecek kadar çılgın olmadığını biliyorsunuz. Bu tehlikeyi görmezden gelmeye karar veriyorsunuz. Ne olacaksa olsun!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_001" = "Birkaç gün sonra askerleriniz bir grup insanın kuzey çölünden geldiğini bildiriyor. Birkaç saat içinde kasabada olacaklar.\n\nYalnızca gezgin olabilirler ama kim bilir, belki de köyünüzü işgal etmeye gelmiş tehlikeli haydutlardır!";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_002" = "Savunmaları hazırlayın.";
"T_GAME_QUEST_NORTHERN_DESERT_FEW_DAYS_003" = "Sıcak bir karşılama hazırlayın.";
"T_GAME_QUEST_NORTHERN_DESERT_TITLE" = "Kuzey Çölü";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_001" = "On kişilik bir grup insan şehrinize yaklaşıyor. Askerleriniz tetikte, emirlerinizi bekliyor.\n\nYaklaşmalarına izin veriyorsunuz. Bu grubun lideri şehrin kapılarına doğru tek başına yürüyor. "Günaydın sevgili lordum, kuzey çölünü aşıp geldik. Bizi bir geceliğine misafir eder misiniz?"";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_001" = "Öyleyse güzel şehrimize gelin, handa kalacaksınız, orada yeterince yerimiz var.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_002" = "Danışmanınız size eve kadar eşlik ederken tetikte kalıyorsunuz. Neden yelkenli ile nehirden geçebilecekken çölü aşma riskini aldılar? Saklanmayacaklarsa neden tehlikeli bir yolu seçtiler?\n\nBelki de casuslarım onlar hakkında daha fazlasını öğrenebilir. Siz de yatağınıza gidebilirsiniz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_003" = "Yatağa gidin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_004" = "Bir casus gönderin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_001" = "Casusunuz tüm gece ayakta kalıyor ve handaki bazı konuşmalara kulak kabartmayı başarıyorlar: Gezginler kaçak. Çölün diğer tarafındaki ülkelerinde bazı suçlar işledikleri söyleniyor. Arkalarından bir ordu gönderilmiş ve onlar adaletten kaçmak için yollarını hazırlıyorlar bile.\n\nEn iyi çözüm nedir?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ACCEPT_SPY_002" = "Gezginleri kilitleyin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_001" = "Az önce Kraldan bir mesaj aldık. Tehlikeli suçlular komşu ülkenin hapishanesinden kaçmış. Yaklaşık on kişiler ve değerli bir nesneyi çalmışlar. Sizce onlar birkaç gün önce burada olan gezginler mi?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_002" = "Krala bir mesaj gönderin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_003" = "Aramızda kalsın.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_004" = "Krala onların köyümüzden geçtiğini bildiren bir mesaj göndereceğim. Belki de onları bulmayı başarırlar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_005" = "Sör! Kraliyet Ordusu o tehlikeli bireyleri yakalamayı başardı. Çalınan hazineyi geri alabildiler.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_AFTER_006" = "Yardımınız için teşekkürler Vali. O insanlar benim en değerli mücevherlerimden birisi çalmıştı. Onu kara borsada satmayı planlıyorlardı. Şehrinizde bulunduklarını bana söyleyerek doğru şeyi yaptınız.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_001" = "Çok güzel Sör. Birileri bu konu hakkında soru sorarsa bilmediğimizi söyleyeceğiz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_END_SILENCE_002" = "Şehirde göze batan bir şey olmayalı uzun bir süre oluyor. Ancak bugün bunun değişeceğini hissediyorsunuz.\n\nVe haklısınız! Danışmanınız size Kraliyet Ordusu tarafından aranan gezginlerden bir mektup getiriyor. Mesajda şöyle yazıyor: \n\n"Bizi bildirmediğiniz için teşekkürler Vali. Görüyorsunuz ya, biz bir tuzağın kurbanlarıydık ve tüm ailemiz büyük tehlikedeydi. Köyünüze gelişimizi bir sır olarak tutarak masumiyetimizin kanıtını bulacak zamanımız oldu. Siz olmasaydınız bu mümkün olmazdı. Bu yüzden lütfen minnetimizin bir sembolü olarak bu ödülü kabul edin. Siz iyi bir Valisiniz."";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_001" = "Gezginleri serbest bıraktım sör. Bize emrettiğiniz gibi. Umarım bize geri dönüşü olmaz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_002" = "Gezginler nezaketiniz için teşekkür ediyor ve masumiyetleri kanıtlandığında size minnetlerinin bir sembolü olarak bir ödül vereceklerine dair söz veriyorlar.\n\nİçinizden doğru kararı verdiğinizi ve bu gezginlerin yalanlar söyleyerek sizi kandırmamış olmalarını umuyorsunuz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_003" = "Bu gezginlerden haber almayalı birkaç ay geçti. Bazen bu konuyu yeniden düşünüyorsunuz. Kral ile hiçbir sıkıntı yaşamadınız ancak sözde ödülünüzü de almadınız.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_004" = "Aniden güneşli bir sabahta danışmanınız size içinde mektup bulunan bir paket getiriyor. Mektubun içinde gizemli gezginlerden bir mektup bulunuyor. Minnetlerini dile getiriyorlar. Pakette sözü verilen ödülü görebiliyorsunuz. Altının yanında prestij.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_FREEDOM_005" = "Haklı olduğunuz ve kandırılmadığınız için mutlusunuz.\n\nDanışmanınız bu gezginler için zaten bir kahraman olduğunuzu ve sizi takdir ettiklerini bildiriyor. Bir Vali olmak için ne harika bir zaman.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_LEAVE_TOWN_001" = "Sör, gezginler sabahın erken saatlerinde gitti, aceleleri var gibi görünüyorlardı.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_001" = "Gezginler cevabınızı bekliyor. Bazıları agresif görünüyor, bazıları da korkmuş.\n\n"Gezginler, sizi misafir edemem. Bu gece yeterli yerimiz yok."\n\nGezginlerden birisi size kılıcıyla koşarken "YALAN!" diye bağırıyor.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_002" = "Valiyi koruyun!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_003" = "Çabuk Sör! Acele edin! Gözden kaybolalım!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_001" = "Fazlasıyla panik içinde görünen danışmanınızla bir gizlenme yerine saklanmayı başarıyorsunuz: "Sör, ne yapacağız?! Bu kötü gezginler köyümüzü yerle bir ediyor ve yapabileceğimiz hiçbir şey yok! Yuvarlar ekmekler yerine savunmalarımızı hazırlamalıydık!"\n\nNe yazık ki tek yapabileceğimiz şey beklemek.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_FOOD_002" = "Sabahın erken saatlerinde gizlenme yerinizden çıkıyorsunuz. Köy zarar görmemiş. Görünüşe göre gezginler yalnızca nöbetçileri dövüp yolculuklarının geri kalanı için biraz erzak almışlar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_001" = "Neyse ki hareketi planladık Sör. Ürettiğimiz silahlar ve kalkanlarla onları geri püskürtmeyi başaracağız. Buna eminim.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_002" = "Sör, tüm gezginleri yakalamayı başardık. Onları hapse attık, sizin için bir karar verme zamanı.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_003" = "Bu gezginler gittikçe garipleşiyor. Artık hapsolduklarına göre biraz daha güvende hissediyorsunuz. Yine de bir şey sizi rahatsız ediyor.\n\nNe yapmanız gerekiyor?";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_004" = "Onları sorgulayın.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_NO_WEAPON_005" = "Krala haber verin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_001" = "Peki Sör, bu hikâyeyi açıklığa kavuşturmak için onlara birkaç soru soracağım.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_002" = "Danışmanınız geri döndü ve size gezginlerle ilgili bilgiler getiriyor. \n\nHaksız yere suçlandıkları için ülkelerinden kaçmışlar. Masumiyetlerinin kanıtı güneyde yatıyormuş. Çevredeki şehirlerden birisinde.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_QUESTIONS_003" = "Gitmelerine izin verin.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_001" = "Krala, kraliyet ordusunun gelip bu tehlikeli suçluları alması için haber vereceğim!";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_ROYAL_ARMY_002" = "Kraliyet ordusu nihayet geliyor. Gezginleri teslim ediyorsunuz. Kral size bu tehlikeli bireyleri yakalamak için gerekli bilgiyi sağladığınızdan bir ödül gönderiyor.\n\nKöyünüz yavaşça iyileşiyor, bu sırada siz huzur içinde vali olarak işlerinize devam ediyorsunuz.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_001" = "Casusunuz bir hata yaptı ve gezginler tarafından görüldü. Onu rehin tutuyorlar ve canlı olarak geri alabilmeniz için fidye istiyorlar.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_001" = "Çok fazla para kaybedeceğiz ama en azından casusumuz güvende olacak.";
"T_GAME_QUEST_NORTHERN_DESERT_TRAVELERS_SPY_CATCH_PAY_002" = "Beni serbest bırakmak için fidye ödediğiniz için teşekkürler Sör! Can güvenliğimden koruyordum. Bir casus olmak ne tehlikeli bir iş.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_001" = "Bu harika bir fikir. Kapımıza geldiklerinde bu insanlar için yiyecek hazırlamalıyız. Ekmek ve balık iş görür.";
"T_GAME_QUEST_NORTHERN_DESERT_WARM_WELCOME_002" = "Harika, şimdi tek yapmamız gereken onları beklemek.";
"T_GAME_QUEST_PLACE_STARTED" = "Şimdi bu büyüklükte bir etkinlik için uygun yeri inşa etme zamanı!";
"T_GAME_QUEST_PLACE_SUCCESS" = "Oh la la, bu kesinlikle inanılmaz! Ayrıca nöbetçilerin gayreti olmasaydı bunlardan hiçbirisinin mümkün olmamış olacağını düşünsenize. Bu fırsattan faydalanarak harika bir fikir düşündünüz! Festival bir başarı olmayı vaat ediyor.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_001" = "Daha fazla çiçek ekin.";
"T_GAME_QUEST_PRETTY_PETALS_ANSWER_002" = "Buna gerek yok.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_001" = "Çok güzel! Ah, çiçekler gerçekten harika şeyler, kokuları beni çok mutlu ediyor.";
"T_GAME_QUEST_PRETTY_PETALS_CONSEQUENCE_002" = "Siz korkunç bir insansınız. Şehrimiz çiçeklerle çok daha güzel olabilirdi!";
"T_GAME_QUEST_PRETTY_PETALS_DESC" = "Bahar geldi Lordum. Köy biraz ek çiçekten faydalanabilir.";
"T_GAME_QUEST_PRETTY_PETALS_TITLE" = "Güzel Çiçek Yaprakları";
"T_GAME_QUEST_REBUILT_SAWMILL_DESC" = "Efendim, kereste fabrikası yandı. Yeniden inşaat emrini verir misiniz? Tahta üretmek için binaya ihtiyacımız var!";
"T_GAME_QUEST_REBUILT_SAWMILL_TITLE" = "Kereste fabrikasını yeniden inşa edin.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_001" = "Hiç kimseye bir şey vermeyin.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_002" = "Kazançları kasabalılara yeniden dağıtın.";
"T_GAME_QUEST_REDISTRIBUTION_ANSWER_003" = "Bu parayı madenlere dağıtın.";
"T_GAME_QUEST_REDISTRIBUTION_DESC" = "Sör, sandıklarda bolca paramız var ve bu kazançların bir kısmını dağıtmanın şehre faydası olur.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001" = "Köylüler kararınızı duydu. Mutlu değiller. İnsanlarınıza biraz daha ilgi göstermeye çalışın sör.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_001_PART_2" = "Kasabalıların üretkenliği artık kazançları yeniden dağıtmanız hakkında alacağınız karardan etkilenmiyor. ";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_002" = "Kasabalıları ne kadar mutlu ettiniz! Etekleri zil çalıyor!";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_A" = "Muhteşem hareket Sör. Madenler inşa edip kaynaklar çıkartmamıza izin verin.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_003_B" = "Elimizdeki parayı yeni madenlerin inşaatına kullanmak muhtemelen aldığımız en iyi karardı. Bu kaynaklarla daha hızlı gelişebileceğiz.";
"T_GAME_QUEST_REDISTRIBUTION_OUTCOME_PEOPLE_001" = "Çok cömertsiniz Sör. Bu para günlük hayatlarını iyileştirmeye yardımcı olacak.";
"T_GAME_QUEST_REDISTRIBUTION_TITLE" = "Kazançların yeniden dağıtılması";
"T_GAME_QUEST_REGULATION_CONCLUSION_001" = "Sör, şansımız yaver gitti. Mahsuller etkilenmemiş. Yaban domuzları gitti, artık onlar hakkında endişelenmemize gerek yok.";
"T_GAME_QUEST_REGULATION_CONCLUSION_002" = "Yaban domuzları mahsullerimizi mahvetti Sör! Çiftliğe gidiyorlar. Bu bir katliam.";
"T_GAME_QUEST_REGULATION_CONCLUSION_003" = "Nüfus bu kayıptan dolayı mahvoldu, mutluluk ve üretkenlikleri etkilendi.";
"T_GAME_QUEST_REGULATION_CONCLUSION_004" = "Sör, mahsullerimiz bir süre önce yaban domuzları tarafından aldıkları hasarı atlatıyor. Kültürler yeniden büyüyor ve insanlar olanları unutmaya başlıyor.";
"T_GAME_QUEST_REGULATION_CONSEQUENCE_002" = "Kararınızın sonucu yüzünden nüfus ihmal ediliyor! Umalım da mahsuller bu yaban domuzları tarafından zarar görmesin.";
"T_GAME_QUEST_REWARD" = "Ödül:";
"T_GAME_QUEST_SANDBOX_COASTSANDSCLIFFS_WELCOME" = "Sizi nezaketle karşılıyorum vekil!\n\nŞu sahil şeridine baksanıza! Kasabanızın bu güzel manzaraya değer olmasını bekliyorum!\nKasabalılarınıza iyi bakın ve Krala haraç ödemeyi unutmayın, böylece bana hizmet etmeye devam edebilirsiniz!";
"T_GAME_QUEST_SANDBOX_CREDIT" = "Kralın maliyesinden borç alın";
"T_GAME_QUEST_SANDBOX_CREDIT_DESC" = "Vali, \nKaynaklarınız azaldıysa krallık size işleri yoluna koymanız için ufak bir borç verebilir.";
"T_GAME_QUEST_SANDBOX_DIVIDEDSHORELINE_WELCOME" = "Mütevazı kasabamıza hoş geldiniz Vali!\nBölge karalık bir sırt ile ikiye bölünmüş. Lordum, sırtın güneybatı kısmında cevher yatakları bulunabilir.\n\nBirlikte çalışmayı dört gözle bekliyorum.";
"T_GAME_QUEST_SANDBOX_FRIGYTHKINGDOM_WELCOME" = "Hoş geldiniz Vali!\n\nBen Kraliçe Frigyth, bu Krallığın hükümdarı. Bu köyü muhteşem bir hâle getirmek için yardımınızı istedim. Toprak zengin kaynaklara sahip, bu yüzden sizin için kolay olmalı. Beni hayal kırıklığına uğratmayın.";
"T_GAME_QUEST_SANDBOX_LOWLANDS_WELCOME" = "Lordum, bu bölgenin sonsuz büyüklüğüne baksanıza. Düz ve gözün görebildiği yere kadar gidiyor! Yakında buraya büyük bir şehir inşa edebileceğiz, sizce de öyle değil mi?";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_BIGRIVER" = "Selamlar Vali.\nBu kudretli nehrin kıyılarında faydalanacak birçok fırsat bulunuyor. Dalyanlar çok geniş ve madenler de cevher dolu. Burada Kral adına başarılı bir kasaba inşa edebiliriz.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_CANYON" = "Muhteşem, Vali.\nBu kanyon, dağların içindeki en önemli rotalardan birisini barındırıyor. Kasaba, buradan geçen seyyah tüccarlar için rahat bir konaklama sunan ideal bir konumda olma özelliğine sahip. ";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_FALLS" = "Lordum, bu şelalelerin dibinde bolca dalyan var. Ayrıca zengin cevher yatakları bu bölgeyi kasabamızı kurmak için ideal kılıyor.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_ICYHOLD" = "Lordum, Buzlu Sığınak'a hoş geldiniz.\nKasabalılar için kaleye tırmanmak kolay değil ancak ovaların manzarası buna değer. Topraklarınız buradan uçsuz bucaksız görünüyor.";
"T_GAME_QUEST_SANDBOX_MAPSTART_GREETING_VASTHILLS" = "Günaydın Efendim.\n\nArazilerinizle dolu şu inişli çıkışlı tepelerinden bakın. Bu manzara muhteşem değil mi? Burası bir kasaba kurmak için güzel bir yer Efendim.";
"T_GAME_QUEST_SANDBOX_THEPIT_WELCOME" = "İyi sabahlar Lordum.\n\nKüçük köyümüze hoş geldiniz. Çukurun kayan bir yıldız tarafından oluşturulduğu söyleniyor. Umalım da bize şans getirmiş olsun. Kral kısa süre içinde sizin için görevleri olduğunu yazdı bile.";
"T_GAME_QUEST_SANDBOX_TRIBUTE" = "Krala vergi ödeyin.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_02" = "Kasabalılar için Festival.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_03" = "Fakirler için bağış.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_04" = "Kasabada İçki Festivali.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05" = "Pazarda domuz satın.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD" = "Hayvan pazarında ticaret yapın.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_05_OLD2" = "Pazarda hayvan ticareti yapın.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_06" = "Ordu için erzak.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_07" = "Kralın askerleri için ekipman.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_08" = "Haydut saldırılarını savuşturun.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_09" = "Haydut kamplarını yok edin.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC" = "Sizi nezaketle karşılıyorum vekil! Şu sahil şeridine baksanıza! Kasabanızın bu güzel manzaraya değer olmasını bekliyorum!\nKasabalılarınıza iyi bakın ve Krala haraç ödemeyi unutmayın, böylece bana hizmet etmeye devam edebilirsiniz!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_02" = "Balık tutmak için ne harika bir yer. Sizce de öyle değil mi Efendim? Burada kesinlikle yiyecek eksikliği yaşamayacağız!\nKrala haracınızı ödedikten sonra gücünüz yeterse ara sıra bir festivale ev sahipliği yapmanız çok hoşumuza gider!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_03" = "Ah canım, buraya yerleştiğiniz için teşekkür ederim! Bu göl gerçekten çok güzel!\nOnlara iyi bakarsan Kasabalılar burada kesinlikle mutlu olacak!\nAh, ayrıca burada sonsuza kadar kalabilmemiz için Krala rüşvet vermeyi unutmayın!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_04" = "Lordum, bu nehir vadisine taşınmak akıllıca bir karardı!\nKasabalılar fakir ve yardıma muhtaçlara yardım ettiğinizde kesinlikle memnun olacak!\nYine de tüm cömertliğinize rağmen Krala karşı olan görevinizi aksatmamanızı öneririm!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_05" = "Hoş geldiniz! Adamlarım iktidar makamınızı topraklarımızın böylesine önemli bir yerinde inşa etmenize destek olmaktan onur duyar!\nBu sene bir kutlama senesi olacak!\nYaşasın Kral, siz de öyle!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_06" = "Sevgili Valim, sizin hakkınızda zaten çok şey duymuştum! Bu yüzden sizi seçtim: Kaleme giden yokuşun aşağısında gelişen bir kasaba kurun!\nHemen başlasanız iyi olur! Hoşça kalın!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_07" = "Efendim, bize bu kurumuş nehir yatağının yakınında bir kasaba kurma görevi verildi. Görevimizi layıkıyla yerine getirirsek Kral bizi cömertçe ödüllendirecektir.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_08" = "Lordum, kalenizin durduğu plato küçük sevimli kasabamız için mükemmel bir konum. Ayrıca Kral size yapılmasını istediği birkaç görev gönderdi.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ARCHIPELAGO" = "Sahile hemen yakın bir yerde bir takımada keşfedildi. Size benim adıma o adaları kolonileştirmenizi emrediyorum!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_DEEPFOREST" = "Lordum, şu güzel orman bölgesine bakın. Buraya bir kasaba inşa etmek zor bir iş olacak ancak en azından bolca geyik ve odun var.\n\nBu, Kralın bize verdiği görevleri tamamlamayı kolaylaştırır.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_FROZENPLAIN" = "Efendim, Krala olan haraç yükümlülüklerimizi yerine getirmek sert kış şartları yüzünden zor olacak. Hadi bir an önce işe koyulalım…";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_GREEN_VALLEY" = "Ne harika bir vadi. Krala haraç ödemek için yeterli kaynak var. Yine de dikkatli olun, binalar için az alanın olması düzgün bir planlamayı şart kılar.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_ISLAND" = "Burası gerçekten güzel bir ada! Buraya geldiğimiz için çok mutluyum. Hemen köyümüzü planlamalıyız!";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_MOUNTAINTOP" = "Buradan çevredeki bölgeyi mükemmel bir şekilde izleyebiliriz. Ne yazık ki bu yükseklikte kış mevsimi çok daha uzun, bunun da mahsul yetiştirmede kötü etkileri var.\n\nYazın stok yapmak akıllıca olur.";
"T_GAME_QUEST_SANDBOX_TRIBUTE_DESC_STEPPE" = "Selamlar! Sizi bekliyorduk! Adamlarım bölgeyi çoktan keşfetti ve çok fazla gelecek vaat eden cevher damarları buldu.\n\nBaşkalarından önce hemen maden çıkarmaya başlasan iyi olur!";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME" = "Lordum, iyi ki buradasınız.\n\nEski vali kaçtı. Kaçarken bağırarak bu bölgenin lanetli olduğunu söylüyordu.";
"T_GAME_QUEST_SANDBOX_WASTELAND_WELCOME_02" = "Sizden öncekiler bu konuda tamamen hatalı sayılmazlar. Tarım zor, burada neredeyse bir şey yetişmiyor. Su bile az ama eminim siz bir çözüm bulursunuz.";
"T_GAME_QUEST_SCEN10_10_DESC" = "Kasabalılarınız dini yaşamları hakkında biraz memnuniyetsiz hissediyor Lordum. Kasabada bir kilise inşa etmeniz mümkün mü?";
"T_GAME_QUEST_SCEN10_10_NAME" = "Yüksek dini mutluluk elde edin.";
"T_GAME_QUEST_SCEN10_11_DESC" = "Benim seviyemde bir adamın gerçekten toprak yollarda yürümesini mi bekliyorsunuz Vali? Gerçek bir şehrin hak ettiği yollar inşa edin!";
"T_GAME_QUEST_SCEN10_11_NAME" = "Kasabanızda taş yollar inşa edin.";
"T_GAME_QUEST_SCEN10_11_NAME_DIRT" = "Kasabanızda toprak yollar inşa edin.";
"T_GAME_QUEST_SCEN10_12_DESC" = "Birileri burada gerçekten kötü işçilik çıkartmış Lordum. Binaların feci halde onarıma ihtiyacı var.\n\nTamamen yıkılmadan önce tüm binaları onarması için bir marangoz tutmalıyız.";
"T_GAME_QUEST_SCEN10_12_NAME" = "Bir marangoz dükkânı inşa edin ve binaların durumuyla ilgili yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN10_13_DESC" = "Vali! Neden kasabanız bu kadar küçük? Arşidükün arkasında kalıyoruz!\n\nYakında kasabanın nüfusunu artırmayı başaramazsanız bahsi kaybedeceğiz!";
"T_GAME_QUEST_SCEN10_13_NAME" = "Köyünüzün nüfusunu artırın.";
"T_GAME_QUEST_SCEN10_14_DESC" = "Kasabaya taşınan yeni aileler uzun ve yorucu bir yolculuk yaptı ve çok açlar. Onlar için bir ziyafet verelim ve bahsi resmi olarak başlatalım Lordum!";
"T_GAME_QUEST_SCEN10_14_NAME" = "Köyünüzü beslemek için yeterli yemek tedarik edin.";
"T_GAME_QUEST_SCEN10_15_DESC" = "Seyyah tüccarlarla ticaret yapmaya başlamalıyız. Kasabada tüccarların olması ziyaretçi çekerek kasabamızın şanını artıracaktır Lordum!";
"T_GAME_QUEST_SCEN10_15_NAME" = "Tüccar ile ticaret yaparak çok para kazanın.";
"T_GAME_QUEST_SCEN10_16_DESC" = "Topladığınız vergi miktarı acınacak kadar az! Belki de vergi gelirinizi artırmak için bir maliye inşa etmelisiniz.";
"T_GAME_QUEST_SCEN10_16_NAME" = "Bir maliye inşa edin ve yeterli miktarda vergi toplayın.";
"T_GAME_QUEST_SCEN10_17_DESC" = "Mücevher, mücevhere ihtiyacım var! Yine de bir kuyumcu bile inşa etmemişken nasıl mücevher teslimatı yapacaksınız merak ediyorum.";
"T_GAME_QUEST_SCEN10_17_NAME" = "Bir kuyumcu inşa edin ve mücevher üretimine başlayın.";
"T_GAME_QUEST_SCEN10_18_DESC" = "Harika iş Lordum. Artık bana vagonlarca mücevher gönderebilirsiniz.";
"T_GAME_QUEST_SCEN10_18_NAME" = "Tüccara mücevher teslimatı yapın.";
"T_GAME_QUEST_SCEN10_2_DESC" = "Lordum, ilk önceliğimiz yemek tedariki. Balıkçı ve avcılara ihtiyacımız var.";
"T_GAME_QUEST_SCEN10_2_NAME" = "Birkaç balıkçı kulübesi ve avcı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN10_3_DESC" = "Benim güzel Valim, bir pazar inşa etmezseniz çabalarınıza destek olamam.";
"T_GAME_QUEST_SCEN10_3_NAME" = "Köyünüzü büyütmek için ihtiyacınız olan bir pazar.";
"T_GAME_QUEST_SCEN10_4_DESC" = "Lordum! Henüz bir alet yapım atölyesi inşa ettiniz mi? Arşidük alet üretimine çoktan başladı bile!";
"T_GAME_QUEST_SCEN10_4_NAME" = "Bir alet yapım atölyesi inşa edin ve alet üretimine başlayın.";
"T_GAME_QUEST_SCEN10_5_DESC" = "Bunca çalışmayla birlikte rahatlayıp arkadaşlarla buluştuğumuz ve bir bardak üzüm suyu içtiğimiz bir yerimiz olsun isteriz. Bir taverna gerçekten iyi olurdu.\n\nElbette tamamen sizin için ne zaman uygun olursa Lordum.";
"T_GAME_QUEST_SCEN10_5_NAME" = "Tavernalarla yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN10_6_DESC" = "Yeterli ev alanımız var mı Lordum? Kasabaya taşınan tüm yeni işçilerin başının üstünde bir çatıya ihtiyaçları var, sizce de değil mi?";
"T_GAME_QUEST_SCEN10_6_NAME" = "2 büyük 4 normal kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN10_6_NAME_HOUSES" = "Daha fazla büyük kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN10_6_NAME_SMALLHOUSES" = "Daha fazla küçük kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN10_7_DESC" = "Kasabanın abartılı bir eğlenceye ihtiyacı var. Atlı mızrak alanları gibi. Önemli ziyaretçiler gelmeden önce bu tarz bir eğlence sunabileceğinizden emin olun.";
"T_GAME_QUEST_SCEN10_7_NAME" = "Eğlence ile yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN10_7_NAME_DEPRECATED" = "Atlı mızrak alanları ile yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN10_8_DESC" = "Lordum, birkaç heykel ve dekorasyonla bu sıkıcı kasabayı biraz güzelleştirebilir miyiz? Hadi Kral yeniden ziyaret etmeden bunu yapalım.";
"T_GAME_QUEST_SCEN10_8_NAME" = "Kasabanızı dekorasyonlarla güzelleştirin.";
"T_GAME_QUEST_SCEN10_9_DESC" = "İyi günler Vali. Bir ticaretle ilgilenir misiniz?\n\nArşidük ile kazançlı bir ticaret yapmak için büyük miktarda giysiye ihtiyacım var. İhtiyacım olanı bana teslim ederseniz iyi bir ödeme yapabilirim.";
"T_GAME_QUEST_SCEN10_9_NAME" = "Tüccara bolca giysi teslim edin.";
"T_GAME_QUEST_SCEN10_END_FAIL" = "Vali, bu tam bir felaket! Canterborough Arşidükü bizden önce davrandı ve biz kasabamızı bitiremeden kendisininkini tamamladı!\n\nSizin desteğinize güvenmiştim ve şimdi gerçekten hayal kırıklığına uğradım. Belki de bu bahsi kazanmak en başından beri yalnızca çılgınca bir hayaldi. ";
"T_GAME_QUEST_SCEN10_END_SUCESS" = "Harika iş benim güzel Valim! İnşa etme ve kasabamızı genişletme konusunda Arşidükü yendik. Bahis kazanıldı!\n\nPerformansınızdan etkilendim ve bizzat krallar gibi ödüllendirileceğinizden emin olacağım. Ayrıca getirdiği tüm hak ve ayrıcalıklarıyla size Dük unvanını veriyorum.";
"T_GAME_QUEST_SCEN10_MAIN_DESC" = "Sadık hizmetkârım, boyumdan büyük bir işe kalkmış olabilirim.\n\nCanterborough Arşidüküyle, o en geri kalmış kasabasını gelişen bir metropole dönüştüremeden önce, krallığımın en geri kalmış kasabası için aynısını benim yapabileceğime dair bir bahse girdim.";
"T_GAME_QUEST_SCEN12_01_START" = "Bizi ziyaret etmeniz ne hoş. Manastırdaki tüm keşişler adına sizi selamlıyorum.";
"T_GAME_QUEST_SCEN12_01_SUCCESS" = "Manastırımıza hoş geldiniz Efendim.\nElbette Kral için mükemmel hediye konusunda size yardım edebiliriz. Ancak şu anda birkaç haydut sorunumuz var. Belki de bize yardım edebilirsiniz.";
"T_GAME_QUEST_SCEN12_02_START" = "Ne haince bir hareket!\n\nBirisi odunlarımızı çalmış! Fıçılar için odun olmadan içkimizi depolayamayız.";
"T_GAME_QUEST_SCEN12_02_SUCCESS" = "Çok teşekkürler Lordum! Artık yeniden birkaç içki fıçısı yapabiliriz.";
"T_GAME_QUEST_SCEN12_02_TITLE" = "Birkaç ormancı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN12_04_START" = "Efendim, görevlerimizi tamamlamamız için kasabanın genişletilmesi gerekiyor. İlk olarak sağlam bir ekonomi oluşturmalıyız. Bunun için aletler üretmemiz gerekiyor.";
"T_GAME_QUEST_SCEN12_04_SUCCESS" = "Muhteşem, Lordum. Artık kasabayı daha da genişletebiliriz.";
"T_GAME_QUEST_SCEN12_04_TITLE" = "Bir alet üretimi zinciri kurun.";
"T_GAME_QUEST_SCEN12_05_START" = "Lordum, kasabaya daha fazla yiyecek tedarik edilmesi gerekiyor. Bir çiftliğimiz var ama yel değirmeni veya fırın yok?";
"T_GAME_QUEST_SCEN12_05_SUCCESS" = "Çok güzel! Köy gerçek bir kasabaya dönüşüyor.";
"T_GAME_QUEST_SCEN12_05_TITLE" = "Sağlam bir yiyecek üretimi sağlayın.";
"T_GAME_QUEST_SCEN12_06_FAILED" = "Hayır! Şu sinsi haydutlar! Manastırı yıkmışlar!";
"T_GAME_QUEST_SCEN12_06_START" = "Lordum, bu manastır dört yüz yıldır bu tepede duruyor. Bina o pis haydutlar tarafından yıkılırsa çok korkunç olur. Haftalardır orayı yıkmakla tehdit ediyorlar…";
"T_GAME_QUEST_SCEN12_06_SUCCESS" = "Çok güzel Efendim.\nManastır tüm haydut saldırılarından sağlam çıktı ve mükemmel bir içki üretimi yaptık! \n\nNe harika bir içecek oldu! Kesinlikle muhteşem.";
"T_GAME_QUEST_SCEN12_06_TITLE" = "Manastırı koruyun.";
"T_GAME_QUEST_SCEN12_07_START" = "Manastırı yeniden inşa etmelisiniz yoksa görevimizi asla zamanında yerine getiremeyeceğiz!";
"T_GAME_QUEST_SCEN12_07_SUCCESS" = "Çok güzel Lordum! Manastır yeniden inşa edildi! Elimizdeki görevle devam edebiliriz: Kusursuz içkiyi yapmak!";
"T_GAME_QUEST_SCEN12_07_TITLE" = "Manastırı yeniden inşa edin.";
"T_GAME_QUEST_SCEN12_08_START" = "Efendim, manastırın iyi şekilde savunulduğundan emin olmalıyız! Yanına bir nöbetçi kulesi yerleştirmek korumasını büyük oranda artırır.";
"T_GAME_QUEST_SCEN12_08_TITLE" = "Manastırın yanına bir nöbetçi kulesi inşa edin.";
"T_GAME_QUEST_SCEN12_09_START" = "Askerlerin sosisi ne kadar sevdiğini biliyor muydunuz?\nBir miktar üretmek için bir domuz çiftliği ve kasap dükkânı inşa edebilirsiniz.";
"T_GAME_QUEST_SCEN12_09_START2" = "Lordum.\nDomuz çiftliği ve kasap dükkânının inşaatını sizin idare etmenizi öneriyorum.\nBöylece köylüler için et ve askerlerimizin sevdiği sosislerden üretebiliriz.";
"T_GAME_QUEST_SCEN12_10_START" = "Hmm, sanırım bu zavallı askerlere birkaç kılıç ve zırh vermeliyiz. Bu, onların savaş sırasında hayatta kalabilmelerini büyük ölçüde geliştirir. Bunun için bir cephanelik ve tabakhaneye ihtiyacımız var.";
"T_GAME_QUEST_SCEN12_10_SUCCESS" = "Efendim, başardık! Artık askerlerimiz için biraz cephanelik yapabiliriz.";
"T_GAME_QUEST_SCEN12_10_TITLE" = "Bir cephanelik ve tabakhane inşa edin.";
"T_GAME_QUEST_SCEN12_10_TITLE_2" = "Bir cephanelik inşa edin.";
"T_GAME_QUEST_SCEN12_11_START" = "Artık bir cephaneliğimiz ve tabakhanemiz olduğuna göre ekipman üretimiyle başlamak harika olur.";
"T_GAME_QUEST_SCEN12_11_SUCCESS" = "Harika, Efendim! Askerler artık savaşta çok daha iyi performans gösterecek.";
"T_GAME_QUEST_SCEN12_11_TITLE" = "Askerler için ekipman yapın.";
"T_GAME_QUEST_SCEN12_14_SUCCESS" = "Çok güzel Lordum. Artık manastır sonraki haydut saldırılarına karşı korunur!";
"T_GAME_QUEST_SCEN12_15_START" = "Mahvolan şerbetçiotu tarlalarını yeniden inşa etmeyi başaramadık.\n\nBirkaç tane yerleştirebilir misiniz?";
"T_GAME_QUEST_SCEN12_15_TITLE" = "Birkaç şerbetçiotu tarlası inşa edin.";
"T_GAME_QUEST_SCEN12_15_TITLE_NEW" = "Bir şerbetçiotu çiftliği ve şerbetçiotu tarlası inşa edin.";
"T_GAME_QUEST_SCEN12_16_FAILED" = "Hahaha. Mütevazı manastırınız tarih oldu. Artık bu bölgeye ben hükmediyorum!";
"T_GAME_QUEST_SCEN12_16_START" = "O küçük keşişleri koruyabileceğinizi mi sandınız? Hiç sanmıyorum. O küçük manastırınızı nasıl yerle bir edeceğim size gösteririm.";
"T_GAME_QUEST_SCEN12_16_SUCCESS" = "Ahhh! Gelecek sefere bunu ödeyeceksiniz! Bu iş bitmedi…";
"T_GAME_QUEST_SCEN12_16_TITLE" = "Manastırdaki tüm saldırıları püskürtün!";
"T_GAME_QUEST_SCEN12_17_START" = "Lordum, keşiş arkadaşlarım ve ben ülkedeki en iyi içkilerin üretimine hemen başlayacağız.";
"T_GAME_QUEST_SCEN12_17_SUCCESS" = "Mayalama sürecini tamamladık Efendim. Birçok farklı türden içki oluşturuldu. Artık en iyilerini seçip sonrasında rafine etmemiz gerekiyor.";
"T_GAME_QUEST_SCEN12_18_START" = "İçki ustamız içkiyi daha da rafine etmek için içki yapım ekipmanımızı yükseltmemiz gerektiğini söyledi. Kralı memnun etmek istiyoruz değil mi? Ülkedeki en iyi içki olması gerekiyor…";
"T_GAME_QUEST_SCEN12_18_SUCCESS" = "Harika Lordum! Artık tek ihtiyacımız olan bu kaliteli malzemelerden bir miktar daha.";
"T_GAME_QUEST_SCEN12_18_TITLE" = "Manastırı 2. seviyeye yükseltin.";
"T_GAME_QUEST_SCEN12_19_START" = "Lort, içki neredeyse tamamlandı. Ancak hâlâ birkaç malzeme eksik. Ürünü tamamlamak için bitkiler ve biraz altın tozu harika olurdu.";
"T_GAME_QUEST_SCEN12_19_TITLE" = "Bitkiler ve altın keseklerini teslim edin. ";
"T_GAME_QUEST_SCEN12_20_START" = "İçkinin bir süre olgunlaşması gerekiyor.\n\nDış etkenlerle bozulmaması gerekiyor, içkinin olgunlaşma sürecinde dinlenmesi gerekiyor.";
"T_GAME_QUEST_SCEN12_20_SUCCESS" = "Tamamlandı Efendim. Size kusursuz içkiyi takdim edebilir miyim?";
"T_GAME_QUEST_SCEN12_20_TITLE" = "İçki yapım süreci tamamlanana kadar manastırı savunun.";
"T_GAME_QUEST_SCEN12_END_SUCCESS" = "Vekil, size bizzat teşekkür etmek istedim.\nBu benim için gerçekten de kusursuz doğum günü hediyesiydi. İçki yapımına olan hayranlığımı bildiğinizi bilmiyordum.";
"T_GAME_QUEST_SCEN12_MAINQUEST" = "Manastırı koruyun ve Kral için kusursuz içkiyi üretin.";
"T_GAME_QUEST_SCEN13_01_1_TITLE" = "Kasabayı Kralın gelişine hazırlayın. ";
"T_GAME_QUEST_SCEN13_01_FAIL" = "Beni kandırabileceğinizi mi sandınız? Küçük bir kasabayı yönetemediğiniz için hayal kırıklığına uğradım.\n\nBen koca bir krallığı yönetiyorum ancak kimseyi kandırmama gerek kalmıyor!";
"T_GAME_QUEST_SCEN13_01_START" = "Gelecek yıl içerisinde varlıklarımı denetleyeceğim.\nÜnlü kasabanız yolculuğumun doruk noktası olacak!";
"T_GAME_QUEST_SCEN13_01_SUCCESS" = "Sizden çok memnunum!\nBir kasabayı nasıl yöneteceğinizi gerçekten biliyorsunuz ve yüksek saygımı kazandığınızdan emin olabilirsiniz.";
"T_GAME_QUEST_SCEN13_01_TITLE" = "Kralın denetimini başarıyla geçin.";
"T_GAME_QUEST_SCEN13_02_START" = "Selamlar, Lort Vekilim! Muhteşem kasabanızı görmek için kasabanıza daha erken gelmeye karar verdim!\n\nGelişimi zaten bekliyormuşsunuz.";
"T_GAME_QUEST_SCEN13_02_TITLE" = "Kralın şüphelenmesine izin vermeyin.";
"T_GAME_QUEST_SCEN13_05_1_START" = "İlk olarak malların üretiminin yeniden devam etmesini sağlamalısınız!\n\nOrmancıyı yeniden görevlendirin ve üretime yeniden başlamak için kereste fabrikasını onarın.";
"T_GAME_QUEST_SCEN13_05_1_SUCCESS" = "Çok güzel Lordum.\nAncak dinlenmeye vakit yok!";
"T_GAME_QUEST_SCEN13_05_1_TITLE" = "Bir ormancı görevlendirin ve kereste fabrikasını onarın.";
"T_GAME_QUEST_SCEN13_05_START" = "Ah hayır! Ormandaki haydutlar yüzünden kasaba tamamen çürüdü.\n\nİnşaata hemen başlamalıyız!";
"T_GAME_QUEST_SCEN13_06_START" = "Pazar yandı ve yeniden inşa edilmesi gerekiyor!\n\nKasabayı Kralın gelişine hazırlamak için acilen mallara ihtiyacımız var.";
"T_GAME_QUEST_SCEN13_07_1_START" = "Ayrıca bir marangoza ihtiyacımız var Lordum. Birçok binanın acilen onarılmaya ihtiyacı var!";
"T_GAME_QUEST_SCEN13_07_START" = "Vergi toplayıcısının işine devam edebilmesi için maliyeyi onarmalıyız.\nOnarımlar için acilen para gerekiyor!";
"T_GAME_QUEST_SCEN13_07_SUCCESS" = "Gerekli onarmaları ödemek için vergi toplamalıyız.";
"T_GAME_QUEST_SCEN13_08_START" = "Kasabaya daha fazla işçi alabilmek için kasaba evlerini onarıp yenilerini inşa etmelisiniz.\nÜretime yeniden başlamalıyız!";
"T_GAME_QUEST_SCEN13_08_SUCCESS" = "Artık daha fazla işçi için yerimiz var ancak işimiz henüz bitmedi.";
"T_GAME_QUEST_SCEN13_09_START" = "Bu bir felaket!\nYalnızca Kralın ziyaret edeceği yerleri onarıp şüphelenmemesini umabiliriz.\n\nKral dinlenirken bu süreyi akıllıca kullanın!";
"T_GAME_QUEST_SCEN13_09_TITLE" = "Kral ziyaret edeceği ilk yeri duyurana kadar bekleyin.";
"T_GAME_QUEST_SCEN13_10_FAIL" = "Kral haydutları gördü ve şüphelendi! Daha dikkatli olmalıyız!";
"T_GAME_QUEST_SCEN13_10_START" = "Kral ormanları keşfetmek istiyor.\nOraya ulaşmadan önce haydut kamplarını yok etmeliyiz!";
"T_GAME_QUEST_SCEN13_10_SUCCESS" = "Ucuz atlattık! Ama henüz bitmedi…";
"T_GAME_QUEST_SCEN13_10_TITLE" = "Tüm haydut kamplarını yok edin. ";
"T_GAME_QUEST_SCEN13_11_FAIL" = "Ah hayır! Kralı kandırma konusunda başarısız olduk.\nArtık şüphelendiğine göre başka bir hata yapmamalıyız!";
"T_GAME_QUEST_SCEN13_11_START" = "Kral kasabada yürümek istiyor.\nMemnuniyetsiz kasaba halkını görürse bir şeylerin yolunda olmadığını kesinlikle fark edecektir.\n\nAyrıca Kralın bir heykelini inşa etmeliyiz!";
"T_GAME_QUEST_SCEN13_11_SUCCESS" = "Muhteşem! Kralın yürüyüşü boyunca tüm kasabalıların keyfi oldukça yerindeydi.";
"T_GAME_QUEST_SCEN13_11_TITLE" = "Kasaba halkının memnuniyetini artırın ve Kralın bir heykelini inşa edin.";
"T_GAME_QUEST_SCEN13_12_FAIL" = "Kral etkilenmedi!\nDaha fazla hata yapamayız!";
"T_GAME_QUEST_SCEN13_12_START" = "Kral birliklerimizi denetleyecek.\nKralın gelişini bekleyen etkileyici bir kasaba devriyemiz olduğundan emin olun!";
"T_GAME_QUEST_SCEN13_12_SUCCESS" = "Bu kasaba devriyesi Kralı kesinlikle etkileyecektir!";
"T_GAME_QUEST_SCEN13_12_TITLE" = "Yeterli sayıda askeri görevde tutun.";
"T_GAME_QUEST_SCEN13_13_FAIL" = "Lordum, başarısız olduk. Ziyafetler kralın standartlarına uymadı ve şimdi canı sıkkın! \n\nBelki de dürüst olmak daha iyi olurdu…";
"T_GAME_QUEST_SCEN13_13_START" = "Kral harika bir ziyafet çekmek istiyor. Stokta yeterli mücevherimiz ve asil giysilerimiz olduğundan emin olun.\nBaşarısız olursak her şey mahvolur!";
"T_GAME_QUEST_SCEN13_13_SUCCESS" = "Ziyafet oldukça başarılı oldu! Görünüşe göre Kralı kandırmayı başardık.";
"T_GAME_QUEST_SCEN13_13_TITLE" = "Giysi ve mücevher stoku yapın.";
"T_GAME_QUEST_SCEN13_14_START" = "Tüm değerli mallarımla sizin sokaklarınızda gezmek benim için fazla tehlikeli.\n\nKendi başınasınız!";
"T_GAME_QUEST_SCEN13_15_START" = "Artık haydutları bozguna uğrattığınıza göre kasabanızı ziyaret edip yeniden ticaret yapmak benim için bir zevk.";
"T_GAME_QUEST_SCEN13_16_START" = "Tüccar bir korkak ama doğruları söyledi!\nKasabanın etrafındaki ormanlar tehlikeli. Haydutlar için nöbet tutacak nöbetçiler eğitmeliyiz.";
"T_GAME_QUEST_SCEN13_16_SUCCESS" = " Lordum, köyün savunmasına yönelik temeli inşa ettiniz ancak bunu genişletmeliyiz.";
"T_GAME_QUEST_SCEN13_16_TITLE" = "Bir kışla ve nöbetçi kulesi inşa edin.";
"T_GAME_QUEST_SCEN13_19_FAIL" = "Ah hayır! Haydutlar savunmayı geçti mi!? Kral bunu duyduğuna sevinmeyecek. ";
"T_GAME_QUEST_SCEN13_19_START" = "Haydutlar güvenli bir kasaba imajını zedeler.\nDenetim sırasında çok fazla saldırının olmasına izin vermeyin, yoksa kesinlikle yakalanırız!";
"T_GAME_QUEST_SCEN14_01A_START" = "Efendim, sizce de bu adam biraz garip davranmıyor mu?";
"T_GAME_QUEST_SCEN14_01A_TITLE" = "Kumaş gönderin.";
"T_GAME_QUEST_SCEN14_01_FAILED" = "Lordum, görevimizde başarısız olduk!\nO tıbbi danışman bir şarlatanmış, maliyedeki tüm altınlarımızı alıp kaçtı.\n\nYine de laboratuvarında tedaviyi bulduğumuz için şanslıyız…";
"T_GAME_QUEST_SCEN14_01_START" = "Günaydın Efendim. Krallık veba ile kırılıyor.\nKral bile çok hasta! Kısa süre içinde bir tedavi üretmesi için krallığın tıbbi danışmanını desteklemeliyiz. ";
"T_GAME_QUEST_SCEN14_01_SUCCESS" = "Tedaviyi zamanında bulduk Lordum!\n\nBiz şu anda konuşurken Krala verilecek! Bu krallık için iyi haber!";
"T_GAME_QUEST_SCEN14_01_TITLE" = "Kral için tedavi bulun.";
"T_GAME_QUEST_SCEN14_02A_START" = "Lordum, bir şeyler yolunda değil! Tıbbi danışman garip şeyler istiyor. İçimde kötü bir his var…\n\nBu adam konusunda dikkatli olmalıyız.";
"T_GAME_QUEST_SCEN14_02A_SUCCESS" = "Siz emri verdiğinizde içkiyi doktora teslim edeceğim.\nUmarım bize kısa süre içinde bir tedavi sunabilir. Kralın çok fazla zamanı kalmadı!";
"T_GAME_QUEST_SCEN14_02A_TITLE" = "İçkiyi teslim edin.";
"T_GAME_QUEST_SCEN14_02_START" = "Sanırım Kral için biraz içki elde etmenin en iyi yolu bir manastır içki işletmesi olacak. \n\nUmarım içki Kralın acılarını hafifletir.";
"T_GAME_QUEST_SCEN14_02_START_NEW" = "Sanırım Kral için biraz içki elde etmenin en iyi yolu bir manastır içki işletmesi olacak.\n\nUmarım içki Kralın acılarını hafifletir.";
"T_GAME_QUEST_SCEN14_02_SUCCESS" = "Çok güzel Lordum! Keşişler kesinlikle biraz içki konusunda bize yardım edecektir! Kral çok memnun olacak.";
"T_GAME_QUEST_SCEN14_02_TITLE" = "Bir manastır inşa edin.";
"T_GAME_QUEST_SCEN14_02_TITLE_NEW" = "Bir manastır ve şerbetçiotu işleme evi inşa edin.";
"T_GAME_QUEST_SCEN14_03_START" = "Tıbbi danışmana domuzları teslim etmek için bir domuz çiftliğine ihtiyacımız var!\nEfendim, hemen inşaatın emrini vermelisiniz.";
"T_GAME_QUEST_SCEN14_03_SUCCESS" = "Muhteşem, Lordum. Artık biraz domuz yetiştirmeye başlayabiliriz.";
"T_GAME_QUEST_SCEN14_03_TITLE" = "Bir domuz çiftliği inşa edin.";
"T_GAME_QUEST_SCEN14_05_START" = "Lordum, kasabada bir kışlaya ihtiyaç var. Bu gibi zamanlarda kanun ve nizamı sürdürmeliyiz.";
"T_GAME_QUEST_SCEN14_06_SUCCESS" = "Lordum! Biliyordum!\n\nO tıbbi danışman bir şarlatan. Bunca zamandır Kral için tedavisi varmış.\nGörünüşe göre ülkeye bu hastalığı bulaştıran oymuş. \n\nNöbetçilere onu tutuklamaları için bilgi verdim.";
"T_GAME_QUEST_SCEN14_END_SUCCESS" = "Bu bir rezalet!\n\nNe cüretle beni tutuklarsınız! Ben Kralın özel danışmanıyım. \nBunu yapamazsınız…";
"T_GAME_QUEST_SCEN14_HEALER_01_FAILED" = "Beni hayal kırıklığına uğrattınız Vali!\n\nDün gece bir rüya gördüm! Bana, sizin yetersizliğinizin bu kasabaya büyük talihsizlik yaşatacağını gösterdi.\n";
"T_GAME_QUEST_SCEN14_HEALER_01_START" = "Vali! Benim adım Rasiksin, Kralın kâhini ve tıbbi danışmanıyım.\nBana sağlayabileceğiniz tüm desteğe ihtiyacım olacak!\nBaşlangıç olarak: Bana olabildiğince hızlı sürede yeterli miktarda şifalı bitki getirin!";
"T_GAME_QUEST_SCEN14_HEALER_01_SUCCESS" = "İhtiyacım olan tüm bitkileri ürettiğinizi görüyorum.\n\nDün gece bir rüya gördüm… Bana Kralı hayal kırıklığına uğratmayacağınızı gösterdi.\n\nŞimdi danışmanınıza söyleyin bana bitkileri teslim etsin sonra da başımdan gidin. Yapacak işlerim var.";
"T_GAME_QUEST_SCEN14_HEALER_01_TITLE" = "Bitkileri gönderin.";
"T_GAME_QUEST_SCEN14_HEALER_02_FAILED" = "Vali, size güvenmemeliydim! Rüyalarım sizin yetersizliğinizin kasabaya felaket getireceğini göstermişti! Vali, Kralı ve beni hayal kırıklığına uğrattınız!";
"T_GAME_QUEST_SCEN14_HEALER_02_START" = "İlacı süzmek için kumaşlara ihtiyacım var. Benim için biraz kumaş üretmelisiniz. Kısa süre içinde süzmeye başlayabilmem için bunu hızlıca yapın.";
"T_GAME_QUEST_SCEN14_HEALER_02_SUCCESS" = "Vali, vaktimi harcamadığınızı görmek güzel!\n\nŞimdi kaynakların teslimat emrini verin! Ben oldukça meşgul bir insanım!";
"T_GAME_QUEST_SCEN14_HEALER_02_TITLE" = "Kumaş üretin.";
"T_GAME_QUEST_SCEN14_HEALER_04_START" = "İlacın toplu üretim için inceltilmesi gerekiyor. Sıvı seçimi içki olsun! \n\nŞimdi iş başına koyulun!";
"T_GAME_QUEST_SCEN14_HEALER_04_SUCCESS" = "Tam zamanında! Şimdi laboratuvarıma teslimatı yapın.";
"T_GAME_QUEST_SCEN14_HEALER_04_TITLE" = "İçki üretin.";
"T_GAME_QUEST_SCEN14_HEALER_05_FAILED" = "Hayırr… Çok geç! Şimdi kasabanın başına bir talihsizlik daha gelecek.\n\nHepsi sizin suçunuz!";
"T_GAME_QUEST_SCEN14_HEALER_05_START" = "Kralı kurtarmak için daha ciddi önlemler almalıyız!\n\nGeleneksel tanrılara kurban etme için domuzlara ihtiyacım var.\nBelki yardımı dokunur…";
"T_GAME_QUEST_SCEN14_HEALER_05_SUCCESS" = "Vali, elinizi çabuk tuttuğunuzu söyleyemem. Gelmeye zahmet etmeniz ne hoş…";
"T_GAME_QUEST_SCEN14_HEALER_05_TITLE" = "Domuzları teslim edin.";
"T_GAME_QUEST_SCEN14_HEALER_06_START" = "Benim… Iıı… Kralın acısını hafifletmek için özel bir pipo otuna ihtiyacı var.\n\nBana ilaç almak için bir sandık dolusu para getirin!";
"T_GAME_QUEST_SCEN14_HEALER_06_SUCCESS" = "\nOnu bana ver! Ben… Iıı yani… Kral yakında ilacını alacağına sevinecek. Çok acı çekiyor.";
"T_GAME_QUEST_SCEN14_HEALER_06_TITLE" = "Parayı teslim edin.";
"T_GAME_QUEST_SCEN14_HEALER_07_START" = "Kralın giysilerinin onu hasta ettiğini fark ettim. Özel bir malzemeden yapılan yeni giysilere ihtiyacı var.";
"T_GAME_QUEST_SCEN14_HEALER_07_SUCCESS" = "Nihayet yeni giysilerle birlikte geldiniz. Kral çoktan sabırsızlanmaya başladı.";
"T_GAME_QUEST_SCEN14_HEALER_07_TITLE" = "Giysileri teslim edin.";
"T_GAME_QUEST_SCEN14_HEALER_08_START" = "Bu eski laboratuvarda çalışmaya daha fazla katlanamıyorum!\n\nGüzel bir laboratuvara dönüştürebilmem için bana bir nöbetçi kulesi inşa edin. Bir kulede olmalı, kuleleri severim.";
"T_GAME_QUEST_SCEN14_HEALER_08_SUCCESS" = "\nKralın adına bu kuleyi alacağım. Burası benim yeni laboratuvarım olacak. Şimdi gidin başımdan!";
"T_GAME_QUEST_SCEN14_HEALER_08_TITLE" = "Bir nöbetçi kulesi inşa edin.";
"T_GAME_QUEST_SCEN14_HEALER_09_START" = "Vali, son bir şey eksik.\n\nİlacı tamamlamak için altın külçelere ihtiyacım var. Bana biraz altın külçe getirin.";
"T_GAME_QUEST_SCEN14_HEALER_09_SUCCESS" = "Sonunda! Şimdi ilacı rafine etmek için sadece biraz zaman gerekli.\n\nKaçış… Yani ilacın uygulanması için bazı hazırlıklar yapmam gerekecek.";
"T_GAME_QUEST_SCEN14_HEALER_09_TITLE" = "Altın külçeleri teslim edin";
"T_GAME_QUEST_SCEN15_01_FAIL" = "Her şey kaybedildi! Birçok cesur adamın ölümünde payınız olduğunu bilerek yaşamak zorunda kalacaksınız…";
"T_GAME_QUEST_SCEN15_01_FAIL_NEW" = "Her şey kaybedildi! Gerekli tedarikler olmadan zafer kazanamadık.\n\nBirçok cesur adamın ölümünde payın oluşunu bilerek yaşamak zorunda kalacaksınız!\n\nKral öfkeden köpürüyor…";
"T_GAME_QUEST_SCEN15_01_START" = "Selamlar, Lort Vekilim.\nDevam eden savaş için Kralın malzeme alma talebi üzerine geldim.\n\nKasaba halkınızın savaştan dolayı sıkıntı çektiğini biliyorum ancak cephedeki askerlerin acilen desteğinize ihtiyacı var!";
"T_GAME_QUEST_SCEN15_01_START_NEW" = "Selamlar, Lort Vekil.\nDevam eden savaş için Kralın malzeme alma talebi üzerine geldim. Kasaba halkınızın savaştan dolayı sıkıntı çektiğini biliyorum ancak cephedeki askerlerin acilen desteğinize ihtiyacı var!\n\nAncak tüm teslimatlar zamanında ulaşırsa bir zafere ulaşılabilir.\n\nKral desteğinize güveniyor.";
"T_GAME_QUEST_SCEN15_01_SUCCESS" = "Zafer sizindir!\nÖzellikle sağlam desteğinizin buna çok katkısı oldu, adamlarım size içtenlikle minnettar.\n\nHuzurlu zamanlar yakında başlasın!";
"T_GAME_QUEST_SCEN15_01_TITLE" = "Kralın ordusunu destekleyin.";
"T_GAME_QUEST_SCEN15_01_TITLE_NEW" = "Tüm tedarikleri Kralın ordusuna zamanında teslim edin.";
"T_GAME_QUEST_SCEN15_02_FAIL" = "Birçok adamın hayatı sizin desteğinize bağlı!";
"T_GAME_QUEST_SCEN15_02_START" = "Yeni bölgeler keşfettik ve şimdi ön hattı emniyete almalıyız.\nKamp inşa edebilmemiz için hızlıca tahta ve kumaş gönderin!";
"T_GAME_QUEST_SCEN15_02_SUCCESS" = "Çok güzel. Şimdi askerlerime kaynaklar gönderin!";
"T_GAME_QUEST_SCEN15_02_TITLE" = "Kumaş ve tahtalar gönderin.";
"T_GAME_QUEST_SCEN15_03_FAIL" = "Düzgün ekipman olmadan herhangi bir savaşı nasıl kazanacağımızı umuyorsunuz?";
"T_GAME_QUEST_SCEN15_03_START" = "Son savaş çok fazla ekipman tüketti!\n\nAdamlarımın yeniden kuşanması için bir silah teslimatı talep ediyorum.";
"T_GAME_QUEST_SCEN15_03_SUCCESS" = "Bu yeni silahlarla askerler gelecek savaşta kesinlikle zafer kazanacaktır.";
"T_GAME_QUEST_SCEN15_03_TITLE" = "Silahlar teslim edin.";
"T_GAME_QUEST_SCEN15_04_FAIL" = "Sizin teslimatınız olmadan son savaş için hiç umudum yok!";
"T_GAME_QUEST_SCEN15_04_START" = "Erzaklarımız azalıyor!\nSon savaş için gücümüzü kazanabilmemiz için ekmek ve et gönderin.";
"T_GAME_QUEST_SCEN15_04_SUCCESS" = "Askerler yiyecek bekliyor, hemen gönderin!";
"T_GAME_QUEST_SCEN15_04_TITLE" = "Ekmek ve et gönderin.";
"T_GAME_QUEST_SCEN15_07_TITLE" = "İçki ve sosis teslim edin.";
"T_GAME_QUEST_SCEN15_08_START" = "Cesur askerlerimizi yüzüstü bırakamayız ancak kasaba halkı da yokluk çekiyor Lordum.\nKarar size kalmış!\nİlk önce bir kereste fabrikası ve avcı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN15_08_SUCCESS" = "Şimdi umarım hazırlıklı olacağız.";
"T_GAME_QUEST_SCEN15_08_TITLE" = "Bir kereste fabrikası ve avcı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN15_09_START" = "Bu kaynakları teslim etmek için bir koyun otlağı ve dokuma fabrikasına ihtiyacımız var.";
"T_GAME_QUEST_SCEN15_09_SUCCESS" = "Lordum, harika iş. Yükselterek veya ilave binalar inşa ederek üretim hızını her zaman artırabilirsiniz.";
"T_GAME_QUEST_SCEN15_09_TITLE" = "Bir koyun otlağı ve dokuma fabrikası inşa edin.";
"T_GAME_QUEST_SCEN15_10_START" = "Askerlerimizi desteklemek için ileri seviye bir demir sanayiine ihtiyacımız var!";
