"T_GAME_QUEST_DESIRES_10_TITLE" = "Altın haraç verin.";
"T_GAME_QUEST_DESIRES_11_START" = "Bu şantaja boyun eğmeyi düşünmüyorsunuz değil mi?\nAltınları yeni giysiler için harcamak çok daha iyi bir yatırım olur!";
"T_GAME_QUEST_DESIRES_11_TITLE" = "Tüccardan giysi satın alın.";
"T_GAME_QUEST_DESIRES_12_START" = "Bu köy sıkıcı, eğlence eksik!";
