"T_LEVELSELECTION_START_GAME" = "Oyunu başlatın";
"T_LOADINGTIP_001" = "Çiftçiler mahsuller yeniden yetişene kadar çalışamaz. Birkaç daha küçük tarla inşa ederseniz çiftçiler tarlaları ekerek dinlenme süresinden kaçabilirler.";
"T_LOADINGTIP_002" = "Taşıma gecikmelerinden kaçınmak için depolara taşıyıcı olarak yeterli kasabalı görevlendirdiğinizden emin olun.";
"T_LOADINGTIP_003" = "Taverna, bir meyve suyu fabrikasından meyve suyu veya manastırdan içki tedarik edildiğinde daha etkilidir.";
"T_LOADINGTIP_004" = "Kilise gibi bir kamu binası yalnızca sınırlı sayıda Kasabalıya hizmet edebilir.";
"T_LOADINGTIP_005" = "Bazı dekorasyonlar mutluluğu artırmada diğerlerinden daha etkilidir. Daha büyük nüfuslar belirli seviyede mutluluğu korumak için daha fazla dekorasyona ihtiyaç duyar.";
"T_LOADINGTIP_006" = "Gözünüz Kasabalılarınızın mutluluğunda olsun. Kasabalılarınızın ihtiyaçları ve isteklerini takip edebilmek için istatistik menüsünü kullanın. ";
"T_LOADINGTIP_007" = "Kasabalılarınızın ihtiyaç ve isteklerini gidermekte ne kadar iyi olursanız onlar grev yapmadan önce o kadar yüksek vergilendirebilirsiniz.";
"T_LOADINGTIP_008" = "Tüccar kasabaya geldiğinde acil ihtiyaç duyduğunuz kaynakları satın alabilir ya da fazla malları para için satabilirsiniz.";
"T_LOADINGTIP_009" = "Bir çiftlik buğday, yün veya bitkiler üretebilir. Buğday için bir buğday tarlasına ihtiyacınız olur. Koyun için bir otlak ve bitkiler için bir bitki bahçesine ihtiyacınız olur. Onları çiftliğin yakınlarına yerleştirin.";
"T_LOADINGTIP_010" = "Üretim binalarınızda çalışacak bolca Kasabalınız olması için hızlıca erkenden kasaba evleri inşa edin.";
"T_LOADINGTIP_011" = "Küçük bir köy balıkçılar ve avcılar tarafından kolaylıkla tedarik edilebilir ancak bir fırın ve kasap dükkânı büyük köyler için daha uygundur.";
"T_LOADINGTIP_012" = "Gözünüz her zaman odun üretiminde olsun. Birçok binanın üretim için bir kaynak olarak oduna ihtiyacı olur.";
"T_LOADINGTIP_013" = "Örneğin maden ve çiftlik gibi bazı binalar birden fazla kaynak üretebilir.";
"T_LOADINGTIP_014" = "Üretim binası zincirinizdeki girdi çıktı oranını anlamaya çalışın. Böylece tam kapasitede çalıştığından emin olabilirsiniz. ";
"T_LOADINGTIP_015" = "İsteğe bağlı haraç ödeme görevlerini tamamlayarak kum havuzu oyununda Prestij kazanabilirsiniz.";
"T_LOADINGTIP_016" = "Senaryolar, senaryoyu tamamlamak için yerine getirilmesi gereken belirli görevlerden oluşur.";
"T_LOADINGTIP_017" = "Bir senaryoyu tamamladıktan sonra oynamaya devam etme seçeneği verilir.";
"T_LOADINGTIP_018" = "Bir maliye inşa edin! Vergi toplayıcısı kasabayı gezerek ziyaret ettiği her evden vergi hasılatını artırır.";
"T_LOADINGTIP_019" = "Marangoz dükkânı oldukça kullanışlıdır. Marangoz, kasabada gezerek kaynaklar ve para harcayarak çürüyen binaları onarır.";
"T_LOADINGTIP_020" = "Bina durumu oldukça önemlidir. Yıkık dökük kasaba evleri Kasabalılarınızı mutsuz eder ve kötü durumdaki üretim binaları daha az üretkendir. Kötü onarılan binalarda da bir yangın çıkma riski yüksektir.";
"T_LOADINGTIP_021" = "Kasabalıların günlük rutinleri bulunur. İşe mola verdiklerinde boş zamanlarını eve gidip yemek yiyerek ya da isteklerini gidererek kullanırlar.";
"T_LOADINGTIP_022" = "Bir binayı yıkarken inşaat masraflarının yarısı kurtarılabilir. Yine de kaynaklar Kasabalılar tarafından harabelerden taşınmalı. Bu olmadan önce aynı yere başka bir bina inşa ederseniz kaynakları kaybedersiniz.";
"T_LOADINGTIP_023" = "Madenler yalnızca kayalık dağ yamaçlarına inşa edilebilir. Cevher yataklarının üzerine inşa edilen madenler taş çıkartmanın yanında demir cevher ve altın cevher de çıkartabilir.";
"T_LOADINGTIP_024" = "Yollar, malların ve kaynakların taşınmasını hızlandırır. Kasabalılarınız genellikle yolları kullanmayı tercih ediyor. Taş yollarda taşıma toprak yollardan daha hızlıdır.";
"T_LOADINGTIP_025" = "Vergi oranınız fazla yüksekse kasabalılarınız mutsuz olur ve hatta grev bile yapabilirler. Yine de bazı istekleri yerine getirirseniz daha yüksek vergiler ödemeye istekli olabilirler.";
"T_LOADINGTIP_026" = "Kasabalı hanımlar kasaba evlerine yiyecek ve su tedarik eğer. Ayrıca mücevher ve giysiler mevcut olduğunda bunları satın almak için pazarı ziyaret ederler. Diğer yandan kasabalı erkekler üretim binalarında çalışır.";
"T_LOADINGTIP_027" = "Bina depolarınız sıklıkla doluysa daha fazla depo inşa etmeli ve ilave taşıyıcılar görevlendirmelisiniz.";
"T_LOADINGTIP_028" = "Çalışkan Kasabalılar sonunda yorulur ve mola verir. Dinlendikten sonra çalışmaya devam ederler.";
"T_LOADINGTIP_029" = "Tam bir yıllık döngü 60 dakika alır. Değişen mevsimler her haritada bulunmaz ve bazıları çok daha uzun mevsimlere sahiptir.";
"T_LOADINGTIP_030" = "Tarlalar kışın boş durur! Soğuk mevsime bol buğday, bitki, şerbetçiotu ve üzüm suyu stoklayarak hazırlanmalısınız. ";
"T_LOADINGTIP_031" = "Avlanmak kış için muhteşem bir yiyecek kaynağıdır. Avcı, bölgesinde yeterli geyik veya tavşan olduğu sürece kasabaya et ve post temin eder. ";
"T_LOADINGTIP_032" = "Onları verilen bir süre içinde tamamlamazsanız bazı görevler başarısız olabilir.\nBir görevde başarısız olmak çoğunlukla görev ödülünü almayacağınız anlamına gelir ancak bazen bir senaryoda başarısız olunabilir.";
"T_LOADINGTIP_033" = "Bir senaryoyu tamamladıktan sonra oynamaya devam etme seçeneği verilir. Sonrasında oyun kum havuzu moduna geçer.";
"T_LOADINGTIP_034" = "Çok fazla avcıya sahip olmak av nüfusunu büyük ölçüde azaltabilir.\nYeni geyiklerin veya tavşanların ortaya çıkış hızı haritadaki ormanlık alanın boyutuna bağlıdır.";
"T_LOADINGTIP_035" = "Bazı görevlerin süre sınırı bulunur. Görevin tamamlanması için kalan süre ekranın sol üstünde bir uyarı mesajı olarak gösterilir.";
"T_LOADINGTIP_036" = "Depoların aşırı yüklenmesini önlemek veya depo menüsünde kaynakları yok etmek için fazla üretim yapan binaları devre dışı bırakın.";
"T_LOADINGTIP_037" = "Görevler tamamlayarak ve kasabanızı geliştirerek seviyenizi artırabilirsiniz. Seviyeniz ne kadar yüksek olursa kilidi açılan ödüller o kadar iyi olur!";
"T_LOADINGTIP_038" = "Doktor, hasta Kasabalıları bitki bahçesindeki bitkilerle iyileştirebilir.";
"T_LOADINGTIP_039" = "DP, bina inşa ederek, pazarda ticaret yaparak, kasabada yüksek mutluluğa ulaşarak, görevler tamamlayarak ve büyük bir nüfusa ulaşarak kazanılabilir.";
"T_LOADINGTIP_040" = "Bina yükseltmeleri çok güçlüdür. Örneğin bir binada daha fazla işçinin görevlendirilmesine veya bir binanın depo alanını artırmaya olanak sağlar!";
"T_LOADINGTIP_041" = "Bir madenin kaynak yatağı tükendiğinde birkaç seçeneğiniz bulunur. Başka bir yatak arayın, oraya yeni bir maden inşa edin veya daha fazla yatağı erişilebilir kılması için tükenen madene bir jeolog gönderin.";
"T_LOADINGTIP_042" = "Kasabanızın seviyesini artırarak güçlü araştırma kilidini açarsınız. Bina yükseltmeleri, artırılmış vergi geliri veya daha iyi görev ödülleri gibi!";
"T_LOADINGTIP_043" = "Yükseltilen binaların dezavantajları da bulunur:\nEk işçiler kaynak tüketimini artırır ve her bir yükseltmeyle birlikte binanın onarım masrafı da artar!";
"T_LOADINGTIP_044" = "Belirli kasaba seviyelerine ulaştığınızda bina yükseltmelerinin kilidi açılır. Prestij harcayarak bina menüsünden binaları yükseltebilirsiniz.";
"T_LOADINGTIP_045" = "Jeolog araştırmak çok kullanışlıdır! Jeoloğu bir madende görevlendirdiğinizde yavaşça cevher yatağını yeniden doldurur.";
"T_LOADINGTIP_046" = "Yeni bir kasaba seviyesine ulaşıldığında ilave araştırma seçeneklerinin kilidi açılacaktır. Bir araştırma tamamlandığında bonuslar tüm kasabalar için kalıcı olacak mevcut olur! ";
"T_LOADINGTIP_047" = "Kasabanız belirli bir büyüklüğe ulaştığında bir veba salgını riski bulunur! Kasabalılarınızı iyileştirmek için bir revire ve bitki bahçesine ihtiyacınız olacaktır.";
"T_LOADINGTIP_048" = "Kasabanızda bir veba veya yangın çıktığında hemen bir revir veya yangın kulesi inşa etmelisiniz. Doktor hasta Kasabalıları iyileştirir ve itfaiyeci yanan binaları söndürür.";
"T_LOADINGTIP_049" = "Bir binanın performansını artırmak için onu yükseltin. Binanın içerik menüsünde yükseltme sekmesini bulabilirsiniz.";
"T_LOADINGTIP_050" = "Binalarınıza iyi bakın! Onları düzenli olarak onarmazsanız duman çıkarabilirler ve hatta yanıp kül olabilirler.";
"T_LOADINGTIP_051" = "Kasabanız veba veya yangın ile tahrip olduğunda Kasabalılarınız kasabayı terk edebilir. Tehlike sona erdiğinde ve yeterli miktarda boş müsait kasaba evleri olduğunda sonunda geri gelirler.";
"T_LOADINGTIP_052" = "Bir kışla, yalnızca etki alanındaki nöbetçi kulelerine tedarik sağlayabilir.";
"T_LOADINGTIP_053" = "Askerleriniz bir savaşı kaybettiklerinde geri dönüp yaralarını iyileştirecektir.";
"T_LOADINGTIP_054" = "Bir binanın içerik menüsü faydalı bilgilerle doludur. Yalnızca haritadan bir bina seçin.";
"T_LOADINGTIP_055" = "Haydutlar bir binaya saldırdıklarına kaynaklar çalabilir, yangın çıkarabilir veya binayı yıkabilir.";
"T_LOADINGTIP_056" = "Bir binadaki haydut saldırısı askerleriniz tarafından durdurulabilir ancak bunu yapmak için süre sınırlıdır.";
"T_LOADINGTIP_057" = "Tabakhane için hayvan postları, avcı kulübesi veya kasap dükkânı tarafından üretilir.";
"T_LOADINGTIP_058" = "Askeri araştırma size savaşta büyük faydalar ve köyünüz için koruma sağlayabilir.";
"T_LOADINGTIP_059" = "Köyünüzü olabildiğince fazla nöbetçi ve yangın kuleleriyle koruyun.";
"T_LOADINGTIP_060" = "Kışlada çalışan taşıyıcılar depodan askerlerin tedariklerini alarak menzildeki nöbetçi kulelerine teslim eder.";
"T_LOADINGTIP_061" = "Kasabanızdaki mevcut etkileri görmek için menüye göz atın. Bir haritada geçici ve kalıcı olarak aktif olabilirler. Örnekler şunlardır: Aktif haydutlar, uzun bir kış veya azaltılmış vergi geliri.";
"T_LOADINGTIP_062" = "Askerlere ekipman ve yiyecek tedarik ederken saldırı ve savunma istatistikleri bundan doğrudan etkilenir. Kılıç tedarik edilen askerler daha fazla saldırı değerine sahip olur.";
"T_LOADINGTIP_063" = "Hem saldırı hem de savunma istatistiğini artırmak için askerlerinize yiyecek ve içecek tedarik etmeye çalışın.\nTedariki iyi yapılan askerler iyi savaşır!";
"T_LOADINGTIP_064" = "Bir savaş birkaç aşamadan oluşur: Her iki taraf da ilk adım aşamasına kimin başlayacağını belirlemek için zar atar. Sonrasın da iki taraf da dönerek saldırı ve savunma yapar. ";
"T_LOADINGTIP_065" = "Sakinlerin veya işçilerin o anda ne yaptığını görmek için bir binanın içerik menüsündeki "Kasabalıyı Takip Edin" modunu kullanın.";
"T_LOADINGTIP_066" = "Haydut saldırıları harita sınırından veya haritada yer alan bir haydut kampından gelebilir. Bir haydut kampı yükseltilebilir, bu da kampın daha iyi savunulduğu anlamına gelir.";
"T_LOADINGTIP_067" = "Kışlalar, Nöbetçi kuleleri ve yangın kuleleri çalıştığı yerde bir etki alanına sahiptir. Örneğin itfaiyeci alanın dışındayken yanan binalarla ilgilenemez.";
"T_LOADINGTIP_068" = "Bir binayı yerleştirirken kapsama modunda veya binanın içerik menüsünde etki alanını görebilirsiniz. Bu görüntüleme modu kışlalar, nöbetçi kuleleri ve yangın kuleleri için mevcuttur.";
"T_LOADINGTIP_069" = "Bir bina ve üretimi hakkında daha fazlasını öğrenmek istiyorsanız binanın içerik menüsünü ziyaret edin ve "bina bilgisi"ne gidin.";
"T_LOADINGTIP_070" = "Birçok üretim zinciri ve ekonominiz buğdaya bağlıdır. Kış başlamadan önce stokta bolca buğday bulundurmalısınız.";
"T_LOADINGTIP_071" = "Yanan bir binada ne kadar fazla alev olursa yangın o kadar ilerlemiş olur. Bina çökebilir!";
"T_LOADINGTIP_072" = "Kasabadaki eğlence isteği birkaç eğlence binası tarafından giderilebilir. Binaların her biri yalnızca belirli miktarda Kasabalıyı memnun edebilir.";
"T_LOADINGTIP_073" = "Her mevsimin kasabanızda farklı bir etkisi bulunur. Örneğin kış giysi ihtiyacını artırır.";
"T_LOADINGTIP_074" = "Kışın köyünüz kar fırtınaları ve çığlarla tehlikeye girebilir.";
"T_LOADINGTIP_075" = "Yazın kasabanız kuraklık yaşayabilir. Etkisi geçene kadar tarlalarınız kurumaya başlar.";
"T_LOADINGTIP_076" = "Şerbetçiotları tedarik edilebilmesi için manastırın bir şerbetçiotu işleme evine ihtiyaç duyar.";
"T_LOADINGTIP_077" = "Meyve suyu fabrikası, ona üzüm tedarik etmesi için bir üzüm bağına ihtiyaç duyar.";
"T_LOADINGTIP_078" = "Revirin doktoru bitki hasadı yapmaz. Bitkileri hasat etmekten bir çiftçi sorumludur. Doktor bitkilerini depodan alır.";
"T_LOADINGTIP_079" = "Hava durumlarının kasabanızda özel etkileri olur. Biraz yağmurdan sonra çiftlikleriniz geçici olarak daha verimlidir. ";
"T_LOADINGTIP_080" = "Kasabanızdan bir fırtına geçerken binalarınıza yıldırım düşüp onları yakabilir.";
"T_LOADINGTIP_081" = "Her mevsim panayır alanında festivaller olur. Devam eden bir festival olduğu her zaman genel mutluluk geçici olarak artar.";
"T_LOADINGTIP_082" = "Menüdeki etki ekranına bir göz atın. Orada kasabanızda hangi etkilerin işlediğini görebilirsiniz.";
"T_LOADINGTIP_083" = "Binalarınızdan birisi yıkıldığında onu yeniden inşa etmek için enkazdaki yön tabelasını seçebilirsiniz.";
"T_LOADINGTIP_084" = "Kasabayı bir tipi etkilediğinde kasabalılarınız daha yavaş yürür ve binalar daha hızlı çürür.";
"T_LOADINGTIP_085" = "Binalarınızdan birisi kilitli veya müsait değilse özel bir gereksinim eksik olabilir.";
"T_LOADINGTIP_086" = "Bir fırtına devam ederken binalarınıza yıldırım düşebilir!";
"T_LOADINGTIP_087" = "Şiddetli bir kar yağışında binalarınız daha hızlı çürür!";
"T_LOADINGTIP_088" = "Hızlı menü binaları onarmanın, işçiler görevlendirip görevden almanın ve kasabalıları hızlıca takip etmenin iyi bir yoludur.";
"T_LOADINGTIP_089" = ""İstatistikler" sekmesindeki "binalar"ın altında, tüm binalara ilişkin bir genel bakış bulabilirsiniz. Birini seçmek, o türdeki tüm binalar arasında geçiş yapmanızı sağlar.";
"T_LOADINGTIP_090" = "Kapsama ana görünümünde farklı türden kaplamalar arasında geçiş yapabilirsiniz.";
"T_LOADINGTIP_091" = "Etkinlik menüsü tamamlanmış görev veya araştırma gibi etkinliklere doğrudan geçiş yapmaya olanak sağlar.";
"T_LOADINGTIP_092" = ""Kasaba bilgisi" kategorisinde kasabanızı yeniden adlandırabilirsiniz.";
"T_LOADINGTIP_093" = "Mevcut aile sayısı "kasaba bilgisi"nin altında bulunabilir.";
"T_LOADINGTIP_094" = "Etkinlik menüsünde ciddiyetlerine göre uyarıları sıralayabilir ve hatta onları ekranda gizleyebilirsiniz.";
"T_LOADINGTIP_095" = "Yel değirmeninin etkili olarak çalışabilmesi için birkaç çiftlik tarafından buğday tedarik edilmesi gerekiyor.";
"T_LOADINGTIP_096" = "Yangınlar yağmur ile söndürülebilir.";
"T_LOADINGTIP_097" = "Hasta köylülerin kendi kendilerine iyileşme olasılığı düşüktür.";
"T_LOADINGTIP_098" = "Kasaba dili bir Danca, Fince ve Volapük karışımıdır.";
"T_LOADINGTIP_099" = "Bir binanın mevcut olan aktif etkilerinin tamamı binanın içerik menüsünde görülebilir.";
"T_LOADINGTIP_100" = "Esnaf loncası ticareti otomatikleştirebilir. Alım ve satım emirleri kasabaya her tüccar gelişinde başlatılır.";
"T_LOADINGTIP_101" = "Vergiler düzenli aralıklarla otomatik olarak toplanır. "Vergiler" kategorisinin altında "mutluluk" menüsünden vergileri düzenleyebilirsiniz.";
"T_LOADINGTIP_102" = "Townsmen'deki nüfus Kasabalı ve Kasabalı Hanımlardan oluşan ailelerden oluşur. Bina kapasiteleri her zaman aileleri gösterir.";
"T_LOADINGTIP_103" = "Çığlar yalnızca kışın ve bazı dağ yamaçlarında oluşur. Bir çığ tetiklenirse etki alanındaki binalar hasar görür veya durumlarına bağlı olarak yıkılabilir.";
"T_LOADINGTIP_104" = "Haydutlar bazen şehre birkaç büyük grup halinde saldırır. Şehrin çok fazla saldırıya uğramaması için şehir nöbetinin yeterince büyük olması gerekir.";
"T_LOADINGTIP_105" = "Binaları onarmak kaynağa mâl olur. Bir bina ne kadar gelişmişse masrafı da o kadar yüksek olur.";
"T_LOADINGTIP_106" = "İçerik menüsünden bir bina için mevcut tüm eylemlere ulaşmak için oradaki eylemler düğmesini kullanın.";
"T_LOADINGTIP_107" = "Balıkçı ve avcı kulübeleri kış için tek güvenilebilir yiyecek kaynaklarıdır.";
"T_LOADINGTIP_108" = "Liman gibi bazı içerikler yalnızca "Deniz Kenarı İmparatorluğu"nda mevcuttur.";
"T_LOADINGTIP_109" = "Bir sonsuz oyundaki kısa hikâyeler diyaloglar halinde karar verme olanakları bulunan küçük etkinliklerdir. Bazı kararların kalıcı sonuçları olur!";
"T_LOADINGTIP_110" = "Bazen kısa hikâyelerdeki seçenekler seçilebilir değildir ve hatta belirli bir şart yerine getirilmezse gizlidir.";
"T_LOADINGTIP_111" = "Birçok etkinlik, şehir başına yalnızca bir kez başlar. Çoğu kısa hikâye eşsizdir.";
"T_LOADINGTIP_112" = "Kısa hikâyeler ve etkinlikler çoğu durumda iptal edilebilir. Ancak bir kez başladıktan sonra ancak bir kararla sonlandırılabilirler.";
"T_LOADINGTIP_113" = "Kısa hikâyeler, etkinlikler ve askeri kale yalnızca yeni bir sonsuz oyuna başladığınızda mevcuttur. Burada sonsuz oyunu kişiselleştirmek için birkaç seçenek de bulacaksınız.";
"T_LOADINGTIP_114" = "Haydutlar, felaketler, rastgele görevler veya kısa hikâyeler sonsuz modda açılıp kapatılabilir. Bu ayarlar yalnızca bir sonsuz haritaya başlandığında değiştirilebilir.";
"T_LOADINGTIP_115" = "Kısa hikâyeler bazı şartlar yerine getirildiğinde harekete geçirilebilir. Örneğin belirli bir bina dikilirse veya sakinlerin sayısı belirli bir büyüklüğe ulaşırsa.";
"T_LOADINGTIP_116" = "Bazen bir kısa hikâyedeki bir karar durumunda bir veya daha fazla seçenek mevcut değildir. Bu, bir önkoşulun yerine getirilmemesinden kaynaklanır.";
"T_LOADINGTIP_117" = "Askeri kalenin yalnızca küçük bir depolama kapasitesi vardır ancak savunma binalarına erzak tedarik edebilir. Taşıyıcıların, askerlerin ve vardiya çavuşlarının görevlendirilmesini sağlar.";
"T_LOADINGTIP_118" = "Deniz Kenarı İmparatorluğu. Güzel sahilleriyle tamamen yeni bir ortamda seçenek ve sonuçlar sunan sonsuz saat içerik, yeni binalar, dekorasyonlar, haritalar, senaryolar ve harika etkinlikleri deneyimleyin!";
"T_LOADINGTIP_119" = "Orta büyüklükte kasaba evi varsayılan olarak 4, şehir evi 3 aileye yaşam alanı sunar.";
"T_LOADINGTIP_120" = ""Deniz Kenarı İmparatorluğu"ndaki neredeyse tüm binalar yeni bir görünüşe sahip.";
"T_LOADINGTIP_121" = "Bundan sonra sonsuz modda kale türünü seçmek mümkün. Normal kale, "Deniz Kenarı İmparatorluğu" için artık yenilenmiş bir görünüşe sahip. Ayrıca artık haydut saldırılarına karşı büyük avantaj sağlayan askeri kale de bulunuyor.";
"T_LOADINGTIP_122" = ""Deniz Kenarı İmparatorluğu" hakkında daha fazlasını öğrenmek isterseniz yardım sayfasında detaylı bilgileri bulabilirsiniz. İndirilebilir içeriği tanımlayan ayrıca bir madde bulunuyor.";
"T_LOADINGTIP_123" = "Bazen binaların üretkenliğini değiştiren olaylar olur. Bu, yağmurdan sonra çiftliklerin artırılmış üretkenliği olabilir ancak çözülmeyen bir görevden sonra azaltılmış üretkenlik gibi karara bağlı da olabilirler.";
"T_LOADINGTIP_CLOUDSAVE_01" = "Veri kaybından kaçınmak için kayıtlı oyunlarınızı düzenli olarak buluta yükleyin!";
"T_LOADINGTIP_CLOUDSAVE_02" = "Kayıtlı oyunlarınız bulut ile otomatik olarak senkronize olmaz! Oyununuzu buluta kaydetmek için oyun menüsündeki bulut düğmesini veya Google Oyun Hizmetlerini kullanın.";
"T_LOADINGTIP_CLOUDSAVE_03" = "Kayıtlı oyunlarınız bulut ile otomatik olarak senkronize olmaz!";
"T_LOADINGTIP_CLOUDSAVE_04" = "Townsmen, oyununuzu buluta kaydetmeniz için size hatırlatma yapacak. Seçenekler menüsünde buluta kaydetme hatırlatıcılarını etkinleştirebilir veya devre dışı bırakabilirsiniz.";
