"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS" = "Efendim, tarlalar yavaş yavaş iyileşiyor. Mahsul hastalığı sona eriyor gibi görünüyor.";
"T_GAME_QUEST_DISASTER_DROUGHT_SUCCESS_02" = "Efendim, tarlalar yavaş yavaş iyileşiyor. Kuraklık sona eriyor gibi görünüyor.";
"T_GAME_QUEST_DISASTER_FIRE_START" = "Lort Vekil, kasaba alevler içinde!\n\nTüm kasabaya yayılmadan önce yangını hızlıca söndürmeliyiz.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS" = "Harika iş Efendim.\n\nTüm yangınlar söndürüldü ve kasaba yeniden güvende.";
"T_GAME_QUEST_DISASTER_FIRE_SUCCESS_NEW" = "Efendim, kasabada daha fazla yangın yok.";
