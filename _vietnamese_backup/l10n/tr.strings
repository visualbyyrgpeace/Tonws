"QUESTS_COMMUNITY_SATISFACTION_DESC" = "Köylüler, onlar için yoğun bir iş gününün ardından buluşup bir bardak üzüm suyu içecek veya biraz içki yudumlayacak bir halk alanı olsa daha mutlu olurdu. Lordum, bunu istemek çok mu olur?";
"QUESTS_COMMUNITY_SATISFACTION_SUMMARY" = "Topluluk memnuniyetini yükseltin.";
"SCENARIO_COUNTER_THIEF_END_DESC" = "Pekâlâ Vali. Benimle ticaret yapmayacaksanız adamlarım ihtiyacı olanları sadece alacak.";
"SCENARIO_COUNTER_THIEF_END_FAILED" = "Bu sefer şansınız yaver gitti. Bir dahaki sefere bu kadar kolay olmayacak.";
"SCENARIO_COUNTER_THIEF_END_SUCCESS" = "Ha ha ha. Bu size bir ders olsun. Bir dahaki sefere benimle ticaret yapacağınıza eminim.";
"SCENARIO_CW_QUEST_B_20_DESC" = "Lordum, bir sürü taşa ihtiyacım var. Bana biraz taş verirseniz ben de size odun desteği sağlarım.";
"SCENARIO_CW_QUEST_B_30_DESC" = "Lordum, köyün inşaatını desteklemek için biraz odun topladım. Biraz buğday ile takas edeceğim.";
"SCENARIO_CW_QUEST_B_40_DESC" = "Kızım dün gece soğuktan donuyordu. Bana bir miktar yün verebilir misiniz? Karşılığında size değerli odunlar verebilirim.";
"SCENARIO_CW_QUEST_B_50_DESC" = "Lordum, bir sorum var… Oğlum deri tabaklama mesleğini öğrenmek istiyor. Pratik yapmak için biraz posta ihtiyacı var. Biraz odun ile takas edebilirim.";
"SCENARIO_CW_QUEST_B_60_DESC" = "Lordum, biraz bitkiniz var mı? Ne yazık ki etimi tatlandırmak hiç bitkim yok.\nKarşılığında size en iyi odunlarımdan vereceğim.";
"SCENARIO_CW_QUEST_B_70_DESC" = "Lordum, evimi onarmak istiyorum. Kalan son yakacak odun yığınımla birkaç alet takas eder misiniz?";
"SCENARIO_CW_QUEST_B_80_DESC" = "Lordum, bir ziyafet hazırlamak istiyorum. Lütfen bana destek sağlar mısınız? Karşılığında size biraz odun verebilirim.";
"SCENARIO_CW_QUEST_B_NAME" = "Çiftçi ile ticaret yapın.";
"SCENARIO_CW_QUEST_B_START_01_DESC" = "Lordum, ailem açlıktan kırılıyor. Bize biraz balık getirme nezaketinde bulunur musunuz? Karşılığında size küçük yakacak odun stokumdan biraz odun bile verebilirim.";
"SCENARIO_CW_QUEST_B_START_02_DESC" = "Onarımlar için ufak bir odun stokum var. Lordum, onu biraz taş karşılığında takas ederim.";
"SCENARIO_CW_QUEST_C_10_DESC" = "Adamlarımın daha fazla balığa ihtiyacı var. Bana biraz balık getirirseniz size odun veririm! Ayrıca küçük köyünüzü de bağışlarım.";
"SCENARIO_CW_QUEST_C_20_DESC" = "Hey Vali! Size bir iyilik yapıp deponuzdaki ağır taşlardan bazılarını almak istiyorum. Bunu yapmama izin verirseniz size odun bile veririm.";
"SCENARIO_CW_QUEST_C_30_DESC" = "Buğdayı çiftçilerinize verip boşa harcamadan önce bana verirseniz size en iyi odunlarımdan veririm.";
"SCENARIO_CW_QUEST_C_40_DESC" = "Kılıç kabzalarımızı yünle yumuşatmak istiyoruz. Merak etmeyin, işbirliği yaparsanız onları size karşı kullanmayacağız.";
"SCENARIO_CW_QUEST_C_50_DESC" = "Adamlarım sıkıldı. Bize post verirseniz eğitim kuklalarımızın daha gerçekçi görünmesi için onları geliştirebiliriz. Benimle ticaret yapmak istemiyorsanız eğitimlerimizi Kasaba Halkınızın üzerinde gerçekleştiririz.";
"SCENARIO_CW_QUEST_C_60_DESC" = "Adamlarımdan birisi hâlâ hasta. Bitkilerin ona yardımcı olabileceğini duydum. Sakıncası olmazsa deponuzu arayacağım. Eminim onları bulabilirim.";
"SCENARIO_CW_QUEST_C_70_DESC" = "Aletlerimiz artık kullanılacak halde değil. Vali, sizde onlardan çok var. Bize biraz verme nezaketini gösterirseniz onları kendim alarak kabalık etmeyeceğim.";
"SCENARIO_CW_QUEST_C_80_DESC" = "Adamlarım biraz et yemek istiyor. Onları teslim ederseniz cömertlik yapıp karşılığında size odun vereceğim. \n\nYoksa benim çocuklar küçük kasabanızı ziyaret edip kendileri alabilirler…";
"SCENARIO_CW_QUEST_C_NAME" = "Haydutla ticaret yapın.";
"SCENARIO_CW_QUEST_C_START_01_DESC" = "Ah, yeni bir Vali…\nBurada yeni olduğunuz için size kuralları açıklayayım. Siz bana istediğimi verin ben de yapmanız gerekenleri yapmanıza izin vereyim.\n\nAdil bir anlaşmaya benziyor, değil mi? Pekâlâ, kolay bir görevle başlayalım: Bana biraz balık getirin!";
"SCENARIO_CW_QUEST_C_START_02_DESC" = "Odun sıkıntısı mı var? Sorun yok!\nÇaldığım… Iıı… Depoladığım büyük bir yığın odun var. Birkaç taş karşılığında seve seve biraz odun takas ederim.";
"SCENARIO_THIEF_FAIL" = "Yani gerçekten benimle ticaret yapmak istemiyorsunuz hı?\n\nPekâlâ, siz olacakları görürsünüz.";
"THEBEAST_ATK_002_SCENE_ADVISOR_ITEMS_EXPERT_QUEST" = "Lordum, bakın burada ne var… Bir dişe benziyor. İnsana ait değil. Burada da! Daha fazla yer mantarı. Bir teori ortaya koyacak bilgim yok ama bize yardım edebilecek birisini tanıyorum. Hadi gidip ihtiyar adamı görelim!";
