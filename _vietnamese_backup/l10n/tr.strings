"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_ABORT" = "Bir anda geldiği gibi aniden ortadan kayboldu. Kısa bir süreliğine, farklı karar vermiş olsaydınız ne olacağını düşünüyorsunuz ancak olanlar değiştirilemez. Bunu asla bilemeyeceksiniz.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_AFTERCHOICE_HAPPINESS" = "Ertesi gün sakinlerin ne kadar mutlu olduğunu görüyorsunuz. Demirci yeni bir kadınla tanışmış ve âşık olmuş. Marangoz nihayet neşe dolu son projesini duyurmuş. Bir beşik. Ne güzel! Herkesin morali iyi. Ne güzel bir gün.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_AFTERCHOICE_WEALTH" = "Ertesi sabahın erken saatleri. Aniden sadık danışmanınız yatak odasına geliyor. "Lordum! Buna inanmayacaksınız" diye bağırıyor. Kekelemeye devam ediyor "..M..Ma…Maliye! Ağzına kadar dolu. Bir gecede çok daha zengin olduk!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_AFTERCHOICE_WISDOM" = "Ertesi sabah uyandığınızda şiddetli bir baş ağrısı hissediyorsunuz. Sanki bilgi bir çekiçle çivilenmiş gibi. Artık her şeyi biliyormuşsunuz gibi geliyor, her şey kafanızda dolaşıyor. Kütüphanedeki tüm kitapları ezbere okuyabilir ve her şeyi, hatta bebekliğinizi bile hatırlayabilirsiniz. Gerçek bilgeliğe ulaştınız!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_AYEARAFTER_01" = "Kasaba için iyi bir yıl oldu. Bir yıl önceki gizemli ziyaretçiyi neredeyse unuttunuz. Buz gibi lezzetli bir içkiyle şöminenizin yanında oturup ateşin sıcaklığının tadını çıkartıyorsunuz. ";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_AYEARAFTER_02" = "Odadaki hava birden çok soğuk oluyor! Masanıza bakıyorsunuz ve yeniden onu orada otururken görüyorsunuz. Gizemli yabancı geri dönmüş!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_01_DESC" = "Hızlıca komodinin başından bir meşale alıyorsunuz ve yeniden figüre dönüyorsunuz. Gitmiş…";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_01_REPLY_01" = "Garip.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_01_REPLY_02" = "Sıra dışı.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_01_REPLY_03" = "Bu bir rüya olmalı.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_02_DESC" = ""Size bir teklifim var…" diyor yabancı. "Sizin için yapabileceğim bir şey olduğuna inanıyorum. Sadece en çok ne istediğinizi söyleyin." diye devam ediyor. Soruya cevap vermenizi bekliyor…";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_02_REPLY_01" = "Mutluluk";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_02_REPLY_02" = "Zenginlik";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_02_REPLY_03" = "Bilgelik";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_02_REPLY_04" = "Burada laf ebelerine yer yok!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_03_AFTERCHOICE_STATEMENT" = "Yabancı gülümseyip gölgelerin içinde kayboluyor. Ne demek istedi? Şimdi ne olacak?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_03_DESC" = "Size şu cümleleri söylemeden önce uzun süre karanlık bakışlarla bakıyor: "Zamanı gelen için buradayım. Bir bedelinin olacağını söylemiştim."";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_03_REPLY_01" = "Ne?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_03_REPLY_02" = "Bedel mi?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_03_REPLY_03" = "Nöbetçiler!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERCHOICE_STATEMENT" = "Yabancı kafasını sallıyor ve gülümsüyor. Bir an sonra şu sözleri söylüyor "Bir bedeli olacak…" ve ortadan kayboluyor. Bu konuda içinizde kötü bir his var. Neler olacak?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_01_STARTED" = "Danışman aceleyle dinleme salonuna girerek "Lordum, köyün her yerinde yangınlar çıktı!" diyor. Duman kokusunu henüz almıştınız. Şimdi de onayı geldi. "İtfaiyecilere ilk öncelik ve uyarı düzeyini verdim." O bedel bu mu?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_01_SUCCESS" = "İtfaiye lideri, tüm yangınların söndürüldüğünü veya kontrollü bir şekilde yanmasına izin verildiğini teyit eder. Köy tekrar güvende.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_02_STARTED" = "Dinleme salonunun kapısı büyük bir gürültüyle açılır. Kötü haberi getiren doktordur. "Lordum, köydeki yeni durumdan haberdar olmalısınız." Birkaç dakika duraklar. "Veba salgını patlak verdi. Çok sayıda hasta insan var ve çok fazla kişiye bulaşmış. Hızlı hareket etmeliyiz". Bedel ödeme zamanı geldi!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_02_SUCCESS" = "Veba salgını sona erdi Lordum. Kasaba yeniden güvende.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_03_STARTED" = ""Lordum, garip bir şey oluyor. Kendiniz bakın" pencereden dün tamamlanan bir binaya işaret ediyor. Bir harabe gibi görünüyor. "Lordum, binalar… Hızla çürüyorlar. Neler oluyor?" Bedel ödeme zamanı geldi!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_03_SUCCESS" = "Sadık danışmanınız dinleme salonuna giriyor. "Sanırım sona erdi Lort." diyor neşeyle. "Binaların anormal şekilde çürümesi normalde dönmüş görünüyor."";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_04_STARTED" = "Kalenin giriş kapısında domuz çobanıyla kendini kaybetmiş bir halde tartışan bir çiftçi ile karşılaşıyorsunuz. Neler olduğu sorulduğunda, çiftçi heyecanla bildiriyor. "Her şey ölüyor lordum. Irmaklardaki balıklar da çobanın domuzları da. Ormanda ve tarladaki mahsuller. Buğday, şerbetçiotları, üzümler. Her şey ölüyor. Lanetlendik! Bedel ödeme zamanı geldi!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_04_SUCCESS" = "Tarlalar lordum! Yeniden büyüyorlar. Sanırım bu lanetin nihayet üstesinden geldik. Ne şans ama!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_05_STARTED" = "Köyde çok garip bir şey oluyor. Tüm hareketlerin oldukça zor olduğunu önceden fark etmiştiniz. Her şey inanılmaz yavaş görünüyor. Pencereden baktığınızda köyün tüm sakinlerinin çok yavaş hareket ettiğini görüyorsunuz. Bedel bu mu?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_AFTERRECKONING_05_SUCCESS" = "Neredeyse sonsuz süre sonra köydeki hareket hızı yeniden normalde dönüyor. Bir talih kuşu! Görünüşe göre bedel ödeme sona erdi.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_HAPPINESS_AFTERCHOICE_STATEMENT" = "Demek ki tüm istediğiniz hayallerinizdeki köyde hayatınızın aşkıyla sonsuza kadar mutlu yaşamak! ";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_WEALTH_AFTERCHOICE_STATEMENT" = "Yani Krallıktaki en zengin kişi olmak mı istiyorsunuz?";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_CHOICE_WISDOM_AFTERCHOICE_STATEMENT" = "Ahhh, siz tek gerçek gücü arzu ediyorsunuz… Bilgelik! İyi seçim.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_DESC" = "O gece gizemli bir yabancı karşınıza çıktı ve size bir teklif sundu.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_INTRO_01" = "Bu gece kale buz gibi soğuk. Rüzgâr salonlarınızda uğulduyor. Kapının yanındaki dolaptan daha kalın battaniyeler almak için kalktığınızda göz ucunuzla bir gölge görüyorsunuz.\nOdada birisi var! ";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_INTRO_02" = "Güvenilir danışmanınız olabilir mi? Ya da kötü niyetli birisi?\nYavaşça dönüyorsunuz ve masanızın yanındaki sandalyede karanlık bir figürün oturduğunu görüyorsunuz. Figür hareket etmiyor… Sadece orada oturuyor.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_INTRO_03" = "Saat geç oldu ve yorgunsunuz. Kale kulesindeki odanıza doğru yukarı çıkıyorsunuz. Salonunuza giden kapıyı açmadan hemen önce her yer çok soğuk olmaya başlıyor. Yavaşça kapıyı açmaya başlıyorsunuz. Neredeyse yarısı açıkken odanızda yine o figürün orada oturduğunu görüyorsunuz!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_INTRO_04" = "Loş ışıkta önünüzde daha önce hiç görmediğin giysiler giymiş bir adam görüyorsunuz. Rahatsız hissediyorsunuz. Bir şeyler yolunda değil. Adam yavaşça sandalyeden kalkıyor. Hareketlerinde garip olan bir şey var ama tam olarak ne olduğunu tarif edemiyorsunuz.\nDerin ve yavaş bir sesle konuşmaya başlıyor.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_RECKONING_SUMMARY" = "Her dileğin bir bedeli vardır.";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_SUMMARY" = "Teklifi kabul edin… Bunu istiyorsunuz!";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_TITLE" = "Gizemli Yabancı";
"T_RANDOM_EVENT_MYSTERIOUS_STRANGER_UNHAPPY_DESC" = "Lordum, birçok sakin gece onları rahatsız eden korkunç rüyalardan bahsediyor. İnsanlar memnun değil ve işlerinde tam çaba gösteremiyor. Uykusuzlar.";
"T_RANDOM_EVENT_OUTCOME_DROUGHT_BUILD_WELLS" = "Tarlaların sulanmasını ve kasaba için tedarikleri iyileştirerek kuraklığın üstesinden çok daha iyi gelebiliriz Lordum.";
"T_RANDOM_EVENT_OUTCOME_DROUGHT_DO_NOTHING" = "Her zamanki gibi bu sıkıntının da üstesinden geldik ve bu zor zamanları atlattık… Düşünceler ve dualar ile.";
"T_RANDOM_EVENT_OUTCOME_DROUGHT_LIMIT_WATER" = "Pekâlâ Lordum. Yine de köylülerin kararınızı beğeneceğini sanmıyorum.";
"T_RANDOM_EVENT_OUTCOME_DROUGHT_TOOLS" = "Çok güzel Lordum. Bence önlemler alındıktan sonra kuraklığın üstesinden daha iyi gelebiliriz.";
"T_RANDOM_EVENT_OUTCOME_FALLENSTAR_STATEMENT_01" = "Çok güzel Lordum. Hemen siparişini vereceğim.";
"T_RANDOM_EVENT_OUTCOME_FALLENSTAR_STATEMENT_02" = "Bir alıcı bulduk sör. Taş iyi bir fiyata gidecek.";
"T_RANDOM_EVENT_OUTCOME_FALLENSTAR_STATEMENT_03" = "Taşın yardımıyla kömürcüdeki ekipmanı geliştirebildik. Bundan sonra kalıcı olarak daha etkili çalışabileceğiz.";
"T_RANDOM_EVENT_OUTCOME_FALLENSTAR_STATEMENT_04" = "Vali, bu muhteşem hediye için teşekkürlerimi kabul edin. Heykel gerçekten çok özel!";
"T_RANDOM_EVENT_OUTCOME_FARMERS_AND_CRAFTSMEN_STATEMENT_01" = "Lordum, kararınızın sonuçları olacak.";
"T_RANDOM_EVENT_OUTCOME_FARMERS_AND_CRAFTSMEN_STATEMENT_02" = "Yani bizim işimizin zanaatkârlardan daha az değerli olduğunu mu söylüyorsunuz Lordum? Peki, göreceğiz.";
"T_RANDOM_EVENT_OUTCOME_FARMERS_AND_CRAFTSMEN_STATEMENT_03" = "Pekâlâ, çiftçileri seçeceğinizi biliyordum Lordum! Bakalım bu olay nasıl ilerleyecek.";
"T_RANDOM_EVENT_OUTCOME_FARMERS_AND_CRAFTSMEN_STATEMENT_04" = "Lordum, bence halkımızı hayal kırıklığına uğrattınız. Şimdi iki grup da kızgın.";
