"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_005" = "Hayır dediysem hayır.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_006" = "Onu gönderin.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_007" = "Verildi.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_008" = "Daha fazla gezgin çekmek söz konusu bile olamaz.";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_HELP_OK_001" = "Eşsiz bir cömertlik patlamasıyla işe koyulun. Bu han bir çiçekler içinde yüzecek!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_OK" = "Peki, tamam.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_001" = ""Duyduk duymadık demeyin millet! Hanın yeni bir sahibi var! Yeniden açılış için hana gelin!"\n\nKasabanın tellalının keyfi bugün yerinde. Söylenene göre hana her yeni misafir geldiğinde bahşiş alıyormuş.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_002" = "Sör, hanın yeni sahibi ziyaret etti. Onu karşılamak ister misiniz?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DESC_003" = "Sör, lütfen. Han, gezginlerin en sevdiği yerlerden birisi. Bu yeri geliştirerek şehrin ününü artırabiliriz.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_001" = "Günaydın Sör. Beni kalenizde ağırladığınız için teşekkürler.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_002" = "Bizi ziyaret etme onurunu neye borçluyuz?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_003" = "Şey, görüyorsunuz ki han kötü bir durumda. Önceki sahibi gerçekten umursamazmış. Yalnızca tedarikler değil müşteriler konusunda da!";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_004" = "Iı, evet, siz öyle diyorsanız öyledir. Handa pek vakit geçirmiyoruz.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DIALOGUE_005" = "Bu yüzden yardımınızı istemek için buradayım. Müessesemin etrafına çiçekler ekleyerek başlamak istiyorum. Daha göz alıcı bir görüntü sağlamak için. Geri dönsünler diye daha fazla gezgin çekmek istiyorum.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_001" = "Şimdi ikinci adıma geçelim! İçkiler.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_002" = "Ah! İkinci bir adım… Pekâlâ, burada olduğumuza göre devam da edebiliriz. Programınızdaki bir sonraki adım nedir?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_003" = "En iyi kalite odunun yanında metale de ihtiyacımız var.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_004" = "İçkiler hakkında bir şey dememiş miydin? Neden şimdi odun lazım?";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_005" = "Hadi ama, düzgün fıçılar yapmak için! Bir önceki sahibin içkileri depolamak için düzgün fıçıları bile yokmuş. Tedarikçiler kötü odun kullanıyor olmalı. Bu yüzden kendimiz yapmak için yeterli odun ve demir külçeler toplamamız gerekiyor.";
"T_GAME_QUEST_ENEMIES_FLOWERS_DRINKS_006" = "Harika! Çok güzeller!";
"T_GAME_QUEST_ENEMIES_FLOWERS_END_002" = "Öyle anlıyorsanız öyledir. Kendi başıma halledeceğim!";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_INN" = "Bundan sonra kasaba tellalı duyurularında hana ayrıcalık gösterecek.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_001" = "Bundan sonra kasaba tellalı duyurularında tavernaya ayrıcalık gösterecek.";
"T_GAME_QUEST_ENEMIES_FLOWERS_FINAL_TAVERN_002" = "Teşekkürler Vali! İnsan sonuca bakmalı.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SUCCESS_FLOWERS_001" = "Ah, teşekkürler Sör! Han çiçeklerle çok daha hoş oldu.";
"T_GAME_QUEST_ENEMIES_FLOWERS_SURE_001" = "Hadi Sör, bunu düşünmek için kendinize biraz zaman verin. Han, köy için önemli bir gelir kaynağı. Projelerinizden bazılarını tamamlamanıza yardımcı olabilir.\n\nÇabalarınızı durdurmak istediğinize emin misiniz?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_001" = "Ne diyorsunuz Sör?! Bu yaşlı kadına hanı için yardım ediyorsunuz ama ya ben? Tavernam için bana yardım etmiyorsunuz!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_002" = "Hadi ama, valiyle konuşurken terbiyeli olun.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_003" = "Bu kadınla aynı ayrıcalıkları elde etmeyi talep ediyorum!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_004" = "Müesseseniz için çiçekler de istiyor musunuz?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_005" = "Çiçekler mi? Hayır! Ben müessesemi destekleyen bir kasaba tellalı istiyorum!";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_006" = "Sör, ne yapmalıyız?";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_007" = "Tavernayı tanıtın.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TAVERNE_DIALOGUE_008" = "Hanı tanıtın.";
"T_GAME_QUEST_ENEMIES_FLOWERS_TITLE" = "Çiçekler ve Düşmanlar";
"T_GAME_QUEST_FEAST_TITLE" = "Kasaba için bir festival düzenleyin.";
"T_GAME_QUEST_FIRECOVERAGE_TITLE" = "Köyü yangın gözetleme kuleleriyle koruyun.";
"T_GAME_QUEST_FIRE_COVERAGE_DESC" = "Lordum, kasaba büyük yangınlara karşı hazır değil! Köyün çoğunluğu yangın gözetleme kuleleriyle korunmuyor. Olabildiğince çok binayı koruması için kuleler yerleştirmelisiniz.";
"T_GAME_QUEST_FOOD_STARTED" = "Sör, yiyecekleri unutmayalım! Dolu bir kiler olmadan festival olmaz. Hadi acele edip kaynakları stoklayalım. Onlara ne kadar kısa sürede sahip olursak projeniz o kadar kısa süre içinde başarıya ulaşır.";
"T_GAME_QUEST_FOOD_SUCCESS" = "Festival katılımcılarımız açlıktan ölmeyecek! Ah Sör, hedefe ulaşıyoruz! Sabırsızlanıyorum!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_001" = "Bir kraliçeye serinletici bir içecek teklif edemeyen bir vali mi? Size karşı şüpheci olmam söylenmişti ama dinlemek istememiştim!";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_002" = "Kraliçe Frygith, hadi ama böyle ufak bir şey için sinirlenmeyin. Sadece bir serinletici içecek. Bu kadar dramatik olmayın.";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_003" = "Görüyorum ki danışmanınız bile bana saygısızlık yapmaya başlıyor…";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_BYE_004" = "Durum tamamen kontrolden çıkıyor, artık ne yapacağınızı bilmiyorsunuz ve stres seviyeniz gittikçe artıyor.\n\nNasıl tepki vereceksiniz?";
"T_GAME_QUEST_FORTUNE_TELLER_ANSWER_CALM_001" = "Kraliçeyi sakinleştirmeye çalışın.";
