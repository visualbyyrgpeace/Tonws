"T_GAME_QUEST_DREAM_TIME_ANSWER_001" = "Yatağa geri dönün.";
"T_GAME_QUEST_DREAM_TIME_ANSWER_002" = "Size güveniyorum.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_A" = "Ah hayır! Hayır! O rüya sahibini dinlemeliydik! Bazı insanlarda garip bir hastalık çıkmaya başladı.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_B" = "Neyse ki sayemizde bu hastalığı durdurmayı başardık. Gelecek sefere uyarıları dinlesek iyi olur…";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_001_C" = "Bu kasabalı bizi daha önce de birkaç felaketten kurtarmıştı. Ne olur ne olmaz diye bir revir inşa edelim Sör.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_001" = "Ah Sör! Reviri inşa etmeyi henüz bitirdik ve kasabalılarımızdan bazıları hasta. Bu kasabalıyı dinlemeye karar vermeniz iyi oldu! Hasar sınırlandırıldı! İyi iş sör.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_002" = "Yine de onları iyileştirmemiz gerekiyor Sör. Yoksa hastalık yayılabilir.";
"T_GAME_QUEST_DREAM_TIME_CONSEQUENCE_002_003" = "Muhteşem! Tüm kasabanın sağlığı yeniden yerinde. İşimize geri dönebiliriz.";
"T_GAME_QUEST_DREAM_TIME_DESC" = "Lordum, dün gece rüyamda köyümüze garip bir hastalık bulaşacağını gördüm. Tüm sakinlerin burnu tıkanmıştı. \n\nSizce rüyam bir uyarı olabilir mi?";
"T_GAME_QUEST_DREAM_TIME_TITLE" = "Rüya zamanı";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_001" = "Dört gözle bekliyorum!";
"T_GAME_QUEST_ENEMIES_FLOWERS_ANSWER_002" = "Ah, bir önceki için bir tercihim vardı.";
