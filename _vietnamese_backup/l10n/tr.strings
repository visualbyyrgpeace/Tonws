"T_TUTORIAL_06_EXPEDITION_RUNNING_TITLE" = "Şu anda bir sefer devam ediyor…";
"T_TUTORIAL_06_EXPEDITION_TITLE_01" = "Ormana bir sefer yapmak için bütçe ayırın.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_01" = "Hah! Beni gerçekten bu noktaya getirdiniz… Köyünüzü yok etmeli ve maliyenizdeki tüm parayı çalmalıydım! Lanet olsun… Yalnızca bu hain soylu yüzünden foyam ortaya çıktı!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_02" = "Alçak! Kraldan çalmak için kumar bağımlılığımı kullandınız. Sonunda bu kâbus sona erdi ve Kralın altınları bulundu.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_03" = "Ve bu asil Vali seni tepetaklak etti. Bu biz, köy ve tüm Krallık için harika bir gün.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_04" = "Bakın! Kralın ordusu nihayet geldi!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_05" = "Yer açın! Kralınız için yer açın! Yolu açın, Kral geçmek istiyor…";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_06" = "İyi güler baylar. Görüyorum ki adamlarım ve ben, haydutlara karşı zafer kazanışınızı görmek için tam zamanında geldik. ";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_07" = "Siz Merhametsiz Kızılsakal'sınız değil mi? Krallığın en belalı haydudu sonunda yakalandı.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_08" = "Evet, o benim Majesteleri. Buradaki Valiniz beni yakaladı.";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_09" = "Vali, siz gerçek bir kahramansınız. Maliyemden altın çalmakla suçlanıp bir Lort olarak unvanınızı kaybettiğinizi duydum. Bu doğru mu?";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_10" = "O suçlu değil Majesteleri. Parayı çalan bendim. Kızılsakal bana şantaj yaptı. Gerçekten özür dilerim!";
"T_TUTORIAL_06_MAINQUEST_END_DIALOGUE_CONV_11" = "Peki. Bu ikisini zindana atın. Vali ile Krallığın geleceği hakkında konuşmamız gerekiyor…";
"T_TUTORIAL_06_MAINQUEST_EXPEDITION_FAILED" = "Lordum, adamlarımız döndü. Ne yazık ki haydut kampını bulamadılar.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_01" = "Lort, köyde birkaç sorun var. Onlarla hemen ilgilenmeliyiz!";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_02" = "İlk olarak kasabamızdaki mutluluk çok düşük. Köylülerin isteklerini yerine getirmeye başlamanızı öneririm.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_03" = "Lordum, ikinci olarak kasaba nöbetindeki askerlerin neredeyse hiç erzakı ve ekipmanı yok. Kasabayı savunabilmek için daha fazla erzaka ihtiyacımız var Lort.";
"T_TUTORIAL_06_MAINQUEST_EXPLAIN_CONV_04" = "İlk önceliğimiz o haydut kampını bulmak olmalı. Onu bulursak yıkabiliriz Lordum.";
"T_TUTORIAL_06_MAINQUEST_OBJECTIVE_01" = "Haydut kampını bulun.";
