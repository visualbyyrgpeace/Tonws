"T_TUTORIAL_01_DESC_GOTO_BUILDMENU_TOUCH" = "İnşa etme menüsünü açın ve kasaba evinizi seçin.";
"T_TUTORIAL_01_FISHER_CONV_01" = "Burada balıkçı kulübemizi görebilirsiniz. Şu anda yel değirmeni yandığı için tek yiyecek kaynağımız bu. Belki de Lordumuz bunu yakında değiştirebilir.";
"T_TUTORIAL_01_FISHER_CONV_02" = "Harika… Balıklardan nefret ediyorum…";
"T_TUTORIAL_01_HINT_CLAIM_TO_CONTINUE" = "Devam etmek için görev ekranından ödülünüzü seçin.";
"T_TUTORIAL_01_INTRO_02_STARTED" = "Dirgenler ve meşalelerle karşılanmadığımızı görmek güzel Lordum. Kralın sarayındaki o çılgınlıktan sonra zindana atılmamakla kalıp yalnızca buraya transfer edildiğimiz için memnun olmalıyız Efendim.";
"T_TUTORIAL_01_INTRO_03_STARTED" = "Burası kasabamızın kuyusu. Biraz eski ve kasaba için tam yetecek kadar suyu var ancak kasabaya daha fazla köylü taşınırsa yakında yeni bir tane inşa etmemiz gerekecek.";
"T_TUTORIAL_01_INTRO_04_STARTED" = "Bayan Fitz-Givens! Oduncu Woodrow artık bıktı. Artık böylesine harap olmuş bir binada çalışamayacağını söyledi. Kasabadan ayrıldı ve artık ormancı kulübesi boşta. Şimdi ne yapacağız?";
"T_TUTORIAL_01_INTRO_STARTED" = "Vali, küçük mütevazı köyümüze hoş geldiniz! Umarım güzel bir yolculuk geçirmişsinizdir. Ben kalenin kâhyası Bayan Fitz-Givens. Sizinle tanışmak bir zevk Efendim.";
"T_TUTORIAL_01_LEVELUP" = "Tebrikler!\nİlk seviyenizi atladınız. Yeni bir seviyeye ulaştığınız her seferde tüm kasabalarınız için yeni gelişmeler araştırabilirsiniz.";
"T_TUTORIAL_01_LEVELUP_HINT" = "Her seviye atladığınızda yeni araştırma olasılıklarının kilidi açılır. Araştırmalar araştırma menüsünden yapılabilir.";
"T_TUTORIAL_01_MAINQUEST_OBJECTIVE_01" = "Hizmetkârın talimatlarını takip edin.";
"T_TUTORIAL_01_MAINQUEST_STARTED" = "Vali, hizmetkârınız valizinizi açarken kasabada bir tur atmak için ne güzel bir gün. İşte, size kasabanın en önemli yerlerini göstermeme izin verin.";
"T_TUTORIAL_01_MAINQUEST_STARTED_2" = "Bakın, orada isteği olan birisi var.\n\nBelki de sizin için yapacak bir şey vardır Lordum.";
"T_TUTORIAL_01_MAINQUEST_SUCCESS" = "Lordum. İşin ilk gününde kendinizi fazla yormayın! Ayrıca akşam yemeği kalede veriliyor. Günü bitirip bir şeyler yemelisiniz.";
"T_TUTORIAL_01_MAINQUEST_TITLE" = "Tüm görevleri tamamlayın.";
"T_TUTORIAL_01_PLACEMENT_HINT" = "Bu ağaç gibi nesneler inşaatlarınıza engel olabilir.";
"T_TUTORIAL_01_PRESTIGE_STARTED" = "Lordum, son zamanlarda biraz Prestij kazandığınızı fark ettim. Bazen belirli görevler için Prestij kazanırsınız. Kasabamızı geliştirirken bize çok yardımcı olur ve iyilikler için bir para birimi olarak görülebilir.";
"T_TUTORIAL_01_PRESTIGE_SUCCESS" = "Prestij bina yükseltmeleri, özel dekorasyonlar inşa etme veya bir inşaat alanını hızlıca tamamlamak için kullanılabilir.";
"T_TUTORIAL_01_QUICKMENU_02_DESKTOP" = "Bir binaya sağ tıklamak hızlı menüyü açar. Sonrasında istediğiniz seçeneği seçin.";
"T_TUTORIAL_01_QUICKMENU_02_TOUCH" = "Hızlı menüyü açmak için binaya uzun tıklayın. Sonradan istediğiniz seçeneği seçin.";
"T_TUTORIAL_01_REPAIR_QUICKMENU_01" = "Onarma ve işçi görevlendirme gibi bazı bina seçeneklere hızlı menüden kolaylıkla erişilebilir.";
"T_TUTORIAL_01_REPAIR_QUICKMENU_02" = "Bir binanın üzerindeyken "kabul etme" düğmesine basılı tutun ve sol çubuğu istenilen yönde hareket ettirip bırakın.";
"T_TUTORIAL_01_REPAIR_QUICKMENU_02_DESKTOP_LONGPRESS" = "Bir binanın üzerindeyken sağ fare tuşuna basılı tutun, istenen yöne hareket ettirin ve bırakın.";
"T_TUTORIAL_01_REPAIR_STARTED" = "Lordum, ormancı kulübesini onarmanız önerilir. Bir bina ne kadar çürürse üretkenliği de o kadar azalır. Yıkılabilir veya zaman zaman onarılmazsa bir yangın bile çıkabilir.";
"T_TUTORIAL_01_REPAIR_SUCCESS" = "Çok güzel Efendim. Gözümüzü kasabadaki evlerde tutmak akıllıca. Çoğu durumda kahverengimsi dış görünüşüyle harap olmuş bir binayı tespit edebilirsiniz. ";
"T_TUTORIAL_01_REPAIR_TITLE" = "Harap olmuş binayı onarın.";
"T_TUTORIAL_01_RUIN_CONV_01" = "Pekâlâ, bir yıldırım çarpıp yanmadan önce yel değirmenimiz burada dururdu. Belki de böyle bir şeyin bir daha olmasını engellemek için bir yangın gözetleme kulesi inşa etmeliyiz.";
"T_TUTORIAL_01_RUIN_CONV_02" = "Harika, bu ücra kasaba bir ölüm kapanı…";
"T_TUTORIAL_01_SAWMILL_STARTED" = "Efendim, bir kereste fabrikası inşa edilmeli. Bu, kasabadaki inşaat alanlarında kullanılmak üzere odunu tahta olarak işler.";
"T_TUTORIAL_01_SAWMILL_SUCCESS" = "Çok güzel Vali. Kereste fabrikası diğer gelişmiş inşaatlar için önemli bir önkoşuldur.";
"T_TUTORIAL_01_TOWNHOUSE_STARTED" = "Efendim, binaların hepsini düzgün şekilde çalıştırmak için daha fazla işçiye ihtiyacımız var. Köylüler kasabaya yalnızca onlar için daha fazla kasaba evi inşa edersek gelecek.";
"T_TUTORIAL_01_TOWNHOUSE_SUCCESS" = "Muhteşem Efendim. Kasabada yeterli işçi olması ekonomimiz için çok önemli.";
"T_TUTORIAL_01_WELCOME_01" = "Ben sıradan bir hizmetkâr değilim! Ben Lordun danışmanıyım ve günlük görevlerinde ona yardım ediyorum.";
"T_TUTORIAL_01_WELCOME_02" = "Neyse…";
"T_TUTORIAL_01_WORKERPAGE_HINT" = "Bir işçiyi serbest bırakmak için "uyku" sembolünü seçin.";
"T_TUTORIAL_02_ASSIGN_TITLE" = "Binada bir işçi görevlendirin.";
"T_TUTORIAL_02_BAKERY_01_STARTED" = "Bir fırın inşa ederseniz unu işleyerek ekmek haline getirmeye başlayabiliriz Lordum.";
"T_TUTORIAL_02_BAKERY_01_SUCCESS" = "Çok güzel Efendim. Artık ekmek üretim zincirimiz tamamlandı. Yiyecek bir süre boyunca sorun olmayacak. Ayrıca kasabayı kışa hazırlamak için zamanımız da var.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_01" = "Efendim, bir bina stoku dolu olduğunda o binadaki üretim malları yeniden depolayacak yer olana kadar durur.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_01_NEW" = "Bir binanın stoku dolu olduğunda malları depolayacak yer olana kadar üretim durur.";
"T_TUTORIAL_02_BUILDING_STOCK_FULL_02" = "Fazla sayıda binanın stoku fazla dolarsa üretim zincirlerinin tamamının kesintiye uğramasını engellemek için kale veya depolarda daha fazla taşıyıcı görevlendirilmelidir.";
"T_TUTORIAL_02_CONSTRUCTION_HINT" = "Bir inşaat sürecini hızlandırmak için onu inşa etmekte yardım edecek ikinci bir işçi istemelisiniz Efendim.";
"T_TUTORIAL_02_DEASSIGN_TITLE" = "İşçiyi binadaki görevinden alın.";
"T_TUTORIAL_02_ERASE_STARTED" = "Bölgeyi ağaçlar ve engel olan nesnelerden temizlemek için silme modunu kullanın.";
"T_TUTORIAL_02_ERASE_STARTED_OLD" = "Efendim, fırın çiftlik ve yel değirmeninin yakınına yerleştirilmelidir.";
"T_TUTORIAL_02_ERASE_TREES" = "Silme modu ile engel olan nesneleri silin.";
"T_TUTORIAL_02_ERASE_TREES_OBJECTIVE" = "Nesneyi silin";
"T_TUTORIAL_02_FREE_WORKERS_01" = "Lordum, daha fazla serbest işçimiz yok. Yeni bir kasaba evi inşa etmeyi düşünmelisiniz.";
"T_TUTORIAL_02_FREE_WORKERS_02" = "Her yeni kasaba eviyle birlikte köy için daha fazla işçi elde ederiz.";
"T_TUTORIAL_02_FREE_WORKERS_03" = "İnşaat için başka bir binadan bir işçiyi görevden alıp onu inşaat alanında görevlendirebilirsiniz.";
"T_TUTORIAL_02_FREE_WORKERS_04" = "Ayrıca bir binayı hızlıca tamamlamak için Prestij kullanmak da mümkündür. Bu işlem inşaat alanının içerik menüsünden hızlıca tamamlanabilir.";
"T_TUTORIAL_02_INTRO_STARTED" = "Günaydın Lordum. Tüm gün yatakta kalamazsınız.";
"T_TUTORIAL_02_INTRO_SUCCESS" = "Bir misafiriniz var. Bir soylu kaleye geldi. Sizi Kralın sarayından tanıdığını ve onu dinleyecek birisini istediğini söyledi.";
"T_TUTORIAL_02_MAINQUEST_OBJECTIVE_01" = "Yiyecek tedariki oluşturun.";
"T_TUTORIAL_02_MAINQUEST_STARTED" = "Lordum, kasabamızda yeterince yiyecek yok. Tek bir balıkçı kışın kasabanın tamamını besleyemez. Ekmek üretimine başlamayı öneriyorum.";
"T_TUTORIAL_02_MAINQUEST_SUCCESS" = "Lordum, iyi iş. Kasaba kışa hazır. Köylüler bunu duyduğuna sevinecek.\n\nBenimle gelin, Bayan Fitz-Givens sizin onurunuza bir ziyafet hazırladı Efendim.";
"T_TUTORIAL_02_MAINQUEST_TITLE" = "Gelecek kış için yeterince yiyecek üretin.";
"T_TUTORIAL_02_NOBLEMAN_01_STARTED" = "Günaydın Vali! Beni hatırladınız mı? Bir defasında Kralın sarayında tanışmıştık…";
"T_TUTORIAL_02_NOBLEMAN_01_SUCCESS" = "Bu kasabadaki köylüler saraydan atıldığınızı biliyor mu? Bence bunu öğrendiklerinde büyük hayal kırıklığına uğrarlar, değil mi?";
"T_TUTORIAL_02_NOBLEMAN_02_STARTED" = "Ben de öyle düşünmüştüm!";
"T_TUTORIAL_02_NOBLEMAN_02_SUCCESS" = "Pekâlâ… Saraydaki yaramazlığınız bizim küçük sırrımız olacak. Şimdilik. İyi günler Vali.";
"T_TUTORIAL_02_NOBLEMAN_03_SUCCESS" = "Lordum! Köylüler ne ile suçlandığınızı öğrenirse bizi kesinlikle zindana atarlar…";
"T_TUTORIAL_02_NOBLEMAN_04_STARTED" = "Biliyorum Lordum… Parayı almadık. Suçlamaların hepsi yalandı ama biz ve soylular dışında bunu kimse bilmiyor.";
"T_TUTORIAL_02_NOBLEMAN_04_SUCCESS" = "Bu adam bize şantaj yapabilirdi. Dikkatli adım atmalıyız…";
"T_TUTORIAL_02_QUESTS_HINT_STARTED" = "Mevcut tüm görevlerin genel bir görünümü menüdeki "görevler" sekmesinde mevcuttur. Orada tamamlanan görevler için olan ödüller de istenilebilir.";
"T_TUTORIAL_02_STOCK_HINT_STARTED" = "Kasabada depolanan kaynakların detaylı bir genel görünümü menünün "depo" alanında mevcuttur.";
"T_TUTORIAL_02_WELCOME_01_SUCCESS" = "Dinleme salonunda istekleri bulunan birkaç köylü daha sizi bekliyor Lordum. Sanırım sizinle kasabadaki yiyecek tedariki hakkında konuşmak istiyorlar.";
"T_TUTORIAL_02_WINDMILL_01_REWARD" = "Çiftçi yel değirmenini yeniden inşa ettiğiniz için çok mutlu ve size selamlarını gönderiyor. Sizin için biraz mal bıraktı.";
"T_TUTORIAL_02_WINDMILL_01_STARTED" = "Lordum, ben yerli bir çiftçiyim. Bu tepenin dibindeki çiftlik benim. Yel değirmeni geçen mevsimde yandığından beri buğdayım işlenmiyor. Yel değirmenim yeniden inşa edilebilirse minnettar kalırım.";
"T_TUTORIAL_02_WINDMILL_02_SUCCESS" = "Çok güzel Efendim. Şimdi buğdayı daha yenilebilir bir şey olarak işleyebiliriz. Un, fırında işlenerek ekmek haline getirilebilir.";
"T_TUTORIAL_02_WINDMILL_03_SUCCESS" = "Yel değirmeni buğdaydan un üretir. Bir yel değirmenine tedarik sağlayacak birkaç çiftçinin olması her zaman iyidir.";
"T_TUTORIAL_02_WORKERS_ASSIGN_STARTED" = "Lordum, birkaç gelişmiş binanın inşaatı için taşa ihtiyacımız var.\n\nMadene bir işçi görevlendirmeyi düşünmelisiniz. Böylece gerekli kaynakları kendimiz üretebiliriz.";
"T_TUTORIAL_03_CLIENT_MARKETBUILT_STARTED" = "Muhteşem Lordum. Ne kadar çok istek yerine getirirseniz Kasabalılarınız isyandan korkmaya gerek kalmadan o kadar yüksek vergiler ödeyecek.";
"T_TUTORIAL_03_CLOTHING_QUEST_DESC" = "Köylülerimiz giyecek giysiler istiyor Lordum.\n\nBir terzi inşaatı emri vermelisiniz. Sonrasında terzi kumaşlardan giysi üretebilir.";
"T_TUTORIAL_03_CLOTHING_QUEST_SUCCESS" = "Çok güzel Efendim. Artık köylülerin giysi isteklerini tatmin ettik. Giysiler köylüler tarafından pazardan elde edilir.";
"T_TUTORIAL_03_CLOTHING_QUEST_TITLE" = "Giysilerle yüksek memnuniyet elde edin.";
"T_TUTORIAL_03_INTRO_SUCCESS" = "Lordum, maliye neredeyse bomboş. Bir şey yapmalısınız yoksa sermaye yeterliliğimiz tehlikede olacak!\n\nPara olmadan görevlerimizi gerçekleştiremeyeceğiz ve şehrimiz büyümeye devam edemeyecek.";
"T_TUTORIAL_03_MAINQUEST_CONV_01" = "Köylülerimizin temel yiyecek ve sudan daha fazla ihtiyaçları bulunuyor Lordum. ";
"T_TUTORIAL_03_MAINQUEST_CONV_02" = "Giyecek yeni giysiler, güzel dekore edilmiş bir kasaba veya biraz mal satın almak için bir pazar gibi diğer istekleri de var.";
"T_TUTORIAL_03_MAINQUEST_DESC" = "Köylülerin bazı istekleri var. Yeni giysiler ve bir pazar bu listenin tepesinde.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_01" = "Genç kızın görevini yerine getirin.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_02" = "Tüccarın görevini yerine getirin.";
"T_TUTORIAL_03_MAINQUEST_OBJECTIVE_03" = "Soylu meselesini tamamlayın.";
"T_TUTORIAL_03_MAINQUEST_SUCCESS" = "Lordum, çok gayretli davrandınız. Kasaba istikrarla büyüyor ve kış için bile yeterli giysimiz var. Artık yetenekli ve bizi önemseyen bir Valimiz olduğunu görebiliyorum. \n\nSizin onurunuza bir ziyafet hazırladım Efendim. Beni takip edin.";
"T_TUTORIAL_03_MAINQUEST_TITLE" = "Köylülerin isteklerini yerine getirin.";
"T_TUTORIAL_03_MAKE_PROFIT" = "Ticaret yaparak kâr elde edin.";
"T_TUTORIAL_03_MARKETPLACE_CONST_TOOLTIP" = "Bir yer tutucu inşaat alanı seçin ve pazarı oraya inşa edin.";
"T_TUTORIAL_03_MARKET_TOOLTIP" = "Pazar ya da hatta kuyumuz gibi kamu binaları yalnızca sınırlı sayıda köylüye tedarik sağlayabilir. ";
"T_TUTORIAL_03_MARKET_TOOLTIP_02" = "İnşaat menüsü veya binanın içerik menüsünde bir kamu binasına ne kadar aile sığabileceğini görebilirsiniz.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT" = "Ticaret yapmak için oyun içi menüyü ve stok sekmesini ziyaret edin. Ticaret adı verilen bir alt kategori bulunur. Ticaret yapmak yalnızca tüccar köyde olduğunda mümkündür. Tüccarın arabası kalenin önünde görülebilir.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_HINT_SHORT" = "Ticaret yapmak için oyun içi menüyü ve stok için sekmeyi ziyaret edin. Ticaret adı verilen bir alt kategori bulunur.";
"T_TUTORIAL_03_MERCHANT_EXPLAIN_TRADE_TOOLTIP" = "Alternatif olarak tüccar köye geldiğinde pazar binasındaki içerik menüsünü ziyaret ederek de ticaret yapabilirsiniz.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_STARTED" = "Lordum, ben yerel tüccarım. Benden önceki hoş hanımefendi gibi benim de bir isteğim var.\n\nKasabamızın bir pazara ihtiyacı var. Size… Ve bana… Kaynaklar alıp satmamızda olanak sağlar.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_SUCCESS" = "Görünüşe göre köylülerimiz yeni birkaç giysi istiyor. Bir pazar yeni giysiler satın almanıza olanak sağlar. Onları kendiniz üretmenize gerek kalmaz Lordum.";
"T_TUTORIAL_03_MERCHANT_INQUIRY_TITLE" = "Kaynakları kabul edin.";
"T_TUTORIAL_03_MERCHANT_MARKET_STARTED" = "Lordum, izin istemeden ufak bir toprak satın alıp yeni pazarın temelini attım.\n\nBir işçinin inşaatı tamamlamasını emreder misiniz lütfen.";
"T_TUTORIAL_03_MERCHANT_MARKET_SUCCESS" = "Pazarda, depomuzdaki lüks malları dağıtabiliriz. Böyle yaparak zengin kasabalıların isteklerini giderebiliriz Lordum.";
"T_TUTORIAL_03_MERCHANT_OFFER_STARTED" = "Kasabanın maliyesinde paranın suyunu çektiğini herkes biliyor ancak kasabanın yeniden canlanmasını görmek istediğim için yeni pazarın inşaat masraflarını karşılayacağım.\n\nSevgili kasabamızın geleceği için bunu bir yatırım olarak düşünün.";
"T_TUTORIAL_03_MERCHANT_TIMER_TOOLTIP" = "Burada bir tüccarın sizinle ticaret yapmak için ne kadar süre köyde olacağını görebilirsiniz.";
"T_TUTORIAL_03_SHEPHERD_QUEST_DESC" = "Lordum, yün üretimi için çoban olarak çalışmak üzere çiftliğime başka bir işçi göndermelisiniz. Ben buğday hasadıyla meşgulüm, bu yüzden koyunlar konusunda bana yardım edecek birisine ihtiyacım var.";
"T_TUTORIAL_03_SHEPHERD_QUEST_SUCCESS" = "Muhteşem Efendim. Artık buğdayın yanında yün de hasat edebiliriz.";
"T_TUTORIAL_03_SHEPHERD_QUEST_TITLE" = "Çiftliğe bir çoban görevlendirin.";
"T_TUTORIAL_03_TAILOR_QUEST_DESC" = "Artık kasabada bir dokuma fabrikası olduğuna göre giysi üretiminde tek eksiğimiz bir terzi dükkânı Lordum.";
"T_TUTORIAL_03_TAILOR_QUEST_SUCCESS" = "Çok güzel Lordum. Artık giysi üretmeye başlayabiliriz. Köylüler çok sevinecek! Kendi giysi işletmemiz.";
"T_TUTORIAL_03_TRIBUTE_DESC" = "Vali! Son zamanlarda küçük önemsiz kasabanızı ve sefil varlığınızı çok düşünüyorum. Şu sonuca vardım: Lort unvanınızı kaybettiğinizden bahsetmemi istemiyorsanız benim değerli vaktimi boşa harcamayın.\n\nSessizliğimin bedeli düzenli bir miktar para ödemesi, ilki de şimdi yapılacak!";
"T_TUTORIAL_03_TRIBUTE_SUCCESS" = "Beni çok fazla beklettiniz! Süre doldu. Şimdi ödeme yapacak mısınız yoksa nöbetçileri mi çağırayım?";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_1" = "… Sonunda gitti.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_2" = "Lordum, gelecekte bu düşmanla nasıl uğraşacağımızı düşünmeliyiz. Geri dönüp bize şantaj yapmaya devam edecek.";
"T_TUTORIAL_03_TRIBUTE_SUCCESS_3" = "Belki de yeniden fidye verip kendimizi kurtarıp Kralın ulusal maliyesindeki hırsızlıkla bir alakamız olmadığını kanıtlamaya çalışmalıyız.";
"T_TUTORIAL_03_TRIBUTE_TITLE" = "Vergi ödemesi";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_DESC" = "Lordum, kasabada giysi üretmeye karar verirseniz yünden kumaş yapmak için bir dokuma fabrikasına ihtiyacımız olacak.";
"T_TUTORIAL_03_WEAVING_MILL_QUEST_SUCCESS" = "Muhteşem Efendim. Görüyorum ki dokuma fabrikasının inşaatı tamamlanmış. Artık kumaş üretimi başlayabilir.\n";
"T_TUTORIAL_03_WOMAN_INQUIRY_STARTED" = "İyi günler Lordum!\n\nKasaba halkından özel bir istek var. Bazı zengin köylüler kendilerini sıradan halktan ayırmak için daha iyi giysiler istiyor.\n\nPazarda giysiler bulundurma nezaketinde bulunur musunuz?   ";
"T_TUTORIAL_04_AVALANCHE_STARTED" = "İşte, iyi şans için şişeyi binaya fırlatın Efendim…";
"T_TUTORIAL_04_AVALANCHE_STARTED_2" = "Bu sesi duyuyor musunuz? Ne olabilir…";
"T_TUTORIAL_04_AVALANCHE_SUCCESS" = "Lordum, siz iyi misiniz?! Bu bir çığdı! En azından tavernamız hâlâ ayak…";
"T_TUTORIAL_04_COALBURNER_STARTED" = "Efendim, kaledeki normal odun ateşleri büyük binayı ısıtamıyor. Kömür ile evlerimizi ısıtmakla kalmayız ayrıca onu cevher ve demir külçeler olarak işleyebiliriz. \n\nBir kömürcü kulübesi inşa eder misiniz lütfen?";
"T_TUTORIAL_04_COALBURNER_STARTED_02" = "Demir ve altın külçelerin üretiminde genellikle kömür kullanılıyor. Tahtadan kömür üretebilmemiz için bir kömürcü kulübesi inşa eder misiniz lütfen?";
"T_TUTORIAL_04_COALBURNER_SUCCESS" = "İlave kömür üretimi odun tedarikimizin büyük kısmını kullanacağından odun üretimini artırmak akıllıca olur.";
"T_TUTORIAL_04_COUNTDOWN_STARTED" = "Lordum, bahar gelene kadar bu kış dayanmalıyız.";
"T_TUTORIAL_04_COUNTDOWN_SUCCESS" = "Şükürler olsun! Şu berbat kış nihayet sona erdi. Efendim, yakında yeniden mahsul ekebiliriz!";
"T_TUTORIAL_04_COUNTDOWN_TITLE" = "Bahara kadar dayanın.";
"T_TUTORIAL_04_EXTINGUISH_FAIL" = "Efendim, binayı alevler yuttu.";
"T_TUTORIAL_04_EXTINGUISH_STARTED" = "Yangın! Lordum! Bir yangın var! \n\nBir şey yapmalısınız! Neden kasabamızda bir yangın kulesi bulundurmuyoruz?";
"T_TUTORIAL_04_EXTINGUISH_SUCCESS" = "Efendim, size çok teşekkür ederim. Siz gerçek bir kurtarıcısınız.";
"T_TUTORIAL_04_FOOD_HINT_WINTER" = "Lort, yiyeceğimiz tükendi. Köylülerinizi özellikle kışın beslemek çok zor.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_01" = "Tavernayı yeniden inşa edin.";
"T_TUTORIAL_04_MAINQUEST_OBJECTIVE_02" = "Bahara kadar dayanın.";
"T_TUTORIAL_04_MAINQUEST_SUCCESS" = "Lordum. Kasabanın bu inanılmaz zorlu kışı geçirmesini sağladınız. Kasabalılar baharda sizin için ufak bir şenlik hazırlıyor.";
"T_TUTORIAL_04_MAINQUEST_TITLE" = "Kışı atlatın.";
"T_TUTORIAL_04_MINE_STARTED" = "Taş madenimiz bir çığ tarafından yıkıldı ancak kasabanın güneyinde bir demir cevheri yatağı var. Yeni bir maden için iyi bir konuma benziyor.";
"T_TUTORIAL_04_MINE_SUCCESS" = "Efendim, çok güzel. Demir cevherinin yanında maden ayrıca taş da çıkarabilir. İnşaattan sonra işçi anında cevher çıkarmaya başlayacak. Ancak ona taş çıkarması için de emir verebilirsiniz.\n";
"T_TUTORIAL_04_MINE_TITLE" = "Kasabanın güneyinde bir cevher yatağının üzerine bir maden inşa edin.";
"T_TUTORIAL_04_START_NEXT_STARTED" = "…Kahretsin… Yeni tavernamız… Bu planlandığı gibi gitmedi mi…!?!";
"T_TUTORIAL_04_START_NEXT_SUCCESS" = "Tavernayı yeniden inşa edebilmek için aletlere ihtiyacımız var. Ne yazık ki alet tedarikimiz eski tavernanın inşaatında tamamen kullanıldı.";
"T_TUTORIAL_04_TAVERN_STARTED" = "Efendim, nihayet tavernayı yeniden inşa edebiliriz. Bu köylülerin genel mutluluğunu büyük ölçüde artıracaktır.";
"T_TUTORIAL_04_TAVERN_SUCCESS" = "Muhteşem Efendim. Kasabamız nihayet yeniden bir tavernaya sahip ve köylüler işten sonra burada keyifli vakit geçirebilirler. \n\nElbette bir taverna içki veya meyve suyu gibi içeceklerle tedarik edildiğinde çok daha etkili olur. Ancak kış mevsimindeyiz, bu yüzden kendimiz içki veya meyve suyu üretemeyiz. Ama pazardan kaynak satın alabiliriz.";
"T_TUTORIAL_04_TAVERN_SUCCESS_02" = "Elbette bir taverna, içki veya meyve suyu gibi içeceklerle tedarik edildiğinde çok daha etkili olur. Ancak kış mevsimindeyiz, bu yüzden kendimiz içki veya meyve suyu üretemeyiz. Ama pazardan bunları satın alabiliriz.";
"T_TUTORIAL_04_TOOLMAKER_STARTED" = "Efendim, artık kömür üretebildiğimize göre bir alet yapım atölyesi işimize yarayabilir. Sonrasında kendi aletlerimizi üretebiliriz ve daha bağımsız olabiliriz.";
"T_TUTORIAL_04_TOOLMAKER_SUCCESS" = "Harika! Artık aletler için üretim zincirimiz tamamlandı.";
"T_TUTORIAL_04_TOWNHOUSE_STARTED" = "Efendim! Bir kasaba evi çığ tarafından yok edildi. Köylülerimiz kasabayı terk etmeden önce kısa süre içinde onu yeniden inşa etmeliyiz.";
"T_TUTORIAL_04_TOWNHOUSE_SUCCESS" = "Çok güzel Efendim. Artık kendimizi tavernanın yeniden inşaatına verebiliriz.";
"T_TUTORIAL_04_TOWNHOUSE_TITLE" = "Bir küçük veya büyük kasaba evi inşa edin.";
"T_TUTORIAL_04_TRADE_CLOTHES_STARTED" = "Lordum, ailem donuyor. Daha iyi giysilere ihtiyacımız var. Bir iyilik yapıp evime biraz giysi gönderir misiniz?";
"T_TUTORIAL_04_TRADE_CLOTHES_SUCCESS" = "Bizim için stokta yeterince giysiniz olduğunu görüyorum. İşte, böyle anlar için birkaç alet ve para topladık. Size teşekkür ediyorum.";
"T_TUTORIAL_04_WELCOME_SUCCESS" = "Efendim, ne güzel bir gün. Biraz soğuk ama oldukça güzel. Nihayet tavernanın inşaatı tamamlandı. Açılış törenine gidelim.";
"T_TUTORIAL_05_ADVISOR_TALKS_01" = "Lordum, birilerine o adamı takip ettirip casusluk yaptırmalıyız! Fazla şüpheli birisi.";
"T_TUTORIAL_05_ADVISOR_TALKS_02" = "Lordum, bana neden öyle garip bakıyorsunuz? ";
"T_TUTORIAL_05_ADVISOR_TALKS_03" = "…Ah lütfen… Yine ben olmayayım Lordum! En azından bu sefer bir tür kostüm alabilir miyim?";
"T_TUTORIAL_05_ADVISOR_TALKS_04" = "Bu da ne? Bir hayvan kostümü mü? Bunu giymeyeceğim… Bu iğrenç…";
"T_TUTORIAL_05_ARMORY_CONV_01" = "Lordum! Bir cephanelik olmadan herhangi bir silah veya zırh üretemeyiz. Olabildiğince kısa süre içinde bir cephanelik inşaatının emrini vermelisiniz.";
"T_TUTORIAL_05_BANDITS_SIGHTED" = "Lordum, keşif kolları bölgede haydutların dolandığını rapor ediyor. Dikkatli olmalıyız, kasabaya saldırabilirler…";
"T_TUTORIAL_05_BANDIT_ATTACK_01" = "Aptal casusunuzu o çirkin kostümün içinde fark etmeyeceğimi mi düşündünüz gerçekten Vali?";
"T_TUTORIAL_05_BANDIT_ATTACK_02" = "Bundan sonra arada sırada kasabanızı ziyaret edeceğim. Bakalım bana ayıracak biraz malınız var mı…";
"T_TUTORIAL_05_CARPENTER_SUCCESS_CONV_01" = "Çok güzel Efendim. Artık marangoz yeterli kaynaklar mevcut olduğu sürece tüm hasarlı binalarla ilgilenecek.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_DESC" = "Kral, başkent maliyesindeki hırsızlığı araştırması için kasabanıza özel bir temsilci gönderdi. Artık baş şüpheli sizsiniz.";
"T_TUTORIAL_05_COUNTDOWN_KNIGHT_ARRIVES_TITLE" = "Kralın temsilcileri kısa süre içinde gelecek.";
"T_TUTORIAL_05_GEOLOGIST_ASSIGN" = "Madende bir jeolog görevlendirmek için büyüteci seçin.";
"T_TUTORIAL_05_HERB_GARDEN_CONV" = "Lordum, kostüm için birkaç ot kamuflajı yapabilirim ama bunu yapmak için çiftliğimin yakınında bir bitki bahçesine ihtiyacım var.";
"T_TUTORIAL_05_HERB_GARDEN_DESC" = "Bitkileri hasat etmek için bir bitki bahçesi gereklidir. Bitkiler bir çiftçi tarafından hasat edilebilir. Bitki bahçesini bir çiftliğin yanına inşa etmek önerilir.";
"T_TUTORIAL_05_HERB_GARDEN_TITLE" = "Bir bitki bahçesi inşa edin.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_DESC" = "Danışman için işe yarar bir kostüm yapmak için biraz deri ve onu kamufle edecek otlar bulmalısınız. İlk katman olarak birkaç giysi de iyi olabilir.";
"T_TUTORIAL_05_INVESTIGATION_DISGUISE_TITLE" = "Kostümü yapın.";
"T_TUTORIAL_05_KNIGHT_02_CONV_01" = "Vali! Haydutların yeniden saldırması durumunda kasabayı ve çevredeki ormanları daha iyi görebilmem gerekiyor. Acele edin, bu bir emirdir!";
"T_TUTORIAL_05_KNIGHT_02_CONV_02" = "Muhteşem Vali. Artık kasabaya ve çevresine yüksekten bakabilirim. ";
"T_TUTORIAL_05_KNIGHT_02_CONV_03" = "Köyü etkili şekilde koruyabilmek için nöbetçi kulelerinizde her zaman adam bulundurmalı ve kışlalar ile tedarikli olmasını sağlamalısınız.";
"T_TUTORIAL_05_KNIGHT_02_CONV_04" = "Lordum! Kasabanın yakınında birkaç şüpheli kişi görüldü. Haydutlar olabilir!";
"T_TUTORIAL_05_KNIGHT_02_DESC" = "Şövalye, civar bölgeyi güzelce görebilmek istiyor. Bir nöbetçi kulesi inşa edilmeli. Bu, en azından kasabayı koruyan birkaç nöbetçimizin olmasını sağlar.";
"T_TUTORIAL_05_KNIGHT_03_CONV_01" = "Efendim, saldırıya uğradık!";
"T_TUTORIAL_05_KNIGHT_03_CONV_02" = "Lordum, haydutlar binalarımızı soyuyor! Savunmasızız…";
"T_TUTORIAL_05_KNIGHT_03_DESC" = "Kasaba haydutların saldırısına uğruyor. Saldırganlarla savaşmanız gerekiyor. Kazanma şansınızı artırmak için daha fazla nöbetçi kulesi inşa edin ve daha fazla asker görevlendirin. ";
"T_TUTORIAL_05_KNIGHT_03_TITLE" = "Saldırganlarla savaşın.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_01" = "Günaydın Vali. Sizi tutuklamak için Kral tarafından gönderildim. Kral majestelerinden para çalmakla suçlanıyorsunuz. Kendinizi nasıl savunacaksınız?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_02" = "Yemin ederim Valinin bu işle bir ilgisi yok. Biz suçlandık. Başka birisi olmalı.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_03" = "Bu saçmalığa inanacağımı düşünüyor musunuz gerçekten? Saygıdeğer bir soylu ve Kralın eltisinin erkek kardeşi sizi ve danışmanınızı suçu işlerken görmüş.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_04" = "Suçlu olmadığımızı kanıtlayacağız! Değil mi Efendim?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_CONV_05" = "Sessizlik! Bunları dinlemeyeceğim. Şimdilik köyünüze kamp kuracağım. Kasabada komut merkezi olarak kullanabileceğim bir kışlanız var mı?";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_01" = "Muhteşem Vali. Artık adamlarımın kasabanızdaki operasyonlar için bir üssü var ve kasaba nöbetinize eğitim verebilirsiniz.";
"T_TUTORIAL_05_KNIGHT_ARRIVES_SUCCESS_02" = "Artık elimizdeki sorunu çözmeye odaklanabiliriz. Kralın maliyesindeki eksik altın ve bu köyün savunması.";
"T_TUTORIAL_05_MAINQUEST_DESC" = "Soylu geri geldi, para ve porselen eşya istiyorlar. İşler kontrolden çıkmadan önce sorunu çözmelisiniz!";
"T_TUTORIAL_05_MAINQUEST_OBJECTIVE_01" = "Soylunun ne yaptığını öğrenin.";
"T_TUTORIAL_05_MAINQUEST_STARTED" = "Efendim, bu yeterince uzun süredir devam ediyor. Bu soyluyla ilgilenmezsek olay hızlıca büyüyecek!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_DESC" = "Şövalye takviye çağrısında bulundu ama kasaba nöbeti, Kralın birlikleri gelene kadar saldırganları uzakta tutmak zorunda.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_STARTED" = "Vali, takviye almak için Krala haber ilettim. Ancak bu biraz zaman alacak. O zamana kadar ne pahasına olursa olsun köyü savunmalıyız.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_01" = "Başardık Vali! Haydut saldırıları sona eriyor. Geri çekiliyorlar…";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_02" = "Efendim, kasaba nöbeti soyluyu kalenin yakınında saklanırken buldu. Sanırım size bir şey söylemek istiyor.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_03" = "Vali, saldırganları bozguna uğrattığınız için teşekkürlerim sizindir. Gerçekten de tehlikede değildik, değil mi?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_04" = "Neden haydutlarla buluşurken görüldüğünüzü bana açıklayın. HEMEN!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_05" = "Pekâlâ… Birkaç ay önce bir hata yaptım.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_06" = "Başkentte, Haydut Lordu ile ilk tanıştığım kumarhanedeydim. Bir zar oyununda ona karşı büyük miktarda para kaybedene kadar onun kim olduğunu bilmiyordum.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_07" = "Uzun lafın kısası… Sonunda büyük borca girdim ve bana maliyeden Kralın altınlarını çalmam için şantaj yapmaya başladı.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_08" = "Sonra da Valiyi altını çalmak la mı suçladınız?";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_09" = "Kolaydı. Hazine Vekili eski bir arkadaşım ve Valinin buradaki çöplükte görevlendirilmesini sağladım.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_10" = "Küçük köyümüz hakkında böyle konuşmaya kalkma. Demek ki asil Valiye suç atan kişi sendin. Yazıklar olsun!";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_11" = "Her geçen gün haydutlar daha da fazlasını istedi. Sonunda silahlar ve zırhlar talep ettiler… Ben de sizin değerli Valinizin yardımıyla teslim ettim.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_SUCCESS_12" = "Bu deliliği durdurmalıyız! O haydutların çalıştığı kampı bulmak en büyük önceliğimiz olmalı.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE" = "Köyü savunun.";
"T_TUTORIAL_05_MAINQUEST_SURVIVE_TITLE_02" = "Dayanın";
"T_TUTORIAL_05_MAINQUEST_TITLE" = "Soylu ile olan olayla ilgilenin.";
"T_TUTORIAL_05_MILITARY_EXPLANATIONS" = "Bu saldırıları durdurmamızın tek yolu bir kasaba nöbeti inşa etmek!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01" = "Vali, reddedemeyeceğiniz bir teklifim var! Bana silah ve zırhlar yollayın! Hemen!";
"T_TUTORIAL_05_NEW_DEAL_CONV_01B" = "Siz benim sırtımı kaşıyın ben de sizinkini, değil mi? Kralın askerine sizin hakkınızda iyi şeyler söyleyeceğim. Ne düşünüyorsunuz?";
"T_TUTORIAL_05_NEW_DEAL_CONV_02" = "Harika! Şimdi malları bana verin. Onları yakında teslim etmem gerekiyor!";
"T_TUTORIAL_05_NEW_DEAL_DESC" = "Soylu yeni bir teklifte bulundu. Ona silah ve zırh teslimatı yaparsanız Kralın temsilcisine sizin hakkınızda iyi şeyler söylermiş.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_01" = "İyi günler Vali. Ne harika bir gün değil mi?! Sessiz kalmam için başka bir ödeme zamanının geldiğini hatırlatmak istedim.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_02" = "Siz acele etmelisiniz! Bir grup asker yolda. Kralın maliyesinden eksik altını arıyorlar Vali! Kendi iyiliğiniz için sizi burada bulmamalarını umuyorum.";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_03" = "Şimdi bunu teslim edin. Bu parayı akıllıca harcayacağız Vali! Acele edin, vaktim yok. Önemli bir toplantım var…";
"T_TUTORIAL_05_NOBLEMAN_MONEY_CONV_04" = "Bana ödeme yapmama cüretini nasıl gösterirsiniz Vali! Bunun sonuçları olacak, sizi temin ederim… Şimdi önümden çekilin, katılmam gereken önemli bir toplantı var!";
"T_TUTORIAL_05_NOBLEMAN_MONEY_DESC" = "Soylu yeniden para istiyor. Bizi, Kralın çalınan altını arayan dedektifleriyle tehdit ediyor. ";
"T_TUTORIAL_05_NOBLEMAN_MONEY_TITLE" = "Soyluya ödeme yapın.";
"T_TUTORIAL_05_REPAIR_TOWN_CONV_01" = "Efendim, artık marangoz yeterli kaynaklara sahip olduğu sürece hasarlı binaları onaracak.";
"T_TUTORIAL_05_REPAIR_TOWN_DESC" = "Lordum, en azından kasabadaki en önemli binaların olabildiğince hızlı şekilde onarılması gerekiyor.";
"T_TUTORIAL_05_REPAIR_TOWN_SUCCESS" = "Çok güzel Efendim. Marangoz tüm önemli binaların onarıldığını bildirdi. ";
"T_TUTORIAL_05_REPAIR_TOWN_TITLE" = "Kasabadaki en önemli binaları onarın.";
"T_TUTORIAL_05_START_2_CONV_01" = "Böylece gelecek görevlere odaklanabiliriz.";
"T_TUTORIAL_05_START_2_CONV_02" = "Lordum, kış sona erdi ancak kasabadaki binalar zorlu şartlar yüzünden hasar aldı.";
"T_TUTORIAL_05_START_2_DESC" = "Efendim, binaların birçoğu sert geçen kıştan dolayı hasar gördü. Bir marangoz zamanla çürüyen binaları onarabilir. ";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR" = "Peki Lordum. "Kostümüm" burada ve soyluyu toplantısına gidene kadar takip edeceğim. Bu biraz zaman alacak. Lütfen sabırlı olun.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_DESC" = "Kılık değiştiren danışman, soylunun arkasında dolanırken geri dönüp bulduklarını rapor edene kadar beklemeniz gerekiyor.";
"T_TUTORIAL_05_START_INVESTIGATION_ADVISOR_TITLE" = "Danışman, soylunun arkasında dolanıp casusluk yapıyor.";
"T_TUTORIAL_05_START_INVESTIGATION_FAILED" = "…Nihayet, kasabaya döndüm. Beni gördüler ve zor kaçabildim. Haydutlarmış Lordum. Soylu haydutlarla iş yapıyor!";
"T_TUTORIAL_05_STOCKFULL_01" = "Efendim, depolar dolu. Depolarda yer açmak için bazı malları satmak hatta yok etmek öneriliyor.";
"T_TUTORIAL_05_STOCKFULL_02" = "Çok güzel Vali. Artık yeniden biraz yerimiz var. Üretim akışını devam ettirmek için boş depolama kapasitesine sahip olmak önemli.";
"T_TUTORIAL_05_STOCKFULL_TITLE" = "Depolarda yer açın.";
"T_TUTORIAL_05_STOCKFULL_TOOLTIP" = "Depolarda daha fazla yer yok!";
"T_TUTORIAL_05_TANNERY_CONV_02" = "Çok zor Efendim. Tabakhane sadece gerekli derinin tamamını bir avcıdan hayvan postları tedarik edildiğinde üretecek.";
"T_TUTORIAL_05_TANNERY_DESC" = "Zırhı üretmek için bir tabakhaneden elde edeceğimiz deriye ihtiyacımız var Lordum.";
"T_TUTORIAL_05_TANNERY_TITLE" = "Bir tabakhane inşa edin ve deri üretin.";
"T_TUTORIAL_05_TOWN_UNDER_ATTACK" = "Lordum, haydutlar kasabaya saldırdı! O alçaklara karşı önlem almalıyız! Bir kasaba nöbetine ihtiyacımız var.";
"T_TUTORIAL_05_TRIBUTE_TIMER_DESC" = "Süreniz dolmadan haraç ödeyin.";
"T_TUTORIAL_05_UPGRADE_HINT_01" = "Bir kamu binasının kapasitesini onu yükselterek artırılabilir.";
"T_TUTORIAL_05_UPGRADE_HINT_02" = "Bina yükseltmeleri çok güçlüdür. Örneğin bir binada daha fazla işçinin görevlendirilmesine olanak sağlarlar.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_01" = "Lordum, haydut kampını bulmak için kuzey ormanlarını arayabiliriz.";
"T_TUTORIAL_06_EXPEDITION_01_CONV_02" = "Yalnızca kasaba nöbetine gerekli kaynakları gönderin, sonrasında hemen yola çıkacağız.";
"T_TUTORIAL_06_EXPEDITION_01_STARTED" = "Lordum, geri dönmemiz biraz zaman alacak. Bize şans dileyin!";
"T_TUTORIAL_06_EXPEDITION_02_CONV_01" = "Lordum, güney ormanlarına bir keşif kolu ekibi gönderelim mi? Haydut kampı güneyde bir yerde olabilir mi?";
"T_TUTORIAL_06_EXPEDITION_03_CONV_01" = "Haydut kampı batı ormanlarında bir yerde olabilir mi? Kasaba nöbeti bir araştırma ekibi toplasın mı?";
"T_TUTORIAL_06_EXPEDITION_04_CONV_01" = "Lordum, haydut kampı için güney ormanlarını araştırmadık. Emri verin ve kasaba nöbeti hazırlıklara hemen başlasın.";
"T_TUTORIAL_06_EXPEDITION_DESC_01" = "Kasaba nöbeti ormanda haydut kampını aramaya başlayabilir. Ancak bunu yapmak için bazı tedarik ve ekipmanlara ihtiyaçları var.";
"T_TUTORIAL_06_EXPEDITION_RDYTOSTRT" = "Lordum, sadece emri verin, sonrasında yola çıkacağız.";
