"T_GAME_TUTORIAL_QUEST_SUCESS_1" = "Çoğu görev sizi Prestij ile ödüllendirecektir. Görev günlüğünü açın ve ödüllerinizi toplayın.";
"T_GAME_TUTORIAL_QUEST_SUCESS_10_MOUSE" = "Eğitim sona erdiğinde bina menüsünden bir binayı yıkabilirsiniz. Bir binayı yıkmak onu inşa ederken kullanılan kaynakların bazılarını geri getirir.\n\nDekorasyonlar, ormanlar ve yollar "kürek" aletiyle silinebilir. "Kürek modu"nda fareyi birden fazla nesnenin üzerine sürükleyebilir veya kaldırmak istediğiniz nesnelerin her birini ayrı ayrı seçebilirsiniz.";
"T_GAME_TUTORIAL_QUEST_SUCESS_10_TOUCH" = "Eğitim sona erdiğinde bina menüsünden bir binayı yıkabilirsiniz. Bir binayı yıkmak onu inşa ederken kullanılan kaynakların bazılarını geri getirir.\n\nDekorasyonlar, ormanlar ve yollar "kürek" modunu etkinleştirip kaldırmak istediğiniz nesneleri kaydırarak kaldırılabilir.";
"T_GAME_TUTORIAL_QUEST_SUCESS_11" = "Evlerin durumu Kasabalılarınızın mutluluğunu ve üretkenliğini etkiler.\nMutsuz köylüler daha az üretken olur ve bazen grev yapıp çalışmayı bile reddedebilirler!";
"T_GAME_TUTORIAL_QUEST_SUCESS_12" = "Harika! Townsmen dünyası hakkında çok şey öğrendiniz. Eğitim böylece sona eriyor.\n\nArtık senaryolardan birisine veya kum havuzu oyununa başlayabilirsiniz'";
"T_GAME_TUTORIAL_QUEST_SUCESS_13" = "Ne kadar çok Kasabalınız olursa mutluluğu korumak için o kadar fazla dekorasyon nesnesine ihtiyacınız olur!";
"T_GAME_TUTORIAL_QUEST_SUCESS_2" = "Görevlendirilmemiş Kasabalılarınız olduğu sürece inşaat alanlarınıza anında adam sağlanacak. Şimdi görev günlüğüne gidip ödülünüzü alın!";
"T_GAME_TUTORIAL_QUEST_SUCESS_3" = "Townsmen'de erkek Kasabalılar taşıyıcı, kaynak üreticisi ve zanaatkâr olarak çalışırken Kasabalı hanımlar evlerin yiyecek, su ve lüks eşyalarla stoklanmasını sağlıyor.";
"T_GAME_TUTORIAL_QUEST_SUCESS_5" = "Kasabalılarınızın ihtiyaç ve isteklerini gidermekte ne kadar iyi olursanız Kasabalılarınız o kadar mutlu ve üretken olacaktır! Daha mutlu Kasabalılar ayrıca çok fazla karşı çıkmaya yol açmadan daha yüksek vergilendirilebilir.";
"T_GAME_TUTORIAL_QUEST_SUCESS_6" = "Kereste fabrikası odun kütüklerini tahtaya dönüştüren üretim zincirinin bir parçasıdır. Daha sonra daha karışık üretim zincirleriyle karşılaşacaksınız.";
"T_GAME_TUTORIAL_QUEST_SUCESS_8" = "Tüccar kasabaya geldiğinde pazarda malların ticaretini yapabilirsiniz. Ne var ki stoku sınırlı olacak.\nKasabalı hanımlar da mevcut olduğunda mücevher ve giysi almak için pazara gider.";
"T_GAME_TUTORIAL_QUEST_SUCESS_9" = "Paranız az ve malınız çoksa hızlıca Taler kazanmak için mallardan bazılarını satabilirsiniz.";
"T_GAME_TUTORIAL_QUEST_SUCESS_CARRIER" = "Daha fazla depo inşa ederek daha fazla Kasabalıyı taşıyıcı olarak görevlendirebilirsiniz.";
"T_GAME_TUTORIAL_QUEST_SUCESS_CHURCH" = "Kamu binalarının her bir türü Kasabalılarınızın farklı bir isteğine hitap eder. Kilise, taverna veya atlı mızrak alanları gibi birkaç kamu binasını bulunur.";
"T_GAME_TUTORIAL_QUEST_SUCESS_FARM" = "Çiftlikte buğdayın yanında yün de üretebilirsiniz. Bunun için çiftlik binasının yanına bir koyun otlağı inşa etmelisiniz ve yün üretimi için yeniden bir çiftlik işçisi görevlendirmelisiniz.";
