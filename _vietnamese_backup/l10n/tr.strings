"T_GAME_TUTORIAL_FIRETOWER" = "Kasabanız büyüdükçe yangın çıkma riski de artar. Hazırlıklı olmak için bir yangın gözetleme kulesi inşa etmelisiniz.";
"T_GAME_TUTORIAL_FIRETOWER2" = "Yangın gözetleme kulesinin menzili sınırlıdır. İtfaiyeciler yalnızca bu menzil içerisindeki yangınları söndürebilir.\n\nOnu olabildiğince fazla binayı koruyabileceği bir konuma yerleştirin.";
"T_GAME_TUTORIAL_HAPPINESS" = "Kasabalılarınızın ihtiyaçları yiyecek ve su.\nBunun yanında Kasabalılarınızın istekleri bulunur.\nMutluluk değeri tüm ihtiyaç ve isteklerin ortalamasıdır. Gözünüz her zaman Kasabalılarınızın mutluluğunda olmalı!";
"T_GAME_TUTORIAL_NOTIFICATION_1" = "Eğitime hoş geldiniz. Şimdi Townsmen'in temellerini öğreneceksiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_2_MOUSE" = "Sol fare düğmesiyle haritayı sürükleyerek ekranı hareket ettirin. Fare topunu kullanarak yakınlaşın ve uzaklaşın.";
"T_GAME_TUTORIAL_NOTIFICATION_2_NOMULTITOUCH" = "Ekranda kaydırarak kamerayı hareket ettirebilirsiniz. + ve - düğmelerini kullanarak yakınlaşabilir ve uzaklaşabilirsiniz. ";
"T_GAME_TUTORIAL_NOTIFICATION_2_TOUCH" = "Ekranda kaydırarak kamerayı hareket ettirin. İki parmağınızı kullanarak yakınlaşıp uzaklaşın.";
"T_GAME_TUTORIAL_NOTIFICATION_3" = "Kale, en önemli binanızdır. İlk deponuz olarak işlev görür ve buradan taşıyıcı olmaları için Kasabalılar görevlendirebilirsiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_4" = "Ekranın sağ üst kısmında ne kadar Prestij ve Taler'iniz olduğunu, görevlendirilmemiş Kasabalı sayısını ve kasabanızın büyüklüğünü görebilirsiniz.\n\nÖnemli mesajlar sol üstte gösterilir.";
"T_GAME_TUTORIAL_NOTIFICATION_5" = "Prestij size çeşitli avantajlar sağlayan özel bir para birimidir. Taç simgesi için gözünüz her zaman açık olsun!";
"T_GAME_TUTORIAL_NOTIFICATION_6" = "Her bir kasaba evi mevcut işçi sayısını artırır.";
"T_GAME_TUTORIAL_NOTIFICATION_7" = "Şimdi Kasabalılarınızın ihtiyaçları ve istekleriyle ilgilenmelisiniz. Tüm önemli bilgiler istatistikler menüsünde bulunabilir.";
"T_GAME_TUTORIAL_NOTIFICATION_8" = "Binaların üzerinde gösterilen simgeler ve uyarı mesajları size depolama alanı azlığı ve diğer sorunlar hakkında bilgi verecektir.";
"T_GAME_TUTORIAL_NOTIFICATION_FF" = "Oyunda süreyi hızlandırmak için ileri sarma özelliğini kullanın. Onu doldurmak için Prestij harcayabilirsiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_SCREENSHOT_MOUSE" = "Kasabanız çok güzel görünüyor!\n\nKamera simgesine dokunarak bir ekran görüntüsü kaydedebilirsiniz. Ekran görüntüsü alırken simgeler otomatik olarak devre dışı bırakılacak.";
"T_GAME_TUTORIAL_NOTIFICATION_SCREENSHOT_TOUCH" = "Kasabanız çok güzel görünüyor!\n\nKamera simgesine dokunarak cihazınıza bir ekran görüntüsü kaydedebilirsiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_SHOP" = "Kasaba dükkânı, ilave Prestij elde etme veya ücretsiz versiyonu oynuyorsanız banner reklamları kaldırmak için harika teklifler sunar! Her zaman göz atabilirsiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_SHOP_GAMEROOM" = "Townshop'ta ek Prestij elde etmek, sınırsız hızlı ilerleme kilidini açmak veya sınırsız iki katı DP satın almak için harika teklifler var. İstediğiniz zaman bir göz atabilirsiniz.";
"T_GAME_TUTORIAL_NOTIFICATION_STOCK" = "Kaynaklar ve mallar, üretim için kullanılana veya depoya taşınana kadar geçici olarak üretim binalarında depolanır.";
"T_GAME_TUTORIAL_QUEST_4_WELL" = "Bir kuyu inşa edin.";
"T_GAME_TUTORIAL_QUEST_DESC_1" = "İlk görevinizi aldınız! Kasabanızın oduna ihtiyacı var! İnşa etme menüsüne girin ve ormancı kulübesini arayın!";
"T_GAME_TUTORIAL_QUEST_DESC_10" = "Yollar malların ve kaynakların taşınmasını hızlandırır ancak inşaatlarını akıllıca planlamalısınız.\n\nŞimdi kasabanıza biraz yol inşa edin.";
"T_GAME_TUTORIAL_QUEST_DESC_11_MOUSE" = "Düzenli bakımları yapılmazsa binaları durumu kötüleşir ve hatta yanabilirler. Durumu kötüleşen binaları kirli görüntülerinden tespit edebilirsiniz.\n\nBina menüsüne girmek için bir binaya dokunun ve binayı onarmak için onarma düğmesini kullanın.";
"T_GAME_TUTORIAL_QUEST_DESC_11_TOUCH" = "Düzenli bakımları yapılmazsa binaların durumu kötüleşir ve hatta yanabilirler. Durumu kötüleşen binaları kirli görüntülerinden tespit edebilirsiniz.\n\nBina menüsüne girmek için bir binaya dokunun ve binayı onarmak için onarma simgesini kullanın.";
"T_GAME_TUTORIAL_QUEST_DESC_12" = "Kasabalılarınızın ihtiyaçları ve isteklerini takip edebilmek için gözünüzü istatistik menüsünde tutmayı unutmayın!";
"T_GAME_TUTORIAL_QUEST_DESC_13" = "Pazar gibi kamu binalarının yanı sıra Kasabalılarınızın mutluluğu kasaba dekorasyonlarıyla da artar!";
"T_GAME_TUTORIAL_QUEST_DESC_2" = "Boşa çıkan işçinizle başka bir kasaba evi daha inşa edebilirsiniz.";
"T_GAME_TUTORIAL_QUEST_DESC_3" = "Görevlendirilmiş işçileri olmayan binalar faaliyet göstermez. Üretime devam etmek için daha fazla işçi alın.\n\nOrmancı kulübesinde yeni bir işçi görevlendirmelisiniz.";
"T_GAME_TUTORIAL_QUEST_DESC_4" = "Balıkçı kulübesi köyünüze bir yiyecek kaynağı olarak balık tedarik eder. Köylülerinizin yiyecek ihtiyacını gidermek için bir balıkçı kulübesi inşa edin.";
"T_GAME_TUTORIAL_QUEST_DESC_4_WELL" = "Kuyu, köyünüze su tedarik eder. Kasabalılarınızın su ihtiyacınız gidermek için bir kuyu inşa edin.";
"T_GAME_TUTORIAL_QUEST_DESC_5_MOUSE" = "Kasabalılarınız düzenli olarak vergi öder. Toplanan Taler miktarı mutluluk ve vergi oranına göre değişir.\n\nVergileri toplamak için kasaba evlerinin üzerindeki paralara tıklayın!";
"T_GAME_TUTORIAL_QUEST_DESC_5_TOUCH" = "Kasabalılarınız düzenli olarak vergi öder. Toplanan Taler miktarı mutluluk ve vergi oranına göre değişir.\n\nVergileri toplamak için kasaba evlerinin üzerindeki paralara dokunun!";
"T_GAME_TUTORIAL_QUEST_DESC_6_MOUSE" = "Bazı binalar mal üretmek için kaynaklar kullanır.\nBir kereste fabrikası inşa etmeyi hızlandırmak için "anında inşa" özelliğini kullanın.\n\nAyrıca sitedeki içerik menüsündeki düğmeye tıklayarak bir inşaat alanını hızla tamamlamak için prestij kullanabilirsiniz.";
"T_GAME_TUTORIAL_QUEST_DESC_6_TOUCH" = "Bazı binalar mal üretmek için kaynaklar kullanır.\nBir kereste fabrikası inşa etmeyi hızlandırmak için "anında inşa" özelliğini kullanın.\n\nAyrıca sitedeki içerik menüsündeki uygun simgeye dokunarak bir inşaat alanını hızla tamamlamak için prestij kullanabilirsiniz.";
"T_GAME_TUTORIAL_QUEST_DESC_7" = "İş gücünüzü artırmak için fazladan iki kasaba evi inşa etmelisiniz.";
"T_GAME_TUTORIAL_QUEST_DESC_8" = "Kasabalılarınız onlar için bir pazar inşa ettiğinizde daha mutlu olacak.";
"T_GAME_TUTORIAL_QUEST_DESC_9" = "Pazarda biraz mal satmalısınız.\nGözünüz tüccar simgesinde olsun. Tüccar kasabaya geldiğinde size bilgi verir.";
"T_GAME_TUTORIAL_QUEST_DESC_CARRIER_MOUSE" = "Kaleye başka bir taşıyıcı görevlendirmelisiniz. Ne kadar fazla taşıyıcınız olursa binalar arasında mallar o kadar hızlı taşınır.\nKaleye tıklayın ve boş yuvalardan birisine bir işçi görevlendirin!";
"T_GAME_TUTORIAL_QUEST_DESC_CARRIER_TOUCH" = "Kaleye başka bir taşıyıcı görevlendirmelisiniz. Ne kadar fazla taşıyıcınız olursa binalar arasında mallar o kadar hızlı taşınır.\nKaleye dokunun ve boş yuvalardan birisine bir işçi görevlendirin!";
"T_GAME_TUTORIAL_QUEST_DESC_CHURCH" = "Şimdi dikkatinizi Kasabalılarınızın isteklerine çevirme zamanı. Dini hayatlarındaki isteklerini gidermek için bir kilise inşa etmeye ne dersiniz?";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_MOUSE" = "Nüfusunuzu artırmak için şimdi başka bir kasaba evi inşa etmelisiniz. Ancak bunu yapmak için işçi sayınız az olduğundan, ormancı kulübesinden bir işçiyi görevden almalısınız.\n\nBina menüsünü açmak için ormancı kulübesine dokunun ve ardından işçi simgesine dokunun.";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_OLD" = "Nüfusunuzu artırmak için şimdi başka bir kasaba evi inşa etmelisiniz. Ancak bunu yapmak için işçi sayınız az, ormancı kulübesinden bir işçiyi görevden almalısınız.\n\nBina menüsünü açmak için ormancı kulübesine dokunun ve ardından işçi simgesine dokunun.";
"T_GAME_TUTORIAL_QUEST_DESC_DEASSIGN_2_TOUCH" = "Nüfusunuzu artırmak için şimdi başka bir kasaba evi inşa etmelisiniz. Ancak bunu yapmak için işçi sayınız az, ormancı kulübesinden bir işçiyi görevden almalısınız.\n\nBina menüsünü açmak için ormancı kulübesine dokunun ve ardından işçi simgesine dokunun.";
"T_GAME_TUTORIAL_QUEST_DESC_FARM" = "Yiyecek üretiminin daha büyük bir nüfusu desteklemeye hazır olduğundan emin olmak için bir çiftlik inşa etmelisiniz. Bir çiftlik, köyünüze buğday sağlar ve bu da ekmek yapmak için kullanılmak üzere un olarak işlenir.";
"T_GAME_TUTORIAL_QUEST_DESC_MINE" = "Odunun yanı sıra taş da en önemli kaynaklardandır. Kayalık bir yamaçta bir maden inşa edip taş çıkarmaya başlamalısınız.";
