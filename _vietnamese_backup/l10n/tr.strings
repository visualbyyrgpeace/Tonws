"T_GAME_QUEST_DISASTERS_BANDIT_RAID_04" = "Lort Vali, haydutlar sonraki saldırılarına başladı!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_05" = "Efendim, başka bir haydut grubu kasabaya doğru geliyor!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_06" = "Efendim, büyük bir haydut grubu geliyor. Görünüşe göre son haydut grubu. Direnmeliyiz!";
"T_GAME_QUEST_DISASTERS_BANDIT_RAID_07" = "Lordum, şehir nöbetçisi saldırının sona erdiğini bildirdi. Kalan haydutlar şehirden sürüldü ve geri çekiliyorlar.";
