"T_GAME_QUEST_SCEN15_17_FAIL" = "Lordum, bu çok kötü. Moral oldukça düşük. Sinirli kasabalılardan bazılarının düşüncesizce bir şey yapmasından korkuyorum.";
"T_GAME_QUEST_SCEN15_17_START" = "Lordum, tüm topraklar savaşın sıkıntısını çekiyor!\nKasabalıların morali azalırsa bir isyan patlak verebilir.";
"T_GAME_QUEST_SCEN15_17_SUCCESS" = "Çok iyi Lordum. Kasabanızdaki kargaşayı önlemeyi başardınız!";
"T_GAME_QUEST_SCEN15_17_TITLE" = "Memnuniyetin çok fazla düşmesine izin vermeyin.";
"T_GAME_QUEST_SCEN15_17_TITLE_2" = "%75'den daha yüksek bir mutluluk oranı koruyun.";
"T_GAME_QUEST_SCEN15_17_TITLE_NEW" = "Memnuniyetin uzun süreliğine çok fazla düşmesine izin vermeyin.";
"T_GAME_QUEST_SCEN15_19_START" = "Lordum, bu yangının bir kaza olmadığına dair söylentiler var. \nBir tavernada söylentileri dinleyerek çok fazlasını öğrenebileceğime eminim. ";
"T_GAME_QUEST_SCEN15_19_SUCCESS" = "Kasaba halkı tavernada kesinlikle çok fazla gevezelik edecektir. Kasabadaki bu yangınlar hakkında daha fazlasını öğrenmeye çalışacağım.";
"T_GAME_QUEST_SCEN15_20_START" = "Söylentilere göre kasaba halkını kışkırtmak için yangınlar çıkartan bir kundakçı varmış.\nNöbetçiler eğitmeliyiz.";
"T_GAME_QUEST_SCEN15_20_SUCCESS" = "Şimdi yalnızca beklememiz gerekiyor…";
"T_GAME_QUEST_SCEN15_22_SUCCESS" = "Lordum, bir nefes alabiliriz! Nöbetçiler kundakçıyı yakalayıp tutukladılar.\nKasaba yeniden güvende olacaktır!";
"T_GAME_QUEST_SCEN16_01_START" = "Selamlar saygıdeğer Efendim. Kral kısa süre içinde haraç talep edecektir.\nYerel tarımı desteklemeliyiz.";
"T_GAME_QUEST_SCEN16_01_SUCCESS" = "Muhteşem!\n\nLordum, ekonomi yeteneğiniz sayesinde Kralın isteklerini yerine getirmeyi başardık.";
"T_GAME_QUEST_SCEN16_01_TITLE" = "Kralın isteklerini yerine getirin.";
"T_GAME_QUEST_SCEN16_02_2_START" = "Ah hayır! Kral bir buğday teslimatı daha talep etti.\nBelki de istenilen tahılın kalanı için tüccar ile ticaret yapabiliriz!";
"T_GAME_QUEST_SCEN16_02_2_SUCCESS" = "İşte gerçekten başardık! Buğdayı şimdi Krala gönderin.";
"T_GAME_QUEST_SCEN16_02_2_TITLE" = "Krala daha fazla buğday gönderin.";
"T_GAME_QUEST_SCEN16_02_START" = "Kral köylerden buğday istedi.\nBöyle büyük bir teslimatı yapabilmek için daha fazla çiftliğe ihtiyacımız var!";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "Lordum, stokta teslimatı yapmak için yeterli buğday var.";
"T_GAME_QUEST_SCEN16_03_START" = "Kralın depolar inşa etmek için kaynaklara ihtiyacı var.\nGerekli malzemeleri Krala gönderin.";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "Diğer teslimatlarla devam etmek için şimdi istenilen malzemeleri teslim edin.";
"T_GAME_QUEST_SCEN16_03_TITLE" = "Bir depo için inşaat malzemeleri teslim edin.";
"T_GAME_QUEST_SCEN16_04_1_START" = "İlk teslimat çürüdü. Kasabadaki hastalığı yendikten sonra yeni bir tane gönderin.";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "Harika iş Lordum! Yeni et stokta ve teslim edilmeyi bekliyor.";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "Et gönderin.";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "Hastalık kalktığında et gönderin.";
"T_GAME_QUEST_SCEN16_04_START" = "Şimdi Kral et istiyor.\nYeterli avcı varken bu sorun olmayacaktır.";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "Çok güzel Efendim. Gerekli kaynak miktarı stokta bulunuyor.";
"T_GAME_QUEST_SCEN16_04_TITLE" = "Daha fazla avcı kulübesi inşa edin ve et teslim edin.";
"T_GAME_QUEST_SCEN16_05_START" = "Kral bir ziyafet vermeyi planlıyor. Bu yüzden içecekleri bizim göndermemizi istiyor.\nKraliyete içki ve üzüm suyu gönderin.";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "Çok güzel Efendim. Yeterli içki ve üzüm suyu stokta bulunuyor.";
"T_GAME_QUEST_SCEN16_05_TITLE" = "İçki ve üzüm suyu gönderin.";
"T_GAME_QUEST_SCEN16_06_START" = "Kral teslimatlarımızdan çok memnun kaldı.\nYiyeceği de göndermemizi istiyor.\n\nKraliyet ziyafeti için şimdi sosis ve ekmek ile vergi ödemesi yapın. ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "Muhteşem Lordum. Bu son haraç ödemesiydi.";
"T_GAME_QUEST_SCEN16_06_TITLE" = "Sosis ve ekmek gönderin.";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "Meyve suyu ve ekmek gönderin.";
"T_GAME_QUEST_SCEN16_08_START" = "Lordum, bu bir felaket! Buğdayımız bu gizemli beladan etkilendi ve artık mahvoldu!";
"T_GAME_QUEST_SCEN16_09_START" = "Köylüler berbat bir veba yüzünden acı çekiyor.\nHızlıca üstesinden gelmezsek hiç işçi kalmayacak!";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "Veba hasta hayvanlar tarafından tetikleniyor gibi. Krala giden teslimat da kurtlanmış.\nYeni bir tane göndermemiz gerekiyor!";
"T_GAME_QUEST_SCEN16_09_TITLE" = "Bir doktorun yardımıyla kasabadaki vebanın üstesinden gelin.";
"T_GAME_QUEST_SCEN16_10_START" = "Tanrılar bize karşı komplo kurdu. Veba tüm vahşi hayvanların ölmesine sebep oldu. Şimdi nasıl kasabayı doyurup Kralın isteklerini yerine getireceğiz?";
"T_GAME_QUEST_SCEN16_11_START" = "Artık kasaba halkını doyurmak için hayvan yetiştirmemiz gerekiyor.\nBu yüzden bir domuz çiftliği ve kasap dükkânına ihtiyacımız var.";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "Domuzlar buğdaydan besleniyor. Yeniden krallığa teslimatla ilgilenebilmemiz için tüccarla ticaret yapın.";
"T_GAME_QUEST_SCEN16_11_TITLE" = "Bir domuz çiftliği ve kasap dükkânı inşa edin.";
"T_GAME_QUEST_SCEN16_12_1_START" = "Rezervlerimin çok talep gördüğünü kesinlikle anlayacaksınız.\nBundan sonra demir cevheri karşılığında buğday takas edeceğim.";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "Cevheri teslim edin, kısa süre içinde başka bir teslimat ile geri döneceğim.";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "Demir cevherini buğday ile takas edin.";
"T_GAME_QUEST_SCEN16_12_2_START" = "Sana gülünç derecede düşük bir fiyata ülkedeki son buğdayı teslim edebilirim!";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "Lordum, bu bir zevk. Bana altını gönderirseniz size bir miktar daha verebilir miyim bakarım.";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "Altını buğday ile takas edin.";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "Talihsizliğinizi duydum ve size bir yardım eli uzatmak istiyorum. Hâlâ mallar için takas edebileceğim birkaç buğday rezervim bulunuyor.";
"T_GAME_QUEST_SCEN16_12_START" = "Buğday için seve seve birkaç taş takas edebilirim.";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "Görünüşe göre artık bir takas için yeterli malınız var. Daha sonraki ticaretleri dört gözle bekliyorum.";
"T_GAME_QUEST_SCEN16_12_TITLE" = "Buğday ile taş takas edin.";
"T_GAME_QUEST_SCEN2_10_DESC" = "Daha önce hiç yeğenimin yaptığı ekmeği denediniz mi? Kesinlikle denemelisiniz! Ve kışı geçirecek kadar yeterli miktarda pişirmesini söyleyin!";
"T_GAME_QUEST_SCEN2_10_NAME" = "50 somun ekmek pişirin.";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "Bir dokuma fabrikası inşa edin.";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "Bir terzi dükkânı inşa edin.";
"T_GAME_QUEST_SCEN2_11_DESC" = "Söyleyin bana, siz de bizim kadar üşüyor musunuz? Eşim elbiselerindeki şu delikler yüzünden nezle bile oldu. Kalın giysiler yapmamızda bize yardım edebilir misiniz?";
"T_GAME_QUEST_SCEN2_11_NAME" = "Bir koyun otlağı inşa edin.";
"T_GAME_QUEST_SCEN2_12_DESC" = "Bence kasabamız gelmekte olan kış için kusursuz şekilde hazırlandı! Yine de aramızda kalsın, dışarısı soğuktan donuyorken sıcak bir tavernada güzel bir bardak meyve suyu içmek harika değil mi?";
"T_GAME_QUEST_SCEN2_12_NAME" = "Bir meyve suyu fabrikası inşa edin ve 50 sürahi meyve suyu üretin.";
"T_GAME_QUEST_SCEN2_1_DESC" = "Lordum, kabalık etmek istemem ama ne yazık ki çiftliğimiz eksik! Kış gelmeden önce tüm buğdayı nasıl zamanında hasat edeceğiz?";
"T_GAME_QUEST_SCEN2_1_NAME" = "2 çiftlik inşa edin.";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrr, şimdiden donuyorum Lordum! Eminim gelmekte olan kış çok soğuk olacak! Eşim ve ben yeterince yakacak odun olmasını sağlamayı unutmamanızı umuyoruz!";
"T_GAME_QUEST_SCEN2_2_NAME" = "3 ormancı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN2_3_DESC" = "Teşekkürler! Erkek kardeşlerime rastlarsanız onlara selamlarımı iletin. Olabildiğince çok yakacak odun toplamaları gerekiyor!";
"T_GAME_QUEST_SCEN2_3_NAME" = "35 odun toplayın.";
"T_GAME_QUEST_SCEN2_4_DESC" = "Nihayet hasada başlayabiliriz! Umarım ihtiyaçlarımızı karşılamak için yeterli olacaktır!";
"T_GAME_QUEST_SCEN2_4_NAME" = "35 buğday hasat edin.";
"T_GAME_QUEST_SCEN2_5_DESC" = "Ne bereketli bir hasat! Tüm bu buğdayı nerede saklayacağımızı bile bilmiyoruz! Bunlardan biraz ekmek yapmak iyi bir fikir olurdu!";
"T_GAME_QUEST_SCEN2_5_NAME" = "Bir yel değirmeni inşa edin ve un üretin.";
"T_GAME_QUEST_SCEN2_6_DESC" = "Sevgili Lort, burada yaşamayı gerçekten seviyoruz ancak evlerimizin gelecek kışta uzun süre dayanamayacağı konusunda endişeliyiz…";
"T_GAME_QUEST_SCEN2_6_NAME" = "Tüm evlerin iyi durumda olmasını sağlayın.";
"T_GAME_QUEST_SCEN2_7_DESC" = "Hâlâ bir konuda endişeliyim…\nNe yazık ki stokta hiç aletimiz yok. Eminim aletlerin bina onarımında ne kadar önemli olduğunu biliyorsunuzdur! Bizim için bir miktar alabilir misiniz?";
"T_GAME_QUEST_SCEN2_7_NAME" = "50 alet haraç ödeyin.";
"T_GAME_QUEST_SCEN2_8_DESC" = "Erkek kardeşlerimin tüm işi kendi başlarına tamamlayamayacağından korkuyorum… Belki de köyümüzde fazladan birkaç kişi ekleyebilir misiniz?";
"T_GAME_QUEST_SCEN2_8_NAME" = "Nüfusu 50'ye çıkarın.";
"T_GAME_QUEST_SCEN2_9_DESC" = "Burnum buz tutmaya başladı bile… Ama yerleşecek bir yer arayan seyahat eden insanlardan bazıları daha da zorluk çekiyor. Bence onların köyümüzde yaşamalarına izin vermeliyiz!";
"T_GAME_QUEST_SCEN2_9_NAME" = "6 kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN3_10_DESC" = "Tatlım, yarının düğün günümüz olduğunu unutmasan iyi olur! Yeni bir mücevher gerçekten hoşuma gider! Keşke tanıdığın bir kuyumcu olsaydı…";
"T_GAME_QUEST_SCEN3_10_NAME" = "Bir kuyumcu dükkânı inşa edin.";
"T_GAME_QUEST_SCEN3_11_DESC" = "Eminim Kral ve Kasabalılarınız yeni aletler konusunda sevinir! Eskiler paslanmış ve işe yaramaz hale gelmişti!";
"T_GAME_QUEST_SCEN3_11_NAME" = "Bir alet yapım atölyesi inşa edin.";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "Bir terzi dükkânı inşa edin ve giysiler üretin.";
"T_GAME_QUEST_SCEN3_12_DESC" = "Ah, şu sevimli koyunlara baksanıza! Tatlım, onları gördün mü? Ve onlardan toplanan şu yünlere baksanıza! Artık tek ihtiyacımız olan bir dokuma fabrikası ve terzi dükkânı!";
"T_GAME_QUEST_SCEN3_12_NAME" = "Bir dokuma fabrikası inşa edin ve yeterli miktarda kumaş üretin.";
"T_GAME_QUEST_SCEN3_13_DESC" = "Çocuklar gerçekten heyecanlı ve yakında yiyecekleri taze ekmeği dört gözle bekliyorlar! Çoktan birkaç fırın inşa ettiniz, değil mi? Tatlım?";
"T_GAME_QUEST_SCEN3_14_DESC" = "Tahmin edin bakalım! Kız kardeşim nihayet evlenmek istiyor! Ancak kasabamızda bir kiliseye ihtiyacımız var! Yalnızca düğün merasimleri için değil, dindar Kasabalılarımız için de!";
"T_GAME_QUEST_SCEN3_14_NAME" = "Yüksek dini doygunluğa ulaşın.";
"T_GAME_QUEST_SCEN3_15_DESC" = "Şuna baksanıza tatlım! Kasaba iyileşti ve her tıkırında işliyor! Artık istersen arkadaşlarınızla rahatınıza bakıp bir taverna inşa etmek için iznim sizindir! ";
"T_GAME_QUEST_SCEN3_15_NAME" = "Tavernalarla yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN3_1_DESC" = "Tatlım, şu virane kasabaya baksana… Bu zavallı Kasabalılar, onlara gerçekten üzülüyorum! Bence Kraldan yardım istemelisiniz! Belki de birkaç hediye göndererek onu ikna edebilirsiniz!";
"T_GAME_QUEST_SCEN3_1_NAME" = "Krala haraç ödeyin ve tüm görevleri yerine getirin.";
"T_GAME_QUEST_SCEN3_2_DESC" = "Kral yardım gönderene kadar ipleri elinize almalısınız! Kasabalıların acilen daha fazla suya ihtiyacı var!";
"T_GAME_QUEST_SCEN3_2_NAME" = "Köyünüzde bir kuyu inşa edin.";
"T_GAME_QUEST_SCEN3_3_DESC" = "Sizden önceki kişi yeterli yiyecek tedarik etmeyi bile başaramadı! Bu gerçekten inanılmaz! Hayatım, bunu hemen değiştirmelisiniz! Neden bir balıkçı kulübesi inşa etmiyorsunuz?";
"T_GAME_QUEST_SCEN3_3_NAME" = "2 balıkçı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN3_4_DESC" = "Şu zavallı çocuklar… Tatlım, onları neredeyse balıkla bile besleyemiyoruz. Un ve ekmek için buğday hasadı yapabilmemiz için çiftlikler inşa etmelisiniz!";
"T_GAME_QUEST_SCEN3_4_NAME" = "2 çiftlik inşa edin ve buğday üretin.";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "Bir dökümcü inşa edin.";
"T_GAME_QUEST_SCEN3_5_DESC" = "Hey tatlım, bir şey unutmadınız mı? Bize yardım etmeye ikna olması için Krala birkaç hediye göndermeyi planlamamış mıydınız? Bana sahip olduğunuz için şanslısınız… Değerli bir şeyler üretebilmek için önce kesinlikle bir madene ve kömürcüye ihtiyacımız olacak!";
"T_GAME_QUEST_SCEN3_5_NAME" = "Bir maden inşa edin.";
"T_GAME_QUEST_SCEN3_6_DESC" = "Tüm Kasabalılarınız çok çalıştı! Daha fazla işçi çekebilmek için birkaç yeni kasaba evi inşa edemez misiniz?";
"T_GAME_QUEST_SCEN3_6_NAME" = "3 kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN3_7_DESC" = "Ah, çok mutluyum! İşler gittikçe daha da iyiye gidiyor! Artık Kasabalılardan daha fazla vergi bile toplayabiliriz!";
"T_GAME_QUEST_SCEN3_7_NAME" = "1500 Taler vergi toplayın.";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "Yeterli miktarda Taler vergisi toplayın.";
"T_GAME_QUEST_SCEN3_8_DESC" = "Başka ne güzel olurdu biliyor musunuz? Birkaç yeni kıyafet! Yani, elbette öncelikle Kral için… Yine de yün toplayabilmek için birkaç koyun otlağına ihtiyacımız var!";
"T_GAME_QUEST_SCEN3_8_NAME" = "2 koyun otlağı inşa edin.";
"T_GAME_QUEST_SCEN3_9_DESC" = "Çiftçiler buğday toplamak için zaten çok sıkı çalışıyor! Artık ekmek yapımında un üretebilmemiz için bir yel değirmeni inşa edebilirsiniz!";
"T_GAME_QUEST_SCEN3_9_NAME" = "Bir yel değirmeni inşa edin ve un üretin.";
"T_GAME_QUEST_SCEN4_10_DESC" = "Kalem, kraliyet statüm için gerçekten uygun değil, bu yüzden yazlık malikânemi büyük ölçüde genişletmeyi planlıyorum. \n\nKralınız olarak büyük miktarda taş teslimatı yapmanızı emrediyorum. Sadık vekilim, sizin güvenilirliğinize bel bağlıyorum.";
"T_GAME_QUEST_SCEN4_10_NAME" = "Krala bir araba dolusu taş teslim edin.";
"T_GAME_QUEST_SCEN4_11_DESC" = "Bunaltıcı sıcaklar evlerimizi kötü etkiledi. Evlerin durumu kötüleşiyor ve birçok aile binaların durumlarını iyileştirmenizi talep ediyor.\n\nKasabadaki binaların durumunu iyileştirmeyi düşünürseniz harika olur.";
"T_GAME_QUEST_SCEN4_11_NAME" = "Yüksek bina mutluluğu elde edin.";
"T_GAME_QUEST_SCEN4_12_DESC" = "Güzel vekilim, hâlâ üzüm suyu teslimatını bekliyorum. Verdiğim ziyafet yakında başlayacak.";
"T_GAME_QUEST_SCEN4_12_NAME" = "Krala üzüm suyu teslim edin.";
"T_GAME_QUEST_SCEN4_13_DESC" = "Lordum, krallığın tamamında un yüksek talep görüyor. Çiftlikler tam kapasitede çalışması için değirmenlere yeterli miktarda buğday üretemiyor.\n\nBana yeterince un teslim ederseniz pazarda bir köşe açıp bu bölgede bir tekel oluşturabilirim. Elbette bunun için sizi cömertçe ödüllendiririm.";
"T_GAME_QUEST_SCEN4_13_NAME" = "Tüccara un teslim edin.";
"T_GAME_QUEST_SCEN4_14_DESC" = "Kasabalılar, gün boyunca kavurucu güneşten korunmak için çardaklar inşa etmek istiyor. Hemen başlayabilmeleri için onlara tahta tedarik etmeliyiz!";
"T_GAME_QUEST_SCEN4_14_NAME" = "35 tahta üretin.";
"T_GAME_QUEST_SCEN4_15_DESC" = "Lordum, iyi iş çıkarttınız. Kasaba büyük ölçüde büyüdü.\n\nYine de Kasabalılar kuraklık yüzünden çok mutsuz. Daha fazla isteklerini yerine getirerek mutluluğu artırmayı denemelisiniz. Elbette bu sadece naçizane bir teklif…";
"T_GAME_QUEST_SCEN4_15_NAME" = "Kasabanızda yüksek mutluluk elde edin.";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "Efendim, kesinlikle muhteşem!\nKuraklığa rağmen büyük bir kasaba inşa etmeyi başardınız. Kasabalılarınız yaptığınız değişikliklerden gerçekten memnun.\n\nKralınız olarak çalışmalarınızdan çok memnunum. Krallığa harika bir hizmet sundunuz ve buna göre ödüllendirileceksiniz.";
"T_GAME_QUEST_SCEN4_1_DESC" = "Lordum, Kasabalılar sefalet ve yoksulluk içinde yaşıyor. Krallık kuraklık çekiyor. Kalenizin yanında akan şu muhteşem nehre baksanıza. Yalnızca küçük su birikintileri kalmış…\n\nKral bize kasabamızı genişletme görevi verdi. Hadi birkaç kasaba evi daha inşa ederek başlayalım.";
"T_GAME_QUEST_SCEN4_1_NAME" = "8 kasaba evi daha inşa edin.";
"T_GAME_QUEST_SCEN4_1b_DESC" = "Efendim, Kral kasabanın başarıyla genişlediğini duyduğuna sevindi ancak daha da büyük bir kasaba inşa etmemizi emrediyor.";
"T_GAME_QUEST_SCEN4_1b_NAME" = "Toplamda 100 nüfusa ulaşın.";
"T_GAME_QUEST_SCEN4_2_DESC" = "Lordum, bir tüccar olarak içinde bulunduğunuz çıkmaza büyük ölçüde yardımcı olabilirim. \n\nKrallık bir kuraklık çekiyor olabilir ancak siz bir pazar inşa eder etmez kasabanızın çok ihtiyaç duyduğu tedarikleri teslim edebilirim.";
"T_GAME_QUEST_SCEN4_2_NAME" = "Yüksek pazar mutluluğu elde edin.";
"T_GAME_QUEST_SCEN4_3_DESC" = "Lordum size yalvarıyorum, lütfen köylülere bu sıcakta su tedarik edebilmek için ilave kuyuların inşa edilmesini emrini verin.";
"T_GAME_QUEST_SCEN4_3_NAME" = "2 kuyu inşa edin.";
"T_GAME_QUEST_SCEN4_4_DESC" = "Efendim, müjdeler getiriyorum. Bir Kasabalı kuruyan nehir yatağındaki su birikintisinde hâlâ birkaç balık olduğunu keşfetti. \n\nBirkaç balıkçı kulübesinin inşa edilmesini emretmeliyiz.";
"T_GAME_QUEST_SCEN4_4_NAME" = "2 balıkçı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN4_5_DESC" = "Lordum, bir teklif yapmak istiyorum.\n\nTicari ilişkilerimizi genişletebilirsek kasabanıza düzenli yiyecek teslimatı ayarlayabilirim.";
"T_GAME_QUEST_SCEN4_5_NAME" = "Pazarda satış yaparak 1000 Taler kâr elde edin.";
"T_GAME_QUEST_SCEN4_6_DESC" = "Tekrardan önünüze bir teklif ile geldim. Acilen kömüre ihtiyacım var. Bana kömür tedarik ederseniz size büyük bir çuval dolusu Taler ile ödeme yaparım.";
"T_GAME_QUEST_SCEN4_6_NAME" = "Tüccara kömür teslim edin.";
"T_GAME_QUEST_SCEN4_7_DESC" = "Vekil, sarayımın acilen üzüm suyuna ihtiyacı var. Kuraklık yeniden krallığımın başına dert oldu ve üzüm hasatlarımızı mahvetti.\n\nBir meyve suyu fabrikası inşa etmenizi emrediyorum. Yakında kalemde bir ziyafet vermeyi planlıyorum bu yüzden beni hayal kırıklığına uğratmayın!";
"T_GAME_QUEST_SCEN4_7_NAME" = "Bir meyve suyu fabrikası inşa edin ve meyve suyu üretin.";
"T_GAME_QUEST_SCEN4_8_DESC" = "Lordum, ailem kuraklıktan kavrulmuş bu topraklarda neredeyse hiç ekip biçemiyor. Hasat zayıf olacak, bu yüzden bir çiftlik yeterli olmayacak.";
"T_GAME_QUEST_SCEN4_8_NAME" = "İlave bir çiftlik inşa edin ve yeterli miktarda buğday üretin.";
"T_GAME_QUEST_SCEN4_9_DESC" = "Efendim, ekmek stokumuz ciddi derecede azalıyor. Kasabaya daha fazla et tedarik ederek ekmek tüketimini azaltmalıyız.";
"T_GAME_QUEST_SCEN4_9_NAME" = "Yeterli miktarda et üretin.";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "Tüm görevleri tamamlayın, kuraklığın üstesinden gelin ve kasabanızı büyütüp şehre dönüştürün!";
"T_GAME_QUEST_SCEN5_10_DESC" = "Lordum, artık yalnızca bir eksik kaldı, o da zaferimizi kutlamak için üzüm suyu!\n\nLütfen ordunun kamp alanına büyük miktarda üzüm suyu teslim edin!";
"T_GAME_QUEST_SCEN5_10_NAME" = "Şövalyeye 45 üzüm suyu teslim edin.";
"T_GAME_QUEST_SCEN5_11_DESC" = "Kesinlikle muazzam Efendim!\nLort Blankenstein seferini başarıyla tamamladı ve sizden ve desteğinizden övgüyle bahsediyor.\n\nBen bu bölgeden ayrılmadan son bir ticaret yapmak ister misiniz?";
"T_GAME_QUEST_SCEN5_11_NAME" = "Ticaret yaparak 2500 Taler kâr elde edin.";
"T_GAME_QUEST_SCEN5_1_DESC" = "Efendim, ne güzel bir sabah. Harika haberlerim var. Serbest bir tüccar bizimle iletişime geçti.\n\nYakında kasabamızı ziyaret edecek ve bir pazar standı kurmak için tahta ihtiyacı olduğunu söyledi.";
"T_GAME_QUEST_SCEN5_1_NAME" = "30 tahta üretin.";
"T_GAME_QUEST_SCEN5_2_DESC" = "Lordum, buraya güzel bir ticaret merkezi kurdunuz. Yine de tek bir şey eksik o da bir taverna. Bir taverna inşa edersek küçük kasabamız daha fazla tüccar ve gezgin çeker.";
"T_GAME_QUEST_SCEN5_2_NAME" = "Tavernalarla yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN5_3_DESC" = "Lordum, çok güzel. Taverna gelecek için birçok ticaret fırsatı doğuracak.\nŞimdi düzenlememizin ilgi çekici kısmına dönelim. Hadi birkaç mal ticareti yapalım… ";
"T_GAME_QUEST_SCEN5_3_NAME" = "Ticaret yaparak 1500 Taler kâr elde edin.";
"T_GAME_QUEST_SCEN5_4_DESC" = "Efendim, kumaş stoku yapar mısınız? Kumaşlarla çok ilgilenen bir ticaret partnerim var.\n\nAyrıca seyahat ederken bir şövalye ile tanıştım. Buraya geliyor ve sizin için birkaç ilgi çekici görevi olabilir.";
"T_GAME_QUEST_SCEN5_4_NAME" = "Deponuzda 35 birim kumaş stoklayın.";
"T_GAME_QUEST_SCEN5_5_DESC" = "Lordum! Ben Kunibert von Blankenstein, Kralın vaftiz edilmiş bir şövalyesiyim.\n\nTicaret merkeziniz, haydutları bu topraklardan sürme görevimde yardımcı olmak için mükemmel şekilde uygun. Bu bölgeyi korumak için nöbetçi kuleleri inşa edebilmem için bana taş tedarik eder misiniz?";
"T_GAME_QUEST_SCEN5_5_NAME" = "Şövalyeye 50 taş teslim edin.";
"T_GAME_QUEST_SCEN5_6_DESC" = "Lort vekilim, orduma kılıç tedarik edebilmek için silah yapımcılarımın acilen demire ihtiyacı var.\n\nTicaret merkezinizin yakınında birkaç cevher yatağı var. Hizmetkârıma bir demir teslimatı yapabilir misiniz?";
"T_GAME_QUEST_SCEN5_6_NAME" = "Şövalyeye 65 demir külçe teslim edin.";
"T_GAME_QUEST_SCEN5_7_DESC" = "Lordum, bir sorunum var. Piyade erlerimden bazılarının haydutlara karşı yapılan son savaşta zırhlarında çukurlar oluştu. \n\nAskerlerimin ticaret merkezini ziyaret ettiklerinde zırhlarını onarabilmesi için lütfen alet stoku yapın.";
"T_GAME_QUEST_SCEN5_7_NAME" = "25 alet üretin.";
"T_GAME_QUEST_SCEN5_8_DESC" = "Lort vekilim, iyi haberler getiriyorum! Seferim büyük bir başarı getirdi ve haydutlar bu bölgeden sürüldü.\n\nBu uzun sefer boyunca erzaklarımızın tamamını tükettik. Orduma biraz yiyecek teslimatı yapmanıza ihtiyacım var.";
"T_GAME_QUEST_SCEN5_8_NAME" = "Şövalyeye 25 balık ve 25 ekmek teslim edin.";
"T_GAME_QUEST_SCEN5_9_DESC" = "Birliklerim haydutlara karşı olan zaferimizi kutlamak istiyor ancak haydutlar artık bozguna uğratıldığına göre adamlarım yerinde duramıyor. \n\nKasabada eğlence mekânları inşa eder misiniz Lordum?";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "Birliklerim haydutlara karşı olan zaferimizi kutlamak istiyor ancak haydutlar artık bozguna uğratıldığından beri adamlarım yerinde duramıyor. \n\nAskerlerin biraz stres atabilmesi için atlı mızrak alanları inşa eder misiniz Lordum?";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "Atlı mızrak alanları ile yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "Tüm görevleri tamamlayarak başarılı bir ticaret merkezi inşa edin!";
"T_GAME_QUEST_SCEN5_SUCESS" = "Kesinlikle muhteşem Lordum. \nStratejik olarak önemli bir konumda başarıyla bir ticaret merkezi inşa ettiniz.\nKral ve Lort Blankenstein, bu bölgedeki haydutlara karşı yapılan seferdeki desteğiniz ve çalışmanızdan çok memnun.";
"T_GAME_QUEST_SCEN6_1_DESC" = "Kral bir emir verdi! Bir katedral inşa etmek için büyük miktarda malzeme talep ediyor! Bu devasa binanın inşaatı çoktan başladı, bu yüzden kaynakları olabildiğince hızlı şekilde teslim etmeliyiz.";
"T_GAME_QUEST_SCEN6_1_NAME" = "Katedralin inşaatı için kaynakları teslim edin.";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "Yün ile balık takas edin.";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "Demir cevheri ile balık takas edin.";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "Üzüm suyu ile balık takas edin.";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "Altın cevheri ile balık takas edin.";
"T_GAME_QUEST_SCEN6_2_NAME" = "Tahta ile balık takas edin.";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "Yakınlarda göl veya nehir olmadığını görüyorum, bu yüzden balık üretemezsiniz. Bir pazar yeri inşa ederseniz çeşitli mallar karşılığında sizinle balık ticareti yapabilirim!";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "2 maden daha inşa edin.";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "3 maden daha inşa edin.";
"T_GAME_QUEST_SCEN6_3_DESC" = "Hemen maden çıkarmaya başlamalıyız! Teslimat programına uyabilmemiz için yeterli miktarda madenimizin çalıştığına emin olun.";
"T_GAME_QUEST_SCEN6_3_NAME" = "Bir maden inşa edin.";
"T_GAME_QUEST_SCEN6_4_DESC" = "Kasabalılarınız tüm cevheri çıkarabilmek için olabildiğince çok çalışıyor! Çalışmaya uygun olmalarını sağlamak için onlara yeterli yiyecek verdiğinizden emin olun!";
"T_GAME_QUEST_SCEN6_4_NAME" = "Bir fırın inşa edin ve biraz ekmek üretin.";
"T_GAME_QUEST_SCEN6_5_DESC" = "Hızlı ilerliyoruz ancak hâlâ cevheri eritmemiz gerek!";
"T_GAME_QUEST_SCEN6_5_NAME" = "2 dökümcü inşa edin.";
"T_GAME_QUEST_SCEN6_6_DESC" = "Uygun giysiler olmadan karanlık ve nemli madenlerde çalışmak gerçekten huzursuz edici olabilir! Kasabalılarınıza kalın giysiler tedarik etmelisiniz. Eminim bunun için gerçekten minnettar kalırlar!";
"T_GAME_QUEST_SCEN6_6_NAME" = "25 parça giysi teslim edin.";
"T_GAME_QUEST_SCEN6_7_DESC" = "Lordum, büyük bir hızla kaynak üretiyoruz! Tüm bu kaynakları depolamak için daha fazla depo inşa etmeliyiz!";
"T_GAME_QUEST_SCEN6_7_NAME" = "2 depo inşa edin.";
"T_GAME_QUEST_SCEN6_8_DESC" = "Madenlerde çalışmak zor bir iş! Kasabalılarınız yoğun bir iş gününün ardından rahatlamak için bir yerleri olmasını çok isterdi. Bir taverna bunun için çok uygun! ";
"T_GAME_QUEST_SCEN6_8_NAME" = "Bir taverna inşa edin.";
"T_GAME_QUEST_SCEN6_END_DESC" = "Aferin! Katedral için ihtiyaç duyulan tüm kaynakları teslim etme konusunda harika iş çıkardın! Yine de inşaat biraz zaman alacak.\n\nKatedral, eylemleri yüzyıllar boyunca dirlik ve düzen getiren büyük Kralımız için bir abide olacak!";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "Unutmayın, engel olan ağaçları kaldırabilirsiniz! Kaldırılmasını istediğiniz ağaçları işaretlemek için küreği kullanın.";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "Efendim, doğru malzemeler olmadan bir düğün pastası pişiremeyiz! Kendi unumuzu üretebilmemiz için bir çiftlik inşa eder misiniz?";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "Bir çiftlik inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "Bir yel değirmeni inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "25 ekmek üretin.";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "Bu muhteşem bir düğün olacak! İlk olarak harika bir düğün pastamız olduğundan emin olmalıyız. Ben gelinliğimi seçerken lütfen bir fırın inşa eder misiniz?";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "Bir fırın inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "Hoşuma gitmeyen düğün hediyelerinin hepsinden kurtulabilmek için bir pazara ihtiyacım var!";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "Yüksek pazar mutluluğu elde edin.";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "Lordum, düğün hazırlıkları konusunda çok iyi ilerliyoruz! Yine de düğün çadırını inşa etmek için daha fazla alete ihtiyacımız var!";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "Bir alet yapım atölyesi inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "20 alet üretin.";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "Düğün merasimimizin güzel bir kilisede gerçekleşmesini istiyorum. Bir tane inşa etmiş miydiniz?";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "Yüksek dini mutluluk elde edin.";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "Bir koyun otlağı inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "Bir dokuma fabrikası inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "20 giysi üretin.";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "Buna inanabiliyor musunuz? Hiçbir yerde düzgün bir gelinlik bulamadım! Hemen bir gelinliğe ihtiyacım var! En iyi terzinize bir tane diktirin.";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "Bir terzi dükkânı inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "Dekorasyonlar inşa edin.";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "Kasabalılarınızın mutluluğunu artırın!";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "Bu yer gerçekten sıkıcı… Bu kasabayı güzelleştiremez misiniz? Herkesin benim kadar mutlu hissetmesini istiyorum!";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "Pasta veya çiçekler umurumda değil, bolca meyve suyunun olduğu büyük bir kutlama istiyorum! Ayrıca bütün kasabayı davet etmek istiyorum! Ancak düğün davetlilerinin tamamını ağırlamak için yeterli yerimiz yok!";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "Daha fazla küçük kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "Düğün sona erdiğinde arkadaşlarımla toplanmak için güzel bir yer istiyorum. Bu kasabanın gerçekten bir tavernaya ihtiyacı var!";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "Tavernalarla yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "25 üzüm suyu üretin.";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "Arkadaşlarım çok susamış olacak! Meyve suyuyla çoktan ilgilendiniz mi?";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "Bir meyve suyu fabrikası inşa edin.";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "Beklediğimizden daha fazla davetli olacak. Bir büyük kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "Bir büyük kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "15 mücevher üretin.";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "Ah hayır! Başım cidden belada! Düğün yüzüğünü kaybettim! Lütfen ona söylemeyin! Kasabada yeni bir tanesini yapacak bir kuyumcu var mı?";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "Bir kuyumcu dükkânı inşa edin.";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "Evlenmeden önce atlı mızrak alanında nişanlımı etkilemek istiyorum!";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "Atlı mızrak alanları inşa edin.";
"T_GAME_QUEST_SCEN8_10_DESC" = "Lordum, kaledeki depo odalarımız zaten ağzına kadar dolu. Size ek bir depo inşaatı emrini vermeyi önerebilir miyim?";
"T_GAME_QUEST_SCEN8_10_NAME" = "Yeni bir depo inşa edin.";
"T_GAME_QUEST_SCEN8_11_DESC" = "Kasabadaki adamlar onlar için yoğun bir iş gününün ardından buluşup bir bardak üzüm suyu içecek bir yer olsa daha mutlu olurdu. Lordum, bir taverna istemek çok mu olur?";
"T_GAME_QUEST_SCEN8_11_NAME" = "Tavernalarla yüksek memnuniyet elde edin.";
"T_GAME_QUEST_SCEN8_12_DESC" = "Lordum, demirci Kasabalılarımız için basit sobalar yaptı ancak sobaların içinde yakmak için kömüre ihtiyacımız var.";
"T_GAME_QUEST_SCEN8_12_NAME" = "50 kömür üretin.";
"T_GAME_QUEST_SCEN8_1_DESC" = "Lordum, kasabada evleri ısıtmak için yakacak odun eksiği var. Odun stoku yapmamız çok önemli!";
"T_GAME_QUEST_SCEN8_1_NAME" = "75 yakacak odun üretin.";
"T_GAME_QUEST_SCEN8_2_DESC" = "Kasaba kötü durumda. Şu virane evlere baksanıza. Birçoğunun yıkılması için muhtemelen bir kar fırtınası yeterli. Bina onarımlarında yardımcı olması için kasabaya bir marangoz getirelim.";
"T_GAME_QUEST_SCEN8_2_NAME" = "Bir marangoz dükkânı inşa edin.";
"T_GAME_QUEST_SCEN8_3_DESC" = "Lordum, bu zorlu kış kesinlikle göklerden gelen bir işaret! Günahlarımıza tövbe etmeliyiz! İzin verin tanrıyı memnun etmek için onun evini inşa edelim!";
"T_GAME_QUEST_SCEN8_3_NAME" = "Yüksek dini doygunluğa ulaşın.";
"T_GAME_QUEST_SCEN8_4_DESC" = "Lordum, kasabalılar huzursuzlanıyor. Evleri gerçekten soğuk. Bence yün stoku yapmalıyız. Kasabalılar bunu soğuğa karşı evlerini izole etmek için kullanabilirler.";
"T_GAME_QUEST_SCEN8_4_NAME" = "55 yün üretin.";
"T_GAME_QUEST_SCEN8_5_DESC" = "Komşu ilin Valisi bize bir haber güverciniyle yardım çağrısı göndermiş! Halkları için acilen kalın giysilere ihtiyaçları var.";
"T_GAME_QUEST_SCEN8_5_NAME" = "Komşu ile bir araba dolusu giysi gönderin.";
"T_GAME_QUEST_SCEN8_6_DESC" = "Lordum, çiftlikler kışın buğday üretemez. Geyik avlamaları için ormana birkaç Kasabalı göndermemize izin verin.";
"T_GAME_QUEST_SCEN8_6_NAME" = "Birkaç avcı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN8_7_DESC" = "Sadık hizmetkârım, krallık bu olağanüstü zorlu kış şartları yüzünden büyük zorluk çekiyor. Haraç gelirleri ciddi ölçüde düştü.\n\nVergi gelirinizi artırmak için bir maliye inşa etmenizi ve bana haraç ödemesi olarak bir araba dolusu Taler göndermenizi emrediyorum.";
"T_GAME_QUEST_SCEN8_7_NAME" = "Bir maliye inşa edin ve Krala para olarak haraç ödeyin.";
"T_GAME_QUEST_SCEN8_8_DESC" = "Artık kasabada bir marangozumuz olduğuna göre tüm bu yıkılmış evleri onarmak pek sorun olmayacak. Kasabalılar çok memnun olacak.";
"T_GAME_QUEST_SCEN8_8_NAME" = "Tüm kasaba evlerinin düzgünce onarıldığına emin olun.";
"T_GAME_QUEST_SCEN8_9_DESC" = "Av etleri kışın bile her zaman mevcuttur ve ekmek yerine geçebilir. Kış boyunca idare edebilecek kadar yeterli et olduğuna emin olalım.";
"T_GAME_QUEST_SCEN8_9_NAME" = "50 et üretin.";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "Lordum, kış beklediğimizden daha sert ve Kasabalılar durumdan mutsuz.\n\nHızlı hareket etmeliyiz yoksa kışı atlatamayacağız!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "Kasabanın kışı atlatmasını sağlayın…";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "Lordum, Kasabalılar yaptığımız ilerlemeden çok mutlu! \n\nArtık bize kış aylarını atlatmamız için bolca yetecek kadar tedarikliyiz ve hatta komşuya bile yardım edebiliriz. Artık hazırlıklıyız, bu kış bize hiçbir zarar veremez!";
"T_GAME_QUEST_SCEN9_10_DESC" = "Lordum, bölgenizde isyancılarla sorun yaşadığınızı duydum. Ormanda bir arama ekibine öncülük yapabilirim ancak paralı askerlerim önden ödeme talep ediyor.";
"T_GAME_QUEST_SCEN9_10_NAME" = "Paralı askerlere ödeme yapın.";
"T_GAME_QUEST_SCEN9_11_DESC" = "Sadık hizmetkârım, bir talebim daha var. Bir Krala uygun bir sancak gemisine ihtiyacım var, bu da bolca altın süsleme demek!\n\nBu amaç için ihtiyacım olan altını bana teslim etmenizi emrediyorum. Beni hayal kırıklığına uğratmayın.";
"T_GAME_QUEST_SCEN9_11_NAME" = "Süre sınırı dolmadan Krala altın cevher teslim edin.";
"T_GAME_QUEST_SCEN9_12_DESC" = "Sadık hizmetkârım, yeni filomun inşaatı gayet iyi ilerliyor ancak yine de büyük miktarda yelken bezine ihtiyacımız var. Tüm gemilerime yelken yapabilmek için yeterli miktarda kumaş teslim etmenizi emrediyorum.";
"T_GAME_QUEST_SCEN9_12_NAME" = "Yelkenli bezi üretimi için kumaş teslim edin.";
"T_GAME_QUEST_SCEN9_13_DESC" = "Adamlarım bir şey keşfetti. Ormanda haydutların izini bulduk. Yine de daha fazla araştırma yapabilmek için erzaka ihtiyacımız var.";
"T_GAME_QUEST_SCEN9_13_NAME" = "Paralı askerlere erzak teslim edin.";
"T_GAME_QUEST_SCEN9_14_DESC" = "Vali! Vilayetinizdeki haydutlara tam bir parti tahta kaybettim. Bunun durması gerekiyor. Olabildiğince kısa süre içinde daha fazla tahta teslim edin.";
"T_GAME_QUEST_SCEN9_14_NAME" = "Kralı filo inşaatını desteklemek için tahta teslim edin.";
"T_GAME_QUEST_SCEN9_15_DESC" = "Lordum, vergi toplayıcımız ormandaki haydutlar ve kasabadaki sabotajcı arasında bağlantı olduğuna dair bir kanıt buldu. Can güvenliğinden korktuğu için bize daha fazla anlatmayı reddediyor.\n\nVergi toplayıcılığı görevinden alınmak istiyor. Ayrıca kasabadan ayrılıp saklanabilmek için yeni bir takım giysi istiyor. Öğrendiği şeyi ancak bu şekilde söyleyecekmiş.";
"T_GAME_QUEST_SCEN9_15_NAME" = "Vergi toplayıcısını maliyedeki görevinden alın, kasabadan görünmeden kaçabilmesi için ona yeni giysiler tedarik edin.";
"T_GAME_QUEST_SCEN9_16_DESC" = "Lordum, vergi toplayıcısı tıpkı söz verdiği gibi kasabadan ayrılmadan önce sabotajcının kimliğini açığa çıkarttı.\n\nParalı asker ve adamları! Onlar dolandırıcı! Kasaba kasaba gezip gizlice kendi yaptıkları haydutluk ve sabotaj için para karşılığında "koruma" teklif ediyorlar!";
"T_GAME_QUEST_SCEN9_17_DESC" = "Kötü haber var Lordum! Birisi depoya girip tüm etlerimizi çalmış!\n\nKasabada etrafa birkaç meşale yerleştirelim. Bu, gece hırsızları yakalamaya yardımcı olur.";
"T_GAME_QUEST_SCEN9_17_NAME" = "Hırsızları tespit etmek için kasabaya 7 meşale yerleştirin.";
"T_GAME_QUEST_SCEN9_18_DESC" = "Efendim, yakın zamanda seyyah tüccarlar ziyaretimize gelmeyeceği için mallarımızın tamamını depolamak için bir depo odasına ihtiyacımız var. \n\nAyrıca depolarımızda fazladan yük olmadığından emin olmak için gereksiz üretimleri durdurmalıyız.\n\nBaşka bir depo daha inşa etmek akıllıca olur.";
"T_GAME_QUEST_SCEN9_18_NAME" = "Kasabada başka bir depo daha inşa edin.";
"T_GAME_QUEST_SCEN9_19_DESC" = "Kasabalılar sabotajcıdan çekiniyor ve dışarı çıkıp binalarını onarmak için fazla korkuyorlar.\n\nSanırım onarımların tamamlanmasını istiyorsak bir marangoz dükkânı inşa etmek zorundayız.";
"T_GAME_QUEST_SCEN9_19_NAME" = "Bir marangoz dükkânı inşa edin.";
"T_GAME_QUEST_SCEN9_1_DESC" = "Günaydın Lordum. Ne güzel bir kış günü. Gelecek aylarda yapmamız gereken işler belli. \n\nHemen birkaç ormancı kulübesi inşa ederek başlayalım, olur mu?";
"T_GAME_QUEST_SCEN9_1_NAME" = "Birkaç ormancı kulübesi inşa edin.";
"T_GAME_QUEST_SCEN9_20_DESC" = "Lordum, huzurunuza bir istek ile geldim. Krallığın her yerinde aletler yüksek talep görüyor.\n\nBana bir vagon dolusu alet teslim ederseniz size iyi bir ödeme yapabilirim. Ayrıca ticaret yapmak için kasabanızı yeniden ziyaret ederim.";
"T_GAME_QUEST_SCEN9_20_NAME" = "Tüccara bolca alet teslim edin.";
"T_GAME_QUEST_SCEN9_2_DESC" = "Lordum, önemli haberlerim var! Bir paralı asker grubu geldi ve bayağıdır kasabamızda bir tavernanın eksik olduğundan şikâyet ediyorlar. \n\nKasabada bir grup mutsuz ve canı sıkkın paralı asker olmasına izin vermemeliyiz, bu yüzden bir taverna inşa edelim. ";
"T_GAME_QUEST_SCEN9_2_NAME" = "Yüksek taverna mutluluğu elde edin.";
"T_GAME_QUEST_SCEN9_3_DESC" = "Vali, odun üretimini artırmak için gösterdiğiniz çabaların çok güzel ilerlediğini görmekten mutluyum.\n\nŞimdi ilk teslimatı yapar mısınız…";
"T_GAME_QUEST_SCEN9_3_NAME" = "Krala odun olarak haraç ödeyin.";
"T_GAME_QUEST_SCEN9_4_DESC" = "Lordum, kasabada huzursuzluk olduğuna dair bitmeyen söylentiler dönüyor. Bazı Kasabalılar kraliyete karşı komplo kuruyor olabilir mi?\n\nŞimdi harekete geçmezsek büyük bir isyanla yüz yüze gelebiliriz. Kasabalılarımızın mutlu ve hoşnut olduğundan emin olmalıyız ve bu konuda elimizi çabuk tutmalıyız.";
"T_GAME_QUEST_SCEN9_4_NAME" = "Gelecek birkaç dakika içinde 100%'den daha yüksek bir mutluluk oranı koruyun.";
"T_GAME_QUEST_SCEN9_5_DESC" = "Lordum, bu bir rezalet! Taverna yıkılmış! Kasabamızda dolaşan bir sabotajcıya dair söylentiler var. \n\nHer şey tamamen çığırından çıkmadan önce durumu kontrol altına almalıyız. Darağaçları ve boyunduruklar iş görecektir.";
"T_GAME_QUEST_SCEN9_5_NAME" = "Kasabada darağaçları ve 2 boyunduruk inşa edin.";
"T_GAME_QUEST_SCEN9_6_DESC" = "Lordum, kasabada morali biraz daha yükseltmek akıllıca olur. \n\nKasabalılarınıza biraz nezaket göstermek onların mutluluklarını artırır. Neden onlara bir kilise inşa etmiyor ya da kasabayı çiçek bahçeleriyle güzelleştirmiyorsunuz?";
"T_GAME_QUEST_SCEN9_6_NAME" = "Birkaç çiçek bahçesi ve bir kilise inşa edin.";
"T_GAME_QUEST_SCEN9_7_DESC" = "Vali, şu anda kasabanızı ziyaret edemeyeceğimi üzülerek bildirmek istiyorum.\nOrmanda kasabanızı çevreleyen haydutlara dair söylentiler duydum. Şu anda tüccarlar için fazla tehlikeli.\n\nYine de Kraldan bir mesajım var. İki kereste fabrikası inşaatının emrini verdi.";
"T_GAME_QUEST_SCEN9_7_NAME" = "2 kereste fabrikası inşa edin.";
"T_GAME_QUEST_SCEN9_8_DESC" = "Lordum, bir fikrim var. Bir maliye inşa etmeliyiz. Vergi toplayıcısı kasabadaki her evi ziyaret edecektir… Belki de bu sabotajcı hakkında bir şeyler öğrenebilir.";
"T_GAME_QUEST_SCEN9_8_NAME" = "Bir maliye inşa edin ve vergi toplayıcısının evleri soruşturmasını bekleyin.";
"T_GAME_QUEST_SCEN9_9_DESC" = "Lordum, kereste fabrikası sabote edildi! Ayrıca vergi toplayıcısı henüz sabotajcının kimliğini açığa çıkarma konusunda başarılı olmadı Lordum.";
"T_GAME_QUEST_SCEN9_FAIL_1" = "Kargaşayı zamanında engelleyemediniz!";
"T_GAME_QUEST_SCEN9_FAIL_2" = "Başarısız oldunuz! Sizin yetersizliğiniz yüzünden altınımı başka bir kasabadan sipariş etmek zorunda kaldım!";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "Vali, yakında yeni, büyük bir savaş gemisi filosunun inşaatını başlatacağım. \n\nKasabanız bu devasa projede benim en büyük odun tedarikçim olma potansiyeline sahip. Bunun olduğundan emin olun.";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "Vali, paralı asker ve çetesi bölgeden kaçtı. Adamlarım onları acımadan takip edecek.\n\nSize ayrıca yeni filomun inşaatı konusundaki desteğiniz için teşekkür etmek ve yeni amiral gemimin ilk seferine sizi davet etmek istiyorum. O zamana kadar size iyi günler dilerim…";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "Krala projesinde destek olun.";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "Çok güzel! Kasabadaki huzursuzluğa engel oldunuz!";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "Çok güzel! Tam zamanında teslimat yaptınız!";
"T_GAME_QUEST_SCEN_10_DESC" = "Turnuva sona erdiğinde şövalyelerimiz yerel tavernalarda eğlenecek! Yine de ne yeterince tavernamız ne de yeterince üzüm suyumuz olmadığından endişeleniyorum! Hemen bu durumla ilgilenin!";
"T_GAME_QUEST_SCEN_10_NAME" = "Taverna ile yüksek memnuniyete erişin.";
"T_GAME_QUEST_SCEN_11_DESC" = "Vekil, harika iş! Kasaba neredeyse hazır ancak kızlarım ve ben değiliz! Terzilerinizin dikebileceği en muhteşem giysilere ihtiyacım var!";
"T_GAME_QUEST_SCEN_11_NAME" = "35 giysi haraç ödeyin.";
"T_GAME_QUEST_SCEN_12_DESC" = "Artık turnuvanın açılışına yaklaşıyoruz ancak kasabada üzgün bir yüz görmek istemiyorum! Kasabalıların mutlu olduğundan emin olmalısınız!";
"T_GAME_QUEST_SCEN_12_NAME" = "Yüksek mutluluğa erişin.";
"T_GAME_QUEST_SCEN_1_DESC" = "Hoş geldiniz güzel vekilim! Bildiğiniz gibi bölgedeki en büyük atlı mızrak dövüş etkinliğini düzenliyorum! Bu etkinlik için en az 3 atlı mızrak alanı inşa etmenizi bekliyorum! Beni hayal kırıklığına uğratmayın!";
"T_GAME_QUEST_SCEN_1_NAME" = "3 atlı mızrak alanı inşa edin.";
"T_GAME_QUEST_SCEN_2_DESC" = "Turnuva misafirlerimiz kesinlikle acıkacaklar! Hemen ekmek üretmeye başlayıp onları Kralınıza haraç ödemesi olarak teslim etmenizi istiyorum!";
"T_GAME_QUEST_SCEN_2_NAME" = "25 somun ekmek haraç ödeyin.";
"T_GAME_QUEST_SCEN_3_1_NAME" = "Bir yel değirmeni inşa edin ve un üretin.";
"T_GAME_QUEST_SCEN_3_2_NAME" = "2 fırın inşa edin ve ekmek üretin.";
"T_GAME_QUEST_SCEN_3_DESC" = "Lordum, Kralı bekletmemeliyiz! Ekmek üretimine başlamak için buğday ve una ihtiyacımız var!";
"T_GAME_QUEST_SCEN_3_NAME" = "Bir çiftlik inşa edin ve buğday üretin.";
"T_GAME_QUEST_SCEN_4_DESC" = "Çok iyi iş çıkardınız, benim güzel vekilim! Yine de misafirlerimizi memnun etmek için yalnızca ekmek yeterli olmayacak! Kralınıza haraç ödemesi olarak taze balık talep ediyorum!";
"T_GAME_QUEST_SCEN_4_NAME" = "25 balık haraç ödeyin.";
"T_GAME_QUEST_SCEN_5_DESC" = "Turnuvanın unutulmaz olmasını istiyorum! Şövalyelerimiz altın mızraklar taşıyacak ve atlı mızrak alanlarımız parıldayacak! Bana bir iyilik yapın ve Kralınız için vergi toplayın!";
"T_GAME_QUEST_SCEN_5_NAME" = "1000 Taler haraç ödeyin.";
"T_GAME_QUEST_SCEN_6_DESC" = "Eminim misafirlerimiz taze sıkılmış üzüm sularının harika lezzetinin keyfini çıkaracaktır! Gidip meyve suyu fabrikaları inşa edin! Düşük kaliteli atıkları yerel tavernalarda bile servis edebilirsiniz!";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "Eminim misafirlerimiz taze sıkılmış üzüm sularının harika lezzetinin keyfini çıkaracaktır!";
"T_GAME_QUEST_SCEN_6_NAME" = "Bir meyve suyu fabrikası inşa edin ve meyve suyu üretin.";
"T_GAME_QUEST_SCEN_7_1_NAME" = "Bir dokuma fabrikası inşa edin ve kumaş üretin.";
"T_GAME_QUEST_SCEN_7_2_NAME" = "Bir terzi dükkânı inşa edin ve giysiler üretin.";
"T_GAME_QUEST_SCEN_7_DESC" = "Vekil, şövalyelerimizin cübbeleri çok eski ve solmuş, gözlerimi rahatsız ediyor! Gidip yenilerini alın! İşinize devam etmek istiyorsanız koyun otlakları inşa edin, bir dokumacı işe alın ve bir terzi dükkânı inşa edin!";
"T_GAME_QUEST_SCEN_7_NAME" = "2 koyun otlağı inşa edin.";
"T_GAME_QUEST_SCEN_8_DESC" = "Lordum, para karşılığında daha fazla mal satmalıyız. Gelecekteki olası harcamaları karşılaması için kenarda Taler bulundurmak her zaman iyi bir fikirdir.";
"T_GAME_QUEST_SCEN_8_NAME" = "500 Taler değerinde ticaret kârı edin.";
"T_GAME_QUEST_SCEN_9_DESC" = "İşlerin iyi ilerlediğini görüyorum ancak kasabanız hâlâ kötü görünüyor! Çeşmeler, beyaz taş duvarlar, her zaman yeşil ağaçlar ve görkemli heykeller istiyorum! Kasabayı daha fazla dekorasyonla güzelleştirmelisiniz!";
"T_GAME_QUEST_SCEN_9_NAME" = "Dekorasyon mutluluğunu artırın.";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "İlk olarak bölgedeki ormancı kulübelerinden birisine bir işçi görevlendirmeniz tavsiye ediliyor.";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "Ormancı kulübesine bir işçi görevlendirin.";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "Ana görevlerden birisi bir pazar inşa etmek.\nBu görevi tamamlamak için birkaç üretim zinciri kaynağı kurmalı ve gerekli kaynakları toplamalısınız Lordum.";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "Bir pazar yeri inşa edin.";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "Lordum, olabildiğince kısa süre içinde tahtalar üretebilmemiz için kereste fabrikasına bir Kasabalı görevlendirmenizi öneriyorum.";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "Kereste fabrikasına bir işçi görevlendirin.";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "Lordum, cevher yerine taş çıkarmaya geçmenizi öneririm.";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "Biraz tahta ve odun toplar toplamaz işçilerden birisini madende görevlendirip taş çıkarmaya başlamanız gerekiyor.";
"T_GAME_QUEST_SCEN_CC_47_END" = "Çok güzel Lordum. Şimdi pazar inşa edilene kadar sadece beklememiz gerekiyor.";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "Madene bir işçi görevlendirin.";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "İkinci ana göreviniz bir taverna inşa etmek.\n\nBinayı bir an önce inşa etmeye başlamalıyız.";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "Bir taverna inşa edin";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "Haberler iyi Lordum. Bazı Kasabalılar görevimiz konusunda bize yardım eli uzatmaya geldi. Onlara bir kasaba evi inşa etmelisiniz.";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "Bir kasaba evi inşa edin.";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "Tavernayı inşa edebilmek için alet yapım atölyesine ihtiyacımız var. Başlangıç için bir kömürcü inşa etmeyi öneriyorum.";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "Bir kömürcü kulübesi inşa edin.";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "Sıradaki ihtiyacımız olan bina, dökümcü. Böylece demir külçe üretimine başlayabiliriz.";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "Bir dökümcü inşa edin.";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "Lordum! Aletlerin üretimine başlamak için kasabada alet yapım atölyesinin inşa edilmesi gerekiyor.";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "Alet yapım atölyesi inşa edin.";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "Yiyecek stokları azalıyor Efendim. Bir Kasabalıya biraz balık tutmasını veya et avlamasını emretmelisiniz. Kasabalılar hızlıca biraz yemek yemezlerse daha az üretken hale gelecekler.";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "Biraz yiyecek üretin.";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "Lordum, naçiz tüccarınız olarak hizmetinizdeyim. İnşaat projeleriniz için altına ihtiyacınız olduğunu görebiliyorum.\nİsterseniz sizden biraz demir cevheri satın alabilirim.";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "Tüccar ile biraz mal ticareti yapın.";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "Paranız mı bitti Efendim? Sorun değil. Sizden biraz hayvan postu satın almak istiyorum.";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "Vali, biraz altın keseğine ihtiyacım var. Bana biraz satmak ister misiniz?";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "Lordum, pekiyi hissetmiyorum. Bir doktora görünmeliyim.";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "Hasta kasabalıları iyileştirin.";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "Yangın! Bir Kasabalı hemen yangını söndürmeli.";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "Yangını söndürün.";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "Haydutlar bizi burada bile rahatsız ediyor. Lordum, saldırı savunulana kadar nöbetçi kulelerinde birkaç Kasabalı görevlendirmeliyiz.";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "Kasabayı haydutlara karşı savunun.";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "Lordum, biraz dinlenip atıştırmalık yiyebilir miyiz?";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "Biraz ekmek üretin.";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "Lordum, bu mücadele için sadece birkaç Kasabalımız var. Onları uygun gördüğümüz yerlerde görevlendirmeli veya görevden almalıyız.";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "Tebrikler. Bu mücadelede ustalaştın.";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "Tüm görevleri çözmek için Kasabalıları kullanın.";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "İyi haberler var Lordum. Kalenin yanındaki yarımadada ağaçlar yeniden yetişti bile.\n\nKolayca odun elde edebilmek için oraya ormancı kulübesi inşa etmeyi öneriyorum.";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "Lordum, ormancı kulübesi tamamen çürümüş ve terk edilmiş!\n\nBu bölgedeki ağaçlar tamamen kesilmiş. Ormancı kulübesi artık hiçbir işe yaramaz. \nBir miktar odun elde etmek için artık ihtiyaç duyulmayan binaların hepsini yok etmenizi öneririm.";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "Ormancı kulübesini yıkın.";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "Lordum, sanırım bu köydeki insanlara sormalısınız. Bir miktar fazladan odunları olabilir.";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "Kral ilk tahta teslimatını bekliyor.\n\nKereste fabrikasında bir Kasabalı görevlendirip tahta üretmeye başlayabiliriz. Gözünüzü odun stokundan ayırmamanızı öneririm. ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "Kereste fabrikasında bir Kasabalı görevlendirin.";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "Nasıl gidiyor Vali? Toplamda üç teslimat bekliyorum.\n\nİlk teslimatı olabildiğince kısa sürede hazırlamalısınız. Beni hayal kırıklığına uğratmayın!";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "Malları krala teslim edin.";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "Lordum, Kral ilk tahta teslimatından memnun kaldı.\nSıradakini olabildiğince hızlı şekilde hazırlamalıyız.";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "Kral son teslimatı bekliyor. Tahtaları aldıktan sonra Kraliyet Filosu fark edilebilir büyüklükte genişletilebilecek.\n\nİşleri halletmeliyiz.";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "Teslimatın neden hâlâ Kralınızın elinde olmadığını merak ediyor musunuz? Şey, sanırım buna bir cevabım var.\n\nLafı dolandırmadan: bana bir miktar fidye öderseniz teslimatınız daha fazla aksaklık olmadan Krala ulaşır.";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "Fidyeyi ödeyin.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "Kraliyet filosunun inşaatı için çok fazla tahtaya ihtiyacım var.\nNe yazık ki uzun süredir hiç teslimat olmadı.\n\nVali, sizin için bir görevim var! Teslimatlar neden durduğunu öğrenin ve sorunu çözün!";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "İyi iş Vali. Size güvenebileceğimi biliyordum.\n\nSizin sayenizde filo kısa süre içinde hazır olacak.";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "Odun eksikliğine son verin ve krala yeterince tahta teslim edin.";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "Lordum, odunu akıllıca kullanmamızı öneririm!\n\nTüccarlardan odun satın alabilmek için bir pazar inşa edebiliriz.";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "Oduna mı ihtiyacınız var? Bence ikimizin de hemfikir olacağı bir anlaşma yapabiliriz. İsterseniz küçük bir odun yığınını hemen tedarik ede bilirim.\n\nGelip ne kadara ihtiyacınız varsa satın alın!";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "Tüccardan odun satın alın.";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "Lordum, düzenli odun teslimatına ihtiyacınız olacak.\n\nBir Esnaf Loncası inşa ederseniz birkaç takas emri verebilirsiniz.";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "Bir esnaf loncası inşa edin.";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "Esnaf loncasında alım ve satım yapmak için ticaret emirleri verebilirsiniz.\n\nOdun için ticaret emri verin Lordum.";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "Muhteşem! Ödeyecek paranız olduğu sürece tüm emirlerinizi tamamlayacağım.\n\nTicaret emirleriniz siz onları iptal edene kadar alınacak.";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "Odun satın almak için bir ticaret emri verin.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "Şehirde bir yangın çıktı! Yangını söndürüp yeni yangınların olma riskini azaltmak için yeterli yangın gözetleme kulesi inşa etmeliyiz.";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "%80'lik yüksek yangın gözetleme kulesi kapsaması elde edin.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "Haydutlar! Binalarımızı yok etmeye çalışıyorlar. Haydutlardan kurtulmak için kasabada daha fazla askere ihtiyacımız var, ayrıca daha fazla nöbetçi kulesi inşa etmeliyiz.";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "Yeterli nöbetçi kulesi inşa edin ve şehri yeterli sayıda askerle güvenceye alın.";
"T_GAME_QUEST_SCEN_WW_DISASTER_END_DESC" = "Başka bir hastalık daha! Böylesi büyük bir şehrin bir revire daha ihtiyacı var.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_DESC" = "Başka bir hastalık daha! Böylesi büyük bir şehrin bir revire daha ihtiyacı var.";
"T_GAME_QUEST_SCEN_WW_DISASTER_START_NAME" = "Bir revir inşa edin ve hastalığı iyileştirin.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_20_DESC" = "Lordum, sürekli dolu olduğu için Kasabalıların tamamı kiliseyi ziyaret edemiyor.\n\nTüm kasabalıları memnun etmek için daha fazla kiliseye ihtiyacımız var.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_30_DESC" = "Lordum, kasabalılar içecekleri için çok fazla beklemek zorunda kalıyorlar. Daha fazla tavernaya, meyve suyu ve içki üretimini artırmaya ihtiyacımız var.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_40_DESC" = "Bu şehirde hiç eğlence yok. Bir atlı mızrak alanı inşa etmeliyiz.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_END_DESC" = "Kasabalılar memnun. Ancak şimdi de lüks mallar istiyorlar.\n\nOnlara giysi veya mücevher tedarik edebiliriz.";
"T_GAME_QUEST_SCEN_WW_HAPPYNESS_START_DESC" = "Bazı Kasabalılar pazarın çok kalabalık olduğundan şikâyet ediyor.\n\nYeni bir pazar inşa etmeliyiz veya var olanı yükseltmeliyiz. Yoksa mutsuz Kasabalılar şehri terk edecek.";
"T_GAME_QUEST_SCEN_WW_MAIN_END" = "Beni hayal kırıklığına uğratıyorsunuz Vali. Hiçbir görevimi yerine getirememeniz çok kötü.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_01" = "Harika iş çıkardınız Valim, tek bir Kasabalı şehri terk etmeden tüm görevlerimi tamamladınız.\n\nÖdülünüzü ikiye katlayacağım.";
"T_GAME_QUEST_SCEN_WW_MAIN_SUCCESS_02" = "Vali, Kasabalılardan bazıları şehri terk etti. Sizden daha fazlasını beklerdim.\n\nEn azından tüm görevlerimi yerine getirdiniz. Ödülünüzü alacaksınız.";
"T_GAME_QUEST_SCEN_WW_POPULATION_150_DESC" = "Lordum, şehrimize daha fazla Kasabalı yerleştirmeliyiz yoksa Kral çok sinirlenecek.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_DESC" = "Ah hayır Lordum. Birçok Kasabalı şehri çoktan terk etti. Daha fazla kişinin buradan ayrılmasına izin veremeyiz.";
"T_GAME_QUEST_SCEN_WW_POPULATION_160_NAME" = "Nüfusu artırın.";
"T_GAME_QUEST_SCEN_WW_POPULATION_175_DESC" = "Lordum, bazı Kasabalılar şehri çoktan terk etti. Taşınmamaları için kasabalılarımıza daha iyi bakmalıyız.";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_DESC" = "Valim, Kasabalıların birçoğu bu küçük kasabaya taşındı.\n\nŞehri yeniden terk etmelerine engel olmak için tüm ihtiyaçlarını karşılayın. ";
"T_GAME_QUEST_SCEN_WW_POPULATION_END_NAME" = "Süre dolmadan önce nüfusunuzu artırın.";
"T_GAME_QUEST_SCEN_WW_POPULATION_START_NAME" = "Kral varmadan önce tüm görevleri tamamlayın ve nüfusu 150'nin üzerinde tutun.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_DESC" = "Lordum, bu şehirdeki taşıyıcıların hepsi çok çalıştı. Yeni bir depo satın alıp daha fazla taşıyıcı görevlendirmeliyiz.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_20_NAME" = "Yeni bir depo satın alın ve kalede daha fazla taşıyıcı görevlendirin.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_30_DESC" = "Yemeğimiz azalıyor. Hadi bir balıkçı kulübesi inşa edelim. Bu işe yarar.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_DESC" = "Lordum, küçük fırın yeterince ekmek üretmiyor. Onu yükseltip ilave bir fırıncı görevlendirebiliriz.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_35_NAME" = "Bir fırını 2. seviyeye yükseltin ve bir fırıncı daha görevlendirin.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_DESC" = "Su ihtiyacı büyük ölçüde arttı. Yeterli sayıda kuyu inşa ederek tüm Kasabalılara su tedarik edebiliriz.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_40_NAME" = "Şehirde birkaç kuyu inşaatı yapın.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_DESC" = "Lordum, yiyecek stoklarımızı artırmalıyız. İhtiyacımız olan şey yeni bir avcı kulübesi veya kasap dükkânı.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_END_NAME" = "Bir avcı kulübesi veya kasap dükkânı inşa edin.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_FINISHED" = "Harika iş Lordum, iyi bir tedarik oluşturduk. Yine de gözümüz Kasabalılarımızın isteklerinde olmalı.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_DESC" = "Lordum, ilk olarak bazı bina malzemeleri almalıyız ve nehrin karşısındaki ormancı kulübesinde bir Kasabalı görevlendirmeliyiz.\n\nKasabalının işine başlayabilmesi için nehrin üzerinden bir taş yol inşa edin.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME" = "Nehrin üzerinden bir taş yol inşa edin ve ormancı kulübesinde bir Kasabalı görevlendirin.";
"T_GAME_QUEST_SCEN_WW_PRODUCTION_START_NAME_NEW" = "Nehrin üzerinden bir yol inşa edin ve ormancı kulübesinde bir Kasabalı görevlendirin.";
"T_GAME_QUEST_SCEN_WW_TOWNIE_LEAVE_DESC" = "Buraya taşınmak yaptığım en büyük hataydı. Gidiyorum!\n\nLort, isteklerimizi gerçekten yerine getirmelisiniz yoksa daha da çok Kasabalı taşınacak.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_001" = "Hayır, teşekkürler.";
"T_GAME_QUEST_SILK_FLOWERS_ANSWER_002" = "Bu harika bir fikir.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_001" = "Yenilikçi bir zihniyetiniz olduğunu sanmıştım… Peki o zaman, sıradanlığınıza devam edin.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_A" = "Ah, şekil almaya başlıyor. Çabalarımıza devam edip üretimin kalanını hazırlamalıyız.";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_B" = "Lüks moda ve ev tekstilleri konusunda pazara hükmettik! Bir servet kazanacağız!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_DESC" = "Artık hammadde hazır olduğuna göre ilgili binalar gerekiyor. Bir dokumacı ve terzi iş görecektir!";
"T_GAME_QUEST_SILK_FLOWERS_CONSEQUENCE_002_START" = "Kararınızdan sonra köyünüzde harika değişiklikler olacak. Ancak bunların olması için… İyi durumda bir çiftlik ve koyunlar gerekiyor.";
"T_GAME_QUEST_SILK_FLOWERS_DESC" = "Sör, az önce yakındaki bir kasabadan döndüm. Çok güzel kumaş parçaları ve göz alıcı işlemeleri var. Bundan ilham alıp bizim de olağanüstü giysiler üretmemiz gerekiyor.";
"T_GAME_QUEST_SILK_FLOWERS_TITLE" = "Saten çiçekler";
"T_GAME_QUEST_SNEEZE_CONTEST_DESC" = "Polen mevsimi geri geldi, sakinler sürekli hapşırıyor. Bir hapşırma yarışması yapsak nasıl olur?";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_001" = "Her biri odaklanıyor ve sıraları geldiğinde en güçlü hapşırıklarını gösteriyorlar. Kazanan olarak seçilebilmesi için en beğendinizi seçmelisiniz!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_002" = "HAPŞI!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_003" = "HAPŞU!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_004" = "HUAPŞUA!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_005" = "İşte kazananımız geliyor! En başarılı hapşırık! Tebrikler! Mükemmeldi!";
"T_GAME_QUEST_SNEEZE_CONTEST_FINAL_006" = "Kasabalı ödülüyle gurur duyar. Bu yarışma size çok şey kazandırmadı ama belki de şehriniz tarihteki ilk hapşırık yarışmasını başlatmakla ünlü olacaktır!";
"T_GAME_QUEST_SNEEZE_CONTEST_NO_001" = "Hayatta olmaz.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_001" = "Kalabalığın köy meydanında çoktan toplandığını kaleden duyuyorsunuz. Ayrıca hapşırma da duyuyorsunuz. Yarışma çok eğlenceli olacak gibi görünüyor!";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_002" = "Birçok kasabalı sıralarda bekliyor ve siz ve danışmanınızdan oluşan jürinin karşısına çıktığında tüm güçleriyle bırakmak üzere hapşırıklarını tutuyor.";
"T_GAME_QUEST_SNEEZE_CONTEST_PLAZA_003" = "Bir kasabalı ardından diğerini değerlendiriyorsunuz. Üç kasabalının ismini yazdınız. Listeyi danışmanınıza veriyorsunuz, onları hapşırma yarışması finali için köy meydanının ortasına götürüyor!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_001" = "Şehre, köy meydanında bir yarışmanın düzenlendiğine dair haber yaymaya karar verdiniz. En iyi olarak seçilen kasabalı bir ödül kazanacak!";
"T_GAME_QUEST_SNEEZE_CONTEST_START_002" = "Sör, kasabalıların meydanda toplanmasını beklerken şenlikleri hazırlamalıyız! Hadi biraz dekorasyonla başlayalım.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_003" = "Şehri dekore edin.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_004" = "Bu, şehrimizi çok daha çekici hale getirir.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_005" = "Stoklarımızı da kontrol etmeliyiz.";
"T_GAME_QUEST_SNEEZE_CONTEST_START_006" = "Kusursuz, şenlikler sırasında ihtiyacımız olan her şeye sahip olacağız.";
