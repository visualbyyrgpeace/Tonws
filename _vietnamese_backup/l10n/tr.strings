"T_GAME_QUEST_DEFEND_TOWN2_DESC" = "Vali, haydutlar köye saldırıyor!\nEkonomimize ve binamıza gelecek hasarı en aza indirgemek için olabildiğince çok yağmacıyı geri püskürtmeliyiz!";
"T_GAME_QUEST_DEFEND_TOWN_DESC" = "Lordum,\nKasabalılar haydut saldırılarından korkuyor. Kasabalılara ve özellikle haydutlara kendimizi savunabileceğimizi göstermeliyiz!";
