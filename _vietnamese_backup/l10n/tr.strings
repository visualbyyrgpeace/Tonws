"T_RANDOM_EVENT_WITCHHUNT_ANALYZEBREAD_DESC" = "Doktor ekmekle bazı deneyler yapmak istiyor, özel ekmekten biraz verir misiniz lütfen?";
"T_RANDOM_EVENT_WITCHHUNT_ANALYZEBREAD_SUCCESS" = "Çok teşekkürler Sör. Ekmek teslim edilir edilmez soruşturmaya başlayacağım.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_01_DESC" = "“Lordum, köylüler bu cadı durumu konusunda çok öfkeli” diyor mütevazı danışmanınız. “Harekete geçilmesini talep ediyorlar. Hemen!" Huzursuz bir bakışla etrafına bakınır. "Onun gerçekten bir cadı olduğuna inanmıyorsunuz, değil mi?"";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_01_REPLY_01" = "Karar vermek için zamana ihtiyacım var.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_01_REPLY_02" = "Köylüler kaderlerine kendileri karar versin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_01_REPLY_03" = "Tam olarak ne oldu?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_02_DESC" = "Aniden kadın garip bir dilde mırıldanmaya başlıyor ve bir tür nöbet geçiriyor. Hareketleri ve iniltileri daha önce gördüğünüz hiçbir şeye benzemiyor…";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_02_REPLY_01" = "Onu muayene etmesi için doktoru çağırın.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_02_REPLY_02" = "Daha yakından bakmak istiyorum.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_02_REPLY_03" = "Ona bakmaları için keşişleri çağırın.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_03_DESC" = "Kadın kollarını kalabalığa sallarken yerde kıvranarak debeleniyor. Belirsiz bir mırıldanmayla devam ederken köylüler korku içinde uzaklaşır. İçlerinden birisi "Onu sürgün etmeliyiz" der. Güvenilir danışmanınız önce size sonra da kıza bakar. "Ona ne yapmalıyız?"";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_03_REPLY_01" = "Onu zindana atın.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_03_REPLY_03" = "Hadi herkesin fikrini alalım.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_04_DESC_01" = "Bir süre sonra doktor gelir. Bazı köylüler ona dik dik bakmaya çalışırken o morlukları inceler. Sizin için net bir cevabı yok. "Zehirlenmiş olabilir ama bu tuhaf seslerle söylediklerini açıklamıyor. Emin olamıyorum". ";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_04_DESC_02" = "Aniden etraftaki köylülerden biri çığlık atarak yere düşer, benzer nöbetler geçirir ve garip bir şekilde mırıldanmaya başlar. Kalabalık kaçışır. Diğerlerinden birisi "Yayılıyor!" diye bağırır. "Bir şeyler yapmalısınız Lordum."";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_04_REPLY_01" = "Onlarla doktor ilgilensin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_04_REPLY_02" = "Keşişler onları incelesin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_04_REPLY_03" = "Onları köyden sürün.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_05_DESC" = "Bir süre sonra manastırdan keşişler gelir. Kadın, din adamları tarafından iyice incelenir. Keşişlerden birisi size bakar ve alçak sesle konuşur: "Bu, köylüleri ele geçiren şeytani bir varlık olabilir Lordum!" Bir ritüel gerçekleştirmesi için bir vaiz veya tavsiye için bir doktor çağırabiliriz. Bir başka olasılık da köylülerin sorunu çözmesidir.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_05_REPLY_01" = "Dini bir ritüel isteyin!";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_05_REPLY_02" = "Tavsiye için doktoru çağırın.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_05_REPLY_03" = "Olay ile köylülerin ilgilenmesini sağlayın.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06A_DESC" = "Son zamanlardaki olaylar endişe verici. Bu işin aslını öğrenmeliyiz.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06_DESC" = "Doktorun muayene için ve solüsyon filtrelemek için bazı özel ekipmanlara ihtiyacı var.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06_DESC_01" = "Lordum, bazı simya solüsyonlarını filtrelemek için özel ekipmana ihtiyacım var.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06_DESC_02" = "Muayene için özel aletlere ihtiyacım var. Lordum, onları benim belirttiğim şekilde yapar mısınız lütfen?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06_REPLY_01" = "İhtiyaç duyduğu aletlerin verilmesini istiyorum.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_06_REPLY_03" = "Doktora özel filtre ekipmanı verin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_08_DESC" = "Birkaç gün geçer. Birdenbire tamamen farklı birisi önceki kadınla aynı belirtileri gösterir. Yine köylüler "cadı"yı sürgün etmek isterler ama onu kaleye getirmeye çalıştıklarında çoktan kötü bir durumdadır ve tamamen uyku halindedir.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_08_REPLY_01" = "Belki de şimdi bir doktora ihtiyacımız vardır.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_08_REPLY_02" = "Doktorun kurbanı muayene etmesine izin verin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_10_DESC" = "Köylüler kadının tuhaf davranışlarından bahsediyor. Çiftçi, "O bir bitki uzmanı" diyor, "Herkes hasta olduğunda ona geliyor. Yaklaşık bir haftadır tuhaf davranmaya başladı. Kendi kendine konuşuyor, evinde garip şeyler yapıyor."";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_10_REPLY_01" = "Öncesinde ne oldu?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_10_REPLY_02" = "Evde ne yapıyordu?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_10_REPLY_03" = "İzin verin kendisi konuşsun!";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_11_DESC" = "Çiftçi gözleri fal taşı gibi açılmış halde size bakar. "Pekâlâ, kasabadaki tarlaların hasadında hep birlikteydik ve sonrasında hasat festivali olmuştu".";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_11_REPLY_01" = "Hasat ile ilgili özel bir şey var mıydı?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_11_REPLY_02" = "Ziyafette ne oldu?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_11_REPLY_03" = "Kurbanlardan birisiyle konuşmak istiyorum.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_14_DESC" = ""Şey, bir gece evin içinde çığlık attığını duyduk. Sanki bir şeyler görüyormuş gibi… Lanetler ya da buna benzer bir şey" dedi çiftçi. "Geçen gün şeytani varlık onu ele geçirdiğinde, onu sarstığında ve humması başladığında evin önündeydi."";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_14_REPLY_01" = "Belki de bir şekilde zehirlenmiş olabilir mi?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_14_REPLY_02" = "O garipleşmeden önce ne oldu?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_15_DESC" = "Kurbandan sadece mırıldanma sesleri geliyor. Çok ateşi var ve çok terliyor. Gözlerini açtığında hiçbir yüze odaklanamıyor ve gözbebekleri oldukça büyük.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_15_REPLY_01" = "Doktoru çağırın!";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_15_REPLY_01A" = "Kurbanı inceleyin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_15_REPLY_03" = "Keşişler ne yapacağını bilebilir.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_16_DESC" = ""Pekâlâ" der çiftçi, "Bu yıl hasat orta halliydi. Hasatta alışılmadık bir miktar esmer buğday vardı. Değirmenci kışa ve ziyafete yetmediğini söyleyince esmer buğdayları da un için kullandı."";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_17_DESC" = "Fırıncı tüm ekmeği getirdikten sonra hasadı kutlamak için büyük bir ziyafet verdik. Hatta kahverengi buğdaydan pişirdiği yeni bir tür özel ekmek bile getirdi. Bu yıl bayram alışılmadık derecede çılgıncaydı. Köylülerin çoğu ertesi gün mide ağrısından şikâyetçi oldu ama genelde böyle bir ziyafet yapıldığında durum böyledir. Fırıncı tadının garip olduğunu düşündüğü için ekmeğin geri kalanını çöpe attı…";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_17_REPLY_01" = "Kahverengi buğdayı inceleyin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_17_REPLY_02" = "Hadi kadının evini kontrol edelim.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_18_DESC" = "Cadı oldukça fakir olduğu için fırıncı onu attıktan sonra "özel" ekmeğin bir kısmını kendisi almış gibi görünüyordu. Evinde hâlâ ekmeğin yenmemiş bir kısmını bulabilirsiniz.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_18_REPLY_01" = "Doktorun ekmeği incelemesine izin verin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_18_REPLY_02" = "İlginç.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_19_DESC" = "Doktor uzaktayken daha fazla köylü karın ağrısı ve nöbet geçirmekten şikâyetçi olur. Köylüler bir ilaç istiyor. Ne yapmalıyız?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_19_REPLY_01" = "Kalan ekmeği yok edin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_19_REPLY_02" = "Doktorun dönmesini bekleyin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_19_REPLY_03" = "Gerçekten ne olduğunu öğrenmemiz gerekiyor.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_DESC" = "Bir süre sonra doktor başkentten döner. İyi haberler getirir ve hemen öne atılır. "Bu büyücülük değil!" Hasattan gelen ergot hastalığı zehirlenmesi. Bunun bir daha olmayacağından emin olmak için kalan hasadı derhal yok etmeliyiz. Ergot hastalığı zehirlenmesi nöbetlere, halüsinasyonlara ve tamamen uyuşukluğa neden olabilir" dedi.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_DESC_2" = "Karar vermek zorundasınız, Lordum. Ya kalan hasadı saklarız ve bu ergottan daha fazlasını yetiştirmeye çalışırız ya da hasadın tamamını köylülerimiz için yok ederiz. Ne yapmayı önerirsiniz?";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_PART_01" = "Bir süre sonra doktor başkentten döner. İyi haberler getirir ve hemen öne atılır. "Bu büyücülük değil!"";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_PART_02" = "Hasattan gelen ergot hastalığı zehirlenmesi. Bunun bir daha olmayacağından emin olmak için kalan hasadı derhal yok etmeliyiz. Ergot hastalığı zehirlenmesi nöbetlere, halüsinasyonlara ve tamamen uyuşukluğa neden olabilir" dedi.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_PART_03" = "Lordum, bekleyin! Evet, bu ergot hasatta aşırı dozda alındığında tehlikeli olabilir. Ancak köylüler sadece küçük dozlarda tükettiklerinde oldukça rahat ve mutluydular. Belki de burada köylülerin refahı ve iyiliği için bir fırsatımız vardır.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_REPLY_01" = "Hasadın kalanını yok edin.";
"T_RANDOM_EVENT_WITCHHUNT_CHOICE_POPUP_20_REPLY_02" = "Belki de bu ergotun içinde güzel bir şeyler vardır. Onu saklayalım.";
"T_RANDOM_EVENT_WITCHHUNT_DESC" = "Ağlayan bir kadın birkaç köylü tarafından avluya sürüklenir. Ağrılı görünüyor ama başka zarar görmemiş. Köylüler, sözde cadı hakkında bir şeyler yapılmasını istiyor. Ona ne yapacaksınız?";
"T_RANDOM_EVENT_WITCHHUNT_END_DESTROYEVERYTHING" = "Hasat ve ergot mantarıyla ilgili tüm tedarikler yok edildikten sonra barış yavaş yavaş köye geri döndü.\n\n Bununla birlikte, tüm olay köy üzerinde olumlu bir etki yarattı. Köylüler artık işlerinde daha çalışkan ve daha az yorgunlar.";
"T_RANDOM_EVENT_WITCHHUNT_END_KEEP_DRUGS" = "Bundan böyle çiftçiler daha hızlı ergot hastalığı bulaşan buğdaylar ekecek. Hekim, şimdiden az miktarda yeni mucize ilacı içeren bir çözelti oluşturmaya başladı.\n\nBu, sakinlerin biraz daha mutlu ama aynı zamanda biraz daha tembel olmaları gibi kalıcı bir olumlu etkiye sahiptir.";
"T_RANDOM_EVENT_WITCHHUNT_EXORCISM_DESC" = "Lordum, kaderin iyileştirici gücünü hazırlamak için hâlâ malzemelere ihtiyacımız var. Bana uygun malzemeleri gönderebilir misiniz lütfen.";
"T_RANDOM_EVENT_WITCHHUNT_EXORCISM_SUCCESS" = "Ritüel, siz malzemeleri teslim eder etmez başlayacak. Çok teşekkür ederim Sör.";
"T_RANDOM_EVENT_WITCHHUNT_EXORCISM_SUMMARY" = "Ritüel için gerekli malzemeleri sağlatın";
"T_RANDOM_EVENT_WITCHHUNT_INTRO_01" = "Öfkeli köylüler kaleye gelir. Kalabalık, meşaleler ve dirgenler taşıyor. Kalabalığın lideri "Lort!", "Kasabada bir cadı bulduk!" der. Ağlayan bir kadın birkaç köylü tarafından avluya sürüklenir. Ağrılı görünüyor ama başka zarar görmemiş.";
"T_RANDOM_EVENT_WITCHHUNT_INTRO_02" = "Kalabalık lideri, "Bu cadının icabına bakılması gerekiyor, Lordum" diye bağırıyor. "Garip davranıyor. Ve kulübesinde bitki özleri bulduk! O bir cadı olmalı!”";
"T_RANDOM_EVENT_WITCHHUNT_MESSAGE_07" = "Doktor doğru araçlarla kızı muayene etmeye başlar. Dışarıdan bakıldığında her şey normal görünüyordur, ta ki doktor siyah parmakları ve ayakları olduğunu görene kadar.";
"T_RANDOM_EVENT_WITCHHUNT_MESSAGE_09" = "Çok teşekkürler Sör. Sayesinde kurbanın ağzında tanımlayabildiğim özel bir mantardan bir simya solüsyonu ürettim.";
"T_RANDOM_EVENT_WITCHHUNT_MESSAGE_12" = "Vaiz ve rahipler kurbanı kiliseye götürürler. Kutsal topraklarda aynı gece ritüeli gerçekleştirirler. Şarkıyı bütün gece duyabilirsiniz. Sabah keşişler dışarı çıkar ve kurbanın sükunet haline girdiğini bildirir.";
"T_RANDOM_EVENT_WITCHHUNT_MESSAGE_13" = "Muayeneden sonra doktor başkentteki üniversite ile iletişim kurması gerektiğini düşünüyor. Bir teorisi var ancak bunu çalışma arkadaşlarıyla netleştirmesi gerekiyor ve yolculuk için bazı ekipmanlar istiyor.";
"T_RANDOM_EVENT_WITCHHUNT_MESSAGE_13_SUCCESS" = "Yolculuk için ekipmanı alır almaz ayrılacağım. Geri dönmem uzun sürebilir. Dikkatli olun lordum.";
"T_RANDOM_EVENT_WITCHHUNT_PLAGUEFIRE" = "Lordum, köylüler çıldırıyor! Birçoğu hasta veya ne yaptıklarını bilmiyor. Yangınlar çıkarıyorlar.";
"T_RANDOM_EVENT_WITCHHUNT_QUEST_DESTROY_WHEAT_DESC" = "Buğday stoklarının yakılması ve depoların temizlenmesi gerekiyor.";
"T_RANDOM_EVENT_WITCHHUNT_QUEST_DESTROY_WHEAT_SUMMARY" = "Depolardaki buğdaydan kurtulun.";
"T_RANDOM_EVENT_WITCHHUNT_QUEST_DOCTORTRIP_SUMMARY" = "Doktorun yolculuğuna mali destek sağlayın.";
"T_RANDOM_EVENT_WITCHHUNT_SUMMARY" = "Kasabadaki cadı olayıyla ilgilenin.";
"T_RANDOM_EVENT_WITCHHUNT_THROWINDUNGEON_DESC" = "Lordum, emrinizle ilgili bir sorun var. Şu anda zindanda hiç yerimiz yok. Üzüm suyu mahzenindeki son selden beri onarılmadı. Yine de kale surlarının dışında geçici bir zindan inşa edebiliriz. Yeni bir hazine odası elverişli bir bina olur.";
"T_RANDOM_EVENT_WITCHHUNT_THROWINDUNGEON_SUCCESS" = "Peki, deliyi derhal yeni zindana götüreceğiz.";
"T_RANDOM_EVENT_WITCHHUNT_THROWINDUNGEON_SUMMARY" = "Uygun bir zindan inşa edin.";
