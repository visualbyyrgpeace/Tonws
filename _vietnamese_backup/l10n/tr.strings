"T_GAME_QUEST_BROTHER_BIRDS_ANSWER_004" = "Pekâlâ, bu kadarı yeterli, bu adamı şifacıya götürün.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_001" = "Ne demek istiyorsunuz? Erkek kardeşim bir kuş mu? Aklınızı kaybediyorsunuz.";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_002" = "Valinin size söylemeye çalıştığı şey ona güvenmeniz gerektiği, erkek kardeşiniz ne yaptığını biliyor. ";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_A_003" = "Siz öyle diyorsanız… Ona bir şey olursa sizi sorumlu tutacağım!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_B_002" = "Vali, ona biraz sakinleştirici verdik, şimdi uyuyor. Dağların üzerinden gitmesini sağlayabilecek bir teknik hakkında garip şeyler mırıldanıyordu, onu bana getirerek doğru şeyi yaptınız. Az daha sürse bize dünyanın yuvarlak olduğunu söylerdi!";
"T_GAME_QUEST_BROTHER_BIRDS_CONSEQUENCE_C_001" = "Sör! Sarayda bir haberciyle tanıştık, bize mucidimizin kesinlikle inanılmaz olduğunu ve icatları üzerinde çalışması için başkentte daha uzun süre kalmasını istediğini söyledi. Şehrin kültürel etkisi ilerledi! Kral bize biraz prestij göndermeye karar verdi.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_001" = "Lordum, size geliş sebebim erkek kardeşimin delirmiş olması. Bir kuş olduğunu ve uçabildiğini iddia ediyor! Aptalca bir şey yapmasından ve bir kuş gibi uçabildiğini kanıtlamak için fazla yükseğe tırmanmaya karar vermesinden korkuyorum.";
"T_GAME_QUEST_BROTHER_BIRDS_DESC_002" = "Ah Sör! Beni zindana yollamadığınız için teşekkür ederim! Kız kardeşim benim için çok fazla endişeleniyor. Keşfimle size sürpriz yapmak istedim! Uçabilen bir makine keşfettim! KUŞLAR GİBİ! Büyük yıllık panayırda onu başkentte sunmak istiyorum.";
"T_GAME_QUEST_BROTHER_BIRDS_TITLE" = "Kuş kardeş";
"T_GAME_QUEST_COVERAGE_DESC" = "Lordum, kasaba haydut saldırılarına karşı hazır değil!\nKöyün çoğunluğu nöbetçi kuleleriyle korunmuyor. Olabildiğince çok binayı koruması için nöbetçi kuleleri yerleştirmelisiniz.";
