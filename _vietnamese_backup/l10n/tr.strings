"T_LEGACY_BEER_DESC" = "Lort, köyü geliştirmeye devam etmek için bu hızı korumaya ne dersiniz. Tarım genişletilebilir. Bir şerbetçiotu işleme tesisi nasıl olur? Bu şerbetçiotu üretip işlememize olanak sağlar.";
"T_LEGACY_BEER_SUCCESS" = "Bravo Sör. Bundan sonra kasabamız kesinlikle güzel şerbetçiotlarıyla bilinecek.";
"T_LEGACY_COUNTRY_NEED_DESC" = "Lordum, az önce komşu ülkeden bir mesaj aldık. Kıtlık çekiyorlar ve yemeğimizi paylaşmamızı istiyorlar. Onlara gerekli hammaddeleri gönderelim mi?";
"T_LEGACY_COUNTRY_NEED_FAILED" = "Lordum, bu korkunç. Komşumuzdan haberler aldık. Kıtlık insanları sokaklara düşürmüş. İsyanlar ve birçok ölüm var. Oradaki Kral öldürülmüş… Ülkenin dengesi bozulmuş ve bize doğru gelen gruplarca mülteci var. Onlara yardım etmeliydik…";
"T_LEGACY_COUNTRY_NEED_ONLY_TIMER_TITLE" = "Komşularımıza yardım etmek için kalan süre:";
"T_LEGACY_COUNTRY_NEED_SUCCESS_001" = "Efendim, stokumuzda gerekli kaynaklar var. Şimdi tek yapmamız gereken komşularımıza yardım etmek için malları teslim etmek. Zaman tükeniyor!";
"T_LEGACY_COUNTRY_NEED_SUCCESS_002" = "Sör, komşu ülke bize içtenlikle teşekkür ediyor! Onları açlıktan kırılmaktan kurtardığımıza inanıyorum. Bu iyiliği yapmasak ne olurdu kim bilir?";
"T_LEGACY_COUNTRY_NEED_TITLE" = "Komşu ülkeye yardım edin.";
"T_LEGACY_DECO_DESC" = "Lanet olsun Vali! Etrafınıza baksanıza! Bir şey fark ediyor musunuz?\n\nEVET, aynen! Dekorasyonlar nerede? Her şey çok sıkıcı görünüyor! Acele edin ve Kral şehre ulaşmadan önce dekorasyonlar inşa edin.";
"T_LEGACY_DECO_SUCCESS" = "İşte, böylesi çok daha iyi! İyi ki böyle basit şeyleri size hatırlatmak için varım.";
"T_LEGACY_FISHER_HUNTER_HUT_DESC" = "Sör, nihayet sizi buldum. Köyümüz için ekmeğin yanında gerçekten bir yiyecek kaynağı daha iyi olur. Bir avcı kulübesinin yanında bir balıkçı kulübesi nasıl olur? Bu daha dengeli bir şekilde beslenmemize olanak sağlar.";
"T_LEGACY_FISHER_HUNTER_HUT_SUCCESS" = "Lordum, nezaketiniz için teşekkürler. Artık beslenmemizi iyileştirmek için yeterli yiyecek kaynağımız var. Bunun sonucunda sakinler daha sağlıklı bir hayat yaşayabilecekler.";
"T_LEGACY_FISHER_HUNTER_HUT_TITLE" = "Bir balıkçı kulübesi ve avcı kulübesi inşa edin.";
"T_LEGACY_HOUSE_DESC" = "Üstlenmek üzere olduğumuz işi göz önüne aldığımızda ilave bir kasaba evi inşa etmek akıllıca olur.";
"T_LEGACY_HOUSE_SUCCESS" = "Böylesi daha iyi! Bu yeni ev ayrıca ek bir gelir kaynağı olacak.";
"T_LEGACY_INTRODUCTION_001_DESC" = "Vali, sizi bu köyde içtenlikle karşılıyorum. Şu anda sadece ufak bir kasaba ama bu yeri geliştireceğinize eminim Sör.";
"T_LEGACY_INTRODUCTION_002_DESC" = "Refahtan bahsetmişken sizin için önemli bir işim var. Görebildiğiniz gibi ben artık pek genç değildim ve önümde uzun yıllar olsa da yakında buradaki zamanım dolacak.";
"T_LEGACY_INTRODUCTION_003_DESC" = "Buradaki saltanatımdan gelecek nesillere ilham verebilecek bir iz bırakmak istiyorum. Birkaç fikrim var ama onları gerçeğe çevirmek için yardımınıza ihtiyacım var.";
"T_LEGACY_INTRODUCTION_004_DESC" = "Size hayatımdaki anılardan bahseden mektuplar göndereceğim. Her bir hatıra sizin için bir görevin konusu olacak. Beni hayal kırıklığına uğratmayın. Son mektup gönderildiğinde köye gelip sizi ziyaret edeceğim.";
"T_LEGACY_LETTER_001_DESC" = "İnsanlarına daha yakın olarak onlara daha iyi şekilde yardım edebiliyordu. Bu yüzden diğer topraklardan hikâyeler ve efsanelerin anlatılabilmesi için şehirde bir taverna inşa edilmesini istiyor.";
"T_LEGACY_LETTER_001_DESCRIPTION_001_DESC" = "İlk mektup geldi. Sör, bu çok ilginç! İyi kalpli Kralımız henüz bir gençken babası her Kasabalı bireyin görevini anlayabilmesi için onu halkın arasına katılmaya zorlamış.";
"T_LEGACY_LETTER_001_DESCRIPTION_002_DESC" = "Bu yüzden her hafta halkının yeni bir mesleğini keşfetmiş. Bir hafta oduncu, sonraki hafta balıkçı veya hancı. Sonrasında halkının ihtiyaçlarını daha doğru şekilde hesaplayabilmiş. Bu olağanüstü Lordum!";
"T_LEGACY_LETTER_001_DESCRIPTION_003_DESC" = "Özellikle hancılık mesleği onun için zor olmuştu. İlk olarak sadece partiler ve içkiler olacağını düşünmüştü, bu yüzden çok daha fazlası olduğunu gördüğünde kendisini oldukça yoksun hissetmişti.";
"T_LEGACY_LETTER_001_DESCRIPTION_004_DESC" = "Taverna resmi olmayan tartışmalara olanak sağlardı. Felsefeden, yabancı gezginlerin anlattığı hikâyelere kadar her şey bir merak ve düşünce kaynağıydı.";
"T_LEGACY_LETTER_001_SUCCESS" = "Harika Sör! Sakinler bu hayat dolu ve sıcak yerden çok mutlu. Böylece uzun kış akşamları daha keyifli geçecek.";
"T_LEGACY_LETTER_002_DESC" = "İş yapmamızın bize en büyük hazineyi getirebileceği söyleniyor. Kral, atalarını onurlandırmak için topraklarımızda üzüm bağları inşa etmenizi emretti. Daha önce bir yer düşündünüz mü?";
"T_LEGACY_LETTER_002_DESCRIPTION_001_DESC" = "İkinci mektup henüz elimize ulaştı. Kral bize güney üzüm bağlarındaki çocukluğundan bahsediyor. Yaz boyunca büyükannesiyle buluşmak için sık sık oraya gidermiş. ";
"T_LEGACY_LETTER_002_DESCRIPTION_002_DESC" = "Ona birçok öyküler anlatırmış. Onu en çok etkileyen işin önemini öğrendiği çiftçi ve oğullarıyla ilgili olanmış. ";
"T_LEGACY_LETTER_002_SUCCESS" = "Kral köyümüzde üzüm bağları gördüğüne gurur duyuyor. Buradaki çiftçiler ona çok iyi bakacak.";
"T_LEGACY_LETTER_003_DESC" = "Bu yüzden Kral, bize bir depo inşa etmemiz ve mesajı insanlara yaymamız emrini verdi. Böylece bizim stoklarımız dolu olup onlarınkisi boş olduğunda dostlarımıza yardım edebiliriz.";
"T_LEGACY_LETTER_003_DESCRIPTION_001_DESC" = "Başka bir mektup daha geldi. Burada Kral o henüz on yaşındayken meydana gelen bir kıtlıktan bahsediyor. Tüm krallık bundan etkilenmiş. ";
"T_LEGACY_LETTER_003_DESCRIPTION_002_DESC" = "Kraliyet ailesi ipleri eline alıp yardım istemek için tüm komşu ülkelere diplomatlar göndermeye karar vermiş. ";
"T_LEGACY_LETTER_003_DESCRIPTION_003_DESC" = "Kimse Krala yardım etmek istememiş. Diğer ülkelerin çoğu kendi mücadeleleriyle ilgilenmiş. Yine de Kral ümidini yitirmemiş. Sonunda yardım edecek bir krallık bulmuş. Hatta bolca yiyecek kaynakları varmış ve diğer krallıklarda cömertçe paylaşmışlar.";
"T_LEGACY_LETTER_003_DESCRIPTION_004_DESC" = "Hikâyenin ana fikri, yardım etmesi için her zaman sizden daha küçük birine ihtiyaç duymanız. Nüfusun ihtiyacı olan başkalarına yardım etmeye istekli olması Kral için önemli. Bu nedenle, ihtiyaç halinde paylaşabilmek için malları refah zamanlarında stoklamak kaçınılmazdır.";
"T_LEGACY_LETTER_003_SUCCESS" = "Yeni depo mükemmel! Artık beklenmeyen durumlar karşısında gerekli her tür maldan geniş stoklarda depolayabiliriz.";
"T_LEGACY_LETTER_004_DESC" = "Görevimiz dileğinin gerçekleşmesi için şehrimize Kralın bir heykelini dikmek.";
"T_LEGACY_LETTER_004_DESCRIPTION_001_DESC" = "Sör, bir mektup aldım. Kraldan geliyor. Taç giyme töreninde büyük bir kutlama gerçekleşmiş. Krallığının şehirlerindeki tüm valiler sarayda toplanmış.";
"T_LEGACY_LETTER_004_DESCRIPTION_002_DESC" = "Ama onun hayali herkese eşit olarak davranabilmek için tüm şehir ve köylerde aynı anda bulunmakmış. Elbette bu fiziksel olarak mümkün değil. Ama her bir şehre bir heykel yerleştirilirse dileği gerçekleşmiş olurmuş.";
"T_LEGACY_LETTER_004_SUCCESS" = "Ne harika! Kral çok sevinecek. Onun onuruna gerçekten muhteşem bir anıt!";
"T_LEGACY_LETTER_004_TITLE" = "Kralın bir heykelini inşa edin.";
"T_LEGACY_LETTER_005_BOOK_HERE" = "Lordum, kitap tamamlandı. Sevgili Kralımız çok sevinecek.";
"T_LEGACY_LETTER_005_DESC" = "Bunu yapmak için keşişlerin üzerine yazabilmesi için yeterli miktarda post toplamalıyız. Hadi hemen başlayalım!";
"T_LEGACY_LETTER_005_DESCRIPTION_001_DESC" = "Sör, son mektup az önce geldi. Kral, bu dünyanın en büyük şahsiyetlerini ve daha sonra dünyanın dört bir yanına yayılan, birlikte paylaştıkları anıları kitaplarda yazıyor. ";
"T_LEGACY_LETTER_005_DESCRIPTION_002_DESC" = "Kral hatıralarının bir kitaba yazılmasını diliyor. Bir kitap oluşturmak oldukça zor ama bence bu Majestelerini çok mutlu eder.";
"T_LEGACY_LETTER_005_SUCCESS" = "Kitabın yazımı başlayabilir! Keşişlerimiz, Kralın gelişine kadar kitabın hazır olduğundan emin olacak. Bu çok heyecan verici! Bu kitap sayesinde muhtemelen dünyanın her yerinde ünlü olacağız!";
"T_LEGACY_LETTER_005_TITLE" = "Kralın hatıralarını içeren bir kitap oluşturun.";
"T_LEGACY_LETTER_006_DESCRIPTION_001_DESC" = "Sör! Kral geliyor! Umarım yanlış bir şey yapmamışızdır da çabalarımız için teşekkür eder.";
"T_LEGACY_LETTER_006_DESCRIPTION_002_DESC" = "Selamlar Vali. Görüyorum ki yokluğumda şehriniz gayet büyümüş. Ah! Orada çok güzel bir heykeliniz var! Ve bu üzümler! Büyükanneminkilere benziyor!";
"T_LEGACY_LETTER_006_SUCCESS" = "Tüm mektuplarım göz önüne alınmış, özellikle de çok istediğim kitap. Mükemmel! Artık bilgilerimin yok olmayacağını kesinleştirerek nihayet emekliliğimin tadını çıkarabilirim.";
"T_LEGACY_MAINQUEST_DESC" = "Mirasımın hatırlanabilir olması için size güveniyorum, beni takip etmek isteyenler için her anıyı akıl verici bir derse dönüştürün.";
"T_LEGACY_MAINQUEST_SUCCESS" = "Vali, bu muhteşem çalışma için teşekkürler, oldukça dikkatli davrandınız ve tüm isteklerim göz önüne alındı. Sizinle gurur duyuyorum. Tüm Krallık size büyük minnet borçlu.";
"T_LEGACY_MAINQUEST_TITLE" = "Krala görevinde yardım edin.";
"T_LEGACY_MINE_DESC" = "Lordum, yeni binalar inşa etmek için büyük miktarda hammadde kullandığımız için kısa süre içinde tükenecekler. Bir maden inşa edelim mi?";
"T_LEGACY_MINE_SUCCESS" = "Tebrikler Lort Vali. Artık köydeki diğer inşaat projelerini sakince halletmek için uygun miktarda hammaddemiz var.";
"T_LEGACY_SECURITY_DESC" = "İyi günler Sör. Ben Kralın bir habercisiyim ve gelişi için köyde her şeyin hazır olduğundan emin olmam emredildi.\n\nBU da ne? Köyünüz hiç güvenli değil! Derhal bir yangın kulesi inşa edin! Bir yangın çıksa ne olabilir hayal etsenize?!";
"T_LEGACY_SECURITY_SUCCESS" = " Böylesi çok daha iyi! Ne olabileceğini hiçbir zaman bilemezsiniz. Beni dinleyerek doğru şeyi yaptınız.";
"T_LEVELENDSCENE_BUTTON_NEXT" = "Sıradaki senaryo";
"T_LEVELENDSCENE_COMPLETE_DESC" = "Tebrikler, tüm görevleri tamamlayarak bu senaryoyu başarıyla bitirdiniz!";
"T_LEVELENDSCENE_COMPLETE_TITLE" = "Senaryo tamamlandı!";
"T_LEVELENDSCENE_FAILED_DESC" = "Senaryo başarısızlıkla sonuçlandı. Ana görevi tamamlamakta başarısız oldunuz…";
"T_LEVELENDSCENE_FAILED_TITLE" = "Senaryo başarısızlıkla sonuçlandı!";
"T_LEVELSELECTION_ENABLE_BANDITS_QUESTION" = "Bu haritada haydut saldırılarına izin verilsin mi?";
"T_LEVELSELECTION_PROPERTIES_BANDITS_ENABLED" = "Haydutlar aktif";
"T_LEVELSELECTION_PROPERTIES_DIFFICULTY" = "Zorluk";
"T_LEVELSELECTION_PROPERTIES_MAPSIZE" = "Harita boyutu";
"T_LEVELSELECTION_PROPERTIES_MILITARY_ENABLED" = "Askeri harita";
