"T_GAME_QUEST_DESIRES_15_SUCCESS" = "Çok teşekkürler hayatım!";
"T_GAME_QUEST_DESIRES_16_START" = "Ufak bir ziyafet vermek istiyorum.\nBu yüzden meyve suyu ve ekmeğe ihtiyacım var.";
