"T_SCENARIO_2016_06_BANDIT_01_DESC" = "Demek altın keseklerimi çalıyorsunuz? Pekâlâ, karşılığında başınıza geleni göreceksiniz. ÇIIIIIIIĞĞĞĞ!";
"T_SCENARIO_2016_06_BANDIT_025_DESC" = "Laftan anlamayan insanlara ne olur biliyor musunuz?! ÇIIIIIIIĞĞĞ!";
"T_SCENARIO_2016_06_BANDIT_02_DESC" = "O ekmeği nereden aldınız? Her neyse, ben de biraz istiyorum! Yoksa başka bir çığ daha mı istiyorsunuz?";
"T_SCENARIO_2016_06_BANDIT_02_NAME" = "Haydudun isteklerini yerine getirin.";
"T_SCENARIO_2016_06_BANDIT_03_DESC" = "Ah, burada çok fazla demir var. Eminim bunlardan benim için birkaç alet yapmak istersiniz.";
"T_SCENARIO_2016_06_BANDIT_04_DESC" = "Ne beceriklisiniz, altın keseklerini eritip külçeye çevirdiniz. Size zaten onun "benim" altınım olduğunu ve hemen geri istediğimi söylemiştim! Ah, ayrıca onları biraz daha rafine edin olur mu?";
"T_SCENARIO_2016_06_BANDIT_05_DESC" = "Yeni kıyafetler almayı düşünüyordum. Bana uyan bir şeyleriniz var mı?";
"T_SCENARIO_2016_06_INTRO_01_DESC" = "En azından kasabalılar çığdan kaçabildi ama çığın vurduğu binalar yıkıldı.";
"T_SCENARIO_2016_06_MAIN_00_DESC" = "Bu köyden sürekli gelen teslimatlar durdu. Vali, bu sorunla ilgilenmenizi bekliyorum.";
"T_SCENARIO_2016_06_MAIN_00_END" = "Çığ tehditleri sizin için hiç sorun olmadı. Valim, size güvenebileceğimi biliyordum.";
"T_SCENARIO_2016_06_MAIN_00_NAME" = "Ana görevleri tamamlayın ve madenlerle ilgilenin.";
"T_SCENARIO_2016_06_QUEST_00_DESC" = "Depoyu onarmalıyız, yoksa o da yıkılacak.";
"T_SCENARIO_2016_06_QUEST_00_NAME" = "Depoyu onarın.";
"T_SCENARIO_2016_06_QUEST_01_DESC" = "Kasabanın binalarını yeniden inşa etmek için ilk olarak bir kereste fabrikasına ihtiyacımız var.";
"T_SCENARIO_2016_06_QUEST_01_NAME" = "Bir kereste fabrikası inşa edin.";
"T_SCENARIO_2016_06_QUEST_02_DESC" = "Lordum, çığ tehlikelerine rağmen demir ve altın üretimine yeniden başlamamız gerekiyor. Kral bu köyden gelecek büyük bir teslimat bekliyor.";
"T_SCENARIO_2016_06_QUEST_02_NAME" = "Madencilerinize demir ve altın cevher için kazı yaptırın.";
"T_SCENARIO_2016_06_QUEST_03_DESC" = "Bir dökümcü madenlerin yakınına yerleştirildiğinde daha etkili olur ama bir çığ olması durumunda o da hasar görür. Lordum, akıllıca karar verin.";
"T_SCENARIO_2016_06_QUEST_04_DESC" = "Harika Lordum. Kral kaybolan teslimatlar için yenisini bekliyor. Büyük bir haraç ödemesi yapmalıyız.";
"T_SCENARIO_2016_06_QUEST_04_NAME" = "Krala haraç ödeyin.";
"T_SCENARIO_2016_06_QUEST_05_DESC" = "Lordum, üretim çok yavaş. Daha fazla maden ile cevher çıkarma hızını artırabiliriz.";
"T_SCENARIO_2016_06_QUEST_06_DESC" = "Kömürümüz azalıyor. Bir kömürcü kulübesi inşaatının emrini vermelisiniz.";
"T_SCENARIO_2016_06_QUEST_10_DESC" = "Lordum, ilave haraç ödemek için altın külçeler üretmeliyiz. Kral çok memnun olacak.";
"T_SCENARIO_2016_06_QUEST_AVALANCHE_00_DESC" = "Lordum dikkat edin! Başka bir çığ daha, ne korkunç!";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_DESC" = "Lordum, birçok maden çöktü bile. Kral, onları yeniden inşa etmek için emir verdi.";
"T_SCENARIO_2016_06_QUEST_KEEP_MINE_ALIVE_02_NAME" = "Daha fazla maden inşa edin.";
"T_SCENARIO_2016_06_QUEST_SIDE_025_DESC" = "Eşim çığların bize zarar vermemesi için dua etmek istiyor. Bize bir kilise inşa eder misiniz?";
"T_SCENARIO_2016_06_QUEST_SIDE_02_DESC" = "Lordum, yeniden inşa etmek için çok fazla oduna ihtiyacımız olduğunu biliyorum ancak ailemin hiç yakacak odunu kalmadı ve hava çok soğuyor. Bize yardım edebilir misiniz?";
"T_SCENARIO_2016_06_QUEST_SIDE_03_DESC" = "Karda yürümek çok zor. Birkaç taş yol işe yarayabilir.";
"T_SCENARIO_2016_06_QUEST_SIDE_045_DESC" = "Vali, bu bölgede buğday yetiştiremeyiz. Ancak ekmeği pazardan alabiliriz. Ya da sadece buğdayı alıp kendi ekmeğimizi pişirebiliriz.";
"T_SCENARIO_2016_06_QUEST_SIDE_04_DESC" = "Her zaman yalnızca balık ve et. Lordum, değişiklik olsun diye biraz ekmek yiyemez miyiz?";
"T_SCENARIO_2016_06_QUEST_SIDE_04_NAME" = "Kasabalılarınızın isteklerini yerine getirin.";
"T_SCENARIO_2016_06_QUEST_SIDE_05_DESC" = "Giysilerimiz sert hava koşullarından dolayı yırtılıyor. Gerçekten yeni giysilere ihtiyacımız var.";
"T_SCENARIO_2016_06_QUEST_SIDE_06_DESC" = "O paslı aletler neredeyse elimizde parçalanıyor. Sanırım demire ihtiyacınız var ancak birazını yeni aletler için kullanmak bize gerçekten yardımcı olur.";
"T_SCENARIO_2016_06_QUEST_SIDE_07_DESC" = "Bu karlı bölgede en küçük şey bile bizi mutlu eder. Lordum, çok meşgul değilseniz kasabamızı güzelleştirir misiniz lütfen?";
"T_SCENARIO_2016_10_BANDIT_01_DESC" = "Adamlarım! Saldırıyı başlatın!";
"T_SCENARIO_2016_10_BANDIT_04_DESC" = "Tüccarı mı arıyorsunuz? Şey, kayboldu ve bir şekilde kendini bağlanmış halde kampımda buldu. Merak etmeyin, durumu iyi. Yalnızca bize ufak bir bağış yaparsanız yeniden özgür olacak.";
"T_SCENARIO_2016_10_BANDIT_04_END" = "Pekâlâ, tüccarın gitmesine izin vereceğiz. Onunla ticaret yapın da yeniden çalmak için daha fazla şeyim olsun.";
"T_SCENARIO_2016_10_BANDIT_04_NAME" = "Tüccarın yeniden serbest kalması için fidyeyi ödeyin.";
"T_SCENARIO_2016_10_BANDIT_END_DESC" = "Haydutlar! Hadi buradan kaçalım! Buna taktiksel bir geri çekilme diyoruz. Zaten yeterince çaldık.";
"T_SCENARIO_2016_10_BANDIT_TIMER_10_DESC" = "Kamplarımızdan birisini mi yıktınız? Bunu yaparak bize sadece meydan okuyorsunuz. Kasabaya saldırın millet!";
"T_SCENARIO_2016_10_HAPPYNESS_DESC" = "Ah hayır Lordum! Kasabalılar mutsuz ve vergileri ödeme konusunda istekli değiller. Yeniden vergi kazanmak için isteklerini yerine getirmeliyiz.";
"T_SCENARIO_2016_10_HAPPYNESS_NAME" = "Yeniden vergi kazanmak için mutluluğu artırın.";
"T_SCENARIO_2016_10_MAIN_00_DESC" = "Vali, çok fazla paraya ihtiyacım var. Gelişen bir ekonomi kurun ve haraç ödeyin. Ancak dikkat edin, bu bölgede çok fazla haydut var. Krallığın tamamı size güveniyor.";
"T_SCENARIO_2016_10_MAIN_00_END" = "Harika iş Valim. Size güvenebileceğimi biliyordum. Ödüllendirileceksiniz ve daha fazla ün kazanacaksınız.";
"T_SCENARIO_2016_10_NEED_BREAD_DESC" = "Lordum, depo stoklarında ekmek azaldı. Bu insanları mutsuz ediyor.";
"T_SCENARIO_2016_10_NEED_BREAD_NAME" = "Mutluluğu artırmak için yeterli ekmek bulundurun.";
"T_SCENARIO_2016_10_NEED_BREW_DESC" = "Lordum, memnuniyetsizlik yayılıyor. İnsanlar içkiyi özlüyor.";
"T_SCENARIO_2016_10_NEED_BREW_NAME" = "Kasabalılardan gelecek bir greve engel olmak için stokta yeterli içki bulundurun.";
"T_SCENARIO_2016_10_NEED_CARPENTER_DESC" = "Marangozun işi başından aşkın. Efendim, birçok binanın onarılması gerekiyor. Daha fazla marangoz inşa etmeyi öneririm.";
"T_SCENARIO_2016_10_NEED_CARPENTER_NAME" = "Mutluluğu artırmak için bir marangoz dükkânı inşa edin.";
"T_SCENARIO_2016_10_NEED_CLOTHS_DESC" = "Giyecek hiçbir şeyim yok. Daha fazla giysi ve elbiseye ihtiyacımız var.";
"T_SCENARIO_2016_10_NEED_CLOTHS_NAME" = "Mutluluğu artırmak için stokta yeterli giysi bulundurun.";
"T_SCENARIO_2016_10_NEED_FIREWATCH_DESC" = "Sör, yangın gözetleme kuleleri yeterince bina korumuyor, daha fazla inşa etmeliyiz.";
"T_SCENARIO_2016_10_NEED_FISH_DESC" = "Bu köyde yeterli balığımız bile yok. Vergi falan ödemeyeceğim!";
"T_SCENARIO_2016_10_NEED_FISH_NAME" = "Bir grev olma olasılığını azaltmak için depoda yeterince balık stoklayın.";
"T_SCENARIO_2016_10_NEED_JEWELRY_DESC" = "Eşime daha fazla mücevherle sürpriz yapmak istiyorum. Bu şehirde hiç bulamamam çok kötü.";
"T_SCENARIO_2016_10_NEED_JEWELRY_NAME" = "Kasabalıların grev yapmasına engel olmak için stokta yeterince mücevher bulundurun.";
"T_SCENARIO_2016_10_NEED_JOUSTING_DESC" = "Bu kasabada yapacak pek bir şey yok. Yeterince eğlence yok. Sanırım eğlence binalarının sayısını artırma zamanı geldi.";
"T_SCENARIO_2016_10_NEED_JUICE_DESC" = "Canım meyve suyu çekiyor. Yeniden meyve suyu tedarik edebilir misiniz?";
"T_SCENARIO_2016_10_NEED_JUICE_NAME" = "Mutluluğu artırmak ve bir grev olmasını engellemek için meyve suyu stoklayın.";
"T_SCENARIO_2016_10_NEED_MEAT_DESC" = "Kasabada yine hiç et yok. Ne zaman elimize biraz geçecek?";
"T_SCENARIO_2016_10_NEED_MEAT_NAME" = "Mutluluğu artırmak ve bir grev olmasını engellemek için yeterli et bulundurun.";
"T_SCENARIO_2016_10_NEED_MEDICUS_DESC" = "Vali, kasabada bu kadar çok insan varken hepsiyle ilgilenemiyorum. Hepsine yardım edeceksem desteğe ihtiyacım var.";
"T_SCENARIO_2016_10_NEED_MEDICUS_NAME" = "Kasabada bir greve engel olmak için bir revir inşa edin.";
"T_SCENARIO_2016_10_NEED_TAVERN_DESC" = "Tavernamızda hiç yer yok. Çok kalabalık. Yeni vali parayı ihtiyaçlarımız için harcamak yerine boşa harcıyor.";
"T_SCENARIO_2016_10_QUEST_00_DESC" = "Lordum, ilk olarak ekonomimiz için temel binaları inşa etmeliyiz. İlave bir balıkçı kulübesi ve bir kereste fabrikası öneriyorum.";
"T_SCENARIO_2016_10_QUEST_00_NAME" = "Bir kereste fabrikası ve balıkçı kulübesi inşa edin";
"T_SCENARIO_2016_10_QUEST_01_DESC" = "Kaynakları hızlıca toplamak için yakına bir maden inşa edebiliriz.";
"T_SCENARIO_2016_10_QUEST_01_NAME" = "Bir maden inşa edin.";
"T_SCENARIO_2016_10_QUEST_02_DESC" = "İnsanlar şimdi ekmek istiyor. Onları ya kendimiz üretebiliriz ya da pazardan satın alabiliriz. Yine de her zaman yeterli ekmek bulundurduğumuzdan emin olmalıyız.";
"T_SCENARIO_2016_10_QUEST_02_NAME" = "Yeterli ekmek bulundurun.";
"T_SCENARIO_2016_10_QUEST_03_DESC" = "İçkimiz bile yok. İçki gibi basit bir içkiyi bile alamayacaksak ne diye vergi ödüyorum?";
"T_SCENARIO_2016_10_QUEST_03_NAME" = "Depoda yeterli içki bulundurun.";
"T_SCENARIO_2016_10_QUEST_04_DESC" = "Lordum, insanlar her türden yemek yemek istiyor. Yalnızca balık ve ekmek yeterli değil, et de istiyorlar.";
"T_SCENARIO_2016_10_QUEST_04_NAME" = "Depoda yeterli et stoku olduğundan emin olun.";
"T_SCENARIO_2016_10_QUEST_05_DESC" = "Yalnızca bir elbiseden daha fazlasına sahip olmak harika olurdu. Lütfen bu iyiliği yapar mısınız Bay Vali?";
"T_SCENARIO_2016_10_QUEST_05_NAME" = "Giysi stoku yapın.";
"T_SCENARIO_2016_10_QUEST_06_DESC" = "Şehir büyüdüğü için gittikçe daha fazla soylu yerleşiyor. Meyve suyu içmek istiyorlar.";
"T_SCENARIO_2016_10_QUEST_06_NAME" = "Depoda yeterli meyve suyu bulundurun.";
"T_SCENARIO_2016_10_QUEST_07_DESC" = "Harika bir şehir. Ancak bazı lüks eşyalar eksik. Mücevher sunar mısınız lütfen?";
"T_SCENARIO_2016_10_QUEST_07_NAME" = "Depoda mücevher depolayın.";
"T_SCENARIO_2016_10_QUEST_10_DESC" = "Kasabalılar bir kilise istiyor.";
"T_SCENARIO_2016_10_QUEST_11_DESC" = "Lordum, insanlarımızı daha mutlu etmek için bir taverna istiyoruz.";
"T_SCENARIO_2016_10_QUEST_12_DESC" = "Lordum, insanlarımız için bir panayır alanı inşa etmeliyiz.";
"T_SCENARIO_2016_10_QUEST_13_DESC" = "İnsanlarımız yangın güvenliği konusunda endişe ediyor. Bir yangın gözetleme kulesi inşa etmeliyiz.";
"T_SCENARIO_2016_10_QUEST_14_DESC" = "Vali, şehirde zaten yetenekli bir doktor var mı?";
"T_SCENARIO_2016_10_QUEST_14_NAME" = "Bir revir inşa edin.";
"T_SCENARIO_2016_10_QUEST_15_DESC" = "İnsanlarımızın mutluluğunu artırmak için bir atlı mızrak alanı inşa etmeliyiz.";
"T_SCENARIO_2016_10_QUEST_16_DESC" = "Lordum, şehir çok güzel büyüyor. Tüm binaların iyi durumda kalmasını sağlamak için bir marangoz dükkânı inşa etmeliyiz.";
"T_SCENARIO_2016_10_QUEST_20_DESC" = "Haydutlara karşı bir şey yapmazsak sevgili evlerimizi ve eşyalarımızı bizden alacaklar.";
"T_SCENARIO_2016_10_QUEST_21_DESC" = "Zaten birkaç askerimiz var. Umarım şehri haydut saldırılarına karşı savunabiliriz.";
"T_SCENARIO_2016_10_QUEST_22_DESC" = "Lordum, haydutlara haddini bildirip onları bu bölgeden sürmenin zamanı geldi.";
"T_SCENARIO_2016_10_STRIKE_DESC" = "Görünüşe göre daha belirgin önlemler gerekiyor. Kasaba artık grevde!";
"T_SCENARIO_2016_10_STRIKE_NAME" = "Kasabalılarınız grevde. Onlar sakinleşene kadar bekleyin.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_DESC" = "Efendim, sizce de muhteşem bir gün değil mi?\n\nKasabanın ziyafetler için yeterince dekore edildiğinden emin olmanız mümkün mü diye sormak için huzurunuza geldim.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_NAME" = "Kasabadaki dekorasyonlarla memnuniyeti artırın.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_01_SUCESS" = "Lordum, bu yeni dekorasyonlarla harika iş çıkardınız. Kasaba muazzam görünüyor!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_DESC" = "Lordum, şöleni hazırlayan işçiler ziyafetler arasında eğlencenin eksik oluşundan rahatsız. Birkaç tanesinin bir hokkabaz kampı olmasını istediğini duydum.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_NAME" = "Bir hokkabaz kampı inşa edin.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_02_SUCESS" = "Lordum, harika! İşçiler ziyafetleri hazırlamaya döndü. Artık kasabada bir hokkabaz kampımız olduğu için neşe dolular.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_DESC" = "Bu fırtınalar kasabaya büyük ölçüde hasar veriyor. Lordum, tüm binaların yeterince onarıldığından emin olmalıyız. ";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_NAME" = "Bina durumu memnuniyetini artırın.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_SUCESS" = "Lordum, harika! Artık binalar yeniden çok iyi durumda.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_03_THUNDERSTORM" = "Lordum! Kasabaya korkunç bir fırtına yaklaşıyor. Kalenin güvenliğiyle ilgilenmelisiniz. Yıldırımlar şimdiden birkaç binaya düştü…";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_DESC" = "Bir dakikanızı alabilir miyim Lordum?\n\nTüm bu hazırlıklar içinde… Bu şenliğin amacını unutmamalısınız… Lordum, bu yalnızca hasat tamamlandığında gerçekleşebilir!";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_NAME" = "Üzüm hasadını tamamlayın.";
"T_SCENARIO_2016_FESTIVITIES_AUTUMN_04_SUCESS" = "Efendim, ne harika bir manzara! Hasat tamamlandı ve şenlik hazırlıkları da neredeyse tamamlandı. ";
"T_SCENARIO_2016_FESTIVITIES_FEAST_FAILED" = "Lordum, süremiz doldu. Artık festival için çok geç. Kral bunu duyduğuna memnun olmayacak…";
"T_SCENARIO_2016_FESTIVITIES_FEAST_READY" = "Efendim, harika!\n\nŞenlik için hazırlıklar tamamlandı. Şenliklere başlamak için yalnızca sizin emrinizi bekliyoruz.";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_DESC" = " Kraliyet kararı ile ziyafetlerle dolu bir yıl idame ettirmenizi emrediyorum. Her mevsim yeni eşimin onuruna bir festival düzenlemenizi istiyorum!\n\nŞimdi gidip hazırlığa başlayın! Beni hayal kırıklığına uğratmayın…";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_FAILED" = "Beni gerçekten hayal kırıklığına uğrattınız Vali!\n\nBirkaç ziyafeti yönetmek çok basit bir görevdi ancak yine de bunu yapmayı başaramadınız! Çok mu şey istedim? Şimdi gidin başımdan!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_NAME" = "Tüm ziyafetleri zamanında düzenleyin!";
"T_SCENARIO_2016_FESTIVITIES_MQ_01_SUCESS" = "Vali! Bu festivallerle dolu muhteşem bir yıldı.\n\nZorlu bir görevim olduğunda size güvenebileceğimi kanıtladınız.";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_DESC" = "Efendim, ne güzel bir festivaldi!\n\nAma şimdi kış başlamadan önce Sonbahar festivalinin planlandığı gibi düzenlendiğinden emin olmalıyız! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_AUTUMN_NAME" = "Kış başlamadan önce sonbahar festivalini düzenleyin.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_DESC" = "Efendim, ilkbahar festivalini hazırlamak için acele etmeliyiz.\n\nFestival yaz başlamadan önce tamamlanmalı ve fazla zamanımız kalmadı.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SPRING_NAME" = "Yaz başlamadan önce ilkbahar festivalini düzenleyin.";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_DESC" = "Efendim, ne güzel bir festivaldi!\nAma şimdi sonbahar başlamadan önce yaz festivalinin planlandığı gibi düzenlendiğinden emin olmalıyız! \n\nZaman hayati önem taşıyor Efendim!";
"T_SCENARIO_2016_FESTIVITIES_MQ_SUMMER_NAME" = "Sonbahar başlamadan yaz festivalini düzenleyin.";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_DESC" = "Efendim, ne güzel bir festivaldi!\n\nAma şimdi ilkbahar başlamadan önce kış festivalinin planlandığı gibi düzenlendiğinden emin olmalıyız! ";
"T_SCENARIO_2016_FESTIVITIES_MQ_WINTER_NAME" = "İlkbahar başlamadan kış festivalini düzenleyin.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_DESC" = "Lordum, olabildiğince kısa süre içinde bir panayır alanı inşa etmemizi öneriyorum. Tüm festivaller orada gerçekleşecek.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_NAME" = "Bir panayır alanı inşa edin.";
"T_SCENARIO_2016_FESTIVITIES_QUEST01_SUCESS" = "Efendim, harika! Şenlik alanları tamamlandı. Bu bina elimizdeki görev için çok önemli, bu yüzden gözümüz onun üzerinde olmalı.";
"T_SCENARIO_2016_FESTIVITIES_QUEST_FAIRGROUND_DESTR" = "Lordum, ziyafetler için bir panayır alanına ihtiyacımız var! ";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_DESC" = "Efendim, ilk ihtiyacımız bir çiçekli direk. Oduncu bize buna uygun bir ağaç kesebilir. Ancak en iyisini bulmak için birçok ağaç kesmek zorunda kalacak.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_01_NAME" = "Çiçekli direk için odun toplayın.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_DESC" = "Çiçekli direğimizin düzgün şekilde dekore edilmesi gerekiyor. Lordum, bunun için yeterli kumaşa ihtiyacımız var.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_02_NAME" = "Çiçekli direk için Kumaş üretin toplayın.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_DESC" = "Ne hoş bir çiçekli direk. Kardeşlerim arasında her yıl bölgedeki çiçekli direkleri çalmanın bir gelenek olduğunu biliyor muydunuz?";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_FAILED" = "Ha ha ha! Çiçekli direğiniz artık bizim! Haydut kampımızın önünde güzel bir dekorasyon olacak. Becerebilirseniz gelip geri almaya çalışabilirsiniz…";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_NAME" = "Çiçekli direği haydut saldırılarına karşı koruyun!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_03_SUCESS" = "Lanet olsun! Neredeyse lanet çiçekli direği alacaktım. Onu iyi savundunuz Vali!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_DESC" = "Lordum! Kasabanın yakınlarında bir haydut kampı var. Köyü emniyete almak için daha fazla adama ve başka bir nöbetçi kulesine ihtiyacımız var.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_NAME" = "Bir nöbetçi kulesi daha inşa edin ve yeterli asker görevlendirin.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_04_SUCESS" = "Çok iyi! Artık askerlerimiz haydutlar saldırdığında panayır alanını çok daha kolayca savunabilir!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_DESC" = "Çiçekli direk depolarımızdan çalınmış. Festivalin zamanında başlamasını sağlamak için haydut kampına gidip onu geri almalıyız.";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_NAME" = "Haydut kampına saldırın ve çiçekli direği geri alın!";
"T_SCENARIO_2016_FESTIVITIES_SPRING_05_SUCESS" = "Zafer! Lordum, biz konuşurken çiçekli direğimiz depoya geri getiriliyor.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_DESC" = "Lordum! Çiftlik yanıyor! Lütfen, bir şeyler yapmalısınız!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_FAILED" = "Ne felaket ama Vali! Çiftlik yanıp kül oldu ve hasat da mahvoldu…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_NAME" = "Çiftliği kurtarın!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_01_SUCESS" = "Efendim, size sonsuza kadar minnettarım!\n\nAncak yangın hasadı mahvetti! Tarlaları zamanında hasat etmezsek ziyafetler hâlâ iptal edilmek zorunda kalabilir.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_DESC" = "Lordum, ailemin çiftliği yanıp kül oldu! Festival için yılın ilk ekmeğini asla zamanında yapamayacağım. Çiftliğin yeniden inşa edilmesi için emir verebilir misiniz lütfen?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_NAME" = "Yeni bir çiftlik inşa edin.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_02_SUCESS" = "Teşekkürler Lordum.\n\nSiz olmasaydınız ben mahvolurdum ve yaz şenliği iptal edilebilirdi!\n\nAma buğdayı zamanında hasat etmek için acele etmeliyiz!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_DESC" = "Lordum, artık hasatla ilgilenmeliyiz. Festival başlayana kadar hâlâ biraz zaman var. Yeterince buğdayın hasat edildiğinden emin olmalıyız.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_NAME" = "Buğday hasatlarını tamamlayın.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_03_SUCESS" = "Efendim, bu günlerde hava çok sıcak. Umarım ziyafetleri tehdit edecek başka bir yangın veya kuraklık daha olmaz. Yine de şu anda şenlik için yeterli buğdayımız var. ";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_DESC" = "Lordum, tarlalarım o kadar kuru ki sanırım bu yaz yine kuraklık içinde geçecek. Tarlaları sulamak için birkaç kuyu inşa eder misiniz lütfen?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_NAME" = "Tarlaları sulamak için birkaç kuyu inşa edin.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_04_SUCESS" = "Güzel iş Efendim! Tarlalar sulandı. Artık sadece buğday yeniden büyüyene kadar beklememiz gerekiyor.\n\nUmarım uzun sürmez…";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_DESC" = "Efendim, hasadın ilk ekmeğini pişirmeyi tamamladığımızda şenlik başlayabilir. Pişirmenin zamanında tamamlandığından emin olur musunuz lütfen?";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_NAME" = "Yaz festivali için yeterli ekmek pişirin.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_05_SUCESS" = "Efendim, muhteşem. Ziyafet için ekmek pişirildi!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_DESC" = "Lordum! Festival için hâlâ bir şey eksik… İçkiye ihtiyacımız var! Keşişlere biraz içki yaptırmak için bir manastır içki işletmesinin inşaatı için emir vermelisiniz!";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_NAME" = "Yaz festivali için içki üretin.";
"T_SCENARIO_2016_FESTIVITIES_SUMMER_06_SUCESS" = "Çok iyi Efendim. İçki çok lezzetli ve böyle bir yazda ferahlatıcı.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_DESC" = "Efendim, kış şenliği için muhteşem bir fikrim var. Seyahatlerimde sıcak şarap adı verilen özel bir şarapla karşılaştım. Bu kış festivali için kusursuz içecek olabilir.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_NAME" = "Sıcak şarap için malzemeleri teslim edin.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_01_SUCESS" = "Efendim, mükemmel. Artık sıcak şarap için tüm malzemelere sahibiz. Hemen başlayıp içeceği hazırlayacağım.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_DESC" = "Lort, size ağaç dekorasyonu konusunda soru sormak için geldim. Biraz altın süsler olması gerçekten güzel olurdu.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_NAME" = "Dekor amaçlı süsler için altın kesekleri üretin.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_02_SUCESS" = "Lordum, muhteşem. Bu biblolar gerçekten güzel. Değerli vaktinizi bu süslere harcadığınız için size teşekkür ediyorum. Bence bu mükemmel bir festival olacak.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_DESC" = "Ben ve çocuklar festival için bir doğuş şöleni düzenlemek istiyoruz. Ne yazık ki oyun için bazı önemli kaynaklarımız eksik. Lütfen bize gerekli aletleri tedarik eder misiniz?";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_NAME" = "Doğuş şöleni için kaynakları hazırlayın.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_03_SUCESS" = "Teşekkürler Efendim. Artık doğuş şöleni için kostümlerimizi yapmaya başlayabiliriz.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_DESC" = "Lordum, ziyafet için zencefilli kurabiye aklıma geldi. Yine de gerekli kaynakları elde etmek zor olabilir.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_NAME" = "Zencefilli kurabiye için malzemeleri teslim edin.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_04_SUCESS" = "Efendim, harika. Zencefilli kurabiyeyi hemen pişirmeye başlayacağım.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_DESC" = "Bu zamanlarda ihtiyaç sahiplerini unutmamalıyız. Bu yüzden fakirler için para topluyorum. Kasaba gelirlerinin bir kısmını bu dava için bağışlamanız gerçekten büyük bir iyilik olur.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_NAME" = "Yoksullar için yeterli miktarda vergi toplayın.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_05_SUCESS" = "Efendim, cömert bağışınız için teşekkür ederim!";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_DESC" = "Vali.\nŞu anda kasabanızı ziyaret edemeyeceğimi üzülerek bildirmek istiyorum.\nOrmanda kasabanızı çevreleyen haydutlara dair söylentiler duydum. Şu anda tüccarlar için fazla tehlikeli.";
"T_SCENARIO_2016_FESTIVITIES_WINTER_06_SUCESS" = "Çok teşekkürler Efendim. Artık haydutlar bölgeden sürüldüğüne göre kasabanızı yeniden düzenli olarak ziyaret edeceğim.";
"T_SCENARIO_2017_APOCALYPSE_CHURCH_GONE_01" = "Efendim, kilise yıkıldı. Böyle zamanlarda alabildiğimiz tüm desteğe ihtiyacımız var. Kasabada başka bir kiliseye ihtiyacımız var.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_DESC" = "Vali, bu kasabada garip bir şeyler oluyor. Sadece bu mevsim başımıza yedi felaket geldi! Burada neler döndüğünü bulmamız gerekiyor. Lanetlendiğimize inanmaya başlıyorum.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_FAILED" = "Lordum, kasabayı hemen terk etmeliyiz. Her şey kaybedildi… Lanetlendik! Lanet asla kalkmayacak.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_NAME" = "Laneti kaldırmanın bir yolunu bulun.";
"T_SCENARIO_2017_APOCALYPSE_MQ_01_SUCCESS" = "Kasabayı kurtardınız! Bu harika bir haber. Lanet nihayet kaldırıldı ve ritüelde hayatta kalmayı bile başardınız.\n\nYine de kasabanın iyileşmek için biraz zamana ihtiyacı olacak…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_DESC" = "Lordum, kasabanın olabildiğince kısa süre içinde istikrarlı şifalı bitki tedarikine ihtiyacı olacak. Yoksa veba kasabamız için sürekli bir tehlike teşkil edecek.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01A_TITLE" = "Şifalı bitki üretin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01B_DESC" = "Lordum, en az bir revir inşa etmeden vebanın üstesinden asla gelemeyeceğiz. Ben yine de daha fazlasını öneririm.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_QUEST_01C_DESC" = "Kasabadaki doktorlar veba kurbanlarını doğru düzgün tedavi edebilmek için bandaj kullanıyorlar. Bandajlar için de daha fazla malzemeye ihtiyacı var. Onlara biraz kumaş göndermelisiniz.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_01_START" = "Lordum, veba kasabayı sardı! Ne yazık ki bu felaketler gerçekleşirken hiçbir tüccar bizi ziyaret etmeyecek…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02A_DESC" = "Lordum, buğdayı una dönüştürmek için bir yel değirmenine ihtiyacımız var. Böyle zor zamanlarda yiyecek üretimimize ayak uydurmalıyız Efendim!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02B_DESC" = "Lordum, ekmek üretmek için bir fırın inşaatı yapılması emrini vermeliyiz.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_QUEST_02C_DESC" = "Şimdi ekmek stoklama zamanı. Kasabayı doyurmalıyız. İhtiyacımız olan en son şey açlıktan kırılan bir nüfus.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_02_START" = "Lordum, besi hayvanları… Tüm hayvanlar ve nehirdeki balıklar… Hepsi ölüyor! Burada neler oluyor böyle?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03A_DESC" = "Vali, kilise yanıyor. Lort bizi terk etti! Bize yardım etmelisiniz…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_DESC" = "Efendim, kilisede biraz araştırma yaptım ve bize yardımcı olabilecek belgeler buldum.\n\nAma artık kiliseye girmek güvenli değil ve belgelerime ulaşamıyorum.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS" = "Teşekkürler Efendim. İşte, bu belgelere bir göz atın. Naçizane kasabamızın şu anda durduğu yerde bir zamanlar bir kadim mezarlık varmış.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_SUCCESS_A" = "Sarayda bir zamanlar özel bir danışman varmış. Bir kâhinmiş ancak pagan büyülerini ve bu tarz şeylerden anlarmış. Çıldırıp Kralı zehirlemeye çalıştığı için mahkum edilmiş.\n\nKralla iletişime geçeceğim. Belki o adamla konuşmamıza izin verir.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03B_TITLE" = "Kiliseyi onarın.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_CLIENT" = "Kral bize yardım etmeyecek, ipleri elimize alıp kâhini özgür bırakmalıyız.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_DESC" = "Lordum! Kasabalılar panik içinde! Onları sakinleştirmek için askeri güç göstermeliyiz.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03C_KING" = "Vali, bu alçak ve hain adamı hapishanemden çıkartmayacağım. Lanetiniz umurumda değil, bu adam beni öldürmeye çalıştı. Hapiste çürüyecek.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT" = "Lanet olsun Vali… Neden bize saldırıyorsunuz? Sizi defalarca soyduğumuzu biliyorum ama bu…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_BANDIT_02" = "Vali, laneti ilk elden yaşadık. Buralarda böyle olaylar olurken biz haydutlar zengin tüccarları soyamayız.\n\nO adamı hapisten çıkarmanıza yardım edeceğiz…";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_DESC" = "Lordum, kasabamızın yakınında bir haydut kampı var. Belki de kâhini hapisten çıkarmamıza yardım etmeleri için onları "ikna" edebiliriz.\n\nO adamın bazı cevapları olmalı! Ufak bir… Iıı… Uzlaşma başlatmak için o kampa bir saldırı emri verin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_QUEST_03D_SUCCESS" = "Efendim, haydutlara karşı ne harika bir zafer kazandık. Şimdi onlarla bir konuşma yapalım…\n\nBelki de laneti kaldırmamıza yardım ederler.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_03_START" = "Lordum, görünüşe göre bu göklerden gelen bir gazap! Çiftçiler kuraklık yaşadığımızı bildirdi!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04A_DESC" = "Hapishane baskınına hazırlıkta bazı askeri ekipmanlar, birkaç eğitim alanı ve erzak gerekebilir. Bir cephanelikle başlayalım mı?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_DESC" = "Vali, adamlarımın hapishane baskını için eğitim yapması gerekiyor. Bunu gerçekten yapmak istiyorsanız eğitim yapmak için bir yere ihtiyacımız var.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04B_TITLE" = "Bir okçuluk yarışma alanı inşa edin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_DESC" = "Vali, bence yiyecek ve içecek bir şeyler çok güzel olurdu, baskın grubunun lideri, yani BENİM için!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04C_TITLE" = "Erzak teslim edin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_DESC" = "Vali, biraz ekipman için zaman geldi. Normalde kullandığımız tahta kılıçlar ve baltalar hapishane nöbetçilerine karşı hiçbir işe yaramayacak.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_QUEST_04D_TITLE" = "Askeri ekipman teslim edin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_START" = "Lordum, güneş! Bir güneş tutulması oluyor! Acele etmeliyiz yoksa hepimiz lanetleneceğiz!";
"T_SCENARIO_2017_APOCALYPSE_PHASE_04_SUCCESS" = "Harika! Şu adamı hapishaneden çıkartmak için neredeyse hazırız! Gelecek sefer görüştüğümüzde adam ile yüz yüze konuşabilirsiniz.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05A_DESC" = "Belki de zamanımı boşa harcamayarak beni ikna edebilirsiniz. Uzun süredir hiç sosis tadına bakmadım.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_DESC" = "Peki, peki. Size yardım edeceğim. Sizin şu küçük lanet gerçekten fena görünüyor ama basit bir ritüel ile kaldırılabilir.\n\nNeden en baştan kasabanızı kadim bir mezarlığın üzerine inşa ettiniz ki?";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05B_SUCCESS" = "İyi haber var, lanet tersine çevrilebilir. Ancak kolay bulunmayacak bazı kaynaklara ihtiyacımız var.\n\nEnerji dolu bir kristal kuvars, zamansızlık iksiri ve bir paratonere ihtiyacımız var.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_DESC" = "Vali, yağmalarımdan birisinde tesadüfen bu kuvarslardan birisini "buldum". Ne yazık ki çetemizi ayırdığımızda onu arkadaşım "Bıçkın" aldı.\n\nBölgede kendi haydut kampı bulunuyor.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_1_TITLE" = "Enerji yüklü kuvarsı haydut kampından alın.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_DESC" = "Vali, paratoner normal demir külçeler ve birkaç alet ile inşa edilebilir.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_2_TITLE" = "Paratoneri inşa edin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_DESC" = "Lordum, bana gerekli malzemeleri getirebilirseniz size iksiri hazırlayacağım.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_3_TITLE" = "İksir malzemelerini getirin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_DESC" = "Şimdi sol elinizde paratoner, sağ elinizde de enerji dolu kuvarsı tutarken iksiri içmelisiniz. Sonrasında bir yıldırım paratonere düşene kadar açık alanda durmalısınız.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_QUEST_05_RITUAL_END_TITLE" = "Ritüeli gerçekleştirin.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START" = "Beni hapishaneden çıkarmasını beklediğim son kişi sizsiniz. En başından burada olma sebebim SİZSİNİZ.";
"T_SCENARIO_2017_APOCALYPSE_PHASE_05_START_02" = "Görünüşe göre bir lanetle başınız belada. Şimdi de yardımı mı istiyorsunuz?";
"T_SCENARIO_2017_APOCALYPSE_THUNDERSTORM_WARNING" = "Lort! Kasabamıza korkunç bir fırtına yaklaşıyor. Yangın gözleme kulelerinin tamamen tetikte olduğundan emin olalım!";
"T_SCENARIO_2017_APOCALYPSE_TRADE_QUEST_01_DESC" = "Vali. Kasabanıza gelmek benim için çok tehlikeli. Ancak parasını öderseniz sizin için ayarlamalar yapabilirim…";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_DESC" = "Kasabadaki askerlerin çok fazla değerli kaynak harcadığını düşünmüyor musunuz? Onları kolaylıkla satıp bir yandan biraz para kazanabiliriz. Tek yapmamız gereken vardiya çavuşunun bir şekilde dikkatini dağıtmak.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE" = "Vardiya çavuşunu kışladaki görevinden alın.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_01_TITLE_CASTLE" = "Kaledeki taşıyıcıları görevden alın.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_DESC" = "Vali, adamlarımın surlarda bir süre rahatsız edilmemeye ihtiyacı var. Biliyorsunuz, surların dışında malları "depolarken" kendi başlarına olmayı seviyorlar. Surun yakınındaki nöbetçilerin başka bir yerde olması önemli.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_02_TITLE" = "Tüm askerleri görevden alın.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_DESC" = "Kasabadaki nüfusla ilgili ufak birkaç sorunum var. Görüyorsunuz ya, biz varlığımızla onlara yardım ediyoruz ve iyiliklerimiz için bize ödeme yapmak istemiyorlar, anlıyor musunuz?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_03_TITLE" = "Koruma parası toplayın.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_04_DESC" = "Vali, ne yazık ki kasabadaki "masraflarımı" karşılayacak kadar yeterli para toplayamadınız. Paramın geri kalanına ihtiyacım var. Kendiniz bir miktar para "yatırmaya" ne dersiniz?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_05_DESC" = "Grubum bu gece tavernada "kısmen kanuni" küçük bir kumar turnuvası düzenlemek istiyor. Tavernada güzel bir eğlence düzenleyip biraz içki ve meyve suyu getirmeye ne dersiniz.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_DESC" = ""İş ortaklarım" turnuvadaki kumar devam ederken düzgün yemekler istiyor. Kimsenin açlıktan kırılmaması için biraz sosis ve ekmek gönderin, olur mu?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_06_TITLE" = "Sosis ve ekmek teslim edin.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_DESC" = "Vali, huzurunuza başka bir teklifle geldim. Eşkıyalarım… Iıı… Yani elbette iş ortaklarımın işlerini daha iyi yapmak üzere güç kullanmak için daha fazla alete ihtiyacı var. Biraz silah ve zırh yollasanız nasıl olur?";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_07_TITLE" = "Silah ve zırh teslim edin.";
"T_SCENARIO_2017_ELECTION_BANDIT_QUEST_TAVERN_DESC" = "Vali, "iş ortaklarım" biraz eğlenmek istiyor. Biraz rahatlamak için bir tavernaya ihtiyacımız var. ";
"T_SCENARIO_2017_ELECTION_BANDIT_START" = "Hoş geldiniz Vali. Benimle buluşmaya vakit ayırdığınız için teşekkürler. Ben… Iıı… "Gizli" grubun temsilcisiyim. Yeniden seçilme çabanızda sizi destekleyebiliriz ancak ilk önce bizim için bazı görevler tamamlamanız gerekiyor.";
"T_SCENARIO_2017_ELECTION_BANDIT_SUCCESS" = "Vali, görevlerimizi tamamlayarak bizi desteklediniz ve şimdi teşekkür etme sırası bizde.\n\nSiz benim sırtımı kaşıdınız, şimdi de ben sizin sırtınızı kaşıyacağım ve seçim sonucunu sizin lehinize değiştireceğim. ";
"T_SCENARIO_2017_ELECTION_BANDIT_TITLE" = "Gizli grup için tüm görevleri tamamlayın.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_BANDITS" = ""Gizli" grubu seçin.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_FLOWERCLUB" = "Çiçek kulübünün arkadaşlarıyla çalışın.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MERCHANTS" = "Esnaf loncasıyla çalışın.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_MILITARY" = "Askeri grubu seçin.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_NOBLEMAN" = "Soylu grubu seçin.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_QUEST_01_DESC" = "Lordum, hangi grubu desteklemek istediğinize karar vermelisiniz. Seçiminizden sonra grubun isteklerini tamamlamaya odaklanmalısınız. Size oy vermeye ikna olduktan sonra farklı bir grup seçebilirsiniz.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_RELIGIOUS" = "Dini grubu ziyaret edin.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SERVANTS" = "Hizmetkâr grubu seçin.";
"T_SCENARIO_2017_ELECTION_CHOSE_FACTION_SMALLFOLK" = "Küçük halkı ziyaret edin.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_DESC" = "Kasaba çok sıkıcı. Kim olsa detaylar ve güzelliğe önem vermediğinizi fark edebilir.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_01_TITLE" = "Daha fazla çiçek tarhı ekin.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_02_DESC" = "Vali, yine mi tembellik yapıyorsunuz? Kurumak üzere olan bunca çiçeği görmüyor musunuz? Belki de çevrenizdeki muhteşem doğayla daha fazla ilgilenmelisiniz.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_DESC" = "Vali, kasaba leş gibi kokuyor! Bu sefer gerçekten suç sizde. Lağımlar tıkanmış ve taşıyor.\n\nDurumla ilgilenin!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_03_TITLE" = "Daha fazla rögar inşa edin.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_04_DESC" = "İşte oldu! Nihayet şehir düzgün görünüyor, her yerde çiçekler açıyor ve şimdi de bu! Kasaba evlerine baksanıza! En iyi halleri bile harabe.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_05_DESC" = "Vali, bu bir rezalet!\nGezen bu hayvanlar güzel çiçeklerimin büyük bir kısmını yedi. Bunun olmasına nasıl izin verirsiniz?\n\nBu yaratıkları çiçek tarhlarımdan atmak için hemen daha fazla avcı kulübesi talep ediyorum.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_DESC" = "Devlet bahçıvanlık gösterisi için yeterince koltuk olduğundan emin olmalısınız. Kasabada etrafa yerleştirilen birkaç bank yeterli olmalı.\n\nBunun olmasını sağlayın!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_06_TITLE" = "Kasabada banklar inşa edin.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_DESC" = "Vali, şu hayvanlara çok yazık.\n\nDomuzlar kasabada çok kötü şartlarda yaşıyor ve gerektiği şekilde gezemiyorlar.\n\nÇiçek kulübü dostları domuz çiftliğinin ve kasap dükkânının yıkılmasını istiyor!";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_QUEST_07_TITLE" = "Domuz çiftliğini ve kasap dükkânını yıkın.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_START" = "Vali, ben çiçek kulübü dostlarının başkanıyım. Demek ki gelecek seçimde desteğimizi istiyorsunuz. Böyle bir kasaba için neden benim gibi yetenekli bir kadın seçilmesin ki?";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_SUCCESS" = "Valilik için yeterli oluşunuza dair baştaki şüphelerime rağmen çiçek kulübü dostlarının gerçek bir dostu olduğunuzu kanıtladınız.\nSeçimde size oy vereceğiz.";
"T_SCENARIO_2017_ELECTION_FLOWERCLUB_TITLE" = "Çiçek kulübü dostlarının tüm isteklerini yerine getirin.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_DESC" = "Lordum, bu kasabada yakında bir Vali seçilecek.\n\nBu kasabadaki grupları size oy vermeleri için ikna etmeyi öneririm. Hepsini ikna etmek için yeterli zamanımız olduğunu sanmıyorum, bu yüzden kimi destekleyeceğimizi dikkatlice seçmelisiniz.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_FAILED" = "Lordum, seçim sonucu henüz geldi.\n\nSize söylemekten korkarım ki bu kasabadaki gruplardan yeterince oy almayı başaramadık.\n\nGelecek hafta yeni Vali işimizi üstlenmeden önce kaleyi boşaltmalıyız…";
"T_SCENARIO_2017_ELECTION_MAINQUEST_SUCCESS" = "Lordum, kasabada yeterince grubu bize oy vermeleri için ikna etmeyi başardık. Bu kasabadaki yetkimiz güvence altında.\n\nBu işte birkaç yıl daha kazanmamıza kadeh kaldıralım.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER" = "Lort Vali, seçimin başlamasına fazla zaman kalmadı. Acele edip yeterince grubu size oy vermeye ikna etmeliyiz.";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TIMER_TITLE" = "Kalan süre: ";
"T_SCENARIO_2017_ELECTION_MAINQUEST_TITLE" = "Seçimi kazanması için minimum 3 grubu ikna edin.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_01_DESC" = "Lordum, esnaf loncası öfkeli. Pazarımız yıkıldı ve uzun süre önce yeniden inşa edilmeliydi.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_DESC" = "Ne rezalet ama! Taşıyıcı Kasabalılar esnaf loncası binasında çok fazla mal depolamıştı. Orası yıkıldı! Sürekli böyle şeyler olurken nasıl ticaret yönetimi yapabiliriz.\n\nLütfen esnaf loncasını yeniden inşa edin.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_02_TITLE" = "Esnaf loncasını yeniden inşa edin.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_DESC" = "Efendim, muhteşem. Artık ticaret yapmaya yeniden başlayabiliriz. Esnaf loncasında bir ticaret emri oluşturur musunuz? Bu, kasabamızı bölgede hak ettiği yere yeniden yükseltecektir.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_03_TITLE" = "Esnaf loncasında aktif bir ticaret emri bulundurun.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_04_DESC" = "Para! Vali, her şey her zaman parayla ilgilidir. Ticaret yaparak yeterince kâr sağlandığından emin olmak bizim ilk önceliğimizdir.\n\nVali, hadi biraz para kazanalım!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_DESC" = "Vali, pazarımızdaki boş alanlar hızla doluyor. Daha fazla alana sahip olup daha verimli ticaret yapabilmemiz için pazarı yükseltmeyi düşünmelisiniz.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_05_TITLE" = "Pazarı yükseltin.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_DESC" = "Vali, birçok Kasabalı kasabanın etrafına serilmiş küçük pazar tezgâhları istiyor. Bu şekilde şehir içi ticareti de artırabiliriz. Oldukça iyi bir fikir değil mi?";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_06_TITLE" = "Kasabaya pazar tezgâhları yerleştirin.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_DESC" = "Vali, oldukça kârlı bir ticaret sözleşmesi yaptım. Giysi ve içkinin fiyatı büyük ölçüde arttı!\n\nParanın kokusunu alabiliyorum! Çok fazla para!";
"T_SCENARIO_2017_ELECTION_MERCHANTS_QUEST_07_TITLE" = "Pazarda giysi ve içki satın.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_START" = "Vali, ben esnaf loncasının temsilcisiyim. Gelecek seçimde loncanın oyunu kazanmak için kasabadaki ticaret durumunu önemli ölçüde iyileştirmeniz gerekiyor.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_SUCCESS" = "Lordum, ticaret yapmak için harika bir gün.\n\nBu kasabayı bölgedeki en harika ticaret merkezi haline getirdiniz. Bunun için loncanın tüccarları size sonsuza kadar minnettar. \n\nTeşekkür olarak gelecek seçimde size oy vereceğiz.";
"T_SCENARIO_2017_ELECTION_MERCHANTS_TITLE" = "Esnaf loncası için tüm görevleri yerine getirin.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_DESC" = "Kabul edilemez! Kesinlikle kabul edilemez!\n\nKasabada bir kışlamız bile yokken nöbetçi kulelerine nasıl tedarik sağlayabiliriz.\n";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_01_TITLE" = "Bir kışla inşa edin.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_02_DESC" = "Nihayet işleri halletmeyi bilen bir Vali. Pekâlâ, nöbetçi kulelerinde birkaç asker görevlendirmeniz tavsiye edilebilir.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_DESC" = "Birlik komutanı olarak savaştan sonra kuvvetlerimizi organize etmek ve bazen dinlenmeye zaman bulmak imkansız oluyor. Savaştan yorgun düşen vücudumun rahat komutan çadırlarına ihtiyacı var.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_03_TITLE" = "Komutan çadırları inşa edin.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_04_DESC" = "Vali, kuvvetlerimiz hâlâ yeterince büyük değil. Üçüncü sınıf haydutlar zavallı ordumuzla karşılaştığında gülmekten altına yapacak.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_05_DESC" = "Vali, ordu için erzaka ihtiyacımız var. En iyi erzak sosistir. Uzun süre dayanabilirler ve cephede kolaylıkla yenilebilirler.";
"T_SCENARIO_2017_ELECTION_MILITARY_QUEST_06_DESC" = "Vali, hiçbir yer yokken cesur askerlerimiz gelecek savaşlar için nerede pratik yapabilir? Silahlı kuvvetler komutanı olarak bir okçuluk yarışma alanı inşa etmenizi talep ediyorum.";
"T_SCENARIO_2017_ELECTION_MILITARY_START" = "Hoş geldiniz Vali. Gelecek seçimde asker grubunun desteğini istiyorsunuz.\n\nPekâlâ, bizi size oy vermeye ikna etmek için yapacak çok şeyiniz var.";
"T_SCENARIO_2017_ELECTION_MILITARY_SUCCESS" = "Çok teşekkürler Vali. İyiliklerinizde biz sıradan askerleri gururlandırıyorsunuz. Siz Valimiz olana kadar bu şehirdeki askeriye hiç bu kadar dik durmamıştı. Seçimde bizim oyumuzu kazandınız.";
"T_SCENARIO_2017_ELECTION_MILITARY_TITLE" = "Askeri grup için tüm görevleri tamamlayın.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_01_DESC" = "Lordum, hiçbir büyük kasaba vatandaşları için sınırlı miktarda içecek sunmaz. Özellikle biz soylular üzüm suyu gibi gösterişli şeyler isteriz.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_02_DESC" = "Lordum, soylular yeni üretim zincirinizin tamamlanışını kutluyor.\n\nKutlamalar için sadece büyük miktarda üzüm suyuna ihtiyacımız var. Ama lütfen ucuz olanından olmasın…";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_03_DESC" = "Lordum, ayak takımı gibi tavernaya gitmemizi beklemiyorsunuz herhalde. Surların dışındaki turnuva alanı yıllardır sahipsiz.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_DESC" = "Lordum, soylular için büyük bir kahraman öldü. Onun için bir anıt ve saygıdeğer bir mezar inşa ederseniz bu kasabadaki birçok soyluyu mutlu edersiniz.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_04_TITLE" = "Bir anıt mezar ve kahraman heykeli inşa edin.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_05_DESC" = "Lordum, bu kasabada soylular için birkaç değerli mülk eksik. İnsanlar statülerinin ne kadar yüksek olduğunu birkaç değerli mücevherle yeterince gösteremez Efendim.\n";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_QUEST_06_DESC" = "Efendim, muhteşem. Şu anda mücevher çok yüksek talep görüyor. Herkes saraydakilerin taktığını mücevherlerden istiyor.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_START" = "Efendim, nihayet sizinle tanışmak ne hoş. Ben şehrinizdeki soylular grubunu temsil ediyorum. Gelecek seçimde bizim oyumuzu kazanmak istiyorsanız gösterişli isteklerimizi yerine getirmelisiniz.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_SUCCESS" = "Efendim, gerçekten de soyluların tüm isteklerini yerine getirdiniz. Kasabanızda bir soylu, Kralın sarayındaki tüm ayrıcalıklara sahiptir. Bu kasabada harika işler başardınız!\nGelecek seçimde oyumuz sizindir.";
"T_SCENARIO_2017_ELECTION_NOBLEMEN_TITLE" = "Soyluların tüm isteklerini yerine getirin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_DESC" = "Dini topluluğumuz sürekli azalıyor. Nüfus, vaktini içerek veya parti yaparak geçiriyor. Bu sona ermeli.\n\nTüm suç o günah dolu tavernada. Orayı yıkmalısınız! ";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_SUCCESS" = "Çok güzel! O din dışı yapı aylar önce yıkılmalıydı. En azından birisi bunu yapacak cesareti buldu.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_01_TITLE" = "Tavernayı yıkın.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_DESC" = "Kilisemiz yeni inananların akınına dayanamıyor. Taverna yıkıldığından beri kilise fazla kalabalıklaştı.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_SUCCESS" = "Şükürler olsun, ne muazzam yeni bir kilise. Vekil, Hızır gibi yetiştiniz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_02_TITLE" = "Kiliseyi yükseltin veya yeni bir tane inşa edin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_DESC" = "Dini topluluğumuz kasabanın din konusunda sunduklarından hâlâ memnun değil. Nüfusun din konusunda daha memnun olması gerekiyor!";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_03_SUCCESS" = "Vekil, başardınız. Size olan inancım boşa değilmiş. Dini topluluğu yeniden mutlu ettiniz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_DESC" = "Rahip arkadaşlarım kasabadaki şerbetçiotu üretiminin azlığından şikâyetçi. Biz keşişler gerekli miktarda şerbetçiotu olmadan içki üretemeyiz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_04_TITLE" = "Bir şerbetçiotu işleme evi inşa edin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_DESC" = "Artık şerbetçiotu üretimi yeniden arttığına göre içki imalini artırmayı düşünmelisiniz.\n\nManastırı yükseltin. Alternatif olarak yeni bir manastır inşa etmelisiniz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_SUCCESS" = "Yeni manastırımız Lordumuzun ışığıyla parıldıyor. İyi iş Vali.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_05_TITLE" = "Manastırı yükseltin veya yeni bir tane inşa edin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_DESC" = "Yeni manastırın açılış şenlikleri için bol miktarda içki üretmeliyiz. Misafirlerimiz susamış olacak.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_06_SUCCESS" = "Vali, içki yapım süreci tamamlandı. İlk yudumu alma onuruna erişmek ister misiniz?";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_DESC" = "Kasaba mezarlığı çok küçük ve mezarlar için yeterli yer yok. Birkaç anıt mezar ve mezarlık alanı inşaatı emri vermeniz gerekiyor.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_07_TITLE" = "Mezarlığı genişletin: Anıt mezarlar ve mezarlar inşa edin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_DESC" = "Mezarlığın genişletilmesi yeni mezarlık duvarlarının inşa edilmesini de içermeli. Mezarlık alanını net bir şekilde işaretlemek için yeni duvarların inşaatının emrini vermelisiniz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_QUEST_08_TITLE" = "Yeni mezarlık duvarları inşa edin.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_START" = "Hoş geldiniz Vali. Dini grubun keşişleri olarak isteklerimizi yerine getirdiğinizde gelecek seçim için sizi destekleyebiliriz.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_SUCCESS" = "Vali, şükürler olsun. Tüm isteklerimizi tamamen yerine getirdiniz. Cennette kesinlikle bir yer kazandınız ve dini grubun oyu sizinle olacak.";
"T_SCENARIO_2017_ELECTION_RELIGIOUS_TITLE" = "Dini grup için tüm görevleri tamamlayın.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_01_DESC" = "Lordum, itfaiyecilerin kasabada meydana gelen yangınlarla savaşmak için imkânları sınırlı. Hazırda bulunması için daha fazla yangın gözetleme kulesi inşa etmemizin büyük yardımı dokunur.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_02_DESC" = "Hizmetkâr grubunun bazı üyeleri kasabada bir hokkabaz kampının olmasını çok istiyor. Bu, bizim bile gülecek bir şeye sahip olmamızı sağlar.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_03_DESC" = "Onurlu Vali, biz taşımacı Kasabalılar kasabadaki bunca taşıma görevi yüzünden gerçekten çok çalışıyoruz. Daha fazla depo inşaatı emri vermenizin bize gerçekten yardımı dokunur.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_DESC" = "Lordum, marangozlar giysilerinden şikâyetçi. Kasabadaki onarım görevleri giysilerin çok giyilmesine ve yırtılmasına sebep oluyor. Gerçekten yeni giysilere ihtiyaçları var.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_04_TITLE" = "Giysiler teslim edin.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_DESC" = "Lordum, taşıyıcı Kasabalıların yeni ayakkabılara ihtiyacı var. Yeni ayakkabılar yapmanıza gerek yok, bunu kendi başımıza yapabiliriz.\n\nSadece deri ve kumaşa ihtiyacımız var.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_05_TITLE" = "Kumaş ve deri teslim edin.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_DESC" = "Lordum, hizmetkâr grubuna ufak bir bağış gelmiş geçmiş en iyiliksever Vali olduğunuza tamamen ikna olmamızı sağlar.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_06_TITLE" = "Hizmetkârlara para bağışlayın.";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_DESC" = "Lort Vali, vergi toplayıcısı bir gün izin alsa çok iyi olur. Artık o kadar da genç değil ve kemikleri ağrıyor.\n\nBir süreliğine vergileri kendi başınıza toplamayı başarabilirsiniz değil mi?";
"T_SCENARIO_2017_ELECTION_SERVANTS_QUEST_07_TITLE" = "Vergi toplayıcısını görevden alın ve vergi toplayın.";
"T_SCENARIO_2017_ELECTION_SERVANTS_START" = "Lordum, ben kasabanızdaki hizmetkâr grubunun temsilcisiyim.\n\nBiz taşıyıcılar, itfaiyeciler, marangozlar ve vergi toplayıcıları olarak hizmet veririz. Seçimlerde bir oy hakkımız olduğundan, hayatımızı biraz daha kolaylaştırarak bunu "kazanabilirsiniz."";
"T_SCENARIO_2017_ELECTION_SERVANTS_SUCCESS" = "Lordum, biz hizmetkârlar için harika şeyler yaptınız. Bundan sonra biz hizmetkârlar için güzel zamanlar geliyor. Kasabadaki hayatlarımızı gerçekten iyileştireceğinizi asla hayal edemezdik.\n\nSeçimde oyumuzu kazandınız!";
"T_SCENARIO_2017_ELECTION_SERVANTS_TITLE" = "Hizmetkâr grubu için tüm görevleri tamamlayın.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_01_DESC" = "Lordum! Veba kasabada yayılıyor. Bize yardım etmek zorundasınız, lütfen! Çocuklarım etkilenen bölgede ve kasabada bir revirimiz yok.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_DESC" = "Lort Vali, kasabadaki yiyecek tedariki yeterli değil. Çiftçiler gerekli binaların eksik olduğunu bildiriyor. Yeni bir çiftlik ve fırın inşaatı emri vermelisiniz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_02_TITLE" = "Bir çiftlik ve fırın inşa edin.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_03_DESC" = "Lordum, bizim gibi basit insanların gülecek çok fazla şeyi yoktur ve günlük rutinimiz yorucudur. Üzüntülerimizi unutabileceğimiz bir yerimizin olması gerçekten güzel olurdu. Bir panayır alanı bunun için doğru yer olabilir.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_DESC" = "Lordum, nüfusun çoğu yoksulluk içinde yaşıyor. Vergilerin bir kısmını insanlara geri vererek ününüzü artırabilirsiniz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_04_TITLE" = "Vergilerin bir kısmını insanlara geri verin.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_DESC" = "Artık gerekli altyapıya sahip olduğumuza göre nüfusa daha yüksek çeşide sahip yiyecekler sunmalıyız. Yoksulluk içinde yaşayan Kasabalıların çoğunun yemeye eti yok. Bunu değiştirebilirsiniz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_05_TITLE" = "Et teslim edin.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_DESC" = "Lordum, buğdayı biz hasat ediyor, değirmenden geçiriyor ve ekmeği pişiriyoruz. Ancak tabaklarımızda yiyecek ekmeği zar zor bulabiliyoruz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_06_TITLE" = "Ekmek teslim edin.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_QUEST_07_DESC" = "Lordum, neredeyse tamamen onayımızı aldınız. Yapmanız gereken son şey kasabadaki herkesi daha mutlu etmek. Size daha üretken olarak teşekkür edeceğiz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_START" = "Hoş geldiniz Vali. Değirmenci olarak ben küçük çiftçi topluluğunun sesiyim. Kasabadaki hayatlarımızı kolaylaştırırsanız size seçimde oyumuzu vereceğiz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_SUCCESS" = "Siz gerçekten halk adamısınız. Görevlerimizi tamamlayarak küçük topluluğa yardımcı oldunuz. Artık hayatlarımız çok daha kolaylaştı. Teşekkürler Lordum.\n\nSeçimde size oy vereceğimiz konusunda bize güvenebilirsiniz.";
"T_SCENARIO_2017_ELECTION_SMALLFOLK_TITLE" = "Çiftçiler için tüm görevleri tamamlayın.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_DESC" = "Lordum, ekonomimiz marangoza destek olamıyor. Yeterli kaynaklara sahip değiliz. Şimdilik marangozu binasındaki görevinden almalısınız.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_01_TITLE" = "Marangozu görevden alın.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_02_DESC" = "Lordum, yeterince yiyecek üretmiyoruz. Birkaç balıkçı kulübesi daha inşa etmeniz öneriliyor.";
"T_SCENARIO_2017_ELECTION_STANDARD_QUEST_03_DESC" = "Kasaba gruplarından birisini seçmeden önce bir yel değirmeni inşaatının emrini vermelisiniz. Lordum, kasabanın ekonomisinin gelişmesi için bu gerekli.";
"T_SCENARIO_7_QUEST_INTRO_DESC" = "İyi vekilim, kızım Giebelstadt Prensi III. William Clemens ile evlenecek. Bu önemli olay için tüm hazırlıklarla sizin ilgilenmenizi istiyorum. Harcayacak fazla zamanınız yok, bu yüzden acele edin. Size tamamen güveniyorum!";
"T_SCENARIO_7_QUEST_INTRO_NAME" = "Tüm görevleri tamamlayarak büyük düğün için hazırlık yapın!";
"T_SCENARIO_7_QUEST_OUTRO_DESC" = "Harika çalışmanız için teşekkür ederim! Muhteşem bir iş çıkarttınız, düğün artık başlayabilir! Elbette siz de davetlisiniz!";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_DESC" = "Haydutlar yakında saldıracak, hazırlıklı olmalıyız. Nöbetçi kulelerine adam yerleştirin.";
"T_SCENARIO_BESIEGEMENT_HELPQUEST_02_0_NAME" = "Bir haydut saldırısı olması an meselesi!";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_DESC" = "Lordum, kasabanın ekonomisi sürekli gerçekleşen haydut saldırıları yüzünden sarsılıyor. Umarım kuşatmayı devam ettirebiliriz.";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_END" = "Lordum, harika iş! Kuşatmayı çok iyi idare ettiniz ve ekonomiyi geliştirmeyi bile başardınız. Şövalye bile oldukça etkilenmiş görünüyor. ";
"T_SCENARIO_BESIEGEMENT_MAINQUEST_NAME" = "Kasabayı savunurken bir altyapı kurun.";
"T_SCENARIO_BESIEGEMENT_QUEST_01_DESC" = "Yalnızca bir Vali ve danışmanı mı? Umduğum yardım bu değildi. Haydutlara karşı savunmada çok fazla yardımınızın dokunacağını sanmıyorum. Diğer herkes silahlara!";
"T_SCENARIO_BESIEGEMENT_QUEST_01_END" = "Saldıran haydut grupları püskürtüldü! Öncülerimiz başka bir saldırı tespit edene kadar biraz dinlenebiliriz.";
"T_SCENARIO_BESIEGEMENT_QUEST_02_2_DESC" = "Kasabayı savunmak için daha fazla nöbetçi kulelerine ihtiyacımız var. Onları hemen inşa edin!";
"T_SCENARIO_BESIEGEMENT_QUEST_02_DESC" = "Vali, bir işe yarayıp daha fazla nöbetçi kulesi inşa etme emri verseniz nasıl olur?";
"T_SCENARIO_BESIEGEMENT_QUEST_03_DESC" = "Kışlamız yıkıldı, yenisini inşa etmeliyiz. Bence bu halledebileceğiniz bir iş Vali.";
"T_SCENARIO_BESIEGEMENT_QUEST_04_DESC" = "Lordum, Krala bir haberci göndermeyi öneriyorum. Ancak bir kılık değiştirmeye ihtiyacımız olacak. Hadi biraz kumaş ile başlayalım.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_DESC" = "Şimdi kılık değiştirme için biraz deriye ihtiyacımız var. Böylece daha çok haydut giysisine benzer.";
"T_SCENARIO_BESIEGEMENT_QUEST_05_NAME" = "Deri teslim edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_DESC" = "Sakal için biraz yün kullanacağız. Umarım bu habercinin Krala ulaşma şansını artırır.";
"T_SCENARIO_BESIEGEMENT_QUEST_06_NAME" = "Yün teslim edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_07_DESC" = "Böylece oturup Kraldan destek bekleyemeyiz. Kasaba nöbetçilerinin zırhları kötü durumda, kasabadaki savunmayı sağlamak için yenilerini üretmeliyiz. ";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_DESC" = "Ah hayır Lordum. Kışlamızı yıktılar. Askerlerimize tedarik sağlamak için onu yeniden inşa etmeliyiz.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_2_NAME" = "Kışlayı yeniden inşa edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_08_DESC" = "Haydutlar kışlamıza büyük bir saldırı yapmak için hazırlanıyor. Kışla çok önemli, yıkılmaması gerekiyor!";
"T_SCENARIO_BESIEGEMENT_QUEST_08_NAME" = "Kışlayı savunun.";
"T_SCENARIO_BESIEGEMENT_QUEST_09_DESC" = "Kralın ordusu henüz gelmedi. Daha fazla bekleyemeyiz. Bunun için yapabileceğimiz en keskin bıçaklara ihtiyacımız var yoksa kasaba bozguna uğrayacak.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_DESC" = "Vali, güneydoğu haydut kampı diğer kasabalara giden yolu kapatıyor. Daha fazla kasabalının bize yardım etmesini istiyorsak güneydoğudaki o kampı yok etmemiz gerekiyor.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_END" = "Haydut kampı yok edildi! Artık daha fazla kasabalı bize yardım edebilir.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "Güneydoğu haydut kasabasını yok edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "Lordum, tüccarın yerini bulmayı başardık. Kuzeybatıdaki nehrin yakınındaki kampta tutsak edilmiş.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "Lordum, tüccar yeniden güvende. Bundan sonra bizi yeniden düzenli olarak ziyaret edecek.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_NAME" = "Kuzeybatı haydut kampını yok edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_DESC" = "Lordum, haydutlar kuzeydoğu dağlarındaki kamptan gelen kavla kuşanmış. Onu yok edersek artık binalarımızı ateşe veremeyecekler.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_03_NAME" = "Kuzeydoğu haydut kasabasını yok edin.";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_DESC" = "Ana haydut kampı güneybatıda yer alıyor. Sonunda onu yok etmemize izin verirseniz haydutları teslim olmaya zorlayacağız. Hücum!";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_04_NAME" = "Güneybatı haydut kampını yok edin.";
"T_SCENARIO_BESIEGEMENT_SIDEQUEST_01_DESC" = "Ne kaba bir şövalye. Lordum, bu kasabanın ekonomisi açık şekilde çökmüş. Askerlerimiz ilk haydut gruplarını püskürttüğünde nüfusa daha fazla temel kaynak üretmesi için emir vermeye odaklanmalıyız.";
