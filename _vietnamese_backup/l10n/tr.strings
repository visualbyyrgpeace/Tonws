"T_LOADINGTIP_KEYBINDINGS_02" = "Çoğu oyun fonksiyonu için kısa yollar kullanabilirsiniz:\n\nHızlı ilerleme – {KEY_BINDING_FF}\nBina menüsü – {KEY_BINDING_BUILDMENU}\nGörev günlüğü – {KEY_BINDING_QUESTS}\nİstatistik – {KEY_BINDING_STATISTICS}\nNesneleri silin – {KEY_BINDING_SHOVEL}\nAraştırma – {KEY_BINDING_RESEARCH}\nEkran Görüntüsü – {KEY_BINDING_SCREENSHOT}\nMenü – {KEY_BINDING_INGAMEMENU}\nUyarılar – {KEY_BINDING_ALERTS}\nKasaba Dükkânı – {KEY_BINDING_TOWNSHOP}";
"T_LOADINGTIP_KEYBINDINGS_03" = "Kasabanızda bir olay olduğunda {KEY_BINDING_ALERTS} düğmesine basarak doğrudan uyarılara gidebilirsiniz.";
"T_LOADINGTIP_KEYBINDINGS_04" = "İstatistiklerin alt sayfalarına kısa yollarla doğrudan ulaşılabilir:\n\nTicaret – {KEY_BINDING_TRADE}\nDepolar – {KEY_BINDING_STOCK}\nMutluluk – {KEY_BINDING_HAPPINESS} \nAskeriye menüsü – {KEY_BINDING_MILITARY}\nKaynakları yok edin – {KEY_BINDING_DELETE} ";
"T_LOADINGTIP_KEYBINDINGS_05" = "Oyununuzu her zaman menüden veya {KEY_BINDING_QUICKSAVE} kısa yolundan kaydedebilirsiniz.";
"T_LOADINGTIP_KEYBINDINGS_06" = "Oyunda birçok anahtar bağlamalar bulunur. Menüde anahtar bağlamaların bir listesini bulabilirsiniz.";
"T_LOADINGTIP_PRESTIGE" = "Prestijin birden fazla kullanımı bulunur. Binaları yükseltmek, dekorasyonlar inşa etmek veya bina inşaatlarını hızlıca tamamlamak için harcanabilir.";
"T_LOADINGTIP_PRESTIGEFEATURES" = "Bazı binaların içerik menülerinde güçlü özellikleri bulunur.\n\nBu binalar: Marangoz dükkânı, maliye, revir, yangın kulesi ve madendir.";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP" = "Kalıcı olarak İki Kat DP kazanmaya ne dersiniz?\n\nYeni kasaba seviyelerine çok daha hızlı ulaşın ve yeni ve güçlü araştırma seçeneklerinin kilidini açın!\n\nNeyi bekliyorsunuz? Kasaba dükkânını ziyaret edin!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_02" = "Oyunu oynarken iki katı DP kazanmak için "iki kat DP"yi kullanın!\nBu, sonraki kasaba seviyesine daha hızlı ulaşmanıza yardımcı olacak ve yeni güçlü araştırma seçeneklerinin kilidini açacaktır!";
"T_LOADINGTIP_PURCHASE_DOUBLE_XP_03" = "İki kat DP güçlendiricisini kullanarak daha fazla DP kazanın ve yeni kasaba seviyelerine daha hızlı ulaşın!";
"T_LOADINGTIP_PURCHASE_FASTFORWARD" = "Sınırsız hızlı ilerleme elde edin, kalıcı olarak!\n\nİstediğiniz kadar 5 katı daha fazla hızla oynayın!\nHızlı ilerleme süresi için bir daha asla Prestij harcamayın!\n\nNeyi bekliyorsunuz? Kasaba dükkânını ziyaret edin!";
"T_LOADINGTIP_PURCHASE_NOADS" = "Ad bannerları veya araları sevmiyor musunuz? Reklamsız sürüme ne dersiniz?\n\nTownsmen'i reklamsız oynayın, sonsuza kadar!\n\nNeyi bekliyorsunuz? Kasaba dükkânını ziyaret edin!";
"T_LOADINGTIP_PUSH_NOTIFICATIONS" = "Mobil cihazınız kasabalılarınız kayıp olduğunda ve toplanacak bir prestij ödülü olduğunda size bildirim gönderecek.\nTownsmen uygulama seçeneklerinden bildirimleri devre dışı bırakabilirsiniz. ";
"T_LOADINGTIP_REFILLDEPOSIT" = "Bir madenin kaynak yatağı tükendiğinde birkaç seçeneğiniz bulunur. \n-Prestij ile madeni yeniden doldurun\n- Başka bir yatak arayın ve oraya yeni bir maden inşa edin\n- Jeoloğu görevlendirin (araştırma ile kilidi açılabilir)";
"T_LOADINGTIP_REPAIRALL" = "Marangoz dükkânı kasabadaki tüm binaları tek bir tıklama ile onarmanıza olanak sağlar. Prestij puanı masrafı toplamda ne kadar binanın onarılması gerektiğine bağlı olarak değişiklik gösterir.";
"T_LOADINGTIP_YOUTUBE_GENERIC" = "Townsmen Youtube kanalımızdaki eğitim ve oyun videolarını izleyebilirsiniz, bunun için yalnızca ana menüdeki Youtube düğmesini seçin.";
"T_LOADINGTIP_YOUTUBE_MOUSE" = "Ana menüden Townsmen Youtube kanalımızdaki eğitim ve oyun videolarını izleyebilirsiniz. Yalnızca Youtube düğmesine tıklayın.";
"T_LOADINGTIP_YOUTUBE_TOUCH" = "Ana menüden Townsmen Youtube kanalımızdaki eğitim ve oyun videolarını izleyebilirsiniz. Yalnızca Youtube düğmesine dokunun.";
