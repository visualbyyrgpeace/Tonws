"T_RANDOM_EVENT_MINE_ACCIDENT_MESSAGE_OUT_OF_TIME" = "Sör, şansımızı kaçırdık. Altın yatağının olduğu bölge artık ulaşılamaz. ";
"T_RANDOM_EVENT_MINE_ACCIDENT_ON_THE_WAY" = "Adamlar şimdi tehlikeli bölgeye gidiyorlar sör. Yakında başarılı olup olmadıklarını öğreneceğiz.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_01_BAD_A" = "Son anda ekip lideri gaz kaçağını görüyor… Ancak artık çok geç, adamlardan birisi meşalesini gaz kaçağına doğru tutuyor. Madende başka bir patlama daha gerçekleşiyor… Kurtarma operasyonu başarısız.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_01_BAD_B" = "Lordum, madeni kaybettik. Kurtarma ekibi, madenciler ve madendeki kaynakları kaybettik. Tüm köy oldukça üzgün ve madendeki tüm iş bir süreliğine kesintiye uğrayacak.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_01_GOOD_A" = "Son saniyede birlik lideri gaz kaçağını görüyor ve tüm meşalelerin söndürülmesi emrini veriyor. Kısa süre içinde birlik sıkışan işçilere ulaşıyor ve kurtarma işine başlıyor. ";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_01_GOOD_B" = "Sör, madencileri kurtarabildik. Herkes iyi durumda ama madeni kaybettik. Tüm köyün morali oldukça iyi ama madendeki tüm iş bir süreliğine kesintiye uğrayacak.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_01_START" = "Kurtarma ekibi yavaşça madenin dar taraflarına doğru ilerliyor. Zifiri karanlık. Buhar ve kokulu gazlar yerde toplanmış, nefes almak zorlaşıyor.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_02_A" = "Kurtarma ekibi kaynaklara ulaşıyor ve kurtarmayı başlatıyor. Ekip lideri biraz uzaktan sıkışan madencilerin yardım çığlıklarını duyuyor ancak görev öncelikleri açıkça verilmişti. Kaynakları oradan çıkartın! ";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_02_B" = "Bir süre sonra ekip maden tam da çöküp sıkışan tüm işçileri gömmeden önce mallarla geri dönüyor.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_03_A" = "Sör, köydeki moral hiç iyi değil. Ailelere verilen telafiye rağmen tüm sakinler oldukça endişeli. Birilerinin yeniden madenlerde çalışması uzun sürecek.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_03_B" = "Sör, nüfus hayal kırıklığına uğradı. Artık kimse madenlerde çalışmak istemiyor. Korkarım Kasabalılar uzun bir süre yas tutacak.";
"T_RANDOM_EVENT_MINE_ACCIDENT_OUTCOME_04" = "Lordum, insanlar sinirli. Kimse artık madenlerde çalışmak istemiyor. Korkarım Kasabalılar sinirlerini köyden çıkartacak. Tetikte olmalıyız. ";
"T_RANDOM_EVENT_MINE_ACCIDENT_REPLY_01" = "Madencileri serbest bırakmak için bir kurtarma görevi başlatın.";
"T_RANDOM_EVENT_MINE_ACCIDENT_REPLY_02" = "Kaynakların önceliği var, işçiler zayi olsun.";
"T_RANDOM_EVENT_MINE_ACCIDENT_REPLY_03" = "Oraya hiç kimseyi göndermeyeceğiz! Ailelerine telafisini yapın.";
"T_RANDOM_EVENT_MINE_ACCIDENT_REPLY_04" = "Pekâlâ, madenlerde hayat tehlikelidir.";
"T_RANDOM_EVENT_MINE_ACCIDENT_RESCUEMESSAGE_NO_TIME" = "Sör, maden tamamen yıkılma tehlikesiyle karşı karşıya. Yalnızca sınırlı süremiz kaldı. Acele etmeliyiz!";
"T_RANDOM_EVENT_MINE_ACCIDENT_RESCUEMESSAGE_TIMER_SUMMARY" = "Süre dolmadan önce kayıp madencileri kurtarın.";
"T_RANDOM_EVENT_MINE_ACCIDENT_RESCUEMISSION_DESC" = "Gömülü madencileri kurtarmak için kurtarma ekibinin birkaç ekipmana ihtiyacı var.";
"T_RANDOM_EVENT_MINE_ACCIDENT_RESCUEMISSION_EQUIPMENT_READY_DESC" = "Lordum, gerekli ekipman şimdi depoya ulaştı. Madene gitmeleri için kurtarma ekibini bilgilendirmeli miyim?";
"T_RANDOM_EVENT_MINE_ACCIDENT_SECOND CHOICE_ASK" = "Şu seçeneklere sahibiz, vali.\n\nYa tüm yatağı açarız ve her şeyi kaybetme riskini alıp yatağın yarısını dikkatlice çıkarmaya çalışırız ya da bölgeden tamamen kaçar ve bu şansı kaçırırız.";
"T_RANDOM_EVENT_MINE_ACCIDENT_SEND_GOODS" = "Malları gönderin";
"T_RANDOM_EVENT_MINE_ACCIDENT_SEND_MONEY" = "Paralar gönderin";
"T_RANDOM_EVENT_MINE_ACCIDENT_STARTER_ASK_01" = "Lordum, madenlerimizden birisinde büyük bir altın yatağı keşfedildi. Ne var ki gaz kaçağından dolayı sık sık dengesiz olan tehlikeli bir bölgede.";
"T_RANDOM_EVENT_MINE_ACCIDENT_STARTER_ASK_02" = "Zamanında ilave aletler sağlayıp alan tekrar dengesiz hale gelmeden önce acele edersek adamlar yatağı kullanabilirler. Lordum, bu köy için zenginlik anlamına gelebilir!";
