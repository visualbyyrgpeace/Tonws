"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_001" = "Modern tıp.";
"T_GAME_QUEST_DOCTORS_GRANDMA_ANSWER_002" = "Büyükanne devaları.";
"T_GAME_QUEST_DOCTORS_GRANDMA_CONSEQUENCE_002" = "Hekim büyük bir öfkeyle reviri yok etmeye karar verdi! "Büyükannelerinizin devalarını seçecekseniz, artık laboratuvarıma ihtiyacınız yok!" dedi.";
