"T_GAME_QUEST_DESIRES_01_TITLE" = "Eşinizin rahat hissettiğinden emin olun.";
"T_GAME_QUEST_DESIRES_02_START" = "Bu köyün ayrıca bir terzi dükkânına ihtiyacı var, böylece terzi dikimi yeni kıyafetlerim olabilir.";
"T_GAME_QUEST_DESIRES_02_SUCCESS" = "Teşekkürler sevgilim!\nEski kıyafetlerim zaten yırtık pırtık olmuştu.";
"T_GAME_QUEST_DESIRES_03_START" = "Şehrin hareketli aktivitelerini özledim.\nLütfen, bu kasabayı canlandırmak için daha fazla insan yerleştirin!";
"T_GAME_QUEST_DESIRES_03_TITLE" = "Nüfusu artırın.";
"T_GAME_QUEST_DESIRES_04_START" = "Oho, canlı ve güzel bir köy!\n\nBuraya yerleşmem konusunda kesinlikle hiçbir itirazınız olmayacak.";
"T_GAME_QUEST_DESIRES_05_START" = "Ormanda haydutlar mı var!?\nO kötü adamları püskürtmek için bir kasaba devriyesi oluşturun!";
"T_GAME_QUEST_DESIRES_06_START" = "Oho, bir nöbetçi kulesi…\n\nŞunu bilmelisiniz, böyle davranışlar benim adamlarımı yalnızca kışkırtır!";
"T_GAME_QUEST_DESIRES_07_FAIL" = "Şu haydutlar kasabada sorun çıkarıyor.\n\nHemen kasaba nöbetini güçlendirmenizi istiyorum!";
"T_GAME_QUEST_DESIRES_07_START" = "Lütfen nöbetçilerimizin haydutları şehre sokmayacağından emin olun!";
"T_GAME_QUEST_DESIRES_07_SUCCESS" = "Muhteşem! Artık çok daha güvende hissediyorum.";
