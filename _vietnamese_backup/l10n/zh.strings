"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_01_NAME" = "捣毁土匪东南方营地。";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_DESC" = "大人，我等设法寻到那个商人的踪迹。他被囚禁在西北河边的土匪营地。";
"T_SCENARIO_BESIEGEMENT_QUEST_CAMPQUEST_02_END" = "大人，商人又安全了。从此以后，他会定期到我们这里来了。";
