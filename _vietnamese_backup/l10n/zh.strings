"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES" = "接受。";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_001" = "我要给矿工们打造工具，这是笔大单子。";
"T_GAME_QUEST_WOMAN_MINE_TOOLMAKER_COME_DECISION_001_YES_002" = "这些就是晶洞玉石。你看，用这个工具就能把它打开。有时候里面什么都没有，但也有时候会发生奇迹！";
