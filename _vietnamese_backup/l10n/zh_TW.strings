"T_GAME_QUEST_SCEN16_02_START" = "國王剛剛要求村莊上交小麥。\n我們需要更多農田，才能滿足龐大的需求量。";
"T_GAME_QUEST_SCEN16_02_SUCCESS" = "大人，倉庫中的小麥足夠上交之用了。";
"T_GAME_QUEST_SCEN16_03_START" = "國王需要資源修建更多倉庫。\n請把所需的材料交給國王。";
"T_GAME_QUEST_SCEN16_03_SUCCESS" = "先提供國王需要的材料，然後才能發送其他貨物。";
"T_GAME_QUEST_SCEN16_03_TITLE" = "向倉庫提供建物材料。";
"T_GAME_QUEST_SCEN16_04_1_START" = "第一批貨物已經腐爛了。請在清除城鎮的疾病後，重新運送一批新貨物。";
"T_GAME_QUEST_SCEN16_04_1_SUCCESS" = "真棒，大人！新鮮的肉類已經備好，可以發運了。";
"T_GAME_QUEST_SCEN16_04_1_TITLE" = "發送肉類。";
"T_GAME_QUEST_SCEN16_04_1_TITLE_NEW" = "一旦病有起色，就送肉食過去。";
"T_GAME_QUEST_SCEN16_04_START" = "現在國王需要肉類。\n如果獵人數量充足，這是小菜一碟。";
"T_GAME_QUEST_SCEN16_04_SUCCESS" = "很好，大人。倉庫中的資源已經達到需求數量。";
"T_GAME_QUEST_SCEN16_04_TITLE" = "建造更多獵人小屋並提供肉類。";
"T_GAME_QUEST_SCEN16_05_START" = "國王計畫舉辦一場宴會。因此，他希望我們提供一些美酒。\n請向皇宮運送啤酒和果汁。";
"T_GAME_QUEST_SCEN16_05_SUCCESS" = "很好，大人。我們已經儲備了足夠的釀酒和葡萄汁。";
"T_GAME_QUEST_SCEN16_05_TITLE" = "發送啤酒和果汁。";
"T_GAME_QUEST_SCEN16_06_START" = "國王對我們的貨物很滿意。\n他想讓我們也供應一些食物。\n\n請為皇家宴會提供果汁和麵包。 ";
"T_GAME_QUEST_SCEN16_06_SUCCESS" = "好極了，大人。這已經是最後一批貢品。";
"T_GAME_QUEST_SCEN16_06_TITLE" = "送香腸和麵包。";
"T_GAME_QUEST_SCEN16_06_TITLE_2" = "發送果汁和麵包。";
"T_GAME_QUEST_SCEN16_08_START" = "這真是一場災難，大人！我們的小麥感染了奇怪的病毒，全部都變質了！";
"T_GAME_QUEST_SCEN16_09_START" = "鎮民染上了可怕的瘟疫。\n我們要是再不採取措施，就沒有工人可供差遣了！";
"T_GAME_QUEST_SCEN16_09_SUCCESS" = "這場瘟疫似乎是由患病的動物引起的。向國王進獻的物資也受到了感染。\n我們必須重新發送新的物資！";
"T_GAME_QUEST_SCEN16_09_TITLE" = "在醫生的幫助下消滅城鎮中的瘟疫。";
"T_GAME_QUEST_SCEN16_10_START" = "神靈在與我們作對。瘟疫讓所有野生動物滅絕。我們應該如何為城鎮提供食物並滿足國王的要求？";
"T_GAME_QUEST_SCEN16_11_START" = "現在，我們需要飼養家畜為鎮民提供食物。\n所以，我們需要建造一座養豬場和一座屠宰場。";
"T_GAME_QUEST_SCEN16_11_SUCCESS" = "家豬以小麥為食。向商人購買一些小麥，以便我們可以繼續向國王供應物資。";
"T_GAME_QUEST_SCEN16_11_TITLE" = "建造一座養豬場和一座屠宰場。";
"T_GAME_QUEST_SCEN16_12_1_START" = "你應該知道，我的存貨是非常搶手的。\n從現在起，我的小麥只交換鐵礦石。";
"T_GAME_QUEST_SCEN16_12_1_SUCCESS" = "把鐵礦石運送過來，我的另一批小麥很快就到貨了。";
"T_GAME_QUEST_SCEN16_12_1_TITLE" = "用鐵礦石交換小麥。";
"T_GAME_QUEST_SCEN16_12_2_START" = "我能以低的離譜的價格賣給你王國中僅剩的一些小麥！";
"T_GAME_QUEST_SCEN16_12_2_SUCCESS" = "很高興為你效勞，大人。只要你給我黃金，我願意試著幫你再搜集些小麥。";
"T_GAME_QUEST_SCEN16_12_2_TITLE" = "用黃金交換小麥。";
"T_GAME_QUEST_SCEN16_12_MERCHANT" = "我聽說了你的不幸遭遇，想和你做筆交易。我還有一些小麥存貨，想用來交換貨物。";
"T_GAME_QUEST_SCEN16_12_START" = "我當然願意用小麥交換石料。";
"T_GAME_QUEST_SCEN16_12_SUCCESS" = "看起來你有不少貨物可以用來交換，我還想和你再做筆生意。";
"T_GAME_QUEST_SCEN16_12_TITLE" = "用石料交換小麥。";
"T_GAME_QUEST_SCEN2_10_DESC" = "有沒有吃過我侄兒烤的麵包？您一定要嘗嘗！讓他多烤制些麵包，以備嚴冬之用！";
"T_GAME_QUEST_SCEN2_10_NAME" = "烤制 50 條麵包。";
"T_GAME_QUEST_SCEN2_11_1_NAME" = "建立一個紡織廠。";
"T_GAME_QUEST_SCEN2_11_2_NAME" = "建立一個裁縫店。";
"T_GAME_QUEST_SCEN2_11_DESC" = "告訴我，您和我們一樣冷嗎？我妻子得了流感，就是她裙子上的那些破洞造成的。或許您能幫助我們做一些禦寒的衣服？";
"T_GAME_QUEST_SCEN2_11_NAME" = "建造一座牧羊場。";
"T_GAME_QUEST_SCEN2_12_DESC" = "我覺得過冬的準備工作我們幾乎完全做好了！但是，只是我和您私下裡說說，外面天寒地凍，到那家舒適的酒館裡來一杯果汁不是很美的享受嗎？";
"T_GAME_QUEST_SCEN2_12_NAME" = "建造一座果汁製造廠，生產 50 缸果汁。";
"T_GAME_QUEST_SCEN2_1_DESC" = "幹事先生！我不想無禮，但是很不幸，我們缺少農場！在寒冬降臨之前，我們怎樣才能收割所有的小麥呢？";
"T_GAME_QUEST_SCEN2_1_NAME" = "建造兩座農場。";
"T_GAME_QUEST_SCEN2_2_DESC" = "Brrrr! 我已經凍僵了，親愛的幹事先生！我確信即將到來的冬天會非常寒冷！我和我妻子希望您別忘了保證充足的木材取暖。";
"T_GAME_QUEST_SCEN2_2_NAME" = "興建三個伐木工營地。";
"T_GAME_QUEST_SCEN2_3_DESC" = "謝謝您！如果您見到我的兄弟們，請代我向他們轉達我的問候！告訴他們要盡可能多地儲存木材！";
"T_GAME_QUEST_SCEN2_3_NAME" = "獲得35個木材值。";
"T_GAME_QUEST_SCEN2_4_DESC" = "我們終於可以收割莊稼了！希望糧食能夠滿足我們的需求！";
"T_GAME_QUEST_SCEN2_4_NAME" = "收穫 35 個小麥值。";
"T_GAME_QUEST_SCEN2_5_DESC" = "莊稼多充裕啊！這些小麥我們都沒有地方存了！最好還是用小麥做些麵包吧！";
"T_GAME_QUEST_SCEN2_5_NAME" = "興建一座風磨坊並磨製麵粉。";
"T_GAME_QUEST_SCEN2_6_DESC" = "親愛的幹事先生，我們確實喜歡住在這兒，可是我們擔心嚴冬來臨，我們的房子可能無法抵禦漫長的嚴寒呢。";
"T_GAME_QUEST_SCEN2_6_NAME" = "維修和保養好所有的房屋。";
"T_GAME_QUEST_SCEN2_7_DESC" = "我還是有點擔心...我們沒有儲備任何工具。您肯定知道修繕房屋時工具有多重要！就請您幫我們弄些工具如何？";
"T_GAME_QUEST_SCEN2_7_NAME" = "交付 50 件工具作為貢品。";
"T_GAME_QUEST_SCEN2_8_DESC" = "我擔心我的兄弟們自己無法完成所有的工作...或許您可以想辦法為我們村增派些工人?";
"T_GAME_QUEST_SCEN2_8_NAME" = "人口值增加到 50。";
"T_GAME_QUEST_SCEN2_9_DESC" = "我的鼻子上都結冰了...但是有些正在尋找安身之處的旅人們情況更糟糕。我覺得我們應該允許他們在我們村住下來。";
"T_GAME_QUEST_SCEN2_9_NAME" = "建造6座連棟宅邸。";
"T_GAME_QUEST_SCEN3_10_DESC" = "親愛的，最好別忘了明天是我們的結婚和日子！我真想買些新的首飾！要是您認識一個金匠就好了...... ";
"T_GAME_QUEST_SCEN3_10_NAME" = "興建一間金匠鋪。";
"T_GAME_QUEST_SCEN3_11_DESC" = "有了新工具，我確信國王和您的鎮民一定會很高興！那些舊工具都鏽跡斑斑用不成了。";
"T_GAME_QUEST_SCEN3_11_NAME" = "興建一座工具匠作坊。";
"T_GAME_QUEST_SCEN3_12_1_NAME" = "建造裁縫鋪並生產衣服。";
"T_GAME_QUEST_SCEN3_12_DESC" = "噢，瞧那些可愛的羊！親愛的，看見它們了嗎？看那些已經從羊身上剪下來的羊毛！現在我們只缺一座紡織廠和一間裁縫鋪了！";
"T_GAME_QUEST_SCEN3_12_NAME" = "興建一座紡織廠並製作布料。";
"T_GAME_QUEST_SCEN3_13_DESC" = "孩子們真的興奮，他們期盼著很快吃到新鮮麵包呢！親愛的，您已經興建了幾座麵包屋了，對嗎？";
"T_GAME_QUEST_SCEN3_14_DESC" = "您猜怎麼著？我妹妹終於想要結婚了！但是我們鎮上還需要興建一座教堂！不光是為了舉辦婚禮儀式，也是為了我們虔誠的鎮民們考慮！";
"T_GAME_QUEST_SCEN3_14_NAME" = "達到高度虔誠的滿足。";
"T_GAME_QUEST_SCEN3_15_DESC" = "現在您看，親愛的！ 這個城鎮已經恢復了生機,一切都運行良好！所以我允許您和您的朋友們放鬆一下。如果您喜歡就建個酒館吧！";
"T_GAME_QUEST_SCEN3_15_NAME" = "達到高度的酒館滿意度。";
"T_GAME_QUEST_SCEN3_1_DESC" = "親愛的,您看看這個破敗的村莊...... 那些可憐的鎮民，我真為他們難受！我覺得您應該求求國王！也許給國王送些禮物，您就能說服他！ ";
"T_GAME_QUEST_SCEN3_1_NAME" = "向國王進獻，完成所有任務。";
"T_GAME_QUEST_SCEN3_2_DESC" = "在國王派人來幫助前，您應該把這些事兒承擔起來！鎮民們迫切地需要更多的水！";
"T_GAME_QUEST_SCEN3_2_NAME" = "在您的村中鑿一口井。";
"T_GAME_QUEST_SCEN3_3_DESC" = "您的前任甚至連充足的食物都提供不了！真讓人無法相信！親愛的，您得立即改變這個局面！為什麼不建造一些漁農小屋呢？";
"T_GAME_QUEST_SCEN3_3_NAME" = "建造兩座漁農小屋。";
"T_GAME_QUEST_SCEN3_4_DESC" = "那些可憐的孩子...親愛的，光給他們吃魚肉是不行的！您應該建幾座農場，這樣我們就有小麥麵粉來烤麵包了！";
"T_GAME_QUEST_SCEN3_4_NAME" = "興建兩座農場並種植小麥。";
"T_GAME_QUEST_SCEN3_5_1_NAME" = "興建一間冶煉廠。";
"T_GAME_QUEST_SCEN3_5_DESC" = "嘿，親愛的，您沒忘了什麼事兒吧？您不是打算給國王送些禮求他幫助我們嗎？有了我，您真的很幸運呢...我們一定要開一座礦，再建一座冶煉廠，那樣才能生產出有價值的東西來。";
"T_GAME_QUEST_SCEN3_5_NAME" = "開一座礦。";
"T_GAME_QUEST_SCEN3_6_DESC" = "您所有的鎮民都勞累過度！難道您就不能造些新的連棟宅邸吸引更多的工人來嗎？";
"T_GAME_QUEST_SCEN3_6_NAME" = "建造三座連棟宅邸。";
"T_GAME_QUEST_SCEN3_7_DESC" = "噢，我好開心！光景越來越好向了！現在我們甚至可以向鎮民收取更多的稅金了。";
"T_GAME_QUEST_SCEN3_7_NAME" = "稅收進帳 1500 泰勒幣。";
"T_GAME_QUEST_SCEN3_7_NAME_NEW" = "徵稅，收足泰勒幣。";
"T_GAME_QUEST_SCEN3_8_DESC" = "您知道還有什麼值得擁有的? 一些新衣服! 我是說,主要是為國王製作些衣服，當然...... 但是首先，我們需要幾座牧羊場，這樣我們就可以收穫羊毛了！ ";
"T_GAME_QUEST_SCEN3_8_NAME" = "興建兩座牧羊場。";
"T_GAME_QUEST_SCEN3_9_DESC" = "農民們已經在辛苦地收割小麥了！現在您可以興建一個風磨坊，這樣我們就能磨麵粉來烤麵包了！";
"T_GAME_QUEST_SCEN3_9_NAME" = "建造一個磨坊並生產麵粉。";
"T_GAME_QUEST_SCEN4_10_DESC" = "我目前這座城堡已有損於我皇室的威嚴，我計畫大力擴建我的避暑莊園。 \n\n作為國王，我命令您們運來大量的石料。 您是可靠的，我就指望您了，我的好管事。";
"T_GAME_QUEST_SCEN4_10_NAME" = "向國王進獻一車石頭。";
"T_GAME_QUEST_SCEN4_11_DESC" = "酷熱難當，我們的家園損失慘重。 房屋破敗不堪，許多家庭要求改善住房條件。\n\n如果您能把改善鎮周圍建築物的條件納入考慮，那就太好了。";
"T_GAME_QUEST_SCEN4_11_NAME" = "獲得很高的建築狀況幸福點數。";
"T_GAME_QUEST_SCEN4_12_DESC" = "我的好管事，我還等著您給我送來葡萄汁呢。 我很快就要舉辦宴會了。";
"T_GAME_QUEST_SCEN4_12_NAME" = "向國王交付葡萄汁。";
"T_GAME_QUEST_SCEN4_13_DESC" = "閣下，王國之內，麵粉極度緊缺。 農場生產的糧食無法滿足磨坊的工作負荷。\n\n假如您能為我提供充足的麵粉，我就可能囤積居奇，壟斷這一地區的市場。 當然，我對您的獎勵也是很可觀的。";
"T_GAME_QUEST_SCEN4_13_NAME" = "向商人交付個點數的的麵粉。";
"T_GAME_QUEST_SCEN4_14_DESC" = "鎮民們要求搭建遮蔭棚，以便在白躲避灼熱的驕陽。 我們應該為他們提供厚木板，這樣他們就可以馬上開工了。";
"T_GAME_QUEST_SCEN4_14_NAME" = "生產35個點數的的厚木板。";
"T_GAME_QUEST_SCEN4_15_DESC" = "大人，您做得好。 城鎮發展的規模真是值得讚揚的。\n\n然而，由於乾旱，鎮民們還是不幸福。 您應該滿足他們更多的願望，以此來提高幸福點數。 當然，這只是個小小的建議……";
"T_GAME_QUEST_SCEN4_15_NAME" = "在您的城鎮獲得了很高的幸福點數。";
"T_GAME_QUEST_SCEN4_15_SUCESS" = "真是好極了，我的好管事！\n儘管遭遇乾旱，您還是成功地建成了一座宏偉的城市。 您的鎮民們看到城市的變化，真的很開心。\n\n作為您的國王，我對您的工作非常滿意。 您為王國立下了汗馬功勞，應該予以重賞。";
"T_GAME_QUEST_SCEN4_1_DESC" = "大人，鎮民們正生活在貧窮和苦難當中呢。 王國之內正遭遇著乾旱呢。 您看看城堡旁流過的那條河，它曾經是多麼浩浩蕩蕩啊。 現在河水只剩下星星點點的水窪了。\n國王已經發下令來，命令我們擴建城池。 我們先增建一些城鎮連棟宅邸吧。";
"T_GAME_QUEST_SCEN4_1_NAME" = "增建8幢城鎮連棟宅邸。";
"T_GAME_QUEST_SCEN4_1b_DESC" = "君主閣下，國王聽說城池擴建一帆風順，十分喜悅，不過他命令我們建造更大的城池。";
"T_GAME_QUEST_SCEN4_1b_NAME" = "總人口達到100。";
"T_GAME_QUEST_SCEN4_2_DESC" = "尊敬的管事閣下，您目前身處困境，作為商人，我可能幫您解決燃眉之急哦。 \n王國可能要遭受旱災，不過，只要您一建好市場，我便可以向您的城鎮投放大量的必需物資。";
"T_GAME_QUEST_SCEN4_2_NAME" = "獲得高的市場幸福值。";
"T_GAME_QUEST_SCEN4_3_DESC" = "我求求您了，大人，請您下令再多打幾口井，這樣，村民在這樣的高溫下才會有足夠的水喝。";
"T_GAME_QUEST_SCEN4_3_NAME" = "打2口井。";
"T_GAME_QUEST_SCEN4_4_DESC" = "我的君主，我給您帶來了好消息。 有一個鎮民發現，乾涸的河床上，有些水窪裡還有魚。 \n\n我們應該命人再修建幾座漁農小屋。";
"T_GAME_QUEST_SCEN4_4_NAME" = "修建2座漁農小屋。";
"T_GAME_QUEST_SCEN4_5_DESC" = "尊敬的管事大人，我想與您做一筆交易。\n\n假如擴大我們之間的貿易關係，我可以為您的城鎮定期供應食物。";
"T_GAME_QUEST_SCEN4_5_NAME" = "通過市場銷售賺得1000個泰勒幣。";
"T_GAME_QUEST_SCEN4_6_DESC" = "我又來了，想再與您做一筆交易。 我現在迫切需要煤。 如果您為我供煤的話，我願意用一大袋泰勒幣作為交換。";
"T_GAME_QUEST_SCEN4_6_NAME" = "向商人交付個點數的煤炭。";
"T_GAME_QUEST_SCEN4_7_DESC" = "管事，我的宮殿裡急需葡萄汁。 我的王國現在旱情嚴重，我們的葡萄幾乎顆粒無收。\n\n我命令您建造一座果汁釀造廠。 我計畫不久在城堡裡舉辦宴會，不要讓我失望!";
"T_GAME_QUEST_SCEN4_7_NAME" = "興建一座果汁製造廠並生產果汁。";
"T_GAME_QUEST_SCEN4_8_DESC" = "閣下，這乾旱龜裂的土壤，我一家人幾乎無法耕種。 幾乎長不出什麼莊稼，所以一個農場是不夠的。";
"T_GAME_QUEST_SCEN4_8_NAME" = "另外開墾了一片農場。";
"T_GAME_QUEST_SCEN4_9_DESC" = "我們的麵包儲備快要斷貨了，我的君主。 我們應該為鎮民多供應肉，以此來減少麵包消耗。";
"T_GAME_QUEST_SCEN4_9_NAME" = "生產足夠的肉。";
"T_GAME_QUEST_SCEN4_MAIN_NAME" = "完成所有的任務，克服抽水的困難，把城鎮發展成一座大城市！";
"T_GAME_QUEST_SCEN5_10_DESC" = "大人，現在萬事俱備，只欠東風。那就是慶功宴上的葡萄汁！\n\n請運送充足的葡萄汁到部隊的營房去！";
"T_GAME_QUEST_SCEN5_10_NAME" = "向騎士交付45個點數的的葡萄汁。";
"T_GAME_QUEST_SCEN5_11_DESC" = "君主，您太了不起了！\n布蘭肯•施泰因勳爵這一仗大獲全勝，他對您及您的大力協助大為讚賞。\n\n在我離開此地之前，您想不想最後再作一筆交易？";
"T_GAME_QUEST_SCEN5_11_NAME" = "通過貿易獲得的利益達到2500個泰勒幣。";
"T_GAME_QUEST_SCEN5_1_DESC" = "君主，真是個美好的早晨。 告訴您一個好消息。 一個自由貿易商聯繫過我們了。\n\n他馬上到我們鎮上來，他說他需要厚木板用來搭建市場貨攤。 ";
"T_GAME_QUEST_SCEN5_1_NAME" = "生產30個點數的的厚木板。";
"T_GAME_QUEST_SCEN5_2_DESC" = "大人，您在這裡設立的交易站真不錯。 不過，還缺一樣至關重要的東西，那就是酒館。 如果建起酒館，更多的商人及遊客就會聞風而來。";
"T_GAME_QUEST_SCEN5_2_NAME" = "達到高度的酒館滿意度。";
"T_GAME_QUEST_SCEN5_3_DESC" = "很好，閣下。 將來酒館還會開開闢許多商機。\n現在到了我們計畫的有趣的階段。 我們來進行商品交易……";
"T_GAME_QUEST_SCEN5_3_NAME" = "通過貿易獲得的利益達到1500個泰勒幣。";
"T_GAME_QUEST_SCEN5_4_DESC" = "君主，能不能進些面料呢？ 我有一位交易夥伴，對面料生意非常感興趣。\n\n我在旅行時，還認識了一位元騎士。 他也是趕往這裡的，而且他會給您們帶來一些有趣的任務。";
"T_GAME_QUEST_SCEN5_4_NAME" = "在您的倉庫裡儲備35個單位的布料。";
"T_GAME_QUEST_SCEN5_5_DESC" = "大人！ 我叫庫尼貝特，我是國王受膏的騎士。\n\n您設立的交易站十分有利於我趕走這一帶的土匪。 能否請您為我提供石料，我可以建造瞭望塔，來守衛這一地區？";
"T_GAME_QUEST_SCEN5_5_NAME" = "向騎士交付50個點數的的石料。";
"T_GAME_QUEST_SCEN5_6_DESC" = "我的管事大人，我的武器匠急需鋼鐵來為我的部隊鑄劍。\n\n在您的交易站附近有好幾處礦床。 您能不能向我的僕人提供一批鐵礦石呢？";
"T_GAME_QUEST_SCEN5_6_NAME" = "為騎士交付65個點數的的鋼鐵。";
"T_GAME_QUEST_SCEN5_7_DESC" = "閣下，我遇到了難題。 上次在與土匪戰鬥中，有些步兵把盔甲弄壞了。 \n\n請儲備一些工具，這樣我的士兵們在參觀交易站時，就可以順便來修理他們的盔甲了。";
"T_GAME_QUEST_SCEN5_7_NAME" = "生產25個點數的的工具。";
"T_GAME_QUEST_SCEN5_8_DESC" = "我的管事大人，我有好消息！ 我的戰役大獲全勝，土匪已經從該地區驅逐出去了。\n\n在這次漫長的戰役中，我們所有的食物儲備都耗盡了。 我需要您為我的軍隊送些糧食。";
"T_GAME_QUEST_SCEN5_8_NAME" = "向騎士交付25個點數的的魚肉，及25個點數的的麵包。";
"T_GAME_QUEST_SCEN5_9_DESC" = "小人手下的部隊需要歡慶剿匪勝利。既然強盜已敗，小人手下的人也就開始惹是生非了。\n\n主人，您可否在城裡建設娛樂場所？";
"T_GAME_QUEST_SCEN5_9_DESC_DEPRECATED" = "我的軍隊想要慶祝剿匪勝利，現在既然土匪已經趕跑了，我的戰士們就變得無事可幹，煩燥不安。 \n\n您能否建造競技場，讓戰士們消耗一部分過剩的精力？";
"T_GAME_QUEST_SCEN5_9_NAME_DEPRECATED" = "對競技場達到高度的滿意度。";
"T_GAME_QUEST_SCEN5_MAIN_NAME" = "完成所有這些任務就能設立一個交易站！";
"T_GAME_QUEST_SCEN5_SUCESS" = "君主，真了不起！ \n您在此戰略要地成功地設立了一個交易站。 國王和布蘭肯•施泰因勳爵對您的工作及您在該地區的剿匪戰役中的鼎力協助很滿意。";
"T_GAME_QUEST_SCEN6_1_DESC" = "國王下了一道命令！ 他需要巨量的建築材料來建造一座大教堂！ 這座不朽的建築業已動工，所以我們應該儘快運送物資。";
"T_GAME_QUEST_SCEN6_1_NAME" = "為建造大教堂運送物資。";
"T_GAME_QUEST_SCEN6_2_1_NAME" = "用羊毛交換魚肉。";
"T_GAME_QUEST_SCEN6_2_2_NAME" = "用鐵礦石交換魚肉。";
"T_GAME_QUEST_SCEN6_2_3_NAME" = "用葡萄汁交換魚肉。";
"T_GAME_QUEST_SCEN6_2_4_NAME" = "用金礦石交換魚肉。";
"T_GAME_QUEST_SCEN6_2_NAME" = "用厚木板交換魚肉。";
"T_GAME_QUEST_SCEN6_2_START_DESC" = "我能看出附近並沒有湖泊或河流，所以您無法生產魚。 建一座市場，我可以用魚來交換您的商品！";
"T_GAME_QUEST_SCEN6_3_1_NAME" = "又增開了2座礦井。";
"T_GAME_QUEST_SCEN6_3_2_NAME" = "又增開了3座礦井。";
"T_GAME_QUEST_SCEN6_3_DESC" = "我們應該馬上動工開採！ 要保證我們有足夠的礦井在生產，這樣我們才能夠按時完成交付。";
"T_GAME_QUEST_SCEN6_3_NAME" = "開挖一個礦井。";
"T_GAME_QUEST_SCEN6_4_DESC" = "您的鎮民人正埋頭苦幹，開採礦石！ 要保證為他們供應充足的食物讓他們吃飽，才能有力氣幹活！";
"T_GAME_QUEST_SCEN6_4_NAME" = "興建一座麵包店。";
"T_GAME_QUEST_SCEN6_5_DESC" = "我們進展得很順利，不過還得冶煉礦石！";
"T_GAME_QUEST_SCEN6_5_NAME" = "建造兩座熔爐。";
"T_GAME_QUEST_SCEN6_6_DESC" = "在黑暗、潮濕的礦井裡幹活，卻沒有合適的衣服，真不是個滋味！ 您應該為您的鎮民提供曖和的衣服。 我敢肯定，他們會非常感激您的！";
"T_GAME_QUEST_SCEN6_6_NAME" = "為礦工送去了25件衣服。";
"T_GAME_QUEST_SCEN6_7_DESC" = "大人，我們正在以極大的速度生產物資！ 我們需要建造更多的倉庫來儲存所有這此物資！";
"T_GAME_QUEST_SCEN6_7_NAME" = "建造兩座倉庫。";
"T_GAME_QUEST_SCEN6_8_DESC" = "在礦井裡幹活真是很艱苦的工作！ 經過了一天的辛苦勞作，您的鎮民希望有一個地方去放鬆一下。 酒館就是個放鬆的好地方！";
"T_GAME_QUEST_SCEN6_8_NAME" = "興建一座酒館。";
"T_GAME_QUEST_SCEN6_END_DESC" = "幹得漂亮！ 我們把建造大教堂的物資都運送到位，我們幹得真棒！ 不過，大教堂的建成需要時間。\n\n大教堂將是對偉大國王的紀念，他的功績蒂造了一個和平與中詣的年代，並將流芳百世。";
"T_GAME_QUEST_SCEN6_ERASE_DESC" = "記住，您可以把擋道的樹木伐掉！ 用鐵鏟把您想伐掉的樹作上記號。";
"T_GAME_QUEST_SCEN7_GIRL_1_1_DESC" = "我的管事大人，要我們烤婚禮蛋糕，沒有好的配料怎麼行！ 您再建造兩座農場，我們來自己磨麵粉，好嗎？";
"T_GAME_QUEST_SCEN7_GIRL_1_1_NAME" = "興建一座農場。";
"T_GAME_QUEST_SCEN7_GIRL_1_2_NAME" = "興建一座風車磨坊。";
"T_GAME_QUEST_SCEN7_GIRL_1_3_NAME" = "生產 25 個點數的麵包。";
"T_GAME_QUEST_SCEN7_GIRL_1_DESC" = "這將是一場神奇的婚禮！ 首先，我們必須保證婚禮蛋糕要好。 我在挑選婚紗的這段時間，您能否興建一座麵包房？";
"T_GAME_QUEST_SCEN7_GIRL_1_NAME" = "興建一座麵包店。";
"T_GAME_QUEST_SCEN7_GIRL_2_DESC" = "我需要一個市場，把我不喜歡的婚禮禮物處理掉！";
"T_GAME_QUEST_SCEN7_GIRL_2_NAME" = "獲得高的市場幸福值。";
"T_GAME_QUEST_SCEN7_GIRL_3_1_DESC" = "大人，婚禮準備工作進展順利。 不過，我們還需要一些工具來搭建婚禮大帳篷！";
"T_GAME_QUEST_SCEN7_GIRL_3_1_NAME" = "建造了工具匠作坊。";
"T_GAME_QUEST_SCEN7_GIRL_3_2_NAME" = "生產20個點數的的工具。";
"T_GAME_QUEST_SCEN7_GIRL_3_DESC" = "我想要在一座美麗的教堂舉行我們的結婚典禮。 您建好大教堂了嗎？";
"T_GAME_QUEST_SCEN7_GIRL_3_NAME" = "保持高的宗教幸福度。";
"T_GAME_QUEST_SCEN7_GIRL_4_1_NAME" = "建起了一座牧羊場。";
"T_GAME_QUEST_SCEN7_GIRL_4_2_NAME" = "興建了一間織布廠。";
"T_GAME_QUEST_SCEN7_GIRL_4_3_NAME" = "生產20個單位的布匹。";
"T_GAME_QUEST_SCEN7_GIRL_4_DESC" = "這一切您能相信嗎？ 我哪裡都找不到一件得體的婚禮服！ 我需要一件禮服！馬上！ 叫您最好的裁縫趕做一件。";
"T_GAME_QUEST_SCEN7_GIRL_4_NAME" = "建造了一座裁縫店。";
"T_GAME_QUEST_SCEN7_GIRL_5_1_NAME" = "打造裝飾物";
"T_GAME_QUEST_SCEN7_GIRL_5_2_NAME" = "提高了鎮民們的幸福點數！";
"T_GAME_QUEST_SCEN7_GIRL_5_DESC" = "這個地方真是令人沮喪……您能否將這裡美化一下？ 我想讓大家都和我一樣開心！";
"T_GAME_QUEST_SCEN7_GUY_1_DESC" = "我不管蛋糕和花的事；我只想要辦一場盛大的慶祝活動，來賓可以痛飲葡萄汁！ 我想邀請全城的人來參加我的結婚典禮！ 可是我們沒有那麼多房間來接納如此多的婚禮來賓！";
"T_GAME_QUEST_SCEN7_GUY_1_NAME" = "增建小型城鎮連棟宅邸。";
"T_GAME_QUEST_SCEN7_GUY_2_DESC" = "婚禮一結束，我就要會見我的朋友，我需要一個好地方。 這個城鎮真的需要一座酒館！";
"T_GAME_QUEST_SCEN7_GUY_2_NAME" = "達到高度的酒館滿意度。";
"T_GAME_QUEST_SCEN7_GUY_3_1_NAME" = "生產25個點數的的葡萄汁";
"T_GAME_QUEST_SCEN7_GUY_3_DESC" = "我的朋友們會很渴的！ 您把果汁的事辦妥了嗎？";
"T_GAME_QUEST_SCEN7_GUY_3_NAME" = "建造一座果汁釀造廠。";
"T_GAME_QUEST_SCEN7_GUY_4_DESC" = "估計來賓的人數比預計的要多。建造一座連棟大邸。";
"T_GAME_QUEST_SCEN7_GUY_4_NAME" = "建造一座連棟大邸。";
"T_GAME_QUEST_SCEN7_GUY_5_1_NAME" = "生產15個點數的的珠寶。";
"T_GAME_QUEST_SCEN7_GUY_5_DESC" = "噢，不！ 我現在遇到大麻煩了！ 我的婚戒丟了！ 請不要告訴她！ 鎮上有沒有金匠可以為我打一隻新的婚戒？";
"T_GAME_QUEST_SCEN7_GUY_5_NAME" = "興建一座金匠鋪。";
"T_GAME_QUEST_SCEN7_GUY_6_DESC" = "在我結婚前，我想在馬上比武大會場上給我的未婚妻留下深刻的印象！";
"T_GAME_QUEST_SCEN7_GUY_6_NAME" = "建造了競技場。";
"T_GAME_QUEST_SCEN8_10_DESC" = "我的老爺，我們的牧場倉庫都已經塞滿貨物，直達房頂。 我可以建議我們下令另外興建一座倉庫嗎？";
"T_GAME_QUEST_SCEN8_10_NAME" = "興建新倉庫。";
"T_GAME_QUEST_SCEN8_11_DESC" = "鎮上的男人將會更加幸福，如果他們在勞作一天之後，有地方聚會、喝上一杯葡萄酒的話。 會不會太多而不能要求酒館，我的老爺？";
"T_GAME_QUEST_SCEN8_11_NAME" = "達到高度的酒館滿意度。";
"T_GAME_QUEST_SCEN8_12_DESC" = "我的老爺，鐵匠已經為鎮民們興建了簡單的取暖爐，但是我們仍然需要煤炭來給爐子供應燃料。";
"T_GAME_QUEST_SCEN8_12_NAME" = "生產50 煤。";
"T_GAME_QUEST_SCEN8_1_DESC" = "我的老爺，鎮上缺乏給家庭供暖的木柴。 我們儲足木材極其重要！";
"T_GAME_QUEST_SCEN8_1_NAME" = "生產75 木材。";
"T_GAME_QUEST_SCEN8_2_DESC" = "城鎮年久失修。 看看這些失修的連棟宅邸。 很可能只要一場風暴，當中就會有很多連棟宅邸坍塌。 讓我們給城鎮引入木匠，幫助興建修繕。";
"T_GAME_QUEST_SCEN8_2_NAME" = "興建木匠鋪。";
"T_GAME_QUEST_SCEN8_3_DESC" = "我的老爺，這個嚴酷的冬天明顯是上蒼的徵兆！ 我們必須懺悔我們的罪過！ 讓我們興建一處教堂來撫慰上帝！";
"T_GAME_QUEST_SCEN8_3_NAME" = "達到高度虔誠的滿足。";
"T_GAME_QUEST_SCEN8_4_DESC" = "鎮民們休息不足啊，我的老爺。 他們的家中非常寒冷。 我認為我們應當儲足羊絨。 鎮民們可以使用羊絨來給家庭禦寒。";
"T_GAME_QUEST_SCEN8_4_NAME" = "生產55 木絨。";
"T_GAME_QUEST_SCEN8_5_DESC" = "鄰省的省長已經飛鴿傳書，向我們求救! 它們的人們急需溫暖的衣物。";
"T_GAME_QUEST_SCEN8_5_NAME" = "向鄰省運送一車衣服。";
"T_GAME_QUEST_SCEN8_6_DESC" = "農場冬天不能生產小麥，我的老爺。 讓我們打發一些鎮民進林獵鹿。";
"T_GAME_QUEST_SCEN8_6_NAME" = "興建獵人木屋。";
"T_GAME_QUEST_SCEN8_7_DESC" = "我誠實的僕人，這個異常嚴酷的冬天已經重創了這個王國。 稅務收入已經顯著下跌。 我命令你興建金庫，以便增加你們的稅務收入，並送給我一馬車泰勒幣作為貢品。";
"T_GAME_QUEST_SCEN8_7_NAME" = "興建金庫並向國王進貢金幣。";
"T_GAME_QUEST_SCEN8_8_DESC" = "既然我們鎮上有個木匠，修繕所有這些破舊的連棟宅邸就不會成大問題。 鎮民們將非常高興。";
"T_GAME_QUEST_SCEN8_8_NAME" = "確保所有連棟宅邸妥善修葺。";
"T_GAME_QUEST_SCEN8_9_DESC" = "野味總是有，即使在冬天，仍可作為麵包的替代品。 讓我們確保有足夠的肉讓我們活過這個冬季。";
"T_GAME_QUEST_SCEN8_9_NAME" = "生產50 肉。";
"T_GAME_QUEST_SCEN8_MAIN_DESC" = "我的老爺，冬天遠比我們預期的嚴酷，那麼這種情況會令鎮民們不幸。 我們必須快速行動，否則我們將活不過這個冬天!";
"T_GAME_QUEST_SCEN8_MAIN_NAME" = "挽救這個城鎮度過嚴冬...";
"T_GAME_QUEST_SCEN8_SCENENDTEXT" = "我的老爺，我們的進度令鎮民們非常幸福！ 現在，我們貨物供應已經很充足，能讓我們活過冬季歲月，而且我們甚至能夠幫助鄰省。 現在，我們已經做好準備，那麼這個冬天就不能傷害我們！";
"T_GAME_QUEST_SCEN9_10_DESC" = "我的老爺，我聽說您有麻煩，您的地盤有暴亂。 我願意帶領一個搜索隊進入樹林，但我的雇傭兵們要求先付款。";
"T_GAME_QUEST_SCEN9_10_NAME" = "花錢請外國雇傭兵。";
"T_GAME_QUEST_SCEN9_11_DESC" = "我還有另外一個要求，我忠實的僕人。 我需要一艘旗艦，真正配得上國王，而且那意味著大量的金飾！\n\n我命令您交付我亟需的黃金。 不要在這方面讓我失望。";
"T_GAME_QUEST_SCEN9_11_NAME" = "在時限內將金礦交給國王。";
"T_GAME_QUEST_SCEN9_12_DESC" = "我忠實的僕人，我的新艦隊的建設進展良好，但我們還需要大量的帆布。 我命令你交付足夠的帆布以裝備我的戰艦船帆。";
"T_GAME_QUEST_SCEN9_12_NAME" = "交付帆布的紡織生產。";
"T_GAME_QUEST_SCEN9_13_DESC" = "我的人已經發現了些什麼 我們在森林裡發現的土匪的蹤跡。 儘管如此，我們需要更多食物，我們才能繼續調查。";
"T_GAME_QUEST_SCEN9_13_NAME" = "向雇傭兵們交納食物。";
"T_GAME_QUEST_SCEN9_14_DESC" = "長官！ 我在您的省份，土匪搶走了整批的木板貨物。 這必須停止。 請交納盡可能多的木板。";
"T_GAME_QUEST_SCEN9_14_NAME" = "請交納木板以支持國王的艦隊興建。";
"T_GAME_QUEST_SCEN9_15_DESC" = "我的老爺，稅務官已經證明林中土匪和城中破壞者之間有聯繫。 他拒絕告訴我們詳情，因為他擔心他自己的生命。\n\n他要求解除他的稅務官職責。 他還想要一套新衣服，以便他能夠離開城鎮並躲藏起來。 至於那樣他才會告訴我們實話。";
"T_GAME_QUEST_SCEN9_15_NAME" = "取消分配來自金庫的稅務官，並為他提供新衣服，以便他能夠無聲息地溜出城鎮。";
"T_GAME_QUEST_SCEN9_16_DESC" = "我的老爺，正如他承諾的那樣，稅務官在離開城鎮之前吐露了破壞者的身份。\n\n那就是雇傭兵和他的人！ 他們是騙子！ 他們在城鎮之間流竄並提供“保護”，向土匪和破壞者收取保護費，他們有密約。";
"T_GAME_QUEST_SCEN9_17_DESC" = "壞消息，我的老爺！ 有人闖入倉庫，把我們的肉偷光了！\n\n讓我們沿城鎮四周放置一些火把。 晚上，這樣能幫助捉住竊賊。";
"T_GAME_QUEST_SCEN9_17_NAME" = "沿城鎮四周興建 7 個火把，偵反竊賊。";
"T_GAME_QUEST_SCEN9_18_DESC" = "我的君主，既然我們無法很快地找到行商，那麼我們需要額外的倉庫，以儲存我們的貨物。 \n\n另外，我們應該暫停不必要的生產，以確保我們的庫位不緊張。\n\n興建另一座倉庫是明智的。";
"T_GAME_QUEST_SCEN9_18_NAME" = "在鎮上再興建一座倉庫。";
"T_GAME_QUEST_SCEN9_19_DESC" = "\n鎮民們蜷縮在一起，害怕破壞者，而且太害怕而不敢外出和修繕各自的連棟宅邸。 我猜想我們必須興建木匠鋪，如果我們想要修繕完工的話。";
"T_GAME_QUEST_SCEN9_19_NAME" = "興建木匠鋪。";
"T_GAME_QUEST_SCEN9_1_DESC" = "早上好，我的老爺。 這是多美好的冬天啊。 我們已經削減了我們未來幾個月的工作量。 \n\n讓我們馬上開始，先興建兩個伐木工小屋，如何？";
"T_GAME_QUEST_SCEN9_1_NAME" = "興建一些伐木工營地。";
"T_GAME_QUEST_SCEN9_20_DESC" = "我有求而來，我的老爺！ 在整個王國之內，工具需求量很高。 如果您能交給我一馬車工具，我將優厚付款。 另外，我想再次訪問您的城鎮進行貿易。";
"T_GAME_QUEST_SCEN9_20_NAME" = "向商人交付許多工具。";
"T_GAME_QUEST_SCEN9_2_DESC" = "我有重要新聞，我的老爺！ 來了一群外國雇傭兵，而且他們投訴我們的村莊沒有酒館。 \n\n我們應當盡力避免鎮上有一幫令人厭憎、不開心的外國雇傭兵，那麼讓我們興建酒館吧。";
"T_GAME_QUEST_SCEN9_2_NAME" = "提升酒館幸福感。";
"T_GAME_QUEST_SCEN9_3_DESC" = "長官，我很樂意看到您增產木材的努力進展良好。\n\n現在，請您先交付頭批…";
"T_GAME_QUEST_SCEN9_3_NAME" = "向國王進貢木材。";
"T_GAME_QUEST_SCEN9_4_DESC" = "我的老爺，鎮上不斷有騷亂的流言。 可能是一些鎮民正在密謀反對國王？\n\n如果我們現在不採取行動，我們附近就可能會全面爆發叛亂。 我們應該確保：我們的鎮民幸福而且滿足，那麼我們就得快速行動。";
"T_GAME_QUEST_SCEN9_4_NAME" = "在接下來的幾分鐘期間，保持高於 100% 的幸福度。";
"T_GAME_QUEST_SCEN9_5_DESC" = "我的老爺，這是一場暴亂！ 酒館已經被毀！ 有一種談論：鎮上的破壞者正在坐大。 \n\n我們必須在一切完全失控之前先控制住形勢。絞刑架和頭手枷須獲成功。";
"T_GAME_QUEST_SCEN9_5_NAME" = "在鎮上興建絞刑架和2 個頭手枷。";
"T_GAME_QUEST_SCEN9_6_DESC" = "我的老爺，在鎮上增加一些士氣將是明智的。 \n\n向鎮民們顯示善意，將增加他們的幸福感。為什麼不給他們興建教堂或者用花圃美化城鎮？";
"T_GAME_QUEST_SCEN9_6_NAME" = "興建一些花圃和教堂。";
"T_GAME_QUEST_SCEN9_7_DESC" = "長官，很抱歉通知您：我暫且無法訪問您的城鎮。\n我聽到流言，說您所在城鎮周圍的樹林裡有土匪。眼下對商人太危險。\n\n我也得到國王的消息。他下令興建兩個鋸木廠。";
"T_GAME_QUEST_SCEN9_7_NAME" = "興建 2 個鋸木廠。";
"T_GAME_QUEST_SCEN9_8_DESC" = "我的老爺，我有個主意。 我們應該興建金庫。 稅務官將訪問每座連棟宅邸...而且可能他能夠發掘這個破壞者的一些資訊。";
"T_GAME_QUEST_SCEN9_8_NAME" = "興建金庫並等候稅務官調查連棟宅邸。";
"T_GAME_QUEST_SCEN9_9_DESC" = "這個破壞者已經摧毀了鋸木廠！ 同樣，稅務官還沒有成功地發現破壞者的身份，我的老爺。";
"T_GAME_QUEST_SCEN9_FAIL_1" = "您沒有及時預防騷亂！";
"T_GAME_QUEST_SCEN9_FAIL_2" = "您沒有！ 由於您的失職，我必須向另一個城鎮訂購黃金！";
"T_GAME_QUEST_SCEN9_MAIN_DESC" = "長官，我將很快委託興建一個全新的大型戰艦，組成艦隊。 \n\n您的城鎮有能力成為這個艱巨任務的最大供應商。 請務必保證。";
"T_GAME_QUEST_SCEN9_MAIN_ENDTEXT" = "外國雇傭兵及其幫夥已經逃離這個地區，我的老爺。我會派人逐殺他們。\n\n我們還將感謝您支持興建我的新艦隊，並邀請您參加艦隊處女航。到那時為止，我命令你過好每一天…";
"T_GAME_QUEST_SCEN9_MAIN_TITLE" = "配合國王的工作。";
"T_GAME_QUEST_SCEN9_SUCEEDED_1" = "非常好！ 您防止了城鎮騷亂！";
"T_GAME_QUEST_SCEN9_SUCEEDED_2" = "非常好！ 你即時交付！";
"T_GAME_QUEST_SCEN_10_DESC" = "比武大賽結束後，我們的騎士會到酒館去消遣！不過我還是擔心，我們的酒館和葡萄汁都不夠！立即處理好這個問題！";
"T_GAME_QUEST_SCEN_10_NAME" = "興建一個酒館，生產充裕的葡萄汁。";
"T_GAME_QUEST_SCEN_11_DESC" = "好極了，幹事！城鎮的準備工作已經做好了，可是我和我的女兒們還沒有準備好呢！我需要您的裁縫為我們終縫製最華麗的衣服！";
"T_GAME_QUEST_SCEN_11_NAME" = "支付 35 套衣服的貢禮。";
"T_GAME_QUEST_SCEN_12_DESC" = "比武大賽快要開幕了！我可不想看到鎮上有不開心的面孔！您最好確保鎮民們是開心的！";
"T_GAME_QUEST_SCEN_12_NAME" = "提升幸福指數。";
"T_GAME_QUEST_SCEN_1_DESC" = "歡迎您，我的幹事先生！您應該知道，我正計畫著舉辦一場最棒的區域比武大賽！我希望您至少興建三座競技場來舉辦這次大賽！別讓我失望哦！";
"T_GAME_QUEST_SCEN_1_NAME" = "興建三座競技場。";
"T_GAME_QUEST_SCEN_2_DESC" = "比武大賽的來賓們肯定會餓的！我要求您立即開始烤制麵包，當作貢物奉獻給您的國王！";
"T_GAME_QUEST_SCEN_2_NAME" = "送出 25 條麵包的貢禮。";
"T_GAME_QUEST_SCEN_3_1_NAME" = "建造一個磨坊並生產麵粉。";
"T_GAME_QUEST_SCEN_3_2_NAME" = "建造兩個麵包房並生產麵包。";
"T_GAME_QUEST_SCEN_3_DESC" = "我的老爺，我們不應該讓國王久等！我們需要小麥和麵粉開始烤制麵包！";
"T_GAME_QUEST_SCEN_3_NAME" = "建造一個農場並生產小麥。";
"T_GAME_QUEST_SCEN_4_DESC" = "很好，我的好幹事！但是光有麵包還不能滿足我們的賓客的需要！我需要新鮮的魚肉作為給您的國王的進貢禮！";
"T_GAME_QUEST_SCEN_4_NAME" = "送出25條魚的貢禮。";
"T_GAME_QUEST_SCEN_5_DESC" = "我想把比武大賽辦成一次難忘的盛會！我們的騎士必須使用絕好的長矛，我們的競技場必須閃亮耀眼！幫我一個忙為您的國王收取稅金吧！";
"T_GAME_QUEST_SCEN_5_NAME" = "支付1000泰勒幣的貢禮。";
"T_GAME_QUEST_SCEN_6_DESC" = "我相信我們的客人們會非常喜歡享用我們新榨的葡萄汁的！去建幾座果汁製造廠吧！您甚至還可以將低品質的廢料提供給當地的酒館！";
"T_GAME_QUEST_SCEN_6_DESC_NEW" = "咱們鮮榨出來的葡萄汁，甘甜味美，客人一定會喜歡！";
"T_GAME_QUEST_SCEN_6_NAME" = "興建一座果汁製造廠並生產果汁。";
"T_GAME_QUEST_SCEN_7_1_NAME" = "建造織布廠並生產布料。";
"T_GAME_QUEST_SCEN_7_2_NAME" = "興建一間裁縫鋪並製作衣物。";
"T_GAME_QUEST_SCEN_7_DESC" = "幹事，我們騎士的信號旗都舊得褪了色。我看著很不舒服！快做些新的來！如果想保住您的飯碗，就去興建牧羊場，雇一名紡織工，再建個裁縫鋪！";
"T_GAME_QUEST_SCEN_7_NAME" = "興建兩座牧羊場。";
"T_GAME_QUEST_SCEN_8_DESC" = "我們應該拿出更多的貨物去賣錢，我的老爺。有了充足的泰勒，就可以開銷將來的各種用度。這總是一個來錢的好辦法。";
"T_GAME_QUEST_SCEN_8_NAME" = "通過貿易賺取 500 個泰勒幣。";
"T_GAME_QUEST_SCEN_9_DESC" = "我看事情進展良好，但您的小鎮外觀仍然很難看！ 我想要噴泉和白色石牆，還有常綠樹木和輝煌壯麗的雕像! 您應該多用些裝飾來美化城鎮!";
"T_GAME_QUEST_SCEN_9_NAME" = "提升了裝飾幸福指數。";
"T_GAME_QUEST_SCEN_CC_10_DESC" = "首先，建議你分派一個工人，到這個地區的一個伐木工小屋去。";
"T_GAME_QUEST_SCEN_CC_10_TITEL" = "分派一個工人去伐木工小屋。";
"T_GAME_QUEST_SCEN_CC_45_DESC" = "咱們的一個主要任務，就是建立市場。\n大人，要完成這個任務，您就必須建立多種資源的生產鏈條，還要收集必要的資源。";
"T_GAME_QUEST_SCEN_CC_45_TITEL" = "建立市場。";
"T_GAME_QUEST_SCEN_CC_46_DESC" = "大人，小人愚見，咱們分派一個鎮民去鋸木廠，以便儘快鋸出木板。";
"T_GAME_QUEST_SCEN_CC_46_TITEL" = "分派一個工人去鋸木廠。";
"T_GAME_QUEST_SCEN_CC_471_DESC" = "大人，小人建議，您將礦石換成開採出來的石頭。";
"T_GAME_QUEST_SCEN_CC_47_DESC" = "一旦有了原木和木板，您就要派遣一個工人去礦井開採石頭。";
"T_GAME_QUEST_SCEN_CC_47_END" = "太好了，大人。現在咱們就坐等市場建成了。";
"T_GAME_QUEST_SCEN_CC_47_TITEL" = "分派一個工人去礦井。";
"T_GAME_QUEST_SCEN_CC_60_DESC" = "您的第二項主要任務，是修建酒館。\n\n咱們應該立即著手興建。";
"T_GAME_QUEST_SCEN_CC_60_TITEL" = "修建酒館。";
"T_GAME_QUEST_SCEN_CC_61_DESC" = "大人，好消息。有些鎮民，已經搬來，為咱們的任務出力。您應該給他們修建城鎮連棟宅邸。";
"T_GAME_QUEST_SCEN_CC_61_TITEL" = "修建城鎮連棟宅邸。";
"T_GAME_QUEST_SCEN_CC_62_DESC" = "要建酒館，咱們需要一座工具匠作坊。依小人之見，應該從修建木炭窯開始。  ";
"T_GAME_QUEST_SCEN_CC_62_TITEL" = "修建木炭窯。";
"T_GAME_QUEST_SCEN_CC_63_DESC" = "下一步，就需要冶煉廠了。有了冶煉廠，咱們就可以開始製造鐵條了。";
"T_GAME_QUEST_SCEN_CC_63_TITEL" = "修建冶煉廠。";
"T_GAME_QUEST_SCEN_CC_64_DESC" = "大人，要製造工具，咱們就得在鎮裡建一座工具匠作坊。";
"T_GAME_QUEST_SCEN_CC_64_TITEL" = "修建工具匠作坊。";
"T_GAME_QUEST_SCEN_CC_B_15_DESC" = "大人，食品供應出現短缺。您真的應該下令，讓一個鎮民前去捕魚或是狩獵。，鎮民要是不能很快得到某些食品，生產量就會降低。";
"T_GAME_QUEST_SCEN_CC_B_15_TITEL" = "製作食品。";
"T_GAME_QUEST_SCEN_CC_B_20_DESC" = "大人，小的是個卑微的商人，願意為您效勞。小人見您因為建築工程，需要現金。\n如蒙許可，小人想向您購買一些鐵礦石。";
"T_GAME_QUEST_SCEN_CC_B_20_TITEL" = "與商人買賣貨物。";
"T_GAME_QUEST_SCEN_CC_B_30_DESC" = "大人，現金短缺了嗎？沒關係。小人願意向您購買一些動物毛皮。";
"T_GAME_QUEST_SCEN_CC_B_40_DESC" = "總督大人，我需要點天然金塊。您願意賣些給我嗎？";
"T_GAME_QUEST_SCEN_CC_C_10_DESC" = "大人，我感覺不舒服。得找個醫生看看。";
"T_GAME_QUEST_SCEN_CC_C_10_TITEL" = "醫治傷病鎮民。";
"T_GAME_QUEST_SCEN_CC_C_20_DESC" = "著火啦！應該有個鎮民，馬上去把火撲滅。";
"T_GAME_QUEST_SCEN_CC_C_20_TITEL" = "滅火。";
"T_GAME_QUEST_SCEN_CC_C_30_DESC" = "到了這兒，還有土匪騷擾。大人，咱們應該分派些鎮民去瞭望塔，直到抵擋住進犯為止。";
"T_GAME_QUEST_SCEN_CC_C_30_TITEL" = "抗擊土匪，保衛城市。";
"T_GAME_QUEST_SCEN_CC_C_40_DESC" = "大人，我們稍事休息，吃點東西，可以嗎？";
"T_GAME_QUEST_SCEN_CC_C_40_TITEL" = "製作麵包。";
"T_GAME_QUEST_SCEN_CC_MAIN_DESC" = "大人，情勢如此緊急，咱們卻只有幾個鎮民。咱們只得隨機應變，把他們在各建築物間調來調去。";
"T_GAME_QUEST_SCEN_CC_MAIN_END" = "祝賀你。你成功解決了缺工匠挑戰。";
"T_GAME_QUEST_SCEN_CC_MAIN_TITLE" = "巧妙調配鎮民，完成全部任務。";
"T_GAME_QUEST_SCEN_CW_20_DESC" = "大人，好消息。城堡旁邊的半島上，林木已經重新長高。\n\n依小人之見，咱們應該在那邊建築伐木工小屋，方便獲取木材。";
"T_GAME_QUEST_SCEN_CW_30_DESC" = "大人，這些伐木工小屋，已經朽壞廢棄！\n\n這個地區的林木，已經伐盡。伐木工小屋，已經沒用了。\n小人建議，把不需要的建築拆除，以獲取木材。";
"T_GAME_QUEST_SCEN_CW_30_NAME" = "拆除伐木工小屋";
"T_GAME_QUEST_SCEN_CW_35_DESC" = "大人，小人愚見，您可以向村子裡的人詢問，他們可能還有剩餘的木材。";
"T_GAME_QUEST_SCEN_CW_40_DESC" = "陛下正在盼望進獻的第一批木板。\n\n咱們可以分派一個鎮民去鋸木廠，開始生產木板。依小人之見，還得盯緊木材存量。 ";
"T_GAME_QUEST_SCEN_CW_40_NAME" = "分派一個鎮民去鋸木廠。";
"T_GAME_QUEST_SCEN_CW_45_DESC" = "總督，你那邊進展如何？我要你進呈三批木板。\n\n第一批，你要儘快備辦妥當。不要讓我失望。";
"T_GAME_QUEST_SCEN_CW_45_NAME" = "進獻貨物給國王。";
"T_GAME_QUEST_SCEN_CW_50_DESC" = "大人，咱們進獻了第一批木板，陛下很是滿意。\n咱們得趕快備辦好下一批。";
"T_GAME_QUEST_SCEN_CW_60_DESC" = "陛下正在等著最後一批木板。有了這批木板，皇家艦隊會得到大大的擴充。\n\n咱們一定得把差事辦妥當。";
"T_GAME_QUEST_SCEN_CW_70_DESC" = "你想知道，國王收不到木板，是什麼原因嗎？哼哼，我可知道為什麼。\n\n咱廢話少說，給一點贖金，你們的貨，就可以到國王那裡，不會再有留難。";
"T_GAME_QUEST_SCEN_CW_70_NAME" = "付上贖金。";
"T_GAME_QUEST_SCEN_CW_MAIN_10_DESC" = "為打造皇家艦隊，我需要大量的木板。\n無奈，很久都沒有人進獻了。\n\n總督，我交給你一個任務！找出進獻受阻的原因，把問題解決掉！";
"T_GAME_QUEST_SCEN_CW_MAIN_10_END" = "辦事得力，總督。我就知道，可以依靠於你。\n\n由於你做事出色，艦隊不日即可整裝待發。";
"T_GAME_QUEST_SCEN_CW_MAIN_10_NAME" = "終結木材短缺問題，向國王進獻充足的木板。";
"T_GAME_QUEST_SCEN_CW_M_10_DESC" = "大人，小人愚見，這些木材，須妥善使用！\n\n咱們可以建立市場，以便從商人手中購買木材。";
"T_GAME_QUEST_SCEN_CW_M_20_DESC" = "您要用木材嗎？在下以為，你情我願，即可成交，絕非難事。如您需要，現在就有一堆木材待售。\n\n您需要多少，就可以買多少。";
"T_GAME_QUEST_SCEN_CW_M_20_NAME" = "從商人手中購買木材。";
"T_GAME_QUEST_SCEN_CW_M_30_DESC" = "大人，您需要的是定期得到木材。\n\n要是您建立一個同業公會，您就可以下單定貨了。";
"T_GAME_QUEST_SCEN_CW_M_30_NAME" = "建立同業公會。";
"T_GAME_QUEST_SCEN_CW_M_40_DESC" = "到貿易協會，您可以下單進行買賣。\n\n大人，您可以下單購買木材了。";
"T_GAME_QUEST_SCEN_CW_M_40_END" = "太好了！只要您有金幣，我就能完成您的定單。\n\n您的同業定單，會一直有效，直到您取銷為止。";
"T_GAME_QUEST_SCEN_CW_M_40_NAME" = "下單購買木材。";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_DESC" = "城裡著火了！咱們得建夠防火塔，以撲滅大火，減少火患。";
"T_GAME_QUEST_SCEN_WW_DISASTER_20_NAME" = "防火塔覆蓋範圍高達城區的 80 %。";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_DESC" = "土匪來了！他們拚著命，要摧毀咱們的建築物。咱們需要更多的士兵，才能趕走土匪。咱們還要多建守衛塔。";
"T_GAME_QUEST_SCEN_WW_DISASTER_30_NAME" = "修建足夠的守衛塔，以充足兵力保衛城市。";
