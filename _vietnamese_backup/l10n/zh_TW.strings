"T_GOOGLE_QUESTS_SAUSAGES_DESC" = "香腸\n\n國王的兵士，喜歡這些美味。軍中頭領建議，要您擴大此類精細商品的產量。\n";
"T_GOOGLE_QUESTS_SAUSAGES_TITLE" = "軍中補給";
"T_GOOGLE_QUESTS_SUPPLIES_DESC" = "國王已命令，各郡都要趁早儲備麵包，以禦嚴冬。冬天要來了，領主大人……";
"T_GOOGLE_QUESTS_SUPPLIES_NAME" = "生產越冬物資";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_DESC" = "鄰國天降大旱，顆粒無收。我國國王，已承諾給其物資支援。現選中你的城鎮，向鄰國提供穀物。";
"T_GOOGLE_QUESTS_SUPPORTNEIGHBOUR_NAME" = "支援鄰邦";
"T_GOOGLE_QUESTS_TAXESLEVIED_DESC" = "為確保王國內打擊盜匪團夥組織之戰勝利，陛下已命令向公民大額徵稅。";
"T_GOOGLE_QUESTS_TAXESLEVIED_NAME" = "徵稅";
"T_GOOGLE_QUESTS_TERRITORIAL_DESC" = "國王命令，立即生效：所有領主，都要將其城市周圍森林中的強盜營地，盡數掃除。";
"T_GOOGLE_QUESTS_TERRITORIAL_NAME" = "肅清盜匪";
"T_GOOGLE_QUESTS_TOOLS_DESC" = "大人，您需要擴大城鎮面積才能完成任務。首先，我們必須確保經濟穩定。為此，我們得生產一些工具。";
"T_GOOGLE_QUESTS_TOOLS_TITLE" = "新增貿易工具";
"T_GOOGLE_QUESTS_TOWNGUARD_DESC" = "國王要求，不可再讓王國內的村民，再因懼怕其村鎮遭到強盜襲擊而提心吊膽。他命令，所有領主都要確保村鎮立即得到保護，強盜侵襲立即受到阻截。";
"T_GOOGLE_QUESTS_TOWNGUARD_NAME" = "城鎮守衛";
"T_GOOGLE_QUESTS_TRADEAGREEMENT_DESC" = "王國與各鄰國間新的貿易協定已經生效。現命你交易多餘資源，增加市場盈利。";
"T_GOOGLE_QUESTS_TRADEAGREEMENT_NAME" = "貿易總協定";
"T_GOOGLE_QUESTS_UNDERSIZEDARMY_DESC" = "國王陛下已命令，點名選中你的城鎮為王國防衛軍駐紮之地。身為當地領主，你必須修建足夠的兵營，以確保徵兵能及時進行。";
"T_GOOGLE_QUESTS_UNDERSIZEDARMY_NAME" = "擴充軍隊";
"T_GOOGLE_QUESTS_WAREFFORT_DESC" = "國王命令，大小領主，都要生產護甲，效力戰爭。人人都要為克敵制勝貢獻力量。";
"T_GOOGLE_QUESTS_WAREFFORT_NAME" = "戰時措施";
"T_GOOGLE_QUESTS_WAREHOUSE_DESC" = "給國王算命的人說，要有幾件事發生：要有天降啟示，要有惡魔侵擾，要有常規戰爭，還要有幾場沒有什麼後果的小災小難。為了讓每個村莊都做好準備，國王的謀士建議多建倉庫。這樣一來，憂心忡忡的村民，想存什麼貨物，就不愁沒有地方了。";
"T_GOOGLE_QUESTS_WAREHOUSE_TITLE" = "驚恐囤貨";
"T_GOOGLE_QUESTS_WEAPONS_DESC" = "國王下令：新近打造的兵器，要運往前線，支援國王軍隊。";
"T_GOOGLE_QUESTS_WEAPONS_TITLE" = "兵器運送";
